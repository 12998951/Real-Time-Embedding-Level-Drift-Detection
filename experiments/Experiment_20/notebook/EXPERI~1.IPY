    {
      "cell_type": "markdown",
      "source": [
        "# Experiment 20 — Step 3.2.8\n",
        "## Nested CroppedYale Source Archive Verification\n",
        "\n",
        "### Objective\n",
        "Verify the original CroppedYale.zip stored inside the frozen\n",
        "Experiment 20 package and establish image-level recoverability.\n",
        "\n",
        "### Checks\n",
        "1. Extract the nested archive bytes in memory only.\n",
        "2. Calculate and compare its SHA256 with the frozen manifest.\n",
        "3. Inventory PGM image files and their directory structure.\n",
        "4. Match the 2,414 embedding filenames against nested archive entries.\n",
        "5. Verify image decoding and dimensions using a sample.\n",
        "6. Check whether the reference and common-condition cohorts\n",
        "   are recoverable from the nested archive.\n",
        "\n",
        "### Restrictions\n",
        "- Read-only inspection.\n",
        "- No permanent extraction.\n",
        "- No downloads or installations.\n",
        "- No embedding regeneration.\n",
        "- No modification of frozen files.\n",
        "\n",
        "### Decision\n",
        "Proceed to model preprocessing feasibility only if the source\n",
        "archive hash, filename matching and image integrity checks pass."
      ],
      "metadata": {
        "id": "oG-GgrHy3QUZ"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from pathlib import Path\n",
        "from zipfile import ZipFile\n",
        "from io import BytesIO\n",
        "from collections import Counter\n",
        "from PIL import Image\n",
        "import numpy as np\n",
        "import hashlib\n",
        "import json\n",
        "\n",
        "print(\"=\" * 90)\n",
        "print(\"EXPERIMENT 20 — STEP 3.2.8\")\n",
        "print(\"NESTED CROPPEDYALE SOURCE ARCHIVE VERIFICATION\")\n",
        "print(\"=\" * 90)\n",
        "\n",
        "BASE = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "\n",
        "OUTER_ZIP = BASE / \"Experiment_20_Stage_2_Frozen_Dataset.zip\"\n",
        "NPZ_FILE = BASE / \"embeddings/experiment20_croppedyale_facenet_embeddings.npz\"\n",
        "MANIFEST_FILE = BASE / \"Experiment_20_Stage_2_Freeze_Manifest.json\"\n",
        "\n",
        "EXPECTED_SOURCE_SHA256 = (\n",
        "    \"8bbabf3836d077d60626c9ee3c54c2d2851a8d2c15c8b7e13b9bc162e86ea573\"\n",
        ")\n",
        "\n",
        "SOURCE_MEMBER = (\n",
        "    \"Experiment_20_Stage_2_Frozen_Dataset/source/CroppedYale.zip\"\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. Load frozen manifest and embedding metadata\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n[1] LOAD FROZEN REFERENCES\")\n",
        "\n",
        "with open(MANIFEST_FILE, \"r\") as f:\n",
        "    manifest = json.load(f)\n",
        "\n",
        "data = np.load(NPZ_FILE, allow_pickle=False)\n",
        "\n",
        "filenames = data[\"filenames\"].astype(str)\n",
        "subjects = data[\"subjects\"].astype(str)\n",
        "conditions = data[\"conditions\"].astype(str)\n",
        "\n",
        "print(\"Embedding filenames:\", len(filenames))\n",
        "print(\"Expected source SHA256:\", EXPECTED_SOURCE_SHA256)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. Read nested archive from outer ZIP in memory\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n[2] NESTED SOURCE ARCHIVE\")\n",
        "\n",
        "with ZipFile(OUTER_ZIP, \"r\") as outer:\n",
        "    if SOURCE_MEMBER not in outer.namelist():\n",
        "        raise FileNotFoundError(\n",
        "            \"Nested CroppedYale.zip not found in frozen package.\"\n",
        "        )\n",
        "\n",
        "    nested_bytes = outer.read(SOURCE_MEMBER)\n",
        "\n",
        "print(\"Nested archive bytes:\", len(nested_bytes))\n",
        "print(\"Nested archive size MB:\", round(len(nested_bytes) / (1024 ** 2), 2))\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. Verify nested archive SHA256\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n[3] SOURCE ARCHIVE SHA256\")\n",
        "\n",
        "actual_source_sha256 = hashlib.sha256(nested_bytes).hexdigest()\n",
        "\n",
        "print(\"Actual SHA256:\", actual_source_sha256)\n",
        "print(\"Expected SHA256:\", EXPECTED_SOURCE_SHA256)\n",
        "print(\"SHA256 MATCH:\", actual_source_sha256 == EXPECTED_SOURCE_SHA256)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. Inspect nested archive inventory\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n[4] NESTED ARCHIVE INVENTORY\")\n",
        "\n",
        "nested = ZipFile(BytesIO(nested_bytes), \"r\")\n",
        "\n",
        "nested_entries = nested.namelist()\n",
        "\n",
        "pgm_entries = [\n",
        "    name for name in nested_entries\n",
        "    if name.lower().endswith(\".pgm\")\n",
        "]\n",
        "\n",
        "print(\"Total nested entries:\", len(nested_entries))\n",
        "print(\"PGM image entries:\", len(pgm_entries))\n",
        "\n",
        "print(\"\\nFirst 20 PGM paths:\")\n",
        "for name in pgm_entries[:20]:\n",
        "    print(\" \", name)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. Match embedding filenames to nested images\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n[5] EMBEDDING FILENAME MATCHING\")\n",
        "\n",
        "nested_by_basename = {\n",
        "    Path(name).name: name\n",
        "    for name in pgm_entries\n",
        "}\n",
        "\n",
        "matched = []\n",
        "unmatched = []\n",
        "\n",
        "for filename in filenames:\n",
        "    basename = Path(filename).name\n",
        "\n",
        "    if basename in nested_by_basename:\n",
        "        matched.append((filename, nested_by_basename[basename]))\n",
        "    else:\n",
        "        unmatched.append(filename)\n",
        "\n",
        "print(\"Expected embedding images:\", len(filenames))\n",
        "print(\"Matched images:\", len(matched))\n",
        "print(\"Unmatched images:\", len(unmatched))\n",
        "\n",
        "if unmatched:\n",
        "    print(\"\\nFirst 10 unmatched filenames:\")\n",
        "    for name in unmatched[:10]:\n",
        "        print(\" \", name)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. Subject coverage\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n[6] SUBJECT COVERAGE\")\n",
        "\n",
        "archive_subjects = set()\n",
        "\n",
        "for name in pgm_entries:\n",
        "    parts = Path(name).parts\n",
        "\n",
        "    for part in parts:\n",
        "        if part.startswith(\"yaleB\"):\n",
        "            archive_subjects.add(part)\n",
        "\n",
        "metadata_subjects = set(subjects)\n",
        "\n",
        "print(\"Archive subjects:\", len(archive_subjects))\n",
        "print(\"Metadata subjects:\", len(metadata_subjects))\n",
        "print(\"Missing archive subjects:\",\n",
        "      sorted(metadata_subjects - archive_subjects))\n",
        "print(\"Additional archive subjects:\",\n",
        "      sorted(archive_subjects - metadata_subjects))\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. Decode sample images directly from nested archive\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n[7] IMAGE DECODING\")\n",
        "\n",
        "sample = matched[:100]\n",
        "\n",
        "dimension_counts = Counter()\n",
        "mode_counts = Counter()\n",
        "decode_failures = []\n",
        "\n",
        "for original_filename, archive_filename in sample:\n",
        "    try:\n",
        "        with nested.open(archive_filename) as f:\n",
        "            image = Image.open(f)\n",
        "            image.load()\n",
        "\n",
        "            dimension_counts[str(image.size)] += 1\n",
        "            mode_counts[image.mode] += 1\n",
        "\n",
        "    except Exception as exc:\n",
        "        decode_failures.append({\n",
        "            \"filename\": original_filename,\n",
        "            \"error\": repr(exc)\n",
        "        })\n",
        "\n",
        "print(\"Sample images tested:\", len(sample))\n",
        "print(\"Dimensions:\", dict(dimension_counts))\n",
        "print(\"Modes:\", dict(mode_counts))\n",
        "print(\"Decode failures:\", len(decode_failures))\n",
        "\n",
        "if decode_failures:\n",
        "    for item in decode_failures[:5]:\n",
        "        print(item)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 8. Common-condition cohort recovery\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n[8] COMMON-CONDITION COHORT RECOVERY\")\n",
        "\n",
        "common_conditions = sorted(\n",
        "    condition\n",
        "    for condition in set(conditions)\n",
        "    if all(\n",
        "        (subject, condition) in set(zip(subjects, conditions))\n",
        "        for subject in set(subjects)\n",
        "    )\n",
        ")\n",
        "\n",
        "common_rows = [\n",
        "    i for i, condition in enumerate(conditions)\n",
        "    if condition in common_conditions\n",
        "]\n",
        "\n",
        "evaluation_rows = [\n",
        "    i for i in common_rows\n",
        "    if conditions[i] != \"A+000E+00\"\n",
        "]\n",
        "\n",
        "matched_names = {Path(original).name for original, _ in matched}\n",
        "\n",
        "common_matched = sum(\n",
        "    Path(filenames[i]).name in matched_names\n",
        "    for i in common_rows\n",
        ")\n",
        "\n",
        "evaluation_matched = sum(\n",
        "    Path(filenames[i]).name in matched_names\n",
        "    for i in evaluation_rows\n",
        ")\n",
        "\n",
        "print(\"Common conditions:\", len(common_conditions))\n",
        "print(\"Common observations:\", len(common_rows))\n",
        "print(\"Matched common observations:\", common_matched)\n",
        "print(\"Evaluation observations:\", len(evaluation_rows))\n",
        "print(\"Matched evaluation observations:\", evaluation_matched)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 9. Final audit\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "checks = {\n",
        "    \"Nested source archive exists\": len(nested_bytes) > 0,\n",
        "    \"Source archive SHA256 matches\": actual_source_sha256 == EXPECTED_SOURCE_SHA256,\n",
        "    \"Nested ZIP integrity\": nested.testzip() is None,\n",
        "    \"All embedding filenames matched\": len(unmatched) == 0,\n",
        "    \"All 38 subjects present\": len(metadata_subjects) == 38,\n",
        "    \"All 2414 images matched\": len(matched) == 2414,\n",
        "    \"Sample images decoded\": len(sample) > 0 and len(decode_failures) == 0,\n",
        "    \"All 2166 common observations matched\": common_matched == 2166,\n",
        "    \"All 2128 evaluation observations matched\": evaluation_matched == 2128\n",
        "}\n",
        "\n",
        "print(\"\\n\" + \"=\" * 90)\n",
        "print(\"STEP 3.2.8 FINAL AUDIT\")\n",
        "print(\"=\" * 90)\n",
        "\n",
        "for name, passed in checks.items():\n",
        "    print(f\"{name}: {'PASS' if passed else 'FAIL'}\")\n",
        "\n",
        "print(\"\\nPassed:\", sum(checks.values()), \"/\", len(checks))\n",
        "print(\"Permanent extraction: NO\")\n",
        "print(\"Files modified: NO\")\n",
        "print(\"Downloads: NO\")\n",
        "print(\"Embedding regeneration: NO\")\n",
        "print(\"=\" * 90)\n",
        "\n",
        "nested.close()"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
