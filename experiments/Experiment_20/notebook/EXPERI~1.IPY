        "        \"sha256\": manuscript_hash,\n",
        "        \"word_count\": len(manuscript.split()),\n",
        "        \"results_section_word_count\": len(results_text.split())\n",
        "    },\n",
        "\n",
        "    \"frozen_evidence_inventory\": file_inventory,\n",
        "\n",
        "    \"results_reporting_checks\": result_checks,\n",
        "\n",
        "    \"frozen_source_checks\": source_checks,\n",
        "\n",
        "    \"scientific_interpretation_checks\": interpretation_checks,\n",
        "\n",
        "    \"issues\": issues,\n",
        "\n",
        "    \"issue_count\": len(issues),\n",
        "\n",
        "    \"status\": (\n",
        "        \"RESULTS_STATISTICAL_INTERPRETATION_AUDIT_COMPLETED_NO_FLAGGED_ISSUES\"\n",
        "        if len(issues) == 0\n",
        "        else \"RESULTS_STATISTICAL_INTERPRETATION_REVIEW_REQUIRED\"\n",
        "    ),\n",
        "\n",
        "    \"integrity\": {\n",
        "        \"manuscript_modified\": False,\n",
        "        \"frozen_evidence_modified\": False,\n",
        "        \"previous_sections_modified\": False\n",
        "    }\n",
        "}\n",
        "\n",
        "with open(REPORT_PATH, \"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(report, f, indent=2, default=str)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 9. PRINT SUMMARY\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"PHASE 3.4 — AUDIT SUMMARY\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "for category, checks in result_checks.items():\n",
        "    print(\"\\n\", category.upper())\n",
        "\n",
        "    for name, passed in checks.items():\n",
