      "cell_type": "code",
      "source": [
        "\n",
        "# ================================================================\n",
        "# EXPERIMENT 20 — PHASE 5.1 CLOSURE VERIFICATION\n",
        "# TARGET: TABLE CAPTIONS + PHASE 4.6 CORRECTION EVIDENCE\n",
        "#\n",
        "# READ-ONLY:\n",
        "# - Does not modify manuscripts.\n",
        "# - Does not modify historical audit records.\n",
        "# - Creates new JSON and Markdown reports only.\n",
        "# ================================================================\n",
        "\n",
        "import os\n",
        "import re\n",
        "import json\n",
        "import hashlib\n",
        "from datetime import datetime, timezone\n",
        "from pathlib import Path\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 1. PATHS\n",
        "# ------------------------------------------------\n",
        "\n",
        "ROOT = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "\n",
        "PHASE46_DIR = ROOT / \"step_4_6_manuscript_reporting_audit\"\n",
        "PHASE47_DIR = ROOT / \"step_4_7_final_manuscript_audit\"\n",
        "PHASE51_DIR = ROOT / \"step_5_1_final_consistency_review\"\n",
        "\n",
        "PHASE46_MANUSCRIPT = (\n",
        "    PHASE46_DIR /\n",
        "    \"experiment20_integrated_manuscript_v2_phase46_final.md\"\n",
        ")\n",
        "\n",
        "PHASE46_CORRECTION = (\n",
        "    PHASE46_DIR /\n",
        "    \"experiment20_phase46_manuscript_correction_verification.json\"\n",
        ")\n",
        "\n",
        "PHASE46_HISTORICAL_AUDIT = (\n",
        "    PHASE46_DIR /\n",
        "    \"experiment20_phase46_manuscript_reporting_audit.json\"\n",
        ")\n",
        "\n",
        "PHASE47_MANUSCRIPT = (\n",
        "    PHASE47_DIR /\n",
        "    \"experiment20_integrated_manuscript_v2_phase47_final.md\"\n",
        ")\n",
        "\n",
        "PHASE47_INSERTION_RECORD = (\n",
        "    PHASE47_DIR /\n",
        "    \"experiment20_phase47_conclusion_insertion_record.json\"\n",
        ")\n",
        "\n",
        "PHASE51_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 2. HELPERS\n",
        "# ------------------------------------------------\n",
        "\n",
        "def sha256_file(path):\n",
        "    h = hashlib.sha256()\n",
        "    with open(path, \"rb\") as f:\n",
        "        for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n",
        "            h.update(chunk)\n",
        "    return h.hexdigest()\n",
        "\n",
        "\n",
        "def load_json(path):\n",
        "    if not path.exists():\n",
        "        return None\n",
        "    with open(path, \"r\", encoding=\"utf-8\") as f:\n",
        "        return json.load(f)\n",
        "\n",
        "\n",
        "def recursive_key_values(obj, parent=\"\"):\n",
        "    \"\"\"Collect key/value pairs recursively for evidence inspection.\"\"\"\n",
        "    found = []\n",
        "\n",
        "    if isinstance(obj, dict):\n",
        "        for key, value in obj.items():\n",
        "            full_key = f\"{parent}.{key}\" if parent else str(key)\n",
        "            found.append((full_key, value))\n",
        "            found.extend(recursive_key_values(value, full_key))\n",
        "\n",
        "    elif isinstance(obj, list):\n",
        "        for i, value in enumerate(obj):\n",
        "            found.extend(recursive_key_values(value, f\"{parent}[{i}]\"))\n",
        "\n",
        "    return found\n",
        "\n",
        "\n",
        "def is_markdown_table_separator(line):\n",
        "    stripped = line.strip()\n",
        "    if \"|\" not in stripped:\n",
        "        return False\n",
        "\n",
        "    cells = [c.strip() for c in stripped.strip(\"|\").split(\"|\")]\n",
        "    if not cells:\n",
        "        return False\n",
        "\n",
        "    return all(\n",
        "        re.fullmatch(r\":?-{3,}:?\", cell) is not None\n",
        "        for cell in cells\n",
        "    )\n",
        "\n",
        "\n",
        "def find_markdown_tables(text):\n",
        "    \"\"\"\n",
        "    Identify Markdown table blocks by requiring:\n",
        "    - a header row containing pipes\n",
        "    - a separator row\n",
        "    - at least one subsequent row\n",
        "    \"\"\"\n",
        "    lines = text.splitlines()\n",
        "    tables = []\n",
        "\n",
        "    i = 0\n",
        "    while i < len(lines) - 1:\n",
        "        if (\n",
        "            \"|\" in lines[i]\n",
        "            and is_markdown_table_separator(lines[i + 1])\n",
        "        ):\n",
        "            start = i\n",
        "            j = i + 2\n",
        "\n",
        "            while j < len(lines) and \"|\" in lines[j].strip():\n",
        "                j += 1\n",
        "\n",
        "            block = lines[start:j]\n",
        "            tables.append({\n",
        "                \"start_line\": start + 1,\n",
        "                \"end_line\": j,\n",
        "                \"row_count\": len(block),\n",
        "                \"header\": lines[start].strip(),\n",
        "                \"body_rows\": max(0, len(block) - 2),\n",
        "                \"text\": \"\\n\".join(block)\n",
        "            })\n",
        "\n",
        "            i = j\n",
        "        else:\n",
        "            i += 1\n",
        "\n",
        "    return tables\n",
        "\n",
        "\n",
        "def inspect_table(text, table_number):\n",
        "    lines = text.splitlines()\n",
        "    tables = find_markdown_tables(text)\n",
        "\n",
        "    caption_pattern = re.compile(\n",
        "        rf\"^\\s*#{1,6}\\s*Table\\s+{table_number}\\s*[\\.:]\",\n",
        "        re.IGNORECASE\n",
        "    )\n",
        "\n",
        "    captions = []\n",
        "\n",
        "    for index, line in enumerate(lines):\n",
        "        if caption_pattern.search(line):\n",
        "            captions.append({\n",
        "                \"line\": index + 1,\n",
        "                \"text\": line.strip()\n",
        "            })\n",
        "\n",
        "    # Associate a caption with the closest following Markdown table.\n",
        "    associations = []\n",
        "\n",
        "    for caption in captions:\n",
        "        following = [\n",
        "            table for table in tables\n",
        "            if table[\"start_line\"] > caption[\"line\"]\n",
        "        ]\n",
        "\n",
        "        associated_table = following[0] if following else None\n",
        "\n",
        "        associations.append({\n",
        "            \"caption\": caption,\n",
        "            \"associated_table\": associated_table\n",
        "        })\n",
        "\n",
        "    valid_association = (\n",
        "        len(captions) == 1\n",
        "        and len(associations) == 1\n",
        "        and associations[0][\"associated_table\"] is not None\n",
        "        and associations[0][\"associated_table\"][\"body_rows\"] >= 1\n",
        "    )\n",
        "\n",
        "    return {\n",
        "        \"table_number\": table_number,\n",
        "        \"caption_count\": len(captions),\n",
        "        \"captions\": captions,\n",
        "        \"markdown_table_count\": len(tables),\n",
        "        \"associations\": [\n",
        "            {\n",
        "                \"caption\": item[\"caption\"],\n",
        "                \"table_start_line\": (\n",
        "                    item[\"associated_table\"][\"start_line\"]\n",
        "                    if item[\"associated_table\"] else None\n",
        "                ),\n",
        "                \"table_end_line\": (\n",
        "                    item[\"associated_table\"][\"end_line\"]\n",
        "                    if item[\"associated_table\"] else None\n",
        "                ),\n",
        "                \"table_body_rows\": (\n",
        "                    item[\"associated_table\"][\"body_rows\"]\n",
        "                    if item[\"associated_table\"] else None\n",
        "                )\n",
        "            }\n",
        "            for item in associations\n",
        "        ],\n",
        "        \"valid\": valid_association\n",
        "    }\n",
        "\n",
        "\n",
        "def find_table_mentions(text):\n",
        "    return sorted(set(\n",
        "        int(x)\n",
        "        for x in re.findall(\n",
        "            r\"\\bTable\\s+([1-9][0-9]*)\\b\",\n",
        "            text,\n",
        "            flags=re.IGNORECASE\n",
        "        )\n",
        "    ))\n",
        "\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 3. CHECK REQUIRED FILES\n",
        "# ------------------------------------------------\n",
        "\n",
        "required_files = {\n",
        "    \"phase46_manuscript\": PHASE46_MANUSCRIPT,\n",
        "    \"phase46_correction_record\": PHASE46_CORRECTION,\n",
        "    \"phase46_historical_audit\": PHASE46_HISTORICAL_AUDIT,\n",
        "    \"phase47_manuscript\": PHASE47_MANUSCRIPT,\n",
        "    \"phase47_insertion_record\": PHASE47_INSERTION_RECORD\n",
        "}\n",
        "\n",
        "missing_files = [\n",
        "    name for name, path in required_files.items()\n",
        "    if not path.exists()\n",
        "]\n",
        "\n",
        "print(\"=\" * 78)\n",
        "print(\"EXPERIMENT 20 — PHASE 5.1 CLOSURE VERIFICATION\")\n",
        "print(\"=\" * 78)\n",
        "\n",
        "for name, path in required_files.items():\n",
        "    print(f\"{name}: {'FOUND' if path.exists() else 'MISSING'}\")\n",
        "    print(f\"  {path}\")\n",
        "\n",
        "if missing_files:\n",
        "    raise FileNotFoundError(\n",
        "        \"Required files missing: \" + \", \".join(missing_files)\n",
        "    )\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 4. LOAD MANUSCRIPTS AND RECORDS\n",
        "# ------------------------------------------------\n",
        "\n",
        "phase46_text = PHASE46_MANUSCRIPT.read_text(encoding=\"utf-8\")\n",
        "phase47_text = PHASE47_MANUSCRIPT.read_text(encoding=\"utf-8\")\n",
        "\n",
        "phase46_correction = load_json(PHASE46_CORRECTION)\n",
        "phase46_historical = load_json(PHASE46_HISTORICAL_AUDIT)\n",
        "phase47_insertion = load_json(PHASE47_INSERTION_RECORD)\n",
        "\n",
        "phase46_hash_before = sha256_file(PHASE46_MANUSCRIPT)\n",
        "phase47_hash_before = sha256_file(PHASE47_MANUSCRIPT)\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 5. INSPECT TABLES IN BOTH MANUSCRIPTS\n",
        "# ------------------------------------------------\n",
        "\n",
        "table_results = {}\n",
        "\n",
        "for phase_name, manuscript in [\n",
        "    (\"phase46\", phase46_text),\n",
        "    (\"phase47\", phase47_text)\n",
        "]:\n",
        "    table_results[phase_name] = {}\n",
        "\n",
        "    print(f\"\\n--- {phase_name.upper()} TABLE INSPECTION ---\")\n",
        "\n",
        "    mentions = find_table_mentions(manuscript)\n",
        "    print(\"Table numbers mentioned:\", mentions)\n",
        "\n",
        "    for number in [1, 2]:\n",
        "        result = inspect_table(manuscript, number)\n",
        "        table_results[phase_name][str(number)] = result\n",
        "\n",
        "        print(f\"\\nTable {number}\")\n",
        "        print(\"  Caption count:\", result[\"caption_count\"])\n",
        "        print(\"  Caption:\", result[\"captions\"])\n",
        "        print(\"  Caption-to-table association:\", result[\"associations\"])\n",
        "        print(\"  VALID:\", result[\"valid\"])\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 6. INSPECT PHASE 4.6 CORRECTION RECORD\n",
        "# ------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 78)\n",
        "print(\"PHASE 4.6 CORRECTION RECORD — RAW EVIDENCE\")\n",
        "print(\"=\" * 78)\n",
        "\n",
        "print(json.dumps(\n",
        "    phase46_correction,\n",
        "    indent=2,\n",
        "    ensure_ascii=False\n",
        "))\n",
        "\n",
        "correction_pairs = recursive_key_values(phase46_correction)\n",
        "\n",
        "caption_related_evidence = []\n",
        "\n",
        "for key, value in correction_pairs:\n",
        "    if re.search(r\"caption|table|reference\", key, re.IGNORECASE):\n",
        "        caption_related_evidence.append({\n",
        "            \"key\": key,\n",
        "            \"value\": value\n",
        "        })\n",
        "\n",
        "print(\"\\nCAPTION/TABLE/REFERENCE-RELATED FIELDS:\")\n",
        "print(json.dumps(\n",
        "    caption_related_evidence,\n",
        "    indent=2,\n",
        "    ensure_ascii=False\n",
        "))\n",
        "\n",
        "correction_failed_checks = phase46_correction.get(\n",
        "    \"failed_checks\", None\n",
        ")\n",
        "\n",
        "correction_status = phase46_correction.get(\n",
        "    \"status\",\n",
        "    phase46_correction.get(\"overall_status\", \"NOT_RECORDED\")\n",
        ")\n",
        "\n",
        "# Determine whether the record contains explicit evidence of\n",
        "# caption-related correction, rather than merely an empty failure list.\n",
        "caption_evidence_text = json.dumps(\n",
        "    caption_related_evidence,\n",
        "    ensure_ascii=False\n",
        ").lower()\n",
        "\n",
        "explicit_caption_evidence = (\n",
        "    bool(caption_related_evidence)\n",
        "    and any(\n",
        "        word in caption_evidence_text\n",
        "        for word in [\n",
        "            \"pass\", \"verified\", \"true\",\n",
        "            \"corrected\", \"caption\", \"table\"\n",
        "        ]\n",
        "    )\n",
        ")\n",
        "\n",
        "print(\"\\nCorrection record status:\", correction_status)\n",
        "print(\"Correction failed_checks:\", correction_failed_checks)\n",
        "print(\"Explicit caption-related evidence found:\", explicit_caption_evidence)\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 7. INSPECT HISTORICAL PHASE 4.6 FAILURE\n",
        "# ------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 78)\n",
        "print(\"PHASE 4.6 HISTORICAL AUDIT\")\n",
        "print(\"=\" * 78)\n",
        "\n",
        "historical_failed = phase46_historical.get(\"failed_checks\", [])\n",
        "\n",
        "print(\"Historical status:\",\n",
        "      phase46_historical.get(\n",
        "          \"status\",\n",
        "          phase46_historical.get(\"overall_status\", \"NOT_RECORDED\")\n",
        "      ))\n",
        "\n",
        "print(\"Historical failed checks:\")\n",
        "print(json.dumps(\n",
        "    historical_failed,\n",
        "    indent=2,\n",
        "    ensure_ascii=False\n",
        "))\n",
        "\n",
        "historical_caption_failure = any(\n",
        "    \"caption\" in str(item).lower()\n",
        "    or (\n",
        "        isinstance(item, dict)\n",
        "        and \"caption\" in json.dumps(item).lower()\n",
        "    )\n",
        "    for item in historical_failed\n",
        ")\n",
        "\n",
        "print(\"Historical caption-related failure found:\",\n",
        "      historical_caption_failure)\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 8. INSPECT PHASE 4.7 INSERTION RECORD\n",
        "# ------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 78)\n",
        "print(\"PHASE 4.7 INSERTION RECORD\")\n",
        "print(\"=\" * 78)\n",
        "\n",
        "print(json.dumps(\n",
        "    phase47_insertion,\n",
        "    indent=2,\n",
        "    ensure_ascii=False\n",
        "))\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 9. CHECK BIBLIOGRAPHY STRUCTURE\n",
        "# ------------------------------------------------\n",
        "\n",
        "def extract_references(text):\n",
        "    match = re.search(\n",
        "        r\"(?im)^#{1,6}\\s*References\\s*$\",\n",
        "        text\n",
        "    )\n",
        "\n",
        "    if not match:\n",
        "        return []\n",
        "\n",
        "    section = text[match.end():]\n",
        "    next_heading = re.search(r\"(?m)^#{1,6}\\s+\", section)\n",
        "\n",
        "    if next_heading:\n",
        "        section = section[:next_heading.start()]\n",
        "\n",
        "    return [\n",
        "        line.strip()\n",
        "        for line in section.splitlines()\n",
        "        if line.strip()\n",
        "        and not line.strip().startswith(\"#\")\n",
        "    ]\n",
        "\n",
        "\n",
        "references = extract_references(phase47_text)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 78)\n",
        "print(\"BIBLIOGRAPHY STRUCTURAL CHECK\")\n",
        "print(\"=\" * 78)\n",
        "\n",
        "print(\"Non-empty reference lines:\", len(references))\n",
        "\n",
        "for index, reference in enumerate(references, 1):\n",
        "    print(f\"{index}. {reference}\")\n",
        "\n",
        "# This is intentionally NOT an authenticity test.\n",
        "bibliography_authenticity = \"NOT_VERIFIABLE_OFFLINE\"\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 10. FINAL INTEGRITY CHECK\n",
        "# ------------------------------------------------\n",
        "\n",
        "phase46_hash_after = sha256_file(PHASE46_MANUSCRIPT)\n",
        "phase47_hash_after = sha256_file(PHASE47_MANUSCRIPT)\n",
        "\n",
        "manuscripts_unchanged = (\n",
        "    phase46_hash_before == phase46_hash_after\n",
        "    and phase47_hash_before == phase47_hash_after\n",
        ")\n",
        "\n",
        "phase46_tables_valid = all(\n",
        "    table_results[\"phase46\"][str(n)][\"valid\"]\n",
        "    for n in [1, 2]\n",
        ")\n",
        "\n",
        "phase47_tables_valid = all(\n",
        "    table_results[\"phase47\"][str(n)][\"valid\"]\n",
        "    for n in [1, 2]\n",
        ")\n",
        "\n",
        "all_tables_valid = phase46_tables_valid and phase47_tables_valid\n",
        "\n",
        "correction_has_no_recorded_failures = (\n",
        "    correction_failed_checks == []\n",
        ")\n",
        "\n",
        "historical_failure_resolved_by_record = (\n",
        "    historical_caption_failure\n",
        "    and all_tables_valid\n",
        "    and correction_has_no_recorded_failures\n",
        "    and explicit_caption_evidence\n",
        ")\n",
        "\n",
        "# Do not infer closure from a keyword match alone.\n",
        "if not historical_caption_failure:\n",
        "    historical_caption_resolved = (\n",
        "        all_tables_valid and correction_has_no_recorded_failures\n",
        "    )\n",
        "else:\n",
        "    historical_caption_resolved = historical_failure_resolved_by_record\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 11. VERDICT\n",
        "# ------------------------------------------------\n",
        "\n",
        "checks = {\n",
        "    \"phase46_table_1_caption_and_body\": (\n",
        "        table_results[\"phase46\"][\"1\"][\"valid\"]\n",
        "    ),\n",
        "    \"phase46_table_2_caption_and_body\": (\n",
        "        table_results[\"phase46\"][\"2\"][\"valid\"]\n",
        "    ),\n",
        "    \"phase47_table_1_caption_and_body\": (\n",
        "        table_results[\"phase47\"][\"1\"][\"valid\"]\n",
        "    ),\n",
        "    \"phase47_table_2_caption_and_body\": (\n",
        "        table_results[\"phase47\"][\"2\"][\"valid\"]\n",
        "    ),\n",
        "    \"phase46_correction_record_no_failed_checks\": (\n",
        "        correction_has_no_recorded_failures\n",
        "    ),\n",
        "    \"historical_caption_failure_resolved_with_explicit_evidence\": (\n",
        "        historical_caption_resolved\n",
        "    ),\n",
        "    \"manuscripts_unchanged_during_verification\": manuscripts_unchanged\n",
        "}\n",
        "\n",
        "failed_checks = [\n",
        "    key for key, value in checks.items()\n",
        "    if value is not True\n",
        "]\n",
        "\n",
        "if failed_checks:\n",
        "    verdict = \"REVIEW REQUIRED — TABLE/CORRECTION EVIDENCE INCOMPLETE\"\n",
        "elif bibliography_authenticity == \"NOT_VERIFIABLE_OFFLINE\":\n",
        "    verdict = \"TABLE VERIFICATION PASSED — BIBLIOGRAPHY STILL REQUIRES REVIEW\"\n",
        "else:\n",
        "    verdict = \"PHASE 5.1 CLOSURE VERIFIED\"\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 12. BUILD REPORT\n",
        "# ------------------------------------------------\n",
        "\n",
        "timestamp = datetime.now(timezone.utc).strftime(\"%Y%m%dT%H%M%SZ\")\n",
        "\n",
        "report = {\n",
        "    \"experiment\": \"Experiment 20\",\n",
        "    \"phase\": \"5.1\",\n",
        "    \"verification_type\": \"Targeted closure verification\",\n",
        "    \"created_utc\": timestamp,\n",
        "    \"verdict\": verdict,\n",
        "    \"checks\": checks,\n",
        "    \"failed_checks\": failed_checks,\n",
        "    \"table_results\": table_results,\n",
        "    \"phase46_correction_record\": {\n",
        "        \"status\": correction_status,\n",
        "        \"failed_checks\": correction_failed_checks,\n",
        "        \"explicit_caption_related_evidence\": explicit_caption_evidence,\n",
        "        \"caption_related_fields\": caption_related_evidence\n",
        "    },\n",
        "    \"phase46_historical_audit\": {\n",
        "        \"historical_caption_failure_found\": historical_caption_failure,\n",
        "        \"failed_checks\": historical_failed\n",
        "    },\n",
        "    \"bibliography\": {\n",
        "        \"reference_lines_detected\": len(references),\n",
        "        \"entries\": references,\n",
        "        \"authenticity_status\": bibliography_authenticity,\n",
        "        \"note\": (\n",
        "            \"This offline verification checks bibliography structure only. \"\n",
        "            \"It does not verify DOI resolution, authorship, publication \"\n",
        "            \"metadata, or source authenticity.\"\n",
        "        )\n",
        "    },\n",
        "    \"integrity\": {\n",
        "        \"phase46_sha256_before\": phase46_hash_before,\n",
        "        \"phase46_sha256_after\": phase46_hash_after,\n",
        "        \"phase47_sha256_before\": phase47_hash_before,\n",
        "        \"phase47_sha256_after\": phase47_hash_after,\n",
        "        \"manuscripts_unchanged\": manuscripts_unchanged\n",
        "    },\n",
        "    \"source_files\": {\n",
        "        name: str(path)\n",
        "        for name, path in required_files.items()\n",
        "    }\n",
        "}\n",
        "\n",
        "json_path = (\n",
        "    PHASE51_DIR /\n",
        "    f\"experiment20_phase51_closure_verification_{timestamp}.json\"\n",
        ")\n",
        "\n",
        "md_path = (\n",
        "    PHASE51_DIR /\n",
        "    f\"experiment20_phase51_closure_verification_{timestamp}.md\"\n",
        ")\n",
        "\n",
        "with open(json_path, \"x\", encoding=\"utf-8\") as f:\n",
        "    json.dump(report, f, indent=2, ensure_ascii=False)\n",
        "\n",
        "markdown = f\"\"\"# Experiment 20 — Phase 5.1 Closure Verification\n",
        "\n",
        "**Created (UTC):** {timestamp}\n",
        "\n",
        "## Verdict\n",
        "\n",
        "{verdict}\n",
        "\n",
        "## Verification checks\n",
        "\n",
        "| Check | Result |\n",
        "|---|---|\n",
        "\"\"\" + \"\\n\".join(\n",
        "    f\"| {key} | {'PASS' if value else 'REVIEW'} |\"\n",
        "    for key, value in checks.items()\n",
        ") + f\"\"\"\n",
        "\n",
        "## Table verification\n",
        "\n",
        "### Phase 4.6\n",
        "\n",
        "- Table 1 valid: {table_results['phase46']['1']['valid']}\n",
        "- Table 2 valid: {table_results['phase46']['2']['valid']}\n",
        "\n",
        "### Phase 4.7\n",
        "\n",
        "- Table 1 valid: {table_results['phase47']['1']['valid']}\n",
        "- Table 2 valid: {table_results['phase47']['2']['valid']}\n",
        "\n",
        "## Phase 4.6 correction evidence\n",
        "\n",
        "- Correction status: {correction_status}\n",
        "- Failed checks: {correction_failed_checks}\n",
        "- Explicit caption-related evidence: {explicit_caption_evidence}\n",
        "- Historical caption failure found: {historical_caption_failure}\n",
        "- Historical caption failure resolved: {historical_caption_resolved}\n",
        "\n",
        "## Bibliography\n",
        "\n",
        "- Reference lines detected: {len(references)}\n",
        "- Authenticity status: {bibliography_authenticity}\n",
        "\n",
        "This verification does not establish DOI resolution, author identity,\n",
        "publication metadata, or bibliographic authenticity.\n",
        "\n",
        "## Integrity\n",
        "\n",
        "- Phase 4.6 manuscript unchanged: {phase46_hash_before == phase46_hash_after}\n",
        "- Phase 4.7 manuscript unchanged: {phase47_hash_before == phase47_hash_after}\n",
        "- Both manuscripts unchanged: {manuscripts_unchanged}\n",
        "\n",
        "## Failed checks\n",
        "\n",
        "{chr(10).join('- ' + item for item in failed_checks) if failed_checks else '- None'}\n",
        "\n",
        "## Scope\n",
        "\n",
        "This cell is read-only with respect to all existing manuscripts and audit\n",
        "records. It creates new Phase 5.1 closure verification reports only.\n",
        "\"\"\"\n",
        "\n",
        "with open(md_path, \"x\", encoding=\"utf-8\") as f:\n",
        "    f.write(markdown)\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 13. PRINT FINAL SUMMARY\n",
        "# ------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 78)\n",
        "print(\"PHASE 5.1 CLOSURE VERIFICATION SUMMARY\")\n",
        "print(\"=\" * 78)\n",
        "\n",
        "print(\"Verdict:\", verdict)\n",
        "print(\"Passed checks:\", sum(checks.values()), \"/\", len(checks))\n",
        "print(\"Failed/review checks:\", failed_checks)\n",
        "print(\"All table checks passed:\", all_tables_valid)\n",
        "print(\"Historical caption issue resolved:\", historical_caption_resolved)\n",
        "print(\"Bibliography authenticity:\", bibliography_authenticity)\n",
        "print(\"Manuscripts unchanged:\", manuscripts_unchanged)\n",
        "\n",
        "print(\"\\nNEW REPORTS CREATED:\")\n",
        "print(\"JSON:\", json_path)\n",
        "print(\"Markdown:\", md_path)\n",
        "\n",
        "print(\"\\nJSON SHA256:\", sha256_file(json_path))\n",
        "print(\"Markdown SHA256:\", sha256_file(md_path))\n",
        "\n",
        "print(\"\\nNo manuscript or historical audit record was modified.\")\n",
        "print(\"=\" * 78)\n"
      ],
