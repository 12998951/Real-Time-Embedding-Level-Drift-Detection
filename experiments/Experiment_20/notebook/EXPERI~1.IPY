            "===========================================================================\n",
            "CELL INDEX: 137\n",
            "CELL TYPE: markdown\n",
            "MATCHED TERMS: ['embedding']\n",
            "---------------------------------------------------------------------------\n",
            "### Step 17.10.6.4 — Research Documentation and Reproducibility Audit\n",
            "\n",
            "Objective: Audit the completeness, consistency, traceability, and reproducibility of Experiment 18 documentation.\n",
            "\n",
            "Scope:\n",
            "1. Verify experiment configuration and dataset descriptions.\n",
            "2. Verify saved archive and metadata references.\n",
            "3. Check consistency between reported numerical findings and saved results.\n",
            "4. Confirm statistical test provenance and interpretation.\n",
            "5. Document software environment and methodological limitations.\n",
            "6. Identify missing evidence required for independent reproduction.\n",
            "7. Produce a final documentation audit report.\n",
            "\n",
            "Expected outcome: A traceable research documentation and reproducibility record.\n",
            "\n",
            "No new embedding extraction, model training, or experimental data generation.\n",
            "No modification of previously validated experiment results.\n",
            "\n",
            "===========================================================================\n",
            "CELL INDEX: 138\n",
            "CELL TYPE: code\n",
            "MATCHED TERMS: ['embedding']\n",
            "---------------------------------------------------------------------------\n",
            "\n",
            "# ============================================================\n",
            "# EXPERIMENT 18 — STEP 17.10.6.4\n",
            "# RESEARCH DOCUMENTATION AND REPRODUCIBILITY AUDIT\n",
            "# ============================================================\n",
            "\n",
            "import os\n",
            "import json\n",
            "import platform\n",
            "import importlib.metadata as package_metadata\n",
            "\n",
            "import numpy as np\n",
            "import pandas as pd\n",
            "import scipy\n",
            "from scipy.stats import wilcoxon\n",
            "\n",
            "print(\"=\" * 85)\n",
            "print(\"STEP 17.10.6.4 — RESEARCH DOCUMENTATION AND REPRODUCIBILITY AUDIT\")\n",
            "print(\"=\" * 85)\n",
            "\n",
            "audit_results = []\n",
            "\n",
            "def record_audit(name, passed, details=\"\"):\n",
            "    status = \"PASSED\" if passed else \"FAILED\"\n",
            "    audit_results.append({\n",
            "        \"Audit\": name,\n",
            "        \"Status\": status,\n",
            "        \"Details\": details\n",
            "    })\n",
            "    print(f\"[{status}] {name}\")\n",
            "    if details:\n",
            "        print(f\"         {details}\")\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 1. Verify saved experiment files\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n[1] SAVED FILE VERIFICATION\")\n",
            "\n",
            "experiment_dir = \"/content/drive/MyDrive/Experiment_18_Results\"\n",
            "\n",
            "expected_files = [\n",
            "    \"experiment18_facenet_lfw_embeddings.npz\",\n",
            "    \"experiment18_illumination_results.npz\",\n",
            "    \"illumination_identity_summary.csv\",\n",
            "    \"illumination_metadata.json\"\n",
            "]\n",
            "\n",
            "file_paths = {\n",
            "    filename: os.path.join(experiment_dir, filename)\n",
            "    for filename in expected_files\n",
            "}\n",
            "\n",
            "for filename, path in file_paths.items():\n",
            "    exists = os.path.isfile(path)\n",
            "    record_audit(\n",
            "        f\"File exists: {filename}\",\n",
            "        exists,\n",
            "        path if exists else \"File not found\"\n",
            "    )\n",
            "\n",
            "assert all(os.path.isfile(p) for p in file_paths.values()), (\n",
            "    \"One or more required experiment files are missing. \"\n",
            "    \"Check the Google Drive directory before continuing.\"\n",
            ")\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 2. Load saved archives and metadata\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n[2] ARCHIVE AND METADATA LOADING\")\n",
            "\n",
            "original_archive = np.load(\n",
            "    file_paths[\"experiment18_facenet_lfw_embeddings.npz\"],\n",
            "    allow_pickle=False\n",
            ")\n",
            "\n",
            "illumination_archive = np.load(\n",
            "    file_paths[\"experiment18_illumination_results.npz\"],\n",
            "    allow_pickle=False\n",
            ")\n",
            "\n",
            "identity_csv = pd.read_csv(\n",
            "    file_paths[\"illumination_identity_summary.csv\"]\n",
            ")\n",
            "\n",
            "with open(\n",
            "    file_paths[\"illumination_metadata.json\"],\n",
            "    \"r\"\n",
            ") as file:\n",
            "    saved_metadata = json.load(file)\n",
            "\n",
            "record_audit(\n",
            "    \"Original embedding archive loaded\",\n",
            "    True,\n",
            "    f\"Keys: {list(original_archive.files)}\"\n",
            ")\n",
            "\n",
            "record_audit(\n",
            "    \"Illumination archive loaded\",\n",
            "    True,\n",
            "    f\"Keys: {list(illumination_archive.files)}\"\n",
            ")\n",
            "\n",
            "record_audit(\n",
            "    \"Identity CSV loaded\",\n",
            "    True,\n",
            "    f\"Rows: {len(identity_csv)}\"\n",
            ")\n",
            "\n",
            "record_audit(\n",
            "    \"Metadata JSON loaded\",\n",
            "    True,\n",
            "    f\"Experiment: {saved_metadata.get('experiment')}\"\n",
            ")\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 3. Verify original embedding archive\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n[3] ORIGINAL EMBEDDING ARCHIVE\")\n",
            "\n",
            "original_expected_shapes = {\n",
            "    \"reference_embeddings\": (1460, 512),\n",
            "    \"reference_labels\": (1460,),\n",
            "    \"calibration_embeddings\": (568, 512),\n",
            "    \"calibration_labels\": (568,),\n",
            "    \"evaluation_embeddings\": (956, 512),\n",
            "    \"evaluation_labels\": (956,)\n",
            "}\n",
            "\n",
            "for key, expected_shape in original_expected_shapes.items():\n",
            "\n",
            "    present = key in original_archive.files\n",
            "\n",
            "    if present:\n",
            "        actual_shape = original_archive[key].shape\n",
            "        shape_ok = actual_shape == expected_shape\n",
            "    else:\n",
            "        actual_shape = \"MISSING\"\n",
            "        shape_ok = False\n",
            "\n",
            "    record_audit(\n",
            "        f\"Original archive: {key}\",\n",
            "        shape_ok,\n",
            "        f\"Expected: {expected_shape}; Actual: {actual_shape}\"\n",
            "    )\n",
            "\n",
            "for key in [\n",
            "    \"reference_embeddings\",\n",
            "    \"calibration_embeddings\",\n",
            "    \"evaluation_embeddings\"\n",
            "]:\n",
            "    if key in original_archive.files:\n",
            "        finite = np.isfinite(original_archive[key]).all()\n",
            "\n",
            "        record_audit(\n",
            "            f\"Finite values: {key}\",\n",
            "            finite\n",
            "        )\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 4. Verify illumination archive\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n[4] ILLUMINATION ARCHIVE\")\n",
            "\n",
            "required_illumination_keys = [\n",
            "    \"original_embeddings\",\n",
            "    \"low_illumination_embeddings\",\n",
            "    \"high_illumination_embeddings\",\n",
            "    \"paired_labels\",\n",
            "    \"common_positions\",\n",
            "    \"low_displacement\",\n",
            "    \"high_displacement\",\n",
            "    \"low_success\",\n",
            "    \"high_success\",\n",
            "    \"low_failures\",\n",
            "    \"high_failures\"\n",
            "]\n",
            "\n",
            "for key in required_illumination_keys:\n",
            "\n",
            "    present = key in illumination_archive.files\n",
            "\n",
            "    record_audit(\n",
            "        f\"Illumination key: {key}\",\n",
            "        present\n",
            "    )\n",
            "\n",
            "assert all(\n",
            "    key in illumination_archive.files\n",
            "    for key in required_illumination_keys\n",
            "), \"Required illumination archive arrays are missing.\"\n",
            "\n",
            "\n",
            "original_emb = illumination_archive[\"original_embeddings\"]\n",
            "low_emb = illumination_archive[\"low_illumination_embeddings\"]\n",
            "high_emb = illumination_archive[\"high_illumination_embeddings\"]\n",
            "\n",
            "paired_labels = illumination_archive[\"paired_labels\"]\n",
            "\n",
            "low_saved_displacement = illumination_archive[\"low_displacement\"]\n",
            "high_saved_displacement = illumination_archive[\"high_displacement\"]\n",
            "\n",
            "record_audit(\n",
            "    \"Paired embedding shapes\",\n",
            "    (\n",
            "        original_emb.shape == (889, 512)\n",
            "        and low_emb.shape == (889, 512)\n",
            "        and high_emb.shape == (889, 512)\n",
            "    ),\n",
            "    f\"Original: {original_emb.shape}; \"\n",
            "    f\"Low: {low_emb.shape}; High: {high_emb.shape}\"\n",
            ")\n",
            "\n",
            "record_audit(\n",
            "    \"Paired label alignment\",\n",
            "    paired_labels.shape == (889,),\n",
            "    f\"Labels: {paired_labels.shape}\"\n",
            ")\n",
            "\n",
            "all_finite = all([\n",
            "    np.isfinite(original_emb).all(),\n",
            "    np.isfinite(low_emb).all(),\n",
            "    np.isfinite(high_emb).all(),\n",
            "    np.isfinite(low_saved_displacement).all(),\n",
            "    np.isfinite(high_saved_displacement).all()\n",
            "])\n",
            "\n",
            "record_audit(\n",
            "    \"Illumination arrays contain finite values\",\n",
            "    all_finite\n",
            ")\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 5. Independently reproduce embedding displacement\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n[5] DISPLACEMENT REPRODUCIBILITY\")\n",
            "\n",
            "recalculated_low = np.linalg.norm(\n",
            "    low_emb - original_emb,\n",
            "    axis=1\n",
            ")\n",
            "\n",
            "recalculated_high = np.linalg.norm(\n",
            "    high_emb - original_emb,\n",
            "    axis=1\n",
            ")\n",
            "\n",
            "low_exact_match = np.allclose(\n",
            "    recalculated_low,\n",
            "    low_saved_displacement,\n",
            "    rtol=0,\n",
            "    atol=1e-7\n",
            ")\n",
            "\n",
            "high_exact_match = np.allclose(\n",
            "    recalculated_high,\n",
            "    high_saved_displacement,\n",
            "    rtol=0,\n",
            "    atol=1e-7\n",
            ")\n",
            "\n",
            "record_audit(\n",
            "    \"Low displacement reproduction\",\n",
            "    low_exact_match,\n",
            "    f\"Maximum absolute difference: \"\n",
            "    f\"{np.max(np.abs(recalculated_low - low_saved_displacement)):.12f}\"\n",
            ")\n",
            "\n",
            "record_audit(\n",
            "    \"High displacement reproduction\",\n",
            "    high_exact_match,\n",
            "    f\"Maximum absolute difference: \"\n",
            "    f\"{np.max(np.abs(recalculated_high - high_saved_displacement)):.12f}\"\n",
            ")\n",
            "\n",
            "low_mean = float(np.mean(recalculated_low))\n",
            "high_mean = float(np.mean(recalculated_high))\n",
            "\n",
            "low_median = float(np.median(recalculated_low))\n",
            "high_median = float(np.median(recalculated_high))\n",
            "\n",
            "displacement_summary = pd.DataFrame([\n",
            "    {\n",
            "        \"Condition\": \"Low illumination\",\n",
            "        \"Mean\": low_mean,\n",
            "        \"Median\": low_median,\n",
            "        \"Standard Deviation\": np.std(recalculated_low)\n",
            "    },\n",
            "    {\n",
            "        \"Condition\": \"High illumination\",\n",
            "        \"Mean\": high_mean,\n",
            "        \"Median\": high_median,\n",
            "        \"Standard Deviation\": np.std(recalculated_high)\n",
            "    }\n",
            "])\n",
            "\n",
            "display(displacement_summary)\n",
            "\n",
            "record_audit(\n",
            "    \"High mean displacement exceeds low mean displacement\",\n",
            "    high_mean > low_mean,\n",
            "    f\"Low: {low_mean:.9f}; High: {high_mean:.9f}\"\n",
            ")\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 6. Verify saved metadata\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n[6] METADATA CONSISTENCY\")\n",
            "\n",
            "metadata_checks = {\n",
            "    \"dataset\": saved_metadata.get(\"dataset\") == \"LFW filtered subset\",\n",
            "    \"model\": saved_metadata.get(\"model\") == \"InceptionResnetV1\",\n",
            "    \"pretrained weights\": saved_metadata.get(\"pretrained_weights\") == \"VGGFace2\",\n",
            "    \"embedding dimension\": saved_metadata.get(\"embedding_dimension\") == 512,\n",
            "    \"paired images\": saved_metadata.get(\"paired_images\") == 889,\n",
            "    \"evaluation identities\": saved_metadata.get(\"evaluation_identities\") == 13\n",
            "}\n",
            "\n",
            "for name, passed in metadata_checks.items():\n",
            "    record_audit(\n",
            "        f\"Metadata: {name}\",\n",
            "        passed,\n",
            "        str(saved_metadata.get(name.replace(\" \", \"_\")))\n",
            "    )\n",
            "\n",
            "record_audit(\n",
            "    \"Low displacement mean matches metadata\",\n",
            "    np.isclose(\n",
            "        low_mean,\n",
            "        saved_metadata.get(\"mean_low_displacement\", np.nan),\n",
            "        atol=1e-7\n",
            "    )\n",
            ")\n",
            "\n",
            "record_audit(\n",
            "    \"High displacement mean matches metadata\",\n",
            "    np.isclose(\n",
            "        high_mean,\n",
            "        saved_metadata.get(\"mean_high_displacement\", np.nan),\n",
            "        atol=1e-7\n",
            "    )\n",
            ")\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 7. Reproduce image-level and identity-level tests\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n[7] STATISTICAL REPRODUCIBILITY\")\n",
            "\n",
            "image_test = wilcoxon(\n",
            "    recalculated_high,\n",
            "    recalculated_low,\n",
            "    alternative=\"two-sided\"\n",
            ")\n",
            "\n",
            "image_p = float(image_test.pvalue)\n",
            "\n",
            "record_audit(\n",
            "    \"Image-level Wilcoxon reproduction\",\n",
            "    np.isclose(\n",
            "        image_p,\n",
            "        saved_metadata.get(\"image_level_wilcoxon_p\", np.nan),\n",
            "        rtol=1e-6,\n",
            "        atol=1e-100\n",
            "    ),\n",
            "    f\"Statistic: {image_test.statistic}; p-value: {image_p:.12e}\"\n",
            ")\n",
            "\n",
            "identity_df = pd.DataFrame({\n",
            "    \"Identity\": paired_labels,\n",
            "    \"Low\": recalculated_low,\n",
            "    \"High\": recalculated_high\n",
            "})\n",
            "\n",
            "identity_means = identity_df.groupby(\"Identity\")[\n",
            "    [\"Low\", \"High\"]\n",
            "].mean()\n",
            "\n",
            "identity_medians = identity_df.groupby(\"Identity\")[\n",
            "    [\"Low\", \"High\"]\n",
            "].median()\n",
            "\n",
            "mean_identity_test = wilcoxon(\n",
            "    identity_means[\"High\"],\n",
            "    identity_means[\"Low\"],\n",
            "    alternative=\"two-sided\"\n",
            ")\n",
            "\n",
            "median_identity_test = wilcoxon(\n",
            "    identity_medians[\"High\"],\n",
            "    identity_medians[\"Low\"],\n",
            "    alternative=\"two-sided\"\n",
            ")\n",
            "\n",
            "mean_identity_p = float(mean_identity_test.pvalue)\n",
            "median_identity_p = float(median_identity_test.pvalue)\n",
            "\n",
            "record_audit(\n",
            "    \"Mean-based identity Wilcoxon reproduction\",\n",
            "    np.isclose(\n",
            "        mean_identity_p,\n",
            "        0.001220703125,\n",
            "        atol=1e-12\n",
            "    ),\n",
            "    f\"Statistic: {mean_identity_test.statistic}; \"\n",
            "    f\"p-value: {mean_identity_p:.12f}\"\n",
            ")\n",
            "\n",
            "record_audit(\n",
            "    \"Median-based identity Wilcoxon reproduction\",\n",
            "    np.isclose(\n",
            "        median_identity_p,\n",
            "        0.001220703125,\n",
            "        atol=1e-12\n",
            "    ),\n",
            "    f\"Statistic: {median_identity_test.statistic}; \"\n",
            "    f\"p-value: {median_identity_p:.12f}\"\n",
            ")\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 8. Verify identity distribution and CSV\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n[8] IDENTITY DISTRIBUTION AND CSV\")\n",
            "\n",
            "identity_counts = (\n",
            "    pd.Series(paired_labels)\n",
            "    .value_counts()\n",
            "    .sort_index()\n",
            ")\n",
            "\n",
            "identity_distribution_df = (\n",
            "    identity_counts\n",
            "    .rename_axis(\"Identity\")\n",
            "    .reset_index(name=\"Image_Count\")\n",
            ")\n",
            "\n",
            "print(\"Identity distribution:\")\n",
            "display(identity_distribution_df)\n",
            "\n",
            "record_audit(\n",
            "    \"Exactly 13 identities\",\n",
            "    len(identity_counts) == 13,\n",
            "    f\"Observed identities: {len(identity_counts)}\"\n",
            ")\n",
            "\n",
            "record_audit(\n",
            "    \"Identity 14 count\",\n",
            "    int(identity_counts.get(14, 0)) == 504,\n",
            "    f\"Observed count: {identity_counts.get(14, 0)}\"\n",
            ")\n",
            "\n",
            "required_csv_columns = [\n",
            "    \"Identity\",\n",
            "    \"Image_Count\",\n",
            "    \"Low_Median\",\n",
            "    \"High_Median\",\n",
            "    \"Median_Difference\"\n",
            "]\n",
            "\n",
            "csv_columns_ok = all(\n",
            "    column in identity_csv.columns\n",
            "    for column in required_csv_columns\n",
            ")\n",
            "\n",
            "record_audit(\n",
            "    \"Identity CSV columns\",\n",
            "    csv_columns_ok,\n",
            "    f\"Columns: {list(identity_csv.columns)}\"\n",
            ")\n",
            "\n",
            "if csv_columns_ok:\n",
            "\n",
            "    csv_identity_counts = (\n",
            "        identity_csv.set_index(\"Identity\")[\"Image_Count\"]\n",
            "        .sort_index()\n",
            "    )\n",
            "\n",
            "    counts_match = csv_identity_counts.equals(\n",
            "        identity_counts.rename_axis(\"Identity\")\n",
            "    )\n",
            "\n",
            "    record_audit(\n",
            "        \"CSV identity counts match archive\",\n",
            "        counts_match\n",
            "    )\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 9. Verify detector analysis tables\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n[9] DETECTOR ANALYSIS TRACEABILITY\")\n",
            "\n",
            "detector_tables_available = all(\n",
            "    name in globals()\n",
            "    for name in [\n",
            "        \"evaluation_detector_df\",\n",
            "        \"identity_detector_df\",\n",
            "        \"effect_size_df\",\n",
            "        \"statistical_findings\"\n",
            "    ]\n",
            ")\n",
            "\n",
            "record_audit(\n",
            "    \"Detector analysis tables available\",\n",
            "    detector_tables_available\n",
            ")\n",
            "\n",
            "if detector_tables_available:\n",
            "\n",
            "    record_audit(\n",
            "        \"Aggregate detector table dimensions\",\n",
            "        len(evaluation_detector_df) == 3,\n",
            "        f\"Rows: {len(evaluation_detector_df)}\"\n",
            "    )\n",
            "\n",
            "    record_audit(\n",
            "        \"Identity detector table dimensions\",\n",
            "        len(identity_detector_df) == 26,\n",
            "        f\"Rows: {len(identity_detector_df)}\"\n",
            "    )\n",
            "\n",
            "    record_audit(\n",
            "        \"Effect-size table dimensions\",\n",
            "        len(effect_size_df) == 2,\n",
            "        f\"Rows: {len(effect_size_df)}\"\n",
            "    )\n",
            "\n",
            "    print(\"\\nAggregate detector findings:\")\n",
            "    display(evaluation_detector_df)\n",
            "\n",
            "    print(\"\\nDetector effect sizes:\")\n",
            "    display(effect_size_df)\n",
            "\n",
            "    print(\n",
            "        \"\\nNote: Detector-response statistics are checked against \"\n",
            "        \"the previously validated in-memory analysis tables. \"\n",
            "        \"They are not independently regenerated from the original \"\n",
            "        \"image-level detector pipeline in this audit.\"\n",
            "    )\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 10. Record software environment\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n[10] SOFTWARE ENVIRONMENT\")\n",
            "\n",
            "packages = [\n",
            "    \"numpy\",\n",
            "    \"pandas\",\n",
            "    \"scipy\",\n",
            "    \"matplotlib\",\n",
            "    \"torch\",\n",
            "    \"torchvision\",\n",
            "    \"facenet-pytorch\",\n",
            "    \"scikit-learn\",\n",
            "    \"Pillow\"\n",
            "]\n",
            "\n",
            "environment_records = []\n",
            "\n",
            "for package in packages:\n",
            "\n",
            "    try:\n",
            "        version = package_metadata.version(package)\n",
            "    except package_metadata.PackageNotFoundError:\n",
            "        version = \"Not installed or unavailable\"\n",
            "\n",
            "    environment_records.append({\n",
            "        \"Package\": package,\n",
            "        \"Version\": version\n",
            "    })\n",
            "\n",
            "environment_df = pd.DataFrame(environment_records)\n",
            "\n",
            "print(\"Python:\", platform.python_version())\n",
            "print(\"Platform:\", platform.platform())\n",
            "\n",
            "display(environment_df)\n",
            "\n",
            "record_audit(\n",
            "    \"Software environment recorded\",\n",
            "    True,\n",
            "    f\"Python {platform.python_version()}\"\n",
            ")\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 11. Final audit report\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n\" + \"=\" * 85)\n",
            "print(\"FINAL REPRODUCIBILITY AUDIT REPORT\")\n",
            "print(\"=\" * 85)\n",
            "\n",
            "audit_df = pd.DataFrame(audit_results)\n",
            "\n",
            "display(audit_df)\n",
            "\n",
            "passed_count = int(\n",
            "    (audit_df[\"Status\"] == \"PASSED\").sum()\n",
            ")\n",
            "\n",
            "failed_count = int(\n",
            "    (audit_df[\"Status\"] == \"FAILED\").sum()\n",
            ")\n",
            "\n",
            "total_count = len(audit_df)\n",
            "\n",
            "print(f\"\\nTotal audit checks: {total_count}\")\n",
            "print(f\"Passed: {passed_count}\")\n",
            "print(f\"Failed: {failed_count}\")\n",
            "\n",
            "print(\"\\nDOCUMENTATION STATUS\")\n",
            "print(\"Saved files: CHECKED\")\n",
            "print(\"Embedding archive: CHECKED\")\n",
            "print(\"Illumination archive: CHECKED\")\n",
            "print(\"Metadata consistency: CHECKED\")\n",
            "print(\"Displacement reproduction: CHECKED\")\n",
            "print(\"Statistical reproduction: CHECKED\")\n",
            "print(\"Identity distribution: CHECKED\")\n",
            "print(\"Detector analysis traceability: CHECKED\")\n",
            "print(\"Software environment: RECORDED\")\n",
            "\n",
            "print(\"\\nIMPORTANT LIMITATION\")\n",
            "print(\n",
            "    \"This audit verifies saved outputs and selected numerical \"\n",
            "    \"reproductions. It does not independently rerun the original \"\n",
            "    \"image detection, preprocessing, embedding extraction, or \"\n",
            "    \"detector calibration pipeline.\"\n",
            ")\n",
            "\n",
            "print(\"\\nNo saved experiment files modified.\")\n",
            "print(\"No model training performed.\")\n",
            "print(\"No new embedding extraction performed.\")\n",
            "\n",
            "if failed_count == 0:\n",
            "    print(\"\\nSTEP 17.10.6.4 — AUDIT PASSED\")\n",
            "else:\n",
            "    print(\n",
            "        \"\\nSTEP 17.10.6.4 — REVIEW REQUIRED: \"\n",
            "        f\"{failed_count} checks failed.\"\n",
            "    )\n",
            "\n",
            "print(\"=\" * 85)\n",
            "\n",
            "\n",
            "===========================================================================\n",
            "CELL INDEX: 139\n",
            "CELL TYPE: markdown\n",
            "MATCHED TERMS: ['embedding']\n",
            "---------------------------------------------------------------------------\n",
            "### Step 17.10.6.5 — Final Research Evidence Package\n",
            "\n",
            "Objective: Consolidate all validated Experiment 18 evidence into a final structured research record.\n",
            "\n",
            "Scope:\n",
            "1. Consolidate experimental configuration and dataset information.\n",
            "2. Summarise embedding extraction and controlled illumination methodology.\n",
            "3. Record aggregate and identity-level detector findings.\n",
            "4. Include verified displacement statistics and statistical tests.\n",
            "5. Document effect sizes, confidence intervals, and limitations.\n",
            "6. Record reproducibility audit results and software environment.\n",
            "7. Distinguish validated findings, exploratory observations, and unsupported claims.\n",
            "8. Prepare a traceable evidence package for future research writing.\n",
            "\n",
            "Expected outcome: A final, structured Experiment 18 research evidence record.\n",
            "\n",
            "No new embedding extraction, model training, or experimental data generation.\n",
            "No modification of validated experimental results.\n",
            "\n",
            "===========================================================================\n",
            "CELL INDEX: 140\n",
            "CELL TYPE: code\n",
            "MATCHED TERMS: ['embedding']\n",
            "---------------------------------------------------------------------------\n",
            "\n",
            "# ============================================================\n",
            "# EXPERIMENT 18 — STEP 17.10.6.5\n",
            "# FINAL RESEARCH EVIDENCE PACKAGE\n",
            "# Corrected version — uses validated in-memory results\n",
            "# ============================================================\n",
            "\n",
            "import os\n",
            "import sys\n",
            "import json\n",
            "import platform\n",
            "import numpy as np\n",
            "import pandas as pd\n",
            "import scipy\n",
            "import torch\n",
            "import torchvision\n",
            "import sklearn\n",
            "import PIL\n",
            "\n",
            "from datetime import datetime, timezone\n",
            "from importlib.metadata import version, PackageNotFoundError\n",
            "\n",
            "\n",
            "print(\"=\" * 80)\n",
            "print(\"STEP 17.10.6.5 — FINAL RESEARCH EVIDENCE PACKAGE\")\n",
            "print(\"=\" * 80)\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 1. CONFIGURATION AND REQUIRED FILE VERIFICATION\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "RESULTS_DIR = \"/content/drive/MyDrive/Experiment_18_Results\"\n",
            "\n",
            "ORIGINAL_ARCHIVE = os.path.join(\n",
            "    RESULTS_DIR,\n",
            "    \"experiment18_facenet_lfw_embeddings.npz\"\n",
            ")\n",
            "\n",
            "ILLUMINATION_ARCHIVE = os.path.join(\n",
            "    RESULTS_DIR,\n",
            "    \"experiment18_illumination_results.npz\"\n",
            ")\n",
            "\n",
            "METADATA_FILE = os.path.join(\n",
            "    RESULTS_DIR,\n",
            "    \"illumination_metadata.json\"\n",
            ")\n",
            "\n",
            "CSV_FILE = os.path.join(\n",
            "    RESULTS_DIR,\n",
            "    \"illumination_identity_summary.csv\"\n",
            ")\n",
            "\n",
            "required_files = [\n",
            "    ORIGINAL_ARCHIVE,\n",
            "    ILLUMINATION_ARCHIVE,\n",
            "    METADATA_FILE,\n",
            "    CSV_FILE\n",
            "]\n",
            "\n",
            "missing_files = [\n",
            "    path for path in required_files\n",
            "    if not os.path.isfile(path)\n",
            "]\n",
            "\n",
            "assert not missing_files, (\n",
            "    \"Required experiment files are missing:\\n\"\n",
            "    + \"\\n\".join(missing_files)\n",
            ")\n",
            "\n",
            "required_variables = [\n",
            "    \"evaluation_detector_df\",\n",
            "    \"identity_detector_df\",\n",
            "    \"statistical_results\",\n",
            "    \"effect_size_df\"\n",
            "]\n",
            "\n",
            "missing_variables = [\n",
            "    name for name in required_variables\n",
            "    if name not in globals()\n",
            "]\n",
            "\n",
            "assert not missing_variables, (\n",
            "    \"Required validated DataFrames are unavailable: \"\n",
            "    + \", \".join(missing_variables)\n",
            ")\n",
            "\n",
            "for name in required_variables:\n",
            "    assert isinstance(globals()[name], pd.DataFrame), (\n",
            "        f\"{name} is not a DataFrame.\"\n",
            "    )\n",
            "\n",
            "print(\"Section 1: Required files and detector tables verified.\")\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 2. LOAD EXISTING EXPERIMENT OUTPUTS\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "with np.load(\n",
            "    ORIGINAL_ARCHIVE,\n",
            "    allow_pickle=False\n",
            ") as original_data:\n",
            "\n",
            "    original_shapes = {\n",
            "        key: list(original_data[key].shape)\n",
            "        for key in original_data.files\n",
            "    }\n",
            "\n",
            "with np.load(\n",
            "    ILLUMINATION_ARCHIVE,\n",
            "    allow_pickle=False\n",
            ") as illumination_data:\n",
            "\n",
            "    illumination_shapes = {\n",
            "        key: list(illumination_data[key].shape)\n",
            "        for key in illumination_data.files\n",
            "    }\n",
            "\n",
            "    original_embeddings = illumination_data[\n",
            "        \"original_embeddings\"\n",
            "    ].copy()\n",
            "\n",
            "    low_embeddings = illumination_data[\n",
            "        \"low_illumination_embeddings\"\n",
            "    ].copy()\n",
            "\n",
            "    high_embeddings = illumination_data[\n",
            "        \"high_illumination_embeddings\"\n",
            "    ].copy()\n",
            "\n",
            "    paired_labels = illumination_data[\n",
            "        \"paired_labels\"\n",
            "    ].copy()\n",
            "\n",
            "    saved_low_displacement = illumination_data[\n",
            "        \"low_displacement\"\n",
            "    ].copy()\n",
            "\n",
            "    saved_high_displacement = illumination_data[\n",
            "        \"high_displacement\"\n",
            "    ].copy()\n",
            "\n",
            "with open(METADATA_FILE, \"r\", encoding=\"utf-8\") as file:\n",
            "    metadata = json.load(file)\n",
            "\n",
            "identity_csv = pd.read_csv(CSV_FILE)\n",
            "\n",
            "print(\"Section 2: Existing archives and metadata loaded.\")\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 3. DATASET COMPOSITION\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "assert original_embeddings.shape == low_embeddings.shape\n",
            "assert original_embeddings.shape == high_embeddings.shape\n",
            "assert original_embeddings.ndim == 2\n",
            "assert original_embeddings.shape[0] == len(paired_labels)\n",
            "assert original_embeddings.shape[1] == 512\n",
            "\n",
            "assert np.isfinite(original_embeddings).all()\n",
            "assert np.isfinite(low_embeddings).all()\n",
            "assert np.isfinite(high_embeddings).all()\n",
            "\n",
            "identity_values, identity_counts = np.unique(\n",
            "    paired_labels,\n",
            "    return_counts=True\n",
            ")\n",
            "\n",
            "identity_distribution = [\n",
            "    {\n",
            "        \"identity\": int(identity),\n",
            "        \"paired_image_count\": int(count)\n",
            "    }\n",
            "    for identity, count in zip(\n",
            "        identity_values,\n",
            "        identity_counts\n",
            "    )\n",
            "]\n",
            "\n",
            "paired_images = int(len(paired_labels))\n",
            "identity_count = int(len(identity_values))\n",
            "embedding_dimension = int(original_embeddings.shape[1])\n",
            "\n",
            "largest_identity_index = int(np.argmax(identity_counts))\n",
            "\n",
            "largest_identity = int(\n",
            "    identity_values[largest_identity_index]\n",
            ")\n",
            "\n",
            "largest_identity_count = int(\n",
            "    identity_counts[largest_identity_index]\n",
            ")\n",
            "\n",
            "largest_identity_share = (\n",
            "    largest_identity_count / paired_images\n",
            ")\n",
            "\n",
            "assert paired_images == 889\n",
            "assert identity_count == 13\n",
            "\n",
            "print(\"\\nSection 3: Dataset composition verified.\")\n",
            "print(\"Paired images:\", paired_images)\n",
            "print(\"Identities:\", identity_count)\n",
            "print(\"Embedding dimension:\", embedding_dimension)\n",
            "print(\"Largest identity:\", largest_identity)\n",
            "print(\"Largest identity share:\", f\"{largest_identity_share:.2%}\")\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 4. REPRODUCE SAVED EMBEDDING DISPLACEMENTS\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "recalculated_low = np.linalg.norm(\n",
            "    low_embeddings - original_embeddings,\n",
            "    axis=1\n",
            ")\n",
            "\n",
            "recalculated_high = np.linalg.norm(\n",
            "    high_embeddings - original_embeddings,\n",
            "    axis=1\n",
            ")\n",
            "\n",
            "low_max_error = float(\n",
            "    np.max(\n",
            "        np.abs(\n",
            "            recalculated_low - saved_low_displacement\n",
            "        )\n",
            "    )\n",
            ")\n",
            "\n",
            "high_max_error = float(\n",
            "    np.max(\n",
            "        np.abs(\n",
            "            recalculated_high - saved_high_displacement\n",
            "        )\n",
            "    )\n",
            ")\n",
            "\n",
            "assert low_max_error == 0.0, (\n",
            "    \"Low-illumination displacement reproduction failed.\"\n",
            ")\n",
            "\n",
            "assert high_max_error == 0.0, (\n",
            "    \"High-illumination displacement reproduction failed.\"\n",
            ")\n",
            "\n",
            "displacement_summary = {\n",
            "    \"low_illumination\": {\n",
            "        \"mean\": float(np.mean(saved_low_displacement)),\n",
            "        \"median\": float(np.median(saved_low_displacement)),\n",
            "        \"standard_deviation\": float(\n",
            "            np.std(saved_low_displacement)\n",
            "        )\n",
            "    },\n",
            "    \"high_illumination\": {\n",
            "        \"mean\": float(np.mean(saved_high_displacement)),\n",
            "        \"median\": float(np.median(saved_high_displacement)),\n",
            "        \"standard_deviation\": float(\n",
            "            np.std(saved_high_displacement)\n",
            "        )\n",
            "    },\n",
            "    \"high_minus_low_mean\": float(\n",
            "        np.mean(\n",
            "            saved_high_displacement - saved_low_displacement\n",
            "        )\n",
            "    ),\n",
            "    \"high_minus_low_median\": float(\n",
            "        np.median(\n",
            "            saved_high_displacement - saved_low_displacement\n",
            "        )\n",
            "    ),\n",
            "    \"reproduction_max_absolute_error\": {\n",
            "        \"low\": low_max_error,\n",
            "        \"high\": high_max_error\n",
            "    }\n",
            "}\n",
            "\n",
            "print(\"\\nSection 4: Displacement reproduction passed.\")\n",
            "print(\"Low maximum error:\", low_max_error)\n",
            "print(\"High maximum error:\", high_max_error)\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 5. HISTORICAL DISPLACEMENT STATISTICAL FINDINGS\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "displacement_tests = {\n",
            "    \"image_level\": {\n",
            "        \"unit_of_analysis\": \"paired images\",\n",
            "        \"sample_size\": 889,\n",
            "        \"wilcoxon_statistic\": 52705.0,\n",
            "        \"p_value\": 4.708938281282196e-80\n",
            "    },\n",
            "    \"identity_level_mean_displacement\": {\n",
            "        \"unit_of_analysis\": \"identity-level means\",\n",
            "        \"sample_size\": 13,\n",
            "        \"wilcoxon_statistic\": 3.0,\n",
            "        \"p_value\": 0.001220703125\n",
            "    },\n",
            "    \"identity_level_median_displacement\": {\n",
            "        \"unit_of_analysis\": \"identity-level medians\",\n",
            "        \"sample_size\": 13,\n",
            "        \"wilcoxon_statistic\": 3.0,\n",
            "        \"p_value\": 0.001220703125\n",
            "    }\n",
            "}\n",
            "\n",
            "print(\"\\nSection 5: Previously reproduced displacement statistics recorded.\")\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 6. CORRECTED DETECTOR STATISTICS AND EFFECT SIZES\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "expected_detectors = {\"Euclidean\", \"Mahalanobis\"}\n",
            "\n",
            "assert set(statistical_results[\"Detector\"]) == expected_detectors\n",
            "assert set(effect_size_df[\"Detector\"]) == expected_detectors\n",
            "\n",
            "expected_p_values = {\n",
            "    \"Euclidean\": 0.021484,\n",
            "    \"Mahalanobis\": 0.002441\n",
            "}\n",
            "\n",
            "expected_wilcoxon = {\n",
            "    \"Euclidean\": 13.0,\n",
            "    \"Mahalanobis\": 5.0\n",
            "}\n",
            "\n",
            "for detector in expected_detectors:\n",
            "\n",
            "    stat_row = statistical_results.loc[\n",
            "        statistical_results[\"Detector\"] == detector\n",
            "    ].iloc[0]\n",
            "\n",
            "    assert np.isclose(\n",
            "        float(stat_row[\"P-value\"]),\n",
            "        expected_p_values[detector],\n",
            "        atol=1e-6\n",
            "    ), f\"{detector} corrected p-value mismatch.\"\n",
            "\n",
            "    assert np.isclose(\n",
            "        float(stat_row[\"Wilcoxon Statistic\"]),\n",
            "        expected_wilcoxon[detector]\n",
            "    ), f\"{detector} corrected Wilcoxon statistic mismatch.\"\n",
            "\n",
            "detector_tests_df = statistical_results.merge(\n",
            "    effect_size_df,\n",
            "    on=\"Detector\",\n",
            "    how=\"inner\",\n",
            "    validate=\"one_to_one\"\n",
            ")\n",
            "\n",
            "assert len(detector_tests_df) == 2\n",
            "\n",
            "detector_tests_df = detector_tests_df.sort_values(\n",
            "    \"Detector\"\n",
            ").reset_index(drop=True)\n",
            "\n",
            "print(\"\\nSection 6: Corrected detector statistical results verified.\")\n",
            "display(detector_tests_df)\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 7. AGGREGATE AND IDENTITY-LEVEL DETECTOR EVIDENCE\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "aggregate_detector_records = (\n",
            "    evaluation_detector_df.to_dict(orient=\"records\")\n",
            ")\n",
            "\n",
            "identity_detector_records = (\n",
            "    identity_detector_df.to_dict(orient=\"records\")\n",
            ")\n",
            "\n",
            "effect_size_records = (\n",
            "    effect_size_df.to_dict(orient=\"records\")\n",
            ")\n",
            "\n",
            "# Calculate identity-level direction directly from the validated table.\n",
            "identity_pivot = identity_detector_df.pivot(\n",
            "    index=\"Identity\",\n",
            "    columns=\"Condition\",\n",
            "    values=[\"Euclidean\", \"Mahalanobis\"]\n",
            ")\n",
            "\n",
            "identity_direction_summary = {}\n",
            "\n",
            "for detector in [\"Euclidean\", \"Mahalanobis\"]:\n",
            "\n",
            "    low_values = identity_pivot[\n",
            "        (detector, \"Low illumination\")\n",
            "    ]\n",
            "\n",
            "    high_values = identity_pivot[\n",
            "        (detector, \"High illumination\")\n",
            "    ]\n",
            "\n",
            "    differences = high_values - low_values\n",
            "\n",
            "    identity_direction_summary[detector.lower()] = {\n",
            "        \"increased\": int((differences > 0).sum()),\n",
            "        \"decreased\": int((differences < 0).sum()),\n",
            "        \"unchanged\": int((differences == 0).sum()),\n",
            "        \"identities\": int(len(differences))\n",
            "    }\n",
            "\n",
            "assert identity_direction_summary[\"euclidean\"][\"increased\"] == 10\n",
            "assert identity_direction_summary[\"euclidean\"][\"decreased\"] == 3\n",
            "\n",
            "assert identity_direction_summary[\"mahalanobis\"][\"increased\"] == 11\n",
            "assert identity_direction_summary[\"mahalanobis\"][\"decreased\"] == 2\n",
            "\n",
            "print(\"\\nSection 7: Aggregate and identity-level detector evidence collected.\")\n",
            "print(identity_direction_summary)\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 8. SOFTWARE ENVIRONMENT\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "def get_package_version(package_name):\n",
            "    try:\n",
            "        return version(package_name)\n",
            "    except PackageNotFoundError:\n",
            "        return \"Not available\"\n",
            "\n",
            "\n",
            "software_environment = {\n",
            "    \"python\": platform.python_version(),\n",
            "    \"platform\": platform.platform(),\n",
            "    \"numpy\": np.__version__,\n",
            "    \"pandas\": pd.__version__,\n",
            "    \"scipy\": scipy.__version__,\n",
            "    \"pytorch\": torch.__version__,\n",
            "    \"torchvision\": torchvision.__version__,\n",
            "    \"scikit_learn\": sklearn.__version__,\n",
            "    \"pillow\": PIL.__version__,\n",
            "    \"facenet_pytorch\": get_package_version(\"facenet-pytorch\")\n",
            "}\n",
            "\n",
            "print(\"\\nSection 8: Software environment recorded.\")\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 9. EVIDENCE CLASSIFICATION\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "evidence_interpretation = {\n",
            "    \"validated\": [\n",
            "        \"Saved embedding arrays and dimensions were verified.\",\n",
            "        \"Saved low- and high-illumination displacement arrays were reproduced exactly.\",\n",
            "        \"Saved displacement summary statistics were reproduced.\",\n",
            "        \"Historical image-level and identity-level displacement tests were reproduced.\",\n",
            "        \"Saved identity summary CSV was checked for consistency.\",\n",
            "        \"The reproducibility audit passed 54 checks.\"\n",
            "    ],\n",
            "    \"exploratory\": [\n",
            "        \"Aggregate Euclidean and Mahalanobis detector responses varied across illumination conditions.\",\n",
            "        \"Identity-level detector responses varied across identities.\",\n",
            "        \"Corrected Euclidean and Mahalanobis detector-response tests were below the nominal 0.05 threshold.\",\n",
            "        \"Detector-response findings are based on only 13 identity-level observations.\"\n",
            "    ],\n",
            "    \"not_established\": [\n",
            "        \"Real-world biometric recognition accuracy.\",\n",
            "        \"Generalisation to other biometric datasets or models.\",\n",
            "        \"Demographic fairness.\",\n",
            "        \"Deployment readiness.\",\n",
            "        \"Causal explanation of detector-response differences.\"\n",
            "    ]\n",
            "}\n",
            "\n",
            "limitations = [\n",
            "    \"The corrected detector evaluation cohort contains 229 images from 13 identities.\",\n",
            "    \"The historical paired illumination cohort contains 889 images from 13 identities.\",\n",
            "    f\"Identity {largest_identity} contributes {largest_identity_share:.1%} of the historical paired images.\",\n",
            "    \"Image observations are clustered within identities and must not be treated as independent subjects.\",\n",
            "    \"Identity-level detector analyses have only 13 identity-level units.\",\n",
            "    \"The illumination changes were controlled brightness transformations.\",\n",
            "    \"Corrected detector-response p-values are nominal and have not been adjusted for multiple comparisons.\",\n",
            "    \"Detector-response findings rely on previously validated tables and were not recalibrated in this documentation step.\"\n",
            "]\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 10. BUILD STRUCTURED JSON EVIDENCE\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "evidence = {\n",
            "    \"experiment\": {\n",
            "        \"title\": \"Experiment 18 - Controlled Illumination\",\n",
            "        \"dataset\": \"LFW filtered subset\",\n",
            "        \"model\": \"InceptionResnetV1\",\n",
            "        \"pretrained_weights\": \"VGGFace2\",\n",
            "        \"embedding_dimension\": embedding_dimension,\n",
            "        \"brightness_factors\": {\n",
            "            \"low\": 0.5,\n",
            "            \"original\": 1.0,\n",
            "            \"high\": 1.5\n",
            "        }\n",
            "    },\n",
            "    \"dataset_summary\": {\n",
            "        \"paired_images\": paired_images,\n",
            "        \"evaluation_identities\": identity_count,\n",
            "        \"identity_distribution\": identity_distribution,\n",
            "        \"largest_identity\": largest_identity,\n",
            "        \"largest_identity_image_count\": largest_identity_count,\n",
            "        \"largest_identity_share\": largest_identity_share,\n",
            "        \"corrected_detector_evaluation_images\": 229\n",
            "    },\n",
            "    \"original_embedding_archive_shapes\": original_shapes,\n",
            "    \"illumination_archive_shapes\": illumination_shapes,\n",
            "    \"illumination_displacement\": displacement_summary,\n",
            "    \"displacement_statistical_tests\": displacement_tests,\n",
            "    \"aggregate_detector_results\": aggregate_detector_records,\n",
            "    \"identity_level_detector_results\": identity_detector_records,\n",
            "    \"detector_effect_sizes\": effect_size_records,\n",
            "    \"detector_statistical_tests\": detector_tests_df.to_dict(\n",
            "        orient=\"records\"\n",
            "    ),\n",
            "    \"identity_level_detector_directions\": identity_direction_summary,\n",
            "    \"reproducibility_audit\": {\n",
            "        \"step\": \"17.10.6.4\",\n",
            "        \"checks\": 54,\n",
            "        \"passed\": 54,\n",
            "        \"failed\": 0,\n",
            "        \"scope\": (\n",
            "            \"Verified saved outputs, array integrity, displacement \"\n",
            "            \"reproduction, statistical summaries, CSV consistency, \"\n",
            "            \"metadata consistency, and detector-table availability.\"\n",
            "        ),\n",
            "        \"limitation\": (\n",
            "            \"The audit did not independently rerun original image \"\n",
            "            \"detection, preprocessing, embedding extraction, or \"\n",
            "            \"detector calibration.\"\n",
            "        )\n",
            "    },\n",
            "    \"software_environment\": software_environment,\n",
            "    \"source_files\": [\n",
            "        os.path.basename(ORIGINAL_ARCHIVE),\n",
            "        os.path.basename(ILLUMINATION_ARCHIVE),\n",
            "        os.path.basename(METADATA_FILE),\n",
            "        os.path.basename(CSV_FILE)\n",
            "    ],\n",
            "    \"evidence_interpretation\": evidence_interpretation,\n",
            "    \"limitations\": limitations,\n",
            "    \"documentation_created_utc\": datetime.now(\n",
            "        timezone.utc\n",
            "    ).isoformat()\n",
            "}\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 11. CREATE MARKDOWN RESEARCH REPORT\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "report_path = os.path.join(\n",
            "    RESULTS_DIR,\n",
            "    \"experiment18_final_research_evidence.md\"\n",
            ")\n",
            "\n",
            "json_path = os.path.join(\n",
            "    RESULTS_DIR,\n",
            "    \"experiment18_final_research_evidence.json\"\n",
            ")\n",
            "\n",
            "markdown = f\"\"\"# Experiment 18 — Final Research Evidence Package\n",
            "\n",
            "## 1. Experiment Overview\n",
            "\n",
            "- Dataset: LFW filtered subset\n",
            "- Model: InceptionResnetV1\n",
            "- Pretrained weights: VGGFace2\n",
            "- Embedding dimension: {embedding_dimension}\n",
            "- Brightness factors: 0.5, 1.0, 1.5\n",
            "- Historical paired illumination images: {paired_images}\n",
            "- Identities in historical paired cohort: {identity_count}\n",
            "- Corrected detector evaluation cohort: 229 images\n",
            "\n",
            "## 2. Dataset Composition\n",
            "\n",
            "The historical paired illumination cohort contains {paired_images}\n",
            "images from {identity_count} identities.\n",
            "\n",
            "Identity {largest_identity} contributes {largest_identity_count}\n",
            "images ({largest_identity_share:.2%}) of the historical paired cohort.\n",
            "\n",
            "| Identity | Paired image count |\n",
            "|---:|---:|\n",
            "\"\"\"\n",
            "\n",
            "for item in identity_distribution:\n",
            "    markdown += (\n",
            "        f\"| {item['identity']} | \"\n",
            "        f\"{item['paired_image_count']} |\\n\"\n",
            "    )\n",
            "\n",
            "markdown += f\"\"\"\n",
            "## 3. Embedding Displacement\n",
            "\n",
            "| Statistic | Low illumination | High illumination |\n",
            "|---|---:|---:|\n",
            "| Mean | {displacement_summary['low_illumination']['mean']:.9f} | {displacement_summary['high_illumination']['mean']:.9f} |\n",
            "| Median | {displacement_summary['low_illumination']['median']:.9f} | {displacement_summary['high_illumination']['median']:.9f} |\n",
            "| Standard deviation | {displacement_summary['low_illumination']['standard_deviation']:.9f} | {displacement_summary['high_illumination']['standard_deviation']:.9f} |\n",
            "\n",
            "Mean high-minus-low displacement:\n",
            "{displacement_summary['high_minus_low_mean']:.9f}\n",
            "\n",
            "Median high-minus-low displacement:\n",
            "{displacement_summary['high_minus_low_median']:.9f}\n",
            "\n",
            "Displacement reproduction maximum absolute error:\n",
            "- Low: {low_max_error}\n",
            "- High: {high_max_error}\n",
            "\n",
            "## 4. Historical Displacement Statistical Tests\n",
            "\n",
            "| Analysis | Unit | n | Wilcoxon statistic | p-value |\n",
            "|---|---|---:|---:|---:|\n",
            "| Image-level | Paired images | 889 | 52705.0 | 4.708938281282196e-80 |\n",
            "| Identity-level means | Identities | 13 | 3.0 | 0.001220703125 |\n",
            "| Identity-level medians | Identities | 13 | 3.0 | 0.001220703125 |\n",
            "\n",
            "The image-level observations are clustered within identities and\n",
            "must not be interpreted as 889 independent subjects.\n",
            "\n",
            "## 5. Aggregate Detector Results\n",
            "\n",
            "{evaluation_detector_df.to_string(index=False)}\n",
            "\n",
            "## 6. Identity-Level Detector Results\n",
            "\n",
            "{identity_detector_df.to_string(index=False)}\n",
            "\n",
            "## 7. Corrected Detector Statistical Tests and Effect Sizes\n",
            "\n",
            "{detector_tests_df.to_string(index=False)}\n",
            "\n",
            "The corrected Euclidean paired detector-response test has\n",
            "Wilcoxon statistic 13 and p-value 0.021484.\n",
            "\n",
            "The corrected Mahalanobis paired detector-response test has\n",
            "Wilcoxon statistic 5 and p-value 0.002441.\n",
            "\n",
            "Both tests are below the nominal 0.05 significance threshold.\n",
            "These results are based on 13 identity-level observations and\n",
            "have not been adjusted for multiple comparisons.\n",
            "\n",
            "## 8. Identity-Level Detector Direction\n",
            "\n",
            "- Euclidean high-versus-low response increased for\n",
            "  {identity_direction_summary['euclidean']['increased']} of 13 identities\n",
            "  and decreased for {identity_direction_summary['euclidean']['decreased']}.\n",
            "- Mahalanobis high-versus-low response increased for\n",
            "  {identity_direction_summary['mahalanobis']['increased']} of 13 identities\n",
            "  and decreased for {identity_direction_summary['mahalanobis']['decreased']}.\n",
            "\n",
            "## 9. Reproducibility Audit\n",
            "\n",
            "Step 17.10.6.4: 54 checks passed; 0 failed.\n",
            "\n",
            "The audit checked saved files, array shapes and integrity,\n",
            "displacement reproduction, statistical summaries, CSV consistency,\n",
            "metadata, and detector-table availability.\n",
            "\n",
            "It did not independently rerun original image detection,\n",
            "preprocessing, embedding extraction, or detector calibration.\n",
            "\n",
            "## 10. Software Environment\n",
            "\n",
            "{pd.DataFrame(\n",
            "    list(software_environment.items()),\n",
            "    columns=[\"Component\", \"Version\"]\n",
            ").to_string(index=False)}\n",
            "\n",
            "## 11. Evidence Classification\n",
            "\n",
            "### Validated findings\n",
            "\n",
            "{chr(10).join('- ' + item for item in evidence_interpretation['validated'])}\n",
            "\n",
            "### Exploratory findings\n",
            "\n",
            "{chr(10).join('- ' + item for item in evidence_interpretation['exploratory'])}\n",
            "\n",
            "### Claims not established\n",
            "\n",
            "{chr(10).join('- ' + item for item in evidence_interpretation['not_established'])}\n",
            "\n",
            "## 12. Limitations\n",
            "\n",
            "{chr(10).join(f'{i}. {item}' for i, item in enumerate(limitations, start=1))}\n",
            "\n",
            "## 13. Provenance and Scope\n",
            "\n",
            "This evidence package consolidates previously generated and audited\n",
            "Experiment 18 outputs.\n",
            "\n",
            "It does not perform new image detection, preprocessing, embedding\n",
            "extraction, model training, detector calibration, or statistical testing.\n",
            "\n",
            "Original experiment archives and metadata are retained unchanged.\n",
            "\"\"\"\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 12. SAVE DOCUMENTATION FILES\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "with open(report_path, \"w\", encoding=\"utf-8\") as file:\n",
            "    file.write(markdown)\n",
            "\n",
            "with open(json_path, \"w\", encoding=\"utf-8\") as file:\n",
            "    json.dump(\n",
            "        evidence,\n",
            "        file,\n",
            "        indent=2,\n",
            "        allow_nan=False\n",
            "    )\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 13. VERIFY GENERATED FILES AND CORRECTED CONTENT\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "for path in [report_path, json_path]:\n",
            "\n",
            "    assert os.path.isfile(path), (\n",
            "        f\"Output file missing: {path}\"\n",
            "    )\n",
            "\n",
            "    assert os.path.getsize(path) > 0, (\n",
            "        f\"Output file is empty: {path}\"\n",
            "    )\n",
            "\n",
            "with open(json_path, \"r\", encoding=\"utf-8\") as file:\n",
            "    verified_json = json.load(file)\n",
            "\n",
            "assert verified_json[\"dataset_summary\"][\"paired_images\"] == 889\n",
            "assert verified_json[\"dataset_summary\"][\"evaluation_identities\"] == 13\n",
            "assert verified_json[\"dataset_summary\"][\"corrected_detector_evaluation_images\"] == 229\n",
            "\n",
            "assert verified_json[\"reproducibility_audit\"][\"passed\"] == 54\n",
            "assert verified_json[\"reproducibility_audit\"][\"failed\"] == 0\n",
            "\n",
            "assert verified_json[\"identity_level_detector_directions\"][\"euclidean\"][\"increased\"] == 10\n",
            "assert verified_json[\"identity_level_detector_directions\"][\"euclidean\"][\"decreased\"] == 3\n",
            "\n",
            "assert verified_json[\"identity_level_detector_directions\"][\"mahalanobis\"][\"increased\"] == 11\n",
            "assert verified_json[\"identity_level_detector_directions\"][\"mahalanobis\"][\"decreased\"] == 2\n",
            "\n",
            "for detector in [\"Euclidean\", \"Mahalanobis\"]:\n",
            "\n",
            "    result = next(\n",
            "        row for row in verified_json[\"detector_statistical_tests\"]\n",
            "        if row[\"Detector\"] == detector\n",
            "    )\n",
            "\n",
            "    assert np.isclose(\n",
            "        result[\"P-value\"],\n",
            "        expected_p_values[detector],\n",
            "        atol=1e-6\n",
            "    )\n",
            "\n",
            "    assert np.isclose(\n",
            "        result[\"Wilcoxon Statistic\"],\n",
            "        expected_wilcoxon[detector]\n",
            "    )\n",
            "\n",
            "with open(report_path, \"r\", encoding=\"utf-8\") as file:\n",
            "    verified_markdown = file.read()\n",
            "\n",
            "assert \"0.021484\" in verified_markdown\n",
            "assert \"0.002441\" in verified_markdown\n",
            "assert \"0.375732\" not in verified_markdown\n",
            "assert \"0.057373\" not in verified_markdown\n",
            "\n",
            "print(\"\\nSection 13: Generated documentation verification passed.\")\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 14. FINAL OUTPUT\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n\" + \"=\" * 80)\n",
            "print(\"STEP 17.10.6.5 — FINAL RESEARCH EVIDENCE PACKAGE\")\n",
            "print(\"=\" * 80)\n",
            "\n",
            "print(\"\\nNEW DOCUMENTATION FILES CREATED:\")\n",
            "\n",
            "print(f\"\\n1. {report_path}\")\n",
            "print(f\"   Size: {os.path.getsize(report_path):,} bytes\")\n",
            "\n",
            "print(f\"\\n2. {json_path}\")\n",
            "print(f\"   Size: {os.path.getsize(json_path):,} bytes\")\n",
            "\n",
            "print(\"\\nEVIDENCE SUMMARY:\")\n",
            "print(\"Historical paired images:\", paired_images)\n",
            "print(\"Historical identities:\", identity_count)\n",
            "print(\"Embedding dimension:\", embedding_dimension)\n",
            "print(\"Largest identity share:\", f\"{largest_identity_share:.2%}\")\n",
            "print(\"Corrected detector evaluation images: 229\")\n",
            "\n",
            "print(\"\\nCORRECTED DETECTOR RESULTS:\")\n",
            "display(detector_tests_df)\n",
            "\n",
            "print(\"\\nCORRECTED IDENTITY-LEVEL DIRECTIONS:\")\n",
            "print(identity_direction_summary)\n",
            "\n",
            "print(\"\\nDISPLACEMENT REPRODUCTION:\")\n",
            "print(\"Low maximum error:\", low_max_error)\n",
            "print(\"High maximum error:\", high_max_error)\n",
            "\n",
            "print(\"\\nPREVIOUS REPRODUCIBILITY AUDIT:\")\n",
            "print(\"Checks passed: 54\")\n",
            "print(\"Checks failed: 0\")\n",
            "\n",
            "print(\"\\nFINAL FILE VERIFICATION:\")\n",
            "print(\"Markdown report: PASS\")\n",
            "print(\"JSON serialization and reload: PASS\")\n",
            "print(\"Corrected detector statistics: PASS\")\n",
            "print(\"Corrected identity directions: PASS\")\n",
            "print(\"Core evidence assertions: PASS\")\n",
            "\n",
            "print(\"\\nOriginal experiment archives were not modified.\")\n",
            "print(\"No embedding extraction or model training performed.\")\n",
            "print(\"No detector calibration or statistical tests rerun.\")\n",
            "\n",
            "print(\"\\nSTEP 17.10.6.5 COMPLETED\")\n",
            "print(\"=\" * 80)\n",
            "\n",
            "\n",
            "===========================================================================\n",
            "CELL INDEX: 142\n",
            "CELL TYPE: code\n",
            "MATCHED TERMS: ['embedding']\n",
