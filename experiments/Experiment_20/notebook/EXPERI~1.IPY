        "        name for name, passed in checks.items() if not passed\n",
        "    ],\n",
        "    \"status\": (\n",
        "        \"DRAFT_CONSISTENCY_CHECK_PASSED\"\n",
        "        if all(checks.values())\n",
        "        else \"DRAFT_REQUIRES_REVIEW\"\n",
        "    ),\n",
        "    \"selection_notes\": [\n",
        "        \"Common-condition selection maintains complete identity coverage.\",\n",
        "        \"Reference observations are used for distance calculation but excluded from non-reference evaluation counts.\",\n",
        "        \"Geometry groups describe angular deviation, not measured illumination intensity.\"\n",
        "    ]\n",
        "}\n",
        "\n",
        "json_path.write_text(\n",
