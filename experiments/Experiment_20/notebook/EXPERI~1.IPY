        "\n",
        "# ============================================================\n",
        "# EXPERIMENT 20 — STEP 3.3.12\n",
        "# INTEGRATED MANUSCRIPT — COMPLETE STRUCTURAL CORRECTION\n",
        "#\n",
        "# Corrections:\n",
        "# 1. Methodology numbering: 3.1–3.10 -> 2.1–2.10\n",
        "# 2. Results numbering: 4.1–4.6 -> 3.1–3.6\n",
        "# 3. Discussion numbering: 5.1–5.8 -> 4.1–4.8\n",
        "# 4. Moses citations corrected to APA 7 et al. format\n",
        "# 5. Duplicate References heading removed\n",
        "# 6. Section-specific numbering validation\n",
        "# 7. JSON record and SHA256 updated\n",
        "#\n",
        "# Original source documents remain unchanged.\n",
        "# ============================================================\n",
        "\n",
        "import json\n",
        "import hashlib\n",
        "import re\n",
        "\n",
        "from pathlib import Path\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. FILE PATHS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "ROOT = Path(\n",
        "    \"/content/drive/MyDrive/Experiment_20_Results\"\n",
        ")\n",
        "\n",
        "OUT = (\n",
        "    ROOT\n",
        "    / \"step_3_3\"\n",
        "    / \"step_3312\"\n",
        ")\n",
        "\n",
        "MANUSCRIPT = (\n",
        "    OUT / \"experiment20_integrated_manuscript_v1.md\"\n",
        ")\n",
        "\n",
        "RECORD = (\n",
        "    OUT / \"experiment20_step3312_integration_record.json\"\n",
        ")\n",
        "\n",
        "if not MANUSCRIPT.is_file():\n",
        "    raise FileNotFoundError(\n",
        "        f\"Integrated manuscript missing: {MANUSCRIPT}\"\n",
        "    )\n",
        "\n",
        "if not RECORD.is_file():\n",
        "    raise FileNotFoundError(\n",
        "        f\"Integration record missing: {RECORD}\"\n",
        "    )\n",
        "\n",
        "print(\"=\" * 80)\n",
        "print(\"EXPERIMENT 20 — STEP 3.3.12\")\n",
        "print(\"COMPLETE MANUSCRIPT STRUCTURAL CORRECTION\")\n",
        "print(\"=\" * 80)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. LOAD ORIGINAL INTEGRATED MANUSCRIPT AND RECORD\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "original_text = MANUSCRIPT.read_text(\n",
        "    encoding=\"utf-8\"\n",
        ")\n",
        "\n",
        "with open(RECORD, \"r\", encoding=\"utf-8\") as f:\n",
        "    integration_record = json.load(f)\n",
        "\n",
        "if integration_record.get(\"status\") not in [\n",
        "    \"INTEGRATED_MANUSCRIPT_GENERATED\",\n",
        "    \"INTEGRATED_MANUSCRIPT_STRUCTURALLY_CORRECTED\"\n",
        "]:\n",
        "    raise ValueError(\n",
        "        \"Unexpected integration record status.\"\n",
        "    )\n",
        "\n",
        "# Keep an in-memory copy of the original.\n",
        "# The file will only be overwritten after all validations pass.\n",
        "\n",
        "corrected_text = original_text\n",
        "\n",
        "print(\"\\n[1] SOURCE VALIDATION\")\n",
        "print(\"Integrated manuscript: FOUND\")\n",
        "print(\"Integration JSON: FOUND\")\n",
        "print(\"Original manuscript loaded successfully\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. VERIFY MAIN SECTION ORDER\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "main_headings = [\n",
        "    \"# 1. Introduction\",\n",
        "    \"# 2. Methodology\",\n",
        "    \"# 3. Results\",\n",
        "    \"# 4. Discussion\",\n",
        "    \"# References\"\n",
        "]\n",
        "\n",
        "main_positions = {}\n",
        "\n",
        "for heading in main_headings:\n",
        "\n",
        "    if corrected_text.count(heading) < 1:\n",
        "        raise ValueError(\n",
        "            f\"Required main heading missing: {heading}\"\n",
        "        )\n",
        "\n",
        "    main_positions[heading] = corrected_text.index(\n",
        "        heading\n",
        "    )\n",
        "\n",
        "if not (\n",
        "    main_positions[\"# 1. Introduction\"]\n",
        "    < main_positions[\"# 2. Methodology\"]\n",
        "    < main_positions[\"# 3. Results\"]\n",
        "    < main_positions[\"# 4. Discussion\"]\n",
        "    < main_positions[\"# References\"]\n",
        "):\n",
        "    raise ValueError(\n",
        "        \"Main manuscript section order is incorrect.\"\n",
        "    )\n",
        "\n",
        "print(\"\\n[2] MAIN SECTION ORDER\")\n",
        "print(\"PASS: Introduction\")\n",
        "print(\"PASS: Methodology\")\n",
        "print(\"PASS: Results\")\n",
        "print(\"PASS: Discussion\")\n",
        "print(\"PASS: References\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. CORRECT METHODOLOGY SUBSECTION NUMBERING\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "method_start = corrected_text.index(\n",
        "    \"# 2. Methodology\"\n",
        ")\n",
        "\n",
        "results_start = corrected_text.index(\n",
        "    \"# 3. Results\"\n",
        ")\n",
        "\n",
        "methodology_section = corrected_text[\n",
        "    method_start:results_start\n",
        "]\n",
        "\n",
        "methodology_section, methodology_changes = re.subn(\n",
        "    r\"(?m)^# 3\\.(\\d+)\\s+\",\n",
        "    r\"## 2.\\1 \",\n",
        "    methodology_section\n",
        ")\n",
        "\n",
        "if methodology_changes != 10:\n",
        "    raise ValueError(\n",
        "        \"Expected 10 Methodology numbering corrections. \"\n",
        "        f\"Found: {methodology_changes}\"\n",
        "    )\n",
        "\n",
        "corrected_text = (\n",
        "    corrected_text[:method_start]\n",
        "    + methodology_section\n",
        "    + corrected_text[results_start:]\n",
        ")\n",
        "\n",
        "print(\"\\n[3] METHODOLOGY NUMBERING\")\n",
        "print(\"Corrected subsections:\", methodology_changes)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. CORRECT RESULTS SUBSECTION NUMBERING\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "results_start = corrected_text.index(\n",
        "    \"# 3. Results\"\n",
        ")\n",
        "\n",
        "discussion_start = corrected_text.index(\n",
        "    \"# 4. Discussion\"\n",
        ")\n",
        "\n",
        "results_section = corrected_text[\n",
        "    results_start:discussion_start\n",
        "]\n",
        "\n",
        "results_section, results_changes = re.subn(\n",
        "    r\"(?m)^## 4\\.(\\d+)\\s+\",\n",
        "    r\"## 3.\\1 \",\n",
        "    results_section\n",
        ")\n",
        "\n",
        "if results_changes != 6:\n",
        "    raise ValueError(\n",
        "        \"Expected 6 Results numbering corrections. \"\n",
        "        f\"Found: {results_changes}\"\n",
        "    )\n",
        "\n",
        "corrected_text = (\n",
        "    corrected_text[:results_start]\n",
        "    + results_section\n",
        "    + corrected_text[discussion_start:]\n",
        ")\n",
        "\n",
        "print(\"\\n[4] RESULTS NUMBERING\")\n",
        "print(\"Corrected subsections:\", results_changes)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. CORRECT DISCUSSION SUBSECTION NUMBERING\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "discussion_start = corrected_text.index(\n",
        "    \"# 4. Discussion\"\n",
        ")\n",
        "\n",
        "references_start = corrected_text.index(\n",
        "    \"# References\"\n",
        ")\n",
        "\n",
        "discussion_section = corrected_text[\n",
        "    discussion_start:references_start\n",
        "]\n",
        "\n",
        "discussion_section, discussion_changes = re.subn(\n",
        "    r\"(?m)^## 5\\.(\\d+)\\s+\",\n",
        "    r\"## 4.\\1 \",\n",
        "    discussion_section\n",
        ")\n",
        "\n",
        "if discussion_changes != 8:\n",
        "    raise ValueError(\n",
        "        \"Expected 8 Discussion numbering corrections. \"\n",
        "        f\"Found: {discussion_changes}\"\n",
        "    )\n",
        "\n",
        "corrected_text = (\n",
        "    corrected_text[:discussion_start]\n",
        "    + discussion_section\n",
        "    + corrected_text[references_start:]\n",
        ")\n",
        "\n",
        "print(\"\\n[5] DISCUSSION NUMBERING\")\n",
        "print(\"Corrected subsections:\", discussion_changes)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. CORRECT MOSES APA 7 CITATIONS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "narrative_old = \"Moses, Adini, and Ullman (1994)\"\n",
        "narrative_new = \"Moses et al. (1994)\"\n",
        "\n",
        "parenthetical_old = (\n",
        "    \"(Moses, Adini, and Ullman, 1994)\"\n",
        ")\n",
        "\n",
        "parenthetical_new = (\n",
        "    \"(Moses et al., 1994)\"\n",
        ")\n",
        "\n",
        "narrative_count = corrected_text.count(\n",
        "    narrative_old\n",
        ")\n",
        "\n",
        "parenthetical_count = corrected_text.count(\n",
        "    parenthetical_old\n",
        ")\n",
        "\n",
        "corrected_text = corrected_text.replace(\n",
        "    narrative_old,\n",
        "    narrative_new\n",
        ")\n",
        "\n",
        "corrected_text = corrected_text.replace(\n",
        "    parenthetical_old,\n",
        "    parenthetical_new\n",
        ")\n",
        "\n",
        "if narrative_old in corrected_text:\n",
        "    raise ValueError(\n",
        "        \"Old Moses narrative citation remains.\"\n",
        "    )\n",
        "\n",
        "if parenthetical_old in corrected_text:\n",
        "    raise ValueError(\n",
        "        \"Old Moses parenthetical citation remains.\"\n",
        "    )\n",
        "\n",
        "print(\"\\n[6] APA 7 CITATION CORRECTION\")\n",
        "print(\"Narrative citations corrected:\", narrative_count)\n",
        "print(\"Parenthetical citations corrected:\", parenthetical_count)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 8. REMOVE DUPLICATE REFERENCES HEADING\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "references_heading_count = corrected_text.count(\n",
        "    \"# References\"\n",
        ")\n",
        "\n",
        "if references_heading_count == 2:\n",
        "\n",
        "    corrected_text, duplicate_count = re.subn(\n",
        "        r\"(?m)^# References\\s*\\n\\s*# References\\s*$\",\n",
        "        \"# References\",\n",
        "        corrected_text\n",
        "    )\n",
        "\n",
        "    if duplicate_count == 0:\n",
        "\n",
        "        corrected_text, duplicate_count = re.subn(\n",
        "            r\"(?m)^# References\\s*\\n\\s*\\n# References\\s*\\n\",\n",
        "            \"# References\\n\",\n",
        "            corrected_text\n",
        "        )\n",
        "\n",
        "    if duplicate_count != 1:\n",
        "        raise ValueError(\n",
        "            \"Duplicate References heading could not be \"\n",
        "            \"safely removed.\"\n",
        "        )\n",
        "\n",
        "elif references_heading_count == 1:\n",
        "\n",
