      "cell_type": "markdown",
      "source": [
        "# Experiment 20 — Step 3.3.27: Holm Correction Audit Closure\n",
        "\n",
        "## Objective\n",
        "Create a versioned audit record documenting the resolution of the manuscript-level Holm correction discrepancy.\n",
        "\n",
        "## Evidence\n",
        "- Original frozen paired-comparison CSV and its SHA256.\n",
        "- Six-test correction artifact and provenance record.\n",
        "- Independent recomputation from identity-level data.\n",
        "- Step 3.3.26 rounded-value verification report.\n",
        "\n",
        "## Conclusions to preserve\n",
        "1. The frozen paired-comparison CSV retains metric-wise Holm-adjusted values.\n",
        "2. The documented methodology specifies one combined family of six comparisons.\n",
        "3. The corrected manuscript values use the combined six-test family.\n",
        "4. All six manuscript values passed verification in both identical manuscript copies.\n",
        "5. The original frozen CSV remains unchanged.\n",
        "6. The original Experiment 20 statistical implementation was not recovered.\n",
        "\n",
        "## Integrity restrictions\n",
        "- Read-only with respect to all existing evidence.\n",
        "- Create only a new audit closure JSON.\n",
        "- Do not overwrite historical audit reports or statistical artifacts."
      ],
      "metadata": {
        "id": "0fnzQ-LZF7Sl"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# EXPERIMENT 20 — STEP 3.3.27\n",
        "# HOLM CORRECTION AUDIT CLOSURE\n",
        "# READ-ONLY EVIDENCE CONSOLIDATION\n",
        "# ============================================================\n",
        "\n",
        "import os\n",
        "import json\n",
        "import hashlib\n",
        "import pandas as pd\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "BASE = \"/content/drive/MyDrive/Experiment_20_Results\"\n",
        "\n",
        "PATHS = {\n",
        "    \"frozen_paired_csv\": os.path.join(\n",
        "        BASE, \"step_2_7\", \"final_freeze\",\n",
        "        \"experiment20_paired_comparison_results.csv\"\n",
        "    ),\n",
        "    \"corrected_csv\": os.path.join(\n",
        "        BASE, \"step_3_3\", \"step_33103\",\n",
        "        \"experiment20_manuscript_six_test_holm_results.csv\"\n",
        "    ),\n",
        "    \"correction_record\": os.path.join(\n",
        "        BASE, \"step_3_3\", \"step_33103\",\n",
        "        \"experiment20_step33103_holm_correction_record.json\"\n",
        "    ),\n",
        "    \"independent_recomputation\": os.path.join(\n",
        "        BASE, \"step_3_3\", \"step_3321\",\n",
        "        \"experiment20_step3321_paired_comparison_verification.json\"\n",
        "    ),\n",
        "    \"reference_audit\": os.path.join(\n",
        "        BASE, \"step_3_3\", \"step_3322\",\n",
        "        \"experiment20_step3322_holm_reference_audit.json\"\n",
        "    ),\n",
        "    \"provenance_table_check\": os.path.join(\n",
        "        BASE, \"step_3_3\", \"step_3324\",\n",
        "        \"experiment20_step3324_holm_provenance_table2_verification.json\"\n",
        "    ),\n",
        "    \"rounded_verification\": os.path.join(\n",
        "        BASE, \"step_3_3\", \"step_3326\",\n",
        "        \"experiment20_step3326_rounded_holm_verification.json\"\n",
        "    ),\n",
        "    \"integrated_manuscript\": os.path.join(\n",
        "        BASE, \"step_3_3\", \"step_3312\",\n",
        "        \"experiment20_integrated_manuscript_v1.md\"\n",
        "    ),\n",
        "    \"review_copy\": os.path.join(\n",
        "        BASE, \"step_3_3\", \"step_3313\",\n",
        "        \"experiment20_step3313_manuscript_review_copy.md\"\n",
        "    )\n",
        "}\n",
        "\n",
        "OUTPUT_DIR = os.path.join(\n",
        "    BASE, \"step_3_3\", \"step_3327\"\n",
        ")\n",
        "os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
        "\n",
        "OUTPUT_PATH = os.path.join(\n",
        "    OUTPUT_DIR,\n",
        "    \"experiment20_step3327_holm_audit_closure.json\"\n",
        ")\n",
        "\n",
        "\n",
        "def sha256_file(path):\n",
        "    h = hashlib.sha256()\n",
        "    with open(path, \"rb\") as f:\n",
        "        for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n",
        "            h.update(chunk)\n",
        "    return h.hexdigest()\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. VERIFY ALL REQUIRED EVIDENCE EXISTS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"=\" * 100)\n",
        "print(\"STEP 3.3.27 — HOLM AUDIT CLOSURE\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "missing = [\n",
        "    name for name, path in PATHS.items()\n",
        "    if not os.path.isfile(path)\n",
        "]\n",
        "\n",
        "if missing:\n",
        "    raise FileNotFoundError(\n",
        "        \"Required evidence missing: \" + \", \".join(missing)\n",
        "    )\n",
        "\n",
        "evidence = {}\n",
        "\n",
        "for name, path in PATHS.items():\n",
        "    evidence[name] = {\n",
        "        \"path\": path,\n",
        "        \"sha256\": sha256_file(path),\n",
        "        \"size_bytes\": os.path.getsize(path)\n",
        "    }\n",
        "\n",
        "    print(\n",
        "        f\"{name}: VERIFIED | \"\n",
        "        f\"SHA256={evidence[name]['sha256']}\"\n",
        "    )\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. VERIFY FROZEN AND CORRECTED CSV VALUES\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "frozen = pd.read_csv(PATHS[\"frozen_paired_csv\"])\n",
        "corrected = pd.read_csv(PATHS[\"corrected_csv\"])\n",
        "\n",
        "assert len(frozen) == 6\n",
        "assert len(corrected) == 6\n",
        "\n",
        "required_corrected_columns = [\n",
        "    \"raw_p_value\",\n",
        "    \"holm_adjusted_p_value\",\n",
        "    \"six_test_holm_adjusted_p_value\",\n",
        "    \"six_test_family_size\",\n",
        "    \"correction_scope\",\n",
        "    \"manuscript_adjusted_p_value\"\n",
        "]\n",
        "\n",
        "for column in required_corrected_columns:\n",
        "    assert column in corrected.columns, (\n",
        "        f\"Missing corrected CSV column: {column}\"\n",
        "    )\n",
        "\n",
        "frozen_values = sorted(\n",
        "    frozen[\"holm_adjusted_p_value\"].astype(float).tolist()\n",
        ")\n",
        "\n",
        "corrected_values = sorted(\n",
        "    corrected[\"six_test_holm_adjusted_p_value\"].astype(float).tolist()\n",
        ")\n",
        "\n",
        "manuscript_values = sorted(\n",
        "    corrected[\"manuscript_adjusted_p_value\"].astype(float).tolist()\n",
        ")\n",
        "\n",
        "family_sizes = sorted(\n",
        "    corrected[\"six_test_family_size\"].dropna().unique().tolist()\n",
        ")\n",
        "\n",
        "scopes = sorted(\n",
        "    corrected[\"correction_scope\"].dropna().unique().tolist()\n",
        ")\n",
        "\n",
        "print(\"\\nFROZEN CSV\")\n",
        "print(\"Rows:\", len(frozen))\n",
        "print(\"Unique Holm values:\", sorted(set(frozen_values)))\n",
        "\n",
        "print(\"\\nCORRECTED CSV\")\n",
        "print(\"Rows:\", len(corrected))\n",
        "print(\"Unique six-test values:\", sorted(set(corrected_values)))\n",
        "print(\"Unique manuscript values:\", sorted(set(manuscript_values)))\n",
        "print(\"Family sizes:\", family_sizes)\n",
        "print(\"Correction scopes:\", scopes)\n",
        "\n",
        "assert family_sizes == [6]\n",
        "assert len(set(corrected_values)) == 1\n",
        "assert len(set(manuscript_values)) == 1\n",
        "\n",
        "assert all(\n",
        "    abs(a - b) < 1e-20\n",
        "    for a, b in zip(corrected_values, manuscript_values)\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. VERIFY CORRECTION RECORD\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "with open(PATHS[\"correction_record\"], \"r\", encoding=\"utf-8\") as f:\n",
        "    correction_record = json.load(f)\n",
        "\n",
        "assert correction_record[\"number_of_tests\"] == 6\n",
        "assert correction_record[\"correction_family\"] == (\n",
        "    \"One combined family of six pairwise comparisons\"\n",
        ")\n",
        "assert correction_record[\"original_frozen_file_modified\"] is False\n",
        "\n",
        "assert (\n",
        "    correction_record[\"source_sha256\"]\n",
        "    == evidence[\"frozen_paired_csv\"][\"sha256\"]\n",
        ")\n",
        "\n",
        "assert (\n",
        "    correction_record[\"output_csv_sha256\"]\n",
        "    == evidence[\"corrected_csv\"][\"sha256\"]\n",
        ")\n",
        "\n",
        "print(\"\\nCorrection record source/output hashes verified.\")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. VERIFY INDEPENDENT RECOMPUTATION REPORT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "with open(\n",
        "    PATHS[\"independent_recomputation\"], \"r\", encoding=\"utf-8\"\n",
        ") as f:\n",
        "    recomputation = json.load(f)\n",
        "\n",
        "print(\"\\nIndependent recomputation report loaded.\")\n",
        "print(\"Top-level keys:\", list(recomputation.keys()))\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. VERIFY FINAL MANUSCRIPT VALUE REPORT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "with open(\n",
        "    PATHS[\"rounded_verification\"], \"r\", encoding=\"utf-8\"\n",
        ") as f:\n",
        "    rounded_report = json.load(f)\n",
        "\n",
        "assert rounded_report[\"status\"] == (\n",
        "    \"PASS_ALL_SIX_HOLM_VALUES_VERIFIED\"\n",
        ")\n",
        "\n",
        "assert rounded_report[\"manuscript_copies_identical\"] is True\n",
        "assert rounded_report[\"table_contents_identical\"] is True\n",
        "\n",
        "for manuscript_name in [\"integrated\", \"review_copy\"]:\n",
        "    result = rounded_report[\"manuscript_results\"][manuscript_name]\n",
        "\n",
        "    assert result[\"table_rows\"] == 6\n",
        "    assert result[\"matched\"] == 6\n",
        "    assert result[\"all_six_match\"] is True\n",
        "\n",
        "print(\"\\nFinal manuscript verification: PASS\")\n",
        "print(\"Integrated manuscript: 6/6\")\n",
        "print(\"Review copy: 6/6\")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. VERIFY MANUSCRIPT FILE IDENTITY\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "integrated_hash = evidence[\"integrated_manuscript\"][\"sha256\"]\n",
        "review_hash = evidence[\"review_copy\"][\"sha256\"]\n",
        "\n",
        "assert integrated_hash == review_hash\n",
        "\n",
        "print(\"\\nManuscript copies have identical SHA256.\")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. CREATE AUDIT CLOSURE RECORD\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "closure = {\n",
        "    \"experiment\": 20,\n",
        "    \"step\": \"3.3.27\",\n",
        "    \"created_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "\n",
        "    \"title\": \"Holm Correction Audit Closure\",\n",
        "\n",
        "    \"evidence\": evidence,\n",
        "\n",
        "    \"findings\": {\n",
        "        \"frozen_csv_contains_metric_wise_holm_values\": True,\n",
        "        \"documented_method_uses_one_combined_family_of_six\": True,\n",
        "        \"corrected_artifact_contains_six_comparisons\": True,\n",
        "        \"corrected_artifact_family_size\": 6,\n",
        "        \"manuscript_uses_combined_six_test_values\": True,\n",
        "        \"all_six_manuscript_values_verified\": True,\n",
        "        \"both_manuscript_copies_identical\": True,\n",
        "        \"original_frozen_csv_modified\": False,\n",
        "        \"original_experiment20_implementation_recovered\": False\n",
        "    },\n",
        "\n",
        "    \"statistical_values\": {\n",
        "        \"frozen_metric_wise_holm_value\": frozen_values[0],\n",
        "        \"corrected_combined_six_test_holm_value\": corrected_values[0],\n",
        "        \"manuscript_display_value\": \"4.366e-11\",\n",
        "        \"raw_p_value\": float(corrected[\"raw_p_value\"].iloc[0]),\n",
        "        \"all_six_comparisons_significant_at_0_05\": True\n",
        "    },\n",
        "\n",
        "    \"interpretation\": {\n",
        "        \"manuscript_reporting_issue\": \"RESOLVED\",\n",
        "        \"historical_frozen_artifact_discrepancy\": \"PRESERVED_AND_DOCUMENTED\",\n",
        "        \"original_implementation_provenance\": \"NOT_RECOVERED\",\n",
        "        \"historical_values_overwritten\": False\n",
        "    },\n",
        "\n",
        "    \"limitations\": [\n",
        "        \"The original Experiment 20 statistical implementation was not recovered.\",\n",
        "        \"The correction artifact documents the combined-family recalculation, but does not establish which original code generated the frozen metric-wise values.\",\n",
        "        \"The correction changes adjusted p-value reporting, not the underlying six raw Wilcoxon p-values or paired observations.\"\n",
        "    ],\n",
        "\n",
        "    \"overall_status\": \"MANUSCRIPT_HOLM_REPORTING_ISSUE_RESOLVED\",\n",
        "\n",
        "    \"integrity\": {\n",
        "        \"existing_files_modified\": False,\n",
        "        \"frozen_evidence_modified\": False,\n",
        "        \"manuscripts_modified\": False,\n",
        "        \"new_file_created\": True\n",
        "    }\n",
        "}\n",
        "\n",
        "with open(OUTPUT_PATH, \"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(closure, f, indent=2)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"AUDIT CLOSURE\")\n",
        "print(\"=\" * 100)\n",
        "print(\"Status:\", closure[\"overall_status\"])\n",
        "print(\"Frozen artifact discrepancy:\", \"PRESERVED AND DOCUMENTED\")\n",
        "print(\"Original implementation recovered:\", False)\n",
        "print(\"Existing files modified:\", False)\n",
        "print(\"Closure report:\", OUTPUT_PATH)\n",
        "print(\"Closure report SHA256:\", sha256_file(OUTPUT_PATH))\n",
        "\n",
        "print(\"\\nSTEP 3.3.27 COMPLETED\")"
      ],
