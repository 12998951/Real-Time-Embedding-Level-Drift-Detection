            "euclidean                 near_frontal vs oblique            38                    38                     0     0           38     7.275958e-12      4.365575e-11\n",
            "euclidean near_frontal vs large_angular_deviation            38                    38                     0     0           38     7.275958e-12      4.365575e-11\n",
            "euclidean      oblique vs large_angular_deviation            38                    38                     0     0           38     7.275958e-12      4.365575e-11\n",
            "   cosine                 near_frontal vs oblique            38                    38                     0     0           38     7.275958e-12      4.365575e-11\n",
