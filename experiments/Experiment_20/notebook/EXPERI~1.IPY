    {
      "cell_type": "code",
      "source": [
        "import os\n",
        "import re\n",
        "import json\n",
        "import zipfile\n",
        "from collections import defaultdict, Counter\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "ARCHIVE_PATH = \"/content/Experiment20_Downloads/CroppedYale.zip\"\n",
        "\n",
        "AUDIT_DIR = (\n",
        "    \"/content/drive/MyDrive/Experiment_20_Results/dataset_audit\"\n",
        ")\n",
        "\n",
        "OUTPUT_PATH = os.path.join(\n",
        "    AUDIT_DIR,\n",
        "    \"experiment20_croppedyale_filename_completeness_audit.json\"\n",
        ")\n",
        "\n",
        "os.makedirs(AUDIT_DIR, exist_ok=True)\n",
        "\n",
        "pattern = re.compile(\n",
        "    r\"^(yaleB\\d+)_P(\\d{2})A([+-]\\d{3})E([+-]\\d{2})\\.pgm$\",\n",
        "    re.IGNORECASE\n",
        ")\n",
        "\n",
        "print(\"=\" * 75)\n",
        "print(\"EXPERIMENT 20 — STEP 2.6.8: FILENAME AND CONDITION AUDIT\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "with zipfile.ZipFile(ARCHIVE_PATH, \"r\") as archive:\n",
        "\n",
        "    names = archive.namelist()\n",
        "\n",
        "    pgm_paths = [\n",
        "        name for name in names\n",
        "        if name.lower().endswith(\".pgm\")\n",
        "    ]\n",
        "\n",
        "    parsed_records = []\n",
        "    unmatched_records = []\n",
        "    subject_metadata = {}\n",
        "\n",
        "    for path in pgm_paths:\n",
        "        filename = os.path.basename(path)\n",
        "        match = pattern.match(filename)\n",
        "\n",
        "        if match:\n",
        "            subject, pose, azimuth, elevation = match.groups()\n",
        "\n",
        "            parsed_records.append({\n",
        "                \"path\": path,\n",
        "                \"subject\": subject,\n",
        "                \"pose\": pose,\n",
        "                \"azimuth\": azimuth,\n",
        "                \"elevation\": elevation\n",
        "            })\n",
        "        else:\n",
        "            unmatched_records.append({\n",
        "                \"path\": path,\n",
        "                \"filename\": filename,\n",
        "                \"directory\": os.path.dirname(path)\n",
        "            })\n",
        "\n",
        "    # -----------------------------------------------------\n",
        "    # 1. UNMATCHED FILENAMES\n",
        "    # -----------------------------------------------------\n",
        "\n",
        "    print(\"\\n[1] UNMATCHED PGM FILES\")\n",
        "    print(\"Count:\", len(unmatched_records))\n",
        "\n",
        "    for item in unmatched_records:\n",
        "        print(item[\"path\"])\n",
        "\n",
        "    # -----------------------------------------------------\n",
        "    # 2. DUPLICATE CONDITION CHECK\n",
        "    # -----------------------------------------------------\n",
        "\n",
        "    print(\"\\n[2] DUPLICATE CONDITION CHECK\")\n",
        "\n",
        "    condition_counts = Counter(\n",
        "        (\n",
        "            r[\"subject\"],\n",
        "            r[\"pose\"],\n",
        "            r[\"azimuth\"],\n",
        "            r[\"elevation\"]\n",
        "        )\n",
        "        for r in parsed_records\n",
        "    )\n",
        "\n",
        "    duplicates = [\n",
        "        {\n",
        "            \"subject\": key[0],\n",
        "            \"pose\": key[1],\n",
        "            \"azimuth\": key[2],\n",
        "            \"elevation\": key[3],\n",
        "            \"count\": count\n",
        "        }\n",
        "        for key, count in condition_counts.items()\n",
        "        if count > 1\n",
        "    ]\n",
        "\n",
        "    print(\"Duplicate condition keys:\", len(duplicates))\n",
        "\n",
        "    for item in duplicates:\n",
        "        print(item)\n",
        "\n",
        "    # -----------------------------------------------------\n",
        "    # 3. MISSING ILLUMINATION CONDITIONS\n",
        "    # -----------------------------------------------------\n",
        "\n",
        "    print(\"\\n[3] PER-SUBJECT CONDITION COMPLETENESS\")\n",
        "\n",
        "    global_conditions = sorted({\n",
        "        (r[\"azimuth\"], r[\"elevation\"])\n",
        "        for r in parsed_records\n",
        "    })\n",
        "\n",
        "    subject_conditions = defaultdict(set)\n",
        "    subject_poses = defaultdict(set)\n",
        "\n",
        "    for r in parsed_records:\n",
        "        subject_conditions[r[\"subject\"]].add(\n",
        "            (r[\"azimuth\"], r[\"elevation\"])\n",
        "        )\n",
        "        subject_poses[r[\"subject\"]].add(r[\"pose\"])\n",
        "\n",
        "    subjects = sorted(subject_conditions)\n",
        "\n",
        "    missing_conditions = {}\n",
        "\n",
        "    for subject in subjects:\n",
        "        missing = sorted(\n",
        "            set(global_conditions) - subject_conditions[subject]\n",
        "        )\n",
        "\n",
        "        missing_conditions[subject] = [\n",
        "            list(condition) for condition in missing\n",
        "        ]\n",
        "\n",
        "        print(\n",
        "            subject,\n",
        "            \"| images:\", len(subject_conditions[subject]),\n",
        "            \"| poses:\", sorted(subject_poses[subject]),\n",
        "            \"| missing conditions:\", len(missing)\n",
        "        )\n",
        "\n",
        "    # -----------------------------------------------------\n",
        "    # 4. SUBJECT INFO FILES\n",
        "    # -----------------------------------------------------\n",
        "\n",
        "    print(\"\\n[4] SUBJECT INFO FILES\")\n",
        "\n",
        "    info_paths = [\n",
        "        name for name in names\n",
        "        if name.lower().endswith(\".info\")\n",
        "    ]\n",
        "\n",
        "    info_samples = {}\n",
        "\n",
        "    for path in info_paths:\n",
        "        with archive.open(path) as f:\n",
        "            content = f.read().decode(\n",
        "                \"utf-8\", errors=\"replace\"\n",
        "            )\n",
        "\n",
        "        info_samples[os.path.basename(path)] = content[:3000]\n",
        "\n",
        "    print(\"Info files:\", len(info_paths))\n",
        "\n",
        "    for filename, content in list(info_samples.items())[:3]:\n",
        "        print(\"\\n---\", filename, \"---\")\n",
        "        print(content[:1500])\n",
        "\n",
        "    # -----------------------------------------------------\n",
        "    # 5. NON-IMAGE FILES ASSOCIATED WITH SUBJECTS\n",
        "    # -----------------------------------------------------\n",
        "\n",
        "    print(\"\\n[5] BAD AND LOG FILE COUNTS\")\n",
        "\n",
        "    bad_files = [\n",
        "        name for name in names\n",
        "        if name.lower().endswith(\".bad\")\n",
        "    ]\n",
        "\n",
        "    log_files = [\n",
        "        name for name in names\n",
        "        if name.lower().endswith(\".log\")\n",
        "    ]\n",
        "\n",
        "    print(\".bad files:\", len(bad_files))\n",
        "    print(\".log files:\", len(log_files))\n",
        "\n",
        "    # -----------------------------------------------------\n",
        "    # 6. SAVE AUDIT\n",
        "    # -----------------------------------------------------\n",
        "\n",
        "    result = {\n",
        "        \"step\": \"2.6.8\",\n",
        "        \"timestamp_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "        \"archive_path\": ARCHIVE_PATH,\n",
        "        \"pgm_count\": len(pgm_paths),\n",
        "        \"filename_valid_count\": len(parsed_records),\n",
        "        \"unmatched_pgm_count\": len(unmatched_records),\n",
        "        \"unmatched_pgm_files\": unmatched_records,\n",
        "        \"duplicate_condition_count\": len(duplicates),\n",
        "        \"duplicate_conditions\": duplicates,\n",
        "        \"global_illumination_condition_count\": len(global_conditions),\n",
        "        \"global_illumination_conditions\": [\n",
        "            list(condition) for condition in global_conditions\n",
        "        ],\n",
        "        \"subject_count\": len(subjects),\n",
        "        \"subject_pose_coverage\": {\n",
        "            subject: sorted(subject_poses[subject])\n",
        "            for subject in subjects\n",
        "        },\n",
        "        \"missing_conditions_by_subject\": missing_conditions,\n",
        "        \"info_file_count\": len(info_paths),\n",
        "        \"info_file_samples\": info_samples,\n",
        "        \"bad_file_count\": len(bad_files),\n",
        "        \"log_file_count\": len(log_files),\n",
        "        \"acceptance_status\": \"PENDING_IMAGE_CONTENT_VALIDATION\"\n",
        "    }\n",
        "\n",
        "with open(OUTPUT_PATH, \"w\") as f:\n",
        "    json.dump(result, f, indent=2)\n",
        "\n",
        "print(\"\\n[6] AUDIT SAVED\")\n",
        "print(OUTPUT_PATH)\n",
        "print(\"\\nNo extraction or archive modification performed.\")"
      ],
