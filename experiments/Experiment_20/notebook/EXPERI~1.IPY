      "cell_type": "markdown",
      "source": [
        "# Experiment 20 — Step 3.2.10\n",
        "## Additional Face-Recognition Model Feasibility Assessment\n",
        "\n",
        "### Objective\n",
        "Assess the feasibility of adding independent pretrained\n",
        "face-recognition architectures to the existing Yale B cohort.\n",
        "\n",
        "### Current baseline\n",
        "- Dataset: Cropped Extended Yale B\n",
        "- Subjects: 38\n",
        "- Evaluation observations: 2,128\n",
        "- Image dimensions: 168 × 192\n",
        "- Image mode: grayscale\n",
        "- Existing model: InceptionResnetV1 pretrained on VGGFace2\n",
        "- Existing embedding dimension: 512\n",
        "- Existing preprocessing: grayscale-to-RGB, resize to 160 × 160,\n",
        "  tensor conversion and model-specific normalization as recorded.\n",
        "\n",
        "### Assessment criteria\n",
        "1. Availability of pretrained weights.\n",
        "2. Availability of an official or clearly documented implementation.\n",
        "3. Input image requirements.\n",
        "4. Face alignment requirements.\n",
        "5. Input normalization requirements.\n",
        "6. Embedding output dimensions.\n",
        "7. CPU or free Google Colab feasibility.\n",
        "8. Compatibility with the existing Yale B images.\n",
        "9. Whether the architecture provides a genuinely independent model comparison.\n",
        "\n",
        "### Important restriction\n",
        "Do not download models, install packages, modify existing embeddings,\n",
        "or run additional inference in this step.\n",
        "\n",
        "### Output\n",
        "A structured feasibility record identifying candidate architectures\n",
        "and unresolved compatibility questions."
      ],
      "metadata": {
        "id": "NLRBTi4v3w0s"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from pathlib import Path\n",
        "import json\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "BASE = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "STEP_DIR = BASE / \"step_3_2\"\n",
        "STEP_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "OUTPUT_FILE = STEP_DIR / (\n",
        "    \"experiment20_step3210_additional_model_feasibility.json\"\n",
        ")\n",
        "\n",
        "assessment = {\n",
        "    \"experiment\": \"Experiment 20\",\n",
        "    \"step\": \"3.2.10\",\n",
        "    \"timestamp_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "\n",
        "    \"objective\": (\n",
        "        \"Assess feasibility of adding independent pretrained \"\n",
        "        \"face-recognition architectures to the Yale B cohort.\"\n",
        "    ),\n",
        "\n",
        "    \"existing_baseline\": {\n",
        "        \"architecture\": \"InceptionResnetV1\",\n",
        "        \"pretraining\": \"VGGFace2\",\n",
        "        \"embedding_dimension\": 512,\n",
        "        \"subjects\": 38,\n",
        "        \"evaluation_observations\": 2128,\n",
        "        \"image_dimensions\": [168, 192],\n",
        "        \"image_mode\": \"grayscale\",\n",
        "        \"existing_preprocessing\": (\n",
        "            \"Grayscale-to-RGB conversion, resize to 160x160, \"\n",
        "            \"tensor conversion, and recorded model preprocessing.\"\n",
        "        )\n",
        "    },\n",
        "\n",
        "    \"candidate_models\": [\n",
        "        {\n",
        "            \"name\": \"ArcFace\",\n",
        "            \"architecture_family\": \"ResNet-based face recognition\",\n",
        "            \"independent_from_facenet\": True,\n",
        "            \"pretrained_weights_available\": \"To verify\",\n",
        "            \"official_implementation\": \"To verify\",\n",
        "            \"input_requirements\": \"To verify\",\n",
        "            \"alignment_requirements\": \"To verify\",\n",
        "            \"normalization_requirements\": \"To verify\",\n",
        "            \"embedding_dimension\": \"Checkpoint-dependent\",\n",
        "            \"cpu_feasibility\": \"To test\",\n",
        "            \"compatibility\": \"Unresolved\",\n",
        "            \"decision\": \"Candidate\"\n",
        "        },\n",
        "        {\n",
        "            \"name\": \"AdaFace\",\n",
        "            \"architecture_family\": \"Adaptive-margin face recognition\",\n",
        "            \"independent_from_facenet\": True,\n",
        "            \"pretrained_weights_available\": \"To verify\",\n",
        "            \"official_implementation\": \"To verify\",\n",
        "            \"input_requirements\": \"To verify\",\n",
        "            \"alignment_requirements\": \"To verify\",\n",
        "            \"normalization_requirements\": \"To verify\",\n",
        "            \"embedding_dimension\": \"Checkpoint-dependent\",\n",
        "            \"cpu_feasibility\": \"To test\",\n",
        "            \"compatibility\": \"Unresolved\",\n",
        "            \"decision\": \"Candidate\"\n",
        "        },\n",
        "        {\n",
        "            \"name\": \"MagFace\",\n",
        "            \"architecture_family\": \"Magnitude-aware face recognition\",\n",
        "            \"independent_from_facenet\": True,\n",
        "            \"pretrained_weights_available\": \"To verify\",\n",
        "            \"official_implementation\": \"To verify\",\n",
        "            \"input_requirements\": \"To verify\",\n",
        "            \"alignment_requirements\": \"To verify\",\n",
        "            \"normalization_requirements\": \"To verify\",\n",
        "            \"embedding_dimension\": \"Checkpoint-dependent\",\n",
        "            \"cpu_feasibility\": \"To test\",\n",
        "            \"compatibility\": \"Unresolved\",\n",
        "            \"decision\": \"Candidate\"\n",
        "        }\n",
        "    ],\n",
        "\n",
        "    \"evaluation_requirements\": [\n",
        "        \"Use the same 2,414-image source cohort where supported.\",\n",
        "        \"Preserve the 38-subject and 2,128-evaluation-observation mapping.\",\n",
        "        \"Record model-specific preprocessing explicitly.\",\n",
        "        \"Record exact checkpoint provenance and SHA256.\",\n",
        "        \"Do not compare raw Euclidean distances across models as if \"\n",
        "        \"their embedding scales were directly equivalent.\",\n",
        "        \"Compare within-model illumination-group patterns.\",\n",
        "        \"Treat recognition verification as a separate evaluation \"\n",
        "        \"requiring a predefined protocol.\"\n",
        "    ],\n",
        "\n",
        "    \"known_methodological_risks\": [\n",
        "        \"Different alignment pipelines may change the effective input.\",\n",
        "        \"Grayscale-to-RGB conversion may not match model training inputs.\",\n",
        "        \"Different checkpoints may have different embedding dimensions.\",\n",
        "        \"Different embedding scales make raw distance magnitudes \"\n",
        "        \"incomparable across architectures.\",\n",
        "        \"The 38-subject cohort limits the strength of subject-disjoint \"\n",
        "        \"generalisation claims.\"\n",
        "    ],\n",
        "\n",
        "    \"restrictions\": {\n",
        "        \"downloads\": False,\n",
        "        \"package_installations\": False,\n",
        "        \"model_inference\": False,\n",
        "        \"existing_embeddings_modified\": False,\n",
        "        \"dataset_modified\": False\n",
        "    },\n",
        "\n",
        "    \"status\": \"FEASIBILITY_ASSESSMENT_PENDING_EXTERNAL_VERIFICATION\",\n",
        "    \"publication_target\": \"NOT_SELECTED\"\n",
        "}\n",
        "\n",
        "with open(OUTPUT_FILE, \"w\") as f:\n",
        "    json.dump(assessment, f, indent=2)\n",
        "\n",
        "with open(OUTPUT_FILE, \"r\") as f:\n",
        "    verified = json.load(f)\n",
        "\n",
        "print(\"=\" * 88)\n",
        "print(\"EXPERIMENT 20 — STEP 3.2.10\")\n",
        "print(\"ADDITIONAL MODEL FEASIBILITY ASSESSMENT\")\n",
        "print(\"=\" * 88)\n",
        "\n",
        "print(\"Candidate architectures:\")\n",
        "for model in verified[\"candidate_models\"]:\n",
