        "            \"random_seed\": 2026275,\n",
        "            \"rows_verified\": int(len(hemisphere_comparisons))\n",
        "        }\n",
        "    },\n",
        "\n",
        "    \"checks\": {\n",
        "        key: bool(value)\n",
        "        for key, value in checks.items()\n",
        "    },\n",
        "\n",
        "    \"passed\": int(passed),\n",
        "    \"failed\": int(failed),\n",
        "\n",
        "    \"status\": (\n",
        "        \"RESULTS_SECTION_CROSS_VALIDATION_PASSED\"\n",
        "        if failed == 0\n",
        "        else \"REVIEW_REQUIRED\"\n",
        "    ),\n",
        "\n",
        "    \"interpretation_limitations\": [\n",
        "        \"The evaluation concerns 38 identities in one cropped Yale B subset.\",\n",
        "        \"The analysis uses one fixed pretrained FaceNet model.\",\n",
        "        \"Different captures were evaluated rather than exact transformations of identical source images.\",\n",
        "        \"Euclidean displacement and cosine distance are mathematically related.\",\n",
        "        \"The hemisphere comparison is exploratory and has unequal condition counts.\",\n",
        "        \"The audit verifies consistency and provenance, not external scientific validity.\"\n",
        "    ],\n",
        "\n",
        "    \"preservation\": (\n",
        "        \"All original frozen CSV files and previous audit records \"\n",
        "        \"were read only and were not modified.\"\n",
        "    )\n",
        "}\n",
        "\n",
        "OUTPUT = (\n",
        "    OUT /\n",
        "    \"experiment20_step33107_results_consistency_audit.json\"\n",
        ")\n",
        "\n",
        "OUTPUT.write_text(\n",
        "    json.dumps(result, indent=2, allow_nan=False),\n",
        "    encoding=\"utf-8\"\n",
        ")\n",
        "\n",
        "reloaded = json.loads(\n",
        "    OUTPUT.read_text(encoding=\"utf-8\")\n",
        ")\n",
