    {
      "cell_type": "markdown",
      "source": [
        "# Experiment 20 — Step 3.3.25: Complete Table 2 Extraction and Holm Value Verification\n",
        "\n",
        "## Objective\n",
        "Extract the complete Markdown Table 2 from both manuscript copies and compare all six reported adjusted p-values with the independently verified six-test Holm correction artifact.\n",
        "\n",
        "## Procedure\n",
        "1. Locate the Table 2 heading.\n",
        "2. Skip blank lines after the heading.\n",
        "3. Extract every contiguous Markdown table row.\n",
        "4. Parse the table into six comparisons.\n",
        "5. Compare each reported adjusted p-value against the corrected CSV.\n",
        "6. Verify that both manuscript copies contain identical table content.\n",
        "\n",
        "## Integrity restrictions\n",
        "- Read-only inspection.\n",
        "- Do not edit either manuscript.\n",
        "- Do not modify the correction artifact or frozen results.\n",
        "- Do not automatically replace any values.\n",
        "\n",
        "## Expected outcome\n",
        "A definitive check of whether all six rows in Table 2 report the corrected combined-family Holm values."
      ],
      "metadata": {
        "id": "4TTztNusEMc6"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# EXPERIMENT 20 — STEP 3.3.25\n",
        "# COMPLETE TABLE 2 EXTRACTION AND VALUE VERIFICATION\n",
        "# READ-ONLY\n",
        "# ============================================================\n",
        "\n",
        "import os\n",
        "import re\n",
        "import json\n",
        "import hashlib\n",
        "import pandas as pd\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "BASE = \"/content/drive/MyDrive/Experiment_20_Results\"\n",
        "\n",
        "MANUSCRIPTS = {\n",
        "    \"integrated\": os.path.join(\n",
        "        BASE, \"step_3_3\", \"step_3312\",\n",
        "        \"experiment20_integrated_manuscript_v1.md\"\n",
        "    ),\n",
        "    \"review_copy\": os.path.join(\n",
        "        BASE, \"step_3_3\", \"step_3313\",\n",
        "        \"experiment20_step3313_manuscript_review_copy.md\"\n",
        "    )\n",
        "}\n",
        "\n",
        "CORRECTED_CSV = os.path.join(\n",
        "    BASE, \"step_3_3\", \"step_33103\",\n",
        "    \"experiment20_manuscript_six_test_holm_results.csv\"\n",
        ")\n",
        "\n",
        "OUTPUT_DIR = os.path.join(\n",
        "    BASE, \"step_3_3\", \"step_3325\"\n",
        ")\n",
        "\n",
        "os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
        "\n",
        "REPORT_PATH = os.path.join(\n",
        "    OUTPUT_DIR,\n",
        "    \"experiment20_step3325_table2_verification.json\"\n",
        ")\n",
        "\n",
        "\n",
        "def sha256_file(path):\n",
        "    h = hashlib.sha256()\n",
        "    with open(path, \"rb\") as f:\n",
        "        for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n",
        "            h.update(chunk)\n",
        "    return h.hexdigest()\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. LOAD CORRECTED SIX-TEST ARTIFACT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "corrected = pd.read_csv(CORRECTED_CSV)\n",
        "\n",
        "assert len(corrected) == 6\n",
        "assert \"manuscript_adjusted_p_value\" in corrected.columns\n",
        "\n",
        "expected = {}\n",
        "\n",
        "for _, row in corrected.iterrows():\n",
        "    key = (\n",
        "        str(row[\"metric\"]),\n",
        "        str(row[\"group_a\"]),\n",
        "        str(row[\"group_b\"])\n",
        "    )\n",
        "    expected[key] = float(row[\"manuscript_adjusted_p_value\"])\n",
        "\n",
        "print(\"=\" * 100)\n",
        "print(\"STEP 3.3.25 — TABLE 2 VERIFICATION\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "print(\"Correction artifact SHA256:\", sha256_file(CORRECTED_CSV))\n",
        "print(\"Expected comparisons:\", len(expected))\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. EXTRACT COMPLETE TABLE 2\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def extract_table(lines, heading_text):\n",
        "\n",
        "    heading_index = None\n",
        "\n",
        "    for i, line in enumerate(lines):\n",
        "        if heading_text in line:\n",
        "            heading_index = i\n",
        "            break\n",
        "\n",
        "    if heading_index is None:\n",
        "        raise ValueError(\"Table 2 heading not found.\")\n",
        "\n",
        "    # Skip blank lines between heading and table.\n",
        "    start = heading_index + 1\n",
        "\n",
        "    while start < len(lines) and not lines[start].strip():\n",
        "        start += 1\n",
        "\n",
        "    table_lines = []\n",
        "\n",
        "    for i in range(start, len(lines)):\n",
        "        line = lines[i].rstrip(\"\\n\")\n",
        "\n",
        "        if line.strip().startswith(\"|\"):\n",
        "            table_lines.append(line)\n",
        "        elif table_lines:\n",
        "            break\n",
        "\n",
        "    if not table_lines:\n",
        "        raise ValueError(\"No Markdown table rows found after heading.\")\n",
        "\n",
        "    return heading_index + 1, table_lines\n",
        "\n",
        "\n",
        "def parse_markdown_row(line):\n",
        "\n",
        "    cells = [\n",
        "        cell.strip()\n",
        "        for cell in line.strip().strip(\"|\").split(\"|\")\n",
        "    ]\n",
        "\n",
        "    return cells\n",
        "\n",
        "\n",
        "manuscript_results = {}\n",
        "\n",
        "for label, path in MANUSCRIPTS.items():\n",
        "\n",
        "    assert os.path.isfile(path), f\"Missing manuscript: {path}\"\n",
        "\n",
        "    with open(path, \"r\", encoding=\"utf-8\") as f:\n",
        "        lines = f.readlines()\n",
        "\n",
        "    heading_line, table_lines = extract_table(\n",
        "        lines,\n",
        "        \"Table 2. Identity-level pairwise comparisons\"\n",
        "    )\n",
        "\n",
        "    print(\"\\n\" + \"-\" * 100)\n",
        "    print(\"MANUSCRIPT:\", label)\n",
        "    print(\"SHA256:\", sha256_file(path))\n",
        "    print(\"Table heading line:\", heading_line)\n",
        "    print(\"Extracted table rows:\", len(table_lines))\n",
        "\n",
        "    for i, line in enumerate(table_lines):\n",
        "        print(f\"{heading_line + i + 1}: {line}\")\n",
        "\n",
        "    parsed = [parse_markdown_row(line) for line in table_lines]\n",
        "\n",
        "    # First row is header; second may be Markdown separator.\n",
        "    data_rows = []\n",
        "\n",
        "    for row in parsed[1:]:\n",
        "        if row and all(\n",
        "            re.fullmatch(r\":?-{3,}:?\", cell.replace(\" \", \"\"))\n",
        "            for cell in row\n",
        "        ):\n",
        "            continue\n",
        "\n",
        "        if row:\n",
        "            data_rows.append(row)\n",
        "\n",
        "    manuscript_results[label] = {\n",
        "        \"path\": path,\n",
        "        \"sha256\": sha256_file(path),\n",
        "        \"heading_line\": heading_line,\n",
        "        \"table_lines\": table_lines,\n",
        "        \"parsed_rows\": data_rows\n",
        "    }\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. VALIDATE TABLE STRUCTURE AND SIX VALUES\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def normalise_metric(metric_label):\n",
        "\n",
        "    metric_label = metric_label.lower().strip()\n",
        "\n",
        "    if \"euclidean\" in metric_label:\n",
        "        return \"euclidean_mean\"\n",
        "\n",
        "    if \"cosine\" in metric_label:\n",
        "        return \"cosine_mean\"\n",
        "\n",
        "    return None\n",
        "\n",
        "\n",
        "def find_p_value(row):\n",
        "\n",
        "    # Identify p-value-like cells, excluding the comparison text.\n",
        "    candidates = []\n",
        "\n",
        "    for cell in row:\n",
        "        value = cell.strip().replace(\"$\", \"\").replace(\"*\", \"\")\n",
        "\n",
        "        try:\n",
        "            numeric = float(value)\n",
        "            if 0 <= numeric <= 1:\n",
        "                candidates.append((cell, numeric))\n",
        "        except Exception:\n",
        "            pass\n",
        "\n",
        "    return candidates\n",
        "\n",
        "\n",
        "comparison_checks = {}\n",
        "\n",
        "for label, result in manuscript_results.items():\n",
        "\n",
        "    rows = result[\"parsed_rows\"]\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 100)\n",
        "    print(\"VALUE CHECK:\", label)\n",
        "    print(\"=\" * 100)\n",
        "\n",
        "    print(\"Parsed data rows:\", len(rows))\n",
        "\n",
        "    checks = []\n",
        "\n",
        "    for row in rows:\n",
        "\n",
        "        metric = normalise_metric(row[0]) if len(row) > 0 else None\n",
        "\n",
        "        comparison_text = \" \".join(row[1:3]).lower()\n",
        "\n",
        "        group_a = None\n",
        "        group_b = None\n",
        "\n",
        "        if \"near-frontal\" in comparison_text and \"oblique\" in comparison_text:\n",
        "            group_a, group_b = \"near_frontal\", \"oblique\"\n",
        "\n",
        "        elif (\n",
        "            \"near-frontal\" in comparison_text\n",
        "            and (\"large-angular\" in comparison_text or \"large angular\" in comparison_text)\n",
        "        ):\n",
        "            group_a, group_b = \"near_frontal\", \"large_angular_deviation\"\n",
        "\n",
        "        elif (\n",
        "            \"oblique\" in comparison_text\n",
        "            and (\"large-angular\" in comparison_text or \"large angular\" in comparison_text)\n",
        "        ):\n",
        "            group_a, group_b = \"oblique\", \"large_angular_deviation\"\n",
        "\n",
        "        key = (metric, group_a, group_b)\n",
        "\n",
        "        p_candidates = find_p_value(row)\n",
        "\n",
        "        check = {\n",
        "            \"row\": row,\n",
        "            \"metric\": metric,\n",
        "            \"group_a\": group_a,\n",
        "            \"group_b\": group_b,\n",
        "            \"expected_key_found\": key in expected,\n",
        "            \"p_value_candidates\": p_candidates\n",
        "        }\n",
        "\n",
        "        if key in expected and p_candidates:\n",
        "            # The final numeric p-value column is the adjusted value\n",
        "            # in the expected Table 2 layout.\n",
        "            reported_value = p_candidates[-1][1]\n",
        "            expected_value = expected[key]\n",
        "\n",
        "            check[\"reported_adjusted_p_value\"] = reported_value\n",
        "            check[\"expected_adjusted_p_value\"] = expected_value\n",
        "            check[\"matches_corrected_artifact\"] = abs(\n",
        "                reported_value - expected_value\n",
        "            ) <= max(1e-15, abs(expected_value) * 1e-6)\n",
        "\n",
        "        else:\n",
        "            check[\"matches_corrected_artifact\"] = False\n",
        "\n",
        "        checks.append(check)\n",
        "\n",
        "        print(\"\\nRow:\", row)\n",
        "        print(\"Comparison key:\", key)\n",
        "        print(\"P-value candidates:\", p_candidates)\n",
        "        print(\"Matches corrected artifact:\", check[\"matches_corrected_artifact\"])\n",
        "\n",
        "    comparison_checks[label] = checks\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. COMPARE MANUSCRIPT COPIES\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "integrated_hash = manuscript_results[\"integrated\"][\"sha256\"]\n",
        "review_hash = manuscript_results[\"review_copy\"][\"sha256\"]\n",
        "\n",
        "identical_hashes = integrated_hash == review_hash\n",
        "\n",
        "identical_table_lines = (\n",
        "    manuscript_results[\"integrated\"][\"table_lines\"]\n",
        "    == manuscript_results[\"review_copy\"][\"table_lines\"]\n",
        ")\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"MANUSCRIPT COPY COMPARISON\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "print(\"Identical SHA256:\", identical_hashes)\n",
        "print(\"Identical Table 2 lines:\", identical_table_lines)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. SUMMARY\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "summary = {}\n",
        "\n",
        "for label, checks in comparison_checks.items():\n",
        "\n",
        "    valid_matches = sum(\n",
        "        1 for item in checks\n",
        "        if item[\"matches_corrected_artifact\"]\n",
        "    )\n",
        "\n",
        "    summary[label] = {\n",
        "        \"parsed_data_rows\": len(checks),\n",
        "        \"corrected_values_matched\": valid_matches,\n",
        "        \"all_six_rows_match\": (\n",
        "            len(checks) == 6 and valid_matches == 6\n",
        "        )\n",
        "    }\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"FINAL VERIFICATION SUMMARY\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "print(json.dumps(summary, indent=2))\n",
        "print(\"Manuscript copies identical:\", identical_hashes)\n",
        "print(\"Table 2 contents identical:\", identical_table_lines)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. SAVE REPORT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "report = {\n",
        "    \"step\": \"3.3.25\",\n",
        "    \"title\": \"Complete Table 2 Extraction and Holm Value Verification\",\n",
        "    \"timestamp_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "\n",
        "    \"correction_artifact\": {\n",
        "        \"path\": CORRECTED_CSV,\n",
        "        \"sha256\": sha256_file(CORRECTED_CSV),\n",
        "        \"expected_comparison_count\": len(expected)\n",
        "    },\n",
        "\n",
        "    \"manuscripts\": manuscript_results,\n",
        "    \"comparison_checks\": comparison_checks,\n",
        "    \"summary\": summary,\n",
        "\n",
        "    \"manuscript_copies_identical\": identical_hashes,\n",
        "    \"table_contents_identical\": identical_table_lines,\n",
        "\n",
        "    \"integrity\": {\n",
        "        \"source_files_modified\": False,\n",
        "        \"manuscripts_modified\": False,\n",
        "        \"correction_artifact_modified\": False\n",
        "    }\n",
        "}\n",
        "\n",
        "with open(REPORT_PATH, \"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(report, f, indent=2, default=str)\n",
        "\n",
        "print(\"\\nReport saved:\")\n",
        "print(REPORT_PATH)\n",
        "\n",
        "print(\"\\nNo existing files were modified.\")\n",
        "print(\"STEP 3.3.25 COMPLETED\")"
