    {
      "cell_type": "markdown",
      "source": [
        "# Experiment 20 — Step 3.2.16\n",
        "## MediaPipe 30-Image Landmark Detection Pilot\n",
        "\n",
        "### Objective\n",
        "Evaluate MediaPipe Face Landmarker detection performance on the\n",
        "predefined 30-image pilot sample.\n",
        "\n",
        "### Input\n",
        "- 10 near-frontal images\n",
        "- 10 oblique images\n",
        "- 10 large-angular images\n",
        "- Original frozen Yale B source images\n",
        "- Verified Face Landmarker float16 model asset\n",
        "\n",
        "### Measurements\n",
        "1. Successful image processing.\n",
        "2. Number of detected faces per image.\n",
        "3. Whether a face was detected.\n",
        "4. Number of returned facial landmarks.\n",
        "5. Detection failures by illumination group.\n",
        "6. Processing exceptions.\n",
        "\n",
        "### Important\n",
        "A detection is considered successful only when exactly one face\n",
        "is returned with a complete landmark set.\n",
        "\n",
        "This is a detection-feasibility pilot, not an alignment validation.\n",
        "\n",
        "### Restrictions\n",
        "- Process only the 30 predefined images.\n",
        "- Do not generate aligned images.\n",
        "- Do not regenerate FaceNet embeddings.\n",
        "- Do not change the frozen dataset.\n",
        "- Preserve all detection failures in the output."
      ],
      "metadata": {
        "id": "95w1YlCw7Bi9"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from pathlib import Path\n",
        "from zipfile import ZipFile\n",
        "import io\n",
        "import json\n",
        "import hashlib\n",
        "import numpy as np\n",
        "import mediapipe as mp\n",
        "from PIL import Image\n",
        "from collections import Counter, defaultdict\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "BASE = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "STEP_DIR = BASE / \"step_3_2\"\n",
        "\n",
        "MANIFEST_FILE = STEP_DIR / (\n",
        "    \"experiment20_step3213_mediapipe_pilot_sample_manifest.json\"\n",
        ")\n",
        "\n",
        "MODEL_PATH = BASE / \"model_assets\" / \"face_landmarker.task\"\n",
        "\n",
        "OUTPUT_FILE = STEP_DIR / (\n",
        "    \"experiment20_step3216_mediapipe_detection_pilot.json\"\n",
        ")\n",
        "\n",
        "EXPECTED_MODEL_SHA256 = (\n",
        "    \"64184e229b263107bc2b804c6625db1341ff2bb731874b0bcc2fe6544e0bc9ff\"\n",
        ")\n",
        "\n",
        "EXPECTED_SOURCE_SHA256 = (\n",
        "    \"8bbabf3836d077d60626c9ee3c54c2d2851a8d2c15c8b7e13b9bc162e86ea573\"\n",
        ")\n",
        "\n",
        "print(\"=\" * 88)\n",
        "print(\"EXPERIMENT 20 — STEP 3.2.16\")\n",
        "print(\"MEDIAPIPE 30-IMAGE LANDMARK DETECTION PILOT\")\n",
        "print(\"=\" * 88)\n",
        "\n",
        "assert MANIFEST_FILE.exists(), \"Pilot sample manifest missing.\"\n",
        "assert MODEL_PATH.exists(), \"Landmarker model asset missing.\"\n",
        "\n",
        "with open(MANIFEST_FILE) as f:\n",
        "    manifest = json.load(f)\n",
        "\n",
        "assert manifest[\"sample_size\"] == 30\n",
        "assert manifest[\"status\"] == \"PILOT_SAMPLE_READY\"\n",
        "\n",
        "model_hash = hashlib.sha256(MODEL_PATH.read_bytes()).hexdigest()\n",
        "assert model_hash == EXPECTED_MODEL_SHA256, \"Model checksum mismatch.\"\n",
        "\n",
        "FROZEN_ZIP = BASE / \"Experiment_20_Stage_2_Frozen_Dataset.zip\"\n",
        "assert FROZEN_ZIP.exists(), \"Frozen dataset ZIP missing.\"\n",
        "\n",
        "with ZipFile(FROZEN_ZIP, \"r\") as frozen_zip:\n",
        "    nested_name = (\n",
        "        \"Experiment_20_Stage_2_Frozen_Dataset/source/CroppedYale.zip\"\n",
        "    )\n",
        "    nested_bytes = frozen_zip.read(nested_name)\n",
        "\n",
        "source_hash = hashlib.sha256(nested_bytes).hexdigest()\n",
        "assert source_hash == EXPECTED_SOURCE_SHA256, \"Source archive checksum mismatch.\"\n",
        "\n",
        "source_zip = ZipFile(io.BytesIO(nested_bytes), \"r\")\n",
        "\n",
        "# Build exact basename lookup for the selected original source images.\n",
        "source_lookup = {}\n",
        "\n",
        "for member in source_zip.namelist():\n",
        "    if member.lower().endswith(\".pgm\"):\n",
        "        basename = Path(member).name\n",
        "        source_lookup[basename] = member\n",
        "\n",
        "# Configure Face Landmarker in IMAGE mode.\n",
        "BaseOptions = mp.tasks.BaseOptions\n",
        "FaceLandmarker = mp.tasks.vision.FaceLandmarker\n",
        "FaceLandmarkerOptions = mp.tasks.vision.FaceLandmarkerOptions\n",
        "RunningMode = mp.tasks.vision.RunningMode\n",
        "\n",
        "options = FaceLandmarkerOptions(\n",
        "    base_options=BaseOptions(model_asset_path=str(MODEL_PATH)),\n",
        "    running_mode=RunningMode.IMAGE,\n",
        "    num_faces=2\n",
        ")\n",
        "\n",
        "results = []\n",
        "exceptions = []\n",
        "\n",
        "group_counts = defaultdict(Counter)\n",
        "\n",
        "with FaceLandmarker.create_from_options(options) as landmarker:\n",
        "\n",
        "    for i, record in enumerate(manifest[\"records\"], start=1):\n",
        "\n",
        "        filename = record[\"filename\"]\n",
        "        group = record[\"illumination_group\"]\n",
        "\n",
        "        if filename not in source_lookup:\n",
        "            result_record = {\n",
        "                **record,\n",
        "                \"processing_status\": \"SOURCE_IMAGE_NOT_FOUND\",\n",
        "                \"face_count\": None,\n",
        "                \"landmark_count\": None,\n",
        "                \"detection_success\": False\n",
        "            }\n",
        "            results.append(result_record)\n",
        "            group_counts[group][\"source_missing\"] += 1\n",
        "            continue\n",
        "\n",
        "        try:\n",
        "            image_bytes = source_zip.read(source_lookup[filename])\n",
        "\n",
        "            with Image.open(io.BytesIO(image_bytes)) as pil_image:\n",
        "                pil_image.load()\n",
        "                rgb_image = pil_image.convert(\"RGB\")\n",
        "\n",
        "            image_array = np.asarray(rgb_image)\n",
        "\n",
        "            mp_image = mp.Image(\n",
        "                image_format=mp.ImageFormat.SRGB,\n",
        "                data=image_array\n",
        "            )\n",
        "\n",
        "            detection = landmarker.detect(mp_image)\n",
        "\n",
        "            face_count = len(detection.face_landmarks)\n",
        "\n",
        "            landmark_counts = [\n",
        "                len(face)\n",
        "                for face in detection.face_landmarks\n",
        "            ]\n",
        "\n",
        "            # A successful result requires exactly one face\n",
        "            # with all 478 landmarks.\n",
        "            success = (\n",
        "                face_count == 1\n",
        "                and landmark_counts[0] == 478\n",
        "            )\n",
        "\n",
        "            result_record = {\n",
        "                **record,\n",
        "                \"processing_status\": \"PROCESSED\",\n",
        "                \"face_count\": face_count,\n",
        "                \"landmark_counts\": landmark_counts,\n",
        "                \"landmark_count\": (\n",
        "                    landmark_counts[0] if face_count == 1 else None\n",
        "                ),\n",
        "                \"detection_success\": success\n",
        "            }\n",
        "\n",
        "            group_counts[group][\"processed\"] += 1\n",
        "            group_counts[group][\n",
        "                \"successful\" if success else \"unsuccessful\"\n",
        "            ] += 1\n",
        "\n",
        "        except Exception as exc:\n",
        "            result_record = {\n",
        "                **record,\n",
        "                \"processing_status\": \"EXCEPTION\",\n",
        "                \"face_count\": None,\n",
        "                \"landmark_count\": None,\n",
        "                \"detection_success\": False,\n",
        "                \"exception\": repr(exc)\n",
        "            }\n",
        "\n",
        "            group_counts[group][\"exceptions\"] += 1\n",
        "            exceptions.append({\n",
        "                \"filename\": filename,\n",
        "                \"exception\": repr(exc)\n",
        "            })\n",
        "\n",
        "        results.append(result_record)\n",
        "\n",
        "        if i % 5 == 0:\n",
        "            print(f\"Processed: {i}/30\")\n",
        "\n",
        "source_zip.close()\n",
        "\n",
        "total_success = sum(\n",
        "    r[\"detection_success\"] for r in results\n",
        ")\n",
        "\n",
        "total_processed = sum(\n",
        "    r[\"processing_status\"] == \"PROCESSED\"\n",
        "    for r in results\n",
        ")\n",
        "\n",
        "summary_by_group = {}\n",
        "\n",
        "for group in [\n",
        "    \"near_frontal\",\n",
        "    \"oblique\",\n",
        "    \"large_angular\"\n",
        "]:\n",
        "    group_records = [\n",
        "        r for r in results\n",
        "        if r[\"illumination_group\"] == group\n",
        "    ]\n",
        "\n",
        "    summary_by_group[group] = {\n",
        "        \"total\": len(group_records),\n",
        "        \"processed\": sum(\n",
        "            r[\"processing_status\"] == \"PROCESSED\"\n",
        "            for r in group_records\n",
        "        ),\n",
        "        \"successful\": sum(\n",
        "            r[\"detection_success\"]\n",
        "            for r in group_records\n",
        "        ),\n",
        "        \"unsuccessful\": sum(\n",
        "            not r[\"detection_success\"]\n",
        "            for r in group_records\n",
        "        )\n",
        "    }\n",
        "\n",
        "audit_checks = {\n",
        "    \"30_pilot_records_processed\": len(results) == 30,\n",
        "    \"all_source_images_found\": all(\n",
        "        r[\"processing_status\"] != \"SOURCE_IMAGE_NOT_FOUND\"\n",
        "        for r in results\n",
        "    ),\n",
        "    \"model_checksum_verified\": model_hash == EXPECTED_MODEL_SHA256,\n",
        "    \"source_checksum_verified\": source_hash == EXPECTED_SOURCE_SHA256,\n",
        "    \"all_three_groups_present\": all(\n",
        "        summary_by_group[g][\"total\"] == 10\n",
        "        for g in summary_by_group\n",
        "    ),\n",
        "    \"all_results_recorded\": len(results) == 30\n",
        "}\n",
        "\n",
        "output = {\n",
        "    \"experiment\": \"Experiment 20\",\n",
        "    \"step\": \"3.2.16\",\n",
        "    \"timestamp_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "    \"model\": \"MediaPipe Face Landmarker\",\n",
        "    \"model_sha256\": model_hash,\n",
        "    \"source_archive_sha256\": source_hash,\n",
        "    \"sample_size\": 30,\n",
        "    \"processed_count\": total_processed,\n",
        "    \"successful_detection_count\": total_success,\n",
        "    \"overall_detection_rate\": total_success / 30,\n",
        "    \"group_summary\": summary_by_group,\n",
        "    \"exceptions\": exceptions,\n",
        "    \"results\": results,\n",
        "    \"audit_checks\": audit_checks,\n",
        "    \"passed_checks\": sum(audit_checks.values()),\n",
        "    \"total_checks\": len(audit_checks),\n",
        "    \"status\": (\n",
        "        \"DETECTION_PILOT_COMPLETED\"\n",
        "        if all(audit_checks.values())\n",
        "        else \"DETECTION_PILOT_AUDIT_FAILED\"\n",
        "    ),\n",
        "    \"restrictions\": {\n",
        "        \"aligned_images_generated\": False,\n",
        "        \"embeddings_generated\": False,\n",
        "        \"frozen_data_modified\": False\n",
        "    }\n",
        "}\n",
        "\n",
        "with open(OUTPUT_FILE, \"w\") as f:\n",
        "    json.dump(output, f, indent=2)\n",
        "\n",
        "with open(OUTPUT_FILE) as f:\n",
        "    reloaded = json.load(f)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 88)\n",
        "print(\"DETECTION PILOT SUMMARY\")\n",
        "print(\"=\" * 88)\n",
        "\n",
        "print(\"Images processed:\", total_processed, \"/ 30\")\n",
        "print(\"Successful detections:\", total_success, \"/ 30\")\n",
        "print(f\"Overall detection rate: {total_success / 30:.2%}\")\n",
        "\n",
        "for group, summary in summary_by_group.items():\n",
        "    print(\n",
        "        f\"{group}: \"\n",
        "        f\"{summary['successful']}/{summary['total']} successful\"\n",
        "    )\n",
        "\n",
        "print(\"\\nAUDIT\")\n",
        "for name, passed in audit_checks.items():\n",
        "    print(f\"{name}: {'PASS' if passed else 'FAIL'}\")\n",
        "\n",
        "print(\"\\nPassed:\", sum(audit_checks.values()), \"/\", len(audit_checks))\n",
        "print(\"JSON reload:\", \"PASS\" if reloaded == output else \"FAIL\")\n",
        "print(\"Saved:\", OUTPUT_FILE)\n",
        "\n",
        "print(\"\\nAligned images generated: NO\")\n",
        "print(\"FaceNet embeddings generated: NO\")\n",
        "print(\"Frozen data modified: NO\")\n",
        "print(\"=\" * 88)"
      ],
      "metadata": {
