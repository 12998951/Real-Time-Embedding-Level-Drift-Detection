            "    \"angle_unit\": \"degrees\",\n",
            "    \"groups\": {\n",
            "      \"near_frontal\": {\n",
            "        \"rule\": \"theta <= 30 degrees\",\n",
            "        \"conditions\": 17,\n",
            "        \"observations\": 646\n",
            "      },\n",
            "      \"oblique\": {\n",
            "        \"rule\": \"30 degrees < theta <= 60 degrees\",\n",
