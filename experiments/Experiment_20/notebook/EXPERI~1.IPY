      "cell_type": "markdown",
      "source": [
        "# Experiment 20 — Step 3.3.10.1\n",
        "## Frozen Results Inventory and Verification\n",
        "\n",
        "### Objective\n",
        "Inspect the frozen outputs from Step 2.7 before drafting the manuscript Results section.\n",
        "\n",
        "### Tasks\n",
        "1. Confirm the final-freeze directory exists.\n",
        "2. Inventory all frozen files.\n",
        "3. Calculate SHA256 hashes and file sizes.\n",
        "4. Inspect CSV dimensions, column names and sample records.\n",
        "5. Inspect JSON audit and summary structures.\n",
        "6. Identify the primary files containing:\n",
        "   - Overall reference-relative displacement\n",
        "   - Illumination-group statistics\n",
        "   - Identity-level group means\n",
        "   - Repeated-measures statistical tests\n",
        "   - Hemisphere comparisons\n",
        "   - Figure metadata\n",
        "\n",
        "### Important\n",
        "This is an inspection step only. Do not modify, regenerate or overwrite frozen experimental outputs.\n",
        "\n",
        "Do not draft manuscript claims from filenames or summary labels alone. Numerical claims must be traceable to the underlying tables or statistical audit."
      ],
      "metadata": {
        "id": "4lBcrzbbPnmk"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# EXPERIMENT 20\n",
        "# STEP 3.3.10.1\n",
        "# FROZEN RESULTS INVENTORY AND VERIFICATION\n",
        "# ============================================================\n",
        "\n",
        "import json\n",
        "import hashlib\n",
        "import pandas as pd\n",
        "from pathlib import Path\n",
        "\n",
        "ROOT = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "\n",
        "FREEZE_DIR = ROOT / \"step_2_7\" / \"final_freeze\"\n",
        "\n",
        "OUTPUT_DIR = ROOT / \"step_3_3\" / \"step_33101\"\n",
        "OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "AUDIT_PATH = (\n",
        "    OUTPUT_DIR /\n",
        "    \"experiment20_step33101_frozen_results_inventory.json\"\n",
        ")\n",
        "\n",
        "print(\"=\" * 75)\n",
        "print(\"EXPERIMENT 20 — STEP 3.3.10.1\")\n",
        "print(\"FROZEN RESULTS INVENTORY AND VERIFICATION\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. DIRECTORY AVAILABILITY\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n[1] DIRECTORY CHECK\")\n",
        "\n",
        "if not FREEZE_DIR.exists():\n",
        "    raise FileNotFoundError(\n",
        "        f\"Final freeze directory not found: {FREEZE_DIR}\"\n",
        "    )\n",
        "\n",
        "print(\"Final freeze directory:\", FREEZE_DIR)\n",
        "print(\"Directory exists: PASS\")\n",
        "\n",
        "all_files = sorted(\n",
        "    path for path in FREEZE_DIR.rglob(\"*\")\n",
        "    if path.is_file()\n",
        ")\n",
        "\n",
        "print(\"Total files:\", len(all_files))\n",
        "\n",
        "if not all_files:\n",
        "    raise RuntimeError(\"No files found in final freeze directory.\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. FILE INVENTORY AND SHA256\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n[2] FILE INVENTORY\")\n",
        "\n",
        "inventory = []\n",
        "\n",
        "for path in all_files:\n",
        "\n",
        "    file_hash = hashlib.sha256(\n",
        "        path.read_bytes()\n",
        "    ).hexdigest()\n",
        "\n",
        "    record = {\n",
        "        \"relative_path\": str(path.relative_to(FREEZE_DIR)),\n",
        "        \"absolute_path\": str(path),\n",
        "        \"suffix\": path.suffix.lower(),\n",
        "        \"size_bytes\": path.stat().st_size,\n",
        "        \"sha256\": file_hash\n",
        "    }\n",
        "\n",
        "    inventory.append(record)\n",
        "\n",
        "    print(\"\\nFile:\", record[\"relative_path\"])\n",
        "    print(\"Size:\", record[\"size_bytes\"], \"bytes\")\n",
        "    print(\"SHA256:\", file_hash)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. CSV INSPECTION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 75)\n",
        "print(\"[3] CSV TABLE INSPECTION\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "csv_records = []\n",
        "\n",
        "csv_files = [\n",
        "    path for path in all_files\n",
        "    if path.suffix.lower() == \".csv\"\n",
        "]\n",
        "\n",
        "for path in csv_files:\n",
        "\n",
        "    print(\"\\nCSV:\", path.name)\n",
        "\n",
        "    try:\n",
        "        df = pd.read_csv(path)\n",
        "\n",
        "        record = {\n",
        "            \"file\": str(path),\n",
        "            \"rows\": int(len(df)),\n",
        "            \"columns_count\": int(len(df.columns)),\n",
        "            \"columns\": list(df.columns),\n",
        "            \"sample_records\": df.head(3).to_dict(\n",
        "                orient=\"records\"\n",
        "            )\n",
        "        }\n",
        "\n",
        "        csv_records.append(record)\n",
        "\n",
        "        print(\"Rows:\", len(df))\n",
        "        print(\"Columns:\", len(df.columns))\n",
        "        print(\"Column names:\", list(df.columns))\n",
        "        print(\"\\nFirst three records:\")\n",
        "        print(df.head(3).to_string(index=False))\n",
        "\n",
        "    except Exception as error:\n",
        "\n",
        "        csv_records.append({\n",
        "            \"file\": str(path),\n",
        "            \"error\": str(error)\n",
        "        })\n",
        "\n",
        "        print(\"CSV READ ERROR:\", error)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. JSON INSPECTION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 75)\n",
        "print(\"[4] JSON STRUCTURE INSPECTION\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "json_records = []\n",
        "\n",
        "json_files = [\n",
        "    path for path in all_files\n",
        "    if path.suffix.lower() == \".json\"\n",
        "]\n",
        "\n",
        "for path in json_files:\n",
        "\n",
        "    print(\"\\nJSON:\", path.name)\n",
        "\n",
        "    try:\n",
        "        with open(path, \"r\", encoding=\"utf-8\") as f:\n",
        "            data = json.load(f)\n",
        "\n",
        "        if isinstance(data, dict):\n",
        "            keys = list(data.keys())\n",
        "        else:\n",
        "            keys = []\n",
        "\n",
        "        record = {\n",
        "            \"file\": str(path),\n",
        "            \"top_level_type\": type(data).__name__,\n",
        "            \"top_level_keys\": keys\n",
        "        }\n",
        "\n",
        "        json_records.append(record)\n",
        "\n",
        "        print(\"Top-level type:\", type(data).__name__)\n",
        "        print(\"Top-level keys:\", keys)\n",
        "\n",
        "        # Display relevant statistical or summary structures.\n",
        "        filename_lower = path.name.lower()\n",
        "\n",
        "        if any(term in filename_lower for term in [\n",
        "            \"summary\",\n",
        "            \"repeated_measures\",\n",
        "            \"hemisphere\",\n",
        "            \"audit\"\n",
        "        ]):\n",
        "\n",
        "            print(\"\\nJSON CONTENT:\")\n",
        "            print(json.dumps(data, indent=2)[:12000])\n",
        "\n",
        "    except Exception as error:\n",
        "\n",
        "        json_records.append({\n",
        "            \"file\": str(path),\n",
        "            \"error\": str(error)\n",
        "        })\n",
        "\n",
        "        print(\"JSON READ ERROR:\", error)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. MARKDOWN AND FIGURE INVENTORY\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 75)\n",
        "print(\"[5] REPORT AND FIGURE INVENTORY\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "text_records = []\n",
        "figure_records = []\n",
        "\n",
        "for path in all_files:\n",
        "\n",
        "    suffix = path.suffix.lower()\n",
        "\n",
        "    if suffix in [\".md\", \".txt\"]:\n",
        "        text_records.append(str(path))\n",
        "        print(\"TEXT:\", path.name)\n",
        "\n",
        "    elif suffix in [\".png\", \".jpg\", \".jpeg\", \".svg\", \".pdf\"]:\n",
        "        figure_records.append(str(path))\n",
        "        print(\"FIGURE:\", path.name)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. EXPECTED TABLE ROW-COUNT CHECKS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 75)\n",
        "print(\"[6] EXPECTED TABLE DIMENSION CHECKS\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "expected_rows = {\n",
        "    \"experiment20_reference_evaluation_displacement.csv\": 2128,\n",
        "    \"experiment20_illumination_group_statistics.csv\": 6,\n",
        "    \"experiment20_identity_group_means.csv\": 114,\n",
        "    \"experiment20_pairwise_comparisons.csv\": 6,\n",
        "    \"experiment20_hemisphere_identity_means.csv\": 76,\n",
        "    \"experiment20_hemisphere_comparison.csv\": 2\n",
        "}\n",
        "\n",
        "row_checks = {}\n",
        "\n",
        "for filename, expected in expected_rows.items():\n",
        "\n",
        "    matches = [\n",
        "        record for record in csv_records\n",
        "        if Path(record[\"file\"]).name == filename\n",
        "    ]\n",
        "\n",
        "    if not matches:\n",
        "        row_checks[filename] = {\n",
        "            \"status\": \"NOT_FOUND\",\n",
        "            \"expected_rows\": expected\n",
        "        }\n",
        "        print(filename, \"NOT FOUND\")\n",
        "        continue\n",
        "\n",
        "    actual = matches[0].get(\"rows\")\n",
        "\n",
        "    passed = actual == expected\n",
        "\n",
        "    row_checks[filename] = {\n",
        "        \"status\": \"PASS\" if passed else \"FAIL\",\n",
        "        \"expected_rows\": expected,\n",
        "        \"actual_rows\": actual\n",
        "    }\n",
        "\n",
        "    print(\n",
        "        filename,\n",
        "        \"| Expected:\", expected,\n",
        "        \"| Actual:\", actual,\n",
        "        \"|\",\n",
        "        \"PASS\" if passed else \"FAIL\"\n",
        "    )\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. SAVE INVENTORY AUDIT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "audit = {\n",
        "    \"experiment\": 20,\n",
        "    \"step\": \"3.3.10.1\",\n",
        "    \"freeze_directory\": str(FREEZE_DIR),\n",
        "    \"total_files\": len(all_files),\n",
        "    \"inventory\": inventory,\n",
        "    \"csv_tables\": csv_records,\n",
        "    \"json_files\": json_records,\n",
        "    \"text_files\": text_records,\n",
        "    \"figure_files\": figure_records,\n",
        "    \"expected_row_checks\": row_checks,\n",
        "    \"note\": (\n",
        "        \"Inventory and structural inspection only. \"\n",
        "        \"This step does not independently reproduce \"\n",
        "        \"the experimental statistics.\"\n",
        "    )\n",
        "}\n",
        "\n",
        "with open(AUDIT_PATH, \"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(audit, f, indent=4)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 75)\n",
        "print(\"[7] INVENTORY SUMMARY\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "print(\"Total files:\", len(all_files))\n",
        "print(\"CSV files:\", len(csv_files))\n",
        "print(\"JSON files:\", len(json_files))\n",
        "print(\"Text files:\", len(text_records))\n",
        "print(\"Figure files:\", len(figure_records))\n",
        "print(\"Inventory audit saved:\", AUDIT_PATH)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 75)\n",
        "print(\"STEP 3.3.10.1 COMPLETED\")\n",
        "print(\"=\" * 75)"
      ],
      "metadata": {
        "colab": {
