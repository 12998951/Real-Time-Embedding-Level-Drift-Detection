      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# EXPERIMENT 20 — PHASE 3.5\n",
        "# DISCUSSION AND LIMITATIONS AUDIT\n",
        "# READ-ONLY — NO MANUSCRIPT OR EVIDENCE MODIFICATIONS\n",
        "# ============================================================\n",
        "\n",
        "import os\n",
        "import re\n",
        "import json\n",
        "import hashlib\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "BASE = \"/content/drive/MyDrive/Experiment_20_Results\"\n",
        "\n",
        "MANUSCRIPT = os.path.join(\n",
        "    BASE, \"step_3_3\", \"step_3330\",\n",
        "    \"experiment20_integrated_manuscript_v2.md\"\n",
        ")\n",
        "\n",
        "PHASE34_REPORT = os.path.join(\n",
        "    BASE, \"step_3_4_results_interpretation\",\n",
        "    \"experiment20_phase34_results_statistical_interpretation_audit.json\"\n",
        ")\n",
        "\n",
        "OUTPUT_DIR = os.path.join(\n",
        "    BASE, \"step_3_5_discussion_limitations\"\n",
        ")\n",
        "os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
        "\n",
        "REPORT_PATH = os.path.join(\n",
        "    OUTPUT_DIR,\n",
        "    \"experiment20_phase35_discussion_limitations_audit.json\"\n",
        ")\n",
        "\n",
        "EXPECTED_MANUSCRIPT_HASH = (\n",
        "    \"2cc4156af63987fae717c37e997e6478e4253d81f584854fb5fab9f18da5e752\"\n",
        ")\n",
        "\n",
        "\n",
        "def sha256_file(path):\n",
        "    h = hashlib.sha256()\n",
        "    with open(path, \"rb\") as f:\n",
        "        for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n",
        "            h.update(chunk)\n",
        "    return h.hexdigest()\n",
        "\n",
        "\n",
        "def find_section(text, heading_pattern, next_heading_pattern=None):\n",
        "    match = re.search(\n",
        "        heading_pattern,\n",
        "        text,\n",
        "        flags=re.I | re.M\n",
        "    )\n",
        "\n",
        "    if not match:\n",
        "        return None\n",
        "\n",
        "    start = match.start()\n",
        "\n",
        "    if next_heading_pattern:\n",
        "        next_match = re.search(\n",
        "            next_heading_pattern,\n",
        "            text[match.end():],\n",
        "            flags=re.I | re.M\n",
        "        )\n",
        "\n",
        "        if next_match:\n",
        "            end = match.end() + next_match.start()\n",
        "            return text[start:end]\n",
        "\n",
        "    return text[start:]\n",
        "\n",
        "\n",
        "print(\"=\" * 100)\n",
        "print(\"EXPERIMENT 20 — PHASE 3.5\")\n",
        "print(\"DISCUSSION AND LIMITATIONS AUDIT\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. VERIFY MANUSCRIPT AND PREVIOUS PHASE\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "assert os.path.isfile(MANUSCRIPT), \"Integrated manuscript v2 missing.\"\n",
        "assert os.path.isfile(PHASE34_REPORT), \"Phase 3.4 report missing.\"\n",
        "\n",
        "manuscript_hash = sha256_file(MANUSCRIPT)\n",
        "\n",
        "assert manuscript_hash == EXPECTED_MANUSCRIPT_HASH, (\n",
        "    \"Manuscript hash differs from the verified version. \"\n",
        "    \"Stop and investigate.\"\n",
        ")\n",
        "\n",
        "with open(MANUSCRIPT, \"r\", encoding=\"utf-8\") as f:\n",
        "    manuscript = f.read()\n",
        "\n",
        "with open(PHASE34_REPORT, \"r\", encoding=\"utf-8\") as f:\n",
        "    phase34 = json.load(f)\n",
        "\n",
        "print(\"\\nMANUSCRIPT SHA256:\", manuscript_hash)\n",
        "print(\"Phase 3.4 status:\", phase34.get(\"status\"))\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. EXTRACT DISCUSSION SECTION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "discussion = find_section(\n",
        "    manuscript,\n",
        "    r\"^#{1,3}\\s*(?:4\\.\\s*)?Discussion\\b\",\n",
        "    r\"^#{1,3}\\s*(?:5\\.\\s*)?References\\b\"\n",
        ")\n",
        "\n",
        "assert discussion, \"Discussion section heading not found.\"\n",
        "\n",
        "print(\"\\nDISCUSSION SECTION\")\n",
        "print(\"Word count:\", len(discussion.split()))\n",
        "\n",
        "discussion_headings = re.findall(\n",
        "    r\"^#{1,4}\\s+.+$\",\n",
        "    discussion,\n",
        "    flags=re.M\n",
        ")\n",
        "\n",
        "print(\"\\nDISCUSSION SUBSECTIONS\")\n",
        "for heading in discussion_headings:\n",
        "    print(heading)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. DISCUSSION INTERPRETATION CHECKS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "discussion_checks = {\n",
        "    \"progressive_illumination_displacement\": (\n",
        "        \"near-frontal\" in discussion.lower()\n",
        "        and \"oblique\" in discussion.lower()\n",
        "        and \"large-angular\" in discussion.lower()\n",
        "    ),\n",
        "\n",
        "    \"identity_level_findings_discussed\": (\n",
        "        \"identity-level\" in discussion.lower()\n",
        "        or \"across identities\" in discussion.lower()\n",
        "    ),\n",
        "\n",
        "    \"statistical_significance_not_equated_with_accuracy\": (\n",
        "        \"recognition accuracy\" in discussion.lower()\n",
        "    ),\n",
        "\n",
        "    \"causal_interpretation_restricted\": (\n",
        "        \"causal\" in discussion.lower()\n",
        "    ),\n",
        "\n",
        "    \"embedding_displacement_scope_retained\": (\n",
        "        \"embedding displacement\" in discussion.lower()\n",
        "    ),\n",
        "\n",
        "    \"fixed_model_scope_retained\": (\n",
        "        \"pretrained model\" in discussion.lower()\n",
        "        or \"recognition architecture\" in discussion.lower()\n",
        "    )\n",
        "}\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. METHODOLOGICAL LIMITATIONS CHECKS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "limitation_checks = {\n",
        "    \"single_pretrained_architecture\": (\n",
        "        \"architecture\" in discussion.lower()\n",
        "        or \"facenet\" in discussion.lower()\n",
        "    ),\n",
        "\n",
        "    \"dataset_scope\": (\n",
        "        \"extended yale\" in discussion.lower()\n",
        "        or \"yale b\" in discussion.lower()\n",
        "    ),\n",
        "\n",
        "    \"cropped_frontal_pose_scope\": (\n",
        "        \"frontal-pose\" in discussion.lower()\n",
        "        or \"frontal pose\" in discussion.lower()\n",
        "        or \"cropped\" in discussion.lower()\n",
        "    ),\n",
        "\n",
        "    \"ambient_image_exclusion\": (\n",
        "        \"ambient\" in discussion.lower()\n",
        "    ),\n",
        "\n",
        "    \"direct_resize_preprocessing\": (\n",
        "        \"resize\" in discussion.lower()\n",
        "        or \"alignment\" in discussion.lower()\n",
        "    ),\n",
        "\n",
        "    \"reference_condition_limitation\": (\n",
        "        \"reference\" in discussion.lower()\n",
        "    ),\n",
        "\n",
        "    \"different_capture_conditions\": (\n",
        "        \"capture\" in discussion.lower()\n",
        "        or \"images\" in discussion.lower()\n",
        "    ),\n",
        "\n",
        "    \"recognition_performance_limitation\": (\n",
        "        \"recognition accuracy\" in discussion.lower()\n",
        "        or \"verification accuracy\" in discussion.lower()\n",
        "    ),\n",
        "\n",
        "    \"absence_of_calibrated_thresholds\": (\n",
        "        \"threshold\" in discussion.lower()\n",
        "        or \"calibrat\" in discussion.lower()\n",
        "    )\n",
        "}\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. STATISTICAL AND CAUSAL LIMITATIONS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "statistical_checks = {\n",
        "    \"euclidean_cosine_relationship\": (\n",
        "        \"euclidean\" in discussion.lower()\n",
        "        and \"cosine\" in discussion.lower()\n",
        "        and (\n",
        "            \"mathematically\" in discussion.lower()\n",
        "            or \"related\" in discussion.lower()\n",
        "        )\n",
        "    ),\n",
        "\n",
        "    \"hemisphere_analysis_exploratory\": (\n",
        "        \"exploratory\" in discussion.lower()\n",
        "    ),\n",
        "\n",
        "    \"unequal_condition_counts\": (\n",
        "        \"unequal\" in discussion.lower()\n",
        "        or \"condition counts\" in discussion.lower()\n",
        "    ),\n",
        "\n",
        "    \"no_causal_illumination_claim\": (\n",
        "        \"causal\" in discussion.lower()\n",
        "    ),\n",
        "\n",
        "    \"no_fairness_overclaim\": (\n",
        "        \"fairness\" in discussion.lower()\n",
        "    ),\n",
        "\n",
        "    \"no_deployment_readiness_overclaim\": (\n",
        "        \"deployment\" in discussion.lower()\n",
        "    ),\n",
        "\n",
        "    \"no_cross_architecture_generalisation_claim\": (\n",
        "        \"generalisation\" in discussion.lower()\n",
        "        or \"generalization\" in discussion.lower()\n",
