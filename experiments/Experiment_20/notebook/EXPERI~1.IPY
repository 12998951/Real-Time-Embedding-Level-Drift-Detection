      "cell_type": "code",
      "source": [
        "\n",
        "from pathlib import Path\n",
        "import hashlib\n",
        "import json\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "BASE = Path(\n",
        "    \"/content/drive/MyDrive/Experiment_20_Results/\"\n",
        "    \"step_4_5_statistical_methodology_audit\"\n",
        ")\n",
        "\n",
        "FILES = {\n",
        "    \"frozen_manuscript\": (\n",
        "        Path(\"/content/drive/MyDrive/Experiment_20_Results/\"\n",
        "             \"step_3_3/step_3330/experiment20_integrated_manuscript_v2.md\"),\n",
        "        \"2cc4156af63987fae717c37e997e6478e4253d81f584854fb5fab9f18da5e752\"\n",
        "    ),\n",
        "    \"final_amended_manuscript\": (\n",
        "        BASE / \"experiment20_integrated_manuscript_v2_phase45_final.md\",\n",
        "        \"eb175d98a9018797a712e90614ace8972d2589bc1ecfd54fb59b76bdebf203e3\"\n",
        "    ),\n",
        "    \"first_amended_copy\": (\n",
        "        BASE / \"experiment20_integrated_manuscript_v2_phase45_amended.md\",\n",
        "        \"d4690d2c2a006733c7ddd71fecfa9a070277aa78402acc360fe9393c47fae7c0\"\n",
        "    ),\n",
        "    \"phase45_computational_audit\": (\n",
        "        BASE / \"experiment20_phase45_statistical_methodology_audit.json\",\n",
        "        \"bf08cfbc118a7173962e3eb29e5b8987e049274645e0304ac0c570f569228237\"\n",
        "    ),\n",
        "    \"sign_test_sensitivity_audit\": (\n",
        "        BASE / \"experiment20_phase45_sign_test_sensitivity_audit.json\",\n",
        "        \"e7951e7b891d6e3c3399aa82c299229ef14f3cc54067ede09d7d5598461d0d25\"\n",
        "    ),\n",
        "    \"manuscript_amendment_record\": (\n",
        "        BASE / \"experiment20_phase45_manuscript_amendment_record.json\",\n",
        "        \"dc3fc95a04ea9a704a63d1d64d9af29add07b21a8f40ccd92695e51570f56311\"\n",
        "    ),\n",
        "    \"frozen_evaluation_csv\": (\n",
        "        Path(\"/content/drive/MyDrive/Experiment_20_Results/\"\n",
        "             \"step_2_7/final_freeze/\"\n",
        "             \"experiment20_reference_evaluation_displacement.csv\"),\n",
        "        \"d24a2a6d628eca608b8ab8e6c056fb50bc7b0e1c6c34e253dfae7c9354c9892f\"\n",
        "    )\n",
        "}\n",
        "\n",
        "def sha256(path):\n",
        "    h = hashlib.sha256()\n",
        "    with path.open(\"rb\") as f:\n",
        "        for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n",
        "            h.update(chunk)\n",
        "    return h.hexdigest()\n",
        "\n",
        "print(\"=\" * 78)\n",
        "print(\"EXPERIMENT 20 — PHASE 4.5 FINAL CLOSURE VERIFICATION\")\n",
        "print(\"=\" * 78)\n",
        "\n",
        "checks = {}\n",
        "verified_hashes = {}\n",
        "\n",
        "for name, (path, expected) in FILES.items():\n",
        "    if not path.exists():\n",
        "        checks[name] = False\n",
        "        print(\"FAIL MISSING:\", name, path)\n",
        "        continue\n",
        "\n",
        "    actual = sha256(path)\n",
        "    verified_hashes[name] = actual\n",
        "    checks[name] = actual == expected\n",
        "\n",
        "    print(\n",
        "        (\"PASS\" if checks[name] else \"FAIL\"),\n",
        "        name,\n",
        "        \"| SHA256:\",\n",
        "        actual\n",
        "    )\n",
        "\n",
        "# Verify that the final manuscript contains all four additions.\n",
        "final_path = FILES[\"final_amended_manuscript\"][0]\n",
        "final_text = final_path.read_text(encoding=\"utf-8\")\n",
        "\n",
        "required_phrases = [\n",
        "    \"exact two-sided paired sign tests were additionally\",\n",
        "    \"separate exploratory correction family\",\n",
        "    \"all 38 identities showed positive paired differences\",\n",
        "    \"all 38 identities showed positive differences between beyond-frontal\"\n",
        "]\n",
        "\n",
        "for i, phrase in enumerate(required_phrases, start=1):\n",
        "    count = final_text.count(phrase)\n",
        "    checks[f\"approved_addition_{i}\"] = count == 1\n",
        "    print(\n",
        "        (\"PASS\" if count == 1 else \"FAIL\"),\n",
        "        f\"approved_addition_{i}\",\n",
        "        \"| occurrences:\",\n",
        "        count\n",
        "    )\n",
        "\n",
        "# Verify the two correction-family statements.\n",
        "checks[\"six_primary_test_family\"] = (\n",
        "    \"combined family of six primary sign tests\" in final_text\n",
        ")\n",
        "checks[\"separate_hemisphere_family\"] = (\n",
        "    \"separate exploratory correction family\" in final_text\n",
        ")\n",
        "\n",
        "print(\n",
        "    (\"PASS\" if checks[\"six_primary_test_family\"] else \"FAIL\"),\n",
        "    \"six_primary_test_family\"\n",
        ")\n",
        "print(\n",
        "    (\"PASS\" if checks[\"separate_hemisphere_family\"] else \"FAIL\"),\n",
        "    \"separate_hemisphere_family\"\n",
        ")\n",
        "\n",
        "# Verify original and final manuscript are distinct files.\n",
        "checks[\"separate_manuscript_versions\"] = (\n",
        "    FILES[\"frozen_manuscript\"][0] != FILES[\"final_amended_manuscript\"][0]\n",
        "    and verified_hashes.get(\"frozen_manuscript\")\n",
        "        != verified_hashes.get(\"final_amended_manuscript\")\n",
        ")\n",
        "\n",
        "print(\n",
        "    (\"PASS\" if checks[\"separate_manuscript_versions\"] else \"FAIL\"),\n",
        "    \"separate_manuscript_versions\"\n",
        ")\n",
        "\n",
        "failed = [name for name, passed in checks.items() if not passed]\n",
        "\n",
        "print(\"\\n\" + \"=\" * 78)\n",
        "print(\"FINAL CHECK SUMMARY\")\n",
        "print(\"=\" * 78)\n",
        "print(\"Checks:\", len(checks))\n",
        "print(\"Passed:\", sum(checks.values()))\n",
        "print(\"Failed:\", len(failed))\n",
        "\n",
        "if failed:\n",
        "    print(\"Failed checks:\", failed)\n",
        "    print(\"\\nFINAL STATUS: CLOSURE_NOT_APPROVED\")\n",
        "    raise RuntimeError(\"Phase 4.5 closure verification failed.\")\n",
        "\n",
        "# Create a new closure record without changing existing evidence.\n",
        "closure_path = BASE / \"experiment20_phase45_final_closure_record.json\"\n",
        "\n",
        "if closure_path.exists():\n",
        "    raise FileExistsError(\n",
        "        \"Closure record already exists. Refusing to overwrite.\"\n",
        "    )\n",
        "\n",
        "closure = {\n",
        "    \"experiment\": \"Experiment 20\",\n",
        "    \"phase\": \"4.5\",\n",
        "    \"status\": \"PHASE_4_5_CLOSURE_VERIFICATION_PASSED\",\n",
        "    \"timestamp_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "    \"checks\": checks,\n",
