        "from pathlib import Path\n",
        "import hashlib\n",
        "\n",
        "BASE = Path(\n",
        "    \"/content/drive/MyDrive/Experiment_20_Results/\"\n",
        "    \"step_4_5_statistical_methodology_audit\"\n",
        ")\n",
        "\n",
        "SOURCE = BASE / \"experiment20_integrated_manuscript_v2_phase45_amended.md\"\n",
        "OUTPUT = BASE / \"experiment20_integrated_manuscript_v2_phase45_final.md\"\n",
        "\n",
        "FROZEN = Path(\n",
        "    \"/content/drive/MyDrive/Experiment_20_Results/\"\n",
        "    \"step_3_3/step_3330/experiment20_integrated_manuscript_v2.md\"\n",
        ")\n",
        "\n",
        "EXPECTED_FROZEN_SHA = (\n",
        "    \"2cc4156af63987fae717c37e997e6478e4253d81f584854fb5fab9f18da5e752\"\n",
        ")\n",
        "\n",
        "EXPECTED_AMENDED_SHA = (\n",
        "    \"d4690d2c2a006733c7ddd71fecfa9a070277aa78402acc360fe9393c47fae7c0\"\n",
        ")\n",
        "\n",
        "ADDITIONS = [\n",
        "    \"As a sensitivity analysis, exact two-sided paired sign tests were additionally\",\n",
        "    \"As an additional sensitivity analysis, exact two-sided paired sign tests were\",\n",
        "    \"In the sign-test sensitivity analysis, all 38 identities showed positive paired\",\n",
        "    \"In the exploratory hemisphere sign-test sensitivity analysis, all 38 identities\",\n",
        "]\n",
        "\n",
        "def sha(path):\n",
        "    return hashlib.sha256(path.read_bytes()).hexdigest()\n",
        "\n",
        "if not SOURCE.exists() or not FROZEN.exists():\n",
        "    raise FileNotFoundError(\"Required manuscript file is missing.\")\n",
        "\n",
        "if OUTPUT.exists():\n",
        "    raise FileExistsError(\"Final output already exists; refusing to overwrite.\")\n",
        "\n",
        "if sha(SOURCE) != EXPECTED_AMENDED_SHA:\n",
        "    raise RuntimeError(\"Amended manuscript hash mismatch.\")\n",
        "\n",
        "if sha(FROZEN) != EXPECTED_FROZEN_SHA:\n",
        "    raise RuntimeError(\"Frozen manuscript hash mismatch.\")\n",
        "\n",
        "text = SOURCE.read_text(encoding=\"utf-8\")\n",
        "\n",
        "for prefix in ADDITIONS:\n",
        "    matches = text.count(prefix)\n",
        "    if matches != 1:\n",
        "        raise RuntimeError(f\"Expected one occurrence of addition: {prefix}\")\n",
        "\n",
        "    position = text.index(prefix)\n",
        "\n",
        "    if position == 0 or text[position - 1] != \"\\n\":\n",
        "        raise RuntimeError(\"Unexpected paragraph boundary.\")\n",
        "\n",
        "    # Add a blank line before the inserted paragraph.\n",
        "    if position < 2 or text[position - 2:position] != \"\\n\\n\":\n",
        "        text = text[:position] + \"\\n\" + text[position:]\n",
        "\n",
        "with OUTPUT.open(\"x\", encoding=\"utf-8\") as f:\n",
        "    f.write(text)\n",
        "\n",
        "final_text = OUTPUT.read_text(encoding=\"utf-8\")\n",
        "\n",
        "print(\"=\" * 75)\n",
        "print(\"PHASE 4.5 — FINAL MANUSCRIPT FORMATTING VERIFICATION\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "for prefix in ADDITIONS:\n",
        "    position = final_text.index(prefix)\n",
        "    before = final_text[position - 2:position]\n",
        "    after = final_text[position + len(final_text[position:].split(\"\\n\", 1)[0]):]\n",
        "\n",
        "    passed = before == \"\\n\\n\"\n",
        "    print((\"PASS\" if passed else \"FAIL\"), prefix)\n",
        "\n",
        "    if not passed:\n",
        "        raise RuntimeError(\"Paragraph separation check failed.\")\n",
        "\n",
        "print(\"\\nOriginal frozen manuscript SHA:\", sha(FROZEN))\n",
        "print(\"First amended copy SHA:\", sha(SOURCE))\n",
        "print(\"Final manuscript SHA:\", sha(OUTPUT))\n",
        "\n",
        "print(\"Frozen manuscript unchanged:\", sha(FROZEN) == EXPECTED_FROZEN_SHA)\n",
        "print(\"First amended copy unchanged:\", sha(SOURCE) == EXPECTED_AMENDED_SHA)\n",
        "\n",
        "print(\"\\nFINAL FILE:\", OUTPUT)\n",
        "print(\"FINAL STATUS: FORMATTED_AMENDED_MANUSCRIPT_CREATED\")"
      ],
