        "# Experiment 20 — Step 3.1.16\n",
        "## Final Methodological Review Closure Audit\n",
        "\n",
        "### Objective\n",
        "Perform a final consistency audit of the methodological\n",
        "decisions and supporting evidence before closing Phase 3.1.\n",
        "\n",
        "### Audit areas\n",
        "1. Decision register completeness and status.\n",
        "2. Statistical correction decision and supporting report.\n",
        "3. Preprocessing documentation and implicit defaults.\n",
        "4. Model identity and checkpoint limitation.\n",
        "5. Dataset provenance and scope limitations.\n",
        "6. Submission-blocking count.\n",
        "7. Supporting artifact availability and integrity.\n",
        "\n",
        "### Restrictions\n",
        "- Read-only inspection.\n",
        "- Do not modify frozen Experiment 20 results.\n",
        "- Do not silently resolve known limitations.\n",
        "- Do not claim independent model validation.\n",
        "- Do not claim operational drift detection or deployment readiness.\n",
        "\n",
        "### Expected outcome\n",
        "A final methodological review audit identifying:\n",
        "- Resolved decisions.\n",
        "- Documented limitations.\n",
        "- Remaining manuscript disclosure requirements.\n",
        "- Whether Phase 3.1 can be closed."
      ],
      "metadata": {
        "id": "y7Yo6XWfx69C"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from pathlib import Path\n",
        "import json\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "BASE = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "STEP31 = BASE / \"step_3_1\"\n",
        "\n",
        "REGISTER_FILE = (\n",
        "    STEP31 / \"experiment20_step317_unresolved_decisions.json\"\n",
        ")\n",
        "\n",
        "AUDIT_FILE = (\n",
        "    STEP31 / \"experiment20_step316_final_methodological_review_audit.json\"\n",
        ")\n",
        "\n",
        "print(\"=\" * 90)\n",
        "print(\"EXPERIMENT 20 — STEP 3.1.16\")\n",
        "print(\"CORRECTED AUDIT CONDITION AND REVALIDATION\")\n",
        "print(\"=\" * 90)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. Load existing records\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "with REGISTER_FILE.open(\"r\", encoding=\"utf-8\") as f:\n",
        "    register = json.load(f)\n",
        "\n",
        "with AUDIT_FILE.open(\"r\", encoding=\"utf-8\") as f:\n",
        "    audit = json.load(f)\n",
        "\n",
        "d02 = next(\n",
        "    item for item in register[\"decisions\"]\n",
        "    if item[\"id\"] == \"D02\"\n",
        ")\n",
        "\n",
        "d02_text = d02[\"current_analysis\"].lower()\n",
        "\n",
        "print(\"\\n[1] ACTUAL D02 DISCLOSURE\")\n",
        "print(d02[\"current_analysis\"])\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. Test the actual disclosure meaning\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "has_implicit_disclosure = (\n",
        "    \"without explicitly specifying\" in d02_text\n",
        "    or \"not explicitly specified\" in d02_text\n",
        "    or \"implicit defaults\" in d02_text\n",
        ")\n",
        "\n",
        "has_interpolation = \"interpolation\" in d02_text\n",
        "has_antialias = \"antialias\" in d02_text\n",
        "\n",
        "corrected_condition = (\n",
        "    has_implicit_disclosure\n",
        "    and has_interpolation\n",
        "    and has_antialias\n",
        ")\n",
        "\n",
        "print(\"\\n[2] CORRECTED SEMANTIC CHECK\")\n",
        "print(\"Implicit-setting disclosure:\", has_implicit_disclosure)\n",
        "print(\"Interpolation mentioned:\", has_interpolation)\n",
        "print(\"Antialiasing mentioned:\", has_antialias)\n",
        "print(\"Corrected condition:\", corrected_condition)\n",
        "\n",
        "if not corrected_condition:\n",
        "    raise ValueError(\n",
        "        \"D02 does not contain the required disclosure. \"\n",
        "        \"Do not mark the audit as passed.\"\n",
        "    )\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. Correct only the failed audit check\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "matching_checks = [\n",
        "    item for item in audit[\"failed_checks\"]\n",
        "    if item[\"check\"] == \"D02 discloses implicit arguments\"\n",
        "]\n",
        "\n",
        "all_checks = audit.get(\"checks\", [])\n",
        "\n",
        "if matching_checks:\n",
        "    matching_checks[0][\"passed\"] = True\n",
        "    matching_checks[0][\"detail\"] = (\n",
        "        \"Verified: original Resize invocation did not explicitly \"\n",
        "        \"specify interpolation or antialiasing; both are documented \"\n",
        "        \"as implicit torchvision defaults.\"\n",
        "    )\n",
        "\n",
        "# The earlier audit report may not retain the full checks array.\n",
        "# Update its counts using the recorded result and this verified check.\n",
        "previous_failures = audit[\"checks_failed\"]\n",
        "\n",
        "if previous_failures != 1:\n",
        "    raise ValueError(\n",
        "        f\"Expected exactly one previous failure, found {previous_failures}.\"\n",
        "    )\n",
        "\n",
        "audit[\"checks_passed\"] = audit[\"checks_passed\"] + 1\n",
        "audit[\"checks_failed\"] = 0\n",
        "audit[\"failed_checks\"] = []\n",
        "audit[\"audit_passed\"] = True\n",
        "\n",
        "audit[\"closure_recommendation\"] = (\n",
        "    \"PHASE_3_1_READY_TO_CLOSE_WITH_DOCUMENTED_LIMITATIONS\"\n",
        ")\n",
        "\n",
        "audit[\"timestamp_utc\"] = datetime.now(\n",
        "    timezone.utc\n",
        ").isoformat()\n",
        "\n",
        "audit[\"audit_correction_note\"] = (\n",
        "    \"The previous failure was caused by an overly restrictive \"\n",
        "    \"string-matching condition. The D02 record contained the \"\n",
        "    \"equivalent wording 'without explicitly specifying'. The \"\n",
        "    \"actual decision-register text was verified before correcting \"\n",
        "    \"the audit result. No scientific record or experiment result \"\n",
        "    \"was modified.\"\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. Save corrected audit report\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "with AUDIT_FILE.open(\"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(audit, f, indent=2)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. Reload and validate\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "with AUDIT_FILE.open(\"r\", encoding=\"utf-8\") as f:\n",
        "    verified = json.load(f)\n",
        "\n",
        "assert verified[\"audit_passed\"] is True\n",
        "assert verified[\"checks_failed\"] == 0\n",
        "assert verified[\"closure_recommendation\"] == (\n",
        "    \"PHASE_3_1_READY_TO_CLOSE_WITH_DOCUMENTED_LIMITATIONS\"\n",
        ")\n",
        "\n",
        "print(\"\\n[3] FINAL AUDIT RESULT\")\n",
        "print(\"Checks passed:\", verified[\"checks_passed\"])\n",
        "print(\"Checks failed:\", verified[\"checks_failed\"])\n",
        "print(\"Submission blockers:\", verified[\"submission_blocking_count\"])\n",
        "print(\"Audit passed:\", verified[\"audit_passed\"])\n",
        "print(\"Closure recommendation:\", verified[\"closure_recommendation\"])\n",
        "\n",
        "print(\"\\n[4] INTEGRITY\")\n",
        "print(\"Decision register modified: NO\")\n",
        "print(\"Frozen experiment results modified: NO\")\n",
        "print(\"Only audit report corrected: YES\")\n",
        "print(\"JSON reload: PASS\")\n",
        "\n",
        "print(\"\\nSaved:\", AUDIT_FILE)\n",
        "\n",
        "print(\"=\" * 90)\n",
        "print(\"CORRECTED AUDIT COMPLETED\")\n",
        "print(\"=\" * 90)"
