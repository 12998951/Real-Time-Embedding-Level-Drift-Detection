      "cell_type": "code",
      "source": [
        "from pathlib import Path\n",
        "import re\n",
        "import json\n",
        "import hashlib\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "BASE = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "STEP_DIR = BASE / \"step_3_3\"\n",
        "\n",
        "SOURCE = (\n",
        "    STEP_DIR / \"step_3384\" /\n",
        "    \"experiment20_consolidated_introduction_apa7_corrected.md\"\n",
        ")\n",
        "\n",
        "REFERENCE_FILE = (\n",
        "    STEP_DIR / \"step_3383\" /\n",
        "    \"experiment20_reference_list_apa7.json\"\n",
        ")\n",
        "\n",
        "OUTPUT_DIR = STEP_DIR / \"step_3387\"\n",
        "OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "if not SOURCE.exists() or not REFERENCE_FILE.exists():\n",
        "    raise FileNotFoundError(\"Required manuscript or reference file missing.\")\n",
        "\n",
        "manuscript = SOURCE.read_text(encoding=\"utf-8\")\n",
        "\n",
        "with open(REFERENCE_FILE, \"r\", encoding=\"utf-8\") as f:\n",
        "    reference_data = json.load(f)\n",
        "\n",
        "# Detect both narrative and parenthetical APA 7 citation forms.\n",
        "patterns = {\n",
        "    \"REF01\": r\"Moses\\s+et\\s+al\\.\\s*,?\\s*\\(1994\\)\",\n",
        "    \"REF02\": r\"Beveridge\\s+et\\s+al\\.\\s*,?\\s*\\(2009\\)\",\n",
        "    \"REF03\": r\"Han\\s+et\\s+al\\.\\s*,?\\s*\\(2013\\)\",\n",
        "    \"REF04\": r\"Ochoa-Villegas\\s+et\\s+al\\.\\s*,?\\s*\\(2015\\)\"\n",
        "}\n",
        "\n",
        "reference_ids = {\n",
        "    item[\"id\"] for item in reference_data[\"references\"]\n",
        "}\n",
        "\n",
        "citation_results = {}\n",
        "\n",
        "for ref_id, pattern in patterns.items():\n",
        "    matches = list(\n",
        "        re.finditer(pattern, manuscript, flags=re.IGNORECASE)\n",
        "    )\n",
        "\n",
        "    citation_results[ref_id] = {\n",
        "        \"occurrences\": len(matches),\n",
        "        \"present\": len(matches) > 0,\n",
        "        \"reference_entry_available\": ref_id in reference_ids\n",
        "    }\n",
        "\n",
        "# Verify the Han citation is in the illumination-preprocessing paragraph.\n",
        "paragraphs = [\n",
        "    p.strip() for p in re.split(r\"\\n\\s*\\n\", manuscript)\n",
        "    if p.strip()\n",
        "]\n",
        "\n",
        "han_context = [\n",
        "    p for p in paragraphs\n",
        "    if \"Han et al., 2013\" in p\n",
        "    and \"preprocessing\" in p.lower()\n",
        "]\n",
        "\n",
        "# Verify the combined parenthetical citation.\n",
        "combined_citation_present = bool(\n",
        "    re.search(\n",
        "        r\"\\(\\s*Han\\s+et\\s+al\\.,\\s*2013\\s*;\\s*\"\n",
        "        r\"Ochoa-Villegas\\s+et\\s+al\\.,\\s*2015\\s*\\)\",\n",
        "        manuscript\n",
        "    )\n",
        ")\n",
        "\n",
        "# Check the reference list for genuinely unused entries.\n",
        "unused_references = [\n",
        "    ref_id for ref_id, result in citation_results.items()\n",
        "    if not result[\"present\"]\n",
        "]\n",
        "\n",
        "checks = {\n",
        "    \"moses_citation_present\": citation_results[\"REF01\"][\"present\"],\n",
        "    \"beveridge_citation_present\": citation_results[\"REF02\"][\"present\"],\n",
        "    \"han_citation_present\": citation_results[\"REF03\"][\"present\"],\n",
        "    \"ochoa_citation_present\": citation_results[\"REF04\"][\"present\"],\n",
        "    \"all_four_reference_entries_available\": all(\n",
        "        citation_results[ref_id][\"reference_entry_available\"]\n",
        "        for ref_id in patterns\n",
        "    ),\n",
        "    \"no_unused_references\": len(unused_references) == 0,\n",
        "    \"han_citation_in_preprocessing_context\": len(han_context) == 1,\n",
        "    \"combined_parenthetical_citation_valid\": combined_citation_present,\n",
        "    \"manuscript_file_unchanged_by_this_step\": True\n",
        "}\n",
        "\n",
        "source_hash = hashlib.sha256(\n",
        "    SOURCE.read_bytes()\n",
        ").hexdigest()\n",
        "\n",
        "audit = {\n",
        "    \"experiment\": \"Experiment 20\",\n",
        "    \"step\": \"3.3.8.7\",\n",
        "    \"timestamp_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "    \"citation_style\": \"APA 7\",\n",
        "    \"citation_detection\": citation_results,\n",
        "    \"han_citation_context_verified\": bool(han_context),\n",
        "    \"unused_references\": unused_references,\n",
        "    \"source_manuscript\": str(SOURCE),\n",
        "    \"source_manuscript_sha256\": source_hash,\n",
        "    \"manuscript_modified\": False,\n",
        "    \"checks\": checks,\n",
        "    \"passed_checks\": sum(checks.values()),\n",
        "    \"total_checks\": len(checks),\n",
        "    \"failed_checks\": [\n",
        "        key for key, value in checks.items() if not value\n",
        "    ],\n",
        "    \"status\": (\n",
        "        \"FINAL_CITATION_CONSISTENCY_VERIFIED\"\n",
        "        if all(checks.values())\n",
        "        else \"CITATION_CONSISTENCY_REQUIRES_REVIEW\"\n",
        "    )\n",
        "}\n",
        "\n",
        "AUDIT_FILE = OUTPUT_DIR / (\n",
        "    \"experiment20_step3387_final_citation_consistency_audit.json\"\n",
        ")\n",
        "\n",
        "with open(AUDIT_FILE, \"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(audit, f, indent=2, ensure_ascii=False)\n",
        "\n",
        "with open(AUDIT_FILE, \"r\", encoding=\"utf-8\") as f:\n",
        "    reloaded = json.load(f)\n",
        "\n",
        "assert reloaded == audit\n",
        "\n",
        "print(\"=\" * 88)\n",
        "print(\"EXPERIMENT 20 — STEP 3.3.8.7\")\n",
        "print(\"FINAL APA 7 CITATION CONSISTENCY VERIFICATION\")\n",
        "print(\"=\" * 88)\n",
        "\n",
        "for ref_id, result in citation_results.items():\n",
        "    print(\n",
        "        f\"{ref_id}: \"\n",
        "        f\"{'PASS' if result['present'] else 'FAIL'} \"\n",
        "        f\"| Occurrences: {result['occurrences']}\"\n",
        "    )\n",
        "\n",
        "print(\"\\nHan preprocessing context:\", \"PASS\" if han_context else \"FAIL\")\n",
        "print(\"Combined parenthetical citation:\",\n",
        "      \"PASS\" if combined_citation_present else \"FAIL\")\n",
        "\n",
        "print(\"\\nUnused references:\", unused_references)\n",
        "\n",
        "print(\"\\nChecks:\")\n",
        "for name, passed in checks.items():\n",
        "    print(f\"{name}: {'PASS' if passed else 'FAIL'}\")\n",
        "\n",
        "print(f\"\\nPassed: {audit['passed_checks']} / {audit['total_checks']}\")\n",
        "print(\"Failed:\", len(audit[\"failed_checks\"]))\n",
        "print(\"Manuscript modified:\", audit[\"manuscript_modified\"])\n",
        "print(\"Status:\", audit[\"status\"])\n",
        "\n",
        "print(\"\\nAudit JSON reload: PASS\")\n",
        "print(\"Manuscript SHA256:\", source_hash)\n",
        "print(\"Saved:\", AUDIT_FILE)\n",
        "print(\"=\" * 88)"
