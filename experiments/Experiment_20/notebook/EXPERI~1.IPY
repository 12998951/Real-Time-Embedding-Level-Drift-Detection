        "\n",
        "from pathlib import Path\n",
        "import re\n",
        "import hashlib\n",
        "\n",
        "ROOT = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "\n",
        "MANUSCRIPT = (\n",
        "    ROOT / \"step_4_5_statistical_methodology_audit\"\n",
        "    / \"experiment20_integrated_manuscript_v2_phase45_final.md\"\n",
        ")\n",
        "\n",
        "EXPECTED_HASH = (\n",
        "    \"eb175d98a9018797a712e90614ace8972d2589bc1ecfd54fb59b76bdebf203e3\"\n",
        ")\n",
        "\n",
        "EXPECTED_FIGURES = [\n",
        "    \"experiment20_figure1_euclidean_illumination_groups.png\",\n",
        "    \"experiment20_figure2_cosine_illumination_groups.png\",\n",
        "    \"experiment20_figure3_euclidean_hemisphere_comparison.png\",\n",
        "    \"experiment20_figure4_cosine_hemisphere_comparison.png\"\n",
        "]\n",
        "\n",
        "def sha(path):\n",
        "    return hashlib.sha256(path.read_bytes()).hexdigest()\n",
        "\n",
        "print(\"=\" * 80)\n",
        "print(\"EXPERIMENT 20 — PHASE 4.6 DIAGNOSTIC FOLLOW-UP\")\n",
        "print(\"=\" * 80)\n",
        "\n",
        "if not MANUSCRIPT.exists():\n",
        "    raise FileNotFoundError(MANUSCRIPT)\n",
        "\n",
        "actual_hash = sha(MANUSCRIPT)\n",
        "\n",
        "if actual_hash != EXPECTED_HASH:\n",
        "    raise RuntimeError(\"STOP: Final amended manuscript hash mismatch.\")\n",
        "\n",
        "text = MANUSCRIPT.read_text(encoding=\"utf-8\")\n",
        "lines = text.splitlines()\n",
        "\n",
        "print(\"\\n1. FIGURE SEARCH ACROSS COMPLETE EXPERIMENT 20 DIRECTORY\")\n",
        "print(\"Searching:\", ROOT)\n",
        "\n",
        "found_figures = {}\n",
        "\n",
        "for filename in EXPECTED_FIGURES:\n",
        "    matches = []\n",
        "\n",
        "    for path in ROOT.rglob(filename):\n",
        "        if path.is_file():\n",
        "            matches.append(str(path))\n",
        "\n",
        "    found_figures[filename] = matches\n",
        "\n",
        "    print(\"\\n\", filename)\n",
        "\n",
        "    if matches:\n",
        "        for match in matches:\n",
        "            print(\"FOUND:\", match)\n",
        "    else:\n",
        "        print(\"NOT FOUND anywhere under Experiment_20_Results\")\n",
        "\n",
        "print(\"\\n2. TABLE CAPTION AND HEADING DISCOVERY\")\n",
        "\n",
        "for i, line in enumerate(lines, start=1):\n",
        "    stripped = line.strip()\n",
        "\n",
        "    if re.search(r\"\\bTable\\s+[12]\\b\", stripped, re.IGNORECASE):\n",
        "        print(f\"Line {i}: {stripped}\")\n",
        "\n",
        "print(\"\\n3. TABLE CONTEXT — LINES 245 TO 300\")\n",
        "\n",
        "for i in range(244, min(300, len(lines))):\n",
        "    print(f\"{i+1}: {lines[i]}\")\n",
        "\n",
        "print(\"\\n4. FIGURE CAPTION AND REFERENCE CONTEXT\")\n",
        "\n",
        "for i, line in enumerate(lines, start=1):\n",
        "    if (\n",
        "        re.search(r\"\\bFigure\\s+[1-4]\\b\", line, re.IGNORECASE)\n",
        "        or re.search(r\"!\\[.*\\]\\(\", line)\n",
        "    ):\n",
        "        print(f\"Line {i}: {line.strip()}\")\n",
        "\n",
        "print(\"\\n5. INDEPENDENCE AND STATISTICAL LIMITATION LANGUAGE\")\n",
        "\n",
        "terms = [\n",
        "    \"independence\",\n",
        "    \"independent\",\n",
        "    \"independently\",\n",
        "    \"identity-level\",\n",
        "    \"unit of analysis\",\n",
        "    \"unit of comparison\",\n",
        "    \"38 identities\",\n",
        "    \"repeated-measures\",\n",
        "    \"symmetry assumption\",\n",
        "    \"sign test\",\n",
        "    \"exploratory\"\n",
        "]\n",
        "\n",
        "for i, line in enumerate(lines, start=1):\n",
        "    if any(term in line.lower() for term in terms):\n",
        "        print(f\"Line {i}: {line.strip()}\")\n",
        "\n",
        "print(\"\\n6. FULL LIMITATIONS SECTION\")\n",
        "\n",
        "heading = None\n",
        "\n",
        "for i, line in enumerate(lines):\n",
        "    if re.match(r\"^\\s{0,3}#{1,6}\\s+4\\.6\\b\", line):\n",
        "        heading = i\n",
        "        break\n",
        "\n",
        "if heading is None:\n",
        "    print(\"Section 4.6 heading not found.\")\n",
        "else:\n",
        "    end = len(lines)\n",
        "\n",
        "    for j in range(heading + 1, len(lines)):\n",
        "        if re.match(r\"^\\s{0,3}#{1,6}\\s+\", lines[j]):\n",
        "            end = j\n",
        "            break\n",
        "\n",
        "    for j in range(heading, end):\n",
        "        print(f\"{j+1}: {lines[j]}\")\n",
        "\n",
        "print(\"\\n7. FINAL MANUSCRIPT INTEGRITY\")\n",
        "\n",
        "final_hash = sha(MANUSCRIPT)\n",
        "\n",
        "print(\"Expected:\", EXPECTED_HASH)\n",
        "print(\"Actual:  \", final_hash)\n",
        "print(\"Unchanged:\", final_hash == EXPECTED_HASH)\n",
        "\n",
        "print(\"\\nFINAL STATUS: PHASE_4_6_DIAGNOSTIC_COMPLETED\")\n",
        "print(\"No files were modified.\")\n"
      ],
