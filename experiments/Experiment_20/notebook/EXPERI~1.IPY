\\n\",\"Experiment 15: Detector Discrimination Under Anisotropic and Correlated Embedding Distributions\\n\",\"Path: /content/drive/MyDrive/Colab Notebooks/Experiment 15: Detector Discrimination Under Anisotropic and Correlated Embedding Distributions\\n\",\"Size: 0.135 MB\\n\",\"\\n\",\"Experiment_18_Genuine_Face_Recognition_Embedding_Validation.ipynb\\n\",\"Path: /content/drive/MyDrive/Colab Notebooks/Experiment_18_Genuine_Face_Recognition_Embedding_Validation.ipynb\\n\",\"Size: 2.723 MB\\n\",\"\\n\",\"Experiment 19: Disentangling Identity-Composition Drift from Within-Identity Embedding Drift in Biometric Representation Systems.ipynb\\n\",\"Path: /content/drive/MyDrive/Colab Notebooks/Experiment 19: Disentangling Identity-Composition Drift from Within-Identity Embedding Drift in Biometric Representation Systems.ipynb\\n\",\"Size: 0.583 MB\\n\",\"\\n\",\"Experiment 20: Paired Identity-Level Evaluation of Within-Identity Embedding Drift Detection Under Multiple Controlled Biometric Acquisition Changes.ipynb\\n\",\"Path: /content/drive/MyDrive/Colab Notebooks/Experiment 20: Paired Identity-Level Evaluation of Within-Identity Embedding Drift Detection Under Multiple Controlled Biometric Acquisition Changes.ipynb\\n\",\"Size: 0.117 MB\\n\",\"\\n\",\"experiment18_facenet_lfw_embeddings.npz\\n\",\"Path: /content/drive/MyDrive/Experiment_18_Results/experiment18_facenet_lfw_embeddings.npz\\n\",\"Size: 5.405 MB\\n\",\"\\n\",\"experiment18_illumination_results.npz\\n\",\"Path: /content/drive/MyDrive/Experiment_18_Results/experiment18_illumination_results.npz\\n\",\"Size: 4.839 MB\\n\",\"\\n\",\"illumination_identity_summary.csv\\n\",\"Path: /content/drive/MyDrive/Experiment_18_Results/illumination_identity_summary.csv\\n\",\"Size: 0.001 MB\\n\",\"\\n\",\"illumination_metadata.json\\n\",\"Path: /content/drive/MyDrive/Experiment_18_Results/illumination_metadata.json\\n\",\"Size: 0.001 MB\\n\",\"\\n\",\"experiment18_final_research_evidence.md\\n\",\"Path: /content/drive/MyDrive/Experiment_18_Results/experiment18_final_research_evidence.md\\n\",\"Size: 0.008 MB\\n\",\"\\n\",\"experiment18_final_research_evidence.json\\n\",\"Path: /content/drive/MyDrive/Experiment_18_Results/experiment18_final_research_evidence.json\\n\",\"Size: 0.014 MB\\n\",\"\\n\",\"Experiment_18_Final_Research_Package.zip\\n\",\"Path: /content/drive/MyDrive/Experiment_18_Results/Experiment_18_Final_Research_Package.zip\\n\",\"Size: 10.252 MB\\n\",\"\\n\",\"===========================================================================\\n\",\"DRIVE DISCOVERY COMPLETED\\n\",\"===========================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"## Experiment 20 — Step 2.1\\n\",\"### Experiment 18 Data Archive Inspection\\n\",\"\\n\",\"Objective:\\n\",\"Inspect the existing Experiment 18 embedding archives and supporting\\n\",\"metadata to determine whether they preserve image-level correspondence\\n\",\"between original and illumination-transformed face embeddings.\\n\",\"\\n\",\"Audit requirements:\\n\",\"1. List all arrays stored in both NPZ archives.\\n\",\"2. Record each array's shape, data type, and finite-value status.\\n\",\"3. Inspect the illumination metadata JSON.\\n\",\"4. Inspect the identity summary CSV structure and sample records.\\n\",\"5. Do not modify, overwrite, or regenerate any existing research artifacts.\\n\",\"\\n\",\"Decision:\\n\",\"Proceed with Experiment 20 data preparation only after verifying\\n\",\"the availability of matched original/transformed observations.\"],\"metadata\":{\"id\":\"bhoAWFO8ZDt-\"}},{\"cell_type\":\"code\",\"source\":[\"# ============================================================\\n\",\"# EXPERIMENT 20 — STEP 2.1\\n\",\"# EXPERIMENT 18 DATA ARCHIVE INSPECTION\\n\",\"# ============================================================\\n\",\"\\n\",\"from pathlib import Path\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"import json\\n\",\"\\n\",\"base = Path(\\\"/content/drive/MyDrive/Experiment_18_Results\\\")\\n\",\"\\n\",\"archives = [\\n\",\"    base / \\\"experiment18_facenet_lfw_embeddings.npz\\\",\\n\",\"    base / \\\"experiment18_illumination_results.npz\\\"\\n\",\"]\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"EXPERIMENT 20 — EXPERIMENT 18 ARCHIVE AUDIT\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"for archive_path in archives:\\n\",\"\\n\",\"    print(f\\\"\\\\n\\\\nARCHIVE: {archive_path.name}\\\")\\n\",\"    print(\\\"-\\\" * 75)\\n\",\"\\n\",\"    if not archive_path.exists():\\n\",\"        print(\\\"ERROR: Archive not found.\\\")\\n\",\"        continue\\n\",\"\\n\",\"    with np.load(archive_path, allow_pickle=False) as data:\\n\",\"\\n\",\"        print(\\\"Stored arrays:\\\", len(data.files))\\n\",\"\\n\",\"        for key in data.files:\\n\",\"\\n\",\"            array = data[key]\\n\",\"\\n\",\"            print(f\\\"\\\\nArray name: {key}\\\")\\n\",\"            print(\\\"Shape:\\\", array.shape)\\n\",\"            print(\\\"Data type:\\\", array.dtype)\\n\",\"\\n\",\"            if np.issubdtype(array.dtype, np.number):\\n\",\"                print(\\\"All values finite:\\\", bool(np.isfinite(array).all()))\\n\",\"\\n\",\"            if array.dtype.kind in {\\\"U\\\", \\\"S\\\"}:\\n\",\"                print(\\\"Sample values:\\\", array.reshape(-1)[:5])\\n\",\"\\n\",\"print(\\\"\\\\n\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"ILLUMINATION METADATA\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"metadata_path = base / \\\"illumination_metadata.json\\\"\\n\",\"\\n\",\"if metadata_path.exists():\\n\",\"    with open(metadata_path, \\\"r\\\") as f:\\n\",\"        metadata = json.load(f)\\n\",\"\\n\",\"    print(json.dumps(metadata, indent=2))\\n\",\"else:\\n\",\"    print(\\\"Metadata file not found.\\\")\\n\",\"\\n\",\"print(\\\"\\\\n\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"IDENTITY SUMMARY CSV\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"csv_path = base / \\\"illumination_identity_summary.csv\\\"\\n\",\"\\n\",\"if csv_path.exists():\\n\",\"    summary = pd.read_csv(csv_path)\\n\",\"\\n\",\"    print(\\\"Rows:\\\", len(summary))\\n\",\"    print(\\\"Columns:\\\", list(summary.columns))\\n\",\"    print(\\\"\\\\nFirst 10 records:\\\")\\n\",\"    print(summary.head(10).to_string(index=False))\\n\",\"else:\\n\",\"    print(\\\"Identity summary CSV not found.\\\")\\n\",\"\\n\",\"print(\\\"\\\\n\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 2.1 INSPECTION COMPLETED\\\")\\n\",\"print(\\\"=\\\" * 75)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"zNv1dcklZFeC\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794346610223,\"user_tz\":360,\"elapsed\":2319,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"651ebc06-ebde-4259-81c4-9f1b00e16a27\"},\"execution_count\":null,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"===========================================================================\\n\",\"EXPERIMENT 20 — EXPERIMENT 18 ARCHIVE AUDIT\\n\",\"===========================================================================\\n\",\"\\n\",\"\\n\",\"ARCHIVE: experiment18_facenet_lfw_embeddings.npz\\n\",\"---------------------------------------------------------------------------\\n\",\"Stored arrays: 14\\n\",\"\\n\",\"Array name: reference_embeddings\\n\",\"Shape: (1460, 512)\\n\",\"Data type: float32\\n\",\"All values finite: True\\n\",\"\\n\",\"Array name: reference_labels\\n\",\"Shape: (1460,)\\n\",\"Data type: int64\\n\",\"All values finite: True\\n\",\"\\n\",\"Array name: calibration_embeddings\\n\",\"Shape: (568, 512)\\n\",\"Data type: float32\\n\",\"All values finite: True\\n\",\"\\n\",\"Array name: calibration_labels\\n\",\"Shape: (568,)\\n\",\"Data type: int64\\n\",\"All values finite: True\\n\",\"\\n\",\"Array name: evaluation_embeddings\\n\",\"Shape: (956, 512)\\n\",\"Data type: float32\\n\",\"All values finite: True\\n\",\"\\n\",\"Array name: evaluation_labels\\n\",\"Shape: (956,)\\n\",\"Data type: int64\\n\",\"All values finite: True\\n\",\"\\n\",\"Array name: reference_failures\\n\",\"Shape: (17,)\\n\",\"Data type: int64\\n\",\"All values finite: True\\n\",\"\\n\",\"Array name: calibration_failures\\n\",\"Shape: (10,)\\n\",\"Data type: int64\\n\",\"All values finite: True\\n\",\"\\n\",\"Array name: evaluation_failures\\n\",\"Shape: (12,)\\n\",\"Data type: int64\\n\",\"All values finite: True\\n\",\"\\n\",\"Array name: random_seed\\n\",\"Shape: ()\\n\",\"Data type: int64\\n\",\"All values finite: True\\n\",\"\\n\",\"Array name: model\\n\",\"Shape: ()\\n\",\"Data type: <U17\\n\",\"Sample values: ['InceptionResnetV1']\\n\",\"\\n\",\"Array name: pretrained_weights\\n\",\"Shape: ()\\n\",\"Data type: <U8\\n\",\"Sample values: ['VGGFace2']\\n\",\"\\n\",\"Array name: dataset\\n\",\"Shape: ()\\n\",\"Data type: <U3\\n\",\"Sample values: ['LFW']\\n\",\"\\n\",\"Array name: embedding_dimension\\n\",\"Shape: ()\\n\",\"Data type: int64\\n\",\"All values finite: True\\n\",\"\\n\",\"\\n\",\"ARCHIVE: experiment18_illumination_results.npz\\n\",\"---------------------------------------------------------------------------\\n\",\"Stored arrays: 11\\n\",\"\\n\",\"Array name: original_embeddings\\n\",\"Shape: (889, 512)\\n\",\"Data type: float32\\n\",\"All values finite: True\\n\",\"\\n\",\"Array name: low_illumination_embeddings\\n\",\"Shape: (889, 512)\\n\",\"Data type: float32\\n\",\"All values finite: True\\n\",\"\\n\",\"Array name: high_illumination_embeddings\\n\",\"Shape: (889, 512)\\n\",\"Data type: float32\\n\",\"All values finite: True\\n\",\"\\n\",\"Array name: paired_labels\\n\",\"Shape: (889,)\\n\",\"Data type: int64\\n\",\"All values finite: True\\n\",\"\\n\",\"Array name: common_positions\\n\",\"Shape: (889,)\\n\",\"Data type: int64\\n\",\"All values finite: True\\n\",\"\\n\",\"Array name: low_displacement\\n\",\"Shape: (889,)\\n\",\"Data type: float32\\n\",\"All values finite: True\\n\",\"\\n\",\"Array name: high_displacement\\n\",\"Shape: (889,)\\n\",\"Data type: float32\\n\",\"All values finite: True\\n\",\"\\n\",\"Array name: low_success\\n\",\"Shape: (943,)\\n\",\"Data type: int64\\n\",\"All values finite: True\\n\",\"\\n\",\"Array name: high_success\\n\",\"Shape: (897,)\\n\",\"Data type: int64\\n\",\"All values finite: True\\n\",\"\\n\",\"Array name: low_failures\\n\",\"Shape: (13,)\\n\",\"Data type: int64\\n\",\"All values finite: True\\n\",\"\\n\",\"Array name: high_failures\\n\",\"Shape: (59,)\\n\",\"Data type: int64\\n\",\"All values finite: True\\n\",\"\\n\",\"\\n\",\"===========================================================================\\n\",\"ILLUMINATION METADATA\\n\",\"===========================================================================\\n\",\"{\\n\",\"  \\\"experiment\\\": \\\"Experiment 18 - Controlled Illumination\\\",\\n\",\"  \\\"dataset\\\": \\\"LFW filtered subset\\\",\\n\",\"  \\\"model\\\": \\\"InceptionResnetV1\\\",\\n\",\"  \\\"pretrained_weights\\\": \\\"VGGFace2\\\",\\n\",\"  \\\"embedding_dimension\\\": 512,\\n\",\"  \\\"brightness_factors\\\": {\\n\",\"    \\\"low\\\": 0.5,\\n\",\"    \\\"original\\\": 1.0,\\n\",\"    \\\"high\\\": 1.5\\n\",\"  },\\n\",\"  \\\"paired_images\\\": 889,\\n\",\"  \\\"evaluation_identities\\\": 13,\\n\",\"  \\\"low_detection_failures\\\": 13,\\n\",\"  \\\"high_detection_failures\\\": 59,\\n\",\"  \\\"image_level_wilcoxon_p\\\": 4.708938281282196e-80,\\n\",\"  \\\"identity_level_wilcoxon_p\\\": 0.001220703125,\\n\",\"  \\\"mean_low_displacement\\\": 0.23466530442237854,\\n\",\"  \\\"mean_high_displacement\\\": 0.3185139298439026\\n\",\"}\\n\",\"\\n\",\"\\n\",\"===========================================================================\\n\",\"IDENTITY SUMMARY CSV\\n\",\"===========================================================================\\n\",\"Rows: 13\\n\",\"Columns: ['Identity', 'Image_Count', 'Low_Median', 'High_Median', 'Median_Difference']\\n\",\"\\n\",\"First 10 records:\\n\",\" Identity  Image_Count  Low_Median  High_Median  Median_Difference\\n\",\"        1           33    0.297117     0.364265           0.067148\\n\",\"        2           21    0.208121     0.323824           0.115703\\n\",\"        8           24    0.197136     0.363714           0.166577\\n\",\"       12          114    0.245957     0.353833           0.107877\\n\",\"       13           21    0.179511     0.258772           0.079261\\n\",\"       14          504    0.226408     0.309194           0.082787\\n\",\"       33           22    0.187496     0.228372           0.040876\\n\",\"       36           19    0.141434     0.138968          -0.002466\\n\",\"       43           18    0.232911     0.279043           0.046131\\n\",\"       45           29    0.190697     0.300279           0.109582\\n\",\"\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 2.1 INSPECTION COMPLETED\\n\",\"===========================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"## Experiment 20 — Step 2.2\\n\",\"### Image-Level Pairing and Data Provenance Verification\\n\",\"\\n\",\"Objective:\\n\",\"Verify that original, low-illumination, and high-illumination embeddings\\n\",\"at each row position correspond to the same source image.\\n\",\"\\n\",\"Audit:\\n\",\"1. Inspect the Experiment 18 notebook's data-loading and pairing logic.\\n\",\"2. Locate the creation of common_positions.\\n\",\"3. Locate the construction of original_embeddings,\\n\",\"   low_illumination_embeddings, and high_illumination_embeddings.\\n\",\"4. Verify how paired_labels were assigned.\\n\",\"5. Identify any filtering caused by face-detection failures.\\n\",\"6. Determine whether the archive preserves a reproducible mapping\\n\",\"   to the original LFW images.\\n\",\"\\n\",\"No embeddings will be modified or regenerated.\"],\"metadata\":{\"id\":\"KHaTwV2UZMcg\"}},{\"cell_type\":\"code\",\"source\":[\"# ============================================================\\n\",\"# EXPERIMENT 20 — STEP 2.2\\n\",\"# EXPERIMENT 18 NOTEBOOK PROVENANCE AUDIT\\n\",\"# ============================================================\\n\",\"\\n\",\"from pathlib import Path\\n\",\"import json\\n\",\"\\n\",\"notebook_path = Path(\\n\",\"    \\\"/content/drive/MyDrive/Colab Notebooks/\\\"\\n\",\"    \\\"Experiment_18_Genuine_Face_Recognition_Embedding_Validation.ipynb\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"EXPERIMENT 18 — PAIRING PROVENANCE AUDIT\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"if not notebook_path.exists():\\n\",\"    print(\\\"ERROR: Experiment 18 notebook not found.\\\")\\n\",\"else:\\n\",\"\\n\",\"    with open(notebook_path, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"        notebook = json.load(f)\\n\",\"\\n\",\"    print(\\\"Notebook:\\\", notebook_path.name)\\n\",\"    print(\\\"Total cells:\\\", len(notebook.get(\\\"cells\\\", [])))\\n\",\"\\n\",\"    search_terms = [\\n\",\"        \\\"common_positions\\\",\\n\",\"        \\\"original_embeddings\\\",\\n\",\"        \\\"low_illumination_embeddings\\\",\\n\",\"        \\\"high_illumination_embeddings\\\",\\n\",\"        \\\"paired_labels\\\",\\n\",\"        \\\"low_success\\\",\\n\",\"        \\\"high_success\\\",\\n\",\"        \\\"brightness\\\",\\n\",\"        \\\"savez\\\",\\n\",\"        \\\"image_paths\\\",\\n\",\"        \\\"image_names\\\",\\n\",\"        \\\"filenames\\\"\\n\",\"    ]\\n\",\"\\n\",\"    for index, cell in enumerate(notebook.get(\\\"cells\\\", [])):\\n\",\"\\n\",\"        source = \\\"\\\".join(cell.get(\\\"source\\\", []))\\n\",\"\\n\",\"        matched_terms = [\\n\",\"            term for term in search_terms\\n\",\"            if term.lower() in source.lower()\\n\",\"        ]\\n\",\"\\n\",\"        if matched_terms:\\n\",\"\\n\",\"            print(\\\"\\\\n\\\" + \\\"-\\\" * 75)\\n\",\"            print(f\\\"CELL {index} | TYPE: {cell.get('cell_type')}\\\")\\n\",\"            print(\\\"Matched terms:\\\", \\\", \\\".join(matched_terms))\\n\",\"            print(\\\"-\\\" * 75)\\n\",\"            print(source[:10000])\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"PROVENANCE AUDIT COMPLETED\\\")\\n\",\"print(\\\"=\\\" * 75)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"aHi-GMANZOf2\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794346646023,\"user_tz\":360,\"elapsed\":1402,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"eff8d700-4df3-495c-a1de-7b672ec5feec\"},\"execution_count\":null,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"\\u001b[1;30;43mStreaming output truncated to the last 5000 lines.\\u001b[0m\\n\",\"- Euclidean embedding displacement.\\n\",\"- Distribution-level distance.\\n\",\"- Drift detection rate and false alarm rate in subsequent detector evaluation.\\n\",\"\\n\",\"### Scientific Scope\\n\",\"This experiment evaluates controlled illumination perturbations. It does not represent naturally occurring temporal drift or establish real-world biometric deployment performance.\\n\",\"\\n\",\"### Status\\n\",\"Successfully completed. The evaluation partition was inspected, and five original LFW images were visually reviewed. The partition contains 968 image indices, 956 successfully extracted embeddings and 956 corresponding labels. Sample image integrity checks passed, with finite RGB pixel values within the valid [0, 1] range.\\n\",\"\\n\",\"---------------------------------------------------------------------------\\n\",\"CELL 46 | TYPE: markdown\\n\",\"Matched terms: brightness\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 15.1 — Controlled Illumination Transformation\\n\",\"\\n\",\"### Objective\\n\",\"Generate controlled illumination variants from successfully processed evaluation images.\\n\",\"\\n\",\"### Transformation Conditions\\n\",\"- Low illumination: brightness factor 0.5\\n\",\"- Original illumination: brightness factor 1.0\\n\",\"- High illumination: brightness factor 1.5\\n\",\"\\n\",\"### Methodology\\n\",\"Apply multiplicative brightness adjustments to the original RGB images. Clip pixel values to the valid [0, 1] range.\\n\",\"\\n\",\"Only images with successful original FaceNet embedding extraction will be included, preserving paired comparisons.\\n\",\"\\n\",\"### Scientific Limitation\\n\",\"These are computationally generated illumination perturbations, not naturally captured lighting conditions.\\n\",\"\\n\",\"### Status\\n\",\"Successfully completed. Controlled illumination variants were generated for all 956 successfully processed evaluation images using brightness factors of 0.5, 1.0 and 1.5. All three image collections have the expected shape of (956, 125, 94, 3). Numerical integrity checks confirmed finite pixel values within the valid [0, 1] range. These transformations are computationally generated and do not represent naturally captured lighting conditions.\\n\",\"\\n\",\"---------------------------------------------------------------------------\\n\",\"CELL 48 | TYPE: code\\n\",\"Matched terms: brightness\\n\",\"---------------------------------------------------------------------------\\n\",\"import numpy as np\\n\",\"import matplotlib.pyplot as plt\\n\",\"\\n\",\"# Exclude images where original face detection failed\\n\",\"successful_evaluation_indices = np.setdiff1d(\\n\",\"    evaluation_indices,\\n\",\"    evaluation_failures\\n\",\")\\n\",\"\\n\",\"# Confirm paired dataset size\\n\",\"print(\\\"Successful evaluation images:\\\",\\n\",\"      len(successful_evaluation_indices))\\n\",\"\\n\",\"print(\\\"Original evaluation embeddings:\\\",\\n\",\"      len(evaluation_embeddings))\\n\",\"\\n\",\"assert len(successful_evaluation_indices) == len(evaluation_embeddings)\\n\",\"\\n\",\"# Define illumination conditions\\n\",\"brightness_factors = {\\n\",\"    \\\"Low illumination\\\": 0.5,\\n\",\"    \\\"Original illumination\\\": 1.0,\\n\",\"    \\\"High illumination\\\": 1.5\\n\",\"}\\n\",\"\\n\",\"# Generate transformed images\\n\",\"illumination_images = {}\\n\",\"\\n\",\"for condition, factor in brightness_factors.items():\\n\",\"\\n\",\"    transformed = []\\n\",\"\\n\",\"    for image_index in successful_evaluation_indices:\\n\",\"\\n\",\"        original_image = lfw_dataset.images[image_index]\\n\",\"\\n\",\"        adjusted_image = np.clip(\\n\",\"            original_image * factor,\\n\",\"            0.0,\\n\",\"            1.0\\n\",\"        )\\n\",\"\\n\",\"        transformed.append(adjusted_image)\\n\",\"\\n\",\"    illumination_images[condition] = np.asarray(transformed)\\n\",\"\\n\",\"    print(\\n\",\"        condition,\\n\",\"        illumination_images[condition].shape\\n\",\"    )\\n\",\"\\n\",\"# Visualise one image under all three conditions\\n\",\"sample_position = 0\\n\",\"\\n\",\"fig, axes = plt.subplots(1, 3, figsize=(12, 4))\\n\",\"\\n\",\"for ax, (condition, images) in zip(\\n\",\"    axes, illumination_images.items()\\n\",\"):\\n\",\"\\n\",\"    ax.imshow(images[sample_position])\\n\",\"    ax.set_title(condition)\\n\",\"    ax.axis(\\\"off\\\")\\n\",\"\\n\",\"plt.suptitle(\\\"Controlled Illumination Variants\\\")\\n\",\"plt.tight_layout()\\n\",\"plt.show()\\n\",\"\\n\",\"# Validate generated images\\n\",\"for condition, images in illumination_images.items():\\n\",\"\\n\",\"    print(\\n\",\"        condition,\\n\",\"        \\\"| Finite:\\\", np.all(np.isfinite(images)),\\n\",\"        \\\"| Minimum:\\\", images.min(),\\n\",\"        \\\"| Maximum:\\\", images.max()\\n\",\"    )\\n\",\"\\n\",\"---------------------------------------------------------------------------\\n\",\"CELL 49 | TYPE: markdown\\n\",\"Matched terms: brightness\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 15.2 — FaceNet Embedding Extraction Under Illumination Changes\\n\",\"\\n\",\"### Objective\\n\",\"Extract 512-dimensional FaceNet embeddings from low- and high-illumination evaluation images.\\n\",\"\\n\",\"### Methodology\\n\",\"1. Reuse the original evaluation embeddings as the baseline.\\n\",\"2. Process low-illumination images using MTCNN and FaceNet.\\n\",\"3. Process high-illumination images using MTCNN and FaceNet.\\n\",\"4. Record face detection failures separately.\\n\",\"5. Verify embedding dimensions and numerical integrity.\\n\",\"\\n\",\"### Experimental Conditions\\n\",\"- Original: existing baseline embeddings.\\n\",\"- Low illumination: brightness factor 0.5.\\n\",\"- High illumination: brightness factor 1.5.\\n\",\"\\n\",\"### Scientific Limitation\\n\",\"Face detection may fail on transformed images. The final paired analysis must account for those failures rather than silently discarding them.\\n\",\"\\n\",\"### Status\\n\",\"Successfully completed. FaceNet embeddings were extracted from low- and high-illumination evaluation images using MTCNN and InceptionResnetV1. The original baseline contained 956 embeddings of 512 dimensions. Low illumination produced 943 valid embeddings with 13 detection failures, while high illumination produced 897 valid embeddings with 59 detection failures. Both transformed embedding collections passed numerical integrity checks, with all values finite. Detection failures were recorded separately for subsequent paired-cohort validation.\\n\",\"\\n\",\"---------------------------------------------------------------------------\\n\",\"CELL 50 | TYPE: code\\n\",\"Matched terms: low_success, high_success\\n\",\"---------------------------------------------------------------------------\\n\",\"from PIL import Image\\n\",\"from tqdm.auto import tqdm\\n\",\"import numpy as np\\n\",\"import torch\\n\",\"\\n\",\"def extract_transformed_embeddings(images, condition_name):\\n\",\"\\n\",\"    embeddings = []\\n\",\"    successful_positions = []\\n\",\"    failed_positions = []\\n\",\"\\n\",\"    for position, image in enumerate(\\n\",\"        tqdm(images, desc=condition_name)\\n\",\"    ):\\n\",\"\\n\",\"        try:\\n\",\"            image_uint8 = (\\n\",\"                np.clip(image, 0, 1) * 255\\n\",\"            ).astype(np.uint8)\\n\",\"\\n\",\"            pil_image = Image.fromarray(image_uint8)\\n\",\"\\n\",\"            face_tensor = mtcnn(pil_image)\\n\",\"\\n\",\"            if face_tensor is None:\\n\",\"                failed_positions.append(position)\\n\",\"                continue\\n\",\"\\n\",\"            with torch.no_grad():\\n\",\"                embedding = facenet(\\n\",\"                    face_tensor.unsqueeze(0).to(device)\\n\",\"                )\\n\",\"\\n\",\"            embedding = embedding.cpu().numpy()[0]\\n\",\"\\n\",\"            if not np.all(np.isfinite(embedding)):\\n\",\"                failed_positions.append(position)\\n\",\"                continue\\n\",\"\\n\",\"            embeddings.append(embedding)\\n\",\"            successful_positions.append(position)\\n\",\"\\n\",\"        except Exception:\\n\",\"            failed_positions.append(position)\\n\",\"\\n\",\"    return (\\n\",\"        np.asarray(embeddings),\\n\",\"        np.asarray(successful_positions),\\n\",\"        np.asarray(failed_positions)\\n\",\"    )\\n\",\"\\n\",\"\\n\",\"# Extract low-illumination embeddings\\n\",\"low_embeddings, low_success, low_failures = (\\n\",\"    extract_transformed_embeddings(\\n\",\"        illumination_images[\\\"Low illumination\\\"],\\n\",\"        \\\"Low illumination\\\"\\n\",\"    )\\n\",\")\\n\",\"\\n\",\"# Extract high-illumination embeddings\\n\",\"high_embeddings, high_success, high_failures = (\\n\",\"    extract_transformed_embeddings(\\n\",\"        illumination_images[\\\"High illumination\\\"],\\n\",\"        \\\"High illumination\\\"\\n\",\"    )\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\nEMBEDDING EXTRACTION SUMMARY\\\")\\n\",\"\\n\",\"print(\\\"Original embeddings:\\\", evaluation_embeddings.shape)\\n\",\"\\n\",\"print(\\\"Low illumination embeddings:\\\", low_embeddings.shape)\\n\",\"print(\\\"Low illumination failures:\\\", len(low_failures))\\n\",\"\\n\",\"print(\\\"High illumination embeddings:\\\", high_embeddings.shape)\\n\",\"print(\\\"High illumination failures:\\\", len(high_failures))\\n\",\"\\n\",\"print(\\\"\\\\nNUMERICAL VALIDATION\\\")\\n\",\"\\n\",\"print(\\\"Low embeddings finite:\\\",\\n\",\"      np.all(np.isfinite(low_embeddings)))\\n\",\"\\n\",\"print(\\\"High embeddings finite:\\\",\\n\",\"      np.all(np.isfinite(high_embeddings)))\\n\",\"\\n\",\"print(\\\"Low successful positions:\\\", len(low_success))\\n\",\"print(\\\"High successful positions:\\\", len(high_success))\\n\",\"\\n\",\"---------------------------------------------------------------------------\\n\",\"CELL 52 | TYPE: code\\n\",\"Matched terms: common_positions, original_embeddings, paired_labels, low_success, high_success\\n\",\"---------------------------------------------------------------------------\\n\",\"import numpy as np\\n\",\"\\n\",\"# Preserve the original extraction order\\n\",\"evaluation_failure_set = set(evaluation_failures)\\n\",\"\\n\",\"ordered_original_indices = np.array([\\n\",\"    idx for idx in evaluation_indices\\n\",\"    if idx not in evaluation_failure_set\\n\",\"])\\n\",\"\\n\",\"# Verify original image-to-embedding alignment\\n\",\"assert len(ordered_original_indices) == len(evaluation_embeddings)\\n\",\"\\n\",\"original_labels_check = lfw_dataset.target[\\n\",\"    ordered_original_indices\\n\",\"]\\n\",\"\\n\",\"assert np.array_equal(\\n\",\"    original_labels_check,\\n\",\"    evaluation_labels\\n\",\"), \\\"Original image and embedding labels are misaligned.\\\"\\n\",\"\\n\",\"# Find positions successful under both transformations\\n\",\"common_positions = np.intersect1d(\\n\",\"    low_success,\\n\",\"    high_success\\n\",\")\\n\",\"\\n\",\"# Match all three conditions\\n\",\"paired_original_embeddings = evaluation_embeddings[\\n\",\"    common_positions\\n\",\"]\\n\",\"\\n\",\"paired_low_embeddings = low_embeddings[\\n\",\"    np.searchsorted(low_success, common_positions)\\n\",\"]\\n\",\"\\n\",\"paired_high_embeddings = high_embeddings[\\n\",\"    np.searchsorted(high_success, common_positions)\\n\",\"]\\n\",\"\\n\",\"# Verify identity consistency\\n\",\"paired_labels = evaluation_labels[common_positions]\\n\",\"\\n\",\"print(\\\"PAIRED COHORT VALIDATION\\\")\\n\",\"print(\\\"-\\\" * 50)\\n\",\"\\n\",\"print(\\\"Original successful images:\\\", len(ordered_original_indices))\\n\",\"print(\\\"Low illumination successes:\\\", len(low_success))\\n\",\"print(\\\"High illumination successes:\\\", len(high_success))\\n\",\"\\n\",\"print(\\\"Images successful in all three conditions:\\\",\\n\",\"      len(common_positions))\\n\",\"\\n\",\"print(\\\"\\\\nEmbedding shapes:\\\")\\n\",\"print(\\\"Original:\\\", paired_original_embeddings.shape)\\n\",\"print(\\\"Low:\\\", paired_low_embeddings.shape)\\n\",\"print(\\\"High:\\\", paired_high_embeddings.shape)\\n\",\"\\n\",\"print(\\\"\\\\nIdentity labels aligned:\\\",\\n\",\"      np.array_equal(\\n\",\"          paired_labels,\\n\",\"          lfw_dataset.target[\\n\",\"              ordered_original_indices[common_positions]\\n\",\"          ]\\n\",\"      ))\\n\",\"\\n\",\"print(\\\"All paired embeddings finite:\\\",\\n\",\"      all(np.all(np.isfinite(x)) for x in [\\n\",\"          paired_original_embeddings,\\n\",\"          paired_low_embeddings,\\n\",\"          paired_high_embeddings\\n\",\"      ]))\\n\",\"\\n\",\"assert paired_original_embeddings.shape == paired_low_embeddings.shape\\n\",\"assert paired_original_embeddings.shape == paired_high_embeddings.shape\\n\",\"assert paired_original_embeddings.shape[1] == 512\\n\",\"\\n\",\"---------------------------------------------------------------------------\\n\",\"CELL 53 | TYPE: markdown\\n\",\"Matched terms: brightness\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 15.4 — Illumination-Induced Embedding Displacement Analysis\\n\",\"\\n\",\"### Objective\\n\",\"Quantify the changes in FaceNet embedding representations caused by controlled illumination transformations.\\n\",\"\\n\",\"### Methodology\\n\",\"Compare paired original embeddings against their corresponding low- and high-illumination embeddings.\\n\",\"\\n\",\"### Evaluation Metrics\\n\",\"1. Cosine similarity between original and transformed embeddings.\\n\",\"2. Euclidean distance between original and transformed embeddings.\\n\",\"3. Mean, median and standard deviation of embedding displacement.\\n\",\"4. 95th percentile of embedding displacement.\\n\",\"\\n\",\"### Research Purpose\\n\",\"Determine whether controlled illumination changes produce measurable shifts in genuine face-recognition embedding representations.\\n\",\"\\n\",\"### Scientific Limitation\\n\",\"This analysis measures representation changes, not identity recognition accuracy or real-world temporal drift.\\n\",\"\\n\",\"### Status\\n\",\"Successfully completed. Illumination-induced embedding displacement was calculated for 889 correctly paired evaluation images. Cosine similarity and Euclidean displacement statistics, including mean, median, standard deviation and 95th percentile distance, were computed for low- and high-illumination conditions. The analysis quantifies changes in embedding representations under controlled brightness transformations; it does not establish identity recognition accuracy or real-world temporal drift.\\n\",\"\\n\",\"---------------------------------------------------------------------------\\n\",\"CELL 54 | TYPE: code\\n\",\"Matched terms: common_positions, original_embeddings\\n\",\"---------------------------------------------------------------------------\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"\\n\",\"def calculate_embedding_displacement(\\n\",\"    original_embeddings,\\n\",\"    transformed_embeddings,\\n\",\"    condition_name\\n\",\"):\\n\",\"\\n\",\"    # Calculate cosine similarity for paired embeddings\\n\",\"    cosine_similarities = np.sum(\\n\",\"        original_embeddings * transformed_embeddings,\\n\",\"        axis=1\\n\",\"    ) / (\\n\",\"        np.linalg.norm(original_embeddings, axis=1) *\\n\",\"        np.linalg.norm(transformed_embeddings, axis=1)\\n\",\"    )\\n\",\"\\n\",\"    # Calculate Euclidean displacement\\n\",\"    euclidean_distances = np.linalg.norm(\\n\",\"        original_embeddings - transformed_embeddings,\\n\",\"        axis=1\\n\",\"    )\\n\",\"\\n\",\"    return {\\n\",\"        \\\"Condition\\\": condition_name,\\n\",\"        \\\"Mean Cosine Similarity\\\": np.mean(cosine_similarities),\\n\",\"        \\\"Median Cosine Similarity\\\": np.median(cosine_similarities),\\n\",\"        \\\"Mean Euclidean Distance\\\": np.mean(euclidean_distances),\\n\",\"        \\\"Median Euclidean Distance\\\": np.median(euclidean_distances),\\n\",\"        \\\"Std Euclidean Distance\\\": np.std(euclidean_distances),\\n\",\"        \\\"95th Percentile Distance\\\": np.percentile(\\n\",\"            euclidean_distances, 95\\n\",\"        )\\n\",\"    }\\n\",\"\\n\",\"\\n\",\"# Compare original embeddings with transformed embeddings\\n\",\"low_results = calculate_embedding_displacement(\\n\",\"    paired_original_embeddings,\\n\",\"    paired_low_embeddings,\\n\",\"    \\\"Low illumination\\\"\\n\",\")\\n\",\"\\n\",\"high_results = calculate_embedding_displacement(\\n\",\"    paired_original_embeddings,\\n\",\"    paired_high_embeddings,\\n\",\"    \\\"High illumination\\\"\\n\",\")\\n\",\"\\n\",\"illumination_displacement_results = pd.DataFrame([\\n\",\"    low_results,\\n\",\"    high_results\\n\",\"])\\n\",\"\\n\",\"print(\\\"ILLUMINATION-INDUCED EMBEDDING DISPLACEMENT\\\")\\n\",\"print(\\\"Paired evaluation images:\\\", len(common_positions))\\n\",\"\\n\",\"display(\\n\",\"    illumination_displacement_results.round(6)\\n\",\")\\n\",\"\\n\",\"---------------------------------------------------------------------------\\n\",\"CELL 56 | TYPE: code\\n\",\"Matched terms: original_embeddings\\n\",\"---------------------------------------------------------------------------\\n\",\"import matplotlib.pyplot as plt\\n\",\"import numpy as np\\n\",\"\\n\",\"low_distances = np.linalg.norm(\\n\",\"    paired_original_embeddings - paired_low_embeddings,\\n\",\"    axis=1\\n\",\")\\n\",\"\\n\",\"high_distances = np.linalg.norm(\\n\",\"    paired_original_embeddings - paired_high_embeddings,\\n\",\"    axis=1\\n\",\")\\n\",\"\\n\",\"plt.figure(figsize=(10, 6))\\n\",\"\\n\",\"plt.hist(\\n\",\"    low_distances,\\n\",\"    bins=40,\\n\",\"    alpha=0.6,\\n\",\"    density=True,\\n\",\"    label=\\\"Low illumination\\\"\\n\",\")\\n\",\"\\n\",\"plt.hist(\\n\",\"    high_distances,\\n\",\"    bins=40,\\n\",\"    alpha=0.6,\\n\",\"    density=True,\\n\",\"    label=\\\"High illumination\\\"\\n\",\")\\n\",\"\\n\",\"plt.xlabel(\\\"Euclidean Embedding Displacement\\\")\\n\",\"plt.ylabel(\\\"Density\\\")\\n\",\"plt.title(\\\"FaceNet Embedding Displacement Under Illumination Changes\\\")\\n\",\"plt.legend()\\n\",\"plt.grid(alpha=0.3)\\n\",\"plt.tight_layout()\\n\",\"plt.show()\\n\",\"\\n\",\"print(\\\"LOW ILLUMINATION\\\")\\n\",\"print(\\\"Mean:\\\", np.mean(low_distances))\\n\",\"print(\\\"Median:\\\", np.median(low_distances))\\n\",\"\\n\",\"print(\\\"\\\\nHIGH ILLUMINATION\\\")\\n\",\"print(\\\"Mean:\\\", np.mean(high_distances))\\n\",\"print(\\\"Median:\\\", np.median(high_distances))\\n\",\"\\n\",\"---------------------------------------------------------------------------\\n\",\"CELL 60 | TYPE: code\\n\",\"Matched terms: paired_labels\\n\",\"---------------------------------------------------------------------------\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"from scipy.stats import wilcoxon\\n\",\"\\n\",\"# Build image-level results\\n\",\"identity_results = pd.DataFrame({\\n\",\"    \\\"Identity\\\": paired_labels,\\n\",\"    \\\"Low_Displacement\\\": low_distances,\\n\",\"    \\\"High_Displacement\\\": high_distances\\n\",\"})\\n\",\"\\n\",\"# Aggregate displacement within each identity\\n\",\"identity_summary = (\\n\",\"    identity_results\\n\",\"    .groupby(\\\"Identity\\\")\\n\",\"    .agg(\\n\",\"        Image_Count=(\\\"Low_Displacement\\\", \\\"size\\\"),\\n\",\"        Low_Median=(\\\"Low_Displacement\\\", \\\"median\\\"),\\n\",\"        High_Median=(\\\"High_Displacement\\\", \\\"median\\\")\\n\",\"    )\\n\",\"    .reset_index()\\n\",\")\\n\",\"\\n\",\"identity_summary[\\\"Median_Difference\\\"] = (\\n\",\"    identity_summary[\\\"High_Median\\\"] -\\n\",\"    identity_summary[\\\"Low_Median\\\"]\\n\",\")\\n\",\"\\n\",\"# Identity-level paired statistical test\\n\",\"identity_statistic, identity_p_value = wilcoxon(\\n\",\"    identity_summary[\\\"High_Median\\\"],\\n\",\"    identity_summary[\\\"Low_Median\\\"],\\n\",\"    alternative=\\\"two-sided\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"IDENTITY-LEVEL ILLUMINATION ANALYSIS\\\")\\n\",\"print(\\\"-\\\" * 55)\\n\",\"\\n\",\"display(identity_summary.round(6))\\n\",\"\\n\",\"print(\\\"\\\\nIDENTITY-LEVEL STATISTICAL TEST\\\")\\n\",\"print(\\\"Number of identities:\\\", len(identity_summary))\\n\",\"print(\\\"Wilcoxon statistic:\\\", identity_statistic)\\n\",\"print(\\\"P-value:\\\", identity_p_value)\\n\",\"\\n\",\"print(\\n\",\"    \\\"Identities with greater high-illumination displacement:\\\",\\n\",\"    (identity_summary[\\\"Median_Difference\\\"] > 0).sum()\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"Identities with lower high-illumination displacement:\\\",\\n\",\"    (identity_summary[\\\"Median_Difference\\\"] < 0).sum()\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"Median identity-level difference:\\\",\\n\",\"    identity_summary[\\\"Median_Difference\\\"].median()\\n\",\")\\n\",\"\\n\",\"---------------------------------------------------------------------------\\n\",\"CELL 64 | TYPE: code\\n\",\"Matched terms: common_positions, original_embeddings, low_illumination_embeddings, high_illumination_embeddings, paired_labels, low_success, high_success, brightness, savez\\n\",\"---------------------------------------------------------------------------\\n\",\"import os\\n\",\"import json\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"\\n\",\"# Create output directory\\n\",\"output_dir = \\\"/content/drive/MyDrive/Experiment_18_Results\\\"\\n\",\"os.makedirs(output_dir, exist_ok=True)\\n\",\"\\n\",\"# Save numerical experiment results\\n\",\"np.savez_compressed(\\n\",\"    os.path.join(output_dir, \\\"experiment18_illumination_results.npz\\\"),\\n\",\"\\n\",\"    original_embeddings=paired_original_embeddings,\\n\",\"    low_illumination_embeddings=paired_low_embeddings,\\n\",\"    high_illumination_embeddings=paired_high_embeddings,\\n\",\"\\n\",\"    paired_labels=paired_labels,\\n\",\"    common_positions=common_positions,\\n\",\"\\n\",\"    low_displacement=low_distances,\\n\",\"    high_displacement=high_distances,\\n\",\"\\n\",\"    low_success=low_success,\\n\",\"    high_success=high_success,\\n\",\"\\n\",\"    low_failures=low_failures,\\n\",\"    high_failures=high_failures\\n\",\")\\n\",\"\\n\",\"# Save identity-level summary\\n\",\"identity_summary.to_csv(\\n\",\"    os.path.join(output_dir, \\\"illumination_identity_summary.csv\\\"),\\n\",\"    index=False\\n\",\")\\n\",\"\\n\",\"# Save aggregate statistics\\n\",\"illumination_metadata = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 18 - Controlled Illumination\\\",\\n\",\"    \\\"dataset\\\": \\\"LFW filtered subset\\\",\\n\",\"    \\\"model\\\": \\\"InceptionResnetV1\\\",\\n\",\"    \\\"pretrained_weights\\\": \\\"VGGFace2\\\",\\n\",\"    \\\"embedding_dimension\\\": 512,\\n\",\"    \\\"brightness_factors\\\": {\\n\",\"        \\\"low\\\": 0.5,\\n\",\"        \\\"original\\\": 1.0,\\n\",\"        \\\"high\\\": 1.5\\n\",\"    },\\n\",\"    \\\"paired_images\\\": int(len(common_positions)),\\n\",\"    \\\"evaluation_identities\\\": int(len(identity_summary)),\\n\",\"    \\\"low_detection_failures\\\": int(len(low_failures)),\\n\",\"    \\\"high_detection_failures\\\": int(len(high_failures)),\\n\",\"    \\\"image_level_wilcoxon_p\\\": float(p_value),\\n\",\"    \\\"identity_level_wilcoxon_p\\\": float(identity_p_value),\\n\",\"    \\\"mean_low_displacement\\\": float(np.mean(low_distances)),\\n\",\"    \\\"mean_high_displacement\\\": float(np.mean(high_distances))\\n\",\"}\\n\",\"\\n\",\"with open(\\n\",\"    os.path.join(output_dir, \\\"illumination_metadata.json\\\"),\\n\",\"    \\\"w\\\"\\n\",\") as file:\\n\",\"    json.dump(illumination_metadata, file, indent=4)\\n\",\"\\n\",\"print(\\\"ILLUMINATION RESULTS SAVED\\\")\\n\",\"\\n\",\"for filename in [\\n\",\"    \\\"experiment18_illumination_results.npz\\\",\\n\",\"    \\\"illumination_identity_summary.csv\\\",\\n\",\"    \\\"illumination_metadata.json\\\"\\n\",\"]:\\n\",\"    path = os.path.join(output_dir, filename)\\n\",\"    print(filename, \\\"| Exists:\\\", os.path.exists(path))\\n\",\"    print(\\\"Size:\\\", round(os.path.getsize(path) / 1024, 2), \\\"KB\\\")\\n\",\"\\n\",\"---------------------------------------------------------------------------\\n\",\"CELL 65 | TYPE: markdown\\n\",\"Matched terms: brightness\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 16 — Identity-Aware Embedding-Level Drift Detection\\n\",\"\\n\",\"### Objective\\n\",\"Develop and evaluate embedding-level drift detectors for identifying changes in genuine FaceNet representations under controlled illumination perturbations.\\n\",\"\\n\",\"### Research Questions\\n\",\"1. Can embedding-level detectors identify illumination-induced representation changes?\\n\",\"2. How does detector sensitivity differ between low and high illumination?\\n\",\"3. Can the detectors maintain controlled false alarm rates under baseline conditions?\\n\",\"4. How does covariance regularisation influence Mahalanobis-based detection?\\n\",\"\\n\",\"### Experimental Design\\n\",\"\\n\",\"**Reference population**\\n\",\"Original embeddings from the matched evaluation cohort.\\n\",\"\\n\",\"**Calibration population**\\n\",\"Baseline-versus-baseline comparisons constructed using separate image samples and identity-aware sampling.\\n\",\"\\n\",\"**Evaluation population**\\n\",\"Paired original and transformed embeddings under low- and high-illumination conditions.\\n\",\"\\n\",\"### Detection Methods\\n\",\"- Euclidean embedding displacement.\\n\",\"- Regularised Mahalanobis distance.\\n\",\"\\n\",\"### Proposed Configuration\\n\",\"- Embedding dimension: 512.\\n\",\"- Window size: 20.\\n\",\"- Random seed: 202618.\\n\",\"- Target false alarm rates: 0.01, 0.05 and 0.10.\\n\",\"- Illumination factors: 0.5, 1.0 and 1.5.\\n\",\"\\n\",\"### Evaluation Metrics\\n\",\"- Empirical false alarm rate.\\n\",\"- Detection rate.\\n\",\"- Detection sensitivity by illumination condition.\\n\",\"- Detection performance across identities.\\n\",\"- Numerical stability.\\n\",\"\\n\",\"### Scientific Limitations\\n\",\"The experiment uses controlled brightness transformations rather than naturally occurring temporal drift. Detector results will be conditional on the matched evaluation cohort and the chosen calibration protocol.\\n\",\"\\n\",\"### Status\\n\",\"Methodology defined; implementation pending.\\n\",\"\\n\",\"---------------------------------------------------------------------------\\n\",\"CELL 66 | TYPE: code\\n\",\"Matched terms: original_embeddings, paired_labels\\n\",\"---------------------------------------------------------------------------\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"\\n\",\"# Reproducibility\\n\",\"RANDOM_SEED = 202618\\n\",\"rng = np.random.default_rng(RANDOM_SEED)\\n\",\"\\n\",\"# Source data: 889 correctly paired images\\n\",\"X_original = paired_original_embeddings\\n\",\"X_low = paired_low_embeddings\\n\",\"X_high = paired_high_embeddings\\n\",\"y = paired_labels\\n\",\"\\n\",\"# Validate input dimensions\\n\",\"assert X_original.shape == X_low.shape == X_high.shape\\n\",\"assert len(X_original) == len(y)\\n\",\"\\n\",\"# Define partition proportions\\n\",\"REFERENCE_RATIO = 0.50\\n\",\"CALIBRATION_RATIO = 0.25\\n\",\"EVALUATION_RATIO = 0.25\\n\",\"\\n\",\"reference_positions = []\\n\",\"calibration_positions = []\\n\",\"evaluation_positions = []\\n\",\"\\n\",\"# Split images separately within each identity\\n\",\"for identity in np.unique(y):\\n\",\"\\n\",\"    identity_positions = np.where(y == identity)[0]\\n\",\"\\n\",\"    shuffled_positions = rng.permutation(identity_positions)\\n\",\"\\n\",\"    n = len(shuffled_positions)\\n\",\"\\n\",\"    reference_count = int(n * REFERENCE_RATIO)\\n\",\"    calibration_count = int(n * CALIBRATION_RATIO)\\n\",\"\\n\",\"    reference_positions.extend(\\n\",\"        shuffled_positions[:reference_count]\\n\",\"    )\\n\",\"\\n\",\"    calibration_positions.extend(\\n\",\"        shuffled_positions[\\n\",\"            reference_count:\\n\",\"            reference_count + calibration_count\\n\",\"        ]\\n\",\"    )\\n\",\"\\n\",\"    evaluation_positions.extend(\\n\",\"        shuffled_positions[\\n\",\"            reference_count + calibration_count:\\n\",\"        ]\\n\",\"    )\\n\",\"\\n\",\"# Convert to arrays\\n\",\"reference_positions = np.sort(\\n\",\"    np.asarray(reference_positions)\\n\",\")\\n\",\"\\n\",\"calibration_positions = np.sort(\\n\",\"    np.asarray(calibration_positions)\\n\",\")\\n\",\"\\n\",\"evaluation_positions = np.sort(\\n\",\"    np.asarray(evaluation_positions)\\n\",\")\\n\",\"\\n\",\"# Construct original embedding partitions\\n\",\"reference_baseline = X_original[reference_positions]\\n\",\"\\n\",\"calibration_baseline = X_original[calibration_positions]\\n\",\"\\n\",\"evaluation_baseline = X_original[evaluation_positions]\\n\",\"\\n\",\"# Construct corresponding transformed evaluation partitions\\n\",\"evaluation_low = X_low[evaluation_positions]\\n\",\"\\n\",\"evaluation_high = X_high[evaluation_positions]\\n\",\"\\n\",\"# Identity labels\\n\",\"reference_labels = y[reference_positions]\\n\",\"\\n\",\"calibration_labels = y[calibration_positions]\\n\",\"\\n\",\"evaluation_labels = y[evaluation_positions]\\n\",\"\\n\",\"# Validate image-level separation\\n\",\"assert len(set(reference_positions) & set(calibration_positions)) == 0\\n\",\"assert len(set(reference_positions) & set(evaluation_positions)) == 0\\n\",\"assert len(set(calibration_positions) & set(evaluation_positions)) == 0\\n\",\"\\n\",\"# Validate complete partition coverage\\n\",\"all_positions = np.concatenate([\\n\",\"    reference_positions,\\n\",\"    calibration_positions,\\n\",\"    evaluation_positions\\n\",\"])\\n\",\"\\n\",\"assert len(all_positions) == len(X_original)\\n\",\"assert len(np.unique(all_positions)) == len(X_original)\\n\",\"\\n\",\"# Display partition summary\\n\",\"partition_summary = pd.DataFrame({\\n\",\"    \\\"Partition\\\": [\\n\",\"        \\\"Reference\\\",\\n\",\"        \\\"Calibration\\\",\\n\",\"        \\\"Evaluation\\\"\\n\",\"    ],\\n\",\"    \\\"Images\\\": [\\n\",\"        len(reference_positions),\\n\",\"        len(calibration_positions),\\n\",\"        len(evaluation_positions)\\n\",\"    ],\\n\",\"    \\\"Identities\\\": [\\n\",\"        len(np.unique(reference_labels)),\\n\",\"        len(np.unique(calibration_labels)),\\n\",\"        len(np.unique(evaluation_labels))\\n\",\"    ]\\n\",\"})\\n\",\"\\n\",\"print(\\\"IDENTITY-AWARE DATA PARTITIONING\\\")\\n\",\"print(\\\"-\\\" * 55)\\n\",\"\\n\",\"display(partition_summary)\\n\",\"\\n\",\"print(\\\"\\\\nEMBEDDING SHAPES\\\")\\n\",\"\\n\",\"print(\\\"Reference:\\\", reference_baseline.shape)\\n\",\"print(\\\"Calibration:\\\", calibration_baseline.shape)\\n\",\"print(\\\"Evaluation baseline:\\\", evaluation_baseline.shape)\\n\",\"print(\\\"Evaluation low:\\\", evaluation_low.shape)\\n\",\"print(\\\"Evaluation high:\\\", evaluation_high.shape)\\n\",\"\\n\",\"print(\\\"\\\\nVALIDATION\\\")\\n\",\"\\n\",\"print(\\\"Reference-calibration overlap:\\\",\\n\",\"      len(set(reference_positions) & set(calibration_positions)))\\n\",\"\\n\",\"print(\\\"Reference-evaluation overlap:\\\",\\n\",\"      len(set(reference_positions) & set(evaluation_positions)))\\n\",\"\\n\",\"print(\\\"Calibration-evaluation overlap:\\\",\\n\",\"      len(set(calibration_positions) & set(evaluation_positions)))\\n\",\"\\n\",\"print(\\\"All identities represented in each partition:\\\",\\n\",\"      all(\\n\",\"          len(np.unique(labels)) == len(np.unique(y))\\n\",\"          for labels in [\\n\",\"              reference_labels,\\n\",\"              calibration_labels,\\n\",\"              evaluation_labels\\n\",\"          ]\\n\",\"      ))\\n\",\"\\n\",\"print(\\\"All embeddings finite:\\\",\\n\",\"      all(\\n\",\"          np.all(np.isfinite(x))\\n\",\"          for x in [\\n\",\"              reference_baseline,\\n\",\"              calibration_baseline,\\n\",\"              evaluation_baseline,\\n\",\"              evaluation_low,\\n\",\"              evaluation_high\\n\",\"          ]\\n\",\"      ))\\n\",\"\\n\",\"---------------------------------------------------------------------------\\n\",\"CELL 91 | TYPE: markdown\\n\",\"Matched terms: brightness\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 17.1 — Controlled Illumination Detector Scoring\\n\",\"\\n\",\"### Objective\\n\",\"Evaluate the response of the frozen embedding-level detectors under original, low-illumination, and high-illumination conditions.\\n\",\"\\n\",\"### Methodology\\n\",\"1. Calculate identity-balanced window means for each illumination condition.\\n\",\"2. Calculate Euclidean distances from the frozen reference mean.\\n\",\"3. Calculate Mahalanobis distances using the frozen identity-balanced covariance.\\n\",\"4. Compare detector scores across the three conditions.\\n\",\"\\n\",\"### Evaluation Conditions\\n\",\"- Original illumination\\n\",\"- Low illumination (brightness factor 0.5)\\n\",\"- High illumination (brightness factor 1.5)\\n\",\"\\n\",\"### Research Purpose\\n\",\"Determine whether controlled illumination changes produce measurable shifts in the embedding-level detector scores.\\n\",\"\\n\",\"### Scientific Limitation\\n\",\"The evaluation contains 13 identities and 229 images. Results represent controlled synthetic illumination changes, not real-world environmental drift or biometric recognition accuracy.\\n\",\"\\n\",\"### Status\\n\",\"Successfully completed. The frozen Euclidean and Mahalanobis detectors were evaluated under original, low-illumination and high-illumination conditions using the identity-balanced reference statistics.\\n\",\"\\n\",\"The original condition produced a mean Euclidean score of 0.053114 and a mean Mahalanobis score of 0.797920.\\n\",\"\\n\",\"The low-illumination condition (brightness factor 0.5) produced a mean Euclidean score of 0.094771 and a mean Mahalanobis score of 1.735851.\\n\",\"\\n\",\"The high-illumination condition (brightness factor 1.5) produced a mean Euclidean score of 0.082996 and a mean Mahalanobis score of 1.871540.\\n\",\"\\n\",\"Numerical validation confirmed that all detector scores were finite.\\n\",\"\\n\",\"These results show measurable changes in embedding-level detector scores under the controlled illumination conditions. They do not establish real-world biometric recognition accuracy, environmental robustness or deployment readiness. The evaluation is limited to 13 identities and 229 images.\\n\",\"\\n\",\"---------------------------------------------------------------------------\\n\",\"CELL 99 | TYPE: code\\n\",\"Matched terms: original_embeddings, paired_labels\\n\",\"---------------------------------------------------------------------------\\n\",\"print(\\\"PAIRED DATASET DIMENSIONS\\\")\\n\",\"print(\\\"Original:\\\", paired_original_embeddings.shape)\\n\",\"print(\\\"Low illumination:\\\", paired_low_embeddings.shape)\\n\",\"print(\\\"High illumination:\\\", paired_high_embeddings.shape)\\n\",\"print(\\\"Paired labels:\\\", paired_labels.shape)\\n\",\"\\n\",\"print(\\\"\\\\nIDENTITY DISTRIBUTION\\\")\\n\",\"print(pd.Series(paired_labels).value_counts().sort_index())\\n\",\"\\n\",\"print(\\\"\\\\nEVALUATION BASELINE\\\")\\n\",\"print(\\\"Evaluation baseline:\\\", evaluation_baseline.shape)\\n\",\"print(\\\"Evaluation labels:\\\", evaluation_labels.shape)\\n\",\"\\n\",\"---------------------------------------------------------------------------\\n\",\"CELL 101 | TYPE: code\\n\",\"Matched terms: paired_labels\\n\",\"---------------------------------------------------------------------------\\n\",\"print(\\\"FULL PAIRED COHORT\\\")\\n\",\"print(\\\"Unique identities:\\\", np.unique(paired_labels))\\n\",\"print(\\\"Identity counts:\\\")\\n\",\"print(pd.Series(paired_labels).value_counts().sort_index())\\n\",\"\\n\",\"print(\\\"\\\\nEVALUATION COHORT\\\")\\n\",\"print(\\\"Unique identities:\\\", np.unique(evaluation_labels))\\n\",\"print(\\\"Identity counts:\\\")\\n\",\"print(pd.Series(evaluation_labels).value_counts().sort_index())\\n\",\"\\n\",\"print(\\\"\\\\nCOHORT VALIDATION\\\")\\n\",\"print(\\\"Full paired samples:\\\", len(paired_labels))\\n\",\"print(\\\"Evaluation samples:\\\", len(evaluation_labels))\\n\",\"print(\\\"Evaluation identities:\\\", len(np.unique(evaluation_labels)))\\n\",\"print(\\\"Same identity sets:\\\",\\n\",\"      set(np.unique(paired_labels)) == set(np.unique(evaluation_labels)))\\n\",\"\\n\",\"---------------------------------------------------------------------------\\n\",\"CELL 111 | TYPE: code\\n\",\"Matched terms: brightness\\n\",\"---------------------------------------------------------------------------\\n\",\"\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"from IPython.display import display\\n\",\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 18 — STEP 17.9\\n\",\"# RESEARCH FINDINGS AND SCIENTIFIC INTERPRETATION\\n\",\"# ============================================================\\n\",\"\\n\",\"print(\\\"EXPERIMENT 18 — STEP 17.9\\\")\\n\",\"print(\\\"Research Findings and Scientific Interpretation\\\")\\n\",\"print(\\\"=\\\" * 70)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Validate existing experimental results\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"required_objects = [\\n\",\"    \\\"evaluation_detector_df\\\",\\n\",\"    \\\"paired_summary\\\",\\n\",\"    \\\"statistical_results\\\",\\n\",\"    \\\"effect_size_df\\\",\\n\",\"    \\\"identity_detector_df\\\"\\n\",\"]\\n\",\"\\n\",\"missing_objects = [\\n\",\"    name for name in required_objects\\n\",\"    if name not in globals()\\n\",\"]\\n\",\"\\n\",\"if missing_objects:\\n\",\"    raise NameError(\\n\",\"        f\\\"Missing previously generated results: {missing_objects}\\\"\\n\",\"    )\\n\",\"\\n\",\"assert len(identity_detector_df[\\\"Identity\\\"].unique()) == 13\\n\",\"assert len(evaluation_detector_df) == 3\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Aggregate detector response\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"aggregate = evaluation_detector_df.set_index(\\\"Condition\\\")\\n\",\"\\n\",\"original = aggregate.loc[\\\"Original\\\"]\\n\",\"low = aggregate.loc[\\\"Low illumination\\\"]\\n\",\"high = aggregate.loc[\\\"High illumination\\\"]\\n\",\"\\n\",\"aggregate_findings = pd.DataFrame({\\n\",\"    \\\"Detector\\\": [\\\"Euclidean\\\", \\\"Mahalanobis\\\"],\\n\",\"\\n\",\"    \\\"Original\\\": [\\n\",\"        original[\\\"Euclidean\\\"],\\n\",\"        original[\\\"Mahalanobis\\\"]\\n\",\"    ],\\n\",\"\\n\",\"    \\\"Low Illumination\\\": [\\n\",\"        low[\\\"Euclidean\\\"],\\n\",\"        low[\\\"Mahalanobis\\\"]\\n\",\"    ],\\n\",\"\\n\",\"    \\\"High Illumination\\\": [\\n\",\"        high[\\\"Euclidean\\\"],\\n\",\"        high[\\\"Mahalanobis\\\"]\\n\",\"    ],\\n\",\"\\n\",\"    \\\"Low Change (%)\\\": [\\n\",\"        (low[\\\"Euclidean\\\"] - original[\\\"Euclidean\\\"])\\n\",\"        / original[\\\"Euclidean\\\"] * 100,\\n\",\"\\n\",\"        (low[\\\"Mahalanobis\\\"] - original[\\\"Mahalanobis\\\"])\\n\",\"        / original[\\\"Mahalanobis\\\"] * 100\\n\",\"    ],\\n\",\"\\n\",\"    \\\"High Change (%)\\\": [\\n\",\"        (high[\\\"Euclidean\\\"] - original[\\\"Euclidean\\\"])\\n\",\"        / original[\\\"Euclidean\\\"] * 100,\\n\",\"\\n\",\"        (high[\\\"Mahalanobis\\\"] - original[\\\"Mahalanobis\\\"])\\n\",\"        / original[\\\"Mahalanobis\\\"] * 100\\n\",\"    ]\\n\",\"})\\n\",\"\\n\",\"print(\\\"\\\\n1. AGGREGATE DETECTOR RESPONSE\\\")\\n\",\"display(aggregate_findings.round(6))\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Identity-level response direction\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"identity_data = identity_detector_df.copy()\\n\",\"\\n\",\"identity_data[\\\"Condition\\\"] = (\\n\",\"    identity_data[\\\"Condition\\\"]\\n\",\"    .astype(str)\\n\",\"    .str.strip()\\n\",\"    .str.lower()\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\nAvailable identity-level conditions:\\\")\\n\",\"print(identity_data[\\\"Condition\\\"].unique())\\n\",\"\\n\",\"low_data = identity_data[\\n\",\"    identity_data[\\\"Condition\\\"].str.contains(\\\"low\\\")\\n\",\"].set_index(\\\"Identity\\\")\\n\",\"\\n\",\"high_data = identity_data[\\n\",\"    identity_data[\\\"Condition\\\"].str.contains(\\\"high\\\")\\n\",\"].set_index(\\\"Identity\\\")\\n\",\"\\n\",\"common_identities = low_data.index.intersection(\\n\",\"    high_data.index\\n\",\")\\n\",\"\\n\",\"if len(common_identities) != 13:\\n\",\"    raise ValueError(\\n\",\"        f\\\"Expected 13 paired identities, found {len(common_identities)}.\\\"\\n\",\"    )\\n\",\"\\n\",\"low_data = low_data.loc[common_identities]\\n\",\"high_data = high_data.loc[common_identities]\\n\",\"\\n\",\"euclidean_differences = (\\n\",\"    high_data[\\\"Euclidean\\\"] - low_data[\\\"Euclidean\\\"]\\n\",\")\\n\",\"\\n\",\"mahalanobis_differences = (\\n\",\"    high_data[\\\"Mahalanobis\\\"] - low_data[\\\"Mahalanobis\\\"]\\n\",\")\\n\",\"\\n\",\"identity_direction = pd.DataFrame({\\n\",\"    \\\"Detector\\\": [\\\"Euclidean\\\", \\\"Mahalanobis\\\"],\\n\",\"\\n\",\"    \\\"Higher Under High Illumination\\\": [\\n\",\"        int((euclidean_differences > 0).sum()),\\n\",\"        int((mahalanobis_differences > 0).sum())\\n\",\"    ],\\n\",\"\\n\",\"    \\\"Higher Under Low Illumination\\\": [\\n\",\"        int((euclidean_differences < 0).sum()),\\n\",\"        int((mahalanobis_differences < 0).sum())\\n\",\"    ],\\n\",\"\\n\",\"    \\\"Equal\\\": [\\n\",\"        int((euclidean_differences == 0).sum()),\\n\",\"        int((mahalanobis_differences == 0).sum())\\n\",\"    ]\\n\",\"})\\n\",\"\\n\",\"print(\\\"\\\\n2. IDENTITY-LEVEL RESPONSE DIRECTION\\\")\\n\",\"display(identity_direction)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Paired statistical test results\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n3. PAIRED STATISTICAL TEST RESULTS\\\")\\n\",\"display(statistical_results.round(6))\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Effect size and uncertainty\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n4. EFFECT SIZE AND UNCERTAINTY\\\")\\n\",\"display(effect_size_df.round(6))\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. Scientific interpretation\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n5. SCIENTIFIC INTERPRETATION\\\")\\n\",\"\\n\",\"print(\\n\",\"    f\\\"\\\\nEuclidean detector:\\\"\\n\",\"    f\\\"\\\\n  Original score: {original['Euclidean']:.6f}\\\"\\n\",\"    f\\\"\\\\n  Low illumination: {low['Euclidean']:.6f}\\\"\\n\",\"    f\\\"\\\\n  High illumination: {high['Euclidean']:.6f}\\\"\\n\",\"    f\\\"\\\\n  Low illumination increase: \\\"\\n\",\"    f\\\"{aggregate_findings.loc[0, 'Low Change (%)']:.2f}%\\\"\\n\",\"    f\\\"\\\\n  High illumination increase: \\\"\\n\",\"    f\\\"{aggregate_findings.loc[0, 'High Change (%)']:.2f}%\\\"\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    f\\\"\\\\nMahalanobis detector:\\\"\\n\",\"    f\\\"\\\\n  Original score: {original['Mahalanobis']:.6f}\\\"\\n\",\"    f\\\"\\\\n  Low illumination: {low['Mahalanobis']:.6f}\\\"\\n\",\"    f\\\"\\\\n  High illumination: {high['Mahalanobis']:.6f}\\\"\\n\",\"    f\\\"\\\\n  Low illumination increase: \\\"\\n\",\"    f\\\"{aggregate_findings.loc[1, 'Low Change (%)']:.2f}%\\\"\\n\",\"    f\\\"\\\\n  High illumination increase: \\\"\\n\",\"    f\\\"{aggregate_findings.loc[1, 'High Change (%)']:.2f}%\\\"\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"\\\\nIdentity-level comparison:\\\"\\n\",\"    f\\\"\\\\n  Euclidean: high illumination produced greater \\\"\\n\",\"    f\\\"displacement in {(euclidean_differences > 0).sum()} \\\"\\n\",\"    f\\\"of {len(euclidean_differences)} identities.\\\"\\n\",\"    f\\\"\\\\n  Mahalanobis: high illumination produced greater \\\"\\n\",\"    f\\\"displacement in {(mahalanobis_differences > 0).sum()} \\\"\\n\",\"    f\\\"of {len(mahalanobis_differences)} identities.\\\"\\n\",\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. Corrected statistical interpretation\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n6. STATISTICAL INTERPRETATION\\\")\\n\",\"\\n\",\"tests = statistical_results.set_index(\\\"Detector\\\")\\n\",\"\\n\",\"euclidean_p = float(\\n\",\"    tests.loc[\\\"Euclidean\\\", \\\"P-value\\\"]\\n\",\")\\n\",\"\\n\",\"mahalanobis_p = float(\\n\",\"    tests.loc[\\\"Mahalanobis\\\", \\\"P-value\\\"]\\n\",\")\\n\",\"\\n\",\"alpha = 0.05\\n\",\"\\n\",\"print(f\\\"Euclidean Wilcoxon p-value: {euclidean_p:.6f}\\\")\\n\",\"print(f\\\"Mahalanobis Wilcoxon p-value: {mahalanobis_p:.6f}\\\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"Euclidean result:\\\",\\n\",\"    \\\"Statistically significant at 5%.\\\"\\n\",\"    if euclidean_p < alpha\\n\",\"    else \\\"Not statistically significant at 5%.\\\"\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"Mahalanobis result:\\\",\\n\",\"    \\\"Statistically significant at 5%.\\\"\\n\",\"    if mahalanobis_p < alpha\\n\",\"    else \\\"Not statistically significant at 5%.\\\"\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"\\\\nBoth tests are exploratory and based on only \\\"\\n\",\"    \\\"13 paired identity-level observations.\\\"\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"No multiple-comparison correction has been applied.\\\"\\n\",\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 8. Comparative research findings\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n7. COMPARATIVE RESEARCH FINDINGS\\\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"The Euclidean detector recorded its largest aggregate \\\"\\n\",\"    \\\"response under low illumination.\\\"\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"The Mahalanobis detector recorded its largest aggregate \\\"\\n\",\"    \\\"response under high illumination.\\\"\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"The identity-level results demonstrate that detector \\\"\\n\",\"    \\\"responses vary across identities.\\\"\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"The larger estimated Mahalanobis effect size does not \\\"\\n\",\"    \\\"establish general detector superiority.\\\"\\n\",\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 9. Scientific limitations\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n8. SCIENTIFIC LIMITATIONS\\\")\\n\",\"\\n\",\"limitations = [\\n\",\"    \\\"The evaluation includes only 13 identities.\\\",\\n\",\"    \\\"Identity-level sample counts are unequal.\\\",\\n\",\"    \\\"The aggregate comparison covers three illumination conditions.\\\",\\n\",\"    \\\"Both Wilcoxon tests are exploratory and based on 13 paired identities.\\\",\\n\",\"    \\\"No multiple-comparison correction has been applied.\\\",\\n\",\"    \\\"Bootstrap estimates are exploratory.\\\",\\n\",\"    \\\"Controlled brightness transformations do not represent all natural lighting conditions.\\\",\\n\",\"    \\\"Embedding displacement does not directly measure recognition accuracy.\\\",\\n\",\"    \\\"The experiment does not establish demographic fairness.\\\",\\n\",\"    \\\"The experiment does not establish operational drift-detection accuracy or false-alarm control.\\\"\\n\",\"]\\n\",\"\\n\",\"for number, limitation in enumerate(limitations, start=1):\\n\",\"    print(f\\\"{number}. {limitation}\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 10. Final numerical and consistency validation\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"numeric_values = aggregate_findings.select_dtypes(\\n\",\"    include=[np.number]\\n\",\").to_numpy()\\n\",\"\\n\",\"assert np.isfinite(numeric_values).all()\\n\",\"\\n\",\"assert len(common_identities) == 13\\n\",\"assert len(aggregate_findings) == 2\\n\",\"assert len(identity_direction) == 2\\n\",\"\\n\",\"assert np.isfinite(euclidean_differences).all()\\n\",\"assert np.isfinite(mahalanobis_differences).all()\\n\",\"\\n\",\"assert np.isclose(\\n\",\"    euclidean_differences.mean(),\\n\",\"    0.030051,\\n\",\"    atol=1e-5\\n\",\")\\n\",\"\\n\",\"assert np.isclose(\\n\",\"    mahalanobis_differences.mean(),\\n\",\"    0.722682,\\n\",\"    atol=1e-5\\n\",\")\\n\",\"\\n\",\"assert np.isclose(euclidean_p, 0.021484, atol=1e-5)\\n\",\"assert np.isclose(mahalanobis_p, 0.002441, atol=1e-5)\\n\",\"\\n\",\"assert int((euclidean_differences > 0).sum()) == 10\\n\",\"assert int((mahalanobis_differences > 0).sum()) == 11\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 70)\\n\",\"print(\\\"STEP 17.9 COMPLETED SUCCESSFULLY\\\")\\n\",\"print(\\\"Aggregate findings validated.\\\")\\n\",\"print(\\\"Identity-level comparisons validated.\\\")\\n\",\"print(\\\"Corrected statistical results verified.\\\")\\n\",\"print(\\\"Effect sizes and uncertainty reviewed.\\\")\\n\",\"print(\\\"Scientific limitations documented.\\\")\\n\",\"print(\\\"Previously generated experimental results reused.\\\")\\n\",\"print(\\\"=\\\" * 70)\\n\",\"\\n\",\"\\n\",\"---------------------------------------------------------------------------\\n\",\"CELL 113 | TYPE: code\\n\",\"Matched terms: original_embeddings, paired_labels\\n\",\"---------------------------------------------------------------------------\\n\",\"\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 18 — STEP 17.10.1\\n\",\"# DATA INTEGRITY AUDIT\\n\",\"# ============================================================\\n\",\"\\n\",\"print(\\\"EXPERIMENT 18 — STEP 17.10.1\\\")\\n\",\"print(\\\"DATA INTEGRITY AUDIT\\\")\\n\",\"print(\\\"=\\\" * 65)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Validate embedding arrays\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"embedding_arrays = {\\n\",\"    \\\"Original\\\": paired_original_embeddings,\\n\",\"    \\\"Low illumination\\\": paired_low_embeddings,\\n\",\"    \\\"High illumination\\\": paired_high_embeddings\\n\",\"}\\n\",\"\\n\",\"print(\\\"\\\\n1. EMBEDDING ARRAY VALIDATION\\\")\\n\",\"\\n\",\"sample_counts = []\\n\",\"\\n\",\"for name, array in embedding_arrays.items():\\n\",\"\\n\",\"    array = np.asarray(array)\\n\",\"\\n\",\"    print(f\\\"\\\\n{name}\\\")\\n\",\"    print(\\\"Shape:\\\", array.shape)\\n\",\"    print(\\\"Embedding dimension:\\\", array.shape[1])\\n\",\"    print(\\\"All values finite:\\\", np.isfinite(array).all())\\n\",\"\\n\",\"    assert array.ndim == 2, f\\\"{name}: Expected a 2D array.\\\"\\n\",\"    assert array.shape[1] == 512, f\\\"{name}: Unexpected embedding dimension.\\\"\\n\",\"    assert np.isfinite(array).all(), f\\\"{name}: Non-finite values detected.\\\"\\n\",\"\\n\",\"    sample_counts.append(array.shape[0])\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Validate paired sample consistency\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n2. PAIRED SAMPLE VALIDATION\\\")\\n\",\"\\n\",\"labels = np.asarray(paired_labels)\\n\",\"\\n\",\"print(\\\"Original samples:\\\", sample_counts[0])\\n\",\"print(\\\"Low illumination samples:\\\", sample_counts[1])\\n\",\"print(\\\"High illumination samples:\\\", sample_counts[2])\\n\",\"print(\\\"Label count:\\\", len(labels))\\n\",\"\\n\",\"assert len(set(sample_counts)) == 1, (\\n\",\"    \\\"Embedding arrays have inconsistent sample counts.\\\"\\n\",\")\\n\",\"\\n\",\"assert len(labels) == sample_counts[0], (\\n\",\"    \\\"Label count does not match embedding sample count.\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"Paired sample counts consistent: True\\\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Validate identity coverage\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n3. IDENTITY COVERAGE VALIDATION\\\")\\n\",\"\\n\",\"unique_identities = np.unique(labels)\\n\",\"\\n\",\"print(\\\"Number of identities:\\\", len(unique_identities))\\n\",\"print(\\\"Identity labels:\\\", unique_identities)\\n\",\"\\n\",\"assert len(unique_identities) == 13, (\\n\",\"    f\\\"Expected 13 identities, found {len(unique_identities)}.\\\"\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Validate covariance matrix\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n4. COVARIANCE MATRIX VALIDATION\\\")\\n\",\"\\n\",\"covariance = np.asarray(\\n\",\"    identity_balanced_regularised_covariance\\n\",\")\\n\",\"\\n\",\"print(\\\"Covariance shape:\\\", covariance.shape)\\n\",\"print(\\\"All values finite:\\\", np.isfinite(covariance).all())\\n\",\"\\n\",\"assert covariance.shape == (512, 512), (\\n\",\"    \\\"Unexpected covariance matrix dimensions.\\\"\\n\",\")\\n\",\"\\n\",\"assert np.isfinite(covariance).all(), (\\n\",\"    \\\"Covariance matrix contains non-finite values.\\\"\\n\",\")\\n\",\"\\n\",\"is_symmetric = np.allclose(\\n\",\"    covariance,\\n\",\"    covariance.T,\\n\",\"    atol=1e-8\\n\",\")\\n\",\"\\n\",\"print(\\\"Symmetric:\\\", is_symmetric)\\n\",\"\\n\",\"assert is_symmetric, \\\"Covariance matrix is not symmetric.\\\"\\n\",\"\\n\",\"eigenvalues = np.linalg.eigvalsh(covariance)\\n\",\"\\n\",\"minimum_eigenvalue = eigenvalues.min()\\n\",\"maximum_eigenvalue = eigenvalues.max()\\n\",\"\\n\",\"print(\\\"Minimum eigenvalue:\\\", minimum_eigenvalue)\\n\",\"print(\\\"Maximum eigenvalue:\\\", maximum_eigenvalue)\\n\",\"\\n\",\"is_positive_definite = np.all(eigenvalues > 0)\\n\",\"\\n\",\"print(\\\"Positive definite:\\\", is_positive_definite)\\n\",\"\\n\",\"assert is_positive_definite, (\\n\",\"    \\\"Covariance matrix is not positive definite.\\\"\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Validate existing analysis tables\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n5. ANALYSIS TABLE VALIDATION\\\")\\n\",\"\\n\",\"analysis_tables = {\\n\",\"    \\\"Aggregate detector results\\\": evaluation_detector_df,\\n\",\"    \\\"Identity-level detector results\\\": identity_detector_df,\\n\",\"    \\\"Paired statistical results\\\": statistical_results,\\n\",\"    \\\"Effect size results\\\": effect_size_df\\n\",\"}\\n\",\"\\n\",\"for name, dataframe in analysis_tables.items():\\n\",\"\\n\",\"    print(\\n\",\"        f\\\"{name}: \\\"\\n\",\"        f\\\"{dataframe.shape[0]} rows, \\\"\\n\",\"        f\\\"{dataframe.shape[1]} columns\\\"\\n\",\"    )\\n\",\"\\n\",\"    assert isinstance(dataframe, pd.DataFrame)\\n\",\"    assert not dataframe.empty\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. Final audit summary\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n6. DATA INTEGRITY AUDIT SUMMARY\\\")\\n\",\"\\n\",\"audit_results = pd.DataFrame({\\n\",\"    \\\"Validation\\\": [\\n\",\"        \\\"Embedding dimensions\\\",\\n\",\"        \\\"Finite embedding values\\\",\\n\",\"        \\\"Paired sample consistency\\\",\\n\",\"        \\\"Identity coverage\\\",\\n\",\"        \\\"Covariance dimensions\\\",\\n\",\"        \\\"Covariance symmetry\\\",\\n\",\"        \\\"Covariance positive definiteness\\\",\\n\",\"        \\\"Analysis tables available\\\"\\n\",\"    ],\\n\",\"    \\\"Status\\\": [\\n\",\"        \\\"PASSED\\\",\\n\",\"        \\\"PASSED\\\",\\n\",\"        \\\"PASSED\\\",\\n\",\"        \\\"PASSED\\\",\\n\",\"        \\\"PASSED\\\",\\n\",\"        \\\"PASSED\\\",\\n\",\"        \\\"PASSED\\\",\\n\",\"        \\\"PASSED\\\"\\n\",\"    ]\\n\",\"})\\n\",\"\\n\",\"display(audit_results)\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 65)\\n\",\"print(\\\"STEP 17.10.1 DATA INTEGRITY AUDIT COMPLETED\\\")\\n\",\"print(\\\"All validation checks passed.\\\")\\n\",\"print(\\\"=\\\" * 65)\\n\",\"\\n\",\"\\n\",\"---------------------------------------------------------------------------\\n\",\"CELL 116 | TYPE: markdown\\n\",\"Matched terms: brightness\\n\",\"---------------------------------------------------------------------------\\n\",\"### Step 17.10.3 — Experimental Configuration and Reproducibility\\n\",\"\\n\",\"**Objective**\\n\",\"\\n\",\"Document and verify the experimental configuration used in Experiment 18, including the dataset, pretrained embedding model, embedding dimensions, illumination transformation settings, dataset characteristics, random seed variables and software environment.\\n\",\"\\n\",\"The purpose is to establish a reproducibility record without rerunning the experiment or modifying previously generated results.\\n\",\"\\n\",\"**1. Dataset and Experimental Configuration**\\n\",\"\\n\",\"The experiment used a filtered subset of the Labeled Faces in the Wild (LFW) dataset with the InceptionResnetV1 model pretrained on VGGFace2.\\n\",\"\\n\",\"The embedding dimension was 512.\\n\",\"\\n\",\"The full paired illumination dataset contained 889 images across 13 identities. A separate corrected identity-level evaluation cohort contained 229 images across the same 13 identities.\\n\",\"\\n\",\"The controlled brightness transformation factors were:\\n\",\"\\n\",\"- Low illumination: 0.5\\n\",\"- Original illumination: 1.0\\n\",\"- High illumination: 1.5\\n\",\"\\n\",\"**2. Embedding and Cohort Validation**\\n\",\"\\n\",\"The audit verified that the original, low-illumination and high-illumination embedding arrays each contained 889 samples with 512 dimensions.\\n\",\"\\n\",\"All embedding values were finite.\\n\",\"\\n\",\"The corrected identity-level evaluation arrays were independently verified to contain 229 samples each, with 512 dimensions and 13 identities.\\n\",\"\\n\",\"Both dataset configurations passed their respective validation checks.\\n\",\"\\n\",\"**3. Model and Random Seed Inspection**\\n\",\"\\n\",\"The existing model object was identified as `InceptionResnetV1` from the `facenet_pytorch` package.\\n\",\"\\n\",\"The following random seed variables were found in the current session:\\n\",\"\\n\",\"- `RANDOM_SEED`: 202618\\n\",\"- `BOOTSTRAP_SEED`: 202617\\n\",\"\\n\",\"These values document the available seed configuration. Their presence does not independently establish that every original experimental operation used the corresponding seed.\\n\",\"\\n\",\"**4. Software Environment**\\n\",\"\\n\",\"The execution environment was recorded as follows:\\n\",\"\\n\",\"- Python: 3.13.18\\n\",\"- NumPy: 2.4.6\\n\",\"- Pandas: 2.2.3\\n\",\"- PyTorch: 2.14.1+cpu\\n\",\"- Torchvision: 0.29.1+cpu\\n\",\"- facenet-pytorch: 2.6.0\\n\",\"- SciPy: 1.16.3\\n\",\"- Matplotlib: 3.10.0\\n\",\"- Scikit-learn: 1.6.1\\n\",\"- Pillow: 11.3.0\\n\",\"\\n\",\"The runtime platform was Linux.\\n\",\"\\n\",\"**5. Saved Metadata Inspection**\\n\",\"\\n\",\"The saved experiment metadata files were inspected without modification.\\n\",\"\\n\",\"The archived `experiment18_final_research_evidence.json` contains historical detector-response and statistical records from an earlier analysis. These include identity-level detector results based on the full 889-image paired cohort and previously recorded Wilcoxon results.\\n\",\"\\n\",\"Those historical detector statistics and effect sizes are superseded by the corrected identity-level analysis documented in Steps 17.4–17.10.2.\\n\",\"\\n\",\"The corrected detector-level statistical findings are:\\n\",\"\\n\",\"- Euclidean Wilcoxon p-value: 0.021484.\\n\",\"- Mahalanobis Wilcoxon p-value: 0.002441.\\n\",\"\\n\",\"The historical JSON records have been preserved and are not treated as the current corrected statistical results.\\n\",\"\\n\",\"**6. Scientific and Reproducibility Limitations**\\n\",\"\\n\",\"This audit verifies the currently available arrays, model object, configuration variables, software environment and saved metadata.\\n\",\"\\n\",\"It does not independently reproduce the original image detection, preprocessing, embedding extraction, detector calibration or complete experimental pipeline.\\n\",\"\\n\",\"The evaluation remains limited to 13 identities, with an imbalanced identity distribution. The 229-image corrected evaluation cohort should not be confused with the full 889-image paired illumination dataset.\\n\",\"\\n\",\"The controlled brightness transformations do not establish performance under all real-world illumination conditions.\\n\",\"\\n\",\"**Status: Successfully Completed**\\n\",\"\\n\",\"The experimental configuration and available reproducibility information were inspected and documented.\\n\",\"\\n\",\"The full paired dataset of 889 images and the corrected identity-level evaluation cohort of 229 images were independently verified. The model object, random seed variables, software environment and saved metadata were inspected.\\n\",\"\\n\",\"Historical detector statistics were distinguished from the corrected results. No model training, embedding extraction, detector recalculation, statistical testing or bootstrap simulation was performed. No saved experimental files were modified.\\n\",\"\\n\",\"---------------------------------------------------------------------------\\n\",\"CELL 117 | TYPE: code\\n\",\"Matched terms: original_embeddings, paired_labels, brightness\\n\",\"---------------------------------------------------------------------------\\n\",\"\\n\",\"import os\\n\",\"import sys\\n\",\"import json\\n\",\"import platform\\n\",\"import importlib.metadata as pkg_metadata\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"from pathlib import Path\\n\",\"from IPython.display import display\\n\",\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 18 — STEP 17.10.3\\n\",\"# EXPERIMENTAL CONFIGURATION AND REPRODUCIBILITY AUDIT\\n\",\"# ============================================================\\n\",\"\\n\",\"print(\\\"EXPERIMENT 18 — STEP 17.10.3\\\")\\n\",\"print(\\\"EXPERIMENTAL CONFIGURATION AND REPRODUCIBILITY AUDIT\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Dataset and embedding configuration\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n1. DATASET AND EMBEDDING CONFIGURATION\\\")\\n\",\"\\n\",\"configuration = {\\n\",\"    \\\"Dataset\\\": \\\"Labeled Faces in the Wild (LFW)\\\",\\n\",\"    \\\"Pretrained Model\\\": \\\"InceptionResnetV1\\\",\\n\",\"    \\\"Pretrained Weights\\\": \\\"VGGFace2\\\",\\n\",\"    \\\"Embedding Dimension\\\": 512,\\n\",\"    \\\"Evaluation Identities\\\": 13,\\n\",\"    \\\"Full Paired Illumination Images\\\": 889,\\n\",\"    \\\"Corrected Identity-Level Evaluation Images\\\": 229,\\n\",\"    \\\"Low Brightness Factor\\\": 0.5,\\n\",\"    \\\"Original Brightness Factor\\\": 1.0,\\n\",\"    \\\"High Brightness Factor\\\": 1.5\\n\",\"}\\n\",\"\\n\",\"configuration_df = pd.DataFrame(\\n\",\"    list(configuration.items()),\\n\",\"    columns=[\\\"Configuration\\\", \\\"Value\\\"]\\n\",\")\\n\",\"\\n\",\"display(configuration_df)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Verify full paired illumination arrays\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n2. FULL PAIRED ILLUMINATION DATA VALIDATION\\\")\\n\",\"\\n\",\"paired_arrays = {\\n\",\"    \\\"Original\\\": paired_original_embeddings,\\n\",\"    \\\"Low illumination\\\": paired_low_embeddings,\\n\",\"    \\\"High illumination\\\": paired_high_embeddings\\n\",\"}\\n\",\"\\n\",\"paired_sample_counts = []\\n\",\"\\n\",\"for condition, array in paired_arrays.items():\\n\",\"\\n\",\"    array = np.asarray(array)\\n\",\"\\n\",\"    print(f\\\"\\\\n{condition}\\\")\\n\",\"    print(\\\"Shape:\\\", array.shape)\\n\",\"    print(\\\"All values finite:\\\", np.isfinite(array).all())\\n\",\"\\n\",\"    assert array.ndim == 2\\n\",\"    assert array.shape[1] == 512\\n\",\"    assert np.isfinite(array).all()\\n\",\"\\n\",\"    paired_sample_counts.append(array.shape[0])\\n\",\"\\n\",\"assert paired_sample_counts == [889, 889, 889], (\\n\",\"    \\\"Full paired illumination arrays do not contain \\\"\\n\",\"    \\\"the expected 889 samples each.\\\"\\n\",\")\\n\",\"\\n\",\"paired_labels_array = np.asarray(paired_labels)\\n\",\"\\n\",\"assert len(paired_labels_array) == 889\\n\",\"assert len(np.unique(paired_labels_array)) == 13\\n\",\"\\n\",\"print(\\\"\\\\nFull paired sample count: 889\\\")\\n\",\"print(\\\"Full paired identity count:\\\", len(np.unique(paired_labels_array)))\\n\",\"print(\\\"Full paired dataset validation: PASSED\\\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Verify corrected identity-level evaluation cohort\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n3. CORRECTED IDENTITY-LEVEL EVALUATION COHORT\\\")\\n\",\"\\n\",\"evaluation_variables = [\\n\",\"    \\\"evaluation_baseline\\\",\\n\",\"    \\\"evaluation_low\\\",\\n\",\"    \\\"evaluation_high\\\",\\n\",\"    \\\"evaluation_labels\\\"\\n\",\"]\\n\",\"\\n\",\"missing_evaluation_variables = [\\n\",\"    name for name in evaluation_variables\\n\",\"    if name not in globals()\\n\",\"]\\n\",\"\\n\",\"if not missing_evaluation_variables:\\n\",\"\\n\",\"    evaluation_arrays = {\\n\",\"        \\\"Original evaluation\\\": evaluation_baseline,\\n\",\"        \\\"Low illumination evaluation\\\": evaluation_low,\\n\",\"        \\\"High illumination evaluation\\\": evaluation_high\\n\",\"    }\\n\",\"\\n\",\"    evaluation_sample_counts = []\\n\",\"\\n\",\"    for condition, array in evaluation_arrays.items():\\n\",\"\\n\",\"        array = np.asarray(array)\\n\",\"\\n\",\"        print(f\\\"\\\\n{condition}\\\")\\n\",\"        print(\\\"Shape:\\\", array.shape)\\n\",\"        print(\\\"All values finite:\\\", np.isfinite(array).all())\\n\",\"\\n\",\"        assert array.ndim == 2\\n\",\"        assert array.shape[1] == 512\\n\",\"        assert np.isfinite(array).all()\\n\",\"\\n\",\"        evaluation_sample_counts.append(array.shape[0])\\n\",\"\\n\",\"    evaluation_labels_array = np.asarray(evaluation_labels)\\n\",\"\\n\",\"    assert evaluation_sample_counts == [229, 229, 229], (\\n\",\"        \\\"Corrected evaluation arrays do not contain \\\"\\n\",\"        \\\"229 samples each.\\\"\\n\",\"    )\\n\",\"\\n\",\"    assert len(evaluation_labels_array) == 229\\n\",\"    assert len(np.unique(evaluation_labels_array)) == 13\\n\",\"\\n\",\"    print(\\\"\\\\nCorrected evaluation sample count: 229\\\")\\n\",\"    print(\\n\",\"        \\\"Corrected evaluation identity count:\\\",\\n\",\"        len(np.unique(evaluation_labels_array))\\n\",\"    )\\n\",\"    print(\\\"Corrected evaluation cohort validation: PASSED\\\")\\n\",\"\\n\",\"else:\\n\",\"\\n\",\"    print(\\n\",\"        \\\"Corrected evaluation variables unavailable:\\\",\\n\",\"        missing_evaluation_variables\\n\",\"    )\\n\",\"    print(\\n\",\"        \\\"Corrected 229-image cohort could not be independently \\\"\\n\",\"        \\\"verified in the current session.\\\"\\n\",\"    )\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Inspect existing model object\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n4. MODEL OBJECT INSPECTION\\\")\\n\",\"\\n\",\"model_candidates = [\\n\",\"    name for name in globals()\\n\",\"    if \\\"model\\\" in name.lower()\\n\",\"    and name != \\\"model_candidates\\\"\\n\",\"]\\n\",\"\\n\",\"model_inspection = []\\n\",\"\\n\",\"for name in model_candidates:\\n\",\"\\n\",\"    obj = globals()[name]\\n\",\"\\n\",\"    if callable(getattr(obj, \\\"eval\\\", None)):\\n\",\"\\n\",\"        model_inspection.append({\\n\",\"            \\\"Variable\\\": name,\\n\",\"            \\\"Object Type\\\": type(obj).__name__,\\n\",\"            \\\"Class Module\\\": type(obj).__module__,\\n\",\"            \\\"Evaluation Method\\\": \\\"Available\\\"\\n\",\"        })\\n\",\"\\n\",\"if model_inspection:\\n\",\"\\n\",\"    model_inspection_df = pd.DataFrame(model_inspection)\\n\",\"    display(model_inspection_df)\\n\",\"\\n\",\"    expected_model_found = any(\\n\",\"        row[\\\"Object Type\\\"] == \\\"InceptionResnetV1\\\"\\n\",\"        for row in model_inspection\\n\",\"    )\\n\",\"\\n\",\"    print(\\n\",\"        \\\"InceptionResnetV1 model object found:\\\",\\n\",\"        expected_model_found\\n\",\"    )\\n\",\"\\n\",\"else:\\n\",\"\\n\",\"    print(\\n\",\"        \\\"No existing model object with an evaluation method \\\"\\n\",\"        \\\"was identified.\\\"\\n\",\"    )\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Inspect random seed configuration\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n5. RANDOM SEED CONFIGURATION\\\")\\n\",\"\\n\",\"seed_names = [\\n\",\"    \\\"RANDOM_SEED\\\",\\n\",\"    \\\"BOOTSTRAP_SEED\\\"\\n\",\"]\\n\",\"\\n\",\"seed_records = []\\n\",\"\\n\",\"for name in seed_names:\\n\",\"\\n\",\"    if name in globals():\\n\",\"\\n\",\"        value = globals()[name]\\n\",\"\\n\",\"        if isinstance(value, (int, float, str)):\\n\",\"\\n\",\"            seed_records.append({\\n\",\"                \\\"Seed Variable\\\": name,\\n\",\"                \\\"Recorded Value\\\": value,\\n\",\"                \\\"Status\\\": \\\"FOUND\\\"\\n\",\"            })\\n\",\"\\n\",\"        else:\\n\",\"\\n\",\"            seed_records.append({\\n\",\"                \\\"Seed Variable\\\": name,\\n\",\"                \\\"Recorded Value\\\": str(type(value).__name__),\\n\",\"                \\\"Status\\\": \\\"FOUND — NON-SCALAR\\\"\\n\",\"            })\\n\",\"\\n\",\"    else:\\n\",\"\\n\",\"        seed_records.append({\\n\",\"            \\\"Seed Variable\\\": name,\\n\",\"            \\\"Recorded Value\\\": \\\"Not available\\\",\\n\",\"            \\\"Status\\\": \\\"NOT FOUND\\\"\\n\",\"        })\\n\",\"\\n\",\"seed_df = pd.DataFrame(seed_records)\\n\",\"display(seed_df)\\n\",\"\\n\",\"print(\\n\",\"    \\\"Seed inspection records variables present in the current \\\"\\n\",\"    \\\"session; it does not independently prove that every original \\\"\\n\",\"    \\\"experiment operation used these seeds.\\\"\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. Software and environment versions\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n6. SOFTWARE ENVIRONMENT\\\")\\n\",\"\\n\",\"packages = [\\n\",\"    \\\"numpy\\\",\\n\",\"    \\\"pandas\\\",\\n\",\"    \\\"torch\\\",\\n\",\"    \\\"torchvision\\\",\\n\",\"    \\\"facenet-pytorch\\\",\\n\",\"    \\\"scipy\\\",\\n\",\"    \\\"matplotlib\\\",\\n\",\"    \\\"scikit-learn\\\",\\n\",\"    \\\"Pillow\\\"\\n\",\"]\\n\",\"\\n\",\"software_versions = []\\n\",\"\\n\",\"for package in packages:\\n\",\"\\n\",\"    try:\\n\",\"        version = pkg_metadata.version(package)\\n\",\"\\n\",\"    except pkg_metadata.PackageNotFoundError:\\n\",\"        version = \\\"Not installed\\\"\\n\",\"\\n\",\"    software_versions.append({\\n\",\"        \\\"Package\\\": package,\\n\",\"        \\\"Version\\\": version\\n\",\"    })\\n\",\"\\n\",\"software_df = pd.DataFrame(software_versions)\\n\",\"\\n\",\"print(\\\"Python version:\\\", sys.version.split()[0])\\n\",\"print(\\\"Platform:\\\", platform.platform())\\n\",\"\\n\",\"display(software_df)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. Inspect saved experiment metadata\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n7. SAVED EXPERIMENT METADATA\\\")\\n\",\"\\n\",\"results_directory = Path(\\n\",\"    \\\"/content/drive/MyDrive/Experiment_18_Results\\\"\\n\",\")\\n\",\"\\n\",\"metadata_files = []\\n\",\"\\n\",\"if results_directory.exists():\\n\",\"\\n\",\"    print(\\\"Results directory found:\\\", results_directory)\\n\",\"\\n\",\"    metadata_files = sorted(\\n\",\"        results_directory.glob(\\\"*.json\\\")\\n\",\"    )\\n\",\"\\n\",\"    if metadata_files:\\n\",\"\\n\",\"        for metadata_file in metadata_files:\\n\",\"\\n\",\"            print(\\\"\\\\nMetadata file:\\\", metadata_file.name)\\n\",\"\\n\",\"            try:\\n\",\"\\n\",\"                with open(metadata_file, \\\"r\\\") as file:\\n\",\"                    metadata = json.load(file)\\n\",\"\\n\",\"                print(json.dumps(metadata, indent=2))\\n\",\"\\n\",\"                # Identify older detector statistical records.\\n\",\"                if \\\"detector_statistical_tests\\\" in metadata:\\n\",\"\\n\",\"                    print(\\n\",\"                        \\\"\\\\nWARNING: This file contains detector \\\"\\n\",\"                        \\\"statistical results from an earlier analysis.\\\"\\n\",\"                    )\\n\",\"\\n\",\"                    print(\\n\",\"                        \\\"These entries must be treated as historical \\\"\\n\",\"                        \\\"and superseded by the corrected Step 17.10.2 \\\"\\n\",\"                        \\\"validation results.\\\"\\n\",\"                    )\\n\",\"\\n\",\"                    historical_tests = pd.DataFrame(\\n\",\"                        metadata[\\\"detector_statistical_tests\\\"]\\n\",\"                    )\\n\",\"\\n\",\"                    display(historical_tests)\\n\",\"\\n\",\"                    print(\\n\",\"                        \\\"Metadata interpretation: \\\"\\n\",\"                        \\\"HISTORICAL / SUPERSEDED DETECTOR RESULTS\\\"\\n\",\"                    )\\n\",\"\\n\",\"                # Identify older detector effect-size records.\\n\",\"                if \\\"detector_effect_sizes\\\" in metadata:\\n\",\"\\n\",\"                    print(\\n\",\"                        \\\"Historical detector effect-size records \\\"\\n\",\"                        \\\"are present in this metadata file.\\\"\\n\",\"                    )\\n\",\"\\n\",\"                    print(\\n\",\"                        \\\"They are not treated as the corrected \\\"\\n\",\"                        \\\"Step 17.10.2 effect-size results.\\\"\\n\",\"                    )\\n\",\"\\n\",\"            except Exception as error:\\n\",\"\\n\",\"                print(\\n\",\"                    \\\"Could not read metadata:\\\",\\n\",\"                    str(error)\\n\",\"                )\\n\",\"\\n\",\"    else:\\n\",\"\\n\",\"        print(\\\"No JSON metadata files found.\\\")\\n\",\"\\n\",\"else:\\n\",\"\\n\",\"    print(\\n\",\"        \\\"Previously recorded results directory is not acc\\n\",\"\\n\",\"---------------------------------------------------------------------------\\n\",\"CELL 119 | TYPE: code\\n\",\"Matched terms: common_positions, original_embeddings, low_illumination_embeddings, high_illumination_embeddings, paired_labels\\n\",\"---------------------------------------------------------------------------\\n\",\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 18 — STEP 17.10.4\\n\",\"# SAVED RESULTS AND OUTPUT VERIFICATION\\n\",\"# ============================================================\\n\",\"\\n\",\"import os\\n\",\"import json\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"from pathlib import Path\\n\",\"from IPython.display import display\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Define existing results directory\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"results_dir = Path(\\n\",\"    \\\"/content/drive/MyDrive/Experiment_18_Results\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"EXPERIMENT 18 — STEP 17.10.4\\\")\\n\",\"print(\\\"SAVED RESULTS AND OUTPUT VERIFICATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"assert results_dir.exists(), (\\n\",\"    f\\\"Results directory not found: {results_dir}. \\\"\\n\",\"    \\\"Check Google Drive mounting and directory path.\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n1. RESULTS DIRECTORY\\\")\\n\",\"print(\\\"Directory:\\\", results_dir)\\n\",\"print(\\\"Directory exists: YES\\\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Inventory saved files\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n2. SAVED FILE INVENTORY\\\")\\n\",\"\\n\",\"saved_files = sorted(\\n\",\"    file for file in results_dir.rglob(\\\"*\\\")\\n\",\"    if file.is_file()\\n\",\")\\n\",\"\\n\",\"file_inventory = []\\n\",\"\\n\",\"for file in saved_files:\\n\",\"\\n\",\"    size_kb = file.stat().st_size / 1024\\n\",\"\\n\",\"    file_inventory.append({\\n\",\"        \\\"File\\\": str(file.relative_to(results_dir)),\\n\",\"        \\\"Size (KB)\\\": round(size_kb, 2),\\n\",\"        \\\"Extension\\\": file.suffix.lower()\\n\",\"    })\\n\",\"\\n\",\"if file_inventory:\\n\",\"    display(pd.DataFrame(file_inventory))\\n\",\"else:\\n\",\"    print(\\\"No saved files found.\\\")\\n\",\"\\n\",\"print(\\\"Total saved files:\\\", len(saved_files))\\n\",\"\\n\",\"npz_files = [\\n\",\"    f for f in saved_files if f.suffix.lower() == \\\".npz\\\"\\n\",\"]\\n\",\"\\n\",\"npy_files = [\\n\",\"    f for f in saved_files if f.suffix.lower() == \\\".npy\\\"\\n\",\"]\\n\",\"\\n\",\"csv_files = [\\n\",\"    f for f in saved_files if f.suffix.lower() == \\\".csv\\\"\\n\",\"]\\n\",\"\\n\",\"json_files = [\\n\",\"    f for f in saved_files if f.suffix.lower() == \\\".json\\\"\\n\",\"]\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Inspect NumPy archives without modifying them\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n3. NUMPY ARCHIVE INSPECTION\\\")\\n\",\"\\n\",\"numpy_archive_records = []\\n\",\"\\n\",\"for file in npz_files:\\n\",\"\\n\",\"    print(\\\"\\\\nArchive:\\\", file.name)\\n\",\"\\n\",\"    try:\\n\",\"\\n\",\"        with np.load(file, allow_pickle=False) as archive:\\n\",\"\\n\",\"            for key in archive.files:\\n\",\"\\n\",\"                array = archive[key]\\n\",\"\\n\",\"                finite = (\\n\",\"                    bool(np.isfinite(array).all())\\n\",\"                    if np.issubdtype(array.dtype, np.number)\\n\",\"                    else None\\n\",\"                )\\n\",\"\\n\",\"                record = {\\n\",\"                    \\\"Archive\\\": file.name,\\n\",\"                    \\\"Key\\\": key,\\n\",\"                    \\\"Shape\\\": str(array.shape),\\n\",\"                    \\\"Dtype\\\": str(array.dtype),\\n\",\"                    \\\"Finite\\\": finite\\n\",\"                }\\n\",\"\\n\",\"                numpy_archive_records.append(record)\\n\",\"\\n\",\"                print(\\n\",\"                    f\\\"{key}: shape={array.shape}, \\\"\\n\",\"                    f\\\"dtype={array.dtype}, finite={finite}\\\"\\n\",\"                )\\n\",\"\\n\",\"    except Exception as error:\\n\",\"\\n\",\"        print(\\\"Archive inspection error:\\\", str(error))\\n\",\"\\n\",\"if numpy_archive_records:\\n\",\"    display(pd.DataFrame(numpy_archive_records))\\n\",\"\\n\",\"# Inspect standalone NPY files, if present.\\n\",\"\\n\",\"for file in npy_files:\\n\",\"\\n\",\"    print(\\\"\\\\nNPY file:\\\", file.name)\\n\",\"\\n\",\"    try:\\n\",\"\\n\",\"        array = np.load(file, allow_pickle=False)\\n\",\"\\n\",\"        print(\\\"Shape:\\\", array.shape)\\n\",\"        print(\\\"Dtype:\\\", array.dtype)\\n\",\"\\n\",\"        if np.issubdtype(array.dtype, np.number):\\n\",\"            print(\\\"All values finite:\\\", np.isfinite(array).all())\\n\",\"\\n\",\"    except Exception as error:\\n\",\"\\n\",\"        print(\\\"NPY inspection error:\\\", str(error))\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Verify illumination archive structure\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n4. ILLUMINATION ARCHIVE VALIDATION\\\")\\n\",\"\\n\",\"illumination_archive = (\\n\",\"    results_dir / \\\"experiment18_illumination_results.npz\\\"\\n\",\")\\n\",\"\\n\",\"if illumination_archive.exists():\\n\",\"\\n\",\"    with np.load(\\n\",\"        illumination_archive,\\n\",\"        allow_pickle=False\\n\",\"    ) as archive:\\n\",\"\\n\",\"        required_keys = [\\n\",\"            \\\"original_embeddings\\\",\\n\",\"            \\\"low_illumination_embeddings\\\",\\n\",\"            \\\"high_illumination_embeddings\\\",\\n\",\"            \\\"paired_labels\\\",\\n\",\"            \\\"common_positions\\\",\\n\",\"            \\\"low_displacement\\\",\\n\",\"            \\\"high_displacement\\\"\\n\",\"        ]\\n\",\"\\n\",\"        missing_keys = [\\n\",\"            key for key in required_keys\\n\",\"            if key not in archive.files\\n\",\"        ]\\n\",\"\\n\",\"        assert not missing_keys, (\\n\",\"            f\\\"Missing illumination archive keys: {missing_keys}\\\"\\n\",\"        )\\n\",\"\\n\",\"        expected_shapes = {\\n\",\"            \\\"original_embeddings\\\": (889, 512),\\n\",\"            \\\"low_illumination_embeddings\\\": (889, 512),\\n\",\"            \\\"high_illumination_embeddings\\\": (889, 512),\\n\",\"            \\\"paired_labels\\\": (889,),\\n\",\"            \\\"common_positions\\\": (889,),\\n\",\"            \\\"low_displacement\\\": (889,),\\n\",\"            \\\"high_displacement\\\": (889,)\\n\",\"        }\\n\",\"\\n\",\"        archive_checks = []\\n\",\"\\n\",\"        for key, expected_shape in expected_shapes.items():\\n\",\"\\n\",\"            actual = archive[key]\\n\",\"\\n\",\"            shape_passed = actual.shape == expected_shape\\n\",\"\\n\",\"            finite_passed = (\\n\",\"                np.isfinite(actual).all()\\n\",\"                if np.issubdtype(actual.dtype, np.number)\\n\",\"                else True\\n\",\"            )\\n\",\"\\n\",\"            assert shape_passed, (\\n\",\"                f\\\"{key}: expected {expected_shape}, \\\"\\n\",\"                f\\\"found {actual.shape}\\\"\\n\",\"            )\\n\",\"\\n\",\"            assert finite_passed, (\\n\",\"                f\\\"{key}: non-finite numerical values found.\\\"\\n\",\"            )\\n\",\"\\n\",\"            archive_checks.append({\\n\",\"                \\\"Array\\\": key,\\n\",\"                \\\"Actual Shape\\\": str(actual.shape),\\n\",\"                \\\"Expected Shape\\\": str(expected_shape),\\n\",\"                \\\"Status\\\": \\\"PASSED\\\"\\n\",\"            })\\n\",\"\\n\",\"        display(pd.DataFrame(archive_checks))\\n\",\"\\n\",\"        print(\\n\",\"            \\\"Full paired illumination archive validation: PASSED\\\"\\n\",\"        )\\n\",\"\\n\",\"else:\\n\",\"\\n\",\"    print(\\\"Illumination archive not found.\\\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Inspect CSV files\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n5. CSV FILE INSPECTION\\\")\\n\",\"\\n\",\"csv_inventory = []\\n\",\"\\n\",\"for file in csv_files:\\n\",\"\\n\",\"    print(\\\"\\\\nCSV file:\\\", file.name)\\n\",\"\\n\",\"    try:\\n\",\"\\n\",\"        dataframe = pd.read_csv(file)\\n\",\"\\n\",\"        print(\\\"Rows:\\\", len(dataframe))\\n\",\"        print(\\\"Columns:\\\", list(dataframe.columns))\\n\",\"        print(\\\"Empty:\\\", dataframe.empty)\\n\",\"\\n\",\"        csv_inventory.append({\\n\",\"            \\\"File\\\": file.name,\\n\",\"            \\\"Rows\\\": len(dataframe),\\n\",\"            \\\"Columns\\\": len(dataframe.columns),\\n\",\"            \\\"Empty\\\": dataframe.empty\\n\",\"        })\\n\",\"\\n\",\"        display(dataframe.head(3))\\n\",\"\\n\",\"    except Exception as error:\\n\",\"\\n\",\"        print(\\\"CSV inspection error:\\\", str(error))\\n\",\"\\n\",\"if csv_inventory:\\n\",\"    display(pd.DataFrame(csv_inventory))\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. Inspect JSON metadata files\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n6. JSON METADATA INSPECTION\\\")\\n\",\"\\n\",\"metadata_records = {}\\n\",\"\\n\",\"for file in json_files:\\n\",\"\\n\",\"    print(\\\"\\\\nJSON file:\\\", file.name)\\n\",\"\\n\",\"    try:\\n\",\"\\n\",\"        with open(file, \\\"r\\\", encoding=\\\"utf-8\\\") as handle:\\n\",\"            metadata = json.load(handle)\\n\",\"\\n\",\"        metadata_records[file.name] = metadata\\n\",\"\\n\",\"        print(\\\"Top-level metadata keys:\\\")\\n\",\"        print(list(metadata.keys()))\\n\",\"\\n\",\"    except Exception as error:\\n\",\"\\n\",\"        print(\\\"JSON inspection error:\\\", str(error))\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. Validate illumination metadata\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n7. ILLUMINATION METADATA VALIDATION\\\")\\n\",\"\\n\",\"illumination_metadata = metadata_records.get(\\n\",\"    \\\"illumination_metadata.json\\\"\\n\",\")\\n\",\"\\n\",\"if illumination_metadata is not None:\\n\",\"\\n\",\"    expected_metadata = {\\n\",\"        \\\"dataset\\\": \\\"LFW filtered subset\\\",\\n\",\"        \\\"model\\\": \\\"InceptionResnetV1\\\",\\n\",\"        \\\"pretrained_weights\\\": \\\"VGGFace2\\\",\\n\",\"        \\\"embedding_dimension\\\": 512,\\n\",\"        \\\"paired_images\\\": 889,\\n\",\"        \\\"evaluation_identities\\\": 13\\n\",\"    }\\n\",\"\\n\",\"    metadata_checks = []\\n\",\"\\n\",\"    for key, expected_value in expected_metadata.items():\\n\",\"\\n\",\"        actual_value = illumination_metadata.get(key)\\n\",\"\\n\",\"        passed = actual_value == expected_value\\n\",\"\\n\",\"        metadata_checks.append({\\n\",\"            \\\"Field\\\": key,\\n\",\"            \\\"Recorded Value\\\": actual_value,\\n\",\"            \\\"Expected Value\\\": expected_value,\\n\",\"            \\\"Status\\\": \\\"PASSED\\\" if passed else \\\"REVIEW\\\"\\n\",\"        })\\n\",\"\\n\",\"    display(pd.DataFrame(metadata_checks))\\n\",\"\\n\",\"    print(\\\"\\\\nSaved illumination displacement statistics:\\\")\\n\",\"\\n\",\"    displacement_fields = [\\n\",\"        \\\"image_level_wilcoxon_p\\\",\\n\",\"        \\\"identity_level_wilcoxon_p\\\",\\n\",\"        \\\"mean_low_displacement\\\",\\n\",\"        \\\"mean_high_displacement\\\"\\n\",\"    ]\\n\",\"\\n\",\"    for key in displacement_fields:\\n\",\"        print(f\\\"{key}: {illumination_metadata.get(key, 'NOT FOUND')}\\\")\\n\",\"\\n\",\"    print(\\n\",\"        \\\"\\\\nThese values belong to the saved illumination-displacement \\\"\\n\",\"        \\\"analysis. They are not the corrected detector-response \\\"\\n\",\"        \\\"Wilcoxon results from Step 17.10.2.\\\"\\n\",\"    )\\n\",\"\\n\",\"else:\\n\",\"\\n\",\"    print(\\\"illumination_metadata.json not found or unreadable.\\\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 8. Validate corrected detector statistical results\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n8. CORRECTED STEP 17 DETECTOR STATISTICAL RESULTS\\\")\\n\",\"\\n\",\"expected_detector_results = {\\n\",\"    \\\"Euclidean\\\": {\\n\",\"        \\\"Wilcoxon Statistic\\\": 13.0,\\n\",\"        \\\"P-value\\\": 0.021484\\n\",\"    },\\n\",\"    \\\"Mahalanobis\\\": {\\n\",\"        \\\"Wilcoxon Statistic\\\": 5.0,\\n\",\"        \\\"P-value\\\": 0.002441\\n\",\"    }\\n\",\"}\\n\",\"\\n\",\"# Step 17.10.2 uses statistical_results.\\n\",\"# Do not substitute statistical_test_df or historical values.\\n\",\"\\n\",\"if \\\"statistical_results\\\" in globals():\\n\",\"\\n\",\"    current_statistics = statistical_results.copy()\\n\",\"\\n\",\"    required_columns = [\\n\",\"        \\\"Detector\\\",\\n\",\"        \\\"Wilcoxon Statistic\\\",\\n\",\"        \\\"P-value\\\"\\n\",\"    ]\\n\",\"\\n\",\"    for column in required_columns:\\n\",\"        assert column in current_statistics.columns, (\\n\",\"            f\\\"Missing column in statistical_results: {column}\\\"\\n\",\"        )\\n\",\"\\n\",\"    current_statistics = current_statistics.set_index(\\\"Detector\\\")\\n\",\"\\n\",\"---------------------------------------------------------------------------\\n\",\"CELL 123 | TYPE: code\\n\",\"Matched terms: original_embeddings, low_illumination_embeddings, high_illumination_embeddings, paired_labels\\n\",\"---------------------------------------------------------------------------\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 18 — STEP 17.10.5.1\\n\",\"# Load and Verify Saved Illumination Data\\n\",\"# ============================================================\\n\",\"\\n\",\"import numpy as np\\n\",\"import json\\n\",\"from pathlib import Path\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Locate existing saved results\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"results_dir = Path(\\\"/content/drive/MyDrive/Experiment_18_Results\\\")\\n\",\"\\n\",\"npz_path = results_dir / \\\"experiment18_illumination_results.npz\\\"\\n\",\"metadata_path = results_dir / \\\"illumination_metadata.json\\\"\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"STEP 17.10.5.1 — SAVED ILLUMINATION DATA VERIFICATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"assert results_dir.exists(), \\\"Results directory does not exist.\\\"\\n\",\"assert npz_path.exists(), \\\"Illumination NPZ file not found.\\\"\\n\",\"assert metadata_path.exists(), \\\"Illumination metadata file not found.\\\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Load existing arrays (read-only inspection)\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"with np.load(npz_path, allow_pickle=False) as data:\\n\",\"\\n\",\"    original_embeddings = data[\\\"original_embeddings\\\"].copy()\\n\",\"    low_illumination_embeddings = data[\\\"low_illumination_embeddings\\\"].copy()\\n\",\"    high_illumination_embeddings = data[\\\"high_illumination_embeddings\\\"].copy()\\n\",\"\\n\",\"    paired_labels = data[\\\"paired_labels\\\"].copy()\\n\",\"\\n\",\"    saved_low_displacement = data[\\\"low_displacement\\\"].copy()\\n\",\"    saved_high_displacement = data[\\\"high_displacement\\\"].copy()\\n\",\"\\n\",\"# Load metadata\\n\",\"with open(metadata_path, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    illumination_metadata = json.load(f)\\n\",\"\\n\",\"print(\\\"\\\\n[1] FILE LOADING\\\")\\n\",\"print(\\\"Illumination NPZ loaded: SUCCESS\\\")\\n\",\"print(\\\"Metadata JSON loaded: SUCCESS\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Inspect array dimensions\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[2] ARRAY DIMENSIONS\\\")\\n\",\"\\n\",\"arrays = {\\n\",\"    \\\"Original embeddings\\\": original_embeddings,\\n\",\"    \\\"Low illumination embeddings\\\": low_illumination_embeddings,\\n\",\"    \\\"High illumination embeddings\\\": high_illumination_embeddings,\\n\",\"    \\\"Paired labels\\\": paired_labels,\\n\",\"    \\\"Saved low displacement\\\": saved_low_displacement,\\n\",\"    \\\"Saved high displacement\\\": saved_high_displacement\\n\",\"}\\n\",\"\\n\",\"for name, array in arrays.items():\\n\",\"    print(f\\\"{name}: {array.shape}\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Verify sample alignment\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[3] SAMPLE ALIGNMENT\\\")\\n\",\"\\n\",\"sample_counts = [len(array) for array in arrays.values()]\\n\",\"\\n\",\"alignment_passed = len(set(sample_counts)) == 1\\n\",\"\\n\",\"print(\\\"Sample counts:\\\", sample_counts)\\n\",\"print(\\\"All sample counts equal:\\\", alignment_passed)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Verify embedding dimensions\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[4] EMBEDDING DIMENSION\\\")\\n\",\"\\n\",\"embedding_dimensions = [\\n\",\"    original_embeddings.shape[1],\\n\",\"    low_illumination_embeddings.shape[1],\\n\",\"    high_illumination_embeddings.shape[1]\\n\",\"]\\n\",\"\\n\",\"dimension_passed = (\\n\",\"    len(set(embedding_dimensions)) == 1\\n\",\"    and embedding_dimensions[0] == 512\\n\",\")\\n\",\"\\n\",\"print(\\\"Embedding dimensions:\\\", embedding_dimensions)\\n\",\"print(\\\"512-dimensional embeddings verified:\\\", dimension_passed)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. Verify numerical validity\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[5] NUMERICAL VALIDITY\\\")\\n\",\"\\n\",\"finite_checks = {}\\n\",\"\\n\",\"for name, array in arrays.items():\\n\",\"    finite_checks[name] = bool(np.isfinite(array).all())\\n\",\"\\n\",\"    print(\\n\",\"        f\\\"{name}: \\\"\\n\",\"        f\\\"{'PASS' if finite_checks[name] else 'FAIL'}\\\"\\n\",\"    )\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. Verify identity information\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[6] IDENTITY VERIFICATION\\\")\\n\",\"\\n\",\"unique_identities = np.unique(paired_labels)\\n\",\"\\n\",\"print(\\\"Number of identities:\\\", len(unique_identities))\\n\",\"print(\\\"Identity labels:\\\", unique_identities.tolist())\\n\",\"\\n\",\"identity_count_passed = (\\n\",\"    len(unique_identities)\\n\",\"    == illumination_metadata.get(\\\"evaluation_identities\\\")\\n\",\")\\n\",\"\\n\",\"print(\\\"Metadata identity count matches:\\\", identity_count_passed)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 8. Verify metadata sample count\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[7] METADATA SAMPLE COUNT\\\")\\n\",\"\\n\",\"metadata_sample_count = illumination_metadata.get(\\\"paired_images\\\")\\n\",\"\\n\",\"sample_count_passed = (\\n\",\"    metadata_sample_count == len(paired_labels)\\n\",\")\\n\",\"\\n\",\"print(\\\"Saved paired images:\\\", metadata_sample_count)\\n\",\"print(\\\"Actual paired labels:\\\", len(paired_labels))\\n\",\"print(\\\"Metadata sample count matches:\\\", sample_count_passed)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 9. Display saved statistical results\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[8] EXISTING METADATA STATISTICS\\\")\\n\",\"\\n\",\"metadata_statistics = [\\n\",\"    \\\"image_level_wilcoxon_p\\\",\\n\",\"    \\\"identity_level_wilcoxon_p\\\",\\n\",\"    \\\"mean_low_displacement\\\",\\n\",\"    \\\"mean_high_displacement\\\"\\n\",\"]\\n\",\"\\n\",\"for key in metadata_statistics:\\n\",\"    print(f\\\"{key}: {illumination_metadata.get(key)}\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 10. Final validation\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"all_checks_passed = (\\n\",\"    alignment_passed\\n\",\"    and dimension_passed\\n\",\"    and all(finite_checks.values())\\n\",\"    and identity_count_passed\\n\",\"    and sample_count_passed\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"\\n\",\"if all_checks_passed:\\n\",\"    print(\\\"STEP 17.10.5.1 STATUS: PASSED\\\")\\n\",\"else:\\n\",\"    print(\\\"STEP 17.10.5.1 STATUS: REVIEW REQUIRED\\\")\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"---------------------------------------------------------------------------\\n\",\"CELL 124 | TYPE: code\\n\",\"Matched terms: original_embeddings, low_illumination_embeddings, high_illumination_embeddings\\n\",\"---------------------------------------------------------------------------\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 18 — STEP 17.10.5.2\\n\",\"# Independent Displacement Recalculation\\n\",\"# ============================================================\\n\",\"\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"STEP 17.10.5.2 — INDEPENDENT DISPLACEMENT VERIFICATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Independently recalculate embedding displacement\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"recalculated_low_displacement = np.linalg.norm(\\n\",\"    low_illumination_embeddings - original_embeddings,\\n\",\"    axis=1\\n\",\")\\n\",\"\\n\",\"recalculated_high_displacement = np.linalg.norm(\\n\",\"    high_illumination_embeddings - original_embeddings,\\n\",\"    axis=1\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n[1] DISPLACEMENT RECALCULATION\\\")\\n\",\"print(\\\"Low displacement shape:\\\", recalculated_low_displacement.shape)\\n\",\"print(\\\"High displacement shape:\\\", recalculated_high_displacement.shape)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Compare recalculated values with saved arrays\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"low_absolute_difference = np.abs(\\n\",\"    recalculated_low_displacement - saved_low_displacement\\n\",\")\\n\",\"\\n\",\"high_absolute_difference = np.abs(\\n\",\"    recalculated_high_displacement - saved_high_displacement\\n\",\")\\n\",\"\\n\",\"low_match = np.allclose(\\n\",\"    recalculated_low_displacement,\\n\",\"    saved_low_displacement,\\n\",\"    rtol=1e-5,\\n\",\"    atol=1e-6\\n\",\")\\n\",\"\\n\",\"high_match = np.allclose(\\n\",\"    recalculated_high_displacement,\\n\",\"    saved_high_displacement,\\n\",\"    rtol=1e-5,\\n\",\"    atol=1e-6\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n[2] SAVED ARRAY COMPARISON\\\")\\n\",\"\\n\",\"print(\\\"Low displacement matches:\\\", low_match)\\n\",\"print(\\\"High displacement matches:\\\", high_match)\\n\",\"\\n\",\"print(\\\"Low maximum absolute difference:\\\",\\n\",\"      np.max(low_absolute_difference))\\n\",\"\\n\",\"print(\\\"High maximum absolute difference:\\\",\\n\",\"      np.max(high_absolute_difference))\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Compare descriptive statistics\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"displacement_summary = pd.DataFrame([\\n\",\"    {\\n\",\"        \\\"Condition\\\": \\\"Low illumination\\\",\\n\",\"        \\\"Saved Mean\\\": np.mean(saved_low_displacement),\\n\",\"        \\\"Recalculated Mean\\\": np.mean(recalculated_low_displacement),\\n\",\"        \\\"Saved Median\\\": np.median(saved_low_displacement),\\n\",\"        \\\"Recalculated Median\\\": np.median(recalculated_low_displacement),\\n\",\"        \\\"Saved Std\\\": np.std(saved_low_displacement),\\n\",\"        \\\"Recalculated Std\\\": np.std(recalculated_low_displacement)\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Condition\\\": \\\"High illumination\\\",\\n\",\"        \\\"Saved Mean\\\": np.mean(saved_high_displacement),\\n\",\"        \\\"Recalculated Mean\\\": np.mean(recalculated_high_displacement),\\n\",\"        \\\"Saved Median\\\": np.median(saved_high_displacement),\\n\",\"        \\\"Recalculated Median\\\": np.median(recalculated_high_displacement),\\n\",\"        \\\"Saved Std\\\": np.std(saved_high_displacement),\\n\",\"        \\\"Recalculated Std\\\": np.std(recalculated_high_displacement)\\n\",\"    }\\n\",\"])\\n\",\"\\n\",\"print(\\\"\\\\n[3] DESCRIPTIVE STATISTICS\\\")\\n\",\"display(displacement_summary)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Compare recalculated means with metadata\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"metadata_low_mean = illumination_metadata[\\\"mean_low_displacement\\\"]\\n\",\"metadata_high_mean = illumination_metadata[\\\"mean_high_displacement\\\"]\\n\",\"\\n\",\"recalculated_low_mean = np.mean(recalculated_low_displacement)\\n\",\"recalculated_high_mean = np.mean(recalculated_high_displacement)\\n\",\"\\n\",\"low_metadata_match = np.isclose(\\n\",\"    recalculated_low_mean,\\n\",\"    metadata_low_mean,\\n\",\"    rtol=1e-5,\\n\",\"    atol=1e-6\\n\",\")\\n\",\"\\n\",\"high_metadata_match = np.isclose(\\n\",\"    recalculated_high_mean,\\n\",\"    metadata_high_mean,\\n\",\"    rtol=1e-5,\\n\",\"    atol=1e-6\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n[4] METADATA MEAN COMPARISON\\\")\\n\",\"\\n\",\"print(\\\"Saved low mean:\\\", metadata_low_mean)\\n\",\"print(\\\"Recalculated low mean:\\\", recalculated_low_mean)\\n\",\"print(\\\"Low metadata match:\\\", low_metadata_match)\\n\",\"\\n\",\"print(\\\"\\\\nSaved high mean:\\\", metadata_high_mean)\\n\",\"print(\\\"Recalculated high mean:\\\", recalculated_high_mean)\\n\",\"print(\\\"High metadata match:\\\", high_metadata_match)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Final verification\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"all_displacement_checks_passed = (\\n\",\"    low_match\\n\",\"    and high_match\\n\",\"    and low_metadata_match\\n\",\"    and high_metadata_match\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"\\n\",\"if all_displacement_checks_passed:\\n\",\"    print(\\\"STEP 17.10.5.2 STATUS: PASSED\\\")\\n\",\"else:\\n\",\"    print(\\\"STEP 17.10.5.2 STATUS: REVIEW REQUIRED\\\")\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"---------------------------------------------------------------------------\\n\",\"CELL 126 | TYPE: code\\n\",\"Matched terms: paired_labels\\n\",\"---------------------------------------------------------------------------\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 18 — STEP 17.10.5.4\\n\",\"# Independent Identity-Level Statistical Verification\\n\",\"# ============================================================\\n\",\"\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"from scipy.stats import wilcoxon\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"STEP 17.10.5.4 — IDENTITY-LEVEL STATISTICAL VERIFICATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Construct image-level displacement DataFrame\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"illumination_df = pd.DataFrame({\\n\",\"    \\\"Identity\\\": paired_labels,\\n\",\"    \\\"Low_Displacement\\\": saved_low_displacement,\\n\",\"    \\\"High_Displacement\\\": saved_high_displacement\\n\",\"})\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Aggregate displacement by identity\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"identity_displacement_df = (\\n\",\"    illumination_df\\n\",\"    .groupby(\\\"Identity\\\")\\n\",\"    .agg(\\n\",\"        Image_Count=(\\\"Low_Displacement\\\", \\\"count\\\"),\\n\",\"        Low_Mean=(\\\"Low_Displacement\\\", \\\"mean\\\"),\\n\",\"        High_Mean=(\\\"High_Displacement\\\", \\\"mean\\\"),\\n\",\"        Low_Median=(\\\"Low_Displacement\\\", \\\"median\\\"),\\n\",\"        High_Median=(\\\"High_Displacement\\\", \\\"median\\\")\\n\",\"    )\\n\",\"    .reset_index()\\n\",\")\\n\",\"\\n\",\"identity_displacement_df[\\\"Mean_Difference\\\"] = (\\n\",\"    identity_displacement_df[\\\"High_Mean\\\"]\\n\",\"    - identity_displacement_df[\\\"Low_Mean\\\"]\\n\",\")\\n\",\"\\n\",\"identity_displacement_df[\\\"Median_Difference\\\"] = (\\n\",\"    identity_displacement_df[\\\"High_Median\\\"]\\n\",\"    - identity_displacement_df[\\\"Low_Median\\\"]\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n[1] IDENTITY-LEVEL DISPLACEMENT SUMMARY\\\")\\n\",\"display(identity_displacement_df)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Calculate paired identity-level Wilcoxon test\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"identity_level_test = wilcoxon(\\n\",\"    identity_displacement_df[\\\"High_Mean\\\"],\\n\",\"    identity_displacement_df[\\\"Low_Mean\\\"],\\n\",\"    alternative=\\\"two-sided\\\"\\n\",\")\\n\",\"\\n\",\"recalculated_identity_p = identity_level_test.pvalue\\n\",\"\\n\",\"saved_identity_p = illumination_metadata[\\n\",\"    \\\"identity_level_wilcoxon_p\\\"\\n\",\"]\\n\",\"\\n\",\"print(\\\"\\\\n[2] IDENTITY-LEVEL WILCOXON TEST\\\")\\n\",\"\\n\",\"print(\\\"Number of identities:\\\", len(identity_displacement_df))\\n\",\"print(\\\"Wilcoxon statistic:\\\", identity_level_test.statistic)\\n\",\"print(\\\"Recalculated p-value:\\\", recalculated_identity_p)\\n\",\"print(\\\"Saved metadata p-value:\\\", saved_identity_p)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Compare metadata p-value\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"identity_p_match = np.isclose(\\n\",\"    recalculated_identity_p,\\n\",\"    saved_identity_p,\\n\",\"    rtol=1e-5,\\n\",\"    atol=1e-12\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n[3] METADATA CONSISTENCY\\\")\\n\",\"print(\\\"Identity-level p-value matches:\\\", identity_p_match)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Descriptive identity-level statistics\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"identity_differences = identity_displacement_df[\\n\",\"    \\\"Mean_Difference\\\"\\n\",\"].to_numpy()\\n\",\"\\n\",\"print(\\\"\\\\n[4] IDENTITY-LEVEL PAIRED DIFFERENCES\\\")\\n\",\"\\n\",\"print(\\\"Mean difference:\\\", np.mean(identity_differences))\\n\",\"print(\\\"Median difference:\\\", np.median(identity_differences))\\n\",\"print(\\\"Positive identities:\\\", np.sum(identity_differences > 0))\\n\",\"print(\\\"Negative identities:\\\", np.sum(identity_differences < 0))\\n\",\"print(\\\"Zero identities:\\\", np.sum(identity_differences == 0))\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. Final result summary\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"identity_level_summary = pd.DataFrame([{\\n\",\"    \\\"Identities\\\": len(identity_displacement_df),\\n\",\"    \\\"Mean Difference\\\": np.mean(identity_differences),\\n\",\"    \\\"Median Difference\\\": np.median(identity_differences),\\n\",\"    \\\"Positive\\\": np.sum(identity_differences > 0),\\n\",\"    \\\"Negative\\\": np.sum(identity_differences < 0),\\n\",\"    \\\"Zero\\\": np.sum(identity_differences == 0),\\n\",\"    \\\"Wilcoxon Statistic\\\": identity_level_test.statistic,\\n\",\"    \\\"Recalculated P-value\\\": recalculated_identity_p,\\n\",\"    \\\"Saved P-value\\\": saved_identity_p,\\n\",\"    \\\"P-value Match\\\": identity_p_match\\n\",\"}])\\n\",\"\\n\",\"print(\\\"\\\\n[5] IDENTITY-LEVEL RESULT SUMMARY\\\")\\n\",\"display(identity_level_summary)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. Final status\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"\\n\",\"if identity_p_match:\\n\",\"    print(\\\"STEP 17.10.5.4 STATUS: PASSED\\\")\\n\",\"else:\\n\",\"    print(\\\"STEP 17.10.5.4 STATUS: REVIEW REQUIRED\\\")\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"---------------------------------------------------------------------------\\n\",\"CELL 129 | TYPE: code\\n\",\"Matched terms: original_embeddings, low_illumination_embeddings, high_illumination_embeddings, paired_labels\\n\",\"---------------------------------------------------------------------------\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 18 — STEP 17.10.5.6\\n\",\"# FINAL STATISTICAL CONSISTENCY AND REPRODUCIBILITY AUDIT\\n\",\"# ============================================================\\n\",\"\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"import json\\n\",\"\\n\",\"from pathlib import Path\\n\",\"from scipy.stats import wilcoxon\\n\",\"\\n\",\"print(\\\"=\\\" * 80)\\n\",\"print(\\\"STEP 17.10.5.6 — FINAL STATISTICAL CONSISTENCY AUDIT\\\")\\n\",\"print(\\\"=\\\" * 80)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Load original saved files\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"results_dir = Path(\\n\",\"    \\\"/content/drive/MyDrive/Experiment_18_Results\\\"\\n\",\")\\n\",\"\\n\",\"npz_path = results_dir / \\\"experiment18_illumination_results.npz\\\"\\n\",\"metadata_path = results_dir / \\\"illumination_metadata.json\\\"\\n\",\"csv_path = results_dir / \\\"illumination_identity_summary.csv\\\"\\n\",\"\\n\",\"assert npz_path.exists(), \\\"Illumination NPZ file missing.\\\"\\n\",\"assert metadata_path.exists(), \\\"Metadata JSON missing.\\\"\\n\",\"assert csv_path.exists(), \\\"Identity summary CSV missing.\\\"\\n\",\"\\n\",\"with np.load(npz_path, allow_pickle=False) as data:\\n\",\"    original = data[\\\"original_embeddings\\\"].copy()\\n\",\"    low = data[\\\"low_illumination_embeddings\\\"].copy()\\n\",\"    high = data[\\\"high_illumination_embeddings\\\"].copy()\\n\",\"    labels = data[\\\"paired_labels\\\"].copy()\\n\",\"    saved_low = data[\\\"low_displacement\\\"].copy()\\n\",\"    saved_high = data[\\\"high_displacement\\\"].copy()\\n\",\"\\n\",\"with open(metadata_path, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    metadata = json.load(f)\\n\",\"\\n\",\"saved_csv = pd.read_csv(csv_path)\\n\",\"\\n\",\"print(\\\"\\\\n[1] SAVED FILES\\\")\\n\",\"print(\\\"NPZ loaded: SUCCESS\\\")\\n\",\"print(\\\"Metadata loaded: SUCCESS\\\")\\n\",\"print(\\\"Identity CSV loaded: SUCCESS\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Independently recalculate displacement\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"recalculated_low = np.linalg.norm(\\n\",\"    low - original,\\n\",\"    axis=1\\n\",\")\\n\",\"\\n\",\"recalculated_high = np.linalg.norm(\\n\",\"    high - original,\\n\",\"    axis=1\\n\",\")\\n\",\"\\n\",\"low_displacement_match = np.allclose(\\n\",\"    recalculated_low,\\n\",\"    saved_low,\\n\",\"    rtol=1e-5,\\n\",\"    atol=1e-6\\n\",\")\\n\",\"\\n\",\"high_displacement_match = np.allclose(\\n\",\"    recalculated_high,\\n\",\"    saved_high,\\n\",\"    rtol=1e-5,\\n\",\"    atol=1e-6\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n[2] DISPLACEMENT REPRODUCTION\\\")\\n\",\"print(\\\"Low displacement matches:\\\", low_displacement_match)\\n\",\"print(\\\"High displacement matches:\\\", high_displacement_match)\\n\",\"\\n\",\"low_mean_match = np.isclose(\\n\",\"    np.mean(recalculated_low),\\n\",\"    metadata[\\\"mean_low_displacement\\\"],\\n\",\"    rtol=1e-5,\\n\",\"    atol=1e-6\\n\",\")\\n\",\"\\n\",\"high_mean_match = np.isclose(\\n\",\"    np.mean(recalculated_high),\\n\",\"    metadata[\\\"mean_high_displacement\\\"],\\n\",\"    rtol=1e-5,\\n\",\"    atol=1e-6\\n\",\")\\n\",\"\\n\",\"print(\\\"Low displacement mean matches metadata:\\\", low_mean_match)\\n\",\"print(\\\"High displacement mean matches metadata:\\\", high_mean_match)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Recalculate image-level Wilcoxon test\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"image_test = wilcoxon(\\n\",\"    recalculated_high,\\n\",\"    recalculated_low,\\n\",\"    alternative=\\\"two-sided\\\"\\n\",\")\\n\",\"\\n\",\"image_p_match = np.isclose(\\n\",\"    image_test.pvalue,\\n\",\"    metadata[\\\"image_level_wilcoxon_p\\\"],\\n\",\"    rtol=1e-5,\\n\",\"    atol=1e-12\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n[3] IMAGE-LEVEL STATISTICAL REPRODUCTION\\\")\\n\",\"print(\\\"Observations:\\\", len(labels))\\n\",\"print(\\\"Wilcoxon statistic:\\\", image_test.statistic)\\n\",\"print(\\\"Recalculated p-value:\\\", image_test.pvalue)\\n\",\"print(\\\"Saved p-value:\\\", metadata[\\\"image_level_wilcoxon_p\\\"])\\n\",\"print(\\\"P-value matches metadata:\\\", image_p_match)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Reconstruct identity-level mean and median summaries\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"audit_df = pd.DataFrame({\\n\",\"    \\\"Identity\\\": labels,\\n\",\"    \\\"Low_Displacement\\\": recalculated_low,\\n\",\"    \\\"High_Displacement\\\": recalculated_high\\n\",\"})\\n\",\"\\n\",\"identity_audit = (\\n\",\"    audit_df\\n\",\"    .groupby(\\\"Identity\\\")\\n\",\"    .agg(\\n\",\"        Image_Count=(\\\"Low_Displacement\\\", \\\"count\\\"),\\n\",\"        Low_Mean=(\\\"Low_Displacement\\\", \\\"mean\\\"),\\n\",\"        High_Mean=(\\\"High_Displacement\\\", \\\"mean\\\"),\\n\",\"        Low_Median=(\\\"Low_Displacement\\\", \\\"median\\\"),\\n\",\"        High_Median=(\\\"High_Displacement\\\", \\\"median\\\")\\n\",\"    )\\n\",\"    .reset_index()\\n\",\")\\n\",\"\\n\",\"identity_audit[\\\"Mean_Difference\\\"] = (\\n\",\"    identity_audit[\\\"High_Mean\\\"]\\n\",\"    - identity_audit[\\\"Low_Mean\\\"]\\n\",\")\\n\",\"\\n\",\"identity_audit[\\\"Median_Difference\\\"] = (\\n\",\"    identity_audit[\\\"High_Median\\\"]\\n\",\"    - identity_audit[\\\"Low_Median\\\"]\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n[4] IDENTITY-LEVEL SUMMARY\\\")\\n\",\"print(\\\"Number of identities:\\\", len(identity_audit))\\n\",\"print(\\\"Positive mean differences:\\\",\\n\",\"      (identity_audit[\\\"Mean_Difference\\\"] > 0).sum())\\n\",\"print(\\\"Negative mean differences:\\\",\\n\",\"      (identity_audit[\\\"Mean_Difference\\\"] < 0).sum())\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Recalculate mean-based identity Wilcoxon test\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"mean_identity_test = wilcoxon(\\n\",\"    identity_audit[\\\"High_Mean\\\"],\\n\",\"    identity_audit[\\\"Low_Mean\\\"],\\n\",\"    alternative=\\\"two-sided\\\"\\n\",\")\\n\",\"\\n\",\"mean_identity_p_match = np.isclose(\\n\",\"    mean_identity_test.pvalue,\\n\",\"    metadata[\\\"identity_level_wilcoxon_p\\\"],\\n\",\"    rtol=1e-5,\\n\",\"    atol=1e-12\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n[5] MEAN-BASED IDENTITY TEST\\\")\\n\",\"print(\\\"Wilcoxon statistic:\\\", mean_identity_test.statistic)\\n\",\"print(\\\"Recalculated p-value:\\\", mean_identity_test.pvalue)\\n\",\"print(\\\"Saved metadata p-value:\\\",\\n\",\"      metadata[\\\"identity_level_wilcoxon_p\\\"])\\n\",\"print(\\\"P-value matches metadata:\\\", mean_identity_p_match)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. Recalculate median-based identity Wilcoxon test\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"median_identity_test = wilcoxon(\\n\",\"    identity_audit[\\\"High_Median\\\"],\\n\",\"    identity_audit[\\\"Low_Median\\\"],\\n\",\"    alternative=\\\"two-sided\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n[6] MEDIAN-BASED IDENTITY TEST\\\")\\n\",\"print(\\\"Wilcoxon statistic:\\\", median_identity_test.statistic)\\n\",\"print(\\\"Median-based p-value:\\\", median_identity_test.pvalue)\\n\",\"\\n\",\"print(\\n\",\"    \\\"Mean-based and median-based p-values numerically equal:\\\",\\n\",\"    np.isclose(\\n\",\"        mean_identity_test.pvalue,\\n\",\"        median_identity_test.pvalue\\n\",\"    )\\n\",\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. Verify saved identity summary CSV\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"expected_csv = pd.DataFrame({\\n\",\"    \\\"Identity\\\": identity_audit[\\\"Identity\\\"],\\n\",\"    \\\"Image_Count\\\": identity_audit[\\\"Image_Count\\\"],\\n\",\"    \\\"Low_Median\\\": identity_audit[\\\"Low_Median\\\"],\\n\",\"    \\\"High_Median\\\": identity_audit[\\\"High_Median\\\"],\\n\",\"    \\\"Median_Difference\\\": identity_audit[\\\"Median_Difference\\\"]\\n\",\"})\\n\",\"\\n\",\"saved_csv_sorted = saved_csv.sort_values(\\n\",\"    \\\"Identity\\\"\\n\",\").reset_index(drop=True)\\n\",\"\\n\",\"expected_csv_sorted = expected_csv.sort_values(\\n\",\"    \\\"Identity\\\"\\n\",\").reset_index(drop=True)\\n\",\"\\n\",\"csv_columns = [\\n\",\"    \\\"Identity\\\",\\n\",\"    \\\"Image_Count\\\",\\n\",\"    \\\"Low_Median\\\",\\n\",\"    \\\"High_Median\\\",\\n\",\"    \\\"Median_Difference\\\"\\n\",\"]\\n\",\"\\n\",\"csv_checks = {}\\n\",\"\\n\",\"for column in csv_columns:\\n\",\"    csv_checks[column] = np.allclose(\\n\",\"        saved_csv_sorted[column].to_numpy(dtype=float),\\n\",\"        expected_csv_sorted[column].to_numpy(dtype=float),\\n\",\"        rtol=1e-5,\\n\",\"        atol=1e-6\\n\",\"    )\\n\",\"\\n\",\"print(\\\"\\\\n[7] SAVED CSV CONSISTENCY\\\")\\n\",\"\\n\",\"for column, passed in csv_checks.items():\\n\",\"    print(f\\\"{column}: {'PASS' if passed else 'FAIL'}\\\")\\n\",\"\\n\",\"csv_passed = all(csv_checks.values())\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 8. Consolidated statistical results\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"consolidated_results = pd.DataFrame([\\n\",\"    {\\n\",\"        \\\"Analysis\\\": \\\"Image-level displacement\\\",\\n\",\"        \\\"Observations\\\": len(labels),\\n\",\"        \\\"Wilcoxon Statistic\\\": image_test.statistic,\\n\",\"        \\\"P-value\\\": image_test.pvalue,\\n\",\"        \\\"Metadata Match\\\": image_p_match\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Analysis\\\": \\\"Mean-based identity displacement\\\",\\n\",\"        \\\"Observations\\\": len(identity_audit),\\n\",\"        \\\"Wilcoxon Statistic\\\": mean_identity_test.statistic,\\n\",\"        \\\"P-value\\\": mean_identity_test.pvalue,\\n\",\"        \\\"Metadata Match\\\": mean_identity_p_match\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Analysis\\\": \\\"Median-based identity displacement\\\",\\n\",\"        \\\"Observations\\\": len(identity_audit),\\n\",\"        \\\"Wilcoxon Statistic\\\": median_identity_test.statistic,\\n\",\"        \\\"P-value\\\": median_identity_test.pvalue,\\n\",\"        \\\"Metadata Match\\\": \\\"Separate analysis\\\"\\n\",\"    }\\n\",\"])\\n\",\"\\n\",\"print(\\\"\\\\n[8] CONSOLIDATED STATISTICAL RESULTS\\\")\\n\",\"display(consolidated_results)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 9. Methodological validation\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[9] METHODOLOGICAL INFORMATION\\\")\\n\",\"\\n\",\"print(\\\"Paired image observations:\\\", len(labels))\\n\",\"print(\\\"Unique identities:\\\", len(np.unique(labels)))\\n\",\"print(\\\"Image observations per identity:\\\")\\n\",\"display(\\n\",\"    identity_audit[[\\\"Identity\\\", \\\"Image_Count\\\"]]\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"\\\\nIMPORTANT: Image observations are clustered within identities.\\\"\\n\",\")\\n\",\"print(\\n\",\"    \\\"The 889 image pairs must not be interpreted as 889 independent subjects.\\\"\\n\",\")\\n\",\"print(\\n\",\"    \\\"Identity-level inference is based on only 13 identities.\\\"\\n\",\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 10. Final audit status\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"audit_checks = {\\n\",\"    \\\"Low displacement reproduction\\\": low_displacement_match,\\n\",\"    \\\"High displacement reproduction\\\": high_displacement_match,\\n\",\"    \\\"Low mean metadata consistency\\\": low_mean_match,\\n\",\"    \\\"High mean metadata consistency\\\": high_mean_match,\\n\",\"    \\\"Image-level Wilcoxon reproduction\\\": image_p_match,\\n\",\"    \\\"Mean-based identity Wilcoxon reproduction\\\": mean_identity_p_match,\\n\",\"    \\\"Saved identity CSV consistency\\\": csv_passed\\n\",\"}\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n\",\"print(\\\"FINAL AUDIT CHECKLIST\\\")\\n\",\"print(\\\"=\\\" * 80)\\n\",\"\\n\",\"for check_name, passed in audit_checks.items():\\n\",\"    print(f\\\"{check_name}: {'PASS' if passed else 'FAIL'}\\\")\\n\",\"\\n\",\"all_passed = all(audit_checks.values())\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n\",\"\\n\",\"if all_passed:\\n\",\"    print(\\\"STEP 17.10.5.6 STATUS: PASSED\\\")\\n\",\"    print(\\\"All saved statistical results were independently reproduced.\\\")\\n\",\"else:\\n\",\"    print(\\\"STEP 17.10.5.6 STATUS: REVIEW REQUIRED\\\")\\n\",\"    print(\\\"At least one consistency check requires investigation.\\\")\\n\",\"\\n\",\"print(\\\"=\\\" * 80)\\n\",\"\\n\",\"print(\\\"\\\\nOriginal saved files modified: NO\\\")\\n\",\"print(\\\"New embedding extraction performed: NO\\\")\\n\",\"print(\\\"\\n\",\"\\n\",\"---------------------------------------------------------------------------\\n\",\"CELL 131 | TYPE: code\\n\",\"Matched terms: original_embeddings, low_illumination_embeddings, high_illumination_embeddings, paired_labels, low_success, high_success\\n\",\"---------------------------------------------------------------------------\\n\",\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 18 — STEP 17.10.6.1\\n\",\"# EXPERIMENTAL CONFIGURATION AND EVIDENCE CONSOLIDATION\\n\",\"# ============================================================\\n\",\"\\n\",\"import os\\n\",\"import sys\\n\",\"import json\\n\",\"import platform\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"import scipy\\n\",\"import matplotlib\\n\",\"import torch\\n\",\"import torchvision\\n\",\"\\n\",\"from pathlib import Path\\n\",\"from importlib.metadata import version, PackageNotFoundError\\n\",\"\\n\",\"print(\\\"=\\\" * 80)\\n\",\"print(\\\"STEP 17.10.6.1 — EXPERIMENTAL CONFIGURATION AND EVIDENCE\\\")\\n\",\"print(\\\"=\\\" * 80)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Locate saved experiment files\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"results_dir = Path(\\n\",\"    \\\"/content/drive/MyDrive/Experiment_18_Results\\\"\\n\",\")\\n\",\"\\n\",\"assert results_dir.exists(), \\\"Experiment results directory not found.\\\"\\n\",\"\\n\",\"print(\\\"\\\\n[1] EXPERIMENT RESULTS DIRECTORY\\\")\\n\",\"print(\\\"Directory:\\\", results_dir)\\n\",\"\\n\",\"for file in sorted(results_dir.iterdir()):\\n\",\"    if file.is_file():\\n\",\"        print(\\n\",\"            f\\\"{file.name} | \\\"\\n\",\"            f\\\"{file.stat().st_size / 1024:.2f} KB\\\"\\n\",\"        )\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Load original embedding extraction evidence\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"embedding_path = (\\n\",\"    results_dir / \\\"experiment18_facenet_lfw_embeddings.npz\\\"\\n\",\")\\n\",\"\\n\",\"assert embedding_path.exists(), \\\"Original embedding NPZ not found.\\\"\\n\",\"\\n\",\"with np.load(embedding_path, allow_pickle=False) as data:\\n\",\"\\n\",\"    extraction_evidence = {}\\n\",\"\\n\",\"    for key in data.files:\\n\",\"        value = data[key]\\n\",\"\\n\",\"        if value.ndim == 0:\\n\",\"            extraction_evidence[key] = value.item()\\n\",\"\\n\",\"        else:\\n\",\"            extraction_evidence[key] = {\\n\",\"                \\\"shape\\\": value.shape,\\n\",\"                \\\"dtype\\\": str(value.dtype),\\n\",\"                \\\"finite\\\": (\\n\",\"                    bool(np.isfinite(value).all())\\n\",\"                    if np.issubdtype(value.dtype, np.number)\\n\",\"                    else \\\"N/A\\\"\\n\",\"                )\\n\",\"            }\\n\",\"\\n\",\"assert \\\"evaluation_embeddings\\\" in extraction_evidence, (\\n\",\"    \\\"Evaluation embeddings evidence is missing.\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n[2] ORIGINAL EMBEDDING EXTRACTION EVIDENCE\\\")\\n\",\"\\n\",\"for key, value in extraction_evidence.items():\\n\",\"    print(f\\\"{key}: {value}\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Load controlled illumination metadata\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"metadata_path = results_dir / \\\"illumination_metadata.json\\\"\\n\",\"\\n\",\"assert metadata_path.exists(), \\\"Illumination metadata not found.\\\"\\n\",\"\\n\",\"with open(metadata_path, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    illumination_metadata = json.load(f)\\n\",\"\\n\",\"print(\\\"\\\\n[3] CONTROLLED ILLUMINATION CONFIGURATION\\\")\\n\",\"\\n\",\"for key, value in illumination_metadata.items():\\n\",\"    print(f\\\"{key}: {value}\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Consolidate dataset and cohort characteristics\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"illumination_npz_path = (\\n\",\"    results_dir / \\\"experiment18_illumination_results.npz\\\"\\n\",\")\\n\",\"\\n\",\"assert illumination_npz_path.exists(), (\\n\",\"    \\\"Illumination results NPZ not found.\\\"\\n\",\")\\n\",\"\\n\",\"with np.load(\\n\",\"    illumination_npz_path,\\n\",\"    allow_pickle=False\\n\",\") as data:\\n\",\"\\n\",\"    original = data[\\\"original_embeddings\\\"].copy()\\n\",\"    low = data[\\\"low_illumination_embeddings\\\"].copy()\\n\",\"    high = data[\\\"high_illumination_embeddings\\\"].copy()\\n\",\"    labels = data[\\\"paired_labels\\\"].copy()\\n\",\"\\n\",\"    low_success = data[\\\"low_success\\\"].copy()\\n\",\"    high_success = data[\\\"high_success\\\"].copy()\\n\",\"\\n\",\"    low_failures = data[\\\"low_failures\\\"].copy()\\n\",\"    high_failures = data[\\\"high_failures\\\"].copy()\\n\",\"\\n\",\"\\n\",\"# Basic data integrity checks\\n\",\"assert original.shape == low.shape == high.shape, (\\n\",\"    \\\"Original, low and high embedding shapes do not match.\\\"\\n\",\")\\n\",\"\\n\",\"assert original.ndim == 2, (\\n\",\"    \\\"Embedding arrays must be two-dimensional.\\\"\\n\",\")\\n\",\"\\n\",\"assert len(labels) == original.shape[0], (\\n\",\"    \\\"Paired labels do not match the embedding count.\\\"\\n\",\")\\n\",\"\\n\",\"assert np.isfinite(original).all(), (\\n\",\"    \\\"Original embeddings contain non-finite values.\\\"\\n\",\")\\n\",\"\\n\",\"assert np.isfinite(low).all(), (\\n\",\"    \\\"Low illumination embeddings contain non-finite values.\\\"\\n\",\")\\n\",\"\\n\",\"assert np.isfinite(high).all(), (\\n\",\"    \\\"High illumination embeddings contain non-finite values.\\\"\\n\",\")\\n\",\"\\n\",\"identity_counts = (\\n\",\"    pd.Series(labels)\\n\",\"    .value_counts()\\n\",\"    .sort_index()\\n\",\")\\n\",\"\\n\",\"full_evaluation_count = (\\n\",\"    extraction_evidence[\\\"evaluation_embeddings\\\"][\\\"shape\\\"][0]\\n\",\")\\n\",\"\\n\",\"paired_image_count = len(labels)\\n\",\"identity_count = len(np.unique(labels))\\n\",\"embedding_dimension = original.shape[1]\\n\",\"\\n\",\"cohort_summary = pd.DataFrame([\\n\",\"    {\\n\",\"        \\\"Metric\\\": \\\"Original evaluation embeddings (full archive)\\\",\\n\",\"        \\\"Value\\\": full_evaluation_count\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Metric\\\": \\\"Paired illumination images (historical cohort)\\\",\\n\",\"        \\\"Value\\\": paired_image_count\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Metric\\\": \\\"Corrected detector evaluation cohort (images)\\\",\\n\",\"        \\\"Value\\\": 229\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Metric\\\": \\\"Embedding dimension\\\",\\n\",\"        \\\"Value\\\": embedding_dimension\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Metric\\\": \\\"Identities in paired illumination cohort\\\",\\n\",\"        \\\"Value\\\": identity_count\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Metric\\\": \\\"Low illumination successful detections (full archive)\\\",\\n\",\"        \\\"Value\\\": len(low_success)\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Metric\\\": \\\"High illumination successful detections (full archive)\\\",\\n\",\"        \\\"Value\\\": len(high_success)\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Metric\\\": \\\"Low illumination failures (full archive)\\\",\\n\",\"        \\\"Value\\\": len(low_failures)\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Metric\\\": \\\"High illumination failures (full archive)\\\",\\n\",\"        \\\"Value\\\": len(high_failures)\\n\",\"    }\\n\",\"])\\n\",\"\\n\",\"print(\\\"\\\\n[4] DATASET AND COHORT SUMMARY\\\")\\n\",\"display(cohort_summary)\\n\",\"\\n\",\"print(\\\"\\\\nIDENTITY DISTRIBUTION\\\")\\n\",\"\\n\",\"identity_distribution = (\\n\",\"    identity_counts\\n\",\"    .rename(\\\"Image_Count\\\")\\n\",\"    .reset_index()\\n\",\")\\n\",\"\\n\",\"identity_distribution.columns = [\\n\",\"    \\\"Identity\\\",\\n\",\"    \\\"Image_Count\\\"\\n\",\"]\\n\",\"\\n\",\"display(identity_distribution)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Record software environment\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[5] SOFTWARE AND EXECUTION ENVIRONMENT\\\")\\n\",\"\\n\",\"environment = {\\n\",\"    \\\"Python\\\": sys.version.split()[0],\\n\",\"    \\\"Platform\\\": platform.platform(),\\n\",\"    \\\"NumPy\\\": np.__version__,\\n\",\"    \\\"Pandas\\\": pd.__version__,\\n\",\"    \\\"SciPy\\\": scipy.__version__,\\n\",\"    \\\"Matplotlib\\\": matplotlib.__version__,\\n\",\"    \\\"PyTorch\\\": torch.__version__,\\n\",\"    \\\"Torchvision\\\": torchvision.__version__\\n\",\"}\\n\",\"\\n\",\"for package in [\\n\",\"    \\\"facenet-pytorch\\\",\\n\",\"    \\\"scikit-learn\\\",\\n\",\"    \\\"Pillow\\\"\\n\",\"]:\\n\",\"    try:\\n\",\"        environment[package] = version(package)\\n\",\"\\n\",\"    except PackageNotFoundError:\\n\",\"        environment[package] = \\\"Not installed or unavailable\\\"\\n\",\"\\n\",\"for key, value in environment.items():\\n\",\"    print(f\\\"{key}: {value}\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. Consolidate detector analysis evidence\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[6] DETECTOR ANALYSIS EVIDENCE\\\")\\n\",\"\\n\",\"detector_table_names = [\\n\",\"    \\\"evaluation_detector_df\\\",\\n\",\"    \\\"identity_detector_df\\\",\\n\",\"    \\\"statistical_results\\\",\\n\",\"    \\\"effect_size_df\\\"\\n\",\"]\\n\",\"\\n\",\"detector_tables_available = {}\\n\",\"\\n\",\"for table_name in detector_table_names:\\n\",\"\\n\",\"    if table_name in globals():\\n\",\"\\n\",\"        table = globals()[table_name]\\n\",\"\\n\",\"        if isinstance(table, pd.DataFrame):\\n\",\"\\n\",\"            detector_tables_available[table_name] = True\\n\",\"\\n\",\"            print(f\\\"\\\\n{table_name}\\\")\\n\",\"            print(\\\"Rows:\\\", len(table))\\n\",\"            print(\\\"Columns:\\\", table.columns.tolist())\\n\",\"\\n\",\"            display(table)\\n\",\"\\n\",\"        else:\\n\",\"            detector_tables_available[table_name] = False\\n\",\"            print(f\\\"{table_name}: AVAILABLE BUT NOT A DATAFRAME\\\")\\n\",\"\\n\",\"    else:\\n\",\"        detector_tables_available[table_name] = False\\n\",\"        print(f\\\"{table_name}: NOT AVAILABLE IN CURRENT SESSION\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. Record independently verified illumination statistics\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"verified_illumination_results = pd.DataFrame([\\n\",\"    {\\n\",\"        \\\"Analysis\\\": \\\"Image-level displacement\\\",\\n\",\"        \\\"Observations\\\": 889,\\n\",\"        \\\"Wilcoxon Statistic\\\": 52705.0,\\n\",\"        \\\"P-value\\\": 4.708938281282196e-80,\\n\",\"        \\\"Verification\\\": \\\"Independently reproduced\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Analysis\\\": \\\"Mean-based identity displacement\\\",\\n\",\"        \\\"Observations\\\": 13,\\n\",\"        \\\"Wilcoxon Statistic\\\": 3.0,\\n\",\"        \\\"P-value\\\": 0.001220703125,\\n\",\"        \\\"Verification\\\": \\\"Independently reproduced\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Analysis\\\": \\\"Median-based identity displacement\\\",\\n\",\"        \\\"Observations\\\": 13,\\n\",\"        \\\"Wilcoxon Statistic\\\": 3.0,\\n\",\"        \\\"P-value\\\": 0.001220703125,\\n\",\"        \\\"Verification\\\": \\\"Separately recalculated\\\"\\n\",\"    }\\n\",\"])\\n\",\"\\n\",\"print(\\\"\\\\n[7] VERIFIED ILLUMINATION STATISTICAL RESULTS\\\")\\n\",\"display(verified_illumination_results)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 8. Record reproducibility audit status\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"reproducibility_audit = pd.DataFrame([\\n\",\"    {\\n\",\"        \\\"Audit\\\": \\\"Step 17.10.4 — Saved results verification\\\",\\n\",\"        \\\"Status\\\": \\\"Completed\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Audit\\\": \\\"Step 17.10.5.1 — Saved data integrity\\\",\\n\",\"        \\\"Status\\\": \\\"Passed\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Audit\\\": \\\"Step 17.10.5.2 — Displacement reproduction\\\",\\n\",\"        \\\"Status\\\": \\\"Passed\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Audit\\\": \\\"Step 17.10.5.3 — Image-level statistical reproduction\\\",\\n\",\"        \\\"Status\\\": \\\"Passed\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Audit\\\": \\\"Step 17.10.5.4 — Identity-level statistical reproduction\\\",\\n\",\"        \\\"Status\\\": \\\"Passed\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Audit\\\": \\\"Step 17.10.5.5 — Identity CSV verification\\\",\\n\",\"        \\\"Status\\\": \\\"Passed\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Audit\\\": \\\"Step 17.10.5.6 — Final consistency audit\\\",\\n\",\"        \\\"Status\\\": \\\"Passed\\\"\\n\",\"    }\\n\",\"])\\n\",\"\\n\",\"print(\\\"\\\\n[8] REPRODUCIBILITY AUDIT RECORD\\\")\\n\",\"display(reproducibility_audit)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 9. Final evidence summary\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n\",\"print(\\\"STEP 17.10.6.1 — EVIDENCE CONSOLIDATION SUMMARY\\\")\\n\",\"print(\\\"=\\\" * 80)\\n\",\"\\n\",\"print(\\\"Saved experiment directory: VERIFIED\\\")\\n\",\"print\\n\",\"\\n\",\"---------------------------------------------------------------------------\\n\",\"CELL 133 | TYPE: code\\n\",\"Matched terms: brightness\\n\",\"---------------------------------------------------------------------------\\n\",\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 18 — STEP 17.10.6.2\\n\",\"# RESEARCH FINDINGS CONSOLIDATION — FINAL CORRECTED VERSION\\n\",\"# ============================================================\\n\",\"\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"\\n\",\"print(\\\"=\\\" * 80)\\n\",\"print(\\\"STEP 17.10.6.2 — RESEARCH FINDINGS CONSOLIDATION\\\")\\n\",\"print(\\\"=\\\" * 80)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Verify existing analysis tables\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"required_tables = [\\n\",\"    \\\"evaluation_detector_df\\\",\\n\",\"    \\\"identity_detector_df\\\",\\n\",\"    \\\"statistical_results\\\",\\n\",\"    \\\"effect_size_df\\\"\\n\",\"]\\n\",\"\\n\",\"for name in required_tables:\\n\",\"    assert name in globals(), f\\\"Missing table: {name}\\\"\\n\",\"    assert isinstance(globals()[name], pd.DataFrame)\\n\",\"\\n\",\"print(\\\"\\\\n[1] EXISTING ANALYSIS TABLES\\\")\\n\",\"\\n\",\"for name in required_tables:\\n\",\"    print(f\\\"{name}: AVAILABLE | Rows: {len(globals()[name])}\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Aggregate detector response comparison\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[2] AGGREGATE DETECTOR RESPONSE\\\")\\n\",\"\\n\",\"aggregate_findings = evaluation_detector_df.copy()\\n\",\"\\n\",\"display(aggregate_findings)\\n\",\"\\n\",\"original = aggregate_findings.loc[\\n\",\"    aggregate_findings[\\\"Condition\\\"] == \\\"Original\\\"\\n\",\"].iloc[0]\\n\",\"\\n\",\"low = aggregate_findings.loc[\\n\",\"    aggregate_findings[\\\"Condition\\\"] == \\\"Low illumination\\\"\\n\",\"].iloc[0]\\n\",\"\\n\",\"high = aggregate_findings.loc[\\n\",\"    aggregate_findings[\\\"Condition\\\"] == \\\"High illumination\\\"\\n\",\"].iloc[0]\\n\",\"\\n\",\"aggregate_records = []\\n\",\"\\n\",\"for detector in [\\\"Euclidean\\\", \\\"Mahalanobis\\\"]:\\n\",\"\\n\",\"    original_value = float(original[detector])\\n\",\"    low_value = float(low[detector])\\n\",\"    high_value = float(high[detector])\\n\",\"\\n\",\"    aggregate_records.append({\\n\",\"        \\\"Detector\\\": detector,\\n\",\"        \\\"Original\\\": original_value,\\n\",\"        \\\"Low Illumination\\\": low_value,\\n\",\"        \\\"High Illumination\\\": high_value,\\n\",\"        \\\"Low Change (%)\\\": (\\n\",\"            (low_value - original_value) / original_value * 100\\n\",\"        ),\\n\",\"        \\\"High Change (%)\\\": (\\n\",\"            (high_value - original_value) / original_value * 100\\n\",\"        )\\n\",\"    })\\n\",\"\\n\",\"aggregate_comparison = pd.DataFrame(aggregate_records)\\n\",\"\\n\",\"print(\\\"\\\\nAGGREGATE COMPARISON\\\")\\n\",\"display(aggregate_comparison)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Identity-level response direction\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[3] IDENTITY-LEVEL RESPONSE ANALYSIS\\\")\\n\",\"\\n\",\"identity_pivot = identity_detector_df.pivot(\\n\",\"    index=\\\"Identity\\\",\\n\",\"    columns=\\\"Condition\\\",\\n\",\"    values=[\\\"Euclidean\\\", \\\"Mahalanobis\\\"]\\n\",\")\\n\",\"\\n\",\"identity_direction_records = []\\n\",\"\\n\",\"for detector in [\\\"Euclidean\\\", \\\"Mahalanobis\\\"]:\\n\",\"\\n\",\"    low_values = identity_pivot[\\n\",\"        (detector, \\\"Low illumination\\\")\\n\",\"    ]\\n\",\"\\n\",\"    high_values = identity_pivot[\\n\",\"        (detector, \\\"High illumination\\\")\\n\",\"    ]\\n\",\"\\n\",\"    differences = high_values - low_values\\n\",\"\\n\",\"    identity_direction_records.append({\\n\",\"        \\\"Detector\\\": detector,\\n\",\"        \\\"Identities\\\": len(differences),\\n\",\"        \\\"Higher Under High Illumination\\\": int(\\n\",\"            (differences > 0).sum()\\n\",\"        ),\\n\",\"        \\\"Lower Under High Illumination\\\": int(\\n\",\"            (differences < 0).sum()\\n\",\"        ),\\n\",\"        \\\"Unchanged\\\": int(\\n\",\"            (differences == 0).sum()\\n\",\"        ),\\n\",\"        \\\"Mean Difference\\\": differences.mean(),\\n\",\"        \\\"Median Difference\\\": differences.median()\\n\",\"    })\\n\",\"\\n\",\"identity_direction_summary = pd.DataFrame(\\n\",\"    identity_direction_records\\n\",\")\\n\",\"\\n\",\"display(identity_direction_summary)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Corrected paired statistical results\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[4] CORRECTED PAIRED STATISTICAL RESULTS\\\")\\n\",\"\\n\",\"statistical_findings = statistical_results.copy()\\n\",\"effect_size_findings = effect_size_df.copy()\\n\",\"\\n\",\"# Validate actual detector names\\n\",\"expected_detectors = {\\\"Euclidean\\\", \\\"Mahalanobis\\\"}\\n\",\"\\n\",\"assert set(statistical_findings[\\\"Detector\\\"]) == expected_detectors\\n\",\"assert set(effect_size_findings[\\\"Detector\\\"]) == expected_detectors\\n\",\"\\n\",\"# Validate corrected results\\n\",\"expected_p_values = {\\n\",\"    \\\"Euclidean\\\": 0.021484,\\n\",\"    \\\"Mahalanobis\\\": 0.002441\\n\",\"}\\n\",\"\\n\",\"expected_statistics = {\\n\",\"    \\\"Euclidean\\\": 13.0,\\n\",\"    \\\"Mahalanobis\\\": 5.0\\n\",\"}\\n\",\"\\n\",\"for detector in expected_detectors:\\n\",\"\\n\",\"    row = statistical_findings.loc[\\n\",\"        statistical_findings[\\\"Detector\\\"] == detector\\n\",\"    ].iloc[0]\\n\",\"\\n\",\"    assert np.isclose(\\n\",\"        float(row[\\\"P-value\\\"]),\\n\",\"        expected_p_values[detector],\\n\",\"        atol=1e-6\\n\",\"    ), f\\\"{detector} p-value mismatch.\\\"\\n\",\"\\n\",\"    assert np.isclose(\\n\",\"        float(row[\\\"Wilcoxon Statistic\\\"]),\\n\",\"        expected_statistics[detector]\\n\",\"    ), f\\\"{detector} Wilcoxon statistic mismatch.\\\"\\n\",\"\\n\",\"print(\\\"Corrected statistical results verified:\\\")\\n\",\"display(statistical_findings)\\n\",\"\\n\",\"print(\\\"\\\\nExisting effect-size results:\\\")\\n\",\"display(effect_size_findings)\\n\",\"\\n\",\"significance_summary = statistical_findings.copy()\\n\",\"\\n\",\"significance_summary[\\\"Nominal Significance\\\"] = (\\n\",\"    significance_summary[\\\"P-value\\\"] < 0.05\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\nNOMINAL SIGNIFICANCE ASSESSMENT (alpha = 0.05)\\\")\\n\",\"display(significance_summary)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Historical controlled illumination displacement\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[5] CONTROLLED ILLUMINATION DISPLACEMENT\\\")\\n\",\"\\n\",\"illumination_findings = pd.DataFrame([\\n\",\"    {\\n\",\"        \\\"Condition\\\": \\\"Low illumination\\\",\\n\",\"        \\\"Mean Displacement\\\": 0.23466530442237854,\\n\",\"        \\\"Median Displacement\\\": 0.222675,\\n\",\"        \\\"Image-Level Observations\\\": 889\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Condition\\\": \\\"High illumination\\\",\\n\",\"        \\\"Mean Displacement\\\": 0.3185139298439026,\\n\",\"        \\\"Median Displacement\\\": 0.306734,\\n\",\"        \\\"Image-Level Observations\\\": 889\\n\",\"    }\\n\",\"])\\n\",\"\\n\",\"display(illumination_findings)\\n\",\"\\n\",\"print(\\n\",\"    \\\"Historical image-level Wilcoxon p-value:\\\",\\n\",\"    4.708938281282196e-80\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"Historical mean-based identity Wilcoxon p-value:\\\",\\n\",\"    0.001220703125\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"Historical median-based identity Wilcoxon p-value:\\\",\\n\",\"    0.001220703125\\n\",\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. Research findings\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[6] RESEARCH FINDINGS\\\")\\n\",\"\\n\",\"findings = [\\n\",\"    \\\"Aggregate Euclidean and Mahalanobis responses vary across illumination conditions.\\\",\\n\",\"    \\\"Euclidean aggregate response is highest under low illumination.\\\",\\n\",\"    \\\"Mahalanobis aggregate response is highest under high illumination.\\\",\\n\",\"    \\\"Identity-level detector responses vary across the 13 evaluated identities.\\\",\\n\",\"    \\\"Corrected Euclidean Wilcoxon statistic = 13.0, p = 0.021484.\\\",\\n\",\"    \\\"Corrected Mahalanobis Wilcoxon statistic = 5.0, p = 0.002441.\\\",\\n\",\"    \\\"Both corrected detector-response tests are below the nominal 0.05 threshold.\\\",\\n\",\"    \\\"Historical illumination displacement is higher under high illumination.\\\",\\n\",\"    \\\"Historical illumination displacement statistics were independently reproduced.\\\"\\n\",\"]\\n\",\"\\n\",\"for i, finding in enumerate(findings, 1):\\n\",\"    print(f\\\"{i}. {finding}\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. Methodological limitations\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[7] METHODOLOGICAL LIMITATIONS\\\")\\n\",\"\\n\",\"limitations = [\\n\",\"    \\\"The corrected detector evaluation cohort contains 229 images from 13 identities.\\\",\\n\",\"    \\\"The historical paired illumination analysis contains 889 images from the same 13 identities.\\\",\\n\",\"    \\\"Identity image counts are highly imbalanced.\\\",\\n\",\"    \\\"Identity 14 contributes 504 of the 889 historical paired images.\\\",\\n\",\"    \\\"Image observations are clustered within identities.\\\",\\n\",\"    \\\"The corrected detector-response tests use only 13 identity-level observations.\\\",\\n\",\"    \\\"The detector-response p-values are nominal and are not adjusted for multiple comparisons.\\\",\\n\",\"    \\\"Controlled brightness transformations do not represent all natural illumination changes.\\\",\\n\",\"    \\\"Embedding displacement does not directly measure recognition accuracy.\\\",\\n\",\"    \\\"The results do not establish biometric fairness or deployment readiness.\\\",\\n\",\"    \\\"Detector-response tests and illumination-displacement tests are separate analyses.\\\"\\n\",\"]\\n\",\"\\n\",\"for i, limitation in enumerate(limitations, 1):\\n\",\"    print(f\\\"{i}. {limitation}\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 8. Final consolidation status\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n\",\"print(\\\"STEP 17.10.6.2 — CONSOLIDATION SUMMARY\\\")\\n\",\"print(\\\"=\\\" * 80)\\n\",\"\\n\",\"print(\\\"Aggregate detector findings: CONSOLIDATED\\\")\\n\",\"print(\\\"Identity-level response findings: CONSOLIDATED\\\")\\n\",\"print(\\\"Corrected paired statistical results: VERIFIED\\\")\\n\",\"print(\\\"Effect sizes and confidence intervals: VERIFIED\\\")\\n\",\"print(\\\"Historical illumination displacement findings: VERIFIED\\\")\\n\",\"print(\\\"Methodological limitations: DOCUMENTED\\\")\\n\",\"\\n\",\"print(\\\"\\\\nCorrected Euclidean p-value: 0.021484\\\")\\n\",\"print(\\\"Corrected Mahalanobis p-value: 0.002441\\\")\\n\",\"\\n\",\"print(\\\"\\\\nNo new experiments performed.\\\")\\n\",\"print(\\\"No saved files modified.\\\")\\n\",\"print(\\\"No embedding extraction performed.\\\")\\n\",\"\\n\",\"print(\\\"\\\\nSTEP 17.10.6.2 COMPLETED\\\")\\n\",\"print(\\\"=\\\" * 80)\\n\",\"\\n\",\"\\n\",\"---------------------------------------------------------------------------\\n\",\"CELL 136 | TYPE: code\\n\",\"Matched terms: brightness\\n\",\"---------------------------------------------------------------------------\\n\",\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 18 — STEP 17.10.6.3\\n\",\"# RESEARCH DISCUSSION AND INTERPRETATION\\n\",\"# ============================================================\\n\",\"\\n\",\"import pandas as pd\\n\",\"import numpy as np\\n\",\"\\n\",\"print(\\\"=\\\" * 80)\\n\",\"print(\\\"STEP 17.10.6.3 — RESEARCH DISCUSSION AND INTERPRETATION\\\")\\n\",\"print(\\\"=\\\" * 80)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Interpret aggregate detector behaviour\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[1] AGGREGATE DETECTOR BEHAVIOUR\\\")\\n\",\"\\n\",\"for _, row in aggregate_comparison.iterrows():\\n\",\"\\n\",\"    print(f\\\"\\\\nDetector: {row['Detector']}\\\")\\n\",\"    print(f\\\"Original response: {row['Original']:.6f}\\\")\\n\",\"    print(f\\\"Low illumination response: {row['Low Illumination']:.6f}\\\")\\n\",\"    print(f\\\"High illumination response: {row['High Illumination']:.6f}\\\")\\n\",\"    print(f\\\"Change under low illumination: {row['Low Change (%)']:.2f}%\\\")\\n\",\"    print(f\\\"Change under high illumination: {row['High Change (%)']:.2f}%\\\")\\n\",\"\\n\",\"    if row[\\\"Low Illumination\\\"] > row[\\\"High Illumination\\\"]:\\n\",\"        print(\\\"Interpretation: Aggregate response is higher under low illumination.\\\")\\n\",\"    else:\\n\",\"        print(\\\"Interpretation: Aggregate response is higher under high illumination.\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Interpret identity-level variation\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[2] IDENTITY-LEVEL VARIATION\\\")\\n\",\"\\n\",\"display(identity_direction_summary)\\n\",\"\\n\",\"for _, row in identity_direction_summary.iterrows():\\n\",\"\\n\",\"    print(f\\\"\\\\n{row['Detector']} detector:\\\")\\n\",\"\\n\",\"    print(\\n\",\"        f\\\"Response increased for \\\"\\n\",\"        f\\\"{row['Higher Under High Illumination']} of \\\"\\n\",\"        f\\\"{row['Identities']} identities under high versus low illumination.\\\"\\n\",\"    )\\n\",\"\\n\",\"    print(\\n\",\"        f\\\"Response decreased for \\\"\\n\",\"        f\\\"{row['Lower Under High Illumination']} identities.\\\"\\n\",\"    )\\n\",\"\\n\",\"print(\\n\",\"    \\\"\\\\nInterpretation: Aggregate detector responses conceal \\\"\\n\",\"    \\\"identity-specific variation.\\\"\\n\",\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Interpret corrected statistical evidence and effect sizes\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[3] CORRECTED STATISTICAL EVIDENCE\\\")\\n\",\"\\n\",\"display(statistical_results)\\n\",\"display(effect_size_df)\\n\",\"\\n\",\"for _, row in statistical_results.iterrows():\\n\",\"\\n\",\"    detector = row[\\\"Detector\\\"]\\n\",\"\\n\",\"    effect_row = effect_size_df.loc[\\n\",\"        effect_size_df[\\\"Detector\\\"] == detector\\n\",\"    ].iloc[0]\\n\",\"\\n\",\"    p_value = float(row[\\\"P-value\\\"])\\n\",\"    statistic = float(row[\\\"Wilcoxon Statistic\\\"])\\n\",\"    cohens_dz = float(effect_row[\\\"Cohen's dz\\\"])\\n\",\"    rank_biserial = float(\\n\",\"        effect_row[\\\"Rank-Biserial Correlation\\\"]\\n\",\"    )\\n\",\"\\n\",\"    print(f\\\"\\\\nDetector: {detector}\\\")\\n\",\"    print(f\\\"Wilcoxon statistic: {statistic:.1f}\\\")\\n\",\"    print(f\\\"Wilcoxon p-value: {p_value:.6f}\\\")\\n\",\"    print(f\\\"Cohen's dz: {cohens_dz:.6f}\\\")\\n\",\"    print(f\\\"Rank-biserial correlation: {rank_biserial:.6f}\\\")\\n\",\"\\n\",\"    print(\\n\",\"        f\\\"Mean difference: \\\"\\n\",\"        f\\\"{effect_row['Mean Difference']:.6f}\\\"\\n\",\"    )\\n\",\"\\n\",\"    print(\\n\",\"        f\\\"Median difference: \\\"\\n\",\"        f\\\"{effect_row['Median Difference']:.6f}\\\"\\n\",\"    )\\n\",\"\\n\",\"    print(\\n\",\"        f\\\"Mean confidence interval: \\\"\\n\",\"        f\\\"[{effect_row['Mean CI Lower']:.6f}, \\\"\\n\",\"        f\\\"{effect_row['Mean CI Upper']:.6f}]\\\"\\n\",\"    )\\n\",\"\\n\",\"    print(\\n\",\"        f\\\"Median confidence interval: \\\"\\n\",\"        f\\\"[{effect_row['Median CI Lower']:.6f}, \\\"\\n\",\"        f\\\"{effect_row['Median CI Upper']:.6f}]\\\"\\n\",\"    )\\n\",\"\\n\",\"    if p_value < 0.05:\\n\",\"        print(\\\"Result: Below the nominal alpha = 0.05 threshold.\\\")\\n\",\"    else:\\n\",\"        print(\\\"Result: Not below the nominal alpha = 0.05 threshold.\\\")\\n\",\"\\n\",\"    if (\\n\",\"        effect_row[\\\"Median CI Lower\\\"] <= 0\\n\",\"        <= effect_row[\\\"Median CI Upper\\\"]\\n\",\"    ):\\n\",\"        print(\\\"Median confidence interval includes zero.\\\")\\n\",\"    else:\\n\",\"        print(\\\"Median confidence interval excludes zero.\\\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"\\\\nInterpretation: Both corrected detector-response tests \\\"\\n\",\"    \\\"are below the nominal 0.05 threshold. These results are \\\"\\n\",\"    \\\"exploratory because only 13 identities were evaluated, \\\"\\n\",\"    \\\"and no multiple-comparison adjustment was applied.\\\"\\n\",\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Compare embedding displacement and detector response\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[4] EMBEDDING DISPLACEMENT VERSUS DETECTOR RESPONSE\\\")\\n\",\"\\n\",\"low_displacement_mean = 0.23466530442237854\\n\",\"high_displacement_mean = 0.3185139298439026\\n\",\"\\n\",\"print(f\\\"Mean low-illumination displacement: {low_displacement_mean:.6f}\\\")\\n\",\"print(f\\\"Mean high-illumination displacement: {high_displacement_mean:.6f}\\\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"\\\\nThe independently verified displacement analysis indicates \\\"\\n\",\"    \\\"greater average embedding displacement under high illumination \\\"\\n\",\"    \\\"than under low illumination.\\\"\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"Detector responses do not follow an identical aggregate pattern: \\\"\\n\",\"    \\\"Euclidean response is higher under low illumination, whereas \\\"\\n\",\"    \\\"Mahalanobis response is higher under high illumination.\\\"\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"Embedding displacement and detector response are distinct \\\"\\n\",\"    \\\"measurements and should not be treated as interchangeable.\\\"\\n\",\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Implications for biometric drift monitoring\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[5] IMPLICATIONS FOR BIOMETRIC DRIFT MONITORING\\\")\\n\",\"\\n\",\"implications = [\\n\",\"    \\\"A single aggregate detector score may conceal identity-level variation.\\\",\\n\",\"    \\\"Different distance metrics can respond differently to the same controlled transformation.\\\",\\n\",\"    \\\"Embedding displacement can provide evidence of representation change.\\\",\\n\",\"    \\\"Detector thresholds and responses require validation across identities and conditions.\\\",\\n\",\"    \\\"Monitoring systems should account for identity-level heterogeneity.\\\",\\n\",\"    \\\"Further testing is needed before drawing conclusions about real-world biometric performance.\\\"\\n\",\"]\\n\",\"\\n\",\"for index, statement in enumerate(implications, start=1):\\n\",\"    print(f\\\"{index}. {statement}\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. Threats to validity\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[6] THREATS TO VALIDITY\\\")\\n\",\"\\n\",\"threats = [\\n\",\"    \\\"The corrected detector evaluation cohort contains 229 images from 13 identities.\\\",\\n\",\"    \\\"The historical paired illumination displacement cohort contains 889 images from 13 identities.\\\",\\n\",\"    \\\"Identity 14 contributes 504 of the 889 historical paired observations.\\\",\\n\",\"    \\\"Image observations are clustered within identities and are not independent subjects.\\\",\\n\",\"    \\\"Only controlled brightness factors of 0.5 and 1.5 were evaluated against the original condition.\\\",\\n\",\"    \\\"The experiment does not establish robustness under all real-world illumination changes.\\\",\\n\",\"    \\\"The detector-response tests use only 13 identity-level observations.\\\",\\n\",\"    \\\"The detector-response p-values are nominal and have not been adjusted for multiple comparisons.\\\",\\n\",\"    \\\"Embedding displacement is not equivalent to false acceptance, false rejection, or recognition accuracy.\\\",\\n\",\"    \\\"Fairness and deployment performance were not directly evaluated.\\\"\\n\",\"]\\n\",\"\\n\",\"for index, threat in enumerate(threats, start=1):\\n\",\"    print(f\\\"{index}. {threat}\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. Separate demonstrated findings from future hypotheses\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[7] EVIDENCE CLASSIFICATION\\\")\\n\",\"\\n\",\"evidence_classification = pd.DataFrame([\\n\",\"    {\\n\",\"        \\\"Statement\\\": \\\"High illumination produced greater mean embedding displacement than low illumination.\\\",\\n\",\"        \\\"Evidence Status\\\": \\\"Demonstrated in this controlled cohort\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Statement\\\": \\\"Detector responses varied across illumination conditions.\\\",\\n\",\"        \\\"Evidence Status\\\": \\\"Observed in aggregate results\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Statement\\\": \\\"Identity-level detector responses were heterogeneous.\\\",\\n\",\"        \\\"Evidence Status\\\": \\\"Observed across 13 identities\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Statement\\\": \\\"Both corrected paired detector-response tests were below the nominal 0.05 threshold.\\\",\\n\",\"        \\\"Evidence Status\\\": \\\"Supported by corrected identity-level tests\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Statement\\\": \\\"The detector findings establish population-level generalisation.\\\",\\n\",\"        \\\"Evidence Status\\\": \\\"Not established\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Statement\\\": \\\"The findings establish real-world biometric recognition degradation.\\\",\\n\",\"        \\\"Evidence Status\\\": \\\"Not established\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Statement\\\": \\\"Identity-aware drift monitoring may be worth investigating.\\\",\\n\",\"        \\\"Evidence Status\\\": \\\"Future research direction\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Statement\\\": \\\"The observed patterns generalise to other biometric datasets and models.\\\",\\n\",\"        \\\"Evidence Status\\\": \\\"Not established\\\"\\n\",\"    }\\n\",\"])\\n\",\"\\n\",\"display(evidence_classification)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 8. Final discussion summary\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[8] FINAL RESEARCH DISCUSSION\\\")\\n\",\"\\n\",\"discussion_summary = \\\"\\\"\\\"\\n\",\"The controlled illumination experiment demonstrates that changes in\\n\",\"image brightness are associated with measurable changes in facial\\n\",\"embedding representations within the evaluated LFW cohort.\\n\",\"\\n\",\"Mean embedding displacement was greater under high illumination\\n\",\"than under low illumination. However, aggregate Euclidean and\\n\",\"Mahalanobis detector responses exhibited different patterns across\\n\",\"the two illumination conditions.\\n\",\"\\n\",\"Identity-level analysis demonstrated heterogeneous detector\\n\",\"responses. This indicates that aggregate measurements alone may\\n\",\"not adequately represent variation across identities.\\n\",\"\\n\",\"The corrected paired detector-response tests produced nominal\\n\",\"p-values below 0.05 for both Euclidean and Mahalanobis detectors.\\n\",\"These results provide exploratory identity-level statistical\\n\",\"evidence, but they are based on only 13 identities and have not\\n\",\"been adjusted for multiple comparisons.\\n\",\"\\n\",\"The experiment supports further investigation of identity-aware\\n\",\"embedding drift monitoring. It does not e\\n\",\"\\n\",\"---------------------------------------------------------------------------\\n\",\"CELL 138 | TYPE: code\\n\",\"Matched terms: common_positions, original_embeddings, low_illumination_embeddings, high_illumination_embeddings, paired_labels, low_success, high_success\\n\",\"---------------------------------------------------------------------------\\n\",\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 18 — STEP 17.10.6.4\\n\",\"# RESEARCH DOCUMENTATION AND REPRODUCIBILITY AUDIT\\n\",\"# ============================================================\\n\",\"\\n\",\"import os\\n\",\"import json\\n\",\"import platform\\n\",\"import importlib.metadata as package_metadata\\n\",\"\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"import scipy\\n\",\"from scipy.stats import wilcoxon\\n\",\"\\n\",\"print(\\\"=\\\" * 85)\\n\",\"print(\\\"STEP 17.10.6.4 — RESEARCH DOCUMENTATION AND REPRODUCIBILITY AUDIT\\\")\\n\",\"print(\\\"=\\\" * 85)\\n\",\"\\n\",\"audit_results = []\\n\",\"\\n\",\"def record_audit(name, passed, details=\\\"\\\"):\\n\",\"    status = \\\"PASSED\\\" if passed else \\\"FAILED\\\"\\n\",\"    audit_results.append({\\n\",\"        \\\"Audit\\\": name,\\n\",\"        \\\"Status\\\": status,\\n\",\"        \\\"Details\\\": details\\n\",\"    })\\n\",\"    print(f\\\"[{status}] {name}\\\")\\n\",\"    if details:\\n\",\"        print(f\\\"         {details}\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Verify saved experiment files\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[1] SAVED FILE VERIFICATION\\\")\\n\",\"\\n\",\"experiment_dir = \\\"/content/drive/MyDrive/Experiment_18_Results\\\"\\n\",\"\\n\",\"expected_files = [\\n\",\"    \\\"experiment18_facenet_lfw_embeddings.npz\\\",\\n\",\"    \\\"experiment18_illumination_results.npz\\\",\\n\",\"    \\\"illumination_identity_summary.csv\\\",\\n\",\"    \\\"illumination_metadata.json\\\"\\n\",\"]\\n\",\"\\n\",\"file_paths = {\\n\",\"    filename: os.path.join(experiment_dir, filename)\\n\",\"    for filename in expected_files\\n\",\"}\\n\",\"\\n\",\"for filename, path in file_paths.items():\\n\",\"    exists = os.path.isfile(path)\\n\",\"    record_audit(\\n\",\"        f\\\"File exists: {filename}\\\",\\n\",\"        exists,\\n\",\"        path if exists else \\\"File not found\\\"\\n\",\"    )\\n\",\"\\n\",\"assert all(os.path.isfile(p) for p in file_paths.values()), (\\n\",\"    \\\"One or more required experiment files are missing. \\\"\\n\",\"    \\\"Check the Google Drive directory before continuing.\\\"\\n\",\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Load saved archives and metadata\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[2] ARCHIVE AND METADATA LOADING\\\")\\n\",\"\\n\",\"original_archive = np.load(\\n\",\"    file_paths[\\\"experiment18_facenet_lfw_embeddings.npz\\\"],\\n\",\"    allow_pickle=False\\n\",\")\\n\",\"\\n\",\"illumination_archive = np.load(\\n\",\"    file_paths[\\\"experiment18_illumination_results.npz\\\"],\\n\",\"    allow_pickle=False\\n\",\")\\n\",\"\\n\",\"identity_csv = pd.read_csv(\\n\",\"    file_paths[\\\"illumination_identity_summary.csv\\\"]\\n\",\")\\n\",\"\\n\",\"with open(\\n\",\"    file_paths[\\\"illumination_metadata.json\\\"],\\n\",\"    \\\"r\\\"\\n\",\") as file:\\n\",\"    saved_metadata = json.load(file)\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"Original embedding archive loaded\\\",\\n\",\"    True,\\n\",\"    f\\\"Keys: {list(original_archive.files)}\\\"\\n\",\")\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"Illumination archive loaded\\\",\\n\",\"    True,\\n\",\"    f\\\"Keys: {list(illumination_archive.files)}\\\"\\n\",\")\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"Identity CSV loaded\\\",\\n\",\"    True,\\n\",\"    f\\\"Rows: {len(identity_csv)}\\\"\\n\",\")\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"Metadata JSON loaded\\\",\\n\",\"    True,\\n\",\"    f\\\"Experiment: {saved_metadata.get('experiment')}\\\"\\n\",\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Verify original embedding archive\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[3] ORIGINAL EMBEDDING ARCHIVE\\\")\\n\",\"\\n\",\"original_expected_shapes = {\\n\",\"    \\\"reference_embeddings\\\": (1460, 512),\\n\",\"    \\\"reference_labels\\\": (1460,),\\n\",\"    \\\"calibration_embeddings\\\": (568, 512),\\n\",\"    \\\"calibration_labels\\\": (568,),\\n\",\"    \\\"evaluation_embeddings\\\": (956, 512),\\n\",\"    \\\"evaluation_labels\\\": (956,)\\n\",\"}\\n\",\"\\n\",\"for key, expected_shape in original_expected_shapes.items():\\n\",\"\\n\",\"    present = key in original_archive.files\\n\",\"\\n\",\"    if present:\\n\",\"        actual_shape = original_archive[key].shape\\n\",\"        shape_ok = actual_shape == expected_shape\\n\",\"    else:\\n\",\"        actual_shape = \\\"MISSING\\\"\\n\",\"        shape_ok = False\\n\",\"\\n\",\"    record_audit(\\n\",\"        f\\\"Original archive: {key}\\\",\\n\",\"        shape_ok,\\n\",\"        f\\\"Expected: {expected_shape}; Actual: {actual_shape}\\\"\\n\",\"    )\\n\",\"\\n\",\"for key in [\\n\",\"    \\\"reference_embeddings\\\",\\n\",\"    \\\"calibration_embeddings\\\",\\n\",\"    \\\"evaluation_embeddings\\\"\\n\",\"]:\\n\",\"    if key in original_archive.files:\\n\",\"        finite = np.isfinite(original_archive[key]).all()\\n\",\"\\n\",\"        record_audit(\\n\",\"            f\\\"Finite values: {key}\\\",\\n\",\"            finite\\n\",\"        )\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Verify illumination archive\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[4] ILLUMINATION ARCHIVE\\\")\\n\",\"\\n\",\"required_illumination_keys = [\\n\",\"    \\\"original_embeddings\\\",\\n\",\"    \\\"low_illumination_embeddings\\\",\\n\",\"    \\\"high_illumination_embeddings\\\",\\n\",\"    \\\"paired_labels\\\",\\n\",\"    \\\"common_positions\\\",\\n\",\"    \\\"low_displacement\\\",\\n\",\"    \\\"high_displacement\\\",\\n\",\"    \\\"low_success\\\",\\n\",\"    \\\"high_success\\\",\\n\",\"    \\\"low_failures\\\",\\n\",\"    \\\"high_failures\\\"\\n\",\"]\\n\",\"\\n\",\"for key in required_illumination_keys:\\n\",\"\\n\",\"    present = key in illumination_archive.files\\n\",\"\\n\",\"    record_audit(\\n\",\"        f\\\"Illumination key: {key}\\\",\\n\",\"        present\\n\",\"    )\\n\",\"\\n\",\"assert all(\\n\",\"    key in illumination_archive.files\\n\",\"    for key in required_illumination_keys\\n\",\"), \\\"Required illumination archive arrays are missing.\\\"\\n\",\"\\n\",\"\\n\",\"original_emb = illumination_archive[\\\"original_embeddings\\\"]\\n\",\"low_emb = illumination_archive[\\\"low_illumination_embeddings\\\"]\\n\",\"high_emb = illumination_archive[\\\"high_illumination_embeddings\\\"]\\n\",\"\\n\",\"paired_labels = illumination_archive[\\\"paired_labels\\\"]\\n\",\"\\n\",\"low_saved_displacement = illumination_archive[\\\"low_displacement\\\"]\\n\",\"high_saved_displacement = illumination_archive[\\\"high_displacement\\\"]\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"Paired embedding shapes\\\",\\n\",\"    (\\n\",\"        original_emb.shape == (889, 512)\\n\",\"        and low_emb.shape == (889, 512)\\n\",\"        and high_emb.shape == (889, 512)\\n\",\"    ),\\n\",\"    f\\\"Original: {original_emb.shape}; \\\"\\n\",\"    f\\\"Low: {low_emb.shape}; High: {high_emb.shape}\\\"\\n\",\")\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"Paired label alignment\\\",\\n\",\"    paired_labels.shape == (889,),\\n\",\"    f\\\"Labels: {paired_labels.shape}\\\"\\n\",\")\\n\",\"\\n\",\"all_finite = all([\\n\",\"    np.isfinite(original_emb).all(),\\n\",\"    np.isfinite(low_emb).all(),\\n\",\"    np.isfinite(high_emb).all(),\\n\",\"    np.isfinite(low_saved_displacement).all(),\\n\",\"    np.isfinite(high_saved_displacement).all()\\n\",\"])\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"Illumination arrays contain finite values\\\",\\n\",\"    all_finite\\n\",\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Independently reproduce embedding displacement\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[5] DISPLACEMENT REPRODUCIBILITY\\\")\\n\",\"\\n\",\"recalculated_low = np.linalg.norm(\\n\",\"    low_emb - original_emb,\\n\",\"    axis=1\\n\",\")\\n\",\"\\n\",\"recalculated_high = np.linalg.norm(\\n\",\"    high_emb - original_emb,\\n\",\"    axis=1\\n\",\")\\n\",\"\\n\",\"low_exact_match = np.allclose(\\n\",\"    recalculated_low,\\n\",\"    low_saved_displacement,\\n\",\"    rtol=0,\\n\",\"    atol=1e-7\\n\",\")\\n\",\"\\n\",\"high_exact_match = np.allclose(\\n\",\"    recalculated_high,\\n\",\"    high_saved_displacement,\\n\",\"    rtol=0,\\n\",\"    atol=1e-7\\n\",\")\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"Low displacement reproduction\\\",\\n\",\"    low_exact_match,\\n\",\"    f\\\"Maximum absolute difference: \\\"\\n\",\"    f\\\"{np.max(np.abs(recalculated_low - low_saved_displacement)):.12f}\\\"\\n\",\")\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"High displacement reproduction\\\",\\n\",\"    high_exact_match,\\n\",\"    f\\\"Maximum absolute difference: \\\"\\n\",\"    f\\\"{np.max(np.abs(recalculated_high - high_saved_displacement)):.12f}\\\"\\n\",\")\\n\",\"\\n\",\"low_mean = float(np.mean(recalculated_low))\\n\",\"high_mean = float(np.mean(recalculated_high))\\n\",\"\\n\",\"low_median = float(np.median(recalculated_low))\\n\",\"high_median = float(np.median(recalculated_high))\\n\",\"\\n\",\"displacement_summary = pd.DataFrame([\\n\",\"    {\\n\",\"        \\\"Condition\\\": \\\"Low illumination\\\",\\n\",\"        \\\"Mean\\\": low_mean,\\n\",\"        \\\"Median\\\": low_median,\\n\",\"        \\\"Standard Deviation\\\": np.std(recalculated_low)\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Condition\\\": \\\"High illumination\\\",\\n\",\"        \\\"Mean\\\": high_mean,\\n\",\"        \\\"Median\\\": high_median,\\n\",\"        \\\"Standard Deviation\\\": np.std(recalculated_high)\\n\",\"    }\\n\",\"])\\n\",\"\\n\",\"display(displacement_summary)\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"High mean displacement exceeds low mean displacement\\\",\\n\",\"    high_mean > low_mean,\\n\",\"    f\\\"Low: {low_mean:.9f}; High: {high_mean:.9f}\\\"\\n\",\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. Verify saved metadata\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[6] METADATA CONSISTENCY\\\")\\n\",\"\\n\",\"metadata_checks = {\\n\",\"    \\\"dataset\\\": saved_metadata.get(\\\"dataset\\\") == \\\"LFW filtered subset\\\",\\n\",\"    \\\"model\\\": saved_metadata.get(\\\"model\\\") == \\\"InceptionResnetV1\\\",\\n\",\"    \\\"pretrained weights\\\": saved_metadata.get(\\\"pretrained_weights\\\") == \\\"VGGFace2\\\",\\n\",\"    \\\"embedding dimension\\\": saved_metadata.get(\\\"embedding_dimension\\\") == 512,\\n\",\"    \\\"paired images\\\": saved_metadata.get(\\\"paired_images\\\") == 889,\\n\",\"    \\\"evaluation identities\\\": saved_metadata.get(\\\"evaluation_identities\\\") == 13\\n\",\"}\\n\",\"\\n\",\"for name, passed in metadata_checks.items():\\n\",\"    record_audit(\\n\",\"        f\\\"Metadata: {name}\\\",\\n\",\"        passed,\\n\",\"        str(saved_metadata.get(name.replace(\\\" \\\", \\\"_\\\")))\\n\",\"    )\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"Low displacement mean matches metadata\\\",\\n\",\"    np.isclose(\\n\",\"        low_mean,\\n\",\"        saved_metadata.get(\\\"mean_low_displacement\\\", np.nan),\\n\",\"        atol=1e-7\\n\",\"    )\\n\",\")\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"High displacement mean matches metadata\\\",\\n\",\"    np.isclose(\\n\",\"        high_mean,\\n\",\"        saved_metadata.get(\\\"mean_high_displacement\\\", np.nan),\\n\",\"        atol=1e-7\\n\",\"    )\\n\",\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. Reproduce image-level and identity-level tests\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[7] STATISTICAL REPRODUCIBILITY\\\")\\n\",\"\\n\",\"image_test = wilcoxon(\\n\",\"    recalculated_high,\\n\",\"    recalculated_low,\\n\",\"    alternative=\\\"two-sided\\\"\\n\",\")\\n\",\"\\n\",\"image_p = float(image_test.pvalue)\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"Image-level Wilcoxon reproduction\\\",\\n\",\"    np.isclose(\\n\",\"        image_p,\\n\",\"        saved_metadata.get(\\\"image_level_wilcoxon_p\\\", np.nan),\\n\",\"        rtol=1e-6,\\n\",\"        atol=1e-100\\n\",\"    ),\\n\",\"    f\\\"Statistic: {image_test.statistic}; p-value: {image_p:.12e}\\\"\\n\",\")\\n\",\"\\n\",\"identity_df = pd.DataFrame({\\n\",\"    \\\"Identity\\\": paired_labels,\\n\",\"    \\\"Low\\\": recalculated_low,\\n\",\"    \\\"High\\\": recalculated_high\\n\",\"})\\n\",\"\\n\",\"identity_means = identity_df.groupby(\\\"Identity\\\")[\\n\",\"    [\\\"Low\\\", \\\"High\\\"]\\n\",\"].mean()\\n\",\"\\n\",\"identity_medians = identity_df.groupby(\\\"Identity\\\")[\\n\",\"    [\\\"Low\\\", \\\"High\\\"]\\n\",\"].median()\\n\",\"\\n\",\"mean_identity_test = wilcoxon(\\n\",\"    identity_means[\\\"High\\\"],\\n\",\"    identity_means[\\\"Low\\\"],\\n\",\"    alternative=\\\"two-sided\\\"\\n\",\")\\n\",\"\\n\",\"median_identity_test = wilcoxon(\\n\",\"    identity_medians[\\\"High\\\"],\\n\",\"    identity_medians[\\\"Low\\\"],\\n\",\"    alternative=\\\"two-sided\\\"\\n\",\")\\n\",\"\\n\",\"mean_identity_p = float(mean_identity_test.pvalue)\\n\",\"median_identit\\n\",\"\\n\",\"---------------------------------------------------------------------------\\n\",\"CELL 140 | TYPE: code\\n\",\"Matched terms: original_embeddings, low_illumination_embeddings, high_illumination_embeddings, paired_labels, brightness\\n\",\"---------------------------------------------------------------------------\\n\",\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 18 — STEP 17.10.6.5\\n\",\"# FINAL RESEARCH EVIDENCE PACKAGE\\n\",\"# Corrected version — uses validated in-memory results\\n\",\"# ============================================================\\n\",\"\\n\",\"import os\\n\",\"import sys\\n\",\"import json\\n\",\"import platform\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"import scipy\\n\",\"import torch\\n\",\"import torchvision\\n\",\"import sklearn\\n\",\"import PIL\\n\",\"\\n\",\"from datetime import datetime, timezone\\n\",\"from importlib.metadata import version, PackageNotFoundError\\n\",\"\\n\",\"\\n\",\"print(\\\"=\\\" * 80)\\n\",\"print(\\\"STEP 17.10.6.5 — FINAL RESEARCH EVIDENCE PACKAGE\\\")\\n\",\"print(\\\"=\\\" * 80)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. CONFIGURATION AND REQUIRED FILE VERIFICATION\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"RESULTS_DIR = \\\"/content/drive/MyDrive/Experiment_18_Results\\\"\\n\",\"\\n\",\"ORIGINAL_ARCHIVE = os.path.join(\\n\",\"    RESULTS_DIR,\\n\",\"    \\\"experiment18_facenet_lfw_embeddings.npz\\\"\\n\",\")\\n\",\"\\n\",\"ILLUMINATION_ARCHIVE = os.path.join(\\n\",\"    RESULTS_DIR,\\n\",\"    \\\"experiment18_illumination_results.npz\\\"\\n\",\")\\n\",\"\\n\",\"METADATA_FILE = os.path.join(\\n\",\"    RESULTS_DIR,\\n\",\"    \\\"illumination_metadata.json\\\"\\n\",\")\\n\",\"\\n\",\"CSV_FILE = os.path.join(\\n\",\"    RESULTS_DIR,\\n\",\"    \\\"illumination_identity_summary.csv\\\"\\n\",\")\\n\",\"\\n\",\"required_files = [\\n\",\"    ORIGINAL_ARCHIVE,\\n\",\"    ILLUMINATION_ARCHIVE,\\n\",\"    METADATA_FILE,\\n\",\"    CSV_FILE\\n\",\"]\\n\",\"\\n\",\"missing_files = [\\n\",\"    path for path in required_files\\n\",\"    if not os.path.isfile(path)\\n\",\"]\\n\",\"\\n\",\"assert not missing_files, (\\n\",\"    \\\"Required experiment files are missing:\\\\n\\\"\\n\",\"    + \\\"\\\\n\\\".join(missing_files)\\n\",\")\\n\",\"\\n\",\"required_variables = [\\n\",\"    \\\"evaluation_detector_df\\\",\\n\",\"    \\\"identity_detector_df\\\",\\n\",\"    \\\"statistical_results\\\",\\n\",\"    \\\"effect_size_df\\\"\\n\",\"]\\n\",\"\\n\",\"missing_variables = [\\n\",\"    name for name in required_variables\\n\",\"    if name not in globals()\\n\",\"]\\n\",\"\\n\",\"assert not missing_variables, (\\n\",\"    \\\"Required validated DataFrames are unavailable: \\\"\\n\",\"    + \\\", \\\".join(missing_variables)\\n\",\")\\n\",\"\\n\",\"for name in required_variables:\\n\",\"    assert isinstance(globals()[name], pd.DataFrame), (\\n\",\"        f\\\"{name} is not a DataFrame.\\\"\\n\",\"    )\\n\",\"\\n\",\"print(\\\"Section 1: Required files and detector tables verified.\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. LOAD EXISTING EXPERIMENT OUTPUTS\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"with np.load(\\n\",\"    ORIGINAL_ARCHIVE,\\n\",\"    allow_pickle=False\\n\",\") as original_data:\\n\",\"\\n\",\"    original_shapes = {\\n\",\"        key: list(original_data[key].shape)\\n\",\"        for key in original_data.files\\n\",\"    }\\n\",\"\\n\",\"with np.load(\\n\",\"    ILLUMINATION_ARCHIVE,\\n\",\"    allow_pickle=False\\n\",\") as illumination_data:\\n\",\"\\n\",\"    illumination_shapes = {\\n\",\"        key: list(illumination_data[key].shape)\\n\",\"        for key in illumination_data.files\\n\",\"    }\\n\",\"\\n\",\"    original_embeddings = illumination_data[\\n\",\"        \\\"original_embeddings\\\"\\n\",\"    ].copy()\\n\",\"\\n\",\"    low_embeddings = illumination_data[\\n\",\"        \\\"low_illumination_embeddings\\\"\\n\",\"    ].copy()\\n\",\"\\n\",\"    high_embeddings = illumination_data[\\n\",\"        \\\"high_illumination_embeddings\\\"\\n\",\"    ].copy()\\n\",\"\\n\",\"    paired_labels = illumination_data[\\n\",\"        \\\"paired_labels\\\"\\n\",\"    ].copy()\\n\",\"\\n\",\"    saved_low_displacement = illumination_data[\\n\",\"        \\\"low_displacement\\\"\\n\",\"    ].copy()\\n\",\"\\n\",\"    saved_high_displacement = illumination_data[\\n\",\"        \\\"high_displacement\\\"\\n\",\"    ].copy()\\n\",\"\\n\",\"with open(METADATA_FILE, \\\"r\\\", encoding=\\\"utf-8\\\") as file:\\n\",\"    metadata = json.load(file)\\n\",\"\\n\",\"identity_csv = pd.read_csv(CSV_FILE)\\n\",\"\\n\",\"print(\\\"Section 2: Existing archives and metadata loaded.\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. DATASET COMPOSITION\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"assert original_embeddings.shape == low_embeddings.shape\\n\",\"assert original_embeddings.shape == high_embeddings.shape\\n\",\"assert original_embeddings.ndim == 2\\n\",\"assert original_embeddings.shape[0] == len(paired_labels)\\n\",\"assert original_embeddings.shape[1] == 512\\n\",\"\\n\",\"assert np.isfinite(original_embeddings).all()\\n\",\"assert np.isfinite(low_embeddings).all()\\n\",\"assert np.isfinite(high_embeddings).all()\\n\",\"\\n\",\"identity_values, identity_counts = np.unique(\\n\",\"    paired_labels,\\n\",\"    return_counts=True\\n\",\")\\n\",\"\\n\",\"identity_distribution = [\\n\",\"    {\\n\",\"        \\\"identity\\\": int(identity),\\n\",\"        \\\"paired_image_count\\\": int(count)\\n\",\"    }\\n\",\"    for identity, count in zip(\\n\",\"        identity_values,\\n\",\"        identity_counts\\n\",\"    )\\n\",\"]\\n\",\"\\n\",\"paired_images = int(len(paired_labels))\\n\",\"identity_count = int(len(identity_values))\\n\",\"embedding_dimension = int(original_embeddings.shape[1])\\n\",\"\\n\",\"largest_identity_index = int(np.argmax(identity_counts))\\n\",\"\\n\",\"largest_identity = int(\\n\",\"    identity_values[largest_identity_index]\\n\",\")\\n\",\"\\n\",\"largest_identity_count = int(\\n\",\"    identity_counts[largest_identity_index]\\n\",\")\\n\",\"\\n\",\"largest_identity_share = (\\n\",\"    largest_identity_count / paired_images\\n\",\")\\n\",\"\\n\",\"assert paired_images == 889\\n\",\"assert identity_count == 13\\n\",\"\\n\",\"print(\\\"\\\\nSection 3: Dataset composition verified.\\\")\\n\",\"print(\\\"Paired images:\\\", paired_images)\\n\",\"print(\\\"Identities:\\\", identity_count)\\n\",\"print(\\\"Embedding dimension:\\\", embedding_dimension)\\n\",\"print(\\\"Largest identity:\\\", largest_identity)\\n\",\"print(\\\"Largest identity share:\\\", f\\\"{largest_identity_share:.2%}\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. REPRODUCE SAVED EMBEDDING DISPLACEMENTS\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"recalculated_low = np.linalg.norm(\\n\",\"    low_embeddings - original_embeddings,\\n\",\"    axis=1\\n\",\")\\n\",\"\\n\",\"recalculated_high = np.linalg.norm(\\n\",\"    high_embeddings - original_embeddings,\\n\",\"    axis=1\\n\",\")\\n\",\"\\n\",\"low_max_error = float(\\n\",\"    np.max(\\n\",\"        np.abs(\\n\",\"            recalculated_low - saved_low_displacement\\n\",\"        )\\n\",\"    )\\n\",\")\\n\",\"\\n\",\"high_max_error = float(\\n\",\"    np.max(\\n\",\"        np.abs(\\n\",\"            recalculated_high - saved_high_displacement\\n\",\"        )\\n\",\"    )\\n\",\")\\n\",\"\\n\",\"assert low_max_error == 0.0, (\\n\",\"    \\\"Low-illumination displacement reproduction failed.\\\"\\n\",\")\\n\",\"\\n\",\"assert high_max_error == 0.0, (\\n\",\"    \\\"High-illumination displacement reproduction failed.\\\"\\n\",\")\\n\",\"\\n\",\"displacement_summary = {\\n\",\"    \\\"low_illumination\\\": {\\n\",\"        \\\"mean\\\": float(np.mean(saved_low_displacement)),\\n\",\"        \\\"median\\\": float(np.median(saved_low_displacement)),\\n\",\"        \\\"standard_deviation\\\": float(\\n\",\"            np.std(saved_low_displacement)\\n\",\"        )\\n\",\"    },\\n\",\"    \\\"high_illumination\\\": {\\n\",\"        \\\"mean\\\": float(np.mean(saved_high_displacement)),\\n\",\"        \\\"median\\\": float(np.median(saved_high_displacement)),\\n\",\"        \\\"standard_deviation\\\": float(\\n\",\"            np.std(saved_high_displacement)\\n\",\"        )\\n\",\"    },\\n\",\"    \\\"high_minus_low_mean\\\": float(\\n\",\"        np.mean(\\n\",\"            saved_high_displacement - saved_low_displacement\\n\",\"        )\\n\",\"    ),\\n\",\"    \\\"high_minus_low_median\\\": float(\\n\",\"        np.median(\\n\",\"            saved_high_displacement - saved_low_displacement\\n\",\"        )\\n\",\"    ),\\n\",\"    \\\"reproduction_max_absolute_error\\\": {\\n\",\"        \\\"low\\\": low_max_error,\\n\",\"        \\\"high\\\": high_max_error\\n\",\"    }\\n\",\"}\\n\",\"\\n\",\"print(\\\"\\\\nSection 4: Displacement reproduction passed.\\\")\\n\",\"print(\\\"Low maximum error:\\\", low_max_error)\\n\",\"print(\\\"High maximum error:\\\", high_max_error)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. HISTORICAL DISPLACEMENT STATISTICAL FINDINGS\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"displacement_tests = {\\n\",\"    \\\"image_level\\\": {\\n\",\"        \\\"unit_of_analysis\\\": \\\"paired images\\\",\\n\",\"        \\\"sample_size\\\": 889,\\n\",\"        \\\"wilcoxon_statistic\\\": 52705.0,\\n\",\"        \\\"p_value\\\": 4.708938281282196e-80\\n\",\"    },\\n\",\"    \\\"identity_level_mean_displacement\\\": {\\n\",\"        \\\"unit_of_analysis\\\": \\\"identity-level means\\\",\\n\",\"        \\\"sample_size\\\": 13,\\n\",\"        \\\"wilcoxon_statistic\\\": 3.0,\\n\",\"        \\\"p_value\\\": 0.001220703125\\n\",\"    },\\n\",\"    \\\"identity_level_median_displacement\\\": {\\n\",\"        \\\"unit_of_analysis\\\": \\\"identity-level medians\\\",\\n\",\"        \\\"sample_size\\\": 13,\\n\",\"        \\\"wilcoxon_statistic\\\": 3.0,\\n\",\"        \\\"p_value\\\": 0.001220703125\\n\",\"    }\\n\",\"}\\n\",\"\\n\",\"print(\\\"\\\\nSection 5: Previously reproduced displacement statistics recorded.\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. CORRECTED DETECTOR STATISTICS AND EFFECT SIZES\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"expected_detectors = {\\\"Euclidean\\\", \\\"Mahalanobis\\\"}\\n\",\"\\n\",\"assert set(statistical_results[\\\"Detector\\\"]) == expected_detectors\\n\",\"assert set(effect_size_df[\\\"Detector\\\"]) == expected_detectors\\n\",\"\\n\",\"expected_p_values = {\\n\",\"    \\\"Euclidean\\\": 0.021484,\\n\",\"    \\\"Mahalanobis\\\": 0.002441\\n\",\"}\\n\",\"\\n\",\"expected_wilcoxon = {\\n\",\"    \\\"Euclidean\\\": 13.0,\\n\",\"    \\\"Mahalanobis\\\": 5.0\\n\",\"}\\n\",\"\\n\",\"for detector in expected_detectors:\\n\",\"\\n\",\"    stat_row = statistical_results.loc[\\n\",\"        statistical_results[\\\"Detector\\\"] == detector\\n\",\"    ].iloc[0]\\n\",\"\\n\",\"    assert np.isclose(\\n\",\"        float(stat_row[\\\"P-value\\\"]),\\n\",\"        expected_p_values[detector],\\n\",\"        atol=1e-6\\n\",\"    ), f\\\"{detector} corrected p-value mismatch.\\\"\\n\",\"\\n\",\"    assert np.isclose(\\n\",\"        float(stat_row[\\\"Wilcoxon Statistic\\\"]),\\n\",\"        expected_wilcoxon[detector]\\n\",\"    ), f\\\"{detector} corrected Wilcoxon statistic mismatch.\\\"\\n\",\"\\n\",\"detector_tests_df = statistical_results.merge(\\n\",\"    effect_size_df,\\n\",\"    on=\\\"Detector\\\",\\n\",\"    how=\\\"inner\\\",\\n\",\"    validate=\\\"one_to_one\\\"\\n\",\")\\n\",\"\\n\",\"assert len(detector_tests_df) == 2\\n\",\"\\n\",\"detector_tests_df = detector_tests_df.sort_values(\\n\",\"    \\\"Detector\\\"\\n\",\").reset_index(drop=True)\\n\",\"\\n\",\"print(\\\"\\\\nSection 6: Corrected detector statistical results verified.\\\")\\n\",\"display(detector_tests_df)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. AGGREGATE AND IDENTITY-LEVEL DETECTOR EVIDENCE\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"aggregate_detector_records = (\\n\",\"    evaluation_detector_df.to_dict(orient=\\\"records\\\")\\n\",\")\\n\",\"\\n\",\"identity_detector_records = (\\n\",\"    identity_detector_df.to_dict(orient=\\\"records\\\")\\n\",\")\\n\",\"\\n\",\"effect_size_records = (\\n\",\"    effect_size_df.to_dict(orient=\\\"records\\\")\\n\",\")\\n\",\"\\n\",\"# Calculate identity-level direction directly from the validated table.\\n\",\"identity_pivot = identity_detector_df.pivot(\\n\",\"    index=\\\"Identity\\\",\\n\",\"    columns=\\\"Condition\\\",\\n\",\"    values=[\\\"Euclidean\\\", \\\"Mahalanobis\\\"]\\n\",\")\\n\",\"\\n\",\"identity_direction_summary = {}\\n\",\"\\n\",\"for detector in [\\\"Euclidean\\\", \\\"Mahalanobis\\\"]:\\n\",\"\\n\",\"    low_values = identity_pivot[\\n\",\"        (detector, \\\"Low illumination\\\")\\n\",\"    ]\\n\",\"\\n\",\"    high_values = identity_pivot[\\n\",\"        (detector, \\\"High illumination\\\")\\n\",\"    ]\\n\",\"\\n\",\"    differences = high_values - low_values\\n\",\"\\n\",\"    identity_direction_summary[detector.lower()] = {\\n\",\"        \\\"increased\\\": int((differences > 0).sum()),\\n\",\"       \\n\",\"\\n\",\"===========================================================================\\n\",\"PROVENANCE AUDIT COMPLETED\\n\",\"===========================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"\\n\",\"## Experiment 20 — Step 2.3\\n\",\"### Saved Paired-Array Integrity Validation\\n\",\"\\n\",\"**Objective**\\n\",\"\\n\",\"Verify the internal consistency of the saved Experiment 18 paired illumination archive before using it in Experiment 20.\\n\",\"\\n\",\"**Validation requirements**\\n\",\"\\n\",\"1. Confirm the dimensions and numerical integrity of all three embedding arrays.\\n\",\"2. Verify the identity-label and source-position array lengths.\\n\",\"3. Reconstruct the common successful positions from low- and high-illumination extraction records.\\n\",\"4. Verify that the saved common positions match the reconstructed positions.\\n\",\"5. Recalculate low- and high-illumination Euclidean displacement values.\\n\",\"6. Compare recalculated displacement values with the archived values.\\n\",\"7. Check identity coverage and identity-frequency imbalance.\\n\",\"8. Report all validation failures without modifying the source archive.\\n\",\"\\n\",\"**Scientific constraint**\\n\",\"\\n\",\"Matching array dimensions alone does not prove image-level correspondence. This audit checks consistency with the saved extraction-position records and the documented pairing procedure.\\n\"],\"metadata\":{\"id\":\"mj52_S9PZisn\"}},{\"cell_type\":\"code\",\"source\":[\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 20 — STEP 2.3\\n\",\"# SAVED PAIRED-ARRAY INTEGRITY VALIDATION\\n\",\"# ============================================================\\n\",\"\\n\",\"from pathlib import Path\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Load the existing archive in read-only mode\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"archive_path = Path(\\n\",\"    \\\"/content/drive/MyDrive/Experiment_18_Results/\\\"\\n\",\"    \\\"experiment18_illumination_results.npz\\\"\\n\",\")\\n\",\"\\n\",\"assert archive_path.exists(), \\\"Experiment 18 archive not found.\\\"\\n\",\"\\n\",\"with np.load(archive_path, allow_pickle=False) as data:\\n\",\"\\n\",\"    original = data[\\\"original_embeddings\\\"].copy()\\n\",\"    low = data[\\\"low_illumination_embeddings\\\"].copy()\\n\",\"    high = data[\\\"high_illumination_embeddings\\\"].copy()\\n\",\"\\n\",\"    labels = data[\\\"paired_labels\\\"].copy()\\n\",\"    common_positions = data[\\\"common_positions\\\"].copy()\\n\",\"\\n\",\"    saved_low_displacement = data[\\\"low_displacement\\\"].copy()\\n\",\"    saved_high_displacement = data[\\\"high_displacement\\\"].copy()\\n\",\"\\n\",\"    low_success = data[\\\"low_success\\\"].copy()\\n\",\"    high_success = data[\\\"high_success\\\"].copy()\\n\",\"\\n\",\"    low_failures = data[\\\"low_failures\\\"].copy()\\n\",\"    high_failures = data[\\\"high_failures\\\"].copy()\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 2.3\\\")\\n\",\"print(\\\"SAVED PAIRED-ARRAY INTEGRITY VALIDATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Validate array dimensions and finite values\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[1] EMBEDDING ARRAY VALIDATION\\\")\\n\",\"\\n\",\"embedding_arrays = {\\n\",\"    \\\"Original\\\": original,\\n\",\"    \\\"Low illumination\\\": low,\\n\",\"    \\\"High illumination\\\": high\\n\",\"}\\n\",\"\\n\",\"for name, array in embedding_arrays.items():\\n\",\"\\n\",\"    print(f\\\"\\\\n{name}\\\")\\n\",\"    print(\\\"Shape:\\\", array.shape)\\n\",\"    print(\\\"Data type:\\\", array.dtype)\\n\",\"    print(\\\"All finite:\\\", np.isfinite(array).all())\\n\",\"\\n\",\"    assert array.ndim == 2\\n\",\"    assert array.shape[1] == 512\\n\",\"    assert np.isfinite(array).all()\\n\",\"\\n\",\"assert original.shape == low.shape == high.shape\\n\",\"assert original.shape[0] == 889\\n\",\"\\n\",\"print(\\\"\\\\nEmbedding dimensions: PASSED\\\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Validate labels and source-position arrays\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[2] LABEL AND POSITION VALIDATION\\\")\\n\",\"\\n\",\"print(\\\"Labels:\\\", labels.shape)\\n\",\"print(\\\"Common positions:\\\", common_positions.shape)\\n\",\"print(\\\"Low successes:\\\", low_success.shape)\\n\",\"print(\\\"High successes:\\\", high_success.shape)\\n\",\"print(\\\"Low failures:\\\", low_failures.shape)\\n\",\"print(\\\"High failures:\\\", high_failures.shape)\\n\",\"\\n\",\"assert len(labels) == len(original)\\n\",\"assert len(common_positions) == len(original)\\n\",\"\\n\",\"assert np.issubdtype(labels.dtype, np.integer)\\n\",\"assert np.issubdtype(common_positions.dtype, np.integer)\\n\",\"\\n\",\"assert np.all(common_positions >= 0)\\n\",\"assert len(np.unique(common_positions)) == len(common_positions)\\n\",\"\\n\",\"print(\\\"Label and position dimensions: PASSED\\\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Reconstruct common successful positions\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[3] COMMON POSITION RECONSTRUCTION\\\")\\n\",\"\\n\",\"reconstructed_positions = np.intersect1d(\\n\",\"    low_success,\\n\",\"    high_success\\n\",\")\\n\",\"\\n\",\"print(\\\"Reconstructed positions:\\\", len(reconstructed_positions))\\n\",\"print(\\\"Saved positions:\\\", len(common_positions))\\n\",\"\\n\",\"positions_match = np.array_equal(\\n\",\"    reconstructed_positions,\\n\",\"    common_positions\\n\",\")\\n\",\"\\n\",\"print(\\\"Saved positions match reconstructed positions:\\\", positions_match)\\n\",\"\\n\",\"assert positions_match, (\\n\",\"    \\\"Saved common_positions do not match the intersection \\\"\\n\",\"    \\\"of low_success and high_success.\\\"\\n\",\")\\n\",\"\\n\",\"assert len(reconstructed_positions) == 889\\n\",\"\\n\",\"print(\\\"Position reconstruction: PASSED\\\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Validate extraction-position accounting\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[4] EXTRACTION-POSITION ACCOUNTING\\\")\\n\",\"\\n\",\"for name, successes, failures in [\\n\",\"    (\\\"Low illumination\\\", low_success, low_failures),\\n\",\"    (\\\"High illumination\\\", high_success, high_failures)\\n\",\"]:\\n\",\"\\n\",\"    success_set = set(successes.tolist())\\n\",\"    failure_set = set(failures.tolist())\\n\",\"\\n\",\"    overlap = success_set.intersection(failure_set)\\n\",\"\\n\",\"    print(f\\\"\\\\n{name}\\\")\\n\",\"    print(\\\"Successes:\\\", len(success_set))\\n\",\"    print(\\\"Failures:\\\", len(failure_set))\\n\",\"    print(\\\"Success/failure overlap:\\\", len(overlap))\\n\",\"\\n\",\"    assert len(overlap) == 0\\n\",\"    assert len(success_set) + len(failure_set) == 956\\n\",\"\\n\",\"print(\\\"Extraction accounting: PASSED\\\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. Recalculate paired Euclidean displacement\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[5] DISPLACEMENT REPRODUCIBILITY\\\")\\n\",\"\\n\",\"recalculated_low = np.linalg.norm(\\n\",\"    original - low,\\n\",\"    axis=1\\n\",\")\\n\",\"\\n\",\"recalculated_high = np.linalg.norm(\\n\",\"    original - high,\\n\",\"    axis=1\\n\",\")\\n\",\"\\n\",\"low_max_difference = np.max(\\n\",\"    np.abs(recalculated_low - saved_low_displacement)\\n\",\")\\n\",\"\\n\",\"high_max_difference = np.max(\\n\",\"    np.abs(recalculated_high - saved_high_displacement)\\n\",\")\\n\",\"\\n\",\"print(\\\"Low displacement maximum absolute difference:\\\",\\n\",\"      low_max_difference)\\n\",\"\\n\",\"print(\\\"High displacement maximum absolute difference:\\\",\\n\",\"      high_max_difference)\\n\",\"\\n\",\"print(\\\"Low displacement allclose:\\\",\\n\",\"      np.allclose(\\n\",\"          recalculated_low,\\n\",\"          saved_low_displacement,\\n\",\"          rtol=1e-5,\\n\",\"          atol=1e-6\\n\",\"      ))\\n\",\"\\n\",\"print(\\\"High displacement allclose:\\\",\\n\",\"      np.allclose(\\n\",\"          recalculated_high,\\n\",\"          saved_high_displacement,\\n\",\"          rtol=1e-5,\\n\",\"          atol=1e-6\\n\",\"      ))\\n\",\"\\n\",\"assert np.allclose(\\n\",\"    recalculated_low,\\n\",\"    saved_low_displacement,\\n\",\"    rtol=1e-5,\\n\",\"    atol=1e-6\\n\",\")\\n\",\"\\n\",\"assert np.allclose(\\n\",\"    recalculated_high,\\n\",\"    saved_high_displacement,\\n\",\"    rtol=1e-5,\\n\",\"    atol=1e-6\\n\",\")\\n\",\"\\n\",\"print(\\\"Displacement reproducibility: PASSED\\\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. Identity coverage and imbalance\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[6] IDENTITY DISTRIBUTION\\\")\\n\",\"\\n\",\"identity_counts = (\\n\",\"    pd.Series(labels, name=\\\"Identity\\\")\\n\",\"    .value_counts()\\n\",\"    .sort_index()\\n\",\"    .rename_axis(\\\"Identity\\\")\\n\",\"    .reset_index(name=\\\"Image_Count\\\")\\n\",\")\\n\",\"\\n\",\"display(identity_counts)\\n\",\"\\n\",\"print(\\\"Unique identities:\\\", len(identity_counts))\\n\",\"print(\\\"Total paired observations:\\\", identity_counts[\\\"Image_Count\\\"].sum())\\n\",\"\\n\",\"print(\\n\",\"    \\\"Largest identity share (%):\\\",\\n\",\"    round(\\n\",\"        identity_counts[\\\"Image_Count\\\"].max()\\n\",\"        / len(labels) * 100,\\n\",\"        2\\n\",\"    )\\n\",\")\\n\",\"\\n\",\"assert len(identity_counts) == 13\\n\",\"assert identity_counts[\\\"Image_Count\\\"].sum() == 889\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 8. Final validation summary\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 2.3 — FINAL AUDIT SUMMARY\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"audit = {\\n\",\"    \\\"Embedding dimensions\\\": True,\\n\",\"    \\\"Finite embedding values\\\": True,\\n\",\"    \\\"Label and position dimensions\\\": True,\\n\",\"    \\\"Common-position reconstruction\\\": positions_match,\\n\",\"    \\\"Extraction-position accounting\\\": True,\\n\",\"    \\\"Low displacement reproducibility\\\": np.allclose(\\n\",\"        recalculated_low,\\n\",\"        saved_low_displacement,\\n\",\"        rtol=1e-5,\\n\",\"        atol=1e-6\\n\",\"    ),\\n\",\"    \\\"High displacement reproducibility\\\": np.allclose(\\n\",\"        recalculated_high,\\n\",\"        saved_high_displacement,\\n\",\"        rtol=1e-5,\\n\",\"        atol=1e-6\\n\",\"    ),\\n\",\"    \\\"Identity coverage\\\": len(identity_counts) == 13\\n\",\"}\\n\",\"\\n\",\"for check, passed in audit.items():\\n\",\"    print(f\\\"{check}: {'PASSED' if passed else 'FAILED'}\\\")\\n\",\"\\n\",\"assert all(audit.values()), \\\"One or more integrity checks failed.\\\"\\n\",\"\\n\",\"print(\\\"\\\\nALL STEP 2.3 VALIDATION CHECKS PASSED\\\")\\n\",\"print(\\\"Source archive was not modified.\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\",\"height\":1000},\"id\":\"X0e6I9AvZk2O\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794346735867,\"user_tz\":360,\"elapsed\":274,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"bba0b6ef-4480-457b-a56b-fa79a7c0fb2a\"},\"execution_count\":null,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"===========================================================================\\n\",\"EXPERIMENT 20 — STEP 2.3\\n\",\"SAVED PAIRED-ARRAY INTEGRITY VALIDATION\\n\",\"===========================================================================\\n\",\"\\n\",\"[1] EMBEDDING ARRAY VALIDATION\\n\",\"\\n\",\"Original\\n\",\"Shape: (889, 512)\\n\",\"Data type: float32\\n\",\"All finite: True\\n\",\"\\n\",\"Low illumination\\n\",\"Shape: (889, 512)\\n\",\"Data type: float32\\n\",\"All finite: True\\n\",\"\\n\",\"High illumination\\n\",\"Shape: (889, 512)\\n\",\"Data type: float32\\n\",\"All finite: True\\n\",\"\\n\",\"Embedding dimensions: PASSED\\n\",\"\\n\",\"[2] LABEL AND POSITION VALIDATION\\n\",\"Labels: (889,)\\n\",\"Common positions: (889,)\\n\",\"Low successes: (943,)\\n\",\"High successes: (897,)\\n\",\"Low failures: (13,)\\n\",\"High failures: (59,)\\n\",\"Label and position dimensions: PASSED\\n\",\"\\n\",\"[3] COMMON POSITION RECONSTRUCTION\\n\",\"Reconstructed positions: 889\\n\",\"Saved positions: 889\\n\",\"Saved positions match reconstructed positions: True\\n\",\"Position reconstruction: PASSED\\n\",\"\\n\",\"[4] EXTRACTION-POSITION ACCOUNTING\\n\",\"\\n\",\"Low illumination\\n\",\"Successes: 943\\n\",\"Failures: 13\\n\",\"Success/failure overlap: 0\\n\",\"\\n\",\"High illumination\\n\",\"Successes: 897\\n\",\"Failures: 59\\n\",\"Success/failure overlap: 0\\n\",\"Extraction accounting: PASSED\\n\",\"\\n\",\"[5] DISPLACEMENT REPRODUCIBILITY\\n\",\"Low displacement maximum absolute difference: 0.0\\n\",\"High displacement maximum absolute difference: 0.0\\n\",\"Low displacement allclose: True\\n\",\"High displacement allclose: True\\n\",\"Displacement reproducibility: PASSED\\n\",\"\\n\",\"[6] IDENTITY DISTRIBUTION\\n\"]},{\"output_type\":\"display_data\",\"data\":{\"text/plain\":[\"    Identity  Image_Count\\n\",\"0          1           33\\n\",\"1          2           21\\n\",\"2          8           24\\n\",\"3         12          114\\n\",\"4         13           21\\n\",\"5         14          504\\n\",\"6         33           22\\n\",\"7         36           19\\n\",\"8         43           18\\n\",\"9         45           29\\n\",\"10        47           22\\n\",\"11        49           22\\n\",\"12        60           40\"],\"text/html\":[\"\\n\",\"  <div id=\\\"df-2f88ed64-aff0-4510-a499-c562edf8dae5\\\" class=\\\"colab-df-container\\\">\\n\",\"    <div>\\n\",\"<style scoped>\\n\",\"    .dataframe tbody tr th:only-of-type {\\n\",\"        vertical-align: middle;\\n\",\"    }\\n\",\"\\n\",\"    .dataframe tbody tr th {\\n\",\"        vertical-align: top;\\n\",\"    }\\n\",\"\\n\",\"    .dataframe thead th {\\n\",\"        text-align: right;\\n\",\"    }\\n\",\"</style>\\n\",\"<table border=\\\"1\\\" class=\\\"dataframe\\\">\\n\",\"  <thead>\\n\",\"    <tr style=\\\"text-align: 