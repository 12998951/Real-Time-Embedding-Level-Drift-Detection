            ")\n",
            "\n",
            "sha256 = hashlib.sha256()\n",
            "\n",
            "with open(weights, \"rb\") as f:\n",
            "    for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n",
            "        sha256.update(chunk)\n",
