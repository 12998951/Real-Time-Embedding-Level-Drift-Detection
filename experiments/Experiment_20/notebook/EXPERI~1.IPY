            "      \"ci_95_lower\": 0.3649059712866757,\n",
            "      \"ci_95_upper\": 0.40832084536922303\n",
            "    }\n",
            "  ]\n",
            "}\n",
            "{\n",
            "  \"location\": \"root.bootstrap_results[0]\",\n",
            "  \"key\": \"bootstrap_iterations\",\n",
