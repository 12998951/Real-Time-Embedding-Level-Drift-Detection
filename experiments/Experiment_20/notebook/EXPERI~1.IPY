      "cell_type": "markdown",
      "source": [
        "# Experiment 20 — Step 3.1.10\n",
        "## Resize Interpolation and Model Weight Availability Verification\n",
        "\n",
        "### Objectives\n",
        "\n",
        "1. Inspect the installed torchvision Resize API.\n",
        "2. Identify its default interpolation setting.\n",
        "3. Verify the recorded torchvision version.\n",
        "4. Inspect common local cache locations for FaceNet model weights.\n",
        "5. If a candidate weight file exists, calculate its SHA-256 checksum.\n",
        "\n",
        "### Restrictions\n",
        "\n",
        "- Do not download model weights.\n",
        "- Do not regenerate embeddings.\n",
        "- Do not modify existing experiment artifacts.\n",
        "- Do not install packages.\n",
        "- Do not assume a cached file belongs to Experiment 20 without supporting evidence.\n",
        "\n",
        "### Expected outcome\n",
        "\n",
        "Establish whether the implicit Resize interpolation can be documented from the recorded software version and whether the exact model-weight file can be independently identified."
      ],
      "metadata": {
        "id": "5ae5BPtiwRry"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import inspect\n",
        "import hashlib\n",
        "import importlib.metadata\n",
        "from pathlib import Path\n",
        "\n",
        "print(\"=\" * 85)\n",
        "print(\"EXPERIMENT 20 — STEP 3.1.10\")\n",
        "print(\"RESIZE DEFAULT AND MODEL WEIGHT AVAILABILITY\")\n",
        "print(\"=\" * 85)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 1. Inspect torchvision\n",
        "# --------------------------------------------------\n",
        "\n",
        "try:\n",
        "    import torchvision\n",
        "    from torchvision import transforms\n",
        "\n",
        "    print(\"\\n[1] TORCHVISION VERSION\")\n",
        "    print(\"Installed version:\", torchvision.__version__)\n",
        "\n",
        "    resize_signature = inspect.signature(\n",
        "        transforms.Resize\n",
        "    )\n",
        "\n",
        "    print(\"\\nResize API signature:\")\n",
        "    print(resize_signature)\n",
        "\n",
        "    resize_default = resize_signature.parameters[\n",
        "        \"interpolation\"\n",
        "    ].default\n",
        "\n",
        "    print(\"\\nDefault interpolation object:\")\n",
        "    print(resize_default)\n",
        "\n",
        "    print(\"Default interpolation name:\")\n",
        "    print(getattr(resize_default, \"name\", str(resize_default)))\n",
        "\n",
        "except Exception as exc:\n",
        "    print(\"\\nTorchvision inspection failed:\")\n",
        "    print(repr(exc))\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 2. Compare recorded version\n",
        "# --------------------------------------------------\n",
        "\n",
        "print(\"\\n[2] RECORDED GENERATION SOFTWARE\")\n",
        "\n",
        "recorded_versions = {\n",
        "    \"Python\": \"3.13.18\",\n",
        "    \"PyTorch\": \"2.14.1+cpu\",\n",
        "    \"torchvision\": \"0.29.1+cpu\",\n",
        "    \"facenet-pytorch\": \"2.6.0\"\n",
        "}\n",
        "\n",
        "for package, version in recorded_versions.items():\n",
        "    print(f\"{package}: {version}\")\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 3. Inspect possible cached model weights\n",
        "# --------------------------------------------------\n",
        "\n",
        "print(\"\\n[3] LOCAL MODEL WEIGHT CACHE INSPECTION\")\n",
        "\n",
        "candidate_roots = [\n",
        "    Path(\"/root/.cache/torch\"),\n",
        "    Path(\"/root/.cache/torch/checkpoints\"),\n",
        "    Path(\"/root/.cache\"),\n",
        "    Path(\"/root/.keras-facenet\"),\n",
        "    Path(\"/content\")\n",
        "]\n",
        "\n",
        "extensions = {\".pth\", \".pt\", \".ckpt\", \".h5\"}\n",
        "\n",
        "candidates = set()\n",
        "\n",
        "for root in candidate_roots:\n",
        "    if not root.exists():\n",
        "        continue\n",
        "\n",
        "    try:\n",
        "        for path in root.rglob(\"*\"):\n",
        "            if (\n",
        "                path.is_file()\n",
        "                and path.suffix.lower() in extensions\n",
        "                and any(\n",
        "                    term in path.name.lower()\n",
        "                    for term in [\"facenet\", \"inception\", \"vggface\"]\n",
        "                )\n",
        "            ):\n",
        "                candidates.add(path)\n",
        "\n",
        "    except (PermissionError, OSError):\n",
        "        continue\n",
        "\n",
        "if not candidates:\n",
        "    print(\"No matching local FaceNet weight files found.\")\n",
        "\n",
        "else:\n",
        "    for path in sorted(candidates):\n",
        "        print(\"\\nCandidate:\", path)\n",
        "        print(\"Size:\", path.stat().st_size, \"bytes\")\n",
        "\n",
        "        digest = hashlib.sha256()\n",
        "\n",
        "        with path.open(\"rb\") as file:\n",
        "            for chunk in iter(\n",
        "                lambda: file.read(1024 * 1024),\n",
        "                b\"\"\n",
        "            ):\n",
        "                digest.update(chunk)\n",
        "\n",
        "        print(\"SHA-256:\", digest.hexdigest())\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 4. Final status\n",
        "# --------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 85)\n",
        "print(\"STEP 3.1.10 INSPECTION SUMMARY\")\n",
        "print(\"=\" * 85)\n",
        "\n",
        "print(\"Resize invocation in original notebook:\")\n",
        "print(\"transforms.Resize((160, 160))\")\n",
        "\n",
        "print(\"Interpolation explicitly specified: NO\")\n",
        "print(\"Model initialization: InceptionResnetV1(pretrained='vggface2')\")\n",
        "print(\"Embedding regeneration: NO\")\n",
        "print(\"Existing experiment artifacts modified: NO\")\n",
        "\n",
        "print(\"=\" * 85)"
      ],
      "metadata": {
