        "\n",
        "import os\n",
        "import re\n",
        "import json\n",
        "import hashlib\n",
        "import pandas as pd\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "BASE = \"/content/drive/MyDrive/Experiment_20_Results\"\n",
        "\n",
        "MANUSCRIPT = os.path.join(\n",
        "    BASE, \"step_3_3\", \"step_3330\",\n",
        "    \"experiment20_integrated_manuscript_v2.md\"\n",
        ")\n",
        "\n",
        "FREEZE = os.path.join(\n",
        "    BASE, \"step_2_7\", \"final_freeze\"\n",
        ")\n",
        "\n",
        "PHASE35_REPORT = os.path.join(\n",
        "    BASE, \"step_3_5_discussion_limitations\",\n",
        "    \"experiment20_phase35_discussion_limitations_audit.json\"\n",
        ")\n",
        "\n",
        "OUTPUT_DIR = os.path.join(\n",
        "    BASE, \"step_3_6_abstract_conclusion\"\n",
        ")\n",
        "os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
        "\n",
        "REPORT_PATH = os.path.join(\n",
        "    OUTPUT_DIR,\n",
        "    \"experiment20_phase36_abstract_conclusion_audit.json\"\n",
        ")\n",
        "\n",
        "EXPECTED_HASH = (\n",
        "    \"2cc4156af63987fae717c37e997e6478e4253d81f584854fb5fab9f18da5e752\"\n",
        ")\n",
        "\n",
        "\n",
        "def sha256_file(path):\n",
        "    h = hashlib.sha256()\n",
        "    with open(path, \"rb\") as f:\n",
        "        for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n",
        "            h.update(chunk)\n",
        "    return h.hexdigest()\n",
        "\n",
        "\n",
        "def extract_section(text, pattern, next_pattern=None):\n",
        "    match = re.search(pattern, text, flags=re.I | re.M)\n",
        "\n",
        "    if not match:\n",
        "        return None\n",
        "\n",
        "    start = match.start()\n",
        "\n",
        "    if next_pattern:\n",
        "        next_match = re.search(\n",
        "            next_pattern,\n",
        "            text[match.end():],\n",
        "            flags=re.I | re.M\n",
        "        )\n",
        "\n",
        "        if next_match:\n",
        "            return text[start:match.end() + next_match.start()]\n",
        "\n",
        "    return text[start:]\n",
        "\n",
        "\n",
        "print(\"=\" * 100)\n",
        "print(\"EXPERIMENT 20 — PHASE 3.6\")\n",
        "print(\"ABSTRACT AND CONCLUSION AUDIT\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. LOAD AND VERIFY MANUSCRIPT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "assert os.path.isfile(MANUSCRIPT), \"Manuscript v2 missing.\"\n",
        "assert os.path.isfile(PHASE35_REPORT), \"Phase 3.5 report missing.\"\n",
        "\n",
        "with open(MANUSCRIPT, \"r\", encoding=\"utf-8\") as f:\n",
        "    manuscript = f.read()\n",
        "\n",
        "manuscript_hash = sha256_file(MANUSCRIPT)\n",
        "\n",
        "assert manuscript_hash == EXPECTED_HASH, (\n",
        "    \"Manuscript hash differs from the verified version.\"\n",
        ")\n",
        "\n",
        "with open(PHASE35_REPORT, \"r\", encoding=\"utf-8\") as f:\n",
        "    phase35 = json.load(f)\n",
        "\n",
        "print(\"\\nManuscript SHA256:\", manuscript_hash)\n",
        "print(\"Phase 3.5 status:\", phase35.get(\"status\"))\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. EXTRACT ABSTRACT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "abstract = extract_section(\n",
        "    manuscript,\n",
        "    r\"^#{1,3}\\s*Abstract\\b\",\n",
        "    r\"^#{1,3}\\s*(?:1\\.?\\s*)Introduction\\b\"\n",
        ")\n",
        "\n",
        "assert abstract, \"Abstract heading not found.\"\n",
        "\n",
        "print(\"\\nABSTRACT WORD COUNT:\", len(abstract.split()))\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. EXTRACT CONCLUSION OR CONCLUDING SUBSECTION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "standalone_conclusion = extract_section(\n",
        "    manuscript,\n",
        "    r\"^#{1,3}\\s*(?:5\\.?\\s*)Conclusion\\b\",\n",
        "    r\"^#{1,3}\\s*References\\b\"\n",
        ")\n",
        "\n",
        "if standalone_conclusion:\n",
        "\n",
        "    conclusion = standalone_conclusion\n",
        "    conclusion_type = \"Standalone Conclusion section\"\n",
        "\n",
        "else:\n",
        "\n",
        "    conclusion = extract_section(\n",
        "        manuscript,\n",
        "        r\"^#{1,3}\\s*##?\\s*4\\.8\\s+Overall discussion\\b\",\n",
        "        r\"^#{1,3}\\s*References\\b\"\n",
        "    )\n",
        "\n",
        "    conclusion_type = (\n",
        "        \"Section 4.8 Overall discussion used as concluding subsection\"\n",
        "        if conclusion else\n",
        "        \"No identifiable standalone conclusion or concluding subsection\"\n",
        "    )\n",
        "\n",
        "assert conclusion, (\n",
        "    \"Neither a standalone Conclusion nor Section 4.8 was identified.\"\n",
        ")\n",
        "\n",
        "print(\"\\nCONCLUSION TYPE:\", conclusion_type)\n",
        "print(\"CONCLUSION WORD COUNT:\", len(conclusion.split()))\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. ABSTRACT CONTENT CHECKS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "abstract_checks = {\n",
        "    \"research_objective_present\": (\n",
        "        \"reference-relative\" in abstract.lower()\n",
        "        or \"embedding displacement\" in abstract.lower()\n",
        "    ),\n",
        "\n",
        "    \"dataset_identified\": (\n",
        "        \"yale\" in abstract.lower()\n",
        "    ),\n",
        "\n",
