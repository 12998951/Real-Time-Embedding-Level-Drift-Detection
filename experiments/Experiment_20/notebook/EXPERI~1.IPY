        "\n",
        "overall = {\n",
        "    \"observations\": len(d),\n",
        "    \"identities\": d[\"subject\"].nunique(),\n",
        "    \"evaluation_conditions\": d[\"evaluation_condition\"].nunique(),\n",
        "    \"euclidean_mean\": d[\"euclidean_displacement\"].mean(),\n",
        "    \"euclidean_median\": d[\"euclidean_displacement\"].median(),\n",
        "    \"euclidean_sd\": d[\"euclidean_displacement\"].std(),\n",
        "    \"cosine_mean\": d[\"cosine_distance\"].mean(),\n",
