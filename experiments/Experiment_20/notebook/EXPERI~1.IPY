        "\n",
        "print(\"\\nSCIENTIFIC INTERPRETATION\")\n",
        "\n",
        "for name, passed in interpretation_checks.items():\n",
        "    print((\"PASS\" if passed else \"REVIEW\"), name)\n",
        "\n",
        "print(\"\\nFlagged issues:\", len(issues))\n",
        "\n",
        "for issue in issues:\n",
        "    print(\n",
        "        issue[\"type\"],\n",
        "        \"|\",\n",
        "        issue[\"category\"],\n",
        "        \"|\",\n",
        "        issue[\"issue\"]\n",
        "    )\n",
        "\n",
        "print(\"\\nFINAL STATUS:\", report[\"status\"])\n",
        "print(\"Report:\", REPORT_PATH)\n",
        "print(\"Report SHA256:\", sha256_file(REPORT_PATH))\n",
        "print(\"No existing manuscript or evidence files were modified.\")\n",
        "print(\"PHASE 3.4 AUDIT COMPLETED\")"
