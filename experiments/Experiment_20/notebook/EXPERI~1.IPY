        "# ------------------------------------------------------------\n",
        "# 4. HELPER FUNCTIONS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "checks = {}\n",
        "\n",
        "def record(name, condition):\n",
        "    checks[name] = bool(condition)\n",
        "\n",
        "def close(a, b, tolerance=1e-9):\n",
        "    return bool(\n",
        "        np.isclose(\n",
        "            float(a),\n",
        "            float(b),\n",
        "            atol=tolerance,\n",
        "            rtol=1e-8\n",
        "        )\n",
        "    )\n",
        "\n",
        "def sha256(path):\n",
        "    return hashlib.sha256(path.read_bytes()).hexdigest()\n",
