      "source": [
        "# Experiment 20 — Step 3.3.35: Table 1 Source Recovery\n",
        "\n",
        "## Objective\n",
        "Locate the authoritative descriptive-statistics CSV used for Table 1 and determine whether its values agree with manuscript v2.\n",
        "\n",
        "## Checks\n",
        "1. Search Experiment_20_Results for CSV files with descriptive-statistics or group-summary names.\n",
        "2. Identify candidate files and inspect their schemas.\n",
        "3. Compare candidate group means and standard deviations with Table 1.\n",
        "4. Verify observation counts, identity counts, and condition counts where available.\n",
        "5. Record each candidate's SHA256 and provenance path.\n",
        "\n",
        "## Integrity restrictions\n",
        "- Do not modify or regenerate any source data.\n",
        "- Do not assume a similarly named file is authoritative.\n",
        "- Do not substitute identity-level means for pooled observation-level statistics.\n",
        "- Do not change the manuscript.\n",
        "\n",
        "## Expected outcome\n",
        "Identify the correct Table 1 source, or document that its original source cannot yet be established."
      ],
      "metadata": {
        "id": "yUwkr84MLNT0"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# EXPERIMENT 20 — STEP 3.3.35\n",
        "# TABLE 1 SOURCE RECOVERY AND VERIFICATION\n",
        "# READ-ONLY\n",
        "# ============================================================\n",
        "\n",
        "import os\n",
        "import re\n",
        "import json\n",
        "import hashlib\n",
        "import pandas as pd\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "BASE = \"/content/drive/MyDrive/Experiment_20_Results\"\n",
        "\n",
        "MANUSCRIPT = os.path.join(\n",
        "    BASE, \"step_3_3\", \"step_3330\",\n",
        "    \"experiment20_integrated_manuscript_v2.md\"\n",
        ")\n",
        "\n",
        "OUTPUT_DIR = os.path.join(\n",
        "    BASE, \"step_3_3\", \"step_3335\"\n",
        ")\n",
        "os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
        "\n",
        "REPORT_PATH = os.path.join(\n",
        "    OUTPUT_DIR,\n",
        "    \"experiment20_step3335_table1_source_recovery.json\"\n",
        ")\n",
        "\n",
        "\n",
        "def sha256_file(path):\n",
        "    h = hashlib.sha256()\n",
        "    with open(path, \"rb\") as f:\n",
        "        for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n",
        "            h.update(chunk)\n",
        "    return h.hexdigest()\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. READ TABLE 1 FROM MANUSCRIPT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "with open(MANUSCRIPT, \"r\", encoding=\"utf-8\") as f:\n",
        "    manuscript = f.read()\n",
        "\n",
        "lines = manuscript.splitlines()\n",
        "\n",
        "table1_start = next(\n",
        "    i for i, line in enumerate(lines)\n",
        "    if \"Table 1. Descriptive statistics by illumination geometry group\" in line\n",
        ")\n",
        "\n",
        "table1_lines = []\n",
        "\n",
        "for line in lines[table1_start + 1:]:\n",
        "    if line.strip().startswith(\"|\"):\n",
        "        table1_lines.append(line)\n",
        "    elif table1_lines:\n",
        "        break\n",
        "\n",
        "print(\"=\" * 100)\n",
        "print(\"STEP 3.3.35 — TABLE 1 SOURCE RECOVERY\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "print(\"\\nMANUSCRIPT TABLE 1\")\n",
        "for line in table1_lines:\n",
        "    print(line)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. SEARCH ALL CSV FILES\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "candidates = []\n",
        "\n",
        "for root, dirs, files in os.walk(BASE):\n",
        "\n",
        "    # Skip hidden/system directories\n",
        "    dirs[:] = [\n",
        "        d for d in dirs\n",
        "        if not d.startswith(\".\")\n",
        "    ]\n",
        "\n",
        "    for filename in files:\n",
        "\n",
        "        if not filename.lower().endswith(\".csv\"):\n",
        "            continue\n",
        "\n",
        "        path = os.path.join(root, filename)\n",
        "        lower = filename.lower()\n",
        "\n",
        "        if any(term in lower for term in [\n",
        "            \"descriptive\",\n",
        "            \"group_summary\",\n",
        "            \"group_statistics\",\n",
        "            \"group_stats\",\n",
        "            \"illumination_group\",\n",
        "            \"summary_statistics\",\n",
        "            \"summary_stats\"\n",
        "        ]):\n",
        "            candidates.append(path)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"CSV CANDIDATES\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "candidate_records = []\n",
        "\n",
        "for path in sorted(set(candidates)):\n",
        "\n",
        "    try:\n",
        "        df = pd.read_csv(path)\n",
        "\n",
        "        record = {\n",
        "            \"path\": path,\n",
        "            \"filename\": os.path.basename(path),\n",
        "            \"sha256\": sha256_file(path),\n",
        "            \"rows\": len(df),\n",
        "            \"columns\": list(df.columns),\n",
        "            \"readable\": True\n",
        "        }\n",
        "\n",
        "        candidate_records.append(record)\n",
        "\n",
        "        print(\"\\nFILE:\", path)\n",
        "        print(\"SHA256:\", record[\"sha256\"])\n",
        "        print(\"Rows:\", record[\"rows\"])\n",
        "        print(\"Columns:\", record[\"columns\"])\n",
        "        print(df.head(5).to_string(index=False))\n",
        "\n",
        "    except Exception as exc:\n",
        "\n",
        "        candidate_records.append({\n",
        "            \"path\": path,\n",
        "            \"filename\": os.path.basename(path),\n",
        "            \"readable\": False,\n",
        "            \"error\": str(exc)\n",
        "        })\n",
        "\n",
        "        print(\"\\nUNREADABLE:\", path, str(exc))\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. SEARCH CSV CONTENTS FOR EXPECTED GROUP LABELS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "content_matches = []\n",
        "\n",
        "for record in candidate_records:\n",
        "\n",
        "    if not record.get(\"readable\"):\n",
        "        continue\n",
        "\n",
        "    path = record[\"path\"]\n",
        "\n",
        "    try:\n",
        "        df = pd.read_csv(path)\n",
        "\n",
        "        searchable = \" \".join(\n",
        "            str(value).lower()\n",
        "            for value in df.astype(str).values.flatten()\n",
        "        )\n",
        "\n",
        "        labels_found = {\n",
        "            \"near_frontal\": \"near_frontal\" in searchable,\n",
        "            \"oblique\": \"oblique\" in searchable,\n",
        "            \"large_angular_deviation\": (\n",
        "                \"large_angular_deviation\" in searchable\n",
        "            )\n",
        "        }\n",
        "\n",
        "        if all(labels_found.values()):\n",
        "            content_matches.append({\n",
        "                \"path\": path,\n",
        "                \"sha256\": record[\"sha256\"],\n",
        "                \"rows\": len(df),\n",
        "                \"columns\": list(df.columns),\n",
        "                \"labels_found\": labels_found\n",
        "            })\n",
        "\n",
        "    except Exception:\n",
        "        pass\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. CHECK FINAL-FREEZE IDENTITY DATA\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "IDENTITY_FILE = os.path.join(\n",
        "    BASE, \"step_2_7\", \"final_freeze\",\n",
        "    \"experiment20_identity_level_group_means.csv\"\n",
        ")\n",
        "\n",
        "identity_file_check = {\n",
        "    \"exists\": os.path.isfile(IDENTITY_FILE)\n",
        "}\n",
        "\n",
        "if identity_file_check[\"exists\"]:\n",
        "\n",
        "    identity_df = pd.read_csv(IDENTITY_FILE)\n",
        "\n",
        "    identity_file_check.update({\n",
        "        \"sha256\": sha256_file(IDENTITY_FILE),\n",
        "        \"rows\": len(identity_df),\n",
        "        \"columns\": list(identity_df.columns),\n",
        "        \"group_counts\": (\n",
        "            identity_df[\"illumination_group\"]\n",
        "            .value_counts()\n",
        "            .to_dict()\n",
        "        )\n",
        "    })\n",
        "\n",
        "    print(\"\\nIDENTITY-LEVEL SOURCE\")\n",
        "    print(json.dumps(identity_file_check, indent=2, default=str))\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. REPORT — DO NOT ASSUME A CANDIDATE IS AUTHORITATIVE\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "report = {\n",
        "    \"step\": \"3.3.35\",\n",
        "    \"created_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "\n",
        "    \"manuscript\": {\n",
        "        \"path\": MANUSCRIPT,\n",
        "        \"sha256\": sha256_file(MANUSCRIPT)\n",
        "    },\n",
        "\n",
        "    \"table1_markdown\": table1_lines,\n",
        "\n",
        "    \"candidate_csv_files\": candidate_records,\n",
        "    \"candidate_files_containing_all_group_labels\": content_matches,\n",
        "\n",
        "    \"identity_level_source\": identity_file_check,\n",
        "\n",
        "    \"interpretation\": (\n",
        "        \"A candidate file is not automatically authoritative. \"\n",
        "        \"Its provenance and statistical unit must be established \"\n",
        "        \"before using it to validate pooled observation-level \"\n",
        "        \"descriptive statistics.\"\n",
        "    ),\n",
        "\n",
        "    \"status\": (\n",
        "        \"CANDIDATE_TABLE1_SOURCE_FOUND_MANUAL_PROVENANCE_REVIEW_REQUIRED\"\n",
        "        if content_matches\n",
        "        else \"TABLE1_SOURCE_NOT_IDENTIFIED\"\n",
        "    ),\n",
        "\n",
        "    \"integrity\": {\n",
        "        \"manuscript_modified\": False,\n",
        "        \"csv_files_modified\": False,\n",
        "        \"frozen_evidence_modified\": False\n",
        "    }\n",
        "}\n",
        "\n",
        "with open(REPORT_PATH, \"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(report, f, indent=2, default=str)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"FINAL STATUS\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "print(\"Candidate CSV files:\", len(candidate_records))\n",
