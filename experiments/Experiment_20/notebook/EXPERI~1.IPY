            "\n",
            "print(\"\\n5. SCIENTIFIC INTERPRETATION\")\n",
            "\n",
            "print(\n",
            "    f\"\\nEuclidean detector:\"\n",
            "    f\"\\n  Original score: {original['Euclidean']:.6f}\"\n",
            "    f\"\\n  Low illumination: {low['Euclidean']:.6f}\"\n",
            "    f\"\\n  High illumination: {high['Euclidean']:.6f}\"\n",
            "    f\"\\n  Low illumination increase: \"\n",
            "    f\"{aggregate_findings.loc[0, 'Low Change (%)']:.2f}%\"\n",
