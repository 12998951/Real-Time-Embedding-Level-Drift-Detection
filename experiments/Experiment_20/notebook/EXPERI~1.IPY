elist():\\n\",\"            print(f\\\"MISSING FROM ZIP: {filename}\\\")\\n\",\"            continue\\n\",\"\\n\",\"        archived_hash = hashlib.sha256(\\n\",\"            archive.read(filename)\\n\",\"        ).hexdigest()\\n\",\"\\n\",\"        repo_path = os.path.join(REPO_RESULTS, filename)\\n\",\"        repo_hash = sha256(repo_path)\\n\",\"\\n\",\"        print(\\n\",\"            f\\\"{filename}:\\\",\\n\",\"            \\\"MATCH\\\" if archived_hash == repo_hash else \\\"DIFFERENT\\\"\\n\",\"        )\\n\",\"\\n\",\"print(\\\"\\\\n[3] GIT STAGING DIAGNOSTICS\\\")\\n\",\"\\n\",\"commands = [\\n\",\"    [\\\"git\\\", \\\"status\\\", \\\"--porcelain=v2\\\"],\\n\",\"    [\\\"git\\\", \\\"diff\\\", \\\"--cached\\\", \\\"--raw\\\"],\\n\",\"    [\\\"git\\\", \\\"diff\\\", \\\"--cached\\\", \\\"--numstat\\\"],\\n\",\"    [\\\"git\\\", \\\"diff\\\", \\\"--cached\\\", \\\"--name-status\\\"],\\n\",\"    [\\\"git\\\", \\\"ls-files\\\", \\\"--stage\\\", \\\"--\\\", \\\"results/\\\"]\\n\",\"]\\n\",\"\\n\",\"for command in commands:\\n\",\"    print(\\\"\\\\nCOMMAND:\\\", \\\" \\\".join(command))\\n\",\"\\n\",\"    result = subprocess.run(\\n\",\"        command,\\n\",\"        capture_output=True,\\n\",\"        text=True\\n\",\"    )\\n\",\"\\n\",\"    print(\\\"Exit code:\\\", result.returncode)\\n\",\"    print(result.stdout.strip() or \\\"[NO OUTPUT]\\\")\\n\",\"\\n\",\"    if result.stderr.strip():\\n\",\"        print(\\\"ERROR:\\\", result.stderr.strip())\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 3.3 AUDIT COMPLETED — NO FILES MODIFIED\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 147\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"\\n\",\"import os\\n\",\"import shutil\\n\",\"import zipfile\\n\",\"import hashlib\\n\",\"import subprocess\\n\",\"\\n\",\"DRIVE_DIR = \\\"/content/drive/MyDrive/Experiment_18_Results\\\"\\n\",\"REPO_DIR = \\\"/content/Real-Time-Embedding-Level-Drift-Detection\\\"\\n\",\"REPO_RESULTS = os.path.join(REPO_DIR, \\\"results\\\")\\n\",\"\\n\",\"ZIP_NAME = \\\"Experiment_18_Final_Research_Package.zip\\\"\\n\",\"\\n\",\"SOURCE_FILES = [\\n\",\"    \\\"experiment18_facenet_lfw_embeddings.npz\\\",\\n\",\"    \\\"experiment18_final_research_evidence.json\\\",\\n\",\"    \\\"experiment18_final_research_evidence.md\\\",\\n\",\"    \\\"experiment18_illumination_results.npz\\\",\\n\",\"    \\\"illumination_identity_summary.csv\\\",\\n\",\"    \\\"illumination_metadata.json\\\"\\n\",\"]\\n\",\"\\n\",\"ALL_FILES = SOURCE_FILES + [ZIP_NAME]\\n\",\"\\n\",\"def sha256(path):\\n\",\"    digest = hashlib.sha256()\\n\",\"    with open(path, \\\"rb\\\") as f:\\n\",\"        for chunk in iter(lambda: f.read(1024 * 1024), b\\\"\\\"):\\n\",\"            digest.update(chunk)\\n\",\"    return digest.hexdigest()\\n\",\"\\n\",\"os.makedirs(REPO_RESULTS, exist_ok=True)\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"STEP 3.4 — RESEARCH PACKAGE SYNCHRONIZATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"# 1. Verify authoritative Drive source files\\n\",\"for filename in SOURCE_FILES:\\n\",\"    path = os.path.join(DRIVE_DIR, filename)\\n\",\"    if not os.path.isfile(path):\\n\",\"        raise FileNotFoundError(f\\\"Missing Drive source: {filename}\\\")\\n\",\"\\n\",\"print(\\\"\\\\n[1] All six Drive source files found.\\\")\\n\",\"\\n\",\"# 2. Rebuild ZIP from the latest Drive source files\\n\",\"drive_zip = os.path.join(DRIVE_DIR, ZIP_NAME)\\n\",\"\\n\",\"with zipfile.ZipFile(\\n\",\"    drive_zip,\\n\",\"    \\\"w\\\",\\n\",\"    compression=zipfile.ZIP_DEFLATED\\n\",\") as archive:\\n\",\"\\n\",\"    for filename in SOURCE_FILES:\\n\",\"        archive.write(\\n\",\"            os.path.join(DRIVE_DIR, filename),\\n\",\"            arcname=filename\\n\",\"        )\\n\",\"\\n\",\"print(\\\"[2] ZIP rebuilt from current Drive files.\\\")\\n\",\"\\n\",\"# 3. Verify ZIP integrity and contents\\n\",\"with zipfile.ZipFile(drive_zip, \\\"r\\\") as archive:\\n\",\"\\n\",\"    assert sorted(archive.namelist()) == sorted(SOURCE_FILES)\\n\",\"    assert archive.testzip() is None\\n\",\"\\n\",\"    for filename in SOURCE_FILES:\\n\",\"        archived_hash = hashlib.sha256(\\n\",\"            archive.read(filename)\\n\",\"        ).hexdigest()\\n\",\"\\n\",\"        source_hash = sha256(\\n\",\"            os.path.join(DRIVE_DIR, filename)\\n\",\"        )\\n\",\"\\n\",\"        assert archived_hash == source_hash, (\\n\",\"            f\\\"ZIP content mismatch: {filename}\\\"\\n\",\"        )\\n\",\"\\n\",\"print(\\\"[3] ZIP integrity and internal file checks passed.\\\")\\n\",\"\\n\",\"# 4. Copy all seven current files into repository\\n\",\"for filename in ALL_FILES:\\n\",\"\\n\",\"    source = os.path.join(DRIVE_DIR, filename)\\n\",\"    destination = os.path.join(REPO_RESULTS, filename)\\n\",\"\\n\",\"    shutil.copy2(source, destination)\\n\",\"\\n\",\"print(\\\"[4] Seven files copied into repository.\\\")\\n\",\"\\n\",\"# 5. Verify Drive and repository hashes\\n\",\"print(\\\"\\\\n[5] SHA-256 VERIFICATION\\\")\\n\",\"\\n\",\"for filename in ALL_FILES:\\n\",\"\\n\",\"    drive_path = os.path.join(DRIVE_DIR, filename)\\n\",\"    repo_path = os.path.join(REPO_RESULTS, filename)\\n\",\"\\n\",\"    match = sha256(drive_path) == sha256(repo_path)\\n\",\"\\n\",\"    print(\\n\",\"        f\\\"{'PASS' if match else 'FAIL'}: {filename}\\\"\\n\",\"    )\\n\",\"\\n\",\"    assert match, f\\\"Hash mismatch: {filename}\\\"\\n\",\"\\n\",\"# 6. Stage the synchronized files\\n\",\"os.chdir(REPO_DIR)\\n\",\"\\n\",\"subprocess.run(\\n\",\"    [\\\"git\\\", \\\"add\\\", \\\"--\\\"] +\\n\",\"    [\\\"results/\\\" + filename for filename in ALL_FILES],\\n\",\"    check=True\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n[6] Git staging refreshed.\\\")\\n\",\"\\n\",\"print(\\\"\\\\nGit staged changes:\\\")\\n\",\"subprocess.run(\\n\",\"    [\\\"git\\\", \\\"diff\\\", \\\"--cached\\\", \\\"--name-status\\\"],\\n\",\"    check=True\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 3.4 COMPLETED\\\")\\n\",\"print(\\\"All seven files synchronized and staged.\\\")\\n\",\"print(\\\"No commit created.\\\")\\n\",\"print(\\\"No push performed.\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 148\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"\\n\",\"import os\\n\",\"import subprocess\\n\",\"\\n\",\"REPO_DIR = \\\"/content/Real-Time-Embedding-Level-Drift-Detection\\\"\\n\",\"\\n\",\"os.chdir(REPO_DIR)\\n\",\"\\n\",\"commands = [\\n\",\"    [\\\"git\\\", \\\"status\\\", \\\"--short\\\"],\\n\",\"    [\\\"git\\\", \\\"diff\\\", \\\"--cached\\\", \\\"--name-status\\\"],\\n\",\"    [\\\"git\\\", \\\"diff\\\", \\\"--cached\\\", \\\"--stat\\\"],\\n\",\"    [\\\"git\\\", \\\"diff\\\", \\\"--name-status\\\"],\\n\",\"    [\\\"git\\\", \\\"status\\\", \\\"--branch\\\"]\\n\",\"]\\n\",\"\\n\",\"labels = [\\n\",\"    \\\"Working tree status\\\",\\n\",\"    \\\"Staged file changes\\\",\\n\",\"    \\\"Staged change summary\\\",\\n\",\"    \\\"Unstaged changes\\\",\\n\",\"    \\\"Branch and repository status\\\"\\n\",\"]\\n\",\"\\n\",\"print(\\\"=\\\" * 70)\\n\",\"print(\\\"STEP 3.5 — FINAL GIT STAGING VERIFICATION\\\")\\n\",\"print(\\\"=\\\" * 70)\\n\",\"\\n\",\"for label, command in zip(labels, commands):\\n\",\"\\n\",\"    print(f\\\"\\\\n--- {label} ---\\\")\\n\",\"\\n\",\"    result = subprocess.run(\\n\",\"        command,\\n\",\"        capture_output=True,\\n\",\"        text=True\\n\",\"    )\\n\",\"\\n\",\"    print(result.stdout.strip() or \\\"[NO OUTPUT]\\\")\\n\",\"\\n\",\"    if result.returncode != 0:\\n\",\"        print(\\\"ERROR:\\\", result.stderr)\\n\",\"        raise RuntimeError(f\\\"Command failed: {label}\\\")\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 70)\\n\",\"print(\\\"STEP 3.5 DIAGNOSTIC COMPLETED\\\")\\n\",\"print(\\\"=\\\" * 70)\\n\",\"\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 149\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"import os\\n\",\"\\n\",\"SOURCE_DIR = \\\"/content/drive/MyDrive/Experiment_18_Results\\\"\\n\",\"\\n\",\"expected_files = [\\n\",\"    \\\"experiment18_facenet_lfw_embeddings.npz\\\",\\n\",\"    \\\"experiment18_illumination_results.npz\\\",\\n\",\"    \\\"illumination_identity_summary.csv\\\",\\n\",\"    \\\"illumination_metadata.json\\\",\\n\",\"    \\\"experiment18_final_research_evidence.md\\\",\\n\",\"    \\\"experiment18_final_research_evidence.json\\\",\\n\",\"    \\\"Experiment_18_Final_Research_Package.zip\\\"\\n\",\"]\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"STEP 4 — EXPERIMENT 18 SOURCE FILE VERIFICATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"all_found = True\\n\",\"\\n\",\"for filename in expected_files:\\n\",\"    path = os.path.join(SOURCE_DIR, filename)\\n\",\"\\n\",\"    if os.path.isfile(path):\\n\",\"        size = os.path.getsize(path)\\n\",\"        print(f\\\"[FOUND] {filename} | {size:,} bytes\\\")\\n\",\"    else:\\n\",\"        print(f\\\"[MISSING] {filename}\\\")\\n\",\"        all_found = False\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"\\n\",\"if all_found:\\n\",\"    print(\\\"RESULT: ALL SEVEN FILES VERIFIED.\\\")\\n\",\"else:\\n\",\"    print(\\\"RESULT: MISSING FILES DETECTED. DO NOT COPY YET.\\\")\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 150\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"import os\\n\",\"import subprocess\\n\",\"\\n\",\"REPO_DIR = \\\"/content/Real-Time-Embedding-Level-Drift-Detection\\\"\\n\",\"\\n\",\"files_to_publish = [\\n\",\"    \\\"experiment18_facenet_lfw_embeddings.npz\\\",\\n\",\"    \\\"experiment18_illumination_results.npz\\\",\\n\",\"    \\\"illumination_identity_summary.csv\\\",\\n\",\"    \\\"illumination_metadata.json\\\",\\n\",\"    \\\"experiment18_final_research_evidence.md\\\",\\n\",\"    \\\"experiment18_final_research_evidence.json\\\",\\n\",\"    \\\"Experiment_18_Final_Research_Package.zip\\\"\\n\",\"]\\n\",\"\\n\",\"DEST_DIR = os.path.join(REPO_DIR, \\\"results\\\")\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"STEP 5 — GITHUB DESTINATION AND IGNORE-RULE AUDIT\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"assert os.path.isdir(os.path.join(REPO_DIR, \\\".git\\\")), \\\\\\n\",\"    \\\"Repository clone not found. Stop.\\\"\\n\",\"\\n\",\"print(\\\"\\\\nRepository:\\\")\\n\",\"print(REPO_DIR)\\n\",\"\\n\",\"print(\\\"\\\\nBranch:\\\")\\n\",\"print(subprocess.check_output(\\n\",\"    [\\\"git\\\", \\\"branch\\\", \\\"--show-current\\\"],\\n\",\"    cwd=REPO_DIR, text=True\\n\",\").strip())\\n\",\"\\n\",\"print(\\\"\\\\nRemote:\\\")\\n\",\"print(subprocess.check_output(\\n\",\"    [\\\"git\\\", \\\"remote\\\", \\\"-v\\\"],\\n\",\"    cwd=REPO_DIR, text=True\\n\",\"))\\n\",\"\\n\",\"print(\\\"\\\\nDestination checks:\\\")\\n\",\"\\n\",\"for filename in files_to_publish:\\n\",\"    relative_path = f\\\"results/{filename}\\\"\\n\",\"    full_path = os.path.join(REPO_DIR, relative_path)\\n\",\"\\n\",\"    exists = os.path.exists(full_path)\\n\",\"\\n\",\"    ignore_check = subprocess.run(\\n\",\"        [\\\"git\\\", \\\"check-ignore\\\", \\\"-v\\\", relative_path],\\n\",\"        cwd=REPO_DIR,\\n\",\"        capture_output=True,\\n\",\"        text=True\\n\",\"    )\\n\",\"\\n\",\"    ignored = ignore_check.returncode == 0\\n\",\"\\n\",\"    print(f\\\"\\\\n{relative_path}\\\")\\n\",\"    print(f\\\"  Already exists: {'YES' if exists else 'NO'}\\\")\\n\",\"    print(f\\\"  Git ignored:    {'YES' if ignored else 'NO'}\\\")\\n\",\"\\n\",\"    if ignored:\\n\",\"        print(f\\\"  Ignore rule:    {ignore_check.stdout.strip()}\\\")\\n\",\"\\n\",\"print(\\\"\\\\nCurrent Git status:\\\")\\n\",\"status = subprocess.check_output(\\n\",\"    [\\\"git\\\", \\\"status\\\", \\\"--short\\\"],\\n\",\"    cwd=REPO_DIR,\\n\",\"    text=True\\n\",\")\\n\",\"print(status if status.strip() else \\\"CLEAN\\\")\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 5 — AUDIT COMPLETED. NO FILES COPIED OR MODIFIED.\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 151\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"import os\\n\",\"import shutil\\n\",\"import hashlib\\n\",\"\\n\",\"SOURCE_DIR = \\\"/content/drive/MyDrive/Experiment_18_Results\\\"\\n\",\"REPO_DIR = \\\"/content/Real-Time-Embedding-Level-Drift-Detection\\\"\\n\",\"DEST_DIR = os.path.join(REPO_DIR, \\\"results\\\")\\n\",\"\\n\",\"files_to_copy = [\\n\",\"    \\\"experiment18_facenet_lfw_embeddings.npz\\\",\\n\",\"    \\\"experiment18_illumination_results.npz\\\",\\n\",\"    \\\"illumination_identity_summary.csv\\\",\\n\",\"    \\\"illumination_metadata.json\\\",\\n\",\"    \\\"experiment18_final_research_evidence.md\\\",\\n\",\"    \\\"experiment18_final_research_evidence.json\\\",\\n\",\"    \\\"Experiment_18_Final_Research_Package.zip\\\"\\n\",\"]\\n\",\"\\n\",\"assert os.path.isdir(os.path.join(REPO_DIR, \\\".git\\\")), \\\"Git repository not found.\\\"\\n\",\"assert os.path.isdir(SOURCE_DIR), \\\"Google Drive source directory not found.\\\"\\n\",\"assert os.path.isdir(DEST_DIR), \\\"Repository results directory not found.\\\"\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"STEP 6 — COPY EXPERIMENT 18 ARTIFACTS\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"# Stop rather than overwrite any destination file.\\n\",\"conflicts = [\\n\",\"    name for name in files_to_copy\\n\",\"    if os.path.exists(os.path.join(DEST_DIR, name))\\n\",\"]\\n\",\"\\n\",\"if conflicts:\\n\",\"    raise FileExistsError(\\n\",\"        \\\"Destination conflicts detected. No files copied: \\\" + \\\", \\\".join(conflicts)\\n\",\"    )\\n\",\"\\n\",\"def sha256(path):\\n\",\"    digest = hashlib.sha256()\\n\",\"    with open(path, \\\"rb\\\") as f:\\n\",\"        for block in iter(lambda: f.read(1024 * 1024), b\\\"\\\"):\\n\",\"            digest.update(block)\\n\",\"    return digest.hexdigest()\\n\",\"\\n\",\"for filename in files_to_copy:\\n\",\"    source = os.path.join(SOURCE_DIR, filename)\\n\",\"    destination = os.path.join(DEST_DIR, filename)\\n\",\"\\n\",\"    if not os.path.isfile(source):\\n\",\"        raise FileNotFoundError(f\\\"Source file missing: {source}\\\")\\n\",\"\\n\",\"    shutil.copy2(source, destination)\\n\",\"\\n\",\"    source_size = os.path.getsize(source)\\n\",\"    destination_size = os.path.getsize(destination)\\n\",\"\\n\",\"    source_hash = sha256(source)\\n\",\"    destination_hash = sha256(destination)\\n\",\"\\n\",\"    assert source_size == destination_size, f\\\"Size mismatch: {filename}\\\"\\n\",\"    assert source_hash == destination_hash, f\\\"Checksum mismatch: {filename}\\\"\\n\",\"\\n\",\"    print(f\\\"[VERIFIED] {filename}\\\")\\n\",\"    print(f\\\"           Size: {destination_size:,} bytes\\\")\\n\",\"    print(f\\\"           SHA-256: {destination_hash}\\\")\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"COPIED AND VERIFIED:\\\", len(files_to_copy), \\\"OF\\\", len(files_to_copy))\\n\",\"print(\\\"Git staging: NOT performed\\\")\\n\",\"print(\\\"Commit: NOT created\\\")\\n\",\"print(\\\"Push: NOT performed\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 152\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"import os\\n\",\"import subprocess\\n\",\"import hashlib\\n\",\"\\n\",\"REPO_DIR = \\\"/content/Real-Time-Embedding-Level-Drift-Detection\\\"\\n\",\"DEST_DIR = os.path.join(REPO_DIR, \\\"results\\\")\\n\",\"\\n\",\"files_to_check = [\\n\",\"    \\\"experiment18_facenet_lfw_embeddings.npz\\\",\\n\",\"    \\\"experiment18_illumination_results.npz\\\",\\n\",\"    \\\"illumination_identity_summary.csv\\\",\\n\",\"    \\\"illumination_metadata.json\\\",\\n\",\"    \\\"experiment18_final_research_evidence.md\\\",\\n\",\"    \\\"experiment18_final_research_evidence.json\\\",\\n\",\"    \\\"Experiment_18_Final_Research_Package.zip\\\"\\n\",\"]\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"STEP 7 — COPIED FILE AND GIT AUDIT\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"for filename in files_to_check:\\n\",\"    path = os.path.join(DEST_DIR, filename)\\n\",\"\\n\",\"    assert os.path.isfile(path), f\\\"Missing file: {filename}\\\"\\n\",\"\\n\",\"    digest = hashlib.sha256()\\n\",\"    with open(path, \\\"rb\\\") as f:\\n\",\"        for block in iter(lambda: f.read(1024 * 1024), b\\\"\\\"):\\n\",\"            digest.update(block)\\n\",\"\\n\",\"    print(f\\\"[PRESENT] {filename}\\\")\\n\",\"    print(f\\\"          {os.path.getsize(path):,} bytes\\\")\\n\",\"    print(f\\\"          SHA-256: {digest.hexdigest()}\\\")\\n\",\"\\n\",\"print(\\\"\\\\nGit status:\\\")\\n\",\"status = subprocess.check_output(\\n\",\"    [\\\"git\\\", \\\"status\\\", \\\"--short\\\"],\\n\",\"    cwd=REPO_DIR,\\n\",\"    text=True\\n\",\")\\n\",\"print(status if status.strip() else \\\"No changes detected\\\")\\n\",\"\\n\",\"print(\\\"\\\\nGit diff summary:\\\")\\n\",\"diff = subprocess.run(\\n\",\"    [\\\"git\\\", \\\"diff\\\", \\\"--stat\\\"],\\n\",\"    cwd=REPO_DIR,\\n\",\"    capture_output=True,\\n\",\"    text=True\\n\",\")\\n\",\"print(diff.stdout if diff.stdout.strip() else \\\"No tracked-file modifications\\\")\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"AUDIT COMPLETE — NO STAGING, COMMIT OR PUSH.\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 153\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"import subprocess\\n\",\"\\n\",\"REPO_DIR = \\\"/content/Real-Time-Embedding-Level-Drift-Detection\\\"\\n\",\"\\n\",\"files_to_stage = [\\n\",\"    \\\"results/experiment18_facenet_lfw_embeddings.npz\\\",\\n\",\"    \\\"results/experiment18_illumination_results.npz\\\",\\n\",\"    \\\"results/illumination_identity_summary.csv\\\",\\n\",\"    \\\"results/illumination_metadata.json\\\",\\n\",\"    \\\"results/experiment18_final_research_evidence.md\\\",\\n\",\"    \\\"results/experiment18_final_research_evidence.json\\\",\\n\",\"    \\\"results/Experiment_18_Final_Research_Package.zip\\\"\\n\",\"]\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"STEP 8 — STAGING EXPERIMENT 18 FILES\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"subprocess.run(\\n\",\"    [\\\"git\\\", \\\"add\\\", \\\"--\\\"] + files_to_stage,\\n\",\"    cwd=REPO_DIR,\\n\",\"    check=True\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\nStaged files:\\\")\\n\",\"staged = subprocess.check_output(\\n\",\"    [\\\"git\\\", \\\"diff\\\", \\\"--cached\\\", \\\"--name-status\\\"],\\n\",\"    cwd=REPO_DIR,\\n\",\"    text=True\\n\",\")\\n\",\"print(staged)\\n\",\"\\n\",\"staged_count = len([\\n\",\"    line for line in staged.splitlines() if line.strip()\\n\",\"])\\n\",\"\\n\",\"assert staged_count == 7, f\\\"Expected 7 staged files, found {staged_count}\\\"\\n\",\"\\n\",\"print(\\\"Staged file count:\\\", staged_count)\\n\",\"\\n\",\"print(\\\"\\\\nStaged change summary:\\\")\\n\",\"subprocess.run(\\n\",\"    [\\\"git\\\", \\\"diff\\\", \\\"--cached\\\", \\\"--stat\\\"],\\n\",\"    cwd=REPO_DIR,\\n\",\"    check=True\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STAGING COMPLETE.\\\")\\n\",\"print(\\\"No commit created. No push performed.\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 154\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"import subprocess\\n\",\"import os\\n\",\"\\n\",\"REPO_DIR = \\\"/content/Real-Time-Embedding-Level-Drift-Detection\\\"\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"STEP 9 — FINAL PRE-COMMIT REVIEW\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"# Confirm exactly seven staged files\\n\",\"staged = subprocess.check_output(\\n\",\"    [\\\"git\\\", \\\"diff\\\", \\\"--cached\\\", \\\"--name-only\\\"],\\n\",\"    cwd=REPO_DIR,\\n\",\"    text=True\\n\",\").splitlines()\\n\",\"\\n\",\"expected = {\\n\",\"    \\\"results/Experiment_18_Final_Research_Package.zip\\\",\\n\",\"    \\\"results/experiment18_facenet_lfw_embeddings.npz\\\",\\n\",\"    \\\"results/experiment18_illumination_results.npz\\\",\\n\",\"    \\\"results/illumination_identity_summary.csv\\\",\\n\",\"    \\\"results/illumination_metadata.json\\\",\\n\",\"    \\\"results/experiment18_final_research_evidence.md\\\",\\n\",\"    \\\"results/experiment18_final_research_evidence.json\\\"\\n\",\"}\\n\",\"\\n\",\"assert set(staged) == expected, \\\"Staged files do not match the approved seven files.\\\"\\n\",\"\\n\",\"print(\\\"\\\\nVerified staged files:\\\")\\n\",\"for filename in sorted(staged):\\n\",\"    print(\\\"[APPROVED]\\\", filename)\\n\",\"\\n\",\"# Confirm no unstaged tracked-file modifications\\n\",\"unstaged = subprocess.check_output(\\n\",\"    [\\\"git\\\", \\\"diff\\\", \\\"--name-only\\\"],\\n\",\"    cwd=REPO_DIR,\\n\",\"    text=True\\n\",\").splitlines()\\n\",\"\\n\",\"print(\\\"\\\\nUnstaged tracked-file modifications:\\\")\\n\",\"print(unstaged if unstaged else \\\"NONE\\\")\\n\",\"\\n\",\"assert not unstaged, \\\"Unexpected unstaged tracked-file modifications detected.\\\"\\n\",\"\\n\",\"# Calculate total staged artifact size\\n\",\"total_size = sum(\\n\",\"    os.path.getsize(os.path.join(REPO_DIR, filename))\\n\",\"    for filename in staged\\n\",\")\\n\",\"\\n\",\"print(f\\\"\\\\nTotal staged size: {total_size:,} bytes ({total_size / (1024*1024):.2f} MiB)\\\")\\n\",\"\\n\",\"print(\\\"\\\\nGit staged summary:\\\")\\n\",\"subprocess.run(\\n\",\"    [\\\"git\\\", \\\"diff\\\", \\\"--cached\\\", \\\"--stat\\\"],\\n\",\"    cwd=REPO_DIR,\\n\",\"    check=True\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"PRE-COMMIT AUDIT PASSED.\\\")\\n\",\"print(\\\"No commit created. No push performed.\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 156\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"from google.colab import files\\n\",\"import os\\n\",\"\\n\",\"RESULTS_DIR = \\\"/content/drive/MyDrive/Experiment_18_Results\\\"\\n\",\"\\n\",\"files_to_download = [\\n\",\"    \\\"experiment18_facenet_lfw_embeddings.npz\\\",\\n\",\"    \\\"experiment18_illumination_results.npz\\\",\\n\",\"    \\\"illumination_identity_summary.csv\\\",\\n\",\"    \\\"illumination_metadata.json\\\",\\n\",\"    \\\"experiment18_final_research_evidence.md\\\",\\n\",\"    \\\"experiment18_final_research_evidence.json\\\",\\n\",\"    \\\"Experiment_18_Final_Research_Package.zip\\\"\\n\",\"]\\n\",\"\\n\",\"for filename in files_to_download:\\n\",\"    path = os.path.join(RESULTS_DIR, filename)\\n\",\"\\n\",\"    assert os.path.isfile(path), f\\\"Missing file: {filename}\\\"\\n\",\"\\n\",\"    print(\\\"Downloading:\\\", filename)\\n\",\"    files.download(path)\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 160\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"import os\\n\",\"import zipfile\\n\",\"\\n\",\"RESULTS_DIR = \\\"/content/drive/MyDrive/Experiment_18_Results\\\"\\n\",\"\\n\",\"ZIP_PATH = os.path.join(\\n\",\"    RESULTS_DIR,\\n\",\"    \\\"Experiment_18_Final_Research_Package.zip\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"=\\\" * 70)\\n\",\"print(\\\"EXPERIMENT 18 — ZIP PACKAGE VERIFICATION\\\")\\n\",\"print(\\\"=\\\" * 70)\\n\",\"\\n\",\"assert os.path.isfile(ZIP_PATH), \\\"ZIP package missing.\\\"\\n\",\"\\n\",\"with zipfile.ZipFile(ZIP_PATH, \\\"r\\\") as archive:\\n\",\"\\n\",\"    files = archive.namelist()\\n\",\"\\n\",\"    print(\\\"\\\\n[1] ARCHIVE CONTENTS\\\")\\n\",\"\\n\",\"    for filename in files:\\n\",\"        print(filename)\\n\",\"\\n\",\"    print(\\\"\\\\n[2] ARCHIVE INTEGRITY\\\")\\n\",\"\\n\",\"    bad_file = archive.testzip()\\n\",\"\\n\",\"    assert bad_file is None, f\\\"Corrupted file: {bad_file}\\\"\\n\",\"\\n\",\"    print(\\\"PASS: ZIP integrity verified.\\\")\\n\",\"\\n\",\"    print(\\\"\\\\n[3] REQUIRED SOURCE FILES\\\")\\n\",\"\\n\",\"    required = [\\n\",\"        \\\"experiment18_facenet_lfw_embeddings.npz\\\",\\n\",\"        \\\"experiment18_illumination_results.npz\\\",\\n\",\"        \\\"illumination_identity_summary.csv\\\",\\n\",\"        \\\"illumination_metadata.json\\\",\\n\",\"        \\\"experiment18_final_research_evidence.md\\\",\\n\",\"        \\\"experiment18_final_research_evidence.json\\\"\\n\",\"    ]\\n\",\"\\n\",\"    archive_basenames = {\\n\",\"        os.path.basename(name) for name in files\\n\",\"    }\\n\",\"\\n\",\"    for filename in required:\\n\",\"        status = filename in archive_basenames\\n\",\"        print((\\\"PASS: \\\" if status else \\\"MISSING: \\\") + filename)\\n\",\"        assert status, f\\\"Required file missing: {filename}\\\"\\n\",\"\\n\",\"print(\\\"\\\\nEXPERIMENT 18 ZIP VERIFICATION PASSED.\\\")\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 161\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"import numpy as np\\n\",\"import os\\n\",\"\\n\",\"RESULTS_DIR = \\\"/content/drive/MyDrive/Experiment_18_Results\\\"\\n\",\"\\n\",\"files = {\\n\",\"    \\\"FaceNet embeddings\\\": \\\"experiment18_facenet_lfw_embeddings.npz\\\",\\n\",\"    \\\"Illumination results\\\": \\\"experiment18_illumination_results.npz\\\"\\n\",\"}\\n\",\"\\n\",\"for label, filename in files.items():\\n\",\"    path = os.path.join(RESULTS_DIR, filename)\\n\",\"\\n\",\"    print(\\\"\\\\n\\\" + \\\"=\\\" * 65)\\n\",\"    print(label.upper())\\n\",\"    print(\\\"=\\\" * 65)\\n\",\"\\n\",\"    with np.load(path, allow_pickle=False) as archive:\\n\",\"        for key in archive.files:\\n\",\"            array = archive[key]\\n\",\"            print(\\n\",\"                f\\\"{key}: shape={array.shape}, \\\"\\n\",\"                f\\\"dtype={array.dtype}\\\"\\n\",\"            )\\n\",\"\\n\",\"print(\\\"\\\\nSOURCE ARCHIVE INSPECTION COMPLETED.\\\")\\n\",\"\\n\",\"===========================================================================\\n\",\"TOTAL MATCHING CELLS: 108\\n\",\"NOTEBOOK: /content/drive/MyDrive/Colab Notebooks/Experiment_18_Genuine_Face_Recognition_Embedding_Validation.ipynb\\n\",\"READ-ONLY INSPECTION COMPLETE\\n\",\"===========================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"## Step 2.6.15 — CroppedYale and FaceNet Compatibility Test\\n\",\"\\n\",\"### Objective\\n\",\"Determine whether the original Experiment 18 FaceNet pipeline can process the Cropped Extended Yale B dataset.\\n\",\"\\n\",\"### Dataset Configuration\\n\",\"- Dataset: Cropped Extended Yale B\\n\",\"- Source images: 2,414 standard illumination images\\n\",\"- Subjects: 38\\n\",\"- Image format: PGM grayscale\\n\",\"- Standard image dimensions: 168 × 192\\n\",\"- Ambient images: Excluded\\n\",\"- Compatibility sample: 12 deterministically selected images\\n\",\"\\n\",\"### Model Configuration\\n\",\"- Face detector and alignment: MTCNN\\n\",\"- Recognition model: InceptionResnetV1\\n\",\"- Pretrained weights: VGGFace2\\n\",\"- Face input resolution: 160 × 160\\n\",\"- Embedding dimension: 512\\n\",\"- Execution device: CPU\\n\",\"- facenet-pytorch: 2.6.0\\n\",\"\\n\",\"### Preprocessing\\n\",\"Grayscale images will be converted to RGB by replicating their grayscale channel across three channels. MTCNN will then be applied using the original Experiment 18 configuration.\\n\",\"\\n\",\"### Methodology\\n\",\"1. Verify the installed FaceNet dependencies.\\n\",\"2. Validate the CroppedYale archive.\\n\",\"3. Identify standard illumination images using the verified filename structure.\\n\",\"4. Exclude ambient images.\\n\",\"5. Select 12 deterministic test images.\\n\",\"6. Convert grayscale images to RGB.\\n\",\"7. Apply MTCNN face detection and alignment.\\n\",\"8. Generate embeddings using InceptionResnetV1.\\n\",\"9. Validate embedding dimensions, numerical integrity and L2 norms.\\n\",\"10. Record detection and embedding failures.\\n\",\"\\n\",\"### Validation Criteria\\n\",\"- Successful archive integrity verification.\\n\",\"- Correct identification of standard illumination images.\\n\",\"- Successful RGB conversion.\\n\",\"- MTCNN detection and alignment.\\n\",\"- Valid 512-dimensional embeddings.\\n\",\"- Finite embedding values.\\n\",\"- L2 norms approximately equal to 1.0.\\n\",\"\\n\",\"### Scientific Limitations\\n\",\"This is a technical compatibility test, not evidence of biometric recognition accuracy or independent model validation.\\n\",\"\\n\",\"CroppedYale contains already-cropped grayscale images, whereas Experiment 18 used RGB LFW images processed through MTCNN. Differences in image characteristics and preprocessing must be documented.\\n\",\"\\n\",\"No full-dataset embedding extraction will be performed during this step.\"],\"metadata\":{\"id\":\"S5qpkjD0s13H\"}},{\"cell_type\":\"code\",\"source\":[\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 20 — STEP 2.6.15\\n\",\"# CROPPEDYALE AND FACENET COMPATIBILITY TEST\\n\",\"# CORRECTED FILENAME PATTERN\\n\",\"# ============================================================\\n\",\"\\n\",\"import sys\\n\",\"import zipfile\\n\",\"import re\\n\",\"import importlib.metadata\\n\",\"import numpy as np\\n\",\"import torch\\n\",\"import torchvision\\n\",\"import facenet_pytorch\\n\",\"\\n\",\"from pathlib import Path\\n\",\"from PIL import Image\\n\",\"from io import BytesIO\\n\",\"from facenet_pytorch import MTCNN, InceptionResnetV1\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. VERIFY FACENET DEPENDENCIES\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"STEP 1 — FACENET DEPENDENCY VERIFICATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"package_version = importlib.metadata.version(\\\"facenet-pytorch\\\")\\n\",\"\\n\",\"print(\\\"facenet-pytorch:\\\", package_version)\\n\",\"print(\\\"PyTorch:\\\", torch.__version__)\\n\",\"print(\\\"Torchvision:\\\", torchvision.__version__)\\n\",\"\\n\",\"assert package_version == \\\"2.6.0\\\"\\n\",\"\\n\",\"print(\\\"MTCNN import: SUCCESS\\\")\\n\",\"print(\\\"InceptionResnetV1 import: SUCCESS\\\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. LOCATE AND VERIFY CROPPEDYALE ARCHIVE\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 2 — DATASET ARCHIVE VALIDATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"archive_path = Path(\\n\",\"    \\\"/content/Experiment20_Downloads/CroppedYale.zip\\\"\\n\",\")\\n\",\"\\n\",\"assert archive_path.exists(), (\\n\",\"    f\\\"CroppedYale archive not found: {archive_path}\\\"\\n\",\")\\n\",\"\\n\",\"with zipfile.ZipFile(archive_path, \\\"r\\\") as archive:\\n\",\"\\n\",\"    bad_member = archive.testzip()\\n\",\"\\n\",\"    assert bad_member is None, (\\n\",\"        f\\\"Archive integrity failure: {bad_member}\\\"\\n\",\"    )\\n\",\"\\n\",\"    members = archive.namelist()\\n\",\"\\n\",\"    # Corrected pattern:\\n\",\"    # Actual filename: yaleB39_P00A+000E+00.pgm\\n\",\"    standard_pattern = re.compile(\\n\",\"        r\\\"yaleB\\\\d+_P00A[+-]\\\\d+E[+-]\\\\d+\\\\.pgm$\\\",\\n\",\"        re.IGNORECASE\\n\",\"    )\\n\",\"\\n\",\"    ambient_pattern = re.compile(\\n\",\"        r\\\"yaleB\\\\d+_P00_Ambient\\\\.pgm$\\\",\\n\",\"        re.IGNORECASE\\n\",\"    )\\n\",\"\\n\",\"    standard_images = sorted([\\n\",\"        name for name in members\\n\",\"        if standard_pattern.search(Path(name).name)\\n\",\"    ])\\n\",\"\\n\",\"    ambient_images = sorted([\\n\",\"        name for name in members\\n\",\"        if ambient_pattern.search(Path(name).name)\\n\",\"    ])\\n\",\"\\n\",\"print(\\\"Archive integrity: PASSED\\\")\\n\",\"print(\\\"Standard illumination images:\\\", len(standard_images))\\n\",\"print(\\\"Ambient images:\\\", len(ambient_images))\\n\",\"\\n\",\"assert len(standard_images) == 2414, (\\n\",\"    f\\\"Expected 2414 standard images, found {len(standard_images)}\\\"\\n\",\")\\n\",\"\\n\",\"assert len(ambient_images) == 38, (\\n\",\"    f\\\"Expected 38 ambient images, found {len(ambient_images)}\\\"\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. SELECT 12 DETERMINISTIC TEST IMAGES\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 3 — TEST IMAGE SELECTION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"sample_count = min(12, len(standard_images))\\n\",\"\\n\",\"sample_positions = np.linspace(\\n\",\"    0,\\n\",\"    len(standard_images) - 1,\\n\",\"    sample_count,\\n\",\"    dtype=int\\n\",\")\\n\",\"\\n\",\"sample_members = [\\n\",\"    standard_images[position]\\n\",\"    for position in sample_positions\\n\",\"]\\n\",\"\\n\",\"print(\\\"Selected images:\\\", len(sample_members))\\n\",\"\\n\",\"for member in sample_members:\\n\",\"    print(Path(member).name)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. INITIALISE ORIGINAL EXPERIMENT 18 MODEL\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 4 — FACENET MODEL INITIALISATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"device = torch.device(\\\"cpu\\\")\\n\",\"\\n\",\"mtcnn = MTCNN(\\n\",\"    image_size=160,\\n\",\"    margin=0,\\n\",\"    keep_all=False,\\n\",\"    device=device\\n\",\")\\n\",\"\\n\",\"facenet = InceptionResnetV1(\\n\",\"    pretrained=\\\"vggface2\\\"\\n\",\").eval().to(device)\\n\",\"\\n\",\"print(\\\"MTCNN initialised successfully.\\\")\\n\",\"print(\\\"FaceNet initialised successfully.\\\")\\n\",\"print(\\\"Pretrained weights: VGGFace2\\\")\\n\",\"print(\\\"Execution device:\\\", device)\\n\",\"print(\\\"Embedding dimension:\\\", facenet.last_linear.out_features)\\n\",\"\\n\",\"assert facenet.last_linear.out_features == 512\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. GRAYSCALE CONVERSION AND EMBEDDING EXTRACTION\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 5 — CROPPEDYALE COMPATIBILITY TEST\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"results = []\\n\",\"\\n\",\"with zipfile.ZipFile(archive_path, \\\"r\\\") as archive:\\n\",\"\\n\",\"    for member in sample_members:\\n\",\"\\n\",\"        result = {\\n\",\"            \\\"image\\\": Path(member).name,\\n\",\"            \\\"original_mode\\\": None,\\n\",\"            \\\"original_size\\\": None,\\n\",\"            \\\"rgb_size\\\": None,\\n\",\"            \\\"mtcnn_success\\\": False,\\n\",\"            \\\"embedding_success\\\": False,\\n\",\"            \\\"embedding_dimension\\\": None,\\n\",\"            \\\"embedding_finite\\\": False,\\n\",\"            \\\"embedding_l2_norm\\\": None,\\n\",\"            \\\"error\\\": None\\n\",\"        }\\n\",\"\\n\",\"        try:\\n\",\"\\n\",\"            image_bytes = archive.read(member)\\n\",\"\\n\",\"            with Image.open(BytesIO(image_bytes)) as source_image:\\n\",\"\\n\",\"                result[\\\"original_mode\\\"] = source_image.mode\\n\",\"                result[\\\"original_size\\\"] = source_image.size\\n\",\"\\n\",\"                grayscale_image = source_image.convert(\\\"L\\\")\\n\",\"\\n\",\"                # Replicate grayscale into three RGB channels.\\n\",\"                rgb_image = grayscale_image.convert(\\\"RGB\\\")\\n\",\"\\n\",\"            result[\\\"rgb_size\\\"] = rgb_image.size\\n\",\"\\n\",\"            # Original Experiment 18 MTCNN configuration.\\n\",\"            face_tensor = mtcnn(rgb_image)\\n\",\"\\n\",\"            if face_tensor is None:\\n\",\"\\n\",\"                result[\\\"error\\\"] = (\\n\",\"                    \\\"MTCNN did not detect a face.\\\"\\n\",\"                )\\n\",\"\\n\",\"            else:\\n\",\"\\n\",\"                result[\\\"mtcnn_success\\\"] = True\\n\",\"\\n\",\"                with torch.no_grad():\\n\",\"\\n\",\"                    embedding = facenet(\\n\",\"                        face_tensor.unsqueeze(0).to(device)\\n\",\"                    )\\n\",\"\\n\",\"                embedding_np = embedding.cpu().numpy()[0]\\n\",\"\\n\",\"                embedding_norm = np.linalg.norm(embedding_np)\\n\",\"\\n\",\"                result[\\\"embedding_dimension\\\"] = len(embedding_np)\\n\",\"\\n\",\"                result[\\\"embedding_finite\\\"] = bool(\\n\",\"                    np.isfinite(embedding_np).all()\\n\",\"                )\\n\",\"\\n\",\"                result[\\\"embedding_l2_norm\\\"] = float(\\n\",\"                    embedding_norm\\n\",\"                )\\n\",\"\\n\",\"                result[\\\"embedding_success\\\"] = bool(\\n\",\"                    len(embedding_np) == 512\\n\",\"                    and np.isfinite(embedding_np).all()\\n\",\"                    and np.isclose(\\n\",\"                        embedding_norm,\\n\",\"                        1.0,\\n\",\"                        atol=1e-4\\n\",\"                    )\\n\",\"                )\\n\",\"\\n\",\"                if not result[\\\"embedding_success\\\"]:\\n\",\"\\n\",\"                    result[\\\"error\\\"] = (\\n\",\"                        \\\"Embedding failed dimensional, \\\"\\n\",\"                        \\\"finite-value or L2-norm validation.\\\"\\n\",\"                    )\\n\",\"\\n\",\"        except Exception as exc:\\n\",\"\\n\",\"            result[\\\"error\\\"] = (\\n\",\"                f\\\"{type(exc).__name__}: {str(exc)}\\\"\\n\",\"            )\\n\",\"\\n\",\"        results.append(result)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. INDIVIDUAL IMAGE RESULTS\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 6 — INDIVIDUAL IMAGE RESULTS\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"for result in results:\\n\",\"\\n\",\"    print(\\\"\\\\nImage:\\\", result[\\\"image\\\"])\\n\",\"    print(\\\"Original mode:\\\", result[\\\"original_mode\\\"])\\n\",\"    print(\\\"Original dimensions:\\\", result[\\\"original_size\\\"])\\n\",\"    print(\\\"RGB dimensions:\\\", result[\\\"rgb_size\\\"])\\n\",\"    print(\\\"MTCNN successful:\\\", result[\\\"mtcnn_success\\\"])\\n\",\"    print(\\\"Embedding valid:\\\", result[\\\"embedding_success\\\"])\\n\",\"    print(\\\"Embedding dimension:\\\", result[\\\"embedding_dimension\\\"])\\n\",\"    print(\\\"Embedding finite:\\\", result[\\\"embedding_finite\\\"])\\n\",\"    print(\\\"Embedding L2 norm:\\\", result[\\\"embedding_l2_norm\\\"])\\n\",\"    print(\\\"Error:\\\", result[\\\"error\\\"])\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. AGGREGATE COMPATIBILITY SUMMARY\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 7 — COMPATIBILITY SUMMARY\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"total = len(results)\\n\",\"\\n\",\"mtcnn_successes = sum(\\n\",\"    result[\\\"mtcnn_success\\\"]\\n\",\"    for result in results\\n\",\")\\n\",\"\\n\",\"embedding_successes = sum(\\n\",\"    result[\\\"embedding_success\\\"]\\n\",\"    for result in results\\n\",\")\\n\",\"\\n\",\"print(\\\"Images tested:\\\", total)\\n\",\"print(\\\"MTCNN successes:\\\", mtcnn_successes)\\n\",\"print(\\\"MTCNN failures:\\\", total - mtcnn_successes)\\n\",\"\\n\",\"print(\\\"Valid FaceNet embeddings:\\\", embedding_successes)\\n\",\"print(\\\"Invalid or missing embeddings:\\\", total - embedding_successes)\\n\",\"\\n\",\"print(\\n\",\"    \\\"MTCNN success rate:\\\",\\n\",\"    round(100 * mtcnn_successes / total, 2),\\n\",\"    \\\"%\\\"\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"Valid embedding rate:\\\",\\n\",\"    round(100 * embedding_successes / total, 2),\\n\",\"    \\\"%\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\nSoftware versions:\\\")\\n\",\"print(\\\"Python:\\\", sys.version.split()[0])\\n\",\"print(\\\"facenet-pytorch:\\\", package_version)\\n\",\"print(\\\"PyTorch:\\\", torch.__version__)\\n\",\"print(\\\"Torchvision:\\\", torchvision.__version__)\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"COMPATIBILITY TEST FINISHED\\\")\\n\",\"print(\\\"No full-dataset embeddings generated.\\\")\\n\",\"print(\\\"No source archive files modified.\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\",\"height\":1000,\"referenced_widgets\":[\"5491bf3275ab4fd7af9f8fb0aa164e0a\",\"34e4698a8e9e4a1fbbf47357277f7bd6\",\"bb8260bf4ad84e088116c7f45a910c4e\",\"27628edacc71412d8ea3e179543c168c\",\"39dc5dbcab5e47158b65b72d41576021\",\"4fc12c1299a347aba2678816145fa972\",\"1a0300ca0b024444873be703c63a92d7\",\"b2805ca7e10742cba12041a9f2ef79d5\",\"0fbc906eddde4256a7c0df6a3cb5af43\",\"c97f50a6ffac43e686298501e55337fd\",\"2ac19493b77a4c0c9ebf742e553cdf6d\"]},\"id\":\"esWbvcXSs6JP\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794352227316,\"user_tz\":360,\"elapsed\":5359,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"9b017703-63c3-480e-917f-8567301b2cf0\"},\"execution_count\":null,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"===========================================================================\\n\",\"STEP 1 — FACENET DEPENDENCY VERIFICATION\\n\",\"===========================================================================\\n\",\"facenet-pytorch: 2.6.0\\n\",\"PyTorch: 2.14.1+cpu\\n\",\"Torchvision: 0.29.1+cpu\\n\",\"MTCNN import: SUCCESS\\n\",\"InceptionResnetV1 import: SUCCESS\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 2 — DATASET ARCHIVE VALIDATION\\n\",\"===========================================================================\\n\",\"Archive integrity: PASSED\\n\",\"Standard illumination images: 2414\\n\",\"Ambient images: 38\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 3 — TEST IMAGE SELECTION\\n\",\"===========================================================================\\n\",\"Selected images: 12\\n\",\"yaleB01_P00A+000E+00.pgm\\n\",\"yaleB04_P00A+085E-20.pgm\\n\",\"yaleB07_P00A-070E-35.pgm\\n\",\"yaleB11_P00A+035E-20.pgm\\n\",\"yaleB15_P00A-110E+40.pgm\\n\",\"yaleB19_P00A+085E+20.pgm\\n\",\"yaleB22_P00A-070E-35.pgm\\n\",\"yaleB26_P00A+035E+65.pgm\\n\",\"yaleB29_P00A-035E+15.pgm\\n\",\"yaleB33_P00A+010E+00.pgm\\n\",\"yaleB36_P00A-005E+10.pgm\\n\",\"yaleB39_P00A-130E+20.pgm\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 4 — FACENET MODEL INITIALISATION\\n\",\"===========================================================================\\n\"]},{\"output_type\":\"display_data\",\"data\":{\"text/plain\":[\"  0%|          | 0.00/107M [00:00<?, ?B/s]\"],\"application/vnd.jupyter.widget-view+json\":{\"version_major\":2,\"version_minor\":0,\"model_id\":\"5491bf3275ab4fd7af9f8fb0aa164e0a\"}},\"metadata\":{}},{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"MTCNN initialised successfully.\\n\",\"FaceNet initialised successfully.\\n\",\"Pretrained weights: VGGFace2\\n\",\"Execution device: cpu\\n\",\"Embedding dimension: 512\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 5 — CROPPEDYALE COMPATIBILITY TEST\\n\",\"===========================================================================\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 6 — INDIVIDUAL IMAGE RESULTS\\n\",\"===========================================================================\\n\",\"\\n\",\"Image: yaleB01_P00A+000E+00.pgm\\n\",\"Original mode: L\\n\",\"Original dimensions: (168, 192)\\n\",\"RGB dimensions: (168, 192)\\n\",\"MTCNN successful: False\\n\",\"Embedding valid: False\\n\",\"Embedding dimension: None\\n\",\"Embedding finite: False\\n\",\"Embedding L2 norm: None\\n\",\"Error: MTCNN did not detect a face.\\n\",\"\\n\",\"Image: yaleB04_P00A+085E-20.pgm\\n\",\"Original mode: L\\n\",\"Original dimensions: (168, 192)\\n\",\"RGB dimensions: (168, 192)\\n\",\"MTCNN successful: False\\n\",\"Embedding valid: False\\n\",\"Embedding dimension: None\\n\",\"Embedding finite: False\\n\",\"Embedding L2 norm: None\\n\",\"Error: MTCNN did not detect a face.\\n\",\"\\n\",\"Image: yaleB07_P00A-070E-35.pgm\\n\",\"Original mode: L\\n\",\"Original dimensions: (168, 192)\\n\",\"RGB dimensions: (168, 192)\\n\",\"MTCNN successful: False\\n\",\"Embedding valid: False\\n\",\"Embedding dimension: None\\n\",\"Embedding finite: False\\n\",\"Embedding L2 norm: None\\n\",\"Error: MTCNN did not detect a face.\\n\",\"\\n\",\"Image: yaleB11_P00A+035E-20.pgm\\n\",\"Original mode: L\\n\",\"Original dimensions: (168, 192)\\n\",\"RGB dimensions: (168, 192)\\n\",\"MTCNN successful: False\\n\",\"Embedding valid: False\\n\",\"Embedding dimension: None\\n\",\"Embedding finite: False\\n\",\"Embedding L2 norm: None\\n\",\"Error: MTCNN did not detect a face.\\n\",\"\\n\",\"Image: yaleB15_P00A-110E+40.pgm\\n\",\"Original mode: L\\n\",\"Original dimensions: (168, 192)\\n\",\"RGB dimensions: (168, 192)\\n\",\"MTCNN successful: False\\n\",\"Embedding valid: False\\n\",\"Embedding dimension: None\\n\",\"Embedding finite: False\\n\",\"Embedding L2 norm: None\\n\",\"Error: MTCNN did not detect a face.\\n\",\"\\n\",\"Image: yaleB19_P00A+085E+20.pgm\\n\",\"Original mode: L\\n\",\"Original dimensions: (168, 192)\\n\",\"RGB dimensions: (168, 192)\\n\",\"MTCNN successful: False\\n\",\"Embedding valid: False\\n\",\"Embedding dimension: None\\n\",\"Embedding finite: False\\n\",\"Embedding L2 norm: None\\n\",\"Error: MTCNN did not detect a face.\\n\",\"\\n\",\"Image: yaleB22_P00A-070E-35.pgm\\n\",\"Original mode: L\\n\",\"Original dimensions: (168, 192)\\n\",\"RGB dimensions: (168, 192)\\n\",\"MTCNN successful: False\\n\",\"Embedding valid: False\\n\",\"Embedding dimension: None\\n\",\"Embedding finite: False\\n\",\"Embedding L2 norm: None\\n\",\"Error: MTCNN did not detect a face.\\n\",\"\\n\",\"Image: yaleB26_P00A+035E+65.pgm\\n\",\"Original mode: L\\n\",\"Original dimensions: (168, 192)\\n\",\"RGB dimensions: (168, 192)\\n\",\"MTCNN successful: True\\n\",\"Embedding valid: True\\n\",\"Embedding dimension: 512\\n\",\"Embedding finite: True\\n\",\"Embedding L2 norm: 0.9999999403953552\\n\",\"Error: None\\n\",\"\\n\",\"Image: yaleB29_P00A-035E+15.pgm\\n\",\"Original mode: L\\n\",\"Original dimensions: (168, 192)\\n\",\"RGB dimensions: (168, 192)\\n\",\"MTCNN successful: False\\n\",\"Embedding valid: False\\n\",\"Embedding dimension: None\\n\",\"Embedding finite: False\\n\",\"Embedding L2 norm: None\\n\",\"Error: MTCNN did not detect a face.\\n\",\"\\n\",\"Image: yaleB33_P00A+010E+00.pgm\\n\",\"Original mode: L\\n\",\"Original dimensions: (168, 192)\\n\",\"RGB dimensions: (168, 192)\\n\",\"MTCNN successful: False\\n\",\"Embedding valid: False\\n\",\"Embedding dimension: None\\n\",\"Embedding finite: False\\n\",\"Embedding L2 norm: None\\n\",\"Error: MTCNN did not detect a face.\\n\",\"\\n\",\"Image: yaleB36_P00A-005E+10.pgm\\n\",\"Original mode: L\\n\",\"Original dimensions: (168, 192)\\n\",\"RGB dimensions: (168, 192)\\n\",\"MTCNN successful: False\\n\",\"Embedding valid: False\\n\",\"Embedding dimension: None\\n\",\"Embedding finite: False\\n\",\"Embedding L2 norm: None\\n\",\"Error: MTCNN did not detect a face.\\n\",\"\\n\",\"Image: yaleB39_P00A-130E+20.pgm\\n\",\"Original mode: L\\n\",\"Original dimensions: (168, 192)\\n\",\"RGB dimensions: (168, 192)\\n\",\"MTCNN successful: False\\n\",\"Embedding valid: False\\n\",\"Embedding dimension: None\\n\",\"Embedding finite: False\\n\",\"Embedding L2 norm: None\\n\",\"Error: MTCNN did not detect a face.\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 7 — COMPATIBILITY SUMMARY\\n\",\"===========================================================================\\n\",\"Images tested: 12\\n\",\"MTCNN successes: 1\\n\",\"MTCNN failures: 11\\n\",\"Valid FaceNet embeddings: 1\\n\",\"Invalid or missing embeddings: 11\\n\",\"MTCNN success rate: 8.33 %\\n\",\"Valid embedding rate: 8.33 %\\n\",\"\\n\",\"Software versions:\\n\",\"Python: 3.13.18\\n\",\"facenet-pytorch: 2.6.0\\n\",\"PyTorch: 2.14.1+cpu\\n\",\"Torchvision: 0.29.1+cpu\\n\",\"\\n\",\"===========================================================================\\n\",\"COMPATIBILITY TEST FINISHED\\n\",\"No full-dataset embeddings generated.\\n\",\"No source archive files modified.\\n\",\"===========================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"\\n\",\"## Step 2.6.16 — Direct FaceNet Compatibility Test Without MTCNN\\n\",\"\\n\",\"### Objective\\n\",\"Determine whether the already-cropped Extended Yale B images can be processed directly by InceptionResnetV1 without MTCNN face detection.\\n\",\"\\n\",\"### Method\\n\",\"1. Select the same 12 previously audited images.\\n\",\"2. Convert grayscale images to RGB.\\n\",\"3. Resize images to 160 × 160.\\n\",\"4. Convert images into tensors using the FaceNet-compatible input range.\\n\",\"5. Generate embeddings using the existing InceptionResnetV1 model pretrained on VGGFace2.\\n\",\"6. Validate embedding dimensions, numerical finiteness and L2 norms.\\n\",\"\\n\",\"### Important distinction\\n\",\"This test changes the preprocessing pipeline relative to Experiment 18. It does not establish methodological equivalence with the original LFW pipeline.\\n\",\"\\n\",\"No full-dataset embedding generation will occur during this test.\\n\"],\"metadata\":{\"id\":\"hGFGNUtfuq0P\"}},{\"cell_type\":\"code\",\"source\":[\"\\n\",\"import os\\n\",\"import re\\n\",\"import zipfile\\n\",\"import numpy as np\\n\",\"import torch\\n\",\"from PIL import Image\\n\",\"from torchvision import transforms\\n\",\"from facenet_pytorch import InceptionResnetV1\\n\",\"from importlib.metadata import version\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. CONFIGURATION\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"archive_path = \\\"/content/Experiment20_Downloads/CroppedYale.zip\\\"\\n\",\"\\n\",\"assert os.path.exists(archive_path), \\\"CroppedYale archive not found.\\\"\\n\",\"\\n\",\"device = torch.device(\\\"cpu\\\")\\n\",\"\\n\",\"# Reuse the existing FaceNet model if it is still available.\\n\",\"# Otherwise initialise the same VGGFace2 model.\\n\",\"if \\\"facenet\\\" not in globals():\\n\",\"    facenet = InceptionResnetV1(\\n\",\"        pretrained=\\\"vggface2\\\"\\n\",\"    ).eval().to(device)\\n\",\"\\n\",\"facenet.eval()\\n\",\"\\n\",\"# Match the 160 x 160 FaceNet input dimensions.\\n\",\"direct_transform = transforms.Compose([\\n\",\"    transforms.Resize((160, 160)),\\n\",\"    transforms.ToTensor()\\n\",\"])\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. SELECT THE SAME 12 IMAGES\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"test_filenames = [\\n\",\"    \\\"yaleB01_P00A+000E+00.pgm\\\",\\n\",\"    \\\"yaleB04_P00A+085E-20.pgm\\\",\\n\",\"    \\\"yaleB07_P00A-070E-35.pgm\\\",\\n\",\"    \\\"yaleB11_P00A+035E-20.pgm\\\",\\n\",\"    \\\"yaleB15_P00A-110E+40.pgm\\\",\\n\",\"    \\\"yaleB19_P00A+085E+20.pgm\\\",\\n\",\"    \\\"yaleB22_P00A-070E-35.pgm\\\",\\n\",\"    \\\"yaleB26_P00A+035E+65.pgm\\\",\\n\",\"    \\\"yaleB29_P00A-035E+15.pgm\\\",\\n\",\"    \\\"yaleB33_P00A+010E+00.pgm\\\",\\n\",\"    \\\"yaleB36_P00A-005E+10.pgm\\\",\\n\",\"    \\\"yaleB39_P00A-130E+20.pgm\\\"\\n\",\"]\\n\",\"\\n\",\"# Locate exact archive paths.\\n\",\"with zipfile.ZipFile(archive_path, \\\"r\\\") as archive:\\n\",\"\\n\",\"    archive_names = archive.namelist()\\n\",\"\\n\",\"    selected_paths = {}\\n\",\"\\n\",\"    for filename in test_filenames:\\n\",\"\\n\",\"        matches = [\\n\",\"            name for name in archive_names\\n\",\"            if name.endswith(\\\"/\\\" + filename)\\n\",\"        ]\\n\",\"\\n\",\"        assert len(matches) == 1, (\\n\",\"            f\\\"Expected exactly one archive match for {filename}; \\\"\\n\",\"            f\\\"found {len(matches)}\\\"\\n\",\"        )\\n\",\"\\n\",\"        selected_paths[filename] = matches[0]\\n\",\"\\n\",\"    # --------------------------------------------------------\\n\",\"    # 3. DIRECT FACE NET EMBEDDING TEST\\n\",\"    # --------------------------------------------------------\\n\",\"\\n\",\"    results = []\\n\",\"\\n\",\"    print(\\\"=\\\" * 75)\\n\",\"    print(\\\"DIRECT FACENET COMPATIBILITY TEST\\\")\\n\",\"    print(\\\"=\\\" * 75)\\n\",\"\\n\",\"    with torch.no_grad():\\n\",\"\\n\",\"        for filename, archive_path_inside in selected_paths.items():\\n\",\"\\n\",\"            print(\\\"\\\\nImage:\\\", filename)\\n\",\"\\n\",\"            try:\\n\",\"\\n\",\"                image_bytes = archive.read(archive_path_inside)\\n\",\"\\n\",\"                import io\\n\",\"\\n\",\"                image = Image.open(\\n\",\"                    io.BytesIO(image_bytes)\\n\",\"                ).convert(\\\"RGB\\\")\\n\",\"\\n\",\"                original_dimensions = image.size\\n\",\"\\n\",\"                tensor = direct_transform(image).unsqueeze(0).to(device)\\n\",\"\\n\",\"                embedding = facenet(tensor)\\n\",\"\\n\",\"                embedding_np = embedding.cpu().numpy().reshape(-1)\\n\",\"\\n\",\"                valid_dimension = embedding_np.shape[0] == 512\\n\",\"                finite = np.isfinite(embedding_np).all()\\n\",\"\\n\",\"                l2_norm = float(np.linalg.norm(embedding_np))\\n\",\"\\n\",\"                valid = (\\n\",\"                    valid_dimension\\n\",\"                    and finite\\n\",\"                    and np.isclose(l2_norm, 1.0, atol=1e-4)\\n\",\"                )\\n\",\"\\n\",\"                result = {\\n\",\"                    \\\"filename\\\": filename,\\n\",\"                    \\\"original_dimensions\\\": original_dimensions,\\n\",\"                    \\\"embedding_dimension\\\": int(embedding_np.shape[0]),\\n\",\"                    \\\"finite\\\": bool(finite),\\n\",\"                    \\\"l2_norm\\\": l2_norm,\\n\",\"                    \\\"valid\\\": bool(valid),\\n\",\"                    \\\"error\\\": None\\n\",\"                }\\n\",\"\\n\",\"                print(\\\"Original dimensions:\\\", original_dimensions)\\n\",\"                print(\\\"Input tensor shape:\\\", tuple(tensor.shape))\\n\",\"                print(\\\"Embedding dimension:\\\", result[\\\"embedding_dimension\\\"])\\n\",\"                print(\\\"Finite:\\\", finite)\\n\",\"                print(\\\"L2 norm:\\\", l2_norm)\\n\",\"                print(\\\"Valid embedding:\\\", valid)\\n\",\"\\n\",\"            except Exception as exc:\\n\",\"\\n\",\"                result = {\\n\",\"                    \\\"filename\\\": filename,\\n\",\"                    \\\"original_dimensions\\\": None,\\n\",\"                    \\\"embedding_dimension\\\": None,\\n\",\"                    \\\"finite\\\": False,\\n\",\"                    \\\"l2_norm\\\": None,\\n\",\"                    \\\"valid\\\": False,\\n\",\"                    \\\"error\\\": str(exc)\\n\",\"                }\\n\",\"\\n\",\"                print(\\\"ERROR:\\\", str(exc))\\n\",\"\\n\",\"            results.append(result)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. SUMMARY\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"successes = sum(item[\\\"valid\\\"] for item in results)\\n\",\"failures = len(results) - successes\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"DIRECT FACENET COMPATIBILITY SUMMARY\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"print(\\\"Images tested:\\\", len(results))\\n\",\"print(\\\"Valid embeddings:\\\", successes)\\n\",\"print(\\\"Invalid embeddings:\\\", failures)\\n\",\"print(\\\"Success rate:\\\", round(successes / len(results) * 100, 2), \\\"%\\\")\\n\",\"\\n\",\"print(\\\"\\\\nSoftware versions:\\\")\\n\",\"print(\\\"facenet-pytorch:\\\", version(\\\"facenet-pytorch\\\"))\\n\",\"print(\\\"PyTorch:\\\", torch.__version__)\\n\",\"print(\\\"Torchvision:\\\", version(\\\"torchvision\\\"))\\n\",\"\\n\",\"print(\\\"\\\\nNo full-dataset embeddings generated.\\\")\\n\",\"print(\\\"No source archive files modified.\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"EhCkgJg0uspG\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794352277007,\"user_tz\":360,\"elapsed\":5100,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"57a90ec7-423c-48fb-9634-7db825c09d88\"},\"execution_count\":null,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"===========================================================================\\n\",\"DIRECT FACENET COMPATIBILITY TEST\\n\",\"===========================================================================\\n\",\"\\n\",\"Image: yaleB01_P00A+000E+00.pgm\\n\",\"Original dimensions: (168, 192)\\n\",\"Input tensor shape: (1, 3, 160, 160)\\n\",\"Embedding dimension: 512\\n\",\"Finite: True\\n\",\"L2 norm: 0.9999999403953552\\n\",\"Valid embedding: True\\n\",\"\\n\",\"Image: yaleB04_P00A+085E-20.pgm\\n\",\"Original dimensions: (168, 192)\\n\",\"Input tensor shape: (1, 3, 160, 160)\\n\",\"Embedding dimension: 512\\n\",\"Finite: True\\n\",\"L2 norm: 1.0\\n\",\"Valid embedding: True\\n\",\"\\n\",\"Image: yaleB07_P00A-070E-35.pgm\\n\",\"Original dimensions: (168, 192)\\n\",\"Input tensor shape: (1, 3, 160, 160)\\n\",\"Embedding dimension: 512\\n\",\"Finite: True\\n\",\"L2 norm: 1.0\\n\",\"Valid embedding: True\\n\",\"\\n\",\"Image: yaleB11_P00A+035E-20.pgm\\n\",\"Original dimensions: (168, 192)\\n\",\"Input tensor shape: (1, 3, 160, 160)\\n\",\"Embedding dimension: 512\\n\",\"Finite: True\\n\",\"L2 norm: 1.0\\n\",\"Valid embedding: True\\n\",\"\\n\",\"Image: yaleB15_P00A-110E+40.pgm\\n\",\"Original dimensions: (168, 192)\\n\",\"Input tensor shape: (1, 3, 160, 160)\\n\",\"Embedding dimension: 512\\n\",\"Finite: True\\n\",\"L2 norm: 0.9999999403953552\\n\",\"Valid embedding: True\\n\",\"\\n\",\"Image: yaleB19_P00A+085E+20.pgm\\n\",\"Original dimensions: (168, 192)\\n\",\"Input tensor shape: (1, 3, 160, 160)\\n\",\"Embedding dimension: 512\\n\",\"Finite: True\\n\",\"L2 norm: 1.0\\n\",\"Valid embedding: True\\n\",\"\\n\",\"Image: yaleB22_P00A-070E-35.pgm\\n\",\"Original dimensions: (168, 192)\\n\",\"Input tensor shape: (1, 3, 160, 160)\\n\",\"Embedding dimension: 512\\n\",\"Finite: True\\n\",\"L2 norm: 1.0000001192092896\\n\",\"Valid embedding: True\\n\",\"\\n\",\"Image: yaleB26_P00A+035E+65.pgm\\n\",\"Original dimensions: (168, 192)\\n\",\"Input tensor shape: (1, 3, 160, 160)\\n\",\"Embedding dimension: 512\\n\",\"Finite: True\\n\",\"L2 norm: 1.0\\n\",\"Valid embedding: True\\n\",\"\\n\",\"Image: yaleB29_P00A-035E+15.pgm\\n\",\"Original dimensions: (168, 192)\\n\",\"Input tensor shape: (1, 3, 160, 160)\\n\",\"Embedding dimension: 512\\n\",\"Finite: True\\n\",\"L2 norm: 1.0\\n\",\"Valid embedding: True\\n\",\"\\n\",\"Image: yaleB33_P00A+010E+00.pgm\\n\",\"Original dimensions: (168, 192)\\n\",\"Input tensor shape: (1, 3, 160, 160)\\n\",\"Embedding dimension: 512\\n\",\"Finite: True\\n\",\"L2 norm: 0.9999998807907104\\n\",\"Valid embedding: True\\n\",\"\\n\",\"Image: yaleB36_P00A-005E+10.pgm\\n\",\"Original dimensions: (168, 192)\\n\",\"Input tensor shape: (1, 3, 160, 160)\\n\",\"Embedding dimension: 512\\n\",\"Finite: True\\n\",\"L2 norm: 1.0\\n\",\"Valid embedding: True\\n\",\"\\n\",\"Image: yaleB39_P00A-130E+20.pgm\\n\",\"Original dimensions: (168, 192)\\n\",\"Input tensor shape: (1, 3, 160, 160)\\n\",\"Embedding dimension: 512\\n\",\"Finite: True\\n\",\"L2 norm: 1.0\\n\",\"Valid embedding: True\\n\",\"\\n\",\"===========================================================================\\n\",\"DIRECT FACENET COMPATIBILITY SUMMARY\\n\",\"===========================================================================\\n\",\"Images tested: 12\\n\",\"Valid embeddings: 12\\n\",\"Invalid embeddings: 0\\n\",\"Success rate: 100.0 %\\n\",\"\\n\",\"Software versions:\\n\",\"facenet-pytorch: 2.6.0\\n\",\"PyTorch: 2.14.1+cpu\\n\",\"Torchvision: 0.29.1+cpu\\n\",\"\\n\",\"No full-dataset embeddings generated.\\n\",\"No source archive files modified.\\n\",\"===========================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"\\n\",\"## Step 2.6.17 — Full-Dataset Image Integrity Audit\\n\",\"\\n\",\"### Objective\\n\",\"Perform a complete image-level integrity audit of the 2,414 standard illumination images in the CroppedYale archive.\\n\",\"\\n\",\"### Validation procedures\\n\",\"1. Verify ZIP archive integrity.\\n\",\"2. Identify standard illumination images using their filename pattern.\\n\",\"3. Exclude ambient reference images.\\n\",\"4. Decode every standard image.\\n\",\"5. Validate image dimensions, image mode and pixel values.\\n\",\"6. Check subject and illumination-condition coverage.\\n\",\"7. Detect duplicate filenames and duplicate subject-condition records.\\n\",\"8. Record all failures and produce a machine-readable audit report.\\n\",\"\\n\",\"### Expected dataset structure\\n\",\"- 38 subjects.\\n\",\"- 2,414 standard illumination images.\\n\",\"- 57 illumination conditions common to all subjects.\\n\",\"- 2,166 observations in the common-condition subset.\\n\",\"- 38 ambient reference images excluded from primary analysis.\\n\",\"\\n\",\"### Important\\n\",\"This is an integrity audit, not an embedding-quality or biometric-recognition evaluation.\\n\",\"\\n\",\"No images will be modified, and no embeddings will be generated.\\n\"],\"metadata\":{\"id\":\"qNAuwNU0vKle\"}},{\"cell_type\":\"code\",\"source\":[\"\\n\",\"import os\\n\",\"import re\\n\",\"import json\\n\",\"import zipfile\\n\",\"import hashlib\\n\",\"import statistics\\n\",\"from collections import Counter, defaultdict\\n\",\"from datetime import datetime, timezone\\n\",\"from PIL import Image\\n\",\"import io\\n\",\"\\n\",\"# ============================================================\\n\",\"# STEP 2.6.17 — FULL-DATASET IMAGE INTEGRITY AUDIT\\n\",\"# ============================================================\\n\",\"\\n\",\"archive_path = \\\"/content/Experiment20_Downloads/CroppedYale.zip\\\"\\n\",\"\\n\",\"audit_dir = (\\n\",\"    \\\"/content/drive/MyDrive/Experiment_20_Results/\\\"\\n\",\"    \\\"dataset_audit\\\"\\n\",\")\\n\",\"\\n\",\"os.makedirs(audit_dir, exist_ok=True)\\n\",\"\\n\",\"output_path = os.path.join(\\n\",\"    audit_dir,\\n\",\"    \\\"experiment20_full_dataset_image_integrity_audit.json\\\"\\n\",\")\\n\",\"\\n\",\"assert os.path.exists(archive_path), (\\n\",\"    f\\\"Dataset archive not found: {archive_path}\\\"\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. FILENAME PATTERNS\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"standard_pattern = re.compile(\\n\",\"    r\\\"yaleB(\\\\d+)_P00A([+-]\\\\d+)E([+-]\\\\d+)\\\\.pgm$\\\"\\n\",\")\\n\",\"\\n\",\"ambient_pattern = re.compile(\\n\",\"    r\\\"yaleB(\\\\d+)_P00_Ambient\\\\.pgm$\\\"\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. ARCHIVE VALIDATION\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"STEP 1 — ARCHIVE VALIDATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"archive_sha256 = hashlib.sha256()\\n\",\"\\n\",\"with open(archive_path, \\\"rb\\\") as f:\\n\",\"    for chunk in iter(lambda: f.read(1024 * 1024), b\\\"\\\"):\\n\",\"        archive_sha256.update(chunk)\\n\",\"\\n\",\"archive_hash = archive_sha256.hexdigest()\\n\",\"\\n\",\"with zipfile.ZipFile(archive_path, \\\"r\\\") as archive:\\n\",\"\\n\",\"    bad_member = archive.testzip()\\n\",\"\\n\",\"    assert bad_member is None, (\\n\",\"        f\\\"ZIP integrity failure: {bad_member}\\\"\\n\",\"    )\\n\",\"\\n\",\"    archive_names = archive.namelist()\\n\",\"\\n\",\"    pgm_paths = [\\n\",\"        name for name in archive_names\\n\",\"        if name.lower().endswith(\\\".pgm\\\")\\n\",\"    ]\\n\",\"\\n\",\"    standard_records = []\\n\",\"    ambient_records = []\\n\",\"    unmatched_pgm = []\\n\",\"\\n\",\"    for path in pgm_paths:\\n\",\"\\n\",\"        filename = os.path.basename(path)\\n\",\"\\n\",\"        standard_match = standard_pattern.fullmatch(filename)\\n\",\"        ambient_match = ambient_pattern.fullmatch(filename)\\n\",\"\\n\",\"        if standard_match:\\n\",\"\\n\",\"            subject_number = int(standard_match.group(1))\\n\",\"            azimuth = int(standard_match.group(2))\\n\",\"            elevation = int(standard_match.group(3))\\n\",\"\\n\",\"            standard_records.append({\\n\",\"                \\\"path\\\": path,\\n\",\"                \\\"filename\\\": filename,\\n\",\"                \\\"subject\\\": f\\\"yaleB{subject_number:02d}\\\",\\n\",\"                \\\"subject_number\\\": subject_number,\\n\",\"                \\\"azimuth\\\": azimuth,\\n\",\"                \\\"elevation\\\": elevation,\\n\",\"                \\\"condition\\\": (\\n\",\"                    f\\\"A{azimuth:+04d}E{elevation:+03d}\\\"\\n\",\"                )\\n\",\"            })\\n\",\"\\n\",\"        elif ambient_match:\\n\",\"\\n\",\"            ambient_records.append({\\n\",\"                \\\"path\\\": path,\\n\",\"                \\\"filename\\\": filename,\\n\",\"                \\\"subject\\\": f\\\"yaleB{int(ambient_match.group(1)):02d}\\\"\\n\",\"            })\\n\",\"\\n\",\"        else:\\n\",\"            unmatched_pgm.append(path)\\n\",\"\\n\",\"    print(\\\"ZIP integrity: PASSED\\\")\\n\",\"    print(\\\"Total archive entries:\\\", len(archive_names))\\n\",\"    print(\\\"Total PGM images:\\\", len(pgm_paths))\\n\",\"    print(\\\"Standard illumination images:\\\", len(standard_records))\\n\",\"    print(\\\"Ambient images:\\\", len(ambient_records))\\n\",\"    print(\\\"Unmatched PGM files:\\\", len(unmatched_pgm))\\n\",\"\\n\",\"    assert len(standard_records) == 2414\\n\",\"    assert len(ambient_records) == 38\\n\",\"    assert len(unmatched_pgm) == 0\\n\",\"\\n\",\"    # --------------------------------------------------------\\n\",\"    # 3. DUPLICATE RECORD CHECK\\n\",\"    # --------------------------------------------------------\\n\",\"\\n\",\"    print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"    print(\\\"STEP 2 — DUPLICATE RECORD CHECK\\\")\\n\",\"    print(\\\"=\\\" * 75)\\n\",\"\\n\",\"    filenames = [\\n\",\"        record[\\\"filename\\\"]\\n\",\"        for record in standard_records\\n\",\"    ]\\n\",\"\\n\",\"    subject_condition_keys = [\\n\",\"        (\\n\",\"            record[\\\"subject\\\"],\\n\",\"            record[\\\"condition\\\"]\\n\",\"        )\\n\",\"        for record in standard_records\\n\",\"    ]\\n\",\"\\n\",\"    duplicate_filenames = [\\n\",\"        name for name, count in Counter(filenames).items()\\n\",\"        if count > 1\\n\",\"    ]\\n\",\"\\n\",\"    duplicate_subject_conditions = [\\n\",\"        key for key, count in Counter(\\n\",\"            subject_condition_keys\\n\",\"        ).items()\\n\",\"        if count > 1\\n\",\"    ]\\n\",\"\\n\",\"    print(\\\"Duplicate standard filenames:\\\", len(duplicate_filenames))\\n\",\"    print(\\n\",\"        \\\"Duplicate subject-condition records:\\\",\\n\",\"        len(duplicate_subject_conditions)\\n\",\"    )\\n\",\"\\n\",\"    assert len(duplicate_filenames) == 0\\n\",\"    assert len(duplicate_subject_conditions) == 0\\n\",\"\\n\",\"    # --------------------------------------------------------\\n\",\"    # 4. IMAGE DECODING AND PIXEL VALIDATION\\n\",\"    # --------------------------------------------------------\\n\",\"\\n\",\"    print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"    print(\\\"STEP 3 — IMAGE DECODING AND PIXEL VALIDATION\\\")\\n\",\"    print(\\\"=\\\" * 75)\\n\",\"\\n\",\"    decoding_failures = []\\n\",\"    dimension_counts = Counter()\\n\",\"    mode_counts = Counter()\\n\",\"    dtype_counts = Counter()\\n\",\"\\n\",\"    pixel_min_values = []\\n\",\"    pixel_max_values = []\\n\",\"\\n\",\"    constant_images = []\\n\",\"    non_grayscale_images = []\\n\",\"    unexpected_dimensions = []\\n\",\"    pixel_anomalies = []\\n\",\"\\n\",\"    image_hashes = defaultdict(list)\\n\",\"\\n\",\"    for index, record in enumerate(standard_records, start=1):\\n\",\"\\n\",\"        path = record[\\\"path\\\"]\\n\",\"\\n\",\"        try:\\n\",\"\\n\",\"            image_bytes = archive.read(path)\\n\",\"\\n\",\"            # Hash the exact source image bytes.\\n\",\"            source_hash = hashlib.sha256(\\n\",\"                image_bytes\\n\",\"            ).hexdigest()\\n\",\"\\n\",\"            image_hashes[source_hash].append(path)\\n\",\"\\n\",\"            with Image.open(io.BytesIO(image_bytes)) as image:\\n\",\"\\n\",\"                image.load()\\n\",\"\\n\",\"                mode = image.mode\\n\",\"                dimensions = image.size\\n\",\"\\n\",\"                image_array = __import__(\\\"numpy\\\").array(image)\\n\",\"\\n\",\"                dimension_counts[str(dimensions)] += 1\\n\",\"                mode_counts[mode] += 1\\n\",\"                dtype_counts[str(image_array.dtype)] += 1\\n\",\"\\n\",\"                if mode != \\\"L\\\":\\n\",\"                    non_grayscale_images.append({\\n\",\"                        \\\"path\\\": path,\\n\",\"                        \\\"mode\\\": mode\\n\",\"                    })\\n\",\"\\n\",\"                if dimensions != (168, 192):\\n\",\"                    unexpected_dimensions.append({\\n\",\"                        \\\"path\\\": path,\\n\",\"                        \\\"dimensions\\\": list(dimensions)\\n\",\"                    })\\n\",\"\\n\",\"                if image_array.size == 0:\\n\",\"                    pixel_anomalies.append({\\n\",\"                        \\\"path\\\": path,\\n\",\"                        \\\"reason\\\": \\\"Empty pixel array\\\"\\n\",\"                    })\\n\",\"                    continue\\n\",\"\\n\",\"                if image_array.min() < 0 or image_array.max() > 255:\\n\",\"                    pixel_anomalies.append({\\n\",\"                        \\\"path\\\": path,\\n\",\"                        \\\"reason\\\": \\\"Pixel value outside 0-255\\\"\\n\",\"                    })\\n\",\"\\n\",\"                minimum = int(image_array.min())\\n\",\"                maximum = int(image_array.max())\\n\",\"\\n\",\"                pixel_min_values.append(minimum)\\n\",\"                pixel_max_values.append(maximum)\\n\",\"\\n\",\"                if minimum == maximum:\\n\",\"                    constant_images.append({\\n\",\"                        \\\"path\\\": path,\\n\",\"                        \\\"pixel_value\\\": minimum\\n\",\"                    })\\n\",\"\\n\",\"        except Exception as exc:\\n\",\"\\n\",\"            decoding_failures.append({\\n\",\"                \\\"path\\\": path,\\n\",\"                \\\"error\\\": str(exc)\\n\",\"            })\\n\",\"\\n\",\"        if index % 250 == 0 or index == len(standard_records):\\n\",\"            print(\\n\",\"                f\\\"Processed {index}/{len(standard_records)} images\\\"\\n\",\"            )\\n\",\"\\n\",\"    # --------------------------------------------------------\\n\",\"    # 5. EXACT BYTE DUPLICATE CHECK\\n\",\"    # --------------------------------------------------------\\n\",\"\\n\",\"    exact_duplicate_groups = [\\n\",\"        paths for paths in image_hashes.values()\\n\",\"        if len(paths) > 1\\n\",\"    ]\\n\",\"\\n\",\"    # --------------------------------------------------------\\n\",\"    # 6. SUBJECT AND CONDITION COVERAGE\\n\",\"    # --------------------------------------------------------\\n\",\"\\n\",\"    print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"    print(\\\"STEP 4 — SUBJECT AND CONDITION COVERAGE\\\")\\n\",\"    print(\\\"=\\\" * 75)\\n\",\"\\n\",\"    subject_counts = Counter(\\n\",\"        record[\\\"subject\\\"]\\n\",\"        for record in standard_records\\n\",\"    )\\n\",\"\\n\",\"    condition_subjects = defaultdict(set)\\n\",\"\\n\",\"    for record in standard_records:\\n\",\"        condition_subjects[record[\\\"condition\\\"]].add(\\n\",\"            record[\\\"subject\\\"]\\n\",\"        )\\n\",\"\\n\",\"    all_subjects = sorted(subject_counts.keys())\\n\",\"\\n\",\"    all_conditions = sorted(condition_subjects.keys())\\n\",\"\\n\",\"    common_conditions = sorted([\\n\",\"        condition\\n\",\"        for condition, subjects in condition_subjects.items()\\n\",\"        if len(subjects) == len(all_subjects)\\n\",\"    ])\\n\",\"\\n\",\"    incomplete_subjects = {\\n\",\"        subject: count\\n\",\"        for subject, count in subject_counts.items()\\n\",\"        if count != 64\\n\",\"    }\\n\",\"\\n\",\"    print(\\\"Unique subjects:\\\", len(all_subjects))\\n\",\"    print(\\\"Unique illumination conditions:\\\", len(all_conditions))\\n\",\"    print(\\\"Common conditions across all subjects:\\\", len(common_conditions))\\n\",\"    print(\\\"Subjects with incomplete condition coverage:\\\", len(incomplete_subjects))\\n\",\"    print(\\\"Total common-condition observations:\\\",\\n\",\"          len(all_subjects) * len(common_conditions))\\n\",\"\\n\",\"    # --------------------------------------------------------\\n\",\"    # 7. AUDIT SUMMARY\\n\",\"    # --------------------------------------------------------\\n\",\"\\n\",\"    print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"    print(\\\"STEP 5 — AUDIT SUMMARY\\\")\\n\",\"    print(\\\"=\\\" * 75)\\n\",\"\\n\",\"    print(\\\"Decoded images:\\\", len(standard_records) - len(decoding_failures))\\n\",\"    print(\\\"Decoding failures:\\\", len(decoding_failures))\\n\",\"    print(\\\"Unexpected dimensions:\\\", len(unexpected_dimensions))\\n\",\"    print(\\\"Non-grayscale images:\\\", len(non_grayscale_images))\\n\",\"    print(\\\"Constant images:\\\", len(constant_images))\\n\",\"    print(\\\"Pixel anomalies:\\\", len(pixel_anomalies))\\n\",\"    print(\\\"Exact duplicate image groups:\\\", len(exact_duplicate_groups))\\n\",\"\\n\",\"    print(\\\"\\\\nDimension distribution:\\\", dict(dimension_counts))\\n\",\"    print(\\\"Image mode distribution:\\\", dict(mode_counts))\\n\",\"    print(\\\"Data type distribution:\\\", dict(dtype_counts))\\n\",\"\\n\",\"    # --------------------------------------------------------\\n\",\"    # 8. BUILD AUDIT REPORT\\n\",\"    # --------------------------------------------------------\\n\",\"\\n\",\"    import numpy as np\\n\",\"\\n\",\"    audit_report = {\\n\",\"        \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"        \\\"step\\\": \\\"2.6.17\\\",\\n\",\"        \\\"audit_name\\\": \\\"Full-Dataset Image Integrity Audit\\\",\\n\",\"        \\\"timestamp_utc\\\": datetime.now(\\n\",\"            timezone.utc\\n\",\"        ).isoformat(),\\n\",\"\\n\",\"        \\\"archive\\\": {\\n\",\"            \\\"path\\\": archive_path,\\n\",\"            \\\"sha256\\\": archive_hash,\\n\",\"            \\\"zip_integrity\\\": \\\"PASSED\\\",\\n\",\"            \\\"total_archive_entries\\\": len(archive_names),\\n\",\"            \\\"total_pgm_images\\\": len(pgm_paths)\\n\",\"        },\\n\",\"\\n\",\"        \\\"dataset_counts\\\": {\\n\",\"            \\\"standard_illumination_images\\\": len(standard_records),\\n\",\"            \\\"ambient_images\\\": len(ambient_records),\\n\",\"            \\\"unmatched_pgm_files\\\": len(unmatched_pgm),\\n\",\"            \\\"unique_subjects\\\": len(all_subjects),\\n\",\"            \\\"unique_illumination_conditions\\\": len(all_conditions),\\n\",\"            \\\"common_illumination_conditions\\\": len(common_conditions),\\n\",\"            \\\"common_condition_observations\\\": (\\n\",\"                len(all_subjects) * len(common_conditions)\\n\",\"            )\\n\",\"        },\\n\",\"\\n\",\"        \\\"image_integrity\\\": {\\n\",\"            \\\"decoded_images\\\": (\\n\",\"                len(standard_records) - len(decoding_failures)\\n\",\"            ),\\n\",\"            \\\"decoding_failures\\\": decoding_failures,\\n\",\"            \\\"dimension_distribution\\\": dict(dimension_counts),\\n\",\"            \\\"unexpected_dimensions\\\": unexpected_dimensions,\\n\",\"            \\\"mode_distribution\\\": dict(mode_counts),\\n\",\"            \\\"non_grayscale_images\\\": non_grayscale_images,\\n\",\"            \\\"dtype_distribution\\\": dict(dtype_counts),\\n\",\"            \\\"constant_images\\\": constant_images,\\n\",\"            \\\"pixel_anomalies\\\": pixel_anomalies,\\n\",\"            \\\"pixel_minimum_observed\\\": (\\n\",\"                min(pixel_min_values) if pixel_min_values else None\\n\",\"            ),\\n\",\"            \\\"pixel_maximum_observed\\\": (\\n\",\"                max(pixel_max_values) if pixel_max_values else None\\n\",\"            )\\n\",\"        },\\n\",\"\\n\",\"        \\\"duplicate_checks\\\": {\\n\",\"            \\\"duplicate_filenames\\\": duplicate_filenames,\\n\",\"            \\\"duplicate_subject_condition_records\\\": [\\n\",\"                list(key)\\n\",\"                for key in duplicate_subject_conditions\\n\",\"            ],\\n\",\"            \\\"exact_duplicate_image_groups\\\": exact_duplicate_groups\\n\",\"        },\\n\",\"\\n\",\"        \\\"subject_coverage\\\": {\\n\",\"            \\\"subject_image_counts\\\": dict(subject_counts),\\n\",\"            \\\"incomplete_subjects\\\": incomplete_subjects,\\n\",\"            \\\"subjects\\\": all_subjects\\n\",\"        },\\n\",\"\\n\",\"        \\\"illumination_coverage\\\": {\\n\",\"            \\\"all_conditions\\\": all_conditions,\\n\",\"            \\\"common_conditions\\\": common_conditions,\\n\",\"            \\\"condition_subject_counts\\\": {\\n\",\"                condition: len(subjects)\\n\",\"                for condition, subjects in condition_subjects.items()\\n\",\"            }\\n\",\"        },\\n\",\"\\n\",\"        \\\"limitations\\\": [\\n\",\"            \\\"This audit verifies image integrity, not biometric recognition accuracy.\\\",\\n\",\"            \\\"Successful image decoding does not establish suitability for FaceNet.\\\",\\n\",\"            \\\"Exact duplicate detection uses source-byte SHA256 hashes.\\\",\\n\",\"            \\\"The dataset is a community-hosted CroppedYale archive.\\\"\\n\",\"        ]\\n\",\"    }\\n\",\"\\n\",\"    # --------------------------------------------------------\\n\",\"    # 9. SAVE REPORT\\n\",\"    # --------------------------------------------------------\\n\",\"\\n\",\"    with open(output_path, \\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"        json.dump(\\n\",\"            audit_report,\\n\",\"            f,\\n\",\"            indent=2\\n\",\"        )\\n\",\"\\n\",\"    print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"    print(\\\"STEP 6 — REPORT SAVED\\\")\\n\",\"    print(\\\"=\\\" * 75)\\n\",\"\\n\",\"    print(\\\"Audit report:\\\", output_path)\\n\",\"    print(\\\"Archive SHA256:\\\", archive_hash)\\n\",\"\\n\",\"    print(\\\"\\\\nNo embeddings generated.\\\")\\n\",\"    print(\\\"No source archive files modified.\\\")\\n\",\"\\n\",\"    print(\\\"=\\\" * 75)\\n\",\"    print(\\\"STEP 2.6.17 AUDIT FINISHED\\\")\\n\",\"    print(\\\"=\\\" * 75)\\n\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"OdbeirzEvNsv\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794352414486,\"user_tz\":360,\"elapsed\":6838,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"4df048d3-9cbb-4e39-9dd8-797a87047464\"},\"execution_count\":null,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"===========================================================================\\n\",\"STEP 1 — ARCHIVE VALIDATION\\n\",\"===========================================================================\\n\",\"ZIP integrity: PASSED\\n\",\"Total archive entries: 2586\\n\",\"Total PGM images: 2452\\n\",\"Standard illumination images: 2414\\n\",\"Ambient images: 38\\n\",\"Unmatched PGM files: 0\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 2 — DUPLICATE RECORD CHECK\\n\",\"===========================================================================\\n\",\"Duplicate standard filenames: 0\\n\",\"Duplicate subject-condition records: 0\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 3 — IMAGE DECODING AND PIXEL VALIDATION\\n\",\"===========================================================================\\n\",\"Processed 250/2414 images\\n\",\"Processed 500/2414 images\\n\",\"Processed 750/2414 images\\n\",\"Processed 1000/2414 images\\n\",\"Processed 1250/2414 images\\n\",\"Processed 1500/2414 images\\n\",\"Processed 1750/2414 images\\n\",\"Processed 2000/2414 images\\n\",\"Processed 2250/2414 images\\n\",\"Processed 2414/2414 images\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 4 — SUBJECT AND CONDITION COVERAGE\\n\",\"===========================================================================\\n\",\"Unique subjects: 38\\n\",\"Unique illumination conditions: 64\\n\",\"Common conditions across all subjects: 57\\n\",\"Subjects with incomplete condition coverage: 7\\n\",\"Total common-condition observations: 2166\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 5 — AUDIT SUMMARY\\n\",\"===========================================================================\\n\",\"Decoded images: 2414\\n\",\"Decoding failures: 0\\n\",\"Unexpected dimensions: 0\\n\",\"Non-grayscale images: 0\\n\",\"Constant images: 0\\n\",\"Pixel anomalies: 0\\n\",\"Exact duplicate image groups: 0\\n\",\"\\n\",\"Dimension distribution: {'(168, 192)': 2414}\\n\",\"Image mode distribution: {'L': 2414}\\n\",\"Data type distribution: {'uint8': 2414}\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 6 — REPORT SAVED\\n\",\"===========================================================================\\n\",\"Audit report: /content/drive/MyDrive/Experiment_20_Results/dataset_audit/experiment20_full_dataset_image_integrity_audit.json\\n\",\"Archive SHA256: 8bbabf3836d077d60626c9ee3c54c2d2851a8d2c15c8b7e13b9bc162e86ea573\\n\",\"\\n\",\"No embeddings generated.\\n\",\"No source archive files modified.\\n\",\"===========================================================================\\n\",\"STEP 2.6.17 AUDIT FINISHED\\n\",\"===========================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"\\n\",\"## Step 2.6.18 — Preprocessing Consistency Audit\\n\",\"\\n\",\"### Objective\\n\",\"Validate the reproducibility and consistency of the proposed direct FaceNet preprocessing pipeline across all 2,414 standard CroppedYale illumination images.\\n\",\"\\n\",\"### Frozen preprocessing specification\\n\",\"1. Load the original PGM image.\\n\",\"2. Convert grayscale mode L to RGB.\\n\",\"3. Resize directly to 160 × 160 pixels.\\n\",\"4. Convert the image to a PyTorch tensor using torchvision.transforms.ToTensor().\\n\",\"5. Retain the resulting three-channel tensor with values in [0, 1].\\n\",\"\\n\",\"### Validation checks\\n\",\"- Successful processing of every standard illumination image.\\n\",\"- RGB image mode.\\n\",\"- Exact image dimensions of 160 × 160.\\n\",\"- Tensor shape of (3, 160, 160).\\n\",\"- Finite tensor values.\\n\",\"- Pixel values within [0, 1].\\n\",\"- Deterministic output when the same image is processed twice.\\n\",\"- Consistent preprocessing across subjects and illumination conditions.\\n\",\"\\n\",\"### Important methodological limitation\\n\",\"Direct resizing is not equivalent to the MTCNN detection and alignment pipeline used in Experiment 18. Experiment 20 will document this preprocessing difference explicitly.\\n\",\"\\n\",\"No FaceNet embeddings will be generated in this step.\\n\"],\"metadata\":{\"id\":\"LADljS6ivesH\"}},{\"cell_type\":\"code\",\"source\":[\"\\n\",\"import os\\n\",\"import re\\n\",\"import io\\n\",\"import json\\n\",\"import zipfile\\n\",\"import hashlib\\n\",\"import numpy as np\\n\",\"import torch\\n\",\"\\n\",\"from PIL import Image\\n\",\"from torchvision import transforms\\n\",\"from collections import Counter\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"# ============================================================\\n\",\"# STEP 2.6.18 — PREPROCESSING CONSISTENCY AUDIT\\n\",\"# ============================================================\\n\",\"\\n\",\"archive_path = \\\"/content/Experiment20_Downloads/CroppedYale.zip\\\"\\n\",\"\\n\",\"audit_dir = (\\n\",\"    \\\"/content/drive/MyDrive/Experiment_20_Results/\\\"\\n\",\"    \\\"dataset_audit\\\"\\n\",\")\\n\",\"\\n\",\"os.makedirs(audit_dir, exist_ok=True)\\n\",\"\\n\",\"output_path = os.path.join(\\n\",\"    audit_dir,\\n\",\"    \\\"experiment20_preprocessing_consistency_audit.json\\\"\\n\",\")\\n\",\"\\n\",\"assert os.path.exists(archive_path), (\\n\",\"    f\\\"Archive not found: {archive_path}\\\"\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. FROZEN PREPROCESSING CONFIGURATION\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"standard_pattern = re.compile(\\n\",\"    r\\\"yaleB(\\\\d+)_P00A([+-]\\\\d+)E([+-]\\\\d+)\\\\.pgm$\\\"\\n\",\")\\n\",\"\\n\",\"preprocessing = transforms.Compose([\\n\",\"    transforms.Resize((160, 160)),\\n\",\"    transforms.ToTensor()\\n\",\"])\\n\",\"\\n\",\"expected_shape = (3, 160, 160)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. ARCHIVE AND IMAGE SELECTION\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"STEP 1 — DATASET IMAGE SELECTION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"with zipfile.ZipFile(archive_path, \\\"r\\\") as archive:\\n\",\"\\n\",\"    assert archive.testzip() is None, (\\n\",\"        \\\"Archive integrity check failed.\\\"\\n\",\"    )\\n\",\"\\n\",\"    standard_paths = []\\n\",\"\\n\",\"    for path in archive.namelist():\\n\",\"\\n\",\"        if not path.lower().endswith(\\\".pgm\\\"):\\n\",\"            continue\\n\",\"\\n\",\"        filename = os.path.basename(path)\\n\",\"\\n\",\"        if standard_pattern.fullmatch(filename):\\n\",\"            standard_paths.append(path)\\n\",\"\\n\",\"    standard_paths.sort()\\n\",\"\\n\",\"    print(\\\"Standard illumination images:\\\", len(standard_paths))\\n\",\"\\n\",\"    assert len(standard_paths) == 2414, (\\n\",\"        f\\\"Expected 2414 images, found {len(standard_paths)}\\\"\\n\",\"    )\\n\",\"\\n\",\"    # --------------------------------------------------------\\n\",\"    # 3. PREPROCESSING VALIDATION\\n\",\"    # --------------------------------------------------------\\n\",\"\\n\",\"    print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"    print(\\\"STEP 2 — PREPROCESSING VALIDATION\\\")\\n\",\"    print(\\\"=\\\" * 75)\\n\",\"\\n\",\"    processing_failures = []\\n\",\"    mode_failures = []\\n\",\"    dimension_failures = []\\n\",\"    shape_failures = []\\n\",\"    nonfinite_failures = []\\n\",\"    range_failures = []\\n\",\"    reproducibility_failures = []\\n\",\"\\n\",\"    output_shapes = Counter()\\n\",\"    output_dtypes = Counter()\\n\",\"    subject_counts = Counter()\\n\",\"\\n\",\"    global_min = float(\\\"inf\\\")\\n\",\"    global_max = float(\\\"-inf\\\")\\n\",\"\\n\",\"    sample_records = []\\n\",\"\\n\",\"    for index, path in enumerate(standard_paths, start=1):\\n\",\"\\n\",\"        filename = os.path.basename(path)\\n\",\"\\n\",\"        match = standard_pattern.fullmatch(filename)\\n\",\"\\n\",\"        subject = f\\\"yaleB{int(match.group(1)):02d}\\\"\\n\",\"\\n\",\"        subject_counts[subject] += 1\\n\",\"\\n\",\"        try:\\n\",\"\\n\",\"            image_bytes = archive.read(path)\\n\",\"\\n\",\"            with Image.open(io.BytesIO(image_bytes)) as source:\\n\",\"\\n\",\"                source.load()\\n\",\"\\n\",\"                # The source image must be grayscale.\\n\",\"                if source.mode != \\\"L\\\":\\n\",\"                    mode_failures.append({\\n\",\"                        \\\"path\\\": path,\\n\",\"                        \\\"mode\\\": source.mode\\n\",\"                    })\\n\",\"\\n\",\"                # Convert grayscale to three-channel RGB.\\n\",\"                rgb_image = source.convert(\\\"RGB\\\")\\n\",\"\\n\",\"                if rgb_image.mode != \\\"RGB\\\":\\n\",\"                    mode_failures.append({\\n\",\"                        \\\"path\\\": path,\\n\",\"                        \\\"converted_mode\\\": rgb_image.mode\\n\",\"                    })\\n\",\"\\n\",\"                # Resize and convert to tensor.\\n\",\"                tensor_first = preprocessing(rgb_image)\\n\",\"\\n\",\"                # Repeat preprocessing independently.\\n\",\"                tensor_second = preprocessing(\\n\",\"                    source.convert(\\\"RGB\\\")\\n\",\"                )\\n\",\"\\n\",\"                # Validate dimensions.\\n\",\"                if rgb_image.size != (168, 192):\\n\",\"                    dimension_failures.append({\\n\",\"                        \\\"path\\\": path,\\n\",\"                        \\\"dimensions\\\": list(rgb_image.size)\\n\",\"                    })\\n\",\"\\n\",\"                # Validate tensor shape.\\n\",\"                if tuple(tensor_first.shape) != expected_shape:\\n\",\"                    shape_failures.append({\\n\",\"                        \\\"path\\\": path,\\n\",\"                        \\\"shape\\\": list(tensor_first.shape)\\n\",\"                    })\\n\",\"\\n\",\"                # Validate numerical finiteness.\\n\",\"                if not torch.isfinite(tensor_first).all():\\n\",\"                    nonfinite_failures.append(path)\\n\",\"\\n\",\"                # Validate tensor range.\\n\",\"                tensor_min = float(tensor_first.min())\\n\",\"                tensor_max = float(tensor_first.max())\\n\",\"\\n\",\"                if tensor_min < 0.0 or tensor_max > 1.0:\\n\",\"                    range_failures.append({\\n\",\"                        \\\"path\\\": path,\\n\",\"                        \\\"minimum\\\": tensor_min,\\n\",\"                        \\\"maximum\\\": tensor_max\\n\",\"                    })\\n\",\"\\n\",\"                global_min = min(global_min, tensor_min)\\n\",\"                global_max = max(global_max, tensor_max)\\n\",\"\\n\",\"                # Validate reproducibility.\\n\",\"                if not torch.equal(\\n\",\"                    tensor_first,\\n\",\"                    tensor_second\\n\",\"                ):\\n\",\"                    reproducibility_failures.append(path)\\n\",\"\\n\",\"                output_shapes[str(tuple(tensor_first.shape))] += 1\\n\",\"                output_dtypes[str(tensor_first.dtype)] += 1\\n\",\"\\n\",\"                if index <= 12:\\n\",\"                    sample_records.append({\\n\",\"                        \\\"filename\\\": filename,\\n\",\"                        \\\"subject\\\": subject,\\n\",\"                        \\\"source_mode\\\": source.mode,\\n\",\"                        \\\"rgb_mode\\\": rgb_image.mode,\\n\",\"                        \\\"rgb_dimensions\\\": list(rgb_image.size),\\n\",\"                        \\\"tensor_shape\\\": list(tensor_first.shape),\\n\",\"                        \\\"tensor_dtype\\\": str(tensor_first.dtype),\\n\",\"                        \\\"tensor_min\\\": tensor_min,\\n\",\"                        \\\"tensor_max\\\": tensor_max,\\n\",\"                        \\\"reproducible\\\": torch.equal(\\n\",\"                            tensor_first,\\n\",\"                            tensor_second\\n\",\"                        )\\n\",\"                    })\\n\",\"\\n\",\"        except Exception as exc:\\n\",\"\\n\",\"            processing_failures.append({\\n\",\"                \\\"path\\\": path,\\n\",\"                \\\"error\\\": str(exc)\\n\",\"            })\\n\",\"\\n\",\"        if index % 250 == 0 or index == len(standard_paths):\\n\",\"            print(\\n\",\"                f\\\"Processed {index}/{len(standard_paths)} images\\\"\\n\",\"            )\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. SUMMARY\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 3 — PREPROCESSING AUDIT SUMMARY\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"print(\\\"Images selected:\\\", len(standard_paths))\\n\",\"print(\\\"Processing failures:\\\", len(processing_failures))\\n\",\"print(\\\"Mode failures:\\\", len(mode_failures))\\n\",\"print(\\\"Dimension failures:\\\", len(dimension_failures))\\n\",\"print(\\\"Tensor shape failures:\\\", len(shape_failures))\\n\",\"print(\\\"Non-finite tensor failures:\\\", len(nonfinite_failures))\\n\",\"print(\\\"Tensor range failures:\\\", len(range_failures))\\n\",\"print(\\\"Reproducibility failures:\\\", len(reproducibility_failures))\\n\",\"\\n\",\"print(\\\"\\\\nTensor shape distribution:\\\", dict(output_shapes))\\n\",\"print(\\\"Tensor dtype distribution:\\\", dict(output_dtypes))\\n\",\"\\n\",\"print(\\\"Global tensor minimum:\\\", global_min)\\n\",\"print(\\\"Global tensor maximum:\\\", global_max)\\n\",\"\\n\",\"print(\\\"\\\\nUnique subjects processed:\\\", len(subject_counts))\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. PREPROCESSING CONFIGURATION FINGERPRINT\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"configuration = {\\n\",\"    \\\"source_mode\\\": \\\"L\\\",\\n\",\"    \\\"conversion\\\": \\\"PIL.Image.convert('RGB')\\\",\\n\",\"    \\\"resize\\\": [160, 160],\\n\",\"    \\\"resize_method\\\": \\\"torchvision.transforms.Resize\\\",\\n\",\"    \\\"tensor_conversion\\\": \\\"torchvision.transforms.ToTensor\\\",\\n\",\"    \\\"tensor_shape\\\": [3, 160, 160],\\n\",\"    \\\"tensor_dtype\\\": \\\"torch.float32\\\",\\n\",\"    \\\"expected_value_range\\\": [0.0, 1.0],\\n\",\"    \\\"face_detection\\\": False,\\n\",\"    \\\"face_alignment\\\": False\\n\",\"}\\n\",\"\\n\",\"configuration_json = json.dumps(\\n\",\"    configuration,\\n\",\"    sort_keys=True\\n\",\")\\n\",\"\\n\",\"configuration_sha256 = hashlib.sha256(\\n\",\"    configuration_json.encode(\\\"utf-8\\\")\\n\",\").hexdigest()\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. FINAL PASS / FAIL\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"audit_passed = all([\\n\",\"    len(standard_paths) == 2414,\\n\",\"    len(processing_failures) == 0,\\n\",\"    len(mode_failures) == 0,\\n\",\"    len(dimension_failures) == 0,\\n\",\"    len(shape_failures) == 0,\\n\",\"    len(nonfinite_failures) == 0,\\n\",\"    len(range_failures) == 0,\\n\",\"    len(reproducibility_failures) == 0,\\n\",\"    len(subject_counts) == 38,\\n\",\"    dict(output_shapes) == {\\n\",\"        \\\"(3, 160, 160)\\\": 2414\\n\",\"    }\\n\",\"])\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. SAVE AUDIT REPORT\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"audit_report = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"step\\\": \\\"2.6.18\\\",\\n\",\"    \\\"audit_name\\\": \\\"Preprocessing Consistency Audit\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(\\n\",\"        timezone.utc\\n\",\"    ).isoformat(),\\n\",\"\\n\",\"    \\\"dataset\\\": {\\n\",\"        \\\"archive_path\\\": archive_path,\\n\",\"        \\\"standard_images\\\": len(standard_paths),\\n\",\"        \\\"unique_subjects\\\": len(subject_counts),\\n\",\"        \\\"subject_image_counts\\\": dict(subject_counts)\\n\",\"    },\\n\",\"\\n\",\"    \\\"preprocessing_configuration\\\": configuration,\\n\",\"    \\\"preprocessing_configuration_sha256\\\": configuration_sha256,\\n\",\"\\n\",\"    \\\"validation\\\": {\\n\",\"        \\\"processing_failures\\\": processing_failures,\\n\",\"        \\\"mode_failures\\\": mode_failures,\\n\",\"        \\\"dimension_failures\\\": dimension_failures,\\n\",\"        \\\"tensor_shape_failures\\\": shape_failures,\\n\",\"        \\\"nonfinite_failures\\\": nonfinite_failures,\\n\",\"        \\\"range_failures\\\": range_failures,\\n\",\"        \\\"reproducibility_failures\\\": reproducibility_failures,\\n\",\"        \\\"tensor_shape_distribution\\\": dict(output_shapes),\\n\",\"        \\\"tensor_dtype_distribution\\\": dict(output_dtypes),\\n\",\"        \\\"global_tensor_minimum\\\": (\\n\",\"            global_min if np.isfinite(global_min) else None\\n\",\"        ),\\n\",\"        \\\"global_tensor_maximum\\\": (\\n\",\"            global_max if np.isfinite(global_max) else None\\n\",\"        )\\n\",\"    },\\n\",\"\\n\",\"    \\\"sample_records\\\": sample_records,\\n\",\"\\n\",\"    \\\"audit_status\\\": (\\n\",\"        \\\"PASSED\\\" if audit_passed else \\\"FAILED\\\"\\n\",\"    ),\\n\",\"\\n\",\"    \\\"limitations\\\": [\\n\",\"        \\\"This audit validates preprocessing consistency, not embedding quality.\\\",\\n\",\"        \\\"Direct resizing does not perform MTCNN detection or alignment.\\\",\\n\",\"        \\\"The preprocessing pipeline differs from Experiment 18.\\\",\\n\",\"        \\\"No FaceNet embeddings were generated.\\\"\\n\",\"    ]\\n\",\"}\\n\",\"\\n\",\"with open(output_path, \\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    json.dump(audit_report, f, indent=2)\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 4 — FINAL AUDIT RESULT\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"print(\\\"Audit status:\\\", \\\"PASSED\\\" if audit_passed else \\\"FAILED\\\")\\n\",\"print(\\\"Configuration SHA256:\\\", configuration_sha256)\\n\",\"print(\\\"Audit report:\\\", output_path)\\n\",\"\\n\",\"print(\\\"\\\\nNo FaceNet embeddings generated.\\\")\\n\",\"print(\\\"No source archive files modified.\\\")\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"STEP 2.6.18 FINISHED\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"assert audit_passed, (\\n\",\"    \\\"Preprocessing audit failed. Inspect the saved audit report.\\\"\\n\",\")\\n\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"72bwG6gqvhXo\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794352501235,\"user_tz\":360,\"elapsed\":12004,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"5299c2a2-6c4e-422f-a99b-37fdfa4e86f0\"},\"execution_count\":null,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"===========================================================================\\n\",\"STEP 1 — DATASET IMAGE SELECTION\\n\",\"===========================================================================\\n\",\"Standard illumination images: 2414\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 2 — PREPROCESSING VALIDATION\\n\",\"===========================================================================\\n\",\"Processed 250/2414 images\\n\",\"Processed 500/2414 images\\n\",\"Processed 750/2414 images\\n\",\"Processed 1000/2414 images\\n\",\"Processed 1250/2414 images\\n\",\"Processed 1500/2414 images\\n\",\"Processed 1750/2414 images\\n\",\"Processed 2000/2414 images\\n\",\"Processed 2250/2414 images\\n\",\"Processed 2414/2414 images\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 3 — PREPROCESSING AUDIT SUMMARY\\n\",\"===========================================================================\\n\",\"Images selected: 2414\\n\",\"Processing failures: 0\\n\",\"Mode failures: 0\\n\",\"Dimension failures: 0\\n\",\"Tensor shape failures: 0\\n\",\"Non-finite tensor failures: 0\\n\",\"Tensor range failures: 0\\n\",\"Reproducibility failures: 0\\n\",\"\\n\",\"Tensor shape distribution: {'(3, 160, 160)': 2414}\\n\",\"Tensor dtype distribution: {'torch.float32': 2414}\\n\",\"Global tensor minimum: 0.0\\n\",\"Global tensor maximum: 1.0\\n\",\"\\n\",\"Unique subjects processed: 38\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 4 — FINAL AUDIT RESULT\\n\",\"===========================================================================\\n\",\"Audit status: PASSED\\n\",\"Configuration SHA256: 43c9e3c9bc61ed77acc0dc9aa2e348a480bf6fdbee9723d66e37717823aa50a0\\n\",\"Audit report: /content/drive/MyDrive/Experiment_20_Results/dataset_audit/experiment20_preprocessing_consistency_audit.json\\n\",\"\\n\",\"No FaceNet embeddings generated.\\n\",\"No source archive files modified.\\n\",\"===========================================================================\\n\",\"STEP 2.6.18 FINISHED\\n\",\"===========================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"\\n\",\"## Step 2.6.19 — Full-Dataset FaceNet Embedding Generation\\n\",\"\\n\",\"### Objective\\n\",\"Generate 512-dimensional FaceNet embeddings for all 2,414 standard illumination images in the CroppedYale dataset.\\n\",\"\\n\",\"### Frozen model configuration\\n\",\"- Architecture: InceptionResnetV1\\n\",\"- Pretrained weights: VGGFace2\\n\",\"- Embedding dimension: 512\\n\",\"- Device: CPU\\n\",\"- Model mode: Evaluation\\n\",\"- Gradient calculation: Disabled\\n\",\"\\n\",\"### Frozen preprocessing\\n\",\"1. Load grayscale PGM image.\\n\",\"2. Convert to RGB.\\n\",\"3. Resize to 160 × 160.\\n\",\"4. Convert to float32 tensor using ToTensor().\\n\",\"5. Generate the FaceNet embedding.\\n\",\"\\n\",\"### Data preservation\\n\",\"For each successful image, preserve:\\n\",\"- Source filename\\n\",\"- Subject identity\\n\",\"- Illumination azimuth\\n\",\"- Illumination elevation\\n\",\"- Illumination condition\\n\",\"- 512-dimensional embedding\\n\",\"\\n\",\"Extraction failures will be recorded separately.\\n\",\"\\n\",\"### Checkpointing\\n\",\"Intermediate checkpoints will be saved every 100 images to Google Drive.\\n\",\"\\n\",\"### Output\\n\",\"- Final embedding archive\\n\",\"- Extraction metadata\\n\",\"- Failure records\\n\",\"- Generation configuration\\n\",\"- Dataset provenance information\\n\",\"\\n\",\"No ambient images will be included in the primary embedding dataset.\\n\"],\"metadata\":{\"id\":\"0NsT81BWvxvY\"}},{\"cell_type\":\"code\",\"source\":[\"\\n\",\"import os\\n\",\"import re\\n\",\"import io\\n\",\"import json\\n\",\"import time\\n\",\"import hashlib\\n\",\"import zipfile\\n\",\"import platform\\n\",\"import numpy as np\\n\",\"import torch\\n\",\"\\n\",\"from PIL import Image\\n\",\"from torchvision import transforms\\n\",\"from facenet_pytorch import InceptionResnetV1\\n\",\"from importlib.metadata import version\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"# ============================================================\\n\",\"# STEP 2.6.19 — FULL-DATASET FACENET EMBEDDING GENERATION\\n\",\"# ============================================================\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. PATHS AND CONFIGURATION\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"archive_path = \\\"/content/Experiment20_Downloads/CroppedYale.zip\\\"\\n\",\"\\n\",\"base_dir = (\\n\",\"    \\\"/content/drive/MyDrive/Experiment_20_Results\\\"\\n\",\")\\n\",\"\\n\",\"embedding_dir = os.path.join(\\n\",\"    base_dir,\\n\",\"    \\\"embeddings\\\"\\n\",\")\\n\",\"\\n\",\"checkpoint_dir = os.path.join(\\n\",\"    embedding_dir,\\n\",\"    \\\"checkpoints\\\"\\n\",\")\\n\",\"\\n\",\"audit_dir = os.path.join(\\n\",\"    base_dir,\\n\",\"    \\\"dataset_audit\\\"\\n\",\")\\n\",\"\\n\",\"os.makedirs(embedding_dir, exist_ok=True)\\n\",\"os.makedirs(checkpoint_dir, exist_ok=True)\\n\",\"os.makedirs(audit_dir, exist_ok=True)\\n\",\"\\n\",\"final_archive_path = os.path.join(\\n\",\"    embedding_dir,\\n\",\"    \\\"experiment20_croppedyale_facenet_embeddings.npz\\\"\\n\",\")\\n\",\"\\n\",\"final_metadata_path = os.path.join(\\n\",\"    embedding_dir,\\n\",\"    \\\"experiment20_croppedyale_embedding_metadata.json\\\"\\n\",\")\\n\",\"\\n\",\"final_config_path = os.path.join(\\n\",\"    embedding_dir,\\n\",\"    \\\"experiment20_embedding_generation_config.json\\\"\\n\",\")\\n\",\"\\n\",\"checkpoint_path = os.path.join(\\n\",\"    checkpoint_dir,\\n\",\"    \\\"experiment20_embedding_checkpoint.npz\\\"\\n\",\")\\n\",\"\\n\",\"checkpoint_metadata_path = os.path.join(\\n\",\"    checkpoint_dir,\\n\",\"    \\\"experiment20_embedding_checkpoint_metadata.json\\\"\\n\",\")\\n\",\"\\n\",\"EXPECTED_IMAGES = 2414\\n\",\"EMBEDDING_DIMENSION = 512\\n\",\"CHECKPOINT_INTERVAL = 100\\n\",\"\\n\",\"device = torch.device(\\\"cpu\\\")\\n\",\"\\n\",\"standard_pattern = re.compile(\\n\",\"    r\\\"yaleB(\\\\d+)_P00A([+-]\\\\d+)E([+-]\\\\d+)\\\\.pgm$\\\"\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. ENVIRONMENT VALIDATION\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"STEP 1 — ENVIRONMENT VALIDATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"assert os.path.exists(archive_path), (\\n\",\"    f\\\"Dataset archive not found: {archive_path}\\\"\\n\",\")\\n\",\"\\n\",\"assert torch.cuda.is_available() is False or device.type == \\\"cpu\\\"\\n\",\"\\n\",\"print(\\\"Python:\\\", platform.python_version())\\n\",\"print(\\\"PyTorch:\\\", torch.__version__)\\n\",\"print(\\\"Torchvision:\\\", version(\\\"torchvision\\\"))\\n\",\"print(\\\"facenet-pytorch:\\\", version(\\\"facenet-pytorch\\\"))\\n\",\"print(\\\"Execution device:\\\", device)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. DATASET ARCHIVE VALIDATION\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 2 — DATASET VALIDATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"archive_sha256 = hashlib.sha256()\\n\",\"\\n\",\"with open(archive_path, \\\"rb\\\") as f:\\n\",\"    for chunk in iter(lambda: f.read(1024 * 1024), b\\\"\\\"):\\n\",\"        archive_sha256.update(chunk)\\n\",\"\\n\",\"archive_hash = archive_sha256.hexdigest()\\n\",\"\\n\",\"with zipfile.ZipFile(archive_path, \\\"r\\\") as archive:\\n\",\"\\n\",\"    assert archive.testzip() is None, (\\n\",\"        \\\"ZIP archive integrity validation failed.\\\"\\n\",\"    )\\n\",\"\\n\",\"    standard_paths = []\\n\",\"\\n\",\"    for path in archive.namelist():\\n\",\"\\n\",\"        if not path.lower().endswith(\\\".pgm\\\"):\\n\",\"            continue\\n\",\"\\n\",\"        filename = os.path.basename(path)\\n\",\"\\n\",\"        if standard_pattern.fullmatch(filename):\\n\",\"            standard_paths.append(path)\\n\",\"\\n\",\"    standard_paths.sort()\\n\",\"\\n\",\"    assert len(standard_paths) == EXPECTED_IMAGES, (\\n\",\"        f\\\"Expected {EXPECTED_IMAGES} standard images; \\\"\\n\",\"        f\\\"found {len(standard_paths)}\\\"\\n\",\"    )\\n\",\"\\n\",\"    print(\\\"Archive integrity: PASSED\\\")\\n\",\"    print(\\\"Standard images:\\\", len(standard_paths))\\n\",\"    print(\\\"Archive SHA256:\\\", archive_hash)\\n\",\"\\n\",\"    # --------------------------------------------------------\\n\",\"    # 4. MODEL INITIALISATION\\n\",\"    # --------------------------------------------------------\\n\",\"\\n\",\"    print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"    print(\\\"STEP 3 — FACENET MODEL INITIALISATION\\\")\\n\",\"    print(\\\"=\\\" * 75)\\n\",\"\\n\",\"    if \\\"facenet\\\" not in globals():\\n\",\"        facenet = InceptionResnetV1(\\n\",\"            pretrained=\\\"vggface2\\\"\\n\",\"        ).eval().to(device)\\n\",\"    else:\\n\",\"        facenet = facenet.eval().to(device)\\n\",\"\\n\",\"    assert isinstance(facenet, InceptionResnetV1)\\n\",\"\\n\",\"    facenet.eval()\\n\",\"\\n\",\"    print(\\\"Model: InceptionResnetV1\\\")\\n\",\"    print(\\\"Pretrained weights: VGGFace2\\\")\\n\",\"    print(\\\"Embedding dimension:\\\", EMBEDDING_DIMENSION)\\n\",\"    print(\\\"Model mode: Evaluation\\\")\\n\",\"\\n\",\"    # --------------------------------------------------------\\n\",\"    # 5. FROZEN PREPROCESSING\\n\",\"    # --------------------------------------------------------\\n\",\"\\n\",\"    preprocessing = transforms.Compose([\\n\",\"        transforms.Resize((160, 160)),\\n\",\"        transforms.ToTensor()\\n\",\"    ])\\n\",\"\\n\",\"    # --------------------------------------------------------\\n\",\"    # 6. CHECKPOINT RECOVERY\\n\",\"    # --------------------------------------------------------\\n\",\"\\n\",\"    embeddings = []\\n\",\"    filenames = []\\n\",\"    subjects = []\\n\",\"    subject_numbers = []\\n\",\"    azimuths = []\\n\",\"    elevations = []\\n\",\"    conditions = []\\n\",\"\\n\",\"    failures = []\\n\",\"    processed_paths = set()\\n\",\"\\n\",\"    start_index = 0\\n\",\"\\n\",\"    if (\\n\",\"        os.path.exists(checkpoint_path)\\n\",\"        and os.path.exists(checkpoint_metadata_path)\\n\",\"    ):\\n\",\"\\n\",\"        print(\\\"\\\\nExisting checkpoint detected.\\\")\\n\",\"\\n\",\"        with open(\\n\",\"            checkpoint_metadata_path,\\n\",\"            \\\"r\\\",\\n\",\"            encoding=\\\"utf-8\\\"\\n\",\"        ) as f:\\n\",\"            checkpoint_metadata = json.load(f)\\n\",\"\\n\",\"        if (\\n\",\"            checkpoint_metadata.get(\\\"archive_sha256\\\") == archive_hash\\n\",\"            and checkpoint_metadata.get(\\\"expected_images\\\") == EXPECTED_IMAGES\\n\",\"            and checkpoint_metadata.get(\\\"embedding_dimension\\\") == EMBEDDING_DIMENSION\\n\",\"        ):\\n\",\"\\n\",\"            checkpoint = np.load(\\n\",\"                checkpoint_path,\\n\",\"                allow_pickle=False\\n\",\"            )\\n\",\"\\n\",\"            embeddings = checkpoint[\\\"embeddings\\\"].tolist()\\n\",\"            filenames = checkpoint[\\\"filenames\\\"].tolist()\\n\",\"            subjects = checkpoint[\\\"subjects\\\"].tolist()\\n\",\"            subject_numbers = checkpoint[\\\"subject_numbers\\\"].tolist()\\n\",\"            azimuths = checkpoint[\\\"azimuths\\\"].tolist()\\n\",\"            elevations = checkpoint[\\\"elevations\\\"].tolist()\\n\",\"            conditions = checkpoint[\\\"conditions\\\"].tolist()\\n\",\"\\n\",\"            failures = checkpoint_metadata.get(\\n\",\"                \\\"failures\\\",\\n\",\"                []\\n\",\"            )\\n\",\"\\n\",\"            processed_paths = set(\\n\",\"                checkpoint_metadata.get(\\n\",\"                    \\\"processed_paths\\\",\\n\",\"                    []\\n\",\"                )\\n\",\"            )\\n\",\"\\n\",\"            checkpoint.close()\\n\",\"\\n\",\"            start_index = len(processed_paths)\\n\",\"\\n\",\"            print(\\\"Checkpoint recovery: PASSED\\\")\\n\",\"            print(\\\"Previously processed images:\\\", start_index)\\n\",\"            print(\\\"Successful embeddings recovered:\\\", len(embeddings))\\n\",\"            print(\\\"Recorded failures recovered:\\\", len(failures))\\n\",\"\\n\",\"        else:\\n\",\"            print(\\n\",\"                \\\"Checkpoint does not match this archive/configuration. \\\"\\n\",\"                \\\"Starting a fresh run.\\\"\\n\",\"            )\\n\",\"\\n\",\"    # --------------------------------------------------------\\n\",\"    # 7. CHECKPOINT SAVE FUNCTION\\n\",\"    # --------------------------------------------------------\\n\",\"\\n\",\"    def save_checkpoint():\\n\",\"\\n\",\"        temporary_path = checkpoint_path + \\\".tmp\\\"\\n\",\"\\n\",\"        with open(temporary_path, \\\"wb\\\") as f:\\n\",\"\\n\",\"            np.savez_compressed(\\n\",\"                f,\\n\",\"                embeddings=np.asarray(\\n\",\"                    embeddings,\\n\",\"                    dtype=np.float32\\n\",\"                ).reshape(-1, EMBEDDING_DIMENSION),\\n\",\"\\n\",\"                filenames=np.asarray(\\n\",\"                    filenames,\\n\",\"                    dtype=\\\"U100\\\"\\n\",\"                ),\\n\",\"\\n\",\"                subjects=np.asarray(\\n\",\"                    subjects,\\n\",\"                    dtype=\\\"U20\\\"\\n\",\"                ),\\n\",\"\\n\",\"                subject_numbers=np.asarray(\\n\",\"                    subject_numbers,\\n\",\"                    dtype=np.int16\\n\",\"                ),\\n\",\"\\n\",\"                azimuths=np.asarray(\\n\",\"                    azimuths,\\n\",\"                    dtype=np.int16\\n\",\"                ),\\n\",\"\\n\",\"                elevations=np.asarray(\\n\",\"                    elevations,\\n\",\"                    dtype=np.int16\\n\",\"                ),\\n\",\"\\n\",\"                conditions=np.asarray(\\n\",\"                    conditions,\\n\",\"                    dtype=\\\"U30\\\"\\n\",\"                )\\n\",\"            )\\n\",\"\\n\",\"        os.replace(\\n\",\"            temporary_path,\\n\",\"            checkpoint_path\\n\",\"        )\\n\",\"\\n\",\"        metadata = {\\n\",\"            \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"            \\\"step\\\": \\\"2.6.19\\\",\\n\",\"            \\\"archive_sha256\\\": archive_hash,\\n\",\"            \\\"expected_images\\\": EXPECTED_IMAGES,\\n\",\"            \\\"embedding_dimension\\\": EMBEDDING_DIMENSION,\\n\",\"            \\\"processed_count\\\": len(processed_paths),\\n\",\"            \\\"successful_embeddings\\\": len(embeddings),\\n\",\"            \\\"failure_count\\\": len(failures),\\n\",\"            \\\"processed_paths\\\": sorted(processed_paths),\\n\",\"            \\\"failures\\\": failures,\\n\",\"            \\\"updated_utc\\\": datetime.now(\\n\",\"                timezone.utc\\n\",\"            ).isoformat()\\n\",\"        }\\n\",\"\\n\",\"        temporary_metadata_path = (\\n\",\"            checkpoint_metadata_path + \\\".tmp\\\"\\n\",\"        )\\n\",\"\\n\",\"        with open(\\n\",\"            temporary_metadata_path,\\n\",\"            \\\"w\\\",\\n\",\"            encoding=\\\"utf-8\\\"\\n\",\"        ) as f:\\n\",\"            json.dump(metadata, f, indent=2)\\n\",\"\\n\",\"        os.replace(\\n\",\"            temporary_metadata_path,\\n\",\"            checkpoint_metadata_path\\n\",\"        )\\n\",\"\\n\",\"    # --------------------------------------------------------\\n\",\"    # 8. FULL EMBEDDING GENERATION\\n\",\"    # --------------------------------------------------------\\n\",\"\\n\",\"    print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"    print(\\\"STEP 4 — EMBEDDING GENERATION\\\")\\n\",\"    print(\\\"=\\\" * 75)\\n\",\"\\n\",\"    start_time = time.time()\\n\",\"\\n\",\"    with torch.no_grad():\\n\",\"\\n\",\"        for index, path in enumerate(\\n\",\"            standard_paths,\\n\",\"            start=1\\n\",\"        ):\\n\",\"\\n\",\"            if path in processed_paths:\\n\",\"                continue\\n\",\"\\n\",\"            filename = os.path.basename(path)\\n\",\"\\n\",\"            match = standard_pattern.fullmatch(filename)\\n\",\"\\n\",\"            if match is None:\\n\",\"\\n\",\"                failures.append({\\n\",\"                    \\\"path\\\": path,\\n\",\"                    \\\"reason\\\": \\\"Filename parsing failed\\\"\\n\",\"                })\\n\",\"\\n\",\"                processed_paths.add(path)\\n\",\"                continue\\n\",\"\\n\",\"            subject_number = int(match.group(1))\\n\",\"            azimuth = int(match.group(2))\\n\",\"            elevation = int(match.group(3))\\n\",\"\\n\",\"            subject = f\\\"yaleB{subject_number:02d}\\\"\\n\",\"\\n\",\"            condition = (\\n\",\"                f\\\"A{azimuth:+04d}E{elevation:+03d}\\\"\\n\",\"            )\\n\",\"\\n\",\"            try:\\n\",\"\\n\",\"                image_bytes = archive.read(path)\\n\",\"\\n\",\"                with Image.open(\\n\",\"                    io.BytesIO(image_bytes)\\n\",\"                ) as source:\\n\",\"\\n\",\"                    source.load()\\n\",\"\\n\",\"                    if source.mode != \\\"L\\\":\\n\",\"                        raise ValueError(\\n\",\"                            f\\\"Unexpected source mode: {source.mode}\\\"\\n\",\"                        )\\n\",\"\\n\",\"                    rgb_image = source.convert(\\\"RGB\\\")\\n\",\"\\n\",\"                    if rgb_image.size != (168, 192):\\n\",\"                        raise ValueError(\\n\",\"                            f\\\"Unexpected image dimensions: {rgb_image.size}\\\"\\n\",\"                        )\\n\",\"\\n\",\"                    tensor = preprocessing(\\n\",\"                        rgb_image\\n\",\"                    ).unsqueeze(0).to(device)\\n\",\"\\n\",\"                if tuple(tensor.shape) != (\\n\",\"                    1, 3, 160, 160\\n\",\"                ):\\n\",\"                    raise ValueError(\\n\",\"                        f\\\"Unexpected input shape: {tuple(tensor.shape)}\\\"\\n\",\"                    )\\n\",\"\\n\",\"                if not torch.isfinite(tensor).all():\\n\",\"                    raise ValueError(\\n\",\"                        \\\"Input tensor contains non-finite values.\\\"\\n\",\"                    )\\n\",\"\\n\",\"                embedding_tensor = facenet(tensor)\\n\",\"\\n\",\"                embedding = (\\n\",\"                    embedding_tensor\\n\",\"                    .cpu()\\n\",\"                    .numpy()\\n\",\"                    .reshape(-1)\\n\",\"                    .astype(np.float32)\\n\",\"                )\\n\",\"\\n\",\"                if embedding.shape != (\\n\",\"                    EMBEDDING_DIMENSION,\\n\",\"                ):\\n\",\"                    raise ValueError(\\n\",\"                        f\\\"Unexpected embedding shape: {embedding.shape}\\\"\\n\",\"                    )\\n\",\"\\n\",\"                if not np.isfinite(embedding).all():\\n\",\"                    raise ValueError(\\n\",\"                        \\\"Embedding contains non-finite values.\\\"\\n\",\"                    )\\n\",\"\\n\",\"                embedding_norm = float(\\n\",\"                    np.linalg.norm(embedding)\\n\",\"                )\\n\",\"\\n\",\"                if not np.isclose(\\n\",\"                    embedding_norm,\\n\",\"                    1.0,\\n\",\"                    atol=1e-4\\n\",\"                ):\\n\",\"                    raise ValueError(\\n\",\"                        f\\\"Unexpected embedding L2 norm: {embedding_norm}\\\"\\n\",\"                    )\\n\",\"\\n\",\"                embeddings.append(embedding)\\n\",\"                filenames.append(filename)\\n\",\"                subjects.append(subject)\\n\",\"                subject_numbers.append(subject_number)\\n\",\"                azimuths.append(azimuth)\\n\",\"                elevations.append(elevation)\\n\",\"                conditions.append(condition)\\n\",\"\\n\",\"            except Exception as exc:\\n\",\"\\n\",\"                failures.append({\\n\",\"                    \\\"path\\\": path,\\n\",\"                    \\\"filename\\\": filename,\\n\",\"                    \\\"subject\\\": subject,\\n\",\"                    \\\"condition\\\": condition,\\n\",\"                    \\\"reason\\\": str(exc)\\n\",\"                })\\n\",\"\\n\",\"            processed_paths.add(path)\\n\",\"\\n\",\"            # Save progress every 100 processed images.\\n\",\"            if (\\n\",\"                len(processed_paths) % CHECKPOINT_INTERVAL == 0\\n\",\"                or len(processed_paths) == EXPECTED_IMAGES\\n\",\"            ):\\n\",\"\\n\",\"                save_checkpoint()\\n\",\"\\n\",\"                elapsed = time.time() - start_time\\n\",\"\\n\",\"                print(\\n\",\"                    f\\\"Processed: {len(processed_paths)}/\\\"\\n\",\"                    f\\\"{EXPECTED_IMAGES} | \\\"\\n\",\"                    f\\\"Successful: {len(embeddings)} | \\\"\\n\",\"                    f\\\"Failures: {len(failures)} | \\\"\\n\",\"                    f\\\"Elapsed: {elapsed:.1f}s\\\"\\n\",\"                )\\n\",\"\\n\",\"    # --------------------------------------------------------\\n\",\"    # 9. FINAL CHECKPOINT\\n\",\"    # --------------------------------------------------------\\n\",\"\\n\",\"    save_checkpoint()\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 10. FINAL ARRAY VALIDATION\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 5 — FINAL EMBEDDING VALIDATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"embedding_array = np.asarray(\\n\",\"    embeddings,\\n\",\"    dtype=np.float32\\n\",\").reshape(-1, EMBEDDING_DIMENSION)\\n\",\"\\n\",\"filename_array = np.asarray(\\n\",\"    filenames,\\n\",\"    dtype=\\\"U100\\\"\\n\",\")\\n\",\"\\n\",\"subject_array = np.asarray(\\n\",\"    subjects,\\n\",\"    dtype=\\\"U20\\\"\\n\",\")\\n\",\"\\n\",\"subject_number_array = np.asarray(\\n\",\"    subject_numbers,\\n\",\"    dtype=np.int16\\n\",\")\\n\",\"\\n\",\"azimuth_array = np.asarray(\\n\",\"    azimuths,\\n\",\"    dtype=np.int16\\n\",\")\\n\",\"\\n\",\"elevation_array = np.asarray(\\n\",\"    elevations,\\n\",\"    dtype=np.int16\\n\",\")\\n\",\"\\n\",\"condition_array = np.asarray(\\n\",\"    conditions,\\n\",\"    dtype=\\\"U30\\\"\\n\",\")\\n\",\"\\n\",\"assert len(processed_paths) == EXPECTED_IMAGES\\n\",\"\\n\",\"assert embedding_array.shape == (\\n\",\"    len(filenames),\\n\",\"    EMBEDDING_DIMENSION\\n\",\")\\n\",\"\\n\",\"assert len(filenames) == len(subjects)\\n\",\"assert len(filenames) == len(subject_numbers)\\n\",\"assert len(filenames) == len(azimuths)\\n\",\"assert len(filenames) == len(elevations)\\n\",\"assert len(filenames) == len(conditions)\\n\",\"\\n\",\"assert len(set(filenames)) == len(filenames)\\n\",\"\\n\",\"assert np.isfinite(embedding_array).all()\\n\",\"\\n\",\"embedding_norms = np.linalg.norm(\\n\",\"    embedding_array,\\n\",\"    axis=1\\n\",\")\\n\",\"\\n\",\"norm_validation = np.allclose(\\n\",\"    embedding_norms,\\n\",\"    1.0,\\n\",\"    atol=1e-4\\n\",\")\\n\",\"\\n\",\"assert norm_validation\\n\",\"\\n\",\"print(\\\"Processed images:\\\", len(processed_paths))\\n\",\"print(\\\"Successful embeddings:\\\", len(embedding_array))\\n\",\"print(\\\"Extraction failures:\\\", len(failures))\\n\",\"print(\\\"Embedding array shape:\\\", embedding_array.shape)\\n\",\"print(\\\"Embedding dtype:\\\", embedding_array.dtype)\\n\",\"print(\\\"All embeddings finite:\\\", np.isfinite(embedding_array).all())\\n\",\"print(\\\"All embedding norms approximately 1:\\\", norm_validation)\\n\",\"\\n\",\"print(\\n\",\"    \\\"Mean embedding norm:\\\",\\n\",\"    float(embedding_norms.mean())\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"Minimum embedding norm:\\\",\\n\",\"    float(embedding_norms.min())\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"Maximum embedding norm:\\\",\\n\",\"    float(embedding_norms.max())\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 11. SAVE FINAL EMBEDDING ARCHIVE\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 6 — FINAL EMBEDDING ARCHIVE\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"temporary_archive_path = final_archive_path + \\\".tmp\\\"\\n\",\"\\n\",\"with open(temporary_archive_path, \\\"wb\\\") as f:\\n\",\"\\n\",\"    np.savez_compressed(\\n\",\"        f,\\n\",\"        embeddings=embedding_array,\\n\",\"        filenames=filename_array,\\n\",\"        subjects=subject_array,\\n\",\"        subject_numbers=subject_number_array,\\n\",\"        azimuths=azimuth_array,\\n\",\"        elevations=elevation_array,\\n\",\"        conditions=condition_array\\n\",\"    )\\n\",\"\\n\",\"os.replace(\\n\",\"    temporary_archive_path,\\n\",\"    final_archive_path\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 12. SAVE METADATA AND CONFIGURATION\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"subject_counts = {\\n\",\"    subject: int(np.sum(subject_array == subject))\\n\",\"    for subject in sorted(set(subject_array.tolist()))\\n\",\"}\\n\",\"\\n\",\"condition_counts = {\\n\",\"    condition: int(np.sum(condition_array == condition))\\n\",\"    for condition in sorted(set(condition_array.tolist()))\\n\",\"}\\n\",\"\\n\",\"configuration = {\\n\",\"    \\\"model_architecture\\\": \\\"InceptionResnetV1\\\",\\n\",\"    \\\"pretrained_weights\\\": \\\"VGGFace2\\\",\\n\",\"    \\\"embedding_dimension\\\": EMBEDDING_DIMENSION,\\n\",\"    \\\"device\\\": \\\"cpu\\\",\\n\",\"    \\\"model_mode\\\": \\\"eval\\\",\\n\",\"    \\\"gradient_calculation\\\": \\\"disabled\\\",\\n\",\"    \\\"source_image_mode\\\": \\\"L\\\",\\n\",\"    \\\"conversion\\\": \\\"PIL.Image.convert('RGB')\\\",\\n\",\"    \\\"resize\\\": [160, 160],\\n\",\"    \\\"tensor_conversion\\\": \\\"torchvision.transforms.ToTensor\\\",\\n\",\"    \\\"input_range\\\": [0.0, 1.0],\\n\",\"    \\\"face_detection\\\": False,\\n\",\"    \\\"face_alignment\\\": False,\\n\",\"    \\\"ambient_images_included\\\": False,\\n\",\"    \\\"expected_standard_images\\\": EXPECTED_IMAGES\\n\",\"}\\n\",\"\\n\",\"configuration_json = json.dumps(\\n\",\"    configuration,\\n\",\"    sort_keys=True\\n\",\")\\n\",\"\\n\",\"configuration_hash = hashlib.sha256(\\n\",\"    configuration_json.encode(\\\"utf-8\\\")\\n\",\").hexdigest()\\n\",\"\\n\",\"with open(\\n\",\"    final_config_path,\\n\",\"    \\\"w\\\",\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\") as f:\\n\",\"    json.dump(configuration, f, indent=2)\\n\",\"\\n\",\"metadata = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"step\\\": \\\"2.6.19\\\",\\n\",\"    \\\"dataset\\\": \\\"Cropped Extended Yale B\\\",\\n\",\"    \\\"archive_sha256\\\": archive_hash,\\n\",\"    \\\"embedding_archive\\\": final_archive_path,\\n\",\"    \\\"generation_timestamp_utc\\\": datetime.now(\\n\",\"        timezone.utc\\n\",\"    ).isoformat(),\\n\",\"\\n\",\"    \\\"software\\\": {\\n\",\"        \\\"python\\\": platform.python_version(),\\n\",\"        \\\"pytorch\\\": torch.__version__,\\n\",\"        \\\"torchvision\\\": version(\\\"torchvision\\\"),\\n\",\"        \\\"facenet_pytorch\\\": version(\\\"facenet-pytorch\\\")\\n\",\"    },\\n\",\"\\n\",\"    \\\"configuration\\\": configuration,\\n\",\"    \\\"configuration_sha256\\\": configuration_hash,\\n\",\"\\n\",\"    \\\"counts\\\": {\\n\",\"        \\\"expected_standard_images\\\": EXPECTED_IMAGES,\\n\",\"        \\\"processed_images\\\": len(processed_paths),\\n\",\"        \\\"successful_embeddings\\\": len(embedding_array),\\n\",\"        \\\"extraction_failures\\\": len(failures),\\n\",\"        \\\"unique_subjects\\\": len(subject_counts),\\n\",\"        \\\"unique_illumination_conditions\\\": len(condition_counts)\\n\",\"    },\\n\",\"\\n\",\"    \\\"subject_counts\\\": subject_counts,\\n\",\"    \\\"condition_counts\\\": condition_counts,\\n\",\"\\n\",\"    \\\"embedding_validation\\\": {\\n\",\"        \\\"shape\\\": list(embedding_array.shape),\\n\",\"        \\\"dtype\\\": str(embedding_array.dtype),\\n\",\"        \\\"all_finite\\\": bool(np.isfinite(embedding_array).all()),\\n\",\"        \\\"all_l2_normalized\\\": bool(norm_validation),\\n\",\"        \\\"mean_l2_norm\\\": float(embedding_norms.mean()),\\n\",\"        \\\"minimum_l2_norm\\\": float(embedding_norms.min()),\\n\",\"        \\\"maximum_l2_norm\\\": float(embedding_norms.max())\\n\",\"    },\\n\",\"\\n\",\"    \\\"failures\\\": failures,\\n\",\"\\n\",\"    \\\"methodological_limitations\\\": [\\n\",\"        \\\"Direct resizing is not equivalent to MTCNN detection and alignment.\\\",\\n\",\"        \\\"Grayscale images are replicated into three RGB channels.\\\",\\n\",\"        \\\"The model was pretrained on VGGFace2, not CroppedYale.\\\",\\n\",\"        \\\"Embedding generation does not establish biometric recognition accuracy.\\\",\\n\",\"        \\\"This dataset contains repeated identity and illumination captures, not exact source-image pairs.\\\"\\n\",\"    ]\\n\",\"}\\n\",\"\\n\",\"with open(\\n\",\"    final_metadata_path,\\n\",\"    \\\"w\\\",\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\") as f:\\n\",\"    json.dump(metadata, f, indent=2)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 13. FINAL FILE HASHES\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"def calculate_sha256(path):\\n\",\"\\n\",\"    digest = hashlib.sha256()\\n\",\"\\n\",\"    with open(path, \\\"rb\\\") as f:\\n\",\"        for chunk in iter(\\n\",\"            lambda: f.read(1024 * 1024),\\n\",\"            b\\\"\\\"\\n\",\"        ):\\n\",\"            digest.update(chunk)\\n\",\"\\n\",\"    return digest.hexdigest()\\n\",\"\\n\",\"embedding_archive_hash = calculate_sha256(\\n\",\"    final_archive_path\\n\",\")\\n\",\"\\n\",\"metadata_hash = calculate_sha256(\\n\",\"    final_metadata_path\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 7 — FINAL OUTPUT\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"print(\\\"Embedding archive:\\\", final_archive_path)\\n\",\"print(\\\"Metadata:\\\", final_metadata_path)\\n\",\"print(\\\"Configuration:\\\", final_config_path)\\n\",\"\\n\",\"print(\\\"Embedding archive SHA256:\\\", embedding_archive_hash)\\n\",\"print(\\\"Metadata SHA256:\\\", metadata_hash)\\n\",\"\\n\",\"print(\\\"\\\\nSubject count:\\\", len(subject_counts))\\n\",\"print(\\\"Condition count:\\\", len(condition_counts))\\n\",\"\\n\",\"print(\\\"\\\\nSuccessful embeddings:\\\", len(embedding_array))\\n\",\"print(\\\"Extraction failures:\\\", len(failures))\\n\",\"\\n\",\"print(\\\"\\\\nCheckpoint retained:\\\", checkpoint_path)\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"STEP 2.6.19 GENERATION FINISHED\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"rj7hT97-v0ZC\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794352852969,\"user_tz\":360,\"elapsed\":286978,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"343c36a5-d53f-4ec8-b7ad-0363341dbde7\"},\"execution_count\":null,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"===========================================================================\\n\",\"STEP 1 — ENVIRONMENT VALIDATION\\n\",\"===========================================================================\\n\",\"Python: 3.13.18\\n\",\"PyTorch: 2.14.1+cpu\\n\",\"Torchvision: 0.29.1+cpu\\n\",\"facenet-pytorch: 2.6.0\\n\",\"Execution device: cpu\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 2 — DATASET VALIDATION\\n\",\"===========================================================================\\n\",\"Archive integrity: PASSED\\n\",\"Standard images: 2414\\n\",\"Archive SHA256: 8bbabf3836d077d60626c9ee3c54c2d2851a8d2c15c8b7e13b9bc162e86ea573\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 3 — FACENET MODEL INITIALISATION\\n\",\"===========================================================================\\n\",\"Model: InceptionResnetV1\\n\",\"Pretrained weights: VGGFace2\\n\",\"Embedding dimension: 512\\n\",\"Model mode: Evaluation\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 4 — EMBEDDING GENERATION\\n\",\"===========================================================================\\n\",\"Processed: 100/2414 | Successful: 100 | Failures: 0 | Elapsed: 14.2s\\n\",\"Processed: 200/2414 | Successful: 200 | Failures: 0 | Elapsed: 26.5s\\n\",\"Processed: 300/2414 | Successful: 300 | Failures: 0 | Elapsed: 37.3s\\n\",\"Processed: 400/2414 | Successful: 400 | Failures: 0 | Elapsed: 49.5s\\n\",\"Processed: 500/2414 | Successful: 500 | Failures: 0 | Elapsed: 61.3s\\n\",\"Processed: 600/2414 | Successful: 600 | Failures: 0 | Elapsed: 74.0s\\n\",\"Processed: 700/2414 | Successful: 700 | Failures: 0 | Elapsed: 84.1s\\n\",\"Processed: 800/2414 | Successful: 800 | Failures: 0 | Elapsed: 96.5s\\n\",\"Processed: 900/2414 | Successful: 900 | Failures: 0 | Elapsed: 108.3s\\n\",\"Processed: 1000/2414 | Successful: 1000 | Failures: 0 | Elapsed: 120.7s\\n\",\"Processed: 1100/2414 | Successful: 1100 | Failures: 0 | Elapsed: 131.0s\\n\",\"Processed: 1200/2414 | Successful: 1200 | Failures: 0 | Elapsed: 143.1s\\n\",\"Processed: 1300/2414 | Successful: 1300 | Failures: 0 | Elapsed: 155.0s\\n\",\"Processed: 1400/2414 | Successful: 1400 | Failures: 0 | Elapsed: 166.3s\\n\",\"Processed: 1500/2414 | Successful: 1500 | Failures: 0 | Elapsed: 177.1s\\n\",\"Processed: 1600/2414 | Successful: 1600 | Failures: 0 | Elapsed: 189.3s\\n\",\"Processed: 1700/2414 | Successful: 1700 | Failures: 0 | Elapsed: 201.1s\\n\",\"Processed: 1800/2414 | Successful: 1800 | Failures: 0 | Elapsed: 212.3s\\n\",\"Processed: 1900/2414 | Successful: 1900 | Failures: 0 | Elapsed: 223.6s\\n\",\"Processed: 2000/2414 | Successful: 2000 | Failures: 0 | Elapsed: 235.7s\\n\",\"Processed: 2100/2414 | Successful: 2100 | Failures: 0 | Elapsed: 247.9s\\n\",\"Processed: 2200/2414 | Successful: 2200 | Failures: 0 | Elapsed: 258.4s\\n\",\"Processed: 2300/2414 | Successful: 2300 | Failures: 0 | Elapsed: 270.4s\\n\",\"Processed: 2400/2414 | Successful: 2400 | Failures: 0 | Elapsed: 282.7s\\n\",\"Processed: 2414/2414 | Successful: 2414 | Failures: 0 | Elapsed: 284.5s\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 5 — FINAL EMBEDDING VALIDATION\\n\",\"===========================================================================\\n\",\"Processed images: 2414\\n\",\"Successful embeddings: 2414\\n\",\"Extraction failures: 0\\n\",\"Embedding array shape: (2414, 512)\\n\",\"Embedding dtype: float32\\n\",\"All embeddings finite: True\\n\",\"All embedding norms approximately 1: True\\n\",\"Mean embedding norm: 1.0\\n\",\"Minimum embedding norm: 0.9999998807907104\\n\",\"Maximum embedding norm: 1.0000001192092896\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 6 — FINAL EMBEDDING ARCHIVE\\n\",\"===========================================================================\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 7 — FINAL OUTPUT\\n\",\"===========================================================================\\n\",\"Embedding archive: /content/drive/MyDrive/Experiment_20_Results/embeddings/experiment20_croppedyale_facenet_embeddings.npz\\n\",\"Metadata: /content/drive/MyDrive/Experiment_20_Results/embeddings/experiment20_croppedyale_embedding_metadata.json\\n\",\"Configuration: /content/drive/MyDrive/Experiment_20_Results/embeddings/experiment20_embedding_generation_config.json\\n\",\"Embedding archive SHA256: 127ffb6e71b871ebab9ed10fd8ce5f2b78b9f3971db4075cf14b44f7df2d3c4c\\n\",\"Metadata SHA256: 5efe5026210728e333ac5cd1fb0bcba093504e5214c0f72fbef931101a5d0888\\n\",\"\\n\",\"Subject count: 38\\n\",\"Condition count: 64\\n\",\"\\n\",\"Successful embeddings: 2414\\n\",\"Extraction failures: 0\\n\",\"\\n\",\"Checkpoint retained: /content/drive/MyDrive/Experiment_20_Results/embeddings/checkpoints/experiment20_embedding_checkpoint.npz\\n\",\"===========================================================================\\n\",\"STEP 2.6.19 GENERATION FINISHED\\n\",\"===========================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"\\n\",\"## Step 2.6.20 — Embedding Quality and Completeness Audit\\n\",\"\\n\",\"### Objective\\n\",\"Independently audit the saved CroppedYale FaceNet embedding archive.\\n\",\"\\n\",\"### Validation procedures\\n\",\"1. Verify the embedding archive SHA256.\\n\",\"2. Verify the metadata file SHA256.\\n\",\"3. Load the saved embedding archive.\\n\",\"4. Validate embedding dimensions, dtype and numerical finiteness.\\n\",\"5. Validate L2 norms.\\n\",\"6. Verify unique filenames and one-to-one image correspondence.\\n\",\"7. Compare saved filenames against all 2,414 source archive filenames.\\n\",\"8. Reconstruct subject and illumination-condition coverage.\\n\",\"9. Identify exact duplicate embedding vectors.\\n\",\"10. Reconstruct the 57 common illumination conditions and 2,166 common-condition observations.\\n\",\"\\n\",\"### Expected structure\\n\",\"- 2,414 embeddings.\\n\",\"- 512 dimensions per embedding.\\n\",\"- 38 identities.\\n\",\"- 64 illumination conditions.\\n\",\"- 57 conditions shared by all identities.\\n\",\"- 2,166 common-condition observations.\\n\",\"\\n\",\"### Important\\n\",\"This audit verifies archive completeness, numerical quality and data correspondence. It does not establish biometric recognition accuracy or robustness to illumination changes.\\n\"],\"metadata\":{\"id\":\"nXfjm9urxIHf\"}},{\"cell_type\":\"code\",\"source\":[\"\\n\",\"import os\\n\",\"import re\\n\",\"import json\\n\",\"import hashlib\\n\",\"import zipfile\\n\",\"import numpy as np\\n\",\"\\n\",\"from collections import Counter, defaultdict\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"# ============================================================\\n\",\"# STEP 2.6.20 — EMBEDDING QUALITY AND COMPLETENESS AUDIT\\n\",\"# ============================================================\\n\",\"\\n\",\"base_dir = (\\n\",\"    \\\"/content/drive/MyDrive/Experiment_20_Results\\\"\\n\",\")\\n\",\"\\n\",\"archive_path = (\\n\",\"    \\\"/content/Experiment20_Downloads/CroppedYale.zip\\\"\\n\",\")\\n\",\"\\n\",\"embedding_path = os.path.join(\\n\",\"    base_dir,\\n\",\"    \\\"embeddings\\\",\\n\",\"    \\\"experiment20_croppedyale_facenet_embeddings.npz\\\"\\n\",\")\\n\",\"\\n\",\"metadata_path = os.path.join(\\n\",\"    base_dir,\\n\",\"    \\\"embeddings\\\",\\n\",\"    \\\"experiment20_croppedyale_embedding_metadata.json\\\"\\n\",\")\\n\",\"\\n\",\"audit_dir = os.path.join(\\n\",\"    base_dir,\\n\",\"    \\\"dataset_audit\\\"\\n\",\")\\n\",\"\\n\",\"os.makedirs(audit_dir, exist_ok=True)\\n\",\"\\n\",\"report_path = os.path.join(\\n\",\"    audit_dir,\\n\",\"    \\\"experiment20_embedding_quality_completeness_audit.json\\\"\\n\",\")\\n\",\"\\n\",\"EXPECTED_EMBEDDING_SHA256 = (\\n\",\"    \\\"127ffb6e71b871ebab9ed10fd8ce5f2b78b9f3971db4075cf14b44f7df2d3c4c\\\"\\n\",\")\\n\",\"\\n\",\"EXPECTED_METADATA_SHA256 = (\\n\",\"    \\\"5efe5026210728e333ac5cd1fb0bcba093504e5214c0f72fbef931101a5d0888\\\"\\n\",\")\\n\",\"\\n\",\"EXPECTED_ARCHIVE_SHA256 = (\\n\",\"    \\\"8bbabf3836d077d60626c9ee3c54c2d2851a8d2c15c8b7e13b9bc162e86ea573\\\"\\n\",\")\\n\",\"\\n\",\"EXPECTED_IMAGES = 2414\\n\",\"EXPECTED_DIMENSION = 512\\n\",\"\\n\",\"standard_pattern = re.compile(\\n\",\"    r\\\"yaleB(\\\\d+)_P00A([+-]\\\\d+)E([+-]\\\\d+)\\\\.pgm$\\\"\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. FILE VALIDATION AND HASHES\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"STEP 1 — FILE AND HASH VALIDATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"for path in [\\n\",\"    archive_path,\\n\",\"    embedding_path,\\n\",\"    metadata_path\\n\",\"]:\\n\",\"    assert os.path.exists(path), (\\n\",\"        f\\\"Required file missing: {path}\\\"\\n\",\"    )\\n\",\"\\n\",\"def calculate_sha256(path):\\n\",\"\\n\",\"    digest = hashlib.sha256()\\n\",\"\\n\",\"    with open(path, \\\"rb\\\") as f:\\n\",\"        for chunk in iter(\\n\",\"            lambda: f.read(1024 * 1024),\\n\",\"            b\\\"\\\"\\n\",\"        ):\\n\",\"            digest.update(chunk)\\n\",\"\\n\",\"    return digest.hexdigest()\\n\",\"\\n\",\"embedding_sha256 = calculate_sha256(\\n\",\"    embedding_path\\n\",\")\\n\",\"\\n\",\"metadata_sha256 = calculate_sha256(\\n\",\"    metadata_path\\n\",\")\\n\",\"\\n\",\"source_archive_sha256 = calculate_sha256(\\n\",\"    archive_path\\n\",\")\\n\",\"\\n\",\"print(\\\"Embedding archive SHA256:\\\", embedding_sha256)\\n\",\"print(\\\"Metadata SHA256:\\\", metadata_sha256)\\n\",\"print(\\\"Source archive SHA256:\\\", source_archive_sha256)\\n\",\"\\n\",\"embedding_hash_match = (\\n\",\"    embedding_sha256 == EXPECTED_EMBEDDING_SHA256\\n\",\")\\n\",\"\\n\",\"metadata_hash_match = (\\n\",\"    metadata_sha256 == EXPECTED_METADATA_SHA256\\n\",\")\\n\",\"\\n\",\"source_hash_match = (\\n\",\"    source_archive_sha256 == EXPECTED_ARCHIVE_SHA256\\n\",\")\\n\",\"\\n\",\"print(\\\"Embedding hash matches generation record:\\\", embedding_hash_match)\\n\",\"print(\\\"Metadata hash matches generation record:\\\", metadata_hash_match)\\n\",\"print(\\\"Source archive hash matches acquisition record:\\\", source_hash_match)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. LOAD SAVED METADATA AND EMBEDDINGS\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 2 — SAVED EMBEDDING ARCHIVE VALIDATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"with open(metadata_path, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    metadata = json.load(f)\\n\",\"\\n\",\"with np.load(\\n\",\"    embedding_path,\\n\",\"    allow_pickle=False\\n\",\") as data:\\n\",\"\\n\",\"    required_keys = {\\n\",\"        \\\"embeddings\\\",\\n\",\"        \\\"filenames\\\",\\n\",\"        \\\"subjects\\\",\\n\",\"        \\\"subject_numbers\\\",\\n\",\"        \\\"azimuths\\\",\\n\",\"        \\\"elevations\\\",\\n\",\"        \\\"conditions\\\"\\n\",\"    }\\n\",\"\\n\",\"    actual_keys = set(data.files)\\n\",\"\\n\",\"    assert required_keys.issubset(actual_keys), (\\n\",\"        f\\\"Missing archive keys: {required_keys - actual_keys}\\\"\\n\",\"    )\\n\",\"\\n\",\"    embeddings = data[\\\"embeddings\\\"].copy()\\n\",\"    filenames = data[\\\"filenames\\\"].copy()\\n\",\"    subjects = data[\\\"subjects\\\"].copy()\\n\",\"    subject_numbers = data[\\\"subject_numbers\\\"].copy()\\n\",\"    azimuths = data[\\\"azimuths\\\"].copy()\\n\",\"    elevations = data[\\\"elevations\\\"].copy()\\n\",\"    conditions = data[\\\"conditions\\\"].copy()\\n\",\"\\n\",\"print(\\\"Embedding shape:\\\", embeddings.shape)\\n\",\"print(\\\"Embedding dtype:\\\", embeddings.dtype)\\n\",\"print(\\\"Filename count:\\\", len(filenames))\\n\",\"print(\\\"Subject count:\\\", len(subjects))\\n\",\"print(\\\"Condition count:\\\", len(conditions))\\n\",\"\\n\",\"assert embeddings.shape == (\\n\",\"    EXPECTED_IMAGES,\\n\",\"    EXPECTED_DIMENSION\\n\",\")\\n\",\"\\n\",\"assert embeddings.dtype == np.float32\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. NUMERICAL QUALITY\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 3 — NUMERICAL QUALITY\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"all_finite = bool(\\n\",\"    np.isfinite(embeddings).all()\\n\",\")\\n\",\"\\n\",\"embedding_norms = np.linalg.norm(\\n\",\"    embeddings,\\n\",\"    axis=1\\n\",\")\\n\",\"\\n\",\"all_norms_valid = bool(\\n\",\"    np.allclose(\\n\",\"        embedding_norms,\\n\",\"        1.0,\\n\",\"        atol=1e-4\\n\",\"    )\\n\",\")\\n\",\"\\n\",\"norm_statistics = {\\n\",\"    \\\"mean\\\": float(embedding_norms.mean()),\\n\",\"    \\\"minimum\\\": float(embedding_norms.min()),\\n\",\"    \\\"maximum\\\": float(embedding_norms.max()),\\n\",\"    \\\"standard_deviation\\\": float(embedding_norms.std())\\n\",\"}\\n\",\"\\n\",\"print(\\\"All embeddings finite:\\\", all_finite)\\n\",\"print(\\\"All L2 norms approximately 1:\\\", all_norms_valid)\\n\",\"print(\\\"Mean norm:\\\", norm_statistics[\\\"mean\\\"])\\n\",\"print(\\\"Minimum norm:\\\", norm_statistics[\\\"minimum\\\"])\\n\",\"print(\\\"Maximum norm:\\\", norm_statistics[\\\"maximum\\\"])\\n\",\"print(\\\"Norm standard deviation:\\\", norm_statistics[\\\"standard_deviation\\\"])\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. ROW MAPPING AND METADATA CONSISTENCY\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 4 — ROW MAPPING VALIDATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"mapping_lengths_valid = all([\\n\",\"    len(filenames) == len(embeddings),\\n\",\"    len(subjects) == len(embeddings),\\n\",\"    len(subject_numbers) == len(embeddings),\\n\",\"    len(azimuths) == len(embeddings),\\n\",\"    len(elevations) == len(embeddings),\\n\",\"    len(conditions) == len(embeddings)\\n\",\"])\\n\",\"\\n\",\"unique_filenames = len(set(filenames.tolist()))\\n\",\"\\n\",\"unique_filename_mapping = (\\n\",\"    unique_filenames == EXPECTED_IMAGES\\n\",\")\\n\",\"\\n\",\"mapping_errors = []\\n\",\"\\n\",\"for i, filename in enumerate(filenames):\\n\",\"\\n\",\"    match = standard_pattern.fullmatch(\\n\",\"        str(filename)\\n\",\"    )\\n\",\"\\n\",\"    if match is None:\\n\",\"        mapping_errors.append({\\n\",\"            \\\"row\\\": int(i),\\n\",\"            \\\"filename\\\": str(filename),\\n\",\"            \\\"reason\\\": \\\"Filename pattern invalid\\\"\\n\",\"        })\\n\",\"        continue\\n\",\"\\n\",\"    expected_subject_number = int(match.group(1))\\n\",\"    expected_azimuth = int(match.group(2))\\n\",\"    expected_elevation = int(match.group(3))\\n\",\"\\n\",\"    expected_subject = (\\n\",\"        f\\\"yaleB{expected_subject_number:02d}\\\"\\n\",\"    )\\n\",\"\\n\",\"    expected_condition = (\\n\",\"        f\\\"A{expected_azimuth:+04d}E{expected_elevation:+03d}\\\"\\n\",\"    )\\n\",\"\\n\",\"    if str(subjects[i]) != expected_subject:\\n\",\"        mapping_errors.append({\\n\",\"            \\\"row\\\": int(i),\\n\",\"            \\\"filename\\\": str(filename),\\n\",\"            \\\"reason\\\": \\\"Subject mismatch\\\"\\n\",\"        })\\n\",\"\\n\",\"    if int(subject_numbers[i]) != expected_subject_number:\\n\",\"        mapping_errors.append({\\n\",\"            \\\"row\\\": int(i),\\n\",\"            \\\"filename\\\": str(filename),\\n\",\"            \\\"reason\\\": \\\"Subject number mismatch\\\"\\n\",\"        })\\n\",\"\\n\",\"    if int(azimuths[i]) != expected_azimuth:\\n\",\"        mapping_errors.append({\\n\",\"            \\\"row\\\": int(i),\\n\",\"            \\\"filename\\\": str(filename),\\n\",\"            \\\"reason\\\": \\\"Azimuth mismatch\\\"\\n\",\"        })\\n\",\"\\n\",\"    if int(elevations[i]) != expected_elevation:\\n\",\"        mapping_errors.append({\\n\",\"            \\\"row\\\": int(i),\\n\",\"            \\\"filename\\\": str(filename),\\n\",\"            \\\"reason\\\": \\\"Elevation mismatch\\\"\\n\",\"        })\\n\",\"\\n\",\"    if str(conditions[i]) != expected_condition:\\n\",\"        mapping_errors.append({\\n\",\"            \\\"row\\\": int(i),\\n\",\"            \\\"filename\\\": str(filename),\\n\",\"            \\\"reason\\\": \\\"Condition mismatch\\\"\\n\",\"        })\\n\",\"\\n\",\"print(\\\"All metadata arrays have matching lengths:\\\", mapping_lengths_valid)\\n\",\"print(\\\"Unique filenames:\\\", unique_filenames)\\n\",\"print(\\\"Filename-to-metadata mapping errors:\\\", len(mapping_errors))\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. SOURCE IMAGE CORRESPONDENCE\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 5 — SOURCE IMAGE CORRESPONDENCE\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"with zipfile.ZipFile(archive_path, \\\"r\\\") as source_archive:\\n\",\"\\n\",\"    assert source_archive.testzip() is None\\n\",\"\\n\",\"    expected_source_filenames = []\\n\",\"\\n\",\"    for path in source_archive.namelist():\\n\",\"\\n\",\"        if not path.lower().endswith(\\\".pgm\\\"):\\n\",\"            continue\\n\",\"\\n\",\"        filename = os.path.basename(path)\\n\",\"\\n\",\"        if standard_pattern.fullmatch(filename):\\n\",\"            expected_source_filenames.append(filename)\\n\",\"\\n\",\"expected_source_filenames = sorted(\\n\",\"    expected_source_filenames\\n\",\")\\n\",\"\\n\",\"saved_filenames = sorted(\\n\",\"    filenames.tolist()\\n\",\")\\n\",\"\\n\",\"missing_embeddings = sorted(\\n\",\"    set(expected_source_filenames) - set(saved_filenames)\\n\",\")\\n\",\"\\n\",\"unexpected_embeddings = sorted(\\n\",\"    set(saved_filenames) - set(expected_source_filenames)\\n\",\")\\n\",\"\\n\",\"source_correspondence_valid = (\\n\",\"    len(missing_embeddings) == 0\\n\",\"    and len(unexpected_embeddings) == 0\\n\",\"    and len(expected_source_filenames) == EXPECTED_IMAGES\\n\",\")\\n\",\"\\n\",\"print(\\\"Expected source images:\\\", len(expected_source_filenames))\\n\",\"print(\\\"Saved embedding rows:\\\", len(saved_filenames))\\n\",\"print(\\\"Missing embeddings:\\\", len(missing_embeddings))\\n\",\"print(\\\"Unexpected embedding filenames:\\\", len(unexpected_embeddings))\\n\",\"print(\\\"One-to-one filename correspondence:\\\", source_correspondence_valid)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. SUBJECT AND CONDITION COVERAGE\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 6 — SUBJECT AND CONDITION COVERAGE\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"subject_counts = Counter(\\n\",\"    subjects.tolist()\\n\",\")\\n\",\"\\n\",\"condition_subjects = defaultdict(set)\\n\",\"condition_counts = Counter(\\n\",\"    conditions.tolist()\\n\",\")\\n\",\"\\n\",\"for subject, condition in zip(\\n\",\"    subjects.tolist(),\\n\",\"    conditions.tolist()\\n\",\"):\\n\",\"    condition_subjects[condition].add(subject)\\n\",\"\\n\",\"all_subjects = sorted(\\n\",\"    subject_counts.keys()\\n\",\")\\n\",\"\\n\",\"all_conditions = sorted(\\n\",\"    condition_counts.keys()\\n\",\")\\n\",\"\\n\",\"common_conditions = sorted([\\n\",\"    condition\\n\",\"    for condition, identity_set in condition_subjects.items()\\n\",\"    if len(identity_set) == len(all_subjects)\\n\",\"])\\n\",\"\\n\",\"common_condition_observations = sum(\\n\",\"    1\\n\",\"    for condition in conditions.tolist()\\n\",\"    if condition in set(common_conditions)\\n\",\")\\n\",\"\\n\",\"print(\\\"Unique subjects:\\\", len(all_subjects))\\n\",\"print(\\\"Unique conditions:\\\", len(all_conditions))\\n\",\"print(\\\"Conditions shared by all subjects:\\\", len(common_conditions))\\n\",\"print(\\\"Common-condition observations:\\\", common_condition_observations)\\n\",\"\\n\",\"print(\\\"\\\\nPer-subject observation counts:\\\")\\n\",\"\\n\",\"for subject in all_subjects:\\n\",\"    print(subject, subject_counts[subject])\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. DUPLICATE EMBEDDING CHECK\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 7 — DUPLICATE EMBEDDING CHECK\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"# Exact byte-level duplicate vectors.\\n\",\"row_hashes = [\\n\",\"    hashlib.sha256(\\n\",\"        row.tobytes()\\n\",\"    ).hexdigest()\\n\",\"    for row in embeddings\\n\",\"]\\n\",\"\\n\",\"row_hash_counts = Counter(row_hashes)\\n\",\"\\n\",\"exact_duplicate_groups = {\\n\",\"    row_hash: count\\n\",\"    for row_hash, count in row_hash_counts.items()\\n\",\"    if count > 1\\n\",\"}\\n\",\"\\n\",\"print(\\\"Embedding rows:\\\", len(embeddings))\\n\",\"print(\\\"Unique exact embedding vectors:\\\", len(row_hash_counts))\\n\",\"print(\\\"Exact duplicate vector groups:\\\", len(exact_duplicate_groups))\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 8. METADATA CROSS-CHECK\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 8 — GENERATION METADATA CROSS-CHECK\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"metadata_counts = metadata.get(\\\"counts\\\", {})\\n\",\"\\n\",\"metadata_cross_checks = {\\n\",\"    \\\"expected_images\\\": (\\n\",\"        metadata_counts.get(\\\"expected_standard_images\\\")\\n\",\"        == EXPECTED_IMAGES\\n\",\"    ),\\n\",\"    \\\"processed_images\\\": (\\n\",\"        metadata_counts.get(\\\"processed_images\\\")\\n\",\"        == EXPECTED_IMAGES\\n\",\"    ),\\n\",\"    \\\"successful_embeddings\\\": (\\n\",\"        metadata_counts.get(\\\"successful_embeddings\\\")\\n\",\"        == EXPECTED_IMAGES\\n\",\"    ),\\n\",\"    \\\"extraction_failures\\\": (\\n\",\"        metadata_counts.get(\\\"extraction_failures\\\")\\n\",\"        == 0\\n\",\"    ),\\n\",\"    \\\"unique_subjects\\\": (\\n\",\"        metadata_counts.get(\\\"unique_subjects\\\")\\n\",\"        == len(all_subjects)\\n\",\"    ),\\n\",\"    \\\"unique_conditions\\\": (\\n\",\"        metadata_counts.get(\\\"unique_illumination_conditions\\\")\\n\",\"        == len(all_conditions)\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"for name, passed in metadata_cross_checks.items():\\n\",\"    print(f\\\"{name}: {'PASS' if passed else 'FAIL'}\\\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 9. FINAL AUDIT DECISION\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"audit_checks = {\\n\",\"    \\\"embedding_hash_match\\\": embedding_hash_match,\\n\",\"    \\\"metadata_hash_match\\\": metadata_hash_match,\\n\",\"    \\\"source_archive_hash_match\\\": source_hash_match,\\n\",\"    \\\"correct_embedding_shape\\\": embeddings.shape == (\\n\",\"        EXPECTED_IMAGES,\\n\",\"        EXPECTED_DIMENSION\\n\",\"    ),\\n\",\"    \\\"correct_embedding_dtype\\\": embeddings.dtype == np.float32,\\n\",\"    \\\"all_embeddings_finite\\\": all_finite,\\n\",\"    \\\"all_embedding_norms_valid\\\": all_norms_valid,\\n\",\"    \\\"metadata_array_lengths_valid\\\": mapping_lengths_valid,\\n\",\"    \\\"unique_filename_mapping\\\": unique_filename_mapping,\\n\",\"    \\\"filename_metadata_mapping_valid\\\": len(mapping_errors) == 0,\\n\",\"    \\\"source_correspondence_valid\\\": source_correspondence_valid,\\n\",\"    \\\"expected_subject_count\\\": len(all_subjects) == 38,\\n\",\"    \\\"expected_condition_count\\\": len(all_conditions) == 64,\\n\",\"    \\\"expected_common_condition_count\\\": len(common_conditions) == 57,\\n\",\"    \\\"expected_common_observation_count\\\": (\\n\",\"        common_condition_observations == 2166\\n\",\"    ),\\n\",\"    \\\"metadata_cross_checks_valid\\\": all(\\n\",\"        metadata_cross_checks.values()\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"audit_passed = all(audit_checks.values())\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 10. SAVE AUDIT REPORT\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"audit_report = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"step\\\": \\\"2.6.20\\\",\\n\",\"    \\\"audit_name\\\": \\\"Embedding Quality and Completeness Audit\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(\\n\",\"        timezone.utc\\n\",\"    ).isoformat(),\\n\",\"\\n\",\"    \\\"file_hashes\\\": {\\n\",\"        \\\"source_archive_sha256\\\": source_archive_sha256,\\n\",\"        \\\"embedding_archive_sha256\\\": embedding_sha256,\\n\",\"        \\\"metadata_sha256\\\": metadata_sha256\\n\",\"    },\\n\",\"\\n\",\"    \\\"counts\\\": {\\n\",\"        \\\"embedding_rows\\\": int(len(embeddings)),\\n\",\"        \\\"embedding_dimension\\\": int(embeddings.shape[1]),\\n\",\"        \\\"unique_filenames\\\": int(unique_filenames),\\n\",\"        \\\"unique_subjects\\\": int(len(all_subjects)),\\n\",\"        \\\"unique_conditions\\\": int(len(all_conditions)),\\n\",\"        \\\"common_conditions\\\": int(len(common_conditions)),\\n\",\"        \\\"common_condition_observations\\\": int(\\n\",\"            common_condition_observations\\n\",\"        ),\\n\",\"        \\\"missing_embeddings\\\": int(len(missing_embeddings)),\\n\",\"        \\\"unexpected_embeddings\\\": int(len(unexpected_embeddings))\\n\",\"    },\\n\",\"\\n\",\"    \\\"numerical_validation\\\": {\\n\",\"        \\\"all_finite\\\": all_finite,\\n\",\"        \\\"all_l2_norms_valid\\\": all_norms_valid,\\n\",\"        \\\"norm_statistics\\\": norm_statistics\\n\",\"    },\\n\",\"\\n\",\"    \\\"mapping_validation\\\": {\\n\",\"        \\\"array_lengths_valid\\\": mapping_lengths_valid,\\n\",\"        \\\"unique_filename_mapping\\\": unique_filename_mapping,\\n\",\"        \\\"mapping_errors\\\": mapping_errors,\\n\",\"        \\\"source_correspondence_valid\\\": source_correspondence_valid,\\n\",\"        \\\"missing_embeddings\\\": missing_embeddings,\\n\",\"        \\\"unexpected_embeddings\\\": unexpected_embeddings\\n\",\"    },\\n\",\"\\n\",\"    \\\"duplicate_embedding_check\\\": {\\n\",\"        \\\"unique_exact_vectors\\\": len(row_hash_counts),\\n\",\"        \\\"exact_duplicate_vector_groups\\\": exact_duplicate_groups\\n\",\"    },\\n\",\"\\n\",\"    \\\"subject_counts\\\": dict(subject_counts),\\n\",\"    \\\"condition_counts\\\": dict(condition_counts),\\n\",\"\\n\",\"    \\\"metadata_cross_checks\\\": metadata_cross_checks,\\n\",\"\\n\",\"    \\\"audit_checks\\\": audit_checks,\\n\",\"    \\\"audit_status\\\": \\\"PASSED\\\" if audit_passed else \\\"FAILED\\\",\\n\",\"\\n\",\"    \\\"limitations\\\": [\\n\",\"        \\\"Numerical validity does not establish identity recognition accuracy.\\\",\\n\",\"        \\\"Exact duplicate embeddings are reported but do not alone establish a data error.\\\",\\n\",\"        \\\"The direct-resizing preprocessing differs from Experiment 18.\\\",\\n\",\"        \\\"The 57-condition subset represents identity-condition matched observations, not exact source-image pairs.\\\"\\n\",\"    ]\\n\",\"}\\n\",\"\\n\",\"with open(\\n\",\"    report_path,\\n\",\"    \\\"w\\\",\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\") as f:\\n\",\"    json.dump(audit_report, f, indent=2)\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 9 — FINAL AUDIT RESULT\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"for name, passed in audit_checks.items():\\n\",\"    print(f\\\"{name}: {'PASS' if passed else 'FAIL'}\\\")\\n\",\"\\n\",\"print(\\\"\\\\nOverall audit:\\\", \\\"PASSED\\\" if audit_passed else \\\"FAILED\\\")\\n\",\"print(\\\"Report saved:\\\", report_path)\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"STEP 2.6.20 FINISHED\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"assert audit_passed, (\\n\",\"    \\\"Embedding audit failed. Inspect the saved report before proceeding.\\\"\\n\",\")\\n\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"-KXNJhk6xMdt\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794352930313,\"user_tz\":360,\"elapsed\":3314,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"a19f18d1-792f-41be-9d9f-31f6c6995e15\"},\"execution_count\":null,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"===========================================================================\\n\",\"STEP 1 — FILE AND HASH VALIDATION\\n\",\"===========================================================================\\n\",\"Embedding archive SHA256: 127ffb6e71b871ebab9ed10fd8ce5f2b78b9f3971db4075cf14b44f7df2d3c4c\\n\",\"Metadata SHA256: 5efe5026210728e333ac5cd1fb0bcba093504e5214c0f72fbef931101a5d0888\\n\",\"Source archive SHA256: 8bbabf3836d077d60626c9ee3c54c2d2851a8d2c15c8b7e13b9bc162e86ea573\\n\",\"Embedding hash matches generation record: True\\n\",\"Metadata hash matches generation record: True\\n\",\"Source archive hash matches acquisition record: True\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 2 — SAVED EMBEDDING ARCHIVE VALIDATION\\n\",\"===========================================================================\\n\",\"Embedding shape: (2414, 512)\\n\",\"Embedding dtype: float32\\n\",\"Filename count: 2414\\n\",\"Subject count: 2414\\n\",\"Condition count: 2414\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 3 — NUMERICAL QUALITY\\n\",\"===========================================================================\\n\",\"All embeddings finite: True\\n\",\"All L2 norms approximately 1: True\\n\",\"Mean norm: 1.0\\n\",\"Minimum norm: 0.9999998807907104\\n\",\"Maximum norm: 1.0000001192092896\\n\",\"Norm standard deviation: 4.390835073309063e-08\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 4 — ROW MAPPING VALIDATION\\n\",\"===========================================================================\\n\",\"All metadata arrays have matching lengths: True\\n\",\"Unique filenames: 2414\\n\",\"Filename-to-metadata mapping errors: 0\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 5 — SOURCE IMAGE CORRESPONDENCE\\n\",\"===========================================================================\\n\",\"Expected source images: 2414\\n\",\"Saved embedding rows: 2414\\n\",\"Missing embeddings: 0\\n\",\"Unexpected embedding filenames: 0\\n\",\"One-to-one filename correspondence: True\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 6 — SUBJECT AND CONDITION COVERAGE\\n\",\"===========================================================================\\n\",\"Unique subjects: 38\\n\",\"Unique conditions: 64\\n\",\"Conditions shared by all subjects: 57\\n\",\"Common-condition observations: 2166\\n\",\"\\n\",\"Per-subject observation counts:\\n\",\"yaleB01 64\\n\",\"yaleB02 64\\n\",\"yaleB03 64\\n\",\"yaleB04 64\\n\",\"yaleB05 64\\n\",\"yaleB06 64\\n\",\"yaleB07 64\\n\",\"yaleB08 64\\n\",\"yaleB09 64\\n\",\"yaleB10 64\\n\",\"yaleB11 60\\n\",\"yaleB12 59\\n\",\"yaleB13 60\\n\",\"yaleB15 63\\n\",\"yaleB16 62\\n\",\"yaleB17 63\\n\",\"yaleB18 63\\n\",\"yaleB19 64\\n\",\"yaleB20 64\\n\",\"yaleB21 64\\n\",\"yaleB22 64\\n\",\"yaleB23 64\\n\",\"yaleB24 64\\n\",\"yaleB25 64\\n\",\"yaleB26 64\\n\",\"yaleB27 64\\n\",\"yaleB28 64\\n\",\"yaleB29 64\\n\",\"yaleB30 64\\n\",\"yaleB31 64\\n\",\"yaleB32 64\\n\",\"yaleB33 64\\n\",\"yaleB34 64\\n\",\"yaleB35 64\\n\",\"yaleB36 64\\n\",\"yaleB37 64\\n\",\"yaleB38 64\\n\",\"yaleB39 64\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 7 — DUPLICATE EMBEDDING CHECK\\n\",\"===========================================================================\\n\",\"Embedding rows: 2414\\n\",\"Unique exact embedding vectors: 2414\\n\",\"Exact duplicate vector groups: 0\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 8 — GENERATION METADATA CROSS-CHECK\\n\",\"===========================================================================\\n\",\"expected_images: PASS\\n\",\"processed_images: PASS\\n\",\"successful_embeddings: PASS\\n\",\"extraction_failures: PASS\\n\",\"unique_subjects: PASS\\n\",\"unique_conditions: PASS\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 9 — FINAL AUDIT RESULT\\n\",\"===========================================================================\\n\",\"embedding_hash_match: PASS\\n\",\"metadata_hash_match: PASS\\n\",\"source_archive_hash_match: PASS\\n\",\"correct_embedding_shape: PASS\\n\",\"correct_embedding_dtype: PASS\\n\",\"all_embeddings_finite: PASS\\n\",\"all_embedding_norms_valid: PASS\\n\",\"metadata_array_lengths_valid: PASS\\n\",\"unique_filename_mapping: PASS\\n\",\"filename_metadata_mapping_valid: PASS\\n\",\"source_correspondence_valid: PASS\\n\",\"expected_subject_count: PASS\\n\",\"expected_condition_count: PASS\\n\",\"expected_common_condition_count: PASS\\n\",\"expected_common_observation_count: PASS\\n\",\"metadata_cross_checks_valid: PASS\\n\",\"\\n\",\"Overall audit: PASSED\\n\",\"Report saved: /content/drive/MyDrive/Experiment_20_Results/dataset_audit/experiment20_embedding_quality_completeness_audit.json\\n\",\"===========================================================================\\n\",\"STEP 2.6.20 FINISHED\\n\",\"===========================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"\\n\",\"## Step 2.6.21 — Dataset Packaging and Freeze\\n\",\"\\n\",\"### Objective\\n\",\"Create and verify a reproducible, frozen dataset package for Experiment 20 Stage 2.\\n\",\"\\n\",\"### Package contents\\n\",\"1. Original CroppedYale source archive.\\n\",\"2. FaceNet embedding archive.\\n\",\"3. Embedding generation metadata.\\n\",\"4. Frozen preprocessing and model configuration.\\n\",\"5. Dataset acquisition and provenance records.\\n\",\"6. Image integrity and preprocessing audit reports.\\n\",\"7. Embedding quality and completeness audit.\\n\",\"8. Illumination condition manifests and grouping records.\\n\",\"9. SHA256 checksum manifest.\\n\",\"10. Research README documenting the dataset and its limitations.\\n\",\"\\n\",\"### Freeze conditions\\n\",\"- 2,414 source images.\\n\",\"- 2,414 valid 512-dimensional embeddings.\\n\",\"- 38 identities.\\n\",\"- 64 illumination conditions.\\n\",\"- 57 common illumination conditions.\\n\",\"- 2,166 common-condition observations.\\n\",\"- Zero extraction failures.\\n\",\"- All previous integrity and completeness checks passed.\\n\",\"\\n\",\"### Scientific limitations\\n\",\"- CroppedYale was obtained from a community-hosted Academic Torrents source.\\n\",\"- The archive has not been independently authenticated against an official checksum.\\n\",\"- Direct resizing replaces the MTCNN preprocessing used in Experiment 18.\\n\",\"- The dataset contains different captures across illumination conditions, not exact source-image perturbations.\\n\",\"- External dataset validation does not constitute independent model validation.\\n\",\"\\n\",\"### Output\\n\",\"A ZIP research package, README, freeze manifest and SHA256 checksum file.\\n\"],\"metadata\":{\"id\":\"8x5WmiCSxdPk\"}},{\"cell_type\":\"code\",\"source\":[\"\\n\",\"import os\\n\",\"import json\\n\",\"import shutil\\n\",\"import hashlib\\n\",\"import zipfile\\n\",\"import platform\\n\",\"\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"# ============================================================\\n\",\"# STEP 2.6.21 — DATASET PACKAGING AND FREEZE\\n\",\"# ============================================================\\n\",\"\\n\",\"BASE = \\\"/content/drive/MyDrive/Experiment_20_Results\\\"\\n\",\"\\n\",\"SOURCE_ARCHIVE = (\\n\",\"    \\\"/content/Experiment20_Downloads/CroppedYale.zip\\\"\\n\",\")\\n\",\"\\n\",\"EMBEDDING_DIR = os.path.join(BASE, \\\"embeddings\\\")\\n\",\"AUDIT_DIR = os.path.join(BASE, \\\"dataset_audit\\\")\\n\",\"\\n\",\"EMBEDDING_ARCHIVE = os.path.join(\\n\",\"    EMBEDDING_DIR,\\n\",\"    \\\"experiment20_croppedyale_facenet_embeddings.npz\\\"\\n\",\")\\n\",\"\\n\",\"EMBEDDING_METADATA = os.path.join(\\n\",\"    EMBEDDING_DIR,\\n\",\"    \\\"experiment20_croppedyale_embedding_metadata.json\\\"\\n\",\")\\n\",\"\\n\",\"EMBEDDING_CONFIG = os.path.join(\\n\",\"    EMBEDDING_DIR,\\n\",\"    \\\"experiment20_embedding_generation_config.json\\\"\\n\",\")\\n\",\"\\n\",\"PACKAGE_ROOT = os.path.join(\\n\",\"    BASE,\\n\",\"    \\\"Experiment_20_Stage_2_Frozen_Dataset\\\"\\n\",\")\\n\",\"\\n\",\"PACKAGE_DIR = os.path.join(\\n\",\"    PACKAGE_ROOT,\\n\",\"    \\\"Experiment_20_Stage_2_Frozen_Dataset\\\"\\n\",\")\\n\",\"\\n\",\"PACKAGE_ZIP = os.path.join(\\n\",\"    BASE,\\n\",\"    \\\"Experiment_20_Stage_2_Frozen_Dataset.zip\\\"\\n\",\")\\n\",\"\\n\",\"PACKAGE_SHA_FILE = os.path.join(\\n\",\"    BASE,\\n\",\"    \\\"Experiment_20_Stage_2_Frozen_Dataset_SHA256.txt\\\"\\n\",\")\\n\",\"\\n\",\"FREEZE_MANIFEST = os.path.join(\\n\",\"    BASE,\\n\",\"    \\\"Experiment_20_Stage_2_Freeze_Manifest.json\\\"\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. REQUIRED INPUT VALIDATION\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"STEP 1 — REQUIRED INPUT VALIDATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"required_files = [\\n\",\"    SOURCE_ARCHIVE,\\n\",\"    EMBEDDING_ARCHIVE,\\n\",\"    EMBEDDING_METADATA,\\n\",\"    EMBEDDING_CONFIG,\\n\",\"    os.path.join(\\n\",\"        AUDIT_DIR,\\n\",\"        \\\"experiment20_full_dataset_image_integrity_audit.json\\\"\\n\",\"    ),\\n\",\"    os.path.join(\\n\",\"        AUDIT_DIR,\\n\",\"        \\\"experiment20_preprocessing_consistency_audit.json\\\"\\n\",\"    ),\\n\",\"    os.path.join(\\n\",\"        AUDIT_DIR,\\n\",\"        \\\"experiment20_embedding_quality_completeness_audit.json\\\"\\n\",\"    ),\\n\",\"    os.path.join(\\n\",\"        AUDIT_DIR,\\n\",\"        \\\"experiment20_corrected_illumination_condition_manifest.json\\\"\\n\",\"    ),\\n\",\"    os.path.join(\\n\",\"        AUDIT_DIR,\\n\",\"        \\\"experiment20_angular_hemisphere_audit.json\\\"\\n\",\"    )\\n\",\"]\\n\",\"\\n\",\"missing_required = [\\n\",\"    path for path in required_files\\n\",\"    if not os.path.isfile(path)\\n\",\"]\\n\",\"\\n\",\"for path in required_files:\\n\",\"    print(\\n\",\"        (\\\"FOUND: \\\" if os.path.isfile(path) else \\\"MISSING: \\\")\\n\",\"        + path\\n\",\"    )\\n\",\"\\n\",\"assert not missing_required, (\\n\",\"    \\\"Required package inputs are missing. \\\"\\n\",\"    \\\"Resolve them before freezing.\\\"\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. SHA256 FUNCTION\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"def sha256_file(path):\\n\",\"\\n\",\"    digest = hashlib.sha256()\\n\",\"\\n\",\"    with open(path, \\\"rb\\\") as f:\\n\",\"        for chunk in iter(\\n\",\"            lambda: f.read(1024 * 1024),\\n\",\"            b\\\"\\\"\\n\",\"        ):\\n\",\"            digest.update(chunk)\\n\",\"\\n\",\"    return digest.hexdigest()\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. VERIFY PREVIOUSLY RECORDED HASHES\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 2 — SOURCE AND EMBEDDING HASH VERIFICATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"expected_hashes = {\\n\",\"    SOURCE_ARCHIVE:\\n\",\"        \\\"8bbabf3836d077d60626c9ee3c54c2d2851a8d2c15c8b7e13b9bc162e86ea573\\\",\\n\",\"\\n\",\"    EMBEDDING_ARCHIVE:\\n\",\"        \\\"127ffb6e71b871ebab9ed10fd8ce5f2b78b9f3971db4075cf14b44f7df2d3c4c\\\",\\n\",\"\\n\",\"    EMBEDDING_METADATA:\\n\",\"        \\\"5efe5026210728e333ac5cd1fb0bcba093504e5214c0f72fbef931101a5d0888\\\"\\n\",\"}\\n\",\"\\n\",\"verified_hashes = {}\\n\",\"\\n\",\"for path, expected_hash in expected_hashes.items():\\n\",\"\\n\",\"    actual_hash = sha256_file(path)\\n\",\"\\n\",\"    verified_hashes[os.path.basename(path)] = actual_hash\\n\",\"\\n\",\"    print(os.path.basename(path))\\n\",\"    print(\\\"Expected:\\\", expected_hash)\\n\",\"    print(\\\"Actual:  \\\", actual_hash)\\n\",\"    print(\\\"Match:\\\", actual_hash == expected_hash)\\n\",\"\\n\",\"    assert actual_hash == expected_hash, (\\n\",\"        f\\\"Hash mismatch: {path}\\\"\\n\",\"    )\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. VALIDATE EMBEDDING AND AUDIT METADATA\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 3 — RESEARCH EVIDENCE VALIDATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"with open(\\n\",\"    EMBEDDING_METADATA,\\n\",\"    \\\"r\\\",\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\") as f:\\n\",\"    embedding_metadata = json.load(f)\\n\",\"\\n\",\"with open(\\n\",\"    os.path.join(\\n\",\"        AUDIT_DIR,\\n\",\"        \\\"experiment20_embedding_quality_completeness_audit.json\\\"\\n\",\"    ),\\n\",\"    \\\"r\\\",\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\") as f:\\n\",\"    embedding_audit = json.load(f)\\n\",\"\\n\",\"with open(\\n\",\"    os.path.join(\\n\",\"        AUDIT_DIR,\\n\",\"        \\\"experiment20_full_dataset_image_integrity_audit.json\\\"\\n\",\"    ),\\n\",\"    \\\"r\\\",\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\") as f:\\n\",\"    image_audit = json.load(f)\\n\",\"\\n\",\"with open(\\n\",\"    os.path.join(\\n\",\"        AUDIT_DIR,\\n\",\"        \\\"experiment20_preprocessing_consistency_audit.json\\\"\\n\",\"    ),\\n\",\"    \\\"r\\\",\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\") as f:\\n\",\"    preprocessing_audit = json.load(f)\\n\",\"\\n\",\"assert embedding_audit[\\\"audit_status\\\"] == \\\"PASSED\\\"\\n\",\"assert image_audit[\\\"dataset_counts\\\"][\\\"standard_illumination_images\\\"] == 2414\\n\",\"assert preprocessing_audit[\\\"audit_status\\\"] == \\\"PASSED\\\"\\n\",\"\\n\",\"counts = embedding_metadata[\\\"counts\\\"]\\n\",\"\\n\",\"assert counts[\\\"successful_embeddings\\\"] == 2414\\n\",\"assert counts[\\\"extraction_failures\\\"] == 0\\n\",\"assert counts[\\\"unique_subjects\\\"] == 38\\n\",\"assert counts[\\\"unique_illumination_conditions\\\"] == 64\\n\",\"\\n\",\"print(\\\"Image integrity audit: PASSED\\\")\\n\",\"print(\\\"Preprocessing consistency audit: PASSED\\\")\\n\",\"print(\\\"Embedding completeness audit: PASSED\\\")\\n\",\"print(\\\"Successful embeddings:\\\", counts[\\\"successful_embeddings\\\"])\\n\",\"print(\\\"Extraction failures:\\\", counts[\\\"extraction_failures\\\"])\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. CREATE PACKAGE DIRECTORY\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 4 — PACKAGE ASSEMBLY\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"if os.path.exists(PACKAGE_ROOT):\\n\",\"    shutil.rmtree(PACKAGE_ROOT)\\n\",\"\\n\",\"os.makedirs(PACKAGE_DIR, exist_ok=True)\\n\",\"\\n\",\"folders = [\\n\",\"    \\\"source\\\",\\n\",\"    \\\"embeddings\\\",\\n\",\"    \\\"configuration\\\",\\n\",\"    \\\"audits\\\",\\n\",\"    \\\"provenance\\\"\\n\",\"]\\n\",\"\\n\",\"for folder in folders:\\n\",\"    os.makedirs(\\n\",\"        os.path.join(PACKAGE_DIR, folder),\\n\",\"        exist_ok=True\\n\",\"    )\\n\",\"\\n\",\"def copy_into_package(source, destination_folder):\\n\",\"\\n\",\"    destination = os.path.join(\\n\",\"        PACKAGE_DIR,\\n\",\"        destination_folder,\\n\",\"        os.path.basename(source)\\n\",\"    )\\n\",\"\\n\",\"    shutil.copy2(source, destination)\\n\",\"\\n\",\"    return destination\\n\",\"\\n\",\"# Source archive\\n\",\"copy_into_package(\\n\",\"    SOURCE_ARCHIVE,\\n\",\"    \\\"source\\\"\\n\",\")\\n\",\"\\n\",\"# Embeddings and configuration\\n\",\"copy_into_package(\\n\",\"    EMBEDDING_ARCHIVE,\\n\",\"    \\\"embeddings\\\"\\n\",\")\\n\",\"\\n\",\"copy_into_package(\\n\",\"    EMBEDDING_METADATA,\\n\",\"    \\\"embeddings\\\"\\n\",\")\\n\",\"\\n\",\"copy_into_package(\\n\",\"    EMBEDDING_CONFIG,\\n\",\"    \\\"configuration\\\"\\n\",\")\\n\",\"\\n\",\"# Required audits\\n\",\"audit_files = [\\n\",\"    \\\"experiment20_full_dataset_image_integrity_audit.json\\\",\\n\",\"    \\\"experiment20_preprocessing_consistency_audit.json\\\",\\n\",\"    \\\"experiment20_embedding_quality_completeness_audit.json\\\",\\n\",\"    \\\"experiment20_corrected_illumination_condition_manifest.json\\\",\\n\",\"    \\\"experiment20_angular_hemisphere_audit.json\\\",\\n\",\"    \\\"experiment20_croppedyale_acquisition_record.json\\\",\\n\",\"    \\\"experiment20_croppedyale_filename_completeness_audit.json\\\",\\n\",\"    \\\"experiment20_croppedyale_image_integrity_audit.json\\\",\\n\",\"    \\\"experiment20_common_illumination_condition_audit.json\\\",\\n\",\"    \\\"experiment20_common_illumination_condition_manifest.json\\\",\\n\",\"    \\\"experiment20_grouped_illumination_condition_manifest.json\\\",\\n\",\"    \\\"experiment20_lighting_geometry_grouping_audit.json\\\",\\n\",\"    \\\"experiment20_yaleb_source_audit.json\\\",\\n\",\"    \\\"experiment20_yaleb_alternative_source_audit.json\\\",\\n\",\"    \\\"experiment20_yaleb_torrent_metadata_audit.json\\\",\\n\",\"    \\\"experiment20_acquisition_environment_audit.json\\\",\\n\",\"    \\\"experiment20_aria2_installation_audit.json\\\"\\n\",\"]\\n\",\"\\n\",\"included_audits = []\\n\",\"optional_audits_missing = []\\n\",\"\\n\",\"for filename in audit_files:\\n\",\"\\n\",\"    source = os.path.join(AUDIT_DIR, filename)\\n\",\"\\n\",\"    if os.path.isfile(source):\\n\",\"\\n\",\"        copy_into_package(\\n\",\"            source,\\n\",\"            \\\"audits\\\"\\n\",\"        )\\n\",\"\\n\",\"        included_audits.append(filename)\\n\",\"\\n\",\"    else:\\n\",\"        optional_audits_missing.append(filename)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. COPY CHECKPOINT\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"checkpoint_path = os.path.join(\\n\",\"    EMBEDDING_DIR,\\n\",\"    \\\"checkpoints\\\",\\n\",\"    \\\"experiment20_embedding_checkpoint.npz\\\"\\n\",\")\\n\",\"\\n\",\"checkpoint_metadata_path = os.path.join(\\n\",\"    EMBEDDING_DIR,\\n\",\"    \\\"checkpoints\\\",\\n\",\"    \\\"experiment20_embedding_checkpoint_metadata.json\\\"\\n\",\")\\n\",\"\\n\",\"checkpoint_files_included = []\\n\",\"\\n\",\"for path in [\\n\",\"    checkpoint_path,\\n\",\"    checkpoint_metadata_path\\n\",\"]:\\n\",\"\\n\",\"    if os.path.isfile(path):\\n\",\"\\n\",\"        copy_into_package(\\n\",\"            path,\\n\",\"            \\\"embeddings\\\"\\n\",\"        )\\n\",\"\\n\",\"        checkpoint_files_included.append(\\n\",\"            os.path.basename(path)\\n\",\"        )\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. CREATE RESEARCH README\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"readme = \\\"\\\"\\\"# Experiment 20 — Stage 2 Frozen Dataset\\n\",\"\\n\",\"## Dataset\\n\",\"\\n\",\"Cropped Extended Yale B frontal-pose illumination subset.\\n\",\"\\n\",\"## Dataset statistics\\n\",\"\\n\",\"- Standard illumination images: 2,414\\n\",\"- Ambient reference images excluded: 38\\n\",\"- Unique identities: 38\\n\",\"- Unique illumination conditions: 64\\n\",\"- Conditions shared by every identity: 57\\n\",\"- Common-condition observations: 2,166\\n\",\"- Incomplete identities: 7\\n\",\"- FaceNet extraction failures: 0\\n\",\"\\n\",\"## Embeddings\\n\",\"\\n\",\"- Architecture: InceptionResnetV1\\n\",\"- Pretrained weights: VGGFace2\\n\",\"- Embedding dimension: 512\\n\",\"- Data type: float32\\n\",\"- Model mode: evaluation\\n\",\"- Device: CPU\\n\",\"- Embeddings: L2-normalized\\n\",\"\\n\",\"## Preprocessing\\n\",\"\\n\",\"1. Load grayscale PGM image.\\n\",\"2. Convert to RGB by channel replication.\\n\",\"3. Resize directly to 160 x 160.\\n\",\"4. Convert using torchvision ToTensor().\\n\",\"5. Generate FaceNet embedding.\\n\",\"\\n\",\"MTCNN face detection and alignment were not used for Yale B because\\n\",\"the initial compatibility test detected only 1 of 12 tested images.\\n\",\"\\n\",\"This preprocessing differs from Experiment 18.\\n\",\"\\n\",\"## Condition coverage\\n\",\"\\n\",\"The complete dataset contains 64 illumination conditions.\\n\",\"Only 57 are present for all 38 identities.\\n\",\"\\n\",\"Use the 2,166-observation common-condition subset for analyses\\n\",\"requiring complete identity-condition coverage.\\n\",\"\\n\",\"## Provenance and limitations\\n\",\"\\n\",\"The archive was acquired from a community-hosted Academic Torrents\\n\",\"listing. It has not been independently authenticated against an\\n\",\"official UCSD checksum.\\n\",\"\\n\",\"The dataset is a cropped frontal-pose subset, not the complete\\n\",\"multi-pose Extended Yale B dataset.\\n\",\"\\n\",\"Different illumination conditions are different image captures\\n\",\"of the same identity. They are not exact source-image perturbations.\\n\",\"\\n\",\"The FaceNet model was pretrained on VGGFace2. External dataset\\n\",\"evaluation does not constitute independent model validation.\\n\",\"\\n\",\"Embedding extraction success does not establish recognition\\n\",\"accuracy, fairness, robustness or deployment readiness.\\n\",\"\\n\",\"## Freeze status\\n\",\"\\n\",\"This package freezes the dataset and preprocessing artifacts for\\n\",\"Experiment 20 Stage 2. It does not freeze or validate the scientific\\n\",\"results of future experiments.\\n\",\"\\n\",\"All file hashes are recorded in SHA256SUMS.txt.\\n\",\"\\\"\\\"\\\"\\n\",\"\\n\",\"readme_path = os.path.join(\\n\",\"    PACKAGE_DIR,\\n\",\"    \\\"README.md\\\"\\n\",\")\\n\",\"\\n\",\"with open(\\n\",\"    readme_path,\\n\",\"    \\\"w\\\",\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\") as f:\\n\",\"    f.write(readme)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 8. CREATE PACKAGE FILE HASH MANIFEST\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 5 — PACKAGE CHECKSUM MANIFEST\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"package_file_hashes = {}\\n\",\"\\n\",\"for root, dirs, files in os.walk(PACKAGE_DIR):\\n\",\"\\n\",\"    for filename in sorted(files):\\n\",\"\\n\",\"        path = os.path.join(root, filename)\\n\",\"\\n\",\"        relative_path = os.path.relpath(\\n\",\"            path,\\n\",\"            PACKAGE_DIR\\n\",\"        ).replace(\\\"\\\\\\\\\\\", \\\"/\\\")\\n\",\"\\n\",\"        package_file_hashes[relative_path] = sha256_file(path)\\n\",\"\\n\",\"checksum_path = os.path.join(\\n\",\"    PACKAGE_DIR,\\n\",\"    \\\"SHA256SUMS.txt\\\"\\n\",\")\\n\",\"\\n\",\"with open(\\n\",\"    checksum_path,\\n\",\"    \\\"w\\\",\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\") as f:\\n\",\"\\n\",\"    for relative_path, digest in sorted(\\n\",\"        package_file_hashes.items()\\n\",\"    ):\\n\",\"        f.write(\\n\",\"            f\\\"{digest}  {relative_path}\\\\n\\\"\\n\",\"        )\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 9. CREATE PACKAGE ZIP\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 6 — ZIP PACKAGE CREATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"if os.path.exists(PACKAGE_ZIP):\\n\",\"    os.remove(PACKAGE_ZIP)\\n\",\"\\n\",\"with zipfile.ZipFile(\\n\",\"    PACKAGE_ZIP,\\n\",\"    \\\"w\\\",\\n\",\"    compression=zipfile.ZIP_DEFLATED,\\n\",\"    compresslevel=6\\n\",\") as package_zip:\\n\",\"\\n\",\"    for root, dirs, files in os.walk(PACKAGE_ROOT):\\n\",\"\\n\",\"        for filename in sorted(files):\\n\",\"\\n\",\"            path = os.path.join(root, filename)\\n\",\"\\n\",\"            arcname = os.path.relpath(\\n\",\"                path,\\n\",\"                PACKAGE_ROOT\\n\",\"            )\\n\",\"\\n\",\"            package_zip.write(\\n\",\"                path,\\n\",\"                arcname\\n\",\"            )\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 10. ZIP INTEGRITY AND CONTENT VALIDATION\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 7 — PACKAGE INTEGRITY VALIDATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"with zipfile.ZipFile(\\n\",\"    PACKAGE_ZIP,\\n\",\"    \\\"r\\\"\\n\",\") as package_zip:\\n\",\"\\n\",\"    bad_member = package_zip.testzip()\\n\",\"\\n\",\"    assert bad_member is None, (\\n\",\"        f\\\"ZIP integrity failure: {bad_member}\\\"\\n\",\"    )\\n\",\"\\n\",\"    zip_members = package_zip.namelist()\\n\",\"\\n\",\"    assert len(zip_members) > 0\\n\",\"\\n\",\"    assert any(\\n\",\"        name.endswith(\\n\",\"            \\\"experiment20_croppedyale_facenet_embeddings.npz\\\"\\n\",\"        )\\n\",\"        for name in zip_members\\n\",\"    )\\n\",\"\\n\",\"    assert any(\\n\",\"        name.endswith(\\\"README.md\\\")\\n\",\"        for name in zip_members\\n\",\"    )\\n\",\"\\n\",\"    assert any(\\n\",\"        name.endswith(\\\"SHA256SUMS.txt\\\")\\n\",\"        for name in zip_members\\n\",\"    )\\n\",\"\\n\",\"    print(\\\"ZIP integrity: PASSED\\\")\\n\",\"    print(\\\"ZIP entries:\\\", len(zip_members))\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 11. PACKAGE HASH AND FREEZE MANIFEST\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"package_sha256 = sha256_file(\\n\",\"    PACKAGE_ZIP\\n\",\")\\n\",\"\\n\",\"package_size = os.path.getsize(\\n\",\"    PACKAGE_ZIP\\n\",\")\\n\",\"\\n\",\"freeze_manifest = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"stage\\\": \\\"Stage 2 — CroppedYale external dataset\\\",\\n\",\"    \\\"step\\\": \\\"2.6.21\\\",\\n\",\"    \\\"freeze_status\\\": \\\"FROZEN\\\",\\n\",\"    \\\"freeze_timestamp_utc\\\": datetime.now(\\n\",\"        timezone.utc\\n\",\"    ).isoformat(),\\n\",\"\\n\",\"    \\\"dataset_statistics\\\": {\\n\",\"        \\\"standard_images\\\": 2414,\\n\",\"        \\\"ambient_images_excluded\\\": 38,\\n\",\"        \\\"identities\\\": 38,\\n\",\"        \\\"illumination_conditions\\\": 64,\\n\",\"        \\\"common_conditions\\\": 57,\\n\",\"        \\\"common_condition_observations\\\": 2166,\\n\",\"        \\\"successful_embeddings\\\": 2414,\\n\",\"        \\\"extraction_failures\\\": 0,\\n\",\"        \\\"embedding_dimension\\\": 512\\n\",\"    },\\n\",\"\\n\",\"    \\\"preprocessing\\\": {\\n\",\"        \\\"source_mode\\\": \\\"L\\\",\\n\",\"        \\\"conversion\\\": \\\"RGB\\\",\\n\",\"        \\\"resize\\\": [160, 160],\\n\",\"        \\\"tensor_conversion\\\": \\\"ToTensor\\\",\\n\",\"        \\\"face_detection\\\": False,\\n\",\"        \\\"face_alignment\\\": False\\n\",\"    },\\n\",\"\\n\",\"    \\\"model\\\": {\\n\",\"        \\\"architecture\\\": \\\"InceptionResnetV1\\\",\\n\",\"        \\\"pretrained_weights\\\": \\\"VGGFace2\\\",\\n\",\"        \\\"embedding_dimension\\\": 512,\\n\",\"        \\\"dtype\\\": \\\"float32\\\",\\n\",\"        \\\"device\\\": \\\"cpu\\\"\\n\",\"    },\\n\",\"\\n\",\"    \\\"verified_hashes\\\": verified_hashes,\\n\",\"\\n\",\"    \\\"package\\\": {\\n\",\"        \\\"filename\\\": os.path.basename(PACKAGE_ZIP),\\n\",\"        \\\"size_bytes\\\": package_size,\\n\",\"        \\\"sha256\\\": package_sha256,\\n\",\"        \\\"zip_entries\\\": len(zip_members)\\n\",\"    },\\n\",\"\\n\",\"    \\\"included_audits\\\": included_audits,\\n\",\"    \\\"optional_audits_not_found\\\": optional_audits_missing,\\n\",\"\\n\",\"    \\\"package_file_count\\\": len(package_file_hashes) + 1,\\n\",\"\\n\",\"    \\\"limitations\\\": [\\n\",\"        \\\"Community-hosted Academic Torrents provenance.\\\",\\n\",\"        \\\"No independent official checksum authentication.\\\",\\n\",\"        \\\"Cropped frontal-pose subset rather than full Extended Yale B.\\\",\\n\",\"        \\\"Direct resizing differs from Experiment 18 MTCNN preprocessing.\\\",\\n\",\"        \\\"External dataset validation is not independent model validation.\\\",\\n\",\"        \\\"Repeated identity-condition captures are not exact image-level pairs.\\\",\\n\",\"        \\\"Embedding extraction success does not establish recognition accuracy.\\\"\\n\",\"    ]\\n\",\"}\\n\",\"\\n\",\"with open(\\n\",\"    FREEZE_MANIFEST,\\n\",\"    \\\"w\\\",\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\") as f:\\n\",\"    json.dump(\\n\",\"        freeze_manifest,\\n\",\"        f,\\n\",\"        indent=2\\n\",\"    )\\n\",\"\\n\",\"with open(\\n\",\"    PACKAGE_SHA_FILE,\\n\",\"    \\\"w\\\",\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\") as f:\\n\",\"    f.write(\\n\",\"        f\\\"{package_sha256}  {os.path.basename(PACKAGE_ZIP)}\\\\n\\\"\\n\",\"    )\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 12. FINAL REPORT\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 8 — FINAL DATASET FREEZE\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"print(\\\"Freeze status: FROZEN\\\")\\n\",\"print(\\\"Package ZIP:\\\", PACKAGE_ZIP)\\n\",\"print(\\\"Package size (bytes):\\\", package_size)\\n\",\"print(\\\"Package SHA256:\\\", package_sha256)\\n\",\"print(\\\"Package entries:\\\", len(zip_members))\\n\",\"print(\\\"Included audit records:\\\", len(included_audits))\\n\",\"print(\\\"Optional audit records not found:\\\", len(optional_audits_missing))\\n\",\"print(\\\"Package internal file hashes:\\\", len(package_file_hashes))\\n\",\"\\n\",\"print(\\\"\\\\nFreeze manifest:\\\", FREEZE_MANIFEST)\\n\",\"print(\\\"Package checksum file:\\\", PACKAGE_SHA_FILE)\\n\",\"\\n\",\"print(\\\"\\\\nIncluded audits:\\\")\\n\",\"for filename in included_audits:\\n\",\"    print(\\\"-\\\", filename)\\n\",\"\\n\",\"if optional_audits_missing:\\n\",\"    print(\\\"\\\\nOptional audit files not found:\\\")\\n\",\"    for filename in optional_audits_missing:\\n\",\"        print(\\\"-\\\", filename)\\n\",\"\\n\",\"print(\\\"\\\\nNo source images or embedding values modified.\\\")\\n\",\"print(\\\"No new embeddings generated.\\\")\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"STEP 2.6.21 FINISHED\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"ueDCd1Dgxh-6\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794353025888,\"user_tz\":360,\"elapsed\":10997,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"16197009-9ad7-45aa-866c-a342d5f3498a\"},\"execution_count\":null,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"===========================================================================\\n\",\"STEP 1 — REQUIRED INPUT VALIDATION\\n\",\"===========================================================================\\n\",\"FOUND: /content/Experiment20_Downloads/CroppedYale.zip\\n\",\"FOUND: /content/drive/MyDrive/Experiment_20_Results/embeddings/experiment20_croppedyale_facenet_embeddings.npz\\n\",\"FOUND: /content/drive/MyDrive/Experiment_20_Results/embeddings/experiment20_croppedyale_embedding_metadata.json\\n\",\"FOUND: /content/drive/MyDrive/Experiment_20_Results/embeddings/experiment20_embedding_generation_config.json\\n\",\"FOUND: /content/drive/MyDrive/Experiment_20_Results/dataset_audit/experiment20_full_dataset_image_integrity_audit.json\\n\",\"FOUND: /content/drive/MyDrive/Experiment_20_Results/dataset_audit/experiment20_preprocessing_consistency_audit.json\\n\",\"FOUND: /content/drive/MyDrive/Experiment_20_Results/dataset_audit/experiment20_embedding_quality_completeness_audit.json\\n\",\"FOUND: /content/drive/MyDrive/Experiment_20_Results/dataset_audit/experiment20_corrected_illumination_condition_manifest.json\\n\",\"FOUND: /content/drive/MyDrive/Experiment_20_Results/dataset_audit/experiment20_angular_hemisphere_audit.json\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 2 — SOURCE AND EMBEDDING HASH VERIFICATION\\n\",\"===========================================================================\\n\",\"CroppedYale.zip\\n\",\"Expected: 8bbabf3836d077d60626c9ee3c54c2d2851a8d2c15c8b7e13b9bc162e86ea573\\n\",\"Actual:   8bbabf3836d077d60626c9ee3c54c2d2851a8d2c15c8b7e13b9bc162e86ea573\\n\",\"Match: True\\n\",\"experiment20_croppedyale_facenet_embeddings.npz\\n\",\"Expected: 127ffb6e71b871ebab9ed10fd8ce5f2b78b9f3971db4075cf14b44f7df2d3c4c\\n\",\"Actual:   127ffb6e71b871ebab9ed10fd8ce5f2b78b9f3971db4075cf14b44f7df2d3c4c\\n\",\"Match: True\\n\",\"experiment20_croppedyale_embedding_metadata.json\\n\",\"Expected: 5efe5026210728e333ac5cd1fb0bcba093504e5214c0f72fbef931101a5d0888\\n\",\"Actual:   5efe5026210728e333ac5cd1fb0bcba093504e5214c0f72fbef931101a5d0888\\n\",\"Match: True\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 3 — RESEARCH EVIDENCE VALIDATION\\n\",\"===========================================================================\\n\",\"Image integrity audit: PASSED\\n\",\"Preprocessing consistency audit: PASSED\\n\",\"Embedding completeness audit: PASSED\\n\",\"Successful embeddings: 2414\\n\",\"Extraction failures: 0\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 4 — PACKAGE ASSEMBLY\\n\",\"===========================================================================\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 5 — PACKAGE CHECKSUM MANIFEST\\n\",\"===========================================================================\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 6 — ZIP PACKAGE CREATION\\n\",\"===========================================================================\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 7 — PACKAGE INTEGRITY VALIDATION\\n\",\"===========================================================================\\n\",\"ZIP integrity: PASSED\\n\",\"ZIP entries: 25\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 8 — FINAL DATASET FREEZE\\n\",\"===========================================================================\\n\",\"Freeze status: FROZEN\\n\",\"Package ZIP: /content/drive/MyDrive/Experiment_20_Results/Experiment_20_Stage_2_Frozen_Dataset.zip\\n\",\"Package size (bytes): 67496777\\n\",\"Package SHA256: d65c657861e093c50f54666deb63185e5ac72af65ef450610f2ea98502b26339\\n\",\"Package entries: 25\\n\",\"Included audit records: 17\\n\",\"Optional audit records not found: 0\\n\",\"Package internal file hashes: 24\\n\",\"\\n\",\"Freeze manifest: /content/drive/MyDrive/Experiment_20_Results/Experiment_20_Stage_2_Freeze_Manifest.json\\n\",\"Package checksum file: /content/drive/MyDrive/Experiment_20_Results/Experiment_20_Stage_2_Frozen_Dataset_SHA256.txt\\n\",\"\\n\",\"Included audits:\\n\",\"- experiment20_full_dataset_image_integrity_audit.json\\n\",\"- experiment20_preprocessing_consistency_audit.json\\n\",\"- experiment20_embedding_quality_completeness_audit.json\\n\",\"- experiment20_corrected_illumination_condition_manifest.json\\n\",\"- experiment20_angular_hemisphere_audit.json\\n\",\"- experiment20_croppedyale_acquisition_record.json\\n\",\"- experiment20_croppedyale_filename_completeness_audit.json\\n\",\"- experiment20_croppedyale_image_integrity_audit.json\\n\",\"- experiment20_common_illumination_condition_audit.json\\n\",\"- experiment20_common_illumination_condition_manifest.json\\n\",\"- experiment20_grouped_illumination_condition_manifest.json\\n\",\"- experiment20_lighting_geometry_grouping_audit.json\\n\",\"- experiment20_yaleb_source_audit.json\\n\",\"- experiment20_yaleb_alternative_source_audit.json\\n\",\"- experiment20_yaleb_torrent_metadata_audit.json\\n\",\"- experiment20_acquisition_environment_audit.json\\n\",\"- experiment20_aria2_installation_audit.json\\n\",\"\\n\",\"No source images or embedding values modified.\\n\",\"No new embeddings generated.\\n\",\"===========================================================================\\n\",\"STEP 2.6.21 FINISHED\\n\",\"===========================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"\\n\",\"## Step 2.7.1 — Descriptive Drift Analysis Protocol Definition\\n\",\"\\n\",\"### Objective\\n\",\"Define and validate the Stage 2 descriptive analysis protocol using the frozen CroppedYale FaceNet embeddings.\\n\",\"\\n\",\"### Reference condition\\n\",\"- Condition: A+000E+00\\n\",\"- Reference identities: 38\\n\",\"- Reference embeddings: one per identity\\n\",\"\\n\",\"### Evaluation cohort\\n\",\"- Common illumination conditions: 57\\n\",\"- Reference condition: 1\\n\",\"- Evaluation conditions: 56\\n\",\"- Evaluation observations: 2,128\\n\",\"- Identity-condition matched observations, not exact source-image pairs.\\n\",\"\\n\",\"### Illumination groups\\n\",\"1. Near-frontal: angular deviation <= 30 degrees.\\n\",\"2. Oblique: angular deviation > 30 and <= 60 degrees.\\n\",\"3. Large angular deviation: angular deviation > 60 degrees.\\n\",\"\\n\",\"The reference condition is excluded from the illumination-effect comparisons.\\n\",\"\\n\",\"### Primary descriptive measurements\\n\",\"1. Euclidean displacement from each identity's reference embedding.\\n\",\"2. Cosine distance from each identity's reference embedding.\\n\",\"3. Group-level displacement distributions.\\n\",\"4. Identity-level displacement variation.\\n\",\"5. Frontal versus beyond-frontal hemisphere comparisons.\\n\",\"\\n\",\"### Statistical approach\\n\",\"- Identity is the repeated-measures unit.\\n\",\"- Illumination conditions are repeated observations within identity.\\n\",\"- Report descriptive distributions, effect sizes and confidence intervals in subsequent analysis.\\n\",\"- Avoid treating all observations as independent identities.\\n\",\"- No calibrated thresholds or operational false-alarm claims.\\n\",\"\\n\",\"### Detector limitations\\n\",\"A separate identity-conditioned covariance detector cannot be estimated from one reference embedding per identity. Global covariance-based Mahalanobis analysis also requires additional dimensionality and stability justification because the reference cohort contains only 38 observations in 512 dimensions.\\n\",\"\\n\",\"### Output\\n\",\"A machine-readable experimental protocol and feasibility audit.\\n\",\"No embeddings are modified and no detector thresholds are calibrated.\\n\"],\"metadata\":{\"id\":\"T7kIBZRIx9NA\"}},{\"cell_type\":\"code\",\"source\":[\"\\n\",\"import os\\n\",\"import json\\n\",\"import hashlib\\n\",\"import numpy as np\\n\",\"\\n\",\"from collections import Counter, defaultdict\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 20 — STEP 2.7.1\\n\",\"# DESCRIPTIVE DRIFT ANALYSIS PROTOCOL DEFINITION\\n\",\"# ============================================================\\n\",\"\\n\",\"BASE = \\\"/content/drive/MyDrive/Experiment_20_Results\\\"\\n\",\"\\n\",\"EMBEDDING_PATH = os.path.join(\\n\",\"    BASE,\\n\",\"    \\\"embeddings\\\",\\n\",\"    \\\"experiment20_croppedyale_facenet_embeddings.npz\\\"\\n\",\")\\n\",\"\\n\",\"AUDIT_DIR = os.path.join(\\n\",\"    BASE,\\n\",\"    \\\"dataset_audit\\\"\\n\",\")\\n\",\"\\n\",\"OUTPUT_DIR = os.path.join(\\n\",\"    BASE,\\n\",\"    \\\"step_2_7\\\"\\n\",\")\\n\",\"\\n\",\"os.makedirs(OUTPUT_DIR, exist_ok=True)\\n\",\"\\n\",\"PROTOCOL_PATH = os.path.join(\\n\",\"    OUTPUT_DIR,\\n\",\"    \\\"experiment20_step27_descriptive_analysis_protocol.json\\\"\\n\",\")\\n\",\"\\n\",\"AUDIT_PATH = os.path.join(\\n\",\"    OUTPUT_DIR,\\n\",\"    \\\"experiment20_step271_protocol_feasibility_audit.json\\\"\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. CONFIGURATION\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"EXPECTED_EMBEDDINGS = 2414\\n\",\"EXPECTED_DIMENSION = 512\\n\",\"EXPECTED_IDENTITIES = 38\\n\",\"EXPECTED_COMMON_CONDITIONS = 57\\n\",\"EXPECTED_EVALUATION_CONDITIONS = 56\\n\",\"EXPECTED_EVALUATION_OBSERVATIONS = 2128\\n\",\"\\n\",\"REFERENCE_CONDITION = \\\"A+000E+00\\\"\\n\",\"\\n\",\"# Previously frozen grouping definitions.\\n\",\"GROUP_THRESHOLDS = {\\n\",\"    \\\"near_frontal\\\": {\\n\",\"        \\\"minimum_degrees\\\": 0.0,\\n\",\"        \\\"maximum_degrees\\\": 30.0,\\n\",\"        \\\"inclusive_maximum\\\": True\\n\",\"    },\\n\",\"    \\\"oblique\\\": {\\n\",\"        \\\"minimum_degrees\\\": 30.0,\\n\",\"        \\\"maximum_degrees\\\": 60.0,\\n\",\"        \\\"inclusive_minimum\\\": False,\\n\",\"        \\\"inclusive_maximum\\\": True\\n\",\"    },\\n\",\"    \\\"large_angular_deviation\\\": {\\n\",\"        \\\"minimum_degrees\\\": 60.0,\\n\",\"        \\\"inclusive_minimum\\\": False\\n\",\"    }\\n\",\"}\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. INPUT VALIDATION\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"STEP 1 — INPUT VALIDATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"assert os.path.isfile(EMBEDDING_PATH), (\\n\",\"    \\\"Frozen embedding archive not found.\\\"\\n\",\")\\n\",\"\\n\",\"with np.load(\\n\",\"    EMBEDDING_PATH,\\n\",\"    allow_pickle=False\\n\",\") as data:\\n\",\"\\n\",\"    embeddings = data[\\\"embeddings\\\"].copy()\\n\",\"    filenames = data[\\\"filenames\\\"].copy()\\n\",\"    subjects = data[\\\"subjects\\\"].copy()\\n\",\"    subject_numbers = data[\\\"subject_numbers\\\"].copy()\\n\",\"    azimuths = data[\\\"azimuths\\\"].copy()\\n\",\"    elevations = data[\\\"elevations\\\"].copy()\\n\",\"    conditions = data[\\\"conditions\\\"].copy()\\n\",\"\\n\",\"print(\\\"Embedding shape:\\\", embeddings.shape)\\n\",\"print(\\\"Embedding dtype:\\\", embeddings.dtype)\\n\",\"\\n\",\"assert embeddings.shape == (\\n\",\"    EXPECTED_EMBEDDINGS,\\n\",\"    EXPECTED_DIMENSION\\n\",\")\\n\",\"\\n\",\"assert len(filenames) == EXPECTED_EMBEDDINGS\\n\",\"assert len(subjects) == EXPECTED_EMBEDDINGS\\n\",\"assert len(conditions) == EXPECTED_EMBEDDINGS\\n\",\"\\n\",\"assert np.isfinite(embeddings).all()\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. VERIFY IDENTITY-CONDITION UNIQUENESS\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 2 — IDENTITY-CONDITION MAPPING\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"identity_condition_records = list(\\n\",\"    zip(\\n\",\"        subjects.tolist(),\\n\",\"        conditions.tolist()\\n\",\"    )\\n\",\")\\n\",\"\\n\",\"identity_condition_counts = Counter(\\n\",\"    identity_condition_records\\n\",\")\\n\",\"\\n\",\"duplicate_identity_condition_records = [\\n\",\"    key\\n\",\"    for key, count in identity_condition_counts.items()\\n\",\"    if count > 1\\n\",\"]\\n\",\"\\n\",\"unique_subjects = sorted(\\n\",\"    set(subjects.tolist())\\n\",\")\\n\",\"\\n\",\"unique_conditions = sorted(\\n\",\"    set(conditions.tolist())\\n\",\")\\n\",\"\\n\",\"print(\\\"Unique identities:\\\", len(unique_subjects))\\n\",\"print(\\\"Unique conditions:\\\", len(unique_conditions))\\n\",\"print(\\n\",\"    \\\"Duplicate identity-condition records:\\\",\\n\",\"    len(duplicate_identity_condition_records)\\n\",\")\\n\",\"\\n\",\"assert len(unique_subjects) == EXPECTED_IDENTITIES\\n\",\"assert len(duplicate_identity_condition_records) == 0\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. IDENTIFY COMMON CONDITIONS\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 3 — COMMON CONDITION RECONSTRUCTION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"condition_subjects = defaultdict(set)\\n\",\"\\n\",\"for subject, condition in identity_condition_records:\\n\",\"    condition_subjects[condition].add(subject)\\n\",\"\\n\",\"common_conditions = sorted([\\n\",\"    condition\\n\",\"    for condition, identity_set in condition_subjects.items()\\n\",\"    if len(identity_set) == EXPECTED_IDENTITIES\\n\",\"])\\n\",\"\\n\",\"print(\\\"Common conditions:\\\", len(common_conditions))\\n\",\"\\n\",\"assert len(common_conditions) == EXPECTED_COMMON_CONDITIONS\\n\",\"\\n\",\"# Verify exactly one observation per identity per common condition.\\n\",\"for condition in common_conditions:\\n\",\"\\n\",\"    for subject in unique_subjects:\\n\",\"\\n\",\"        count = identity_condition_counts[\\n\",\"            (subject, condition)\\n\",\"        ]\\n\",\"\\n\",\"        assert count == 1, (\\n\",\"            f\\\"Expected one observation for {subject}, {condition}; \\\"\\n\",\"            f\\\"found {count}\\\"\\n\",\"        )\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. VERIFY REFERENCE CONDITION\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 4 — REFERENCE CONDITION VALIDATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"assert REFERENCE_CONDITION in common_conditions, (\\n\",\"    \\\"Reference condition is not present in the common cohort.\\\"\\n\",\")\\n\",\"\\n\",\"reference_rows = np.where(\\n\",\"    conditions == REFERENCE_CONDITION\\n\",\")[0]\\n\",\"\\n\",\"reference_subjects = subjects[reference_rows].tolist()\\n\",\"\\n\",\"reference_subject_counts = Counter(\\n\",\"    reference_subjects\\n\",\")\\n\",\"\\n\",\"assert len(reference_rows) == EXPECTED_IDENTITIES\\n\",\"assert len(reference_subject_counts) == EXPECTED_IDENTITIES\\n\",\"assert all(\\n\",\"    count == 1\\n\",\"    for count in reference_subject_counts.values()\\n\",\")\\n\",\"\\n\",\"print(\\\"Reference condition:\\\", REFERENCE_CONDITION)\\n\",\"print(\\\"Reference observations:\\\", len(reference_rows))\\n\",\"print(\\\"Reference identities:\\\", len(reference_subject_counts))\\n\",\"print(\\\"One reference embedding per identity: VERIFIED\\\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. RECONSTRUCT ANGULAR GROUPS\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 5 — ILLUMINATION GROUP VALIDATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"condition_geometry = {}\\n\",\"\\n\",\"for condition in common_conditions:\\n\",\"\\n\",\"    rows = np.where(\\n\",\"        conditions == condition\\n\",\"    )[0]\\n\",\"\\n\",\"    # The same condition must have identical geometry\\n\",\"    # for every identity.\\n\",\"    condition_azimuths = np.unique(\\n\",\"        azimuths[rows]\\n\",\"    )\\n\",\"\\n\",\"    condition_elevations = np.unique(\\n\",\"        elevations[rows]\\n\",\"    )\\n\",\"\\n\",\"    assert len(condition_azimuths) == 1\\n\",\"    assert len(condition_elevations) == 1\\n\",\"\\n\",\"    azimuth = float(condition_azimuths[0])\\n\",\"    elevation = float(condition_elevations[0])\\n\",\"\\n\",\"    # Angular deviation from frontal axis.\\n\",\"    cosine_value = (\\n\",\"        np.cos(np.deg2rad(elevation))\\n\",\"        * np.cos(np.deg2rad(azimuth))\\n\",\"    )\\n\",\"\\n\",\"    cosine_value = np.clip(\\n\",\"        cosine_value,\\n\",\"        -1.0,\\n\",\"        1.0\\n\",\"    )\\n\",\"\\n\",\"    angular_deviation = float(\\n\",\"        np.rad2deg(\\n\",\"            np.arccos(cosine_value)\\n\",\"        )\\n\",\"    )\\n\",\"\\n\",\"    if angular_deviation <= 30.0:\\n\",\"        group = \\\"near_frontal\\\"\\n\",\"\\n\",\"    elif angular_deviation <= 60.0:\\n\",\"        group = \\\"oblique\\\"\\n\",\"\\n\",\"    else:\\n\",\"        group = \\\"large_angular_deviation\\\"\\n\",\"\\n\",\"    hemisphere = (\\n\",\"        \\\"frontal_hemisphere\\\"\\n\",\"        if cosine_value >= 0\\n\",\"        else \\\"beyond_frontal_hemisphere\\\"\\n\",\"    )\\n\",\"\\n\",\"    condition_geometry[condition] = {\\n\",\"        \\\"azimuth\\\": int(azimuth),\\n\",\"        \\\"elevation\\\": int(elevation),\\n\",\"        \\\"angular_deviation_degrees\\\": angular_deviation,\\n\",\"        \\\"group\\\": group,\\n\",\"        \\\"hemisphere\\\": hemisphere\\n\",\"    }\\n\",\"\\n\",\"group_conditions = defaultdict(list)\\n\",\"\\n\",\"for condition, geometry in condition_geometry.items():\\n\",\"\\n\",\"    group_conditions[\\n\",\"        geometry[\\\"group\\\"]\\n\",\"    ].append(condition)\\n\",\"\\n\",\"for group in [\\n\",\"    \\\"near_frontal\\\",\\n\",\"    \\\"oblique\\\",\\n\",\"    \\\"large_angular_deviation\\\"\\n\",\"]:\\n\",\"\\n\",\"    group_conditions[group] = sorted(\\n\",\"        group_conditions[group]\\n\",\"    )\\n\",\"\\n\",\"group_condition_counts = {\\n\",\"    group: len(values)\\n\",\"    for group, values in group_conditions.items()\\n\",\"}\\n\",\"\\n\",\"print(\\\"Illumination condition counts:\\\")\\n\",\"\\n\",\"for group, count in group_condition_counts.items():\\n\",\"    print(group, count)\\n\",\"\\n\",\"assert group_condition_counts == {\\n\",\"    \\\"near_frontal\\\": 18,\\n\",\"    \\\"oblique\\\": 11,\\n\",\"    \\\"large_angular_deviation\\\": 28\\n\",\"}\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. DEFINE EVALUATION COHORT\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 6 — EVALUATION COHORT DEFINITION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"evaluation_conditions = sorted(\\n\",\"    set(common_conditions) - {REFERENCE_CONDITION}\\n\",\")\\n\",\"\\n\",\"assert len(evaluation_conditions) == EXPECTED_EVALUATION_CONDITIONS\\n\",\"\\n\",\"evaluation_rows = np.where(\\n\",\"    np.isin(conditions, evaluation_conditions)\\n\",\")[0]\\n\",\"\\n\",\"assert len(evaluation_rows) == EXPECTED_EVALUATION_OBSERVATIONS\\n\",\"\\n\",\"evaluation_group_counts = {}\\n\",\"\\n\",\"for group, group_condition_list in group_conditions.items():\\n\",\"\\n\",\"    non_reference_conditions = [\\n\",\"        condition\\n\",\"        for condition in group_condition_list\\n\",\"        if condition != REFERENCE_CONDITION\\n\",\"    ]\\n\",\"\\n\",\"    observation_count = (\\n\",\"        len(non_reference_conditions)\\n\",\"        * EXPECTED_IDENTITIES\\n\",\"    )\\n\",\"\\n\",\"    evaluation_group_counts[group] = {\\n\",\"        \\\"conditions\\\": len(non_reference_conditions),\\n\",\"        \\\"observations\\\": observation_count\\n\",\"    }\\n\",\"\\n\",\"print(\\\"Reference observations:\\\", len(reference_rows))\\n\",\"print(\\\"Evaluation conditions:\\\", len(evaluation_conditions))\\n\",\"print(\\\"Evaluation observations:\\\", len(evaluation_rows))\\n\",\"\\n\",\"print(\\\"\\\\nEvaluation group breakdown:\\\")\\n\",\"\\n\",\"for group, values in evaluation_group_counts.items():\\n\",\"\\n\",\"    print(\\n\",\"        group,\\n\",\"        \\\"| Conditions:\\\",\\n\",\"        values[\\\"conditions\\\"],\\n\",\"        \\\"| Observations:\\\",\\n\",\"        values[\\\"observations\\\"]\\n\",\"    )\\n\",\"\\n\",\"assert sum(\\n\",\"    item[\\\"observations\\\"]\\n\",\"    for item in evaluation_group_counts.values()\\n\",\") == EXPECTED_EVALUATION_OBSERVATIONS\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 8. VERIFY HEMISPHERE COVERAGE\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 7 — HEMISPHERE COVERAGE\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"hemisphere_counts = Counter(\\n\",\"    geometry[\\\"hemisphere\\\"]\\n\",\"    for geometry in condition_geometry.values()\\n\",\")\\n\",\"\\n\",\"print(\\\"Common-condition hemisphere counts:\\\")\\n\",\"\\n\",\"for hemisphere, count in hemisphere_counts.items():\\n\",\"    print(hemisphere, count)\\n\",\"\\n\",\"assert hemisphere_counts == {\\n\",\"    \\\"frontal_hemisphere\\\": 46,\\n\",\"    \\\"beyond_frontal_hemisphere\\\": 11\\n\",\"}\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 9. STATISTICAL FEASIBILITY DECISIONS\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 8 — STATISTICAL FEASIBILITY\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"statistical_decisions = {\\n\",\"    \\\"within_identity_euclidean_displacement\\\": {\\n\",\"        \\\"status\\\": \\\"SUPPORTED\\\",\\n\",\"        \\\"reason\\\": (\\n\",\"            \\\"Each identity has one reference embedding and \\\"\\n\",\"            \\\"one embedding for each common illumination condition.\\\"\\n\",\"        )\\n\",\"    },\\n\",\"\\n\",\"    \\\"within_identity_cosine_distance\\\": {\\n\",\"        \\\"status\\\": \\\"SUPPORTED\\\",\\n\",\"        \\\"reason\\\": (\\n\",\"            \\\"Cosine distance can be computed between each \\\"\\n\",\"            \\\"identity's reference and evaluation embeddings.\\\"\\n\",\"        )\\n\",\"    },\\n\",\"\\n\",\"    \\\"identity_level_repeated_measures\\\": {\\n\",\"        \\\"status\\\": \\\"SUPPORTED\\\",\\n\",\"        \\\"reason\\\": (\\n\",\"            \\\"The same 38 identities are observed across \\\"\\n\",\"            \\\"the 56 evaluation conditions.\\\"\\n\",\"        )\\n\",\"    },\\n\",\"\\n\",\"    \\\"identity_conditioned_covariance_detector\\\": {\\n\",\"        \\\"status\\\": \\\"NOT_SUPPORTED_WITH_CURRENT_REFERENCE\\\",\\n\",\"        \\\"reason\\\": (\\n\",\"            \\\"Only one reference embedding per identity is available. \\\"\\n\",\"            \\\"An individual within-identity covariance matrix cannot \\\"\\n\",\"            \\\"be estimated from one observation.\\\"\\n\",\"        )\\n\",\"    },\\n\",\"\\n\",\"    \\\"global_mahalanobis_detector\\\": {\\n\",\"        \\\"status\\\": \\\"REQUIRES_SEPARATE_JUSTIFICATION\\\",\\n\",\"        \\\"reason\\\": (\\n\",\"            \\\"The reference cohort contains 38 observations \\\"\\n\",\"            \\\"in 512 dimensions. The empirical covariance matrix \\\"\\n\",\"            \\\"cannot be full rank without regularisation or \\\"\\n\",\"            \\\"dimension reduction.\\\"\\n\",\"        )\\n\",\"    },\\n\",\"\\n\",\"    \\\"operational_false_alarm_rate\\\": {\\n\",\"        \\\"status\\\": \\\"NOT_SUPPORTED\\\",\\n\",\"        \\\"reason\\\": (\\n\",\"            \\\"The current design does not provide an independent \\\"\\n\",\"            \\\"unchanged-control sequence for operational false-alarm \\\"\\n\",\"            \\\"estimation.\\\"\\n\",\"        )\\n\",\"    },\\n\",\"\\n\",\"    \\\"calibrated_detection_thresholds\\\": {\\n\",\"        \\\"status\\\": \\\"NOT_USED\\\",\\n\",\"        \\\"reason\\\": (\\n\",\"            \\\"The selected primary analysis is descriptive.\\\"\\n\",\"        )\\n\",\"    }\\n\",\"}\\n\",\"\\n\",\"for name, result in statistical_decisions.items():\\n\",\"    print(name, \\\":\\\", result[\\\"status\\\"])\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 10. DEFINE PROTOCOL\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"protocol = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"step\\\": \\\"2.7.1\\\",\\n\",\"    \\\"title\\\": (\\n\",\"        \\\"Descriptive Analysis of Within-Identity FaceNet \\\"\\n\",\"        \\\"Embedding Drift Under Controlled Illumination Conditions\\\"\\n\",\"    ),\\n\",\"\\n\",\"    \\\"protocol_status\\\": \\\"DEFINED\\\",\\n\",\"    \\\"analysis_type\\\": \\\"descriptive_drift_analysis\\\",\\n\",\"\\n\",\"    \\\"dataset\\\": {\\n\",\"        \\\"name\\\": \\\"Cropped Extended Yale B\\\",\\n\",\"        \\\"embedding_archive\\\": EMBEDDING_PATH,\\n\",\"        \\\"identities\\\": EXPECTED_IDENTITIES,\\n\",\"        \\\"embedding_dimension\\\": EXPECTED_DIMENSION,\\n\",\"        \\\"total_embedding_rows\\\": EXPECTED_EMBEDDINGS,\\n\",\"        \\\"common_conditions\\\": EXPECTED_COMMON_CONDITIONS,\\n\",\"        \\\"reference_condition\\\": REFERENCE_CONDITION,\\n\",\"        \\\"reference_observations\\\": len(reference_rows),\\n\",\"        \\\"evaluation_conditions\\\": len(evaluation_conditions),\\n\",\"        \\\"evaluation_observations\\\": len(evaluation_rows)\\n\",\"    },\\n\",\"\\n\",\"    \\\"unit_of_analysis\\\": {\\n\",\"        \\\"primary\\\": \\\"identity-condition observation\\\",\\n\",\"        \\\"repeated_measures_unit\\\": \\\"identity\\\",\\n\",\"        \\\"condition_unit\\\": \\\"illumination condition\\\",\\n\",\"        \\\"pairing_description\\\": (\\n\",\"            \\\"Identity-condition matched repeated captures; \\\"\\n\",\"            \\\"not exact source-image pairs.\\\"\\n\",\"        )\\n\",\"    },\\n\",\"\\n\",\"    \\\"illumination_groups\\\": {\\n\",\"        group: {\\n\",\"            \\\"conditions\\\": values,\\n\",\"            \\\"condition_count\\\": len(values),\\n\",\"            \\\"evaluation_condition_count\\\": len([\\n\",\"                condition\\n\",\"                for condition in values\\n\",\"                if condition != REFERENCE_CONDITION\\n\",\"            ]),\\n\",\"            \\\"evaluation_observation_count\\\": (\\n\",\"                evaluation_group_counts[group][\\\"observations\\\"]\\n\",\"            )\\n\",\"        }\\n\",\"        for group, values in group_conditions.items()\\n\",\"    },\\n\",\"\\n\",\"    \\\"condition_geometry\\\": condition_geometry,\\n\",\"\\n\",\"    \\\"hemisphere_counts\\\": dict(hemisphere_counts),\\n\",\"\\n\",\"    \\\"primary_metrics\\\": [\\n\",\"        \\\"Euclidean displacement from identity reference embedding\\\",\\n\",\"        \\\"Cosine distance from identity reference embedding\\\",\\n\",\"        \\\"Group-level displacement distributions\\\",\\n\",\"        \\\"Identity-level displacement variation\\\"\\n\",\"    ],\\n\",\"\\n\",\"    \\\"secondary_analysis\\\": [\\n\",\"        \\\"Frontal versus beyond-frontal hemisphere comparisons\\\"\\n\",\"    ],\\n\",\"\\n\",\"    \\\"statistical_plan\\\": {\\n\",\"        \\\"report_identity_level_variation\\\": True,\\n\",\"        \\\"avoid_pseudoreplication\\\": True,\\n\",\"        \\\"report_effect_sizes\\\": True,\\n\",\"        \\\"report_confidence_intervals\\\": True,\\n\",\"        \\\"multiple_comparison_correction\\\": True,\\n\",\"        \\\"operational_false_alarm_claims\\\": False,\\n\",\"        \\\"calibrated_thresholds\\\": False\\n\",\"    },\\n\",\"\\n\",\"    \\\"detector_feasibility\\\": statistical_decisions,\\n\",\"\\n\",\"    \\\"preprocessing\\\": {\\n\",\"        \\\"grayscale_to_rgb\\\": True,\\n\",\"        \\\"resize\\\": [160, 160],\\n\",\"        \\\"tensor_conversion\\\": \\\"ToTensor\\\",\\n\",\"        \\\"face_detection\\\": False,\\n\",\"        \\\"face_alignment\\\": False\\n\",\"    },\\n\",\"\\n\",\"    \\\"limitations\\\": [\\n\",\"        \\\"The dataset contains different captures across illumination conditions.\\\",\\n\",\"        \\\"The observations are not exact source-image perturbation pairs.\\\",\\n\",\"        \\\"There is only one reference embedding per identity.\\\",\\n\",\"        \\\"Identity-conditioned covariance cannot be estimated from the current reference cohort.\\\",\\n\",\"        \\\"Global covariance-based Mahalanobis analysis requires separate justification.\\\",\\n\",\"        \\\"Descriptive displacement does not establish recognition accuracy.\\\",\\n\",\"        \\\"Descriptive analysis does not establish operational false-alarm control.\\\"\\n\",\"    ]\\n\",\"}\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 11. FINAL FEASIBILITY AUDIT\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"audit_checks = {\\n\",\"    \\\"correct_embedding_shape\\\": (\\n\",\"        embeddings.shape == (2414, 512)\\n\",\"    ),\\n\",\"    \\\"all_embeddings_finite\\\": bool(\\n\",\"        np.isfinite(embeddings).all()\\n\",\"    ),\\n\",\"    \\\"38_unique_identities\\\": (\\n\",\"        len(unique_subjects) == 38\\n\",\"    ),\\n\",\"    \\\"57_common_conditions\\\": (\\n\",\"        len(common_conditions) == 57\\n\",\"    ),\\n\",\"    \\\"reference_condition_present\\\": (\\n\",\"        REFERENCE_CONDITION in common_conditions\\n\",\"    ),\\n\",\"    \\\"one_reference_per_identity\\\": (\\n\",\"        len(reference_rows) == 38\\n\",\"    ),\\n\",\"    \\\"56_evaluation_conditions\\\": (\\n\",\"        len(evaluation_conditions) == 56\\n\",\"    ),\\n\",\"    \\\"2128_evaluation_observations\\\": (\\n\",\"        len(evaluation_rows) == 2128\\n\",\"    ),\\n\",\"    \\\"illumination_group_counts_valid\\\": (\\n\",\"        group_condition_counts == {\\n\",\"            \\\"near_frontal\\\": 18,\\n\",\"            \\\"oblique\\\": 11,\\n\",\"            \\\"large_angular_deviation\\\": 28\\n\",\"        }\\n\",\"    ),\\n\",\"    \\\"hemisphere_counts_valid\\\": (\\n\",\"        dict(hemisphere_counts) == {\\n\",\"            \\\"frontal_hemisphere\\\": 46,\\n\",\"            \\\"beyond_frontal_hemisphere\\\": 11\\n\",\"        }\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"audit_passed = all(audit_checks.values())\\n\",\"\\n\",\"audit_report = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"step\\\": \\\"2.7.1\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(\\n\",\"        timezone.utc\\n\",\"    ).isoformat(),\\n\",\"\\n\",\"    \\\"audit_checks\\\": audit_checks,\\n\",\"    \\\"audit_status\\\": (\\n\",\"        \\\"PASSED\\\" if audit_passed else \\\"FAILED\\\"\\n\",\"    ),\\n\",\"\\n\",\"    \\\"reference_condition\\\": REFERENCE_CONDITION,\\n\",\"    \\\"reference_observations\\\": len(reference_rows),\\n\",\"    \\\"evaluation_conditions\\\": len(evaluation_conditions),\\n\",\"    \\\"evaluation_observations\\\": len(evaluation_rows),\\n\",\"\\n\",\"    \\\"group_condition_counts\\\": group_condition_counts,\\n\",\"    \\\"evaluation_group_counts\\\": evaluation_group_counts,\\n\",\"    \\\"hemisphere_counts\\\": dict(hemisphere_counts),\\n\",\"\\n\",\"    \\\"statistical_feasibility\\\": statistical_decisions\\n\",\"}\\n\",\"\\n\",\"with open(\\n\",\"    PROTOCOL_PATH,\\n\",\"    \\\"w\\\",\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\") as f:\\n\",\"    json.dump(protocol, f, indent=2)\\n\",\"\\n\",\"with open(\\n\",\"    AUDIT_PATH,\\n\",\"    \\\"w\\\",\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\") as f:\\n\",\"    json.dump(audit_report, f, indent=2)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 12. FINAL OUTPUT\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 2.7.1 — FINAL RESULT\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"for name, passed in audit_checks.items():\\n\",\"    print(\\n\",\"        name,\\n\",\"        \\\":\\\",\\n\",\"        \\\"PASS\\\" if passed else \\\"FAIL\\\"\\n\",\"    )\\n\",\"\\n\",\"print(\\\"\\\\nProtocol feasibility audit:\\\",\\n\",\"      \\\"PASSED\\\" if audit_passed else \\\"FAILED\\\")\\n\",\"\\n\",\"print(\\\"Protocol saved:\\\", PROTOCOL_PATH)\\n\",\"print(\\\"Audit saved:\\\", AUDIT_PATH)\\n\",\"\\n\",\"print(\\\"\\\\nReference observations:\\\", len(reference_rows))\\n\",\"print(\\\"Evaluation observations:\\\", len(evaluation_rows))\\n\",\"\\n\",\"print(\\\"\\\\nNo embeddings modified.\\\")\\n\",\"print(\\\"No detector thresholds calibrated.\\\")\\n\",\"print(\\\"No detector performance claims generated.\\\")\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"STEP 2.7.1 FINISHED\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"assert audit_passed, (\\n\",\"    \\\"Protocol feasibility audit failed. \\\"\\n\",\"    \\\"Do not proceed until the issue is resolved.\\\"\\n\",\")\\n\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"QdcWIwlIyMau\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794353189972,\"user_tz\":360,\"elapsed\":415,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"54a68a86-347a-4ebd-a1b0-eee8651bb046\"},\"execution_count\":null,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"===========================================================================\\n\",\"STEP 1 — INPUT VALIDATION\\n\",\"===========================================================================\\n\",\"Embedding shape: (2414, 512)\\n\",\"Embedding dtype: float32\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 2 — IDENTITY-CONDITION MAPPING\\n\",\"===========================================================================\\n\",\"Unique identities: 38\\n\",\"Unique conditions: 64\\n\",\"Duplicate identity-condition records: 0\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 3 — COMMON CONDITION RECONSTRUCTION\\n\",\"===========================================================================\\n\",\"Common conditions: 57\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 4 — REFERENCE CONDITION VALIDATION\\n\",\"===========================================================================\\n\",\"Reference condition: A+000E+00\\n\",\"Reference observations: 38\\n\",\"Reference identities: 38\\n\",\"One reference embedding per identity: VERIFIED\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 5 — ILLUMINATION GROUP VALIDATION\\n\",\"===========================================================================\\n\",\"Illumination condition counts:\\n\",\"near_frontal 18\\n\",\"oblique 11\\n\",\"large_angular_deviation 28\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 6 — EVALUATION COHORT DEFINITION\\n\",\"===========================================================================\\n\",\"Reference observations: 38\\n\",\"Evaluation conditions: 56\\n\",\"Evaluation observations: 2128\\n\",\"\\n\",\"Evaluation group breakdown:\\n\",\"near_frontal | Conditions: 17 | Observations: 646\\n\",\"oblique | Conditions: 11 | Observations: 418\\n\",\"large_angular_deviation | Conditions: 28 | Observations: 1064\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 7 — HEMISPHERE COVERAGE\\n\",\"===========================================================================\\n\",\"Common-condition hemisphere counts:\\n\",\"frontal_hemisphere 46\\n\",\"beyond_frontal_hemisphere 11\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 8 — STATISTICAL FEASIBILITY\\n\",\"===========================================================================\\n\",\"within_identity_euclidean_displacement : SUPPORTED\\n\",\"within_identity_cosine_distance : SUPPORTED\\n\",\"identity_level_repeated_measures : SUPPORTED\\n\",\"identity_conditioned_covariance_detector : NOT_SUPPORTED_WITH_CURRENT_REFERENCE\\n\",\"global_mahalanobis_detector : REQUIRES_SEPARATE_JUSTIFICATION\\n\",\"operational_false_alarm_rate : NOT_SUPPORTED\\n\",\"calibrated_detection_thresholds : NOT_USED\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 2.7.1 — FINAL RESULT\\n\",\"===========================================================================\\n\",\"correct_embedding_shape : PASS\\n\",\"all_embeddings_finite : PASS\\n\",\"38_unique_identities : PASS\\n\",\"57_common_conditions : PASS\\n\",\"reference_condition_present : PASS\\n\",\"one_reference_per_identity : PASS\\n\",\"56_evaluation_conditions : PASS\\n\",\"2128_evaluation_observations : PASS\\n\",\"illumination_group_counts_valid : PASS\\n\",\"hemisphere_counts_valid : PASS\\n\",\"\\n\",\"Protocol feasibility audit: PASSED\\n\",\"Protocol saved: /content/drive/MyDrive/Experiment_20_Results/step_2_7/experiment20_step27_descriptive_analysis_protocol.json\\n\",\"Audit saved: /content/drive/MyDrive/Experiment_20_Results/step_2_7/experiment20_step271_protocol_feasibility_audit.json\\n\",\"\\n\",\"Reference observations: 38\\n\",\"Evaluation observations: 2128\\n\",\"\\n\",\"No embeddings modified.\\n\",\"No detector thresholds calibrated.\\n\",\"No detector performance claims generated.\\n\",\"===========================================================================\\n\",\"STEP 2.7.1 FINISHED\\n\",\"===========================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"\\n\",\"## Step 2.7.2 — Reference-to-Evaluation Embedding Displacement\\n\",\"\\n\",\"### Objective\\n\",\"Calculate within-identity embedding displacement between the frozen frontal reference condition and each non-reference common illumination condition.\\n\",\"\\n\",\"### Reference\\n\",\"- Condition: A+000E+00\\n\",\"- One reference embedding per identity.\\n\",\"- Total reference embeddings: 38.\\n\",\"\\n\",\"### Evaluation\\n\",\"- Common non-reference illumination conditions: 56.\\n\",\"- Identities: 38.\\n\",\"- Expected evaluation records: 2,128.\\n\",\"\\n\",\"### Metrics\\n\",\"\\n\",\"1. Euclidean displacement:\\n\",\"\\n\",\"   ||z_evaluation - z_reference||₂\\n\",\"\\n\",\"2. Cosine distance:\\n\",\"\\n\",\"   1 - cosine_similarity(z_reference, z_evaluation)\\n\",\"\\n\",\"### Data integrity requirements\\n\",\"- Match reference and evaluation embeddings by identity.\\n\",\"- Exclude the reference condition from evaluation.\\n\",\"- Preserve illumination condition metadata.\\n\",\"- Verify finite displacement values.\\n\",\"- Verify cosine distances are within their mathematically valid range, allowing numerical tolerance.\\n\",\"- Verify exactly 2,128 unique identity-condition records.\\n\",\"\\n\",\"### Output\\n\",\"- Reference-to-evaluation displacement CSV.\\n\",\"- Displacement calculation audit JSON.\\n\",\"- SHA256 checksums.\\n\",\"\\n\",\"No thresholds are calibrated. No statistical significance or operational detection performance is claimed.\\n\"],\"metadata\":{\"id\":\"p0ZBYU9NyaLe\"}},{\"cell_type\":\"code\",\"source\":[\"\\n\",\"import os\\n\",\"import json\\n\",\"import hashlib\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 20 — STEP 2.7.2\\n\",\"# CORRECTED REFERENCE-TO-EVALUATION DISPLACEMENT ANALYSIS\\n\",\"# ============================================================\\n\",\"\\n\",\"BASE = \\\"/content/drive/MyDrive/Experiment_20_Results\\\"\\n\",\"\\n\",\"EMBEDDING_PATH = os.path.join(\\n\",\"    BASE,\\n\",\"    \\\"embeddings\\\",\\n\",\"    \\\"experiment20_croppedyale_facenet_embeddings.npz\\\"\\n\",\")\\n\",\"\\n\",\"PROTOCOL_PATH = os.path.join(\\n\",\"    BASE,\\n\",\"    \\\"step_2_7\\\",\\n\",\"    \\\"experiment20_step27_descriptive_analysis_protocol.json\\\"\\n\",\")\\n\",\"\\n\",\"OUTPUT_DIR = os.path.join(\\n\",\"    BASE,\\n\",\"    \\\"step_2_7\\\",\\n\",\"    \\\"displacement_analysis\\\"\\n\",\")\\n\",\"\\n\",\"os.makedirs(OUTPUT_DIR, exist_ok=True)\\n\",\"\\n\",\"CSV_PATH = os.path.join(\\n\",\"    OUTPUT_DIR,\\n\",\"    \\\"experiment20_reference_evaluation_displacement.csv\\\"\\n\",\")\\n\",\"\\n\",\"AUDIT_PATH = os.path.join(\\n\",\"    OUTPUT_DIR,\\n\",\"    \\\"experiment20_step272_displacement_audit.json\\\"\\n\",\")\\n\",\"\\n\",\"REFERENCE_CONDITION = \\\"A+000E+00\\\"\\n\",\"\\n\",\"EXPECTED_IDENTITIES = 38\\n\",\"EXPECTED_COMMON_CONDITIONS = 57\\n\",\"EXPECTED_EVALUATION_CONDITIONS = 56\\n\",\"EXPECTED_EVALUATION_RECORDS = 2128\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. LOAD FROZEN INPUTS\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"STEP 1 — LOAD FROZEN INPUTS\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"assert os.path.isfile(EMBEDDING_PATH), (\\n\",\"    \\\"Frozen embedding archive not found.\\\"\\n\",\")\\n\",\"\\n\",\"assert os.path.isfile(PROTOCOL_PATH), (\\n\",\"    \\\"Step 2.7.1 protocol not found.\\\"\\n\",\")\\n\",\"\\n\",\"with open(\\n\",\"    PROTOCOL_PATH,\\n\",\"    \\\"r\\\",\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\") as f:\\n\",\"    protocol = json.load(f)\\n\",\"\\n\",\"assert protocol[\\\"protocol_status\\\"] == \\\"DEFINED\\\"\\n\",\"assert protocol[\\\"analysis_type\\\"] == \\\"descriptive_drift_analysis\\\"\\n\",\"\\n\",\"with np.load(\\n\",\"    EMBEDDING_PATH,\\n\",\"    allow_pickle=False\\n\",\") as data:\\n\",\"\\n\",\"    embeddings = data[\\\"embeddings\\\"].copy()\\n\",\"    filenames = data[\\\"filenames\\\"].copy()\\n\",\"    subjects = data[\\\"subjects\\\"].copy()\\n\",\"    conditions = data[\\\"conditions\\\"].copy()\\n\",\"\\n\",\"print(\\\"Embedding shape:\\\", embeddings.shape)\\n\",\"print(\\\"Reference condition:\\\", REFERENCE_CONDITION)\\n\",\"\\n\",\"assert embeddings.shape == (2414, 512)\\n\",\"assert np.isfinite(embeddings).all()\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. LOAD VERIFIED COMMON CONDITIONS FROM PROTOCOL\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 2 — VERIFIED COMMON CONDITION SELECTION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"# IMPORTANT:\\n\",\"# Do not derive evaluation conditions from every archive condition.\\n\",\"# Use only the 57 common conditions frozen in Step 2.7.1.\\n\",\"\\n\",\"condition_geometry = protocol[\\\"condition_geometry\\\"]\\n\",\"\\n\",\"common_conditions = sorted(\\n\",\"    condition_geometry.keys()\\n\",\")\\n\",\"\\n\",\"assert len(common_conditions) == EXPECTED_COMMON_CONDITIONS\\n\",\"\\n\",\"assert REFERENCE_CONDITION in common_conditions\\n\",\"\\n\",\"evaluation_conditions = sorted(\\n\",\"    set(common_conditions) - {REFERENCE_CONDITION}\\n\",\")\\n\",\"\\n\",\"assert len(evaluation_conditions) == EXPECTED_EVALUATION_CONDITIONS\\n\",\"\\n\",\"print(\\\"Verified common conditions:\\\", len(common_conditions))\\n\",\"print(\\\"Reference condition:\\\", REFERENCE_CONDITION)\\n\",\"print(\\\"Evaluation conditions:\\\", len(evaluation_conditions))\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. BUILD REFERENCE EMBEDDING LOOKUP\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 3 — REFERENCE EMBEDDING LOOKUP\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"reference_rows = np.where(\\n\",\"    conditions == REFERENCE_CONDITION\\n\",\")[0]\\n\",\"\\n\",\"assert len(reference_rows) == EXPECTED_IDENTITIES\\n\",\"\\n\",\"reference_lookup = {}\\n\",\"reference_filename_lookup = {}\\n\",\"\\n\",\"for row in reference_rows:\\n\",\"\\n\",\"    subject = str(subjects[row])\\n\",\"\\n\",\"    assert subject not in reference_lookup, (\\n\",\"        f\\\"Duplicate reference embedding for {subject}\\\"\\n\",\"    )\\n\",\"\\n\",\"    reference_lookup[subject] = embeddings[row].astype(\\n\",\"        np.float64\\n\",\"    )\\n\",\"\\n\",\"    reference_filename_lookup[subject] = str(\\n\",\"        filenames[row]\\n\",\"    )\\n\",\"\\n\",\"assert len(reference_lookup) == EXPECTED_IDENTITIES\\n\",\"\\n\",\"print(\\\"Reference embeddings:\\\", len(reference_lookup))\\n\",\"print(\\\"Reference identities:\\\", len(reference_filename_lookup))\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. SELECT ONLY COMMON-COHORT EVALUATION ROWS\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 4 — EVALUATION COHORT FILTERING\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"evaluation_rows = np.where(\\n\",\"    np.isin(\\n\",\"        conditions,\\n\",\"        evaluation_conditions\\n\",\"    )\\n\",\")[0]\\n\",\"\\n\",\"print(\\\"Evaluation rows:\\\", len(evaluation_rows))\\n\",\"\\n\",\"assert len(evaluation_rows) == EXPECTED_EVALUATION_RECORDS, (\\n\",\"    f\\\"Expected {EXPECTED_EVALUATION_RECORDS} rows, \\\"\\n\",\"    f\\\"found {len(evaluation_rows)}\\\"\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. CALCULATE EUCLIDEAN AND COSINE DISPLACEMENT\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 5 — DISPLACEMENT CALCULATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"records = []\\n\",\"\\n\",\"for row in evaluation_rows:\\n\",\"\\n\",\"    subject = str(subjects[row])\\n\",\"    condition = str(conditions[row])\\n\",\"\\n\",\"    assert subject in reference_lookup\\n\",\"    assert condition in condition_geometry\\n\",\"\\n\",\"    reference_vector = reference_lookup[subject]\\n\",\"\\n\",\"    evaluation_vector = embeddings[row].astype(\\n\",\"        np.float64\\n\",\"    )\\n\",\"\\n\",\"    difference = (\\n\",\"        evaluation_vector - reference_vector\\n\",\"    )\\n\",\"\\n\",\"    euclidean_displacement = float(\\n\",\"        np.linalg.norm(difference, ord=2)\\n\",\"    )\\n\",\"\\n\",\"    reference_norm = float(\\n\",\"        np.linalg.norm(reference_vector)\\n\",\"    )\\n\",\"\\n\",\"    evaluation_norm = float(\\n\",\"        np.linalg.norm(evaluation_vector)\\n\",\"    )\\n\",\"\\n\",\"    assert reference_norm > 0\\n\",\"    assert evaluation_norm > 0\\n\",\"\\n\",\"    cosine_similarity = float(\\n\",\"        np.dot(\\n\",\"            reference_vector,\\n\",\"            evaluation_vector\\n\",\"        ) / (\\n\",\"            reference_norm * evaluation_norm\\n\",\"        )\\n\",\"    )\\n\",\"\\n\",\"    cosine_similarity = float(\\n\",\"        np.clip(\\n\",\"            cosine_similarity,\\n\",\"            -1.0,\\n\",\"            1.0\\n\",\"        )\\n\",\"    )\\n\",\"\\n\",\"    cosine_distance = float(\\n\",\"        1.0 - cosine_similarity\\n\",\"    )\\n\",\"\\n\",\"    geometry = condition_geometry[condition]\\n\",\"\\n\",\"    records.append({\\n\",\"\\n\",\"        \\\"subject\\\": subject,\\n\",\"\\n\",\"        \\\"reference_condition\\\": REFERENCE_CONDITION,\\n\",\"\\n\",\"        \\\"evaluation_condition\\\": condition,\\n\",\"\\n\",\"        \\\"reference_filename\\\": (\\n\",\"            reference_filename_lookup[subject]\\n\",\"        ),\\n\",\"\\n\",\"        \\\"evaluation_filename\\\": str(\\n\",\"            filenames[row]\\n\",\"        ),\\n\",\"\\n\",\"        \\\"azimuth_degrees\\\": geometry[\\\"azimuth\\\"],\\n\",\"\\n\",\"        \\\"elevation_degrees\\\": geometry[\\\"elevation\\\"],\\n\",\"\\n\",\"        \\\"angular_deviation_degrees\\\": (\\n\",\"            geometry[\\\"angular_deviation_degrees\\\"]\\n\",\"        ),\\n\",\"\\n\",\"        \\\"illumination_group\\\": geometry[\\\"group\\\"],\\n\",\"\\n\",\"        \\\"hemisphere\\\": geometry[\\\"hemisphere\\\"],\\n\",\"\\n\",\"        \\\"euclidean_displacement\\\": (\\n\",\"            euclidean_displacement\\n\",\"        ),\\n\",\"\\n\",\"        \\\"cosine_similarity\\\": cosine_similarity,\\n\",\"\\n\",\"        \\\"cosine_distance\\\": cosine_distance\\n\",\"    })\\n\",\"\\n\",\"df = pd.DataFrame(records)\\n\",\"\\n\",\"print(\\\"Displacement records:\\\", len(df))\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. DATA INTEGRITY VALIDATION\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 6 — DATA INTEGRITY VALIDATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"assert len(df) == EXPECTED_EVALUATION_RECORDS\\n\",\"\\n\",\"assert df[\\\"subject\\\"].nunique() == EXPECTED_IDENTITIES\\n\",\"\\n\",\"assert (\\n\",\"    df[\\\"evaluation_condition\\\"].nunique()\\n\",\"    == EXPECTED_EVALUATION_CONDITIONS\\n\",\")\\n\",\"\\n\",\"assert not df.duplicated(\\n\",\"    subset=[\\\"subject\\\", \\\"evaluation_condition\\\"]\\n\",\").any()\\n\",\"\\n\",\"assert np.isfinite(\\n\",\"    df[\\\"euclidean_displacement\\\"].to_numpy()\\n\",\").all()\\n\",\"\\n\",\"assert np.isfinite(\\n\",\"    df[\\\"cosine_similarity\\\"].to_numpy()\\n\",\").all()\\n\",\"\\n\",\"assert np.isfinite(\\n\",\"    df[\\\"cosine_distance\\\"].to_numpy()\\n\",\").all()\\n\",\"\\n\",\"assert (\\n\",\"    df[\\\"euclidean_displacement\\\"] >= 0\\n\",\").all()\\n\",\"\\n\",\"assert (\\n\",\"    df[\\\"cosine_distance\\\"] >= -1e-12\\n\",\").all()\\n\",\"\\n\",\"assert (\\n\",\"    df[\\\"cosine_distance\\\"] <= 2.0 + 1e-12\\n\",\").all()\\n\",\"\\n\",\"assert (\\n\",\"    df[\\\"reference_condition\\\"] == REFERENCE_CONDITION\\n\",\").all()\\n\",\"\\n\",\"assert not (\\n\",\"    df[\\\"evaluation_condition\\\"] == REFERENCE_CONDITION\\n\",\").any()\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. ILLUMINATION GROUP COUNTS\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 7 — ILLUMINATION GROUP COUNTS\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"group_summary = (\\n\",\"    df.groupby(\\\"illumination_group\\\")\\n\",\"    .agg(\\n\",\"        observations=(\\\"subject\\\", \\\"size\\\"),\\n\",\"        identities=(\\\"subject\\\", \\\"nunique\\\"),\\n\",\"        conditions=(\\\"evaluation_condition\\\", \\\"nunique\\\")\\n\",\"    )\\n\",\"    .reset_index()\\n\",\")\\n\",\"\\n\",\"print(group_summary.to_string(index=False))\\n\",\"\\n\",\"expected_group_counts = {\\n\",\"    \\\"near_frontal\\\": 646,\\n\",\"    \\\"oblique\\\": 418,\\n\",\"    \\\"large_angular_deviation\\\": 1064\\n\",\"}\\n\",\"\\n\",\"actual_group_counts = dict(\\n\",\"    zip(\\n\",\"        group_summary[\\\"illumination_group\\\"],\\n\",\"        group_summary[\\\"observations\\\"]\\n\",\"    )\\n\",\")\\n\",\"\\n\",\"assert actual_group_counts == expected_group_counts\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 8. SAVE DISPLACEMENT CSV\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 8 — SAVE DISPLACEMENT DATA\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"df.to_csv(\\n\",\"    CSV_PATH,\\n\",\"    index=False,\\n\",\"    float_format=\\\"%.12g\\\"\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 9. CHECKSUM\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"def sha256_file(path):\\n\",\"\\n\",\"    digest = hashlib.sha256()\\n\",\"\\n\",\"    with open(path, \\\"rb\\\") as f:\\n\",\"\\n\",\"        for chunk in iter(\\n\",\"            lambda: f.read(1024 * 1024),\\n\",\"            b\\\"\\\"\\n\",\"        ):\\n\",\"            digest.update(chunk)\\n\",\"\\n\",\"    return digest.hexdigest()\\n\",\"\\n\",\"\\n\",\"csv_sha256 = sha256_file(CSV_PATH)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 10. DISPLACEMENT SUMMARY\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"displacement_summary = {\\n\",\"\\n\",\"    \\\"euclidean_min\\\": float(\\n\",\"        df[\\\"euclidean_displacement\\\"].min()\\n\",\"    ),\\n\",\"\\n\",\"    \\\"euclidean_max\\\": float(\\n\",\"        df[\\\"euclidean_displacement\\\"].max()\\n\",\"    ),\\n\",\"\\n\",\"    \\\"euclidean_mean\\\": float(\\n\",\"        df[\\\"euclidean_displacement\\\"].mean()\\n\",\"    ),\\n\",\"\\n\",\"    \\\"euclidean_median\\\": float(\\n\",\"        df[\\\"euclidean_displacement\\\"].median()\\n\",\"    ),\\n\",\"\\n\",\"    \\\"cosine_distance_min\\\": float(\\n\",\"        df[\\\"cosine_distance\\\"].min()\\n\",\"    ),\\n\",\"\\n\",\"    \\\"cosine_distance_max\\\": float(\\n\",\"        df[\\\"cosine_distance\\\"].max()\\n\",\"    ),\\n\",\"\\n\",\"    \\\"cosine_distance_mean\\\": float(\\n\",\"        df[\\\"cosine_distance\\\"].mean()\\n\",\"    ),\\n\",\"\\n\",\"    \\\"cosine_distance_median\\\": float(\\n\",\"        df[\\\"cosine_distance\\\"].median()\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 11. FINAL AUDIT\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"audit_checks = {\\n\",\"\\n\",\"    \\\"embedding_archive_shape_valid\\\": (\\n\",\"        embeddings.shape == (2414, 512)\\n\",\"    ),\\n\",\"\\n\",\"    \\\"embedding_values_finite\\\": bool(\\n\",\"        np.isfinite(embeddings).all()\\n\",\"    ),\\n\",\"\\n\",\"    \\\"reference_embeddings_valid\\\": (\\n\",\"        len(reference_lookup) == EXPECTED_IDENTITIES\\n\",\"    ),\\n\",\"\\n\",\"    \\\"common_conditions_from_frozen_protocol\\\": (\\n\",\"        len(common_conditions) == EXPECTED_COMMON_CONDITIONS\\n\",\"    ),\\n\",\"\\n\",\"    \\\"evaluation_conditions_valid\\\": (\\n\",\"        len(evaluation_conditions) == EXPECTED_EVALUATION_CONDITIONS\\n\",\"    ),\\n\",\"\\n\",\"    \\\"evaluation_record_count_valid\\\": (\\n\",\"        len(df) == EXPECTED_EVALUATION_RECORDS\\n\",\"    ),\\n\",\"\\n\",\"    \\\"identity_condition_pairs_unique\\\": (\\n\",\"        not df.duplicated(\\n\",\"            subset=[\\\"subject\\\", \\\"evaluation_condition\\\"]\\n\",\"        ).any()\\n\",\"    ),\\n\",\"\\n\",\"    \\\"all_displacements_finite\\\": bool(\\n\",\"        np.isfinite(\\n\",\"            df[\\\"euclidean_displacement\\\"].to_numpy()\\n\",\"        ).all()\\n\",\"    ),\\n\",\"\\n\",\"    \\\"all_cosine_distances_valid\\\": bool(\\n\",\"        (\\n\",\"            df[\\\"cosine_distance\\\"] >= -1e-12\\n\",\"        ).all()\\n\",\"        and\\n\",\"        (\\n\",\"            df[\\\"cosine_distance\\\"] <= 2.0 + 1e-12\\n\",\"        ).all()\\n\",\"    ),\\n\",\"\\n\",\"    \\\"reference_condition_excluded\\\": (\\n\",\"        not (\\n\",\"            df[\\\"evaluation_condition\\\"] == REFERENCE_CONDITION\\n\",\"        ).any()\\n\",\"    ),\\n\",\"\\n\",\"    \\\"illumination_group_counts_valid\\\": (\\n\",\"        actual_group_counts == expected_group_counts\\n\",\"    ),\\n\",\"\\n\",\"    \\\"csv_file_created\\\": os.path.isfile(CSV_PATH)\\n\",\"}\\n\",\"\\n\",\"audit_passed = all(audit_checks.values())\\n\",\"\\n\",\"audit = {\\n\",\"\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"\\n\",\"    \\\"step\\\": \\\"2.7.2\\\",\\n\",\"\\n\",\"    \\\"timestamp_utc\\\": datetime.now(\\n\",\"        timezone.utc\\n\",\"    ).isoformat(),\\n\",\"\\n\",\"    \\\"audit_status\\\": (\\n\",\"        \\\"PASSED\\\" if audit_passed else \\\"FAILED\\\"\\n\",\"    ),\\n\",\"\\n\",\"    \\\"audit_checks\\\": audit_checks,\\n\",\"\\n\",\"    \\\"reference_condition\\\": REFERENCE_CONDITION,\\n\",\"\\n\",\"    \\\"reference_embeddings\\\": len(reference_lookup),\\n\",\"\\n\",\"    \\\"common_conditions\\\": len(common_conditions),\\n\",\"\\n\",\"    \\\"evaluation_conditions\\\": len(evaluation_conditions),\\n\",\"\\n\",\"    \\\"evaluation_records\\\": len(df),\\n\",\"\\n\",\"    \\\"unique_identities\\\": int(\\n\",\"        df[\\\"subject\\\"].nunique()\\n\",\"    ),\\n\",\"\\n\",\"    \\\"unique_evaluation_conditions\\\": int(\\n\",\"        df[\\\"evaluation_condition\\\"].nunique()\\n\",\"    ),\\n\",\"\\n\",\"    \\\"group_observation_counts\\\": actual_group_counts,\\n\",\"\\n\",\"    \\\"displacement_summary\\\": displacement_summary,\\n\",\"\\n\",\"    \\\"output_csv\\\": CSV_PATH,\\n\",\"\\n\",\"    \\\"output_csv_sha256\\\": csv_sha256,\\n\",\"\\n\",\"    \\\"interpretation_limitations\\\": [\\n\",\"        \\\"Displacement is descriptive, not a calibrated detector score.\\\",\\n\",\"        \\\"Observations are repeated within identity.\\\",\\n\",\"        \\\"The dataset does not establish operational false-alarm rates.\\\",\\n\",\"        \\\"Embedding displacement does not directly establish recognition accuracy.\\\"\\n\",\"    ]\\n\",\"}\\n\",\"\\n\",\"with open(\\n\",\"    AUDIT_PATH,\\n\",\"    \\\"w\\\",\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\") as f:\\n\",\"\\n\",\"    json.dump(\\n\",\"        audit,\\n\",\"        f,\\n\",\"        indent=2\\n\",\"    )\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 12. FINAL OUTPUT\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 2.7.2 — FINAL AUDIT\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"for name, passed in audit_checks.items():\\n\",\"\\n\",\"    print(\\n\",\"        name,\\n\",\"        \\\":\\\",\\n\",\"        \\\"PASS\\\" if passed else \\\"FAIL\\\"\\n\",\"    )\\n\",\"\\n\",\"print(\\n\",\"    \\\"\\\\nAudit status:\\\",\\n\",\"    \\\"PASSED\\\" if audit_passed else \\\"FAILED\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\nDisplacement summary:\\\")\\n\",\"\\n\",\"print(\\n\",\"    json.dumps(\\n\",\"        displacement_summary,\\n\",\"        indent=2\\n\",\"    )\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\nCSV:\\\", CSV_PATH)\\n\",\"print(\\\"CSV SHA256:\\\", csv_sha256)\\n\",\"\\n\",\"print(\\\"Audit JSON:\\\", AUDIT_PATH)\\n\",\"\\n\",\"print(\\\"\\\\nNo thresholds calibrated.\\\")\\n\",\"print(\\\"No statistical significance claims generated.\\\")\\n\",\"print(\\\"No detector-performance claims generated.\\\")\\n\",\"\\n\",\"assert audit_passed, (\\n\",\"    \\\"Step 2.7.2 audit failed. \\\"\\n\",\"    \\\"Do not proceed until resolved.\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\nSTEP 2.7.2 FINISHED\\\")\\n\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"VrV4h_Ejycwf\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794353314638,\"user_tz\":360,\"elapsed\":465,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"96c07019-d00d-4746-d6b6-41811c892a1f\"},\"execution_count\":null,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"===========================================================================\\n\",\"STEP 1 — LOAD FROZEN INPUTS\\n\",\"===========================================================================\\n\",\"Embedding shape: (2414, 512)\\n\",\"Reference condition: A+000E+00\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 2 — VERIFIED COMMON CONDITION SELECTION\\n\",\"===========================================================================\\n\",\"Verified common conditions: 57\\n\",\"Reference condition: A+000E+00\\n\",\"Evaluation conditions: 56\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 3 — REFERENCE EMBEDDING LOOKUP\\n\",\"===========================================================================\\n\",\"Reference embeddings: 38\\n\",\"Reference identities: 38\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 4 — EVALUATION COHORT FILTERING\\n\",\"===========================================================================\\n\",\"Evaluation rows: 2128\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 5 — DISPLACEMENT CALCULATION\\n\",\"===========================================================================\\n\",\"Displacement records: 2128\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 6 — DATA INTEGRITY VALIDATION\\n\",\"===========================================================================\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 7 — ILLUMINATION GROUP COUNTS\\n\",\"===========================================================================\\n\",\"     illumination_group  observations  identities  conditions\\n\",\"large_angular_deviation          1064          38          28\\n\",\"           near_frontal           646          38          17\\n\",\"                oblique           418          38          11\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 8 — SAVE DISPLACEMENT DATA\\n\",\"===========================================================================\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 2.7.2 — FINAL AUDIT\\n\",\"===========================================================================\\n\",\"embedding_archive_shape_valid : PASS\\n\",\"embedding_values_finite : PASS\\n\",\"reference_embeddings_valid : PASS\\n\",\"common_conditions_from_frozen_protocol : PASS\\n\",\"evaluation_conditions_valid : PASS\\n\",\"evaluation_record_count_valid : PASS\\n\",\"identity_condition_pairs_unique : PASS\\n\",\"all_displacements_finite : PASS\\n\",\"all_cosine_distances_valid : PASS\\n\",\"reference_condition_excluded : PASS\\n\",\"illumination_group_counts_valid : PASS\\n\",\"csv_file_created : PASS\\n\",\"\\n\",\"Audit status: PASSED\\n\",\"\\n\",\"Displacement summary:\\n\",\"{\\n\",\"  \\\"euclidean_min\\\": 0.1516810430391137,\\n\",\"  \\\"euclidean_max\\\": 1.522514104406745,\\n\",\"  \\\"euclidean_mean\\\": 0.8204963498696879,\\n\",\"  \\\"euclidean_median\\\": 0.817311380200809,\\n\",\"  \\\"cosine_distance_min\\\": 0.011503569787168377,\\n\",\"  \\\"cosine_distance_max\\\": 1.1590245954458218,\\n\",\"  \\\"cosine_distance_mean\\\": 0.40243902507475376,\\n\",\"  \\\"cosine_distance_median\\\": 0.333998932472858\\n\",\"}\\n\",\"\\n\",\"CSV: /content/drive/MyDrive/Experiment_20_Results/step_2_7/displacement_analysis/experiment20_reference_evaluation_displacement.csv\\n\",\"CSV SHA256: d24a2a6d628eca608b8ab8e6c056fb50bc7b0e1c6c34e253dfae7c9354c9892f\\n\",\"Audit JSON: /content/drive/MyDrive/Experiment_20_Results/step_2_7/displacement_analysis/experiment20_step272_displacement_audit.json\\n\",\"\\n\",\"No thresholds calibrated.\\n\",\"No statistical significance claims generated.\\n\",\"No detector-performance claims generated.\\n\",\"\\n\",\"STEP 2.7.2 FINISHED\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"\\n\",\"## Step 2.7.3 — Group-Level Descriptive Statistics\\n\",\"\\n\",\"### Objective\\n\",\"Characterise embedding displacement across the three frozen illumination geometry groups.\\n\",\"\\n\",\"### Input\\n\",\"The validated Step 2.7.2 displacement CSV containing 2,128 identity-condition observations.\\n\",\"\\n\",\"### Illumination groups\\n\",\"1. Near-frontal: 17 evaluation conditions, 646 observations.\\n\",\"2. Oblique: 11 evaluation conditions, 418 observations.\\n\",\"3. Large angular deviation: 28 evaluation conditions, 1,064 observations.\\n\",\"\\n\",\"### Primary measurements\\n\",\"For both Euclidean displacement and cosine distance, calculate:\\n\",\"\\n\",\"- Observation count\\n\",\"- Number of identities\\n\",\"- Number of illumination conditions\\n\",\"- Mean\\n\",\"- Median\\n\",\"- Standard deviation\\n\",\"- Minimum and maximum\\n\",\"- First and third quartiles\\n\",\"- Interquartile range\\n\",\"\\n\",\"### Identity-level aggregation\\n\",\"Calculate each identity's mean displacement within each illumination group.\\n\",\"\\n\",\"This provides 38 identity-level values per group and prevents the unequal number of illumination conditions from being mistaken for unequal numbers of independent identities.\\n\",\"\\n\",\"### Interpretation safeguards\\n\",\"- Observation-level statistics are descriptive.\\n\",\"- Identity-level summaries are the basis for subsequent repeated-measures analysis.\\n\",\"- Do not interpret group differences as statistically significant at this stage.\\n\",\"- Do not claim recognition accuracy or operational detection performance.\\n\",\"\\n\",\"### Outputs\\n\",\"1. Group-level descriptive statistics CSV.\\n\",\"2. Identity-level group means CSV.\\n\",\"3. Step 2.7.3 audit JSON.\\n\",\"4. SHA256 checksums for generated CSV files.\\n\"],\"metadata\":{\"id\":\"3ZyLeZvtzeA7\"}},{\"cell_type\":\"code\",\"source\":[\"\\n\",\"import os\\n\",\"import json\\n\",\"import hashlib\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 20 — STEP 2.7.3\\n\",\"# GROUP-LEVEL DESCRIPTIVE STATISTICS\\n\",\"# ============================================================\\n\",\"\\n\",\"BASE = \\\"/content/drive/MyDrive/Experiment_20_Results\\\"\\n\",\"\\n\",\"INPUT_CSV = os.path.join(\\n\",\"    BASE,\\n\",\"    \\\"step_2_7\\\",\\n\",\"    \\\"displacement_analysis\\\",\\n\",\"    \\\"experiment20_reference_evaluation_displacement.csv\\\"\\n\",\")\\n\",\"\\n\",\"OUTPUT_DIR = os.path.join(\\n\",\"    BASE,\\n\",\"    \\\"step_2_7\\\",\\n\",\"    \\\"group_descriptive_analysis\\\"\\n\",\")\\n\",\"\\n\",\"os.makedirs(OUTPUT_DIR, exist_ok=True)\\n\",\"\\n\",\"GROUP_SUMMARY_PATH = os.path.join(\\n\",\"    OUTPUT_DIR,\\n\",\"    \\\"experiment20_illumination_group_descriptive_statistics.csv\\\"\\n\",\")\\n\",\"\\n\",\"IDENTITY_SUMMARY_PATH = os.path.join(\\n\",\"    OUTPUT_DIR,\\n\",\"    \\\"experiment20_identity_level_group_means.csv\\\"\\n\",\")\\n\",\"\\n\",\"AUDIT_PATH = os.path.join(\\n\",\"    OUTPUT_DIR,\\n\",\"    \\\"experiment20_step273_group_descriptive_audit.json\\\"\\n\",\")\\n\",\"\\n\",\"EXPECTED_ROWS = 2128\\n\",\"EXPECTED_IDENTITIES = 38\\n\",\"\\n\",\"EXPECTED_GROUP_COUNTS = {\\n\",\"    \\\"near_frontal\\\": 646,\\n\",\"    \\\"oblique\\\": 418,\\n\",\"    \\\"large_angular_deviation\\\": 1064\\n\",\"}\\n\",\"\\n\",\"METRICS = [\\n\",\"    \\\"euclidean_displacement\\\",\\n\",\"    \\\"cosine_distance\\\"\\n\",\"]\\n\",\"\\n\",\"GROUP_ORDER = [\\n\",\"    \\\"near_frontal\\\",\\n\",\"    \\\"oblique\\\",\\n\",\"    \\\"large_angular_deviation\\\"\\n\",\"]\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. LOAD INPUT\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"STEP 1 — LOAD DISPLACEMENT DATA\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"assert os.path.isfile(INPUT_CSV), (\\n\",\"    \\\"Step 2.7.2 displacement CSV not found.\\\"\\n\",\")\\n\",\"\\n\",\"df = pd.read_csv(INPUT_CSV)\\n\",\"\\n\",\"print(\\\"Input records:\\\", len(df))\\n\",\"print(\\\"Input columns:\\\", df.columns.tolist())\\n\",\"\\n\",\"assert len(df) == EXPECTED_ROWS\\n\",\"\\n\",\"required_columns = [\\n\",\"    \\\"subject\\\",\\n\",\"    \\\"evaluation_condition\\\",\\n\",\"    \\\"illumination_group\\\",\\n\",\"    \\\"hemisphere\\\",\\n\",\"    \\\"euclidean_displacement\\\",\\n\",\"    \\\"cosine_distance\\\"\\n\",\"]\\n\",\"\\n\",\"for column in required_columns:\\n\",\"    assert column in df.columns, (\\n\",\"        f\\\"Missing required column: {column}\\\"\\n\",\"    )\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. INPUT VALIDATION\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 2 — INPUT VALIDATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"assert df[\\\"subject\\\"].nunique() == EXPECTED_IDENTITIES\\n\",\"\\n\",\"assert not df.duplicated(\\n\",\"    subset=[\\\"subject\\\", \\\"evaluation_condition\\\"]\\n\",\").any()\\n\",\"\\n\",\"assert set(df[\\\"illumination_group\\\"].unique()) == set(\\n\",\"    GROUP_ORDER\\n\",\")\\n\",\"\\n\",\"for metric in METRICS:\\n\",\"\\n\",\"    assert np.isfinite(\\n\",\"        df[metric].to_numpy(dtype=float)\\n\",\"    ).all()\\n\",\"\\n\",\"print(\\\"Unique identities:\\\", df[\\\"subject\\\"].nunique())\\n\",\"print(\\\"Unique evaluation conditions:\\\",\\n\",\"      df[\\\"evaluation_condition\\\"].nunique())\\n\",\"\\n\",\"print(\\\"Duplicate identity-condition records:\\\",\\n\",\"      df.duplicated(\\n\",\"          subset=[\\\"subject\\\", \\\"evaluation_condition\\\"]\\n\",\"      ).sum())\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. VERIFY GROUP OBSERVATION COUNTS\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 3 — GROUP OBSERVATION COUNTS\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"actual_group_counts = (\\n\",\"    df[\\\"illumination_group\\\"]\\n\",\"    .value_counts()\\n\",\"    .to_dict()\\n\",\")\\n\",\"\\n\",\"for group in GROUP_ORDER:\\n\",\"\\n\",\"    observed = int(\\n\",\"        actual_group_counts.get(group, 0)\\n\",\"    )\\n\",\"\\n\",\"    expected = EXPECTED_GROUP_COUNTS[group]\\n\",\"\\n\",\"    print(\\n\",\"        group,\\n\",\"        \\\"| Observed:\\\",\\n\",\"        observed,\\n\",\"        \\\"| Expected:\\\",\\n\",\"        expected\\n\",\"    )\\n\",\"\\n\",\"    assert observed == expected\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. OBSERVATION-LEVEL DESCRIPTIVE STATISTICS\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 4 — OBSERVATION-LEVEL STATISTICS\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"summary_records = []\\n\",\"\\n\",\"for group in GROUP_ORDER:\\n\",\"\\n\",\"    group_df = df[\\n\",\"        df[\\\"illumination_group\\\"] == group\\n\",\"    ].copy()\\n\",\"\\n\",\"    for metric in METRICS:\\n\",\"\\n\",\"        values = group_df[metric].astype(float)\\n\",\"\\n\",\"        q1 = float(values.quantile(0.25))\\n\",\"        q3 = float(values.quantile(0.75))\\n\",\"\\n\",\"        summary_records.append({\\n\",\"\\n\",\"            \\\"illumination_group\\\": group,\\n\",\"\\n\",\"            \\\"metric\\\": metric,\\n\",\"\\n\",\"            \\\"observations\\\": int(len(values)),\\n\",\"\\n\",\"            \\\"identities\\\": int(\\n\",\"                group_df[\\\"subject\\\"].nunique()\\n\",\"            ),\\n\",\"\\n\",\"            \\\"conditions\\\": int(\\n\",\"                group_df[\\\"evaluation_condition\\\"].nunique()\\n\",\"            ),\\n\",\"\\n\",\"            \\\"mean\\\": float(values.mean()),\\n\",\"\\n\",\"            \\\"median\\\": float(values.median()),\\n\",\"\\n\",\"            \\\"standard_deviation\\\": float(\\n\",\"                values.std(ddof=1)\\n\",\"            ),\\n\",\"\\n\",\"            \\\"minimum\\\": float(values.min()),\\n\",\"\\n\",\"            \\\"first_quartile\\\": q1,\\n\",\"\\n\",\"            \\\"third_quartile\\\": q3,\\n\",\"\\n\",\"            \\\"maximum\\\": float(values.max()),\\n\",\"\\n\",\"            \\\"interquartile_range\\\": q3 - q1\\n\",\"        })\\n\",\"\\n\",\"group_summary = pd.DataFrame(\\n\",\"    summary_records\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    group_summary.to_string(\\n\",\"        index=False\\n\",\"    )\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. IDENTITY-LEVEL GROUP MEANS\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 5 — IDENTITY-LEVEL AGGREGATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"identity_summary = (\\n\",\"    df.groupby(\\n\",\"        [\\\"subject\\\", \\\"illumination_group\\\"],\\n\",\"        observed=True\\n\",\"    )\\n\",\"    .agg(\\n\",\"        euclidean_mean=(\\n\",\"            \\\"euclidean_displacement\\\",\\n\",\"            \\\"mean\\\"\\n\",\"        ),\\n\",\"\\n\",\"        euclidean_median=(\\n\",\"            \\\"euclidean_displacement\\\",\\n\",\"            \\\"median\\\"\\n\",\"        ),\\n\",\"\\n\",\"        cosine_mean=(\\n\",\"            \\\"cosine_distance\\\",\\n\",\"            \\\"mean\\\"\\n\",\"        ),\\n\",\"\\n\",\"        cosine_median=(\\n\",\"            \\\"cosine_distance\\\",\\n\",\"            \\\"median\\\"\\n\",\"        ),\\n\",\"\\n\",\"        evaluation_conditions=(\\n\",\"            \\\"evaluation_condition\\\",\\n\",\"            \\\"nunique\\\"\\n\",\"        ),\\n\",\"\\n\",\"        observations=(\\n\",\"            \\\"evaluation_condition\\\",\\n\",\"            \\\"size\\\"\\n\",\"        )\\n\",\"    )\\n\",\"    .reset_index()\\n\",\")\\n\",\"\\n\",\"print(\\\"Identity-group records:\\\", len(identity_summary))\\n\",\"\\n\",\"# Every identity must contribute one record to each group.\\n\",\"assert len(identity_summary) == (\\n\",\"    EXPECTED_IDENTITIES * len(GROUP_ORDER)\\n\",\")\\n\",\"\\n\",\"identity_group_counts = (\\n\",\"    identity_summary.groupby(\\n\",\"        \\\"illumination_group\\\"\\n\",\"    )[\\\"subject\\\"]\\n\",\"    .nunique()\\n\",\"    .to_dict()\\n\",\")\\n\",\"\\n\",\"for group in GROUP_ORDER:\\n\",\"\\n\",\"    assert identity_group_counts[group] == EXPECTED_IDENTITIES\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. IDENTITY-LEVEL DISTRIBUTION SUMMARY\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 6 — IDENTITY-LEVEL DISTRIBUTION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"identity_distribution_records = []\\n\",\"\\n\",\"for group in GROUP_ORDER:\\n\",\"\\n\",\"    group_identity_df = identity_summary[\\n\",\"        identity_summary[\\\"illumination_group\\\"] == group\\n\",\"    ]\\n\",\"\\n\",\"    for metric in [\\n\",\"        \\\"euclidean_mean\\\",\\n\",\"        \\\"cosine_mean\\\"\\n\",\"    ]:\\n\",\"\\n\",\"        values = group_identity_df[metric].astype(float)\\n\",\"\\n\",\"        identity_distribution_records.append({\\n\",\"\\n\",\"            \\\"illumination_group\\\": group,\\n\",\"\\n\",\"            \\\"identity_metric\\\": metric,\\n\",\"\\n\",\"            \\\"identities\\\": int(len(values)),\\n\",\"\\n\",\"            \\\"mean\\\": float(values.mean()),\\n\",\"\\n\",\"            \\\"median\\\": float(values.median()),\\n\",\"\\n\",\"            \\\"standard_deviation\\\": float(\\n\",\"                values.std(ddof=1)\\n\",\"            ),\\n\",\"\\n\",\"            \\\"minimum\\\": float(values.min()),\\n\",\"\\n\",\"            \\\"first_quartile\\\": float(\\n\",\"                values.quantile(0.25)\\n\",\"            ),\\n\",\"\\n\",\"            \\\"third_quartile\\\": float(\\n\",\"                values.quantile(0.75)\\n\",\"            ),\\n\",\"\\n\",\"            \\\"maximum\\\": float(values.max())\\n\",\"        })\\n\",\"\\n\",\"identity_distribution = pd.DataFrame(\\n\",\"    identity_distribution_records\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    identity_distribution.to_string(\\n\",\"        index=False\\n\",\"    )\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. SAVE OUTPUTS\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 7 — SAVE OUTPUTS\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"group_summary.to_csv(\\n\",\"    GROUP_SUMMARY_PATH,\\n\",\"    index=False,\\n\",\"    float_format=\\\"%.12g\\\"\\n\",\")\\n\",\"\\n\",\"identity_summary.to_csv(\\n\",\"    IDENTITY_SUMMARY_PATH,\\n\",\"    index=False,\\n\",\"    float_format=\\\"%.12g\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"Group summary saved:\\\", GROUP_SUMMARY_PATH)\\n\",\"\\n\",\"print(\\\"Identity summary saved:\\\", IDENTITY_SUMMARY_PATH)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 8. SHA256 CHECKSUMS\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"def sha256_file(path):\\n\",\"\\n\",\"    digest = hashlib.sha256()\\n\",\"\\n\",\"    with open(path, \\\"rb\\\") as f:\\n\",\"\\n\",\"        for chunk in iter(\\n\",\"            lambda: f.read(1024 * 1024),\\n\",\"            b\\\"\\\"\\n\",\"        ):\\n\",\"            digest.update(chunk)\\n\",\"\\n\",\"    return digest.hexdigest()\\n\",\"\\n\",\"\\n\",\"group_summary_sha256 = sha256_file(\\n\",\"    GROUP_SUMMARY_PATH\\n\",\")\\n\",\"\\n\",\"identity_summary_sha256 = sha256_file(\\n\",\"    IDENTITY_SUMMARY_PATH\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 9. FINAL AUDIT\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 8 — FINAL AUDIT\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"audit_checks = {\\n\",\"\\n\",\"    \\\"input_csv_exists\\\": os.path.isfile(INPUT_CSV),\\n\",\"\\n\",\"    \\\"input_record_count_valid\\\": (\\n\",\"        len(df) == EXPECTED_ROWS\\n\",\"    ),\\n\",\"\\n\",\"    \\\"identity_count_valid\\\": (\\n\",\"        df[\\\"subject\\\"].nunique() == EXPECTED_IDENTITIES\\n\",\"    ),\\n\",\"\\n\",\"    \\\"identity_condition_records_unique\\\": (\\n\",\"        not df.duplicated(\\n\",\"            subset=[\\\"subject\\\", \\\"evaluation_condition\\\"]\\n\",\"        ).any()\\n\",\"    ),\\n\",\"\\n\",\"    \\\"all_metrics_finite\\\": all(\\n\",\"        np.isfinite(\\n\",\"            df[metric].to_numpy(dtype=float)\\n\",\"        ).all()\\n\",\"        for metric in METRICS\\n\",\"    ),\\n\",\"\\n\",\"    \\\"illumination_group_counts_valid\\\": (\\n\",\"        actual_group_counts == EXPECTED_GROUP_COUNTS\\n\",\"    ),\\n\",\"\\n\",\"    \\\"three_groups_present\\\": (\\n\",\"        set(df[\\\"illumination_group\\\"].unique())\\n\",\"        == set(GROUP_ORDER)\\n\",\"    ),\\n\",\"\\n\",\"    \\\"identity_level_record_count_valid\\\": (\\n\",\"        len(identity_summary) == 114\\n\",\"    ),\\n\",\"\\n\",\"    \\\"all_identities_present_in_each_group\\\": (\\n\",\"        all(\\n\",\"            identity_group_counts[group] == EXPECTED_IDENTITIES\\n\",\"            for group in GROUP_ORDER\\n\",\"        )\\n\",\"    ),\\n\",\"\\n\",\"    \\\"group_summary_file_created\\\": (\\n\",\"        os.path.isfile(GROUP_SUMMARY_PATH)\\n\",\"    ),\\n\",\"\\n\",\"    \\\"identity_summary_file_created\\\": (\\n\",\"        os.path.isfile(IDENTITY_SUMMARY_PATH)\\n\",\"    ),\\n\",\"\\n\",\"    \\\"group_summary_rows_valid\\\": (\\n\",\"        len(group_summary) == 6\\n\",\"    ),\\n\",\"\\n\",\"    \\\"identity_distribution_rows_valid\\\": (\\n\",\"        len(identity_distribution) == 6\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"audit_passed = all(\\n\",\"    audit_checks.values()\\n\",\")\\n\",\"\\n\",\"audit = {\\n\",\"\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"\\n\",\"    \\\"step\\\": \\\"2.7.3\\\",\\n\",\"\\n\",\"    \\\"timestamp_utc\\\": datetime.now(\\n\",\"        timezone.utc\\n\",\"    ).isoformat(),\\n\",\"\\n\",\"    \\\"audit_status\\\": (\\n\",\"        \\\"PASSED\\\" if audit_passed else \\\"FAILED\\\"\\n\",\"    ),\\n\",\"\\n\",\"    \\\"audit_checks\\\": audit_checks,\\n\",\"\\n\",\"    \\\"input_records\\\": len(df),\\n\",\"\\n\",\"    \\\"unique_identities\\\": int(\\n\",\"        df[\\\"subject\\\"].nunique()\\n\",\"    ),\\n\",\"\\n\",\"    \\\"group_observation_counts\\\": actual_group_counts,\\n\",\"\\n\",\"    \\\"identity_level_records\\\": len(identity_summary),\\n\",\"\\n\",\"    \\\"identity_group_counts\\\": identity_group_counts,\\n\",\"\\n\",\"    \\\"group_summary_csv\\\": GROUP_SUMMARY_PATH,\\n\",\"\\n\",\"    \\\"group_summary_sha256\\\": group_summary_sha256,\\n\",\"\\n\",\"    \\\"identity_summary_csv\\\": IDENTITY_SUMMARY_PATH,\\n\",\"\\n\",\"    \\\"identity_summary_sha256\\\": identity_summary_sha256,\\n\",\"\\n\",\"    \\\"interpretation_limitations\\\": [\\n\",\"        \\\"Observation-level values are repeated within identity.\\\",\\n\",\"        \\\"Identity-level group means are the appropriate input \\\"\\n\",\"        \\\"for subsequent repeated-measures comparisons.\\\",\\n\",\"        \\\"No statistical significance is established in this step.\\\",\\n\",\"        \\\"No calibrated detection performance is established.\\\"\\n\",\"    ]\\n\",\"}\\n\",\"\\n\",\"with open(\\n\",\"    AUDIT_PATH,\\n\",\"    \\\"w\\\",\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\") as f:\\n\",\"\\n\",\"    json.dump(\\n\",\"        audit,\\n\",\"        f,\\n\",\"        indent=2\\n\",\"    )\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 10. FINAL REPORT\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 2.7.3 — AUDIT RESULTS\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"for name, passed in audit_checks.items():\\n\",\"\\n\",\"    print(\\n\",\"        name,\\n\",\"        \\\":\\\",\\n\",\"        \\\"PASS\\\" if passed else \\\"FAIL\\\"\\n\",\"    )\\n\",\"\\n\",\"print(\\n\",\"    \\\"\\\\nAudit status:\\\",\\n\",\"    \\\"PASSED\\\" if audit_passed else \\\"FAILED\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\nGroup summary SHA256:\\\")\\n\",\"print(group_summary_sha256)\\n\",\"\\n\",\"print(\\\"\\\\nIdentity summary SHA256:\\\")\\n\",\"print(identity_summary_sha256)\\n\",\"\\n\",\"print(\\\"\\\\nAudit JSON:\\\")\\n\",\"print(AUDIT_PATH)\\n\",\"\\n\",\"print(\\\"\\\\nNo hypothesis tests performed.\\\")\\n\",\"print(\\\"No statistical significance claims generated.\\\")\\n\",\"print(\\\"No detector thresholds calibrated.\\\")\\n\",\"\\n\",\"assert audit_passed, (\\n\",\"    \\\"Step 2.7.3 audit failed. \\\"\\n\",\"    \\\"Do not proceed until resolved.\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\nSTEP 2.7.3 FINISHED\\\")\\n\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"x9JnQpnmzgip\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794353534474,\"user_tz\":360,\"elapsed\":1154,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"e9d89847-9316-4a26-ff6e-ba6c5d189351\"},\"execution_count\":null,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"===========================================================================\\n\",\"STEP 1 — LOAD DISPLACEMENT DATA\\n\",\"===========================================================================\\n\",\"Input records: 2128\\n\",\"Input columns: ['subject', 'reference_condition', 'evaluation_condition', 'reference_filename', 'evaluation_filename', 'azimuth_degrees', 'elevation_degrees', 'angular_deviation_degrees', 'illumination_group', 'hemisphere', 'euclidean_displacement', 'cosine_similarity', 'cosine_distance']\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 2 — INPUT VALIDATION\\n\",\"===========================================================================\\n\",\"Unique identities: 38\\n\",\"Unique evaluation conditions: 56\\n\",\"Duplicate identity-condition records: 0\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 3 — GROUP OBSERVATION COUNTS\\n\",\"===========================================================================\\n\",\"near_frontal | Observed: 646 | Expected: 646\\n\",\"oblique | Observed: 418 | Expected: 418\\n\",\"large_angular_deviation | Observed: 1064 | Expected: 1064\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 4 — OBSERVATION-LEVEL STATISTICS\\n\",\"===========================================================================\\n\",\"     illumination_group                 metric  observations  identities  conditions     mean   median  standard_deviation  minimum  first_quartile  third_quartile  maximum  interquartile_range\\n\",\"           near_frontal euclidean_displacement           646          38          17 0.401897 0.391009            0.110684 0.151681        0.322356        0.476773 0.733905             0.154417\\n\",\"           near_frontal        cosine_distance           646          38          17 0.086877 0.076444            0.047880 0.011504        0.051957        0.113656 0.269308             0.061699\\n\",\"                oblique euclidean_displacement           418          38          11 0.708976 0.711156            0.148166 0.298829        0.607490        0.809109 1.193744             0.201619\\n\",\"                oblique        cosine_distance           418          38          11 0.262274 0.252871            0.106198 0.044649        0.184522        0.327329 0.712512             0.142806\\n\",\"large_angular_deviation euclidean_displacement          1064          38          28 1.118457 1.141883            0.217459 0.519715        0.938912        1.304154 1.522514             0.365242\\n\",\"large_angular_deviation        cosine_distance          1064          38          28 0.649095 0.651949            0.238825 0.135052        0.440778        0.850409 1.159025             0.409631\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 5 — IDENTITY-LEVEL AGGREGATION\\n\",\"===========================================================================\\n\",\"Identity-group records: 114\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 6 — IDENTITY-LEVEL DISTRIBUTION\\n\",\"===========================================================================\\n\",\"     illumination_group identity_metric  identities     mean   median  standard_deviation  minimum  first_quartile  third_quartile  maximum\\n\",\"           near_frontal  euclidean_mean          38 0.401897 0.399489            0.069258 0.280419        0.362035        0.448763 0.607822\\n\",\"           near_frontal     cosine_mean          38 0.086877 0.082990            0.029734 0.041039        0.068555        0.104711 0.189539\\n\",\"                oblique  euclidean_mean          38 0.708976 0.714090            0.091197 0.487992        0.662777        0.773481 0.894227\\n\",\"                oblique     cosine_mean          38 0.262274 0.261925            0.064399 0.130192        0.227661        0.307409 0.408786\\n\",\"large_angular_deviation  euclidean_mean          38 1.118457 1.119720            0.082872 0.921196        1.076022        1.168972 1.278719\\n\",\"large_angular_deviation     cosine_mean          38 0.649095 0.647955            0.089917 0.439785        0.598148        0.705258 0.829855\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 7 — SAVE OUTPUTS\\n\",\"===========================================================================\\n\",\"Group summary saved: /content/drive/MyDrive/Experiment_20_Results/step_2_7/group_descriptive_analysis/experiment20_illumination_group_descriptive_statistics.csv\\n\",\"Identity summary saved: /content/drive/MyDrive/Experiment_20_Results/step_2_7/group_descriptive_analysis/experiment20_identity_level_group_means.csv\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 8 — FINAL AUDIT\\n\",\"===========================================================================\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 2.7.3 — AUDIT RESULTS\\n\",\"===========================================================================\\n\",\"input_csv_exists : PASS\\n\",\"input_record_count_valid : PASS\\n\",\"identity_count_valid : PASS\\n\",\"identity_condition_records_unique : PASS\\n\",\"all_metrics_finite : PASS\\n\",\"illumination_group_counts_valid : PASS\\n\",\"three_groups_present : PASS\\n\",\"identity_level_record_count_valid : PASS\\n\",\"all_identities_present_in_each_group : PASS\\n\",\"group_summary_file_created : PASS\\n\",\"identity_summary_file_created : PASS\\n\",\"group_summary_rows_valid : PASS\\n\",\"identity_distribution_rows_valid : PASS\\n\",\"\\n\",\"Audit status: PASSED\\n\",\"\\n\",\"Group summary SHA256:\\n\",\"1b9a6ba8dae4431e807f1b15286276acaf7c9283a8a950bff3c844f8155c61e9\\n\",\"\\n\",\"Identity summary SHA256:\\n\",\"b1640113782e5e1b05f782ef00e9fd64ff6c8c5e0e6aaea13c2a74f7b4cb33ca\\n\",\"\\n\",\"Audit JSON:\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_2_7/group_descriptive_analysis/experiment20_step273_group_descriptive_audit.json\\n\",\"\\n\",\"No hypothesis tests performed.\\n\",\"No statistical significance claims generated.\\n\",\"No detector thresholds calibrated.\\n\",\"\\n\",\"STEP 2.7.3 FINISHED\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"\\n\",\"## Step 2.7.4 — Identity-Level Repeated-Measures Statistical Analysis\\n\",\"\\n\",\"### Objective\\n\",\"Evaluate whether embedding displacement differs across the three illumination geometry groups while accounting for repeated observations within each identity.\\n\",\"\\n\",\"### Input\\n\",\"The frozen identity-level group means generated in Step 2.7.3.\\n\",\"\\n\",\"Expected:\\n\",\"- 38 identities.\\n\",\"- 3 illumination groups per identity.\\n\",\"- 114 identity-group records.\\n\",\"\\n\",\"### Primary statistical test\\n\",\"Friedman test:\\n\",\"\\n\",\"- Near-frontal\\n\",\"- Oblique\\n\",\"- Large angular deviation\\n\",\"\\n\",\"Run separately for:\\n\",\"1. Identity-level mean Euclidean displacement.\\n\",\"2. Identity-level mean cosine distance.\\n\",\"\\n\",\"### Pairwise comparisons\\n\",\"Use paired Wilcoxon signed-rank tests for:\\n\",\"\\n\",\"1. Near-frontal versus oblique.\\n\",\"2. Near-frontal versus large angular deviation.\\n\",\"3. Oblique versus large angular deviation.\\n\",\"\\n\",\"Apply Holm correction separately within each metric's three pairwise comparisons.\\n\",\"\\n\",\"### Effect size\\n\",\"Calculate Kendall's W for each Friedman test.\\n\",\"\\n\",\"### Confidence intervals\\n\",\"Calculate 95% bootstrap confidence intervals for paired mean differences, resampling identities rather than individual observations.\\n\",\"\\n\",\"### Reporting safeguards\\n\",\"- Identity is the repeated-measures unit.\\n\",\"- All comparisons are paired by identity.\\n\",\"- Report raw and Holm-adjusted p-values.\\n\",\"- Report effect sizes and confidence intervals.\\n\",\"- Do not interpret statistical significance as recognition accuracy or operational detector performance.\\n\"],\"metadata\":{\"id\":\"Z2my70ffzq7_\"}},{\"cell_type\":\"code\",\"source\":[\"\\n\",\"import os\\n\",\"import json\\n\",\"import hashlib\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"\\n\",\"from scipy.stats import friedmanchisquare, wilcoxon\\n\",\"from itertools import combinations\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 20 — STEP 2.7.4\\n\",\"# CORRECTED IDENTITY-LEVEL REPEATED-MEASURES ANALYSIS\\n\",\"# ============================================================\\n\",\"\\n\",\"BASE = \\\"/content/drive/MyDrive/Experiment_20_Results\\\"\\n\",\"\\n\",\"INPUT_PATH = os.path.join(\\n\",\"    BASE,\\n\",\"    \\\"step_2_7\\\",\\n\",\"    \\\"group_descriptive_analysis\\\",\\n\",\"    \\\"experiment20_identity_level_group_means.csv\\\"\\n\",\")\\n\",\"\\n\",\"OUTPUT_DIR = os.path.join(\\n\",\"    BASE,\\n\",\"    \\\"step_2_7\\\",\\n\",\"    \\\"repeated_measures_analysis\\\"\\n\",\")\\n\",\"\\n\",\"os.makedirs(OUTPUT_DIR, exist_ok=True)\\n\",\"\\n\",\"RESULTS_PATH = os.path.join(\\n\",\"    OUTPUT_DIR,\\n\",\"    \\\"experiment20_repeated_measures_test_results.csv\\\"\\n\",\")\\n\",\"\\n\",\"PAIRED_PATH = os.path.join(\\n\",\"    OUTPUT_DIR,\\n\",\"    \\\"experiment20_paired_comparison_results.csv\\\"\\n\",\")\\n\",\"\\n\",\"AUDIT_PATH = os.path.join(\\n\",\"    OUTPUT_DIR,\\n\",\"    \\\"experiment20_step274_repeated_measures_audit.json\\\"\\n\",\")\\n\",\"\\n\",\"GROUPS = [\\n\",\"    \\\"near_frontal\\\",\\n\",\"    \\\"oblique\\\",\\n\",\"    \\\"large_angular_deviation\\\"\\n\",\"]\\n\",\"\\n\",\"METRICS = {\\n\",\"    \\\"euclidean_mean\\\": \\\"Euclidean displacement\\\",\\n\",\"    \\\"cosine_mean\\\": \\\"Cosine distance\\\"\\n\",\"}\\n\",\"\\n\",\"EXPECTED_IDENTITIES = 38\\n\",\"BOOTSTRAP_ITERATIONS = 20000\\n\",\"RANDOM_SEED = 2026274\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. JSON SERIALIZATION SAFETY\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"def make_json_serializable(obj):\\n\",\"\\n\",\"    if isinstance(obj, dict):\\n\",\"        return {\\n\",\"            str(key): make_json_serializable(value)\\n\",\"            for key, value in obj.items()\\n\",\"        }\\n\",\"\\n\",\"    if isinstance(obj, (list, tuple)):\\n\",\"        return [\\n\",\"            make_json_serializable(value)\\n\",\"            for value in obj\\n\",\"        ]\\n\",\"\\n\",\"    if isinstance(obj, np.ndarray):\\n\",\"        return make_json_serializable(obj.tolist())\\n\",\"\\n\",\"    if isinstance(obj, np.generic):\\n\",\"        return make_json_serializable(obj.item())\\n\",\"\\n\",\"    if isinstance(obj, (np.bool_, bool)):\\n\",\"        return bool(obj)\\n\",\"\\n\",\"    if isinstance(obj, (np.integer,)):\\n\",\"        return int(obj)\\n\",\"\\n\",\"    if isinstance(obj, (np.floating,)):\\n\",\"        return float(obj)\\n\",\"\\n\",\"    if isinstance(obj, pd.Series):\\n\",\"        return make_json_serializable(obj.tolist())\\n\",\"\\n\",\"    if isinstance(obj, pd.DataFrame):\\n\",\"        return make_json_serializable(\\n\",\"            obj.to_dict(orient=\\\"records\\\")\\n\",\"        )\\n\",\"\\n\",\"    if isinstance(obj, (datetime,)):\\n\",\"        return obj.isoformat()\\n\",\"\\n\",\"    return obj\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. LOAD DATA\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"STEP 1 — LOAD IDENTITY-LEVEL DATA\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"assert os.path.isfile(INPUT_PATH), (\\n\",\"    \\\"Identity-level group means CSV not found.\\\"\\n\",\")\\n\",\"\\n\",\"df = pd.read_csv(INPUT_PATH)\\n\",\"\\n\",\"print(\\\"Records:\\\", len(df))\\n\",\"print(\\\"Unique identities:\\\", df[\\\"subject\\\"].nunique())\\n\",\"\\n\",\"assert len(df) == 114\\n\",\"assert df[\\\"subject\\\"].nunique() == EXPECTED_IDENTITIES\\n\",\"\\n\",\"assert not df.duplicated(\\n\",\"    subset=[\\\"subject\\\", \\\"illumination_group\\\"]\\n\",\").any()\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. BUILD PAIRED MATRICES\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 2 — BUILD REPEATED-MEASURES MATRICES\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"subjects = sorted(\\n\",\"    df[\\\"subject\\\"].unique().tolist()\\n\",\")\\n\",\"\\n\",\"matrices = {}\\n\",\"\\n\",\"for metric in METRICS:\\n\",\"\\n\",\"    matrix = (\\n\",\"        df.pivot(\\n\",\"            index=\\\"subject\\\",\\n\",\"            columns=\\\"illumination_group\\\",\\n\",\"            values=metric\\n\",\"        )\\n\",\"        .reindex(\\n\",\"            index=subjects,\\n\",\"            columns=GROUPS\\n\",\"        )\\n\",\"    )\\n\",\"\\n\",\"    assert matrix.shape == (38, 3)\\n\",\"    assert not matrix.isna().any().any()\\n\",\"\\n\",\"    matrices[metric] = matrix\\n\",\"\\n\",\"    print(\\n\",\"        METRICS[metric],\\n\",\"        \\\"| Shape:\\\",\\n\",\"        matrix.shape\\n\",\"    )\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. FRIEDMAN TESTS\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 3 — FRIEDMAN TESTS\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"friedman_results = []\\n\",\"\\n\",\"for metric, label in METRICS.items():\\n\",\"\\n\",\"    matrix = matrices[metric]\\n\",\"\\n\",\"    arrays = [\\n\",\"        matrix[group].to_numpy(dtype=float)\\n\",\"        for group in GROUPS\\n\",\"    ]\\n\",\"\\n\",\"    statistic, p_value = friedmanchisquare(*arrays)\\n\",\"\\n\",\"    kendalls_w = (\\n\",\"        float(statistic)\\n\",\"        / (\\n\",\"            EXPECTED_IDENTITIES\\n\",\"            * (len(GROUPS) - 1)\\n\",\"        )\\n\",\"    )\\n\",\"\\n\",\"    result = {\\n\",\"\\n\",\"        \\\"metric\\\": metric,\\n\",\"        \\\"metric_label\\\": label,\\n\",\"        \\\"test\\\": \\\"Friedman\\\",\\n\",\"        \\\"identities\\\": EXPECTED_IDENTITIES,\\n\",\"        \\\"groups\\\": len(GROUPS),\\n\",\"        \\\"test_statistic\\\": float(statistic),\\n\",\"        \\\"p_value\\\": float(p_value),\\n\",\"        \\\"kendalls_w\\\": float(kendalls_w)\\n\",\"    }\\n\",\"\\n\",\"    friedman_results.append(result)\\n\",\"\\n\",\"    print(\\\"\\\\nMetric:\\\", label)\\n\",\"    print(\\\"Friedman statistic:\\\", statistic)\\n\",\"    print(\\\"p-value:\\\", p_value)\\n\",\"    print(\\\"Kendall's W:\\\", kendalls_w)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. PAIRWISE WILCOXON TESTS\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 4 — PAIRED WILCOXON TESTS\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"pair_definitions = list(combinations(GROUPS, 2))\\n\",\"\\n\",\"paired_results = []\\n\",\"\\n\",\"for metric, label in METRICS.items():\\n\",\"\\n\",\"    matrix = matrices[metric]\\n\",\"\\n\",\"    for group_a, group_b in pair_definitions:\\n\",\"\\n\",\"        values_a = matrix[group_a].to_numpy(dtype=float)\\n\",\"        values_b = matrix[group_b].to_numpy(dtype=float)\\n\",\"\\n\",\"        differences = values_b - values_a\\n\",\"\\n\",\"        if np.allclose(\\n\",\"            differences,\\n\",\"            0.0,\\n\",\"            rtol=0,\\n\",\"            atol=1e-14\\n\",\"        ):\\n\",\"\\n\",\"            statistic = 0.0\\n\",\"            p_value = 1.0\\n\",\"\\n\",\"        else:\\n\",\"\\n\",\"            test_result = wilcoxon(\\n\",\"                values_b,\\n\",\"                values_a,\\n\",\"                alternative=\\\"two-sided\\\",\\n\",\"                zero_method=\\\"wilcox\\\",\\n\",\"                method=\\\"auto\\\"\\n\",\"            )\\n\",\"\\n\",\"            statistic = float(test_result.statistic)\\n\",\"            p_value = float(test_result.pvalue)\\n\",\"\\n\",\"        result = {\\n\",\"\\n\",\"            \\\"metric\\\": metric,\\n\",\"            \\\"metric_label\\\": label,\\n\",\"            \\\"group_a\\\": group_a,\\n\",\"            \\\"group_b\\\": group_b,\\n\",\"            \\\"identities\\\": EXPECTED_IDENTITIES,\\n\",\"\\n\",\"            \\\"mean_group_a\\\": float(np.mean(values_a)),\\n\",\"            \\\"mean_group_b\\\": float(np.mean(values_b)),\\n\",\"\\n\",\"            \\\"mean_paired_difference_b_minus_a\\\": float(\\n\",\"                np.mean(differences)\\n\",\"            ),\\n\",\"\\n\",\"            \\\"median_paired_difference_b_minus_a\\\": float(\\n\",\"                np.median(differences)\\n\",\"            ),\\n\",\"\\n\",\"            \\\"wilcoxon_statistic\\\": statistic,\\n\",\"            \\\"raw_p_value\\\": p_value\\n\",\"        }\\n\",\"\\n\",\"        paired_results.append(result)\\n\",\"\\n\",\"        print(\\n\",\"            label,\\n\",\"            \\\"|\\\",\\n\",\"            group_a,\\n\",\"            \\\"vs\\\",\\n\",\"            group_b,\\n\",\"            \\\"| Mean difference:\\\",\\n\",\"            np.mean(differences),\\n\",\"            \\\"| p:\\\",\\n\",\"            p_value\\n\",\"        )\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. HOLM CORRECTION\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 5 — HOLM CORRECTION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"def holm_adjust(p_values):\\n\",\"\\n\",\"    p_values = np.asarray(\\n\",\"        p_values,\\n\",\"        dtype=float\\n\",\"    )\\n\",\"\\n\",\"    m = len(p_values)\\n\",\"    order = np.argsort(p_values)\\n\",\"\\n\",\"    adjusted = np.empty(m, dtype=float)\\n\",\"    running_max = 0.0\\n\",\"\\n\",\"    for rank, original_index in enumerate(order):\\n\",\"\\n\",\"        value = (\\n\",\"            (m - rank)\\n\",\"            * p_values[original_index]\\n\",\"        )\\n\",\"\\n\",\"        running_max = max(\\n\",\"            running_max,\\n\",\"            value\\n\",\"        )\\n\",\"\\n\",\"        adjusted[original_index] = min(\\n\",\"            running_max,\\n\",\"            1.0\\n\",\"        )\\n\",\"\\n\",\"    return adjusted\\n\",\"\\n\",\"\\n\",\"for metric in METRICS:\\n\",\"\\n\",\"    indices = [\\n\",\"        i\\n\",\"        for i, result in enumerate(paired_results)\\n\",\"        if result[\\\"metric\\\"] == metric\\n\",\"    ]\\n\",\"\\n\",\"    raw_p_values = [\\n\",\"        paired_results[i][\\\"raw_p_value\\\"]\\n\",\"        for i in indices\\n\",\"    ]\\n\",\"\\n\",\"    adjusted_values = holm_adjust(raw_p_values)\\n\",\"\\n\",\"    for index, adjusted_p in zip(\\n\",\"        indices,\\n\",\"        adjusted_values\\n\",\"    ):\\n\",\"\\n\",\"        paired_results[index][\\n\",\"            \\\"holm_adjusted_p_value\\\"\\n\",\"        ] = float(adjusted_p)\\n\",\"\\n\",\"        paired_results[index][\\n\",\"            \\\"significant_after_holm_0_05\\\"\\n\",\"        ] = bool(adjusted_p < 0.05)\\n\",\"\\n\",\"    print(\\\"\\\\nMetric:\\\", METRICS[metric])\\n\",\"\\n\",\"    for index in indices:\\n\",\"\\n\",\"        result = paired_results[index]\\n\",\"\\n\",\"        print(\\n\",\"            result[\\\"group_a\\\"],\\n\",\"            \\\"vs\\\",\\n\",\"            result[\\\"group_b\\\"],\\n\",\"            \\\"| Raw p:\\\",\\n\",\"            result[\\\"raw_p_value\\\"],\\n\",\"            \\\"| Holm p:\\\",\\n\",\"            result[\\\"holm_adjusted_p_value\\\"]\\n\",\"        )\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. IDENTITY-LEVEL BOOTSTRAP CONFIDENCE INTERVALS\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 6 — PAIRED BOOTSTRAP CONFIDENCE INTERVALS\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"rng = np.random.default_rng(RANDOM_SEED)\\n\",\"\\n\",\"bootstrap_results = []\\n\",\"\\n\",\"for metric, label in METRICS.items():\\n\",\"\\n\",\"    matrix = matrices[metric]\\n\",\"\\n\",\"    for group_a, group_b in pair_definitions:\\n\",\"\\n\",\"        values_a = matrix[group_a].to_numpy(dtype=float)\\n\",\"        values_b = matrix[group_b].to_numpy(dtype=float)\\n\",\"\\n\",\"        paired_differences = values_b - values_a\\n\",\"\\n\",\"        bootstrap_indices = rng.integers(\\n\",\"            0,\\n\",\"            EXPECTED_IDENTITIES,\\n\",\"            size=(\\n\",\"                BOOTSTRAP_ITERATIONS,\\n\",\"                EXPECTED_IDENTITIES\\n\",\"            )\\n\",\"        )\\n\",\"\\n\",\"        bootstrap_means = paired_differences[\\n\",\"            bootstrap_indices\\n\",\"        ].mean(axis=1)\\n\",\"\\n\",\"        ci_lower, ci_upper = np.percentile(\\n\",\"            bootstrap_means,\\n\",\"            [2.5, 97.5]\\n\",\"        )\\n\",\"\\n\",\"        bootstrap_results.append({\\n\",\"\\n\",\"            \\\"metric\\\": metric,\\n\",\"            \\\"group_a\\\": group_a,\\n\",\"            \\\"group_b\\\": group_b,\\n\",\"\\n\",\"            \\\"bootstrap_iterations\\\": BOOTSTRAP_ITERATIONS,\\n\",\"            \\\"random_seed\\\": RANDOM_SEED,\\n\",\"\\n\",\"            \\\"mean_difference_b_minus_a\\\": float(\\n\",\"                paired_differences.mean()\\n\",\"            ),\\n\",\"\\n\",\"            \\\"ci_95_lower\\\": float(ci_lower),\\n\",\"            \\\"ci_95_upper\\\": float(ci_upper)\\n\",\"        })\\n\",\"\\n\",\"        print(\\n\",\"            label,\\n\",\"            \\\"|\\\",\\n\",\"            group_a,\\n\",\"            \\\"vs\\\",\\n\",\"            group_b,\\n\",\"            \\\"| Mean difference:\\\",\\n\",\"            paired_differences.mean(),\\n\",\"            \\\"| 95% CI:\\\",\\n\",\"            (ci_lower, ci_upper)\\n\",\"        )\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 8. CONSOLIDATE RESULTS\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 7 — CONSOLIDATE RESULTS\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"friedman_df = pd.DataFrame(friedman_results)\\n\",\"\\n\",\"paired_df = pd.DataFrame(paired_results)\\n\",\"\\n\",\"bootstrap_df = pd.DataFrame(bootstrap_results)\\n\",\"\\n\",\"paired_df = paired_df.merge(\\n\",\"    bootstrap_df[\\n\",\"        [\\n\",\"            \\\"metric\\\",\\n\",\"            \\\"group_a\\\",\\n\",\"            \\\"group_b\\\",\\n\",\"            \\\"ci_95_lower\\\",\\n\",\"            \\\"ci_95_upper\\\",\\n\",\"            \\\"bootstrap_iterations\\\",\\n\",\"            \\\"random_seed\\\"\\n\",\"        ]\\n\",\"    ],\\n\",\"    on=[\\\"metric\\\", \\\"group_a\\\", \\\"group_b\\\"],\\n\",\"    how=\\\"left\\\",\\n\",\"    validate=\\\"one_to_one\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\nFriedman results:\\\")\\n\",\"print(friedman_df.to_string(index=False))\\n\",\"\\n\",\"print(\\\"\\\\nPairwise results:\\\")\\n\",\"print(paired_df.to_string(index=False))\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 9. SAVE RESULTS\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 8 — SAVE RESULTS\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"friedman_df.to_csv(\\n\",\"    RESULTS_PATH,\\n\",\"    index=False,\\n\",\"    float_format=\\\"%.12g\\\"\\n\",\")\\n\",\"\\n\",\"paired_df.to_csv(\\n\",\"    PAIRED_PATH,\\n\",\"    index=False,\\n\",\"    float_format=\\\"%.12g\\\"\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 10. CHECKSUMS\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"def sha256_file(path):\\n\",\"\\n\",\"    digest = hashlib.sha256()\\n\",\"\\n\",\"    with open(path, \\\"rb\\\") as f:\\n\",\"\\n\",\"        for chunk in iter(\\n\",\"            lambda: f.read(1024 * 1024),\\n\",\"            b\\\"\\\"\\n\",\"        ):\\n\",\"            digest.update(chunk)\\n\",\"\\n\",\"    return digest.hexdigest()\\n\",\"\\n\",\"\\n\",\"friedman_sha256 = sha256_file(RESULTS_PATH)\\n\",\"paired_sha256 = sha256_file(PAIRED_PATH)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 11. FINAL AUDIT\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 9 — FINAL AUDIT\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"identity_group_counts = (\\n\",\"    df.groupby(\\\"subject\\\")[\\\"illumination_group\\\"]\\n\",\"    .nunique()\\n\",\")\\n\",\"\\n\",\"audit_checks = {\\n\",\"\\n\",\"    \\\"input_file_exists\\\": bool(\\n\",\"        os.path.isfile(INPUT_PATH)\\n\",\"    ),\\n\",\"\\n\",\"    \\\"input_records_valid\\\": bool(\\n\",\"        len(df) == 114\\n\",\"    ),\\n\",\"\\n\",\"    \\\"38_unique_identities\\\": bool(\\n\",\"        df[\\\"subject\\\"].nunique() == 38\\n\",\"    ),\\n\",\"\\n\",\"    \\\"three_groups_per_identity\\\": bool(\\n\",\"        len(identity_group_counts) == 38\\n\",\"        and (identity_group_counts == 3).all()\\n\",\"    ),\\n\",\"\\n\",\"    \\\"euclidean_matrix_complete\\\": bool(\\n\",\"        not matrices[\\\"euclidean_mean\\\"].isna().any().any()\\n\",\"    ),\\n\",\"\\n\",\"    \\\"cosine_matrix_complete\\\": bool(\\n\",\"        not matrices[\\\"cosine_mean\\\"].isna().any().any()\\n\",\"    ),\\n\",\"\\n\",\"    \\\"friedman_results_count_valid\\\": bool(\\n\",\"        len(friedman_df) == 2\\n\",\"    ),\\n\",\"\\n\",\"    \\\"pairwise_results_count_valid\\\": bool(\\n\",\"        len(paired_df) == 6\\n\",\"    ),\\n\",\"\\n\",\"    \\\"holm_adjusted_values_valid\\\": bool(\\n\",\"        paired_df[\\\"holm_adjusted_p_value\\\"].between(\\n\",\"            0.0,\\n\",\"            1.0\\n\",\"        ).all()\\n\",\"    ),\\n\",\"\\n\",\"    \\\"confidence_intervals_valid\\\": bool(\\n\",\"        (\\n\",\"            paired_df[\\\"ci_95_lower\\\"]\\n\",\"            <= paired_df[\\\"ci_95_upper\\\"]\\n\",\"        ).all()\\n\",\"    ),\\n\",\"\\n\",\"    \\\"friedman_file_created\\\": bool(\\n\",\"        os.path.isfile(RESULTS_PATH)\\n\",\"    ),\\n\",\"\\n\",\"    \\\"paired_file_created\\\": bool(\\n\",\"        os.path.isfile(PAIRED_PATH)\\n\",\"    ),\\n\",\"\\n\",\"    \\\"all_result_values_finite\\\": bool(\\n\",\"        np.isfinite(\\n\",\"            friedman_df[\\n\",\"                [\\\"test_statistic\\\", \\\"p_value\\\", \\\"kendalls_w\\\"]\\n\",\"            ].to_numpy(dtype=float)\\n\",\"        ).all()\\n\",\"        and\\n\",\"        np.isfinite(\\n\",\"            paired_df[\\n\",\"                [\\n\",\"                    \\\"raw_p_value\\\",\\n\",\"                    \\\"holm_adjusted_p_value\\\",\\n\",\"                    \\\"ci_95_lower\\\",\\n\",\"                    \\\"ci_95_upper\\\"\\n\",\"                ]\\n\",\"            ].to_numpy(dtype=float)\\n\",\"        ).all()\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"audit_passed = bool(\\n\",\"    all(audit_checks.values())\\n\",\")\\n\",\"\\n\",\"audit = {\\n\",\"\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"step\\\": \\\"2.7.4\\\",\\n\",\"\\n\",\"    \\\"timestamp_utc\\\": datetime.now(\\n\",\"        timezone.utc\\n\",\"    ).isoformat(),\\n\",\"\\n\",\"    \\\"audit_status\\\": (\\n\",\"        \\\"PASSED\\\" if audit_passed else \\\"FAILED\\\"\\n\",\"    ),\\n\",\"\\n\",\"    \\\"audit_checks\\\": audit_checks,\\n\",\"\\n\",\"    \\\"identities\\\": EXPECTED_IDENTITIES,\\n\",\"\\n\",\"    \\\"repeated_measures_groups\\\": GROUPS,\\n\",\"\\n\",\"    \\\"friedman_results\\\": friedman_results,\\n\",\"\\n\",\"    \\\"pairwise_results\\\": paired_results,\\n\",\"\\n\",\"    \\\"bootstrap_results\\\": bootstrap_results,\\n\",\"\\n\",\"    \\\"bootstrap_iterations\\\": BOOTSTRAP_ITERATIONS,\\n\",\"\\n\",\"    \\\"random_seed\\\": RANDOM_SEED,\\n\",\"\\n\",\"    \\\"multiple_comparison_correction\\\": (\\n\",\"        \\\"Holm correction, separately within each metric\\\"\\n\",\"    ),\\n\",\"\\n\",\"    \\\"friedman_results_csv\\\": RESULTS_PATH,\\n\",\"\\n\",\"    \\\"friedman_results_sha256\\\": friedman_sha256,\\n\",\"\\n\",\"    \\\"paired_results_csv\\\": PAIRED_PATH,\\n\",\"\\n\",\"    \\\"paired_results_sha256\\\": paired_sha256,\\n\",\"\\n\",\"    \\\"interpretation_limitations\\\": [\\n\",\"        \\\"The repeated-measures unit is identity.\\\",\\n\",\"        \\\"Bootstrap resampling is performed at identity level.\\\",\\n\",\"        \\\"Statistical significance does not establish recognition accuracy.\\\",\\n\",\"        \\\"Statistical significance does not establish operational detector performance.\\\",\\n\",\"        \\\"Findings are limited to this dataset and embedding pipeline.\\\"\\n\",\"    ]\\n\",\"}\\n\",\"\\n\",\"# Convert all NumPy/Pandas scalar types before JSON output.\\n\",\"audit = make_json_serializable(audit)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 12. WRITE AND VERIFY JSON AUDIT\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"with open(\\n\",\"    AUDIT_PATH,\\n\",\"    \\\"w\\\",\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\") as f:\\n\",\"\\n\",\"    json.dump(\\n\",\"        audit,\\n\",\"        f,\\n\",\"        indent=2,\\n\",\"        allow_nan=False\\n\",\"    )\\n\",\"\\n\",\"# Reopen the JSON file to verify successful serialization.\\n\",\"with open(\\n\",\"    AUDIT_PATH,\\n\",\"    \\\"r\\\",\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\") as f:\\n\",\"\\n\",\"    saved_audit = json.load(f)\\n\",\"\\n\",\"assert saved_audit[\\\"audit_status\\\"] == (\\n\",\"    \\\"PASSED\\\" if audit_passed else \\\"FAILED\\\"\\n\",\")\\n\",\"\\n\",\"assert len(saved_audit[\\\"friedman_results\\\"]) == 2\\n\",\"assert len(saved_audit[\\\"pairwise_results\\\"]) == 6\\n\",\"assert len(saved_audit[\\\"bootstrap_results\\\"]) == 6\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 13. FINAL REPORT\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 2.7.4 — FINAL AUDIT\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"for name, passed in audit_checks.items():\\n\",\"\\n\",\"    print(\\n\",\"        name,\\n\",\"        \\\":\\\",\\n\",\"        \\\"PASS\\\" if passed else \\\"FAIL\\\"\\n\",\"    )\\n\",\"\\n\",\"print(\\n\",\"    \\\"\\\\nAudit status:\\\",\\n\",\"    \\\"PASSED\\\" if audit_passed else \\\"FAILED\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\nFriedman CSV:\\\", RESULTS_PATH)\\n\",\"print(\\\"Friedman SHA256:\\\", friedman_sha256)\\n\",\"\\n\",\"print(\\\"\\\\nPairwise CSV:\\\", PAIRED_PATH)\\n\",\"print(\\\"Pairwise SHA256:\\\", paired_sha256)\\n\",\"\\n\",\"print(\\\"\\\\nAudit JSON:\\\", AUDIT_PATH)\\n\",\"\\n\",\"print(\\n\",\"    \\\"Audit JSON serialization:\\\",\\n\",\"    \\\"PASS\\\" if os.path.isfile(AUDIT_PATH) else \\\"FAIL\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\nRepeated-measures unit: 38 identities.\\\")\\n\",\"print(\\\"Bootstrap resampling unit: identity.\\\")\\n\",\"print(\\\"Holm correction: separately within each metric.\\\")\\n\",\"print(\\\"No detector thresholds calibrated.\\\")\\n\",\"\\n\",\"assert audit_passed, (\\n\",\"    \\\"Step 2.7.4 audit failed. \\\"\\n\",\"    \\\"Do not proceed until resolved.\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\nSTEP 2.7.4 FINISHED\\\")\\n\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"teBAWCFqzski\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794353643504,\"user_tz\":360,\"elapsed\":436,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"9bb229d4-6cdd-4105-aaa9-6e7c123acd37\"},\"execution_count\":null,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"===========================================================================\\n\",\"STEP 1 — LOAD IDENTITY-LEVEL DATA\\n\",\"===========================================================================\\n\",\"Records: 114\\n\",\"Unique identities: 38\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 2 — BUILD REPEATED-MEASURES MATRICES\\n\",\"===========================================================================\\n\",\"Euclidean displacement | Shape: (38, 3)\\n\",\"Cosine distance | Shape: (38, 3)\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 3 — FRIEDMAN TESTS\\n\",\"===========================================================================\\n\",\"\\n\",\"Metric: Euclidean displacement\\n\",\"Friedman statistic: 76.0\\n\",\"p-value: 3.139132792048018e-17\\n\",\"Kendall's W: 1.0\\n\",\"\\n\",\"Metric: Cosine distance\\n\",\"Friedman statistic: 76.0\\n\",\"p-value: 3.139132792048018e-17\\n\",\"Kendall's W: 1.0\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 4 — PAIRED WILCOXON TESTS\\n\",\"===========================================================================\\n\",\"Euclidean displacement | near_frontal vs oblique | Mean difference: 0.3070787629434474 | p: 7.275957614183426e-12\\n\",\"Euclidean displacement | near_frontal vs large_angular_deviation | Mean difference: 0.716559742856737 | p: 7.275957614183426e-12\\n\",\"Euclidean displacement | oblique vs large_angular_deviation | Mean difference: 0.4094809799132894 | p: 7.275957614183426e-12\\n\",\"Cosine distance | near_frontal vs oblique | Mean difference: 0.1753972444096816 | p: 7.275957614183426e-12\\n\",\"Cosine distance | near_frontal vs large_angular_deviation | Mean difference: 0.5622185096315764 | p: 7.275957614183426e-12\\n\",\"Cosine distance | oblique vs large_angular_deviation | Mean difference: 0.3868212652218947 | p: 7.275957614183426e-12\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 5 — HOLM CORRECTION\\n\",\"===========================================================================\\n\",\"\\n\",\"Metric: Euclidean displacement\\n\",\"near_frontal vs oblique | Raw p: 7.275957614183426e-12 | Holm p: 2.1827872842550278e-11\\n\",\"near_frontal vs large_angular_deviation | Raw p: 7.275957614183426e-12 | Holm p: 2.1827872842550278e-11\\n\",\"oblique vs large_angular_deviation | Raw p: 7.275957614183426e-12 | Holm p: 2.1827872842550278e-11\\n\",\"\\n\",\"Metric: Cosine distance\\n\",\"near_frontal vs oblique | Raw p: 7.275957614183426e-12 | Holm p: 2.1827872842550278e-11\\n\",\"near_frontal vs large_angular_deviation | Raw p: 7.275957614183426e-12 | Holm p: 2.1827872842550278e-11\\n\",\"oblique vs large_angular_deviation | Raw p: 7.275957614183426e-12 | Holm p: 2.1827872842550278e-11\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 6 — PAIRED BOOTSTRAP CONFIDENCE INTERVALS\\n\",\"===========================================================================\\n\",\"Euclidean displacement | near_frontal vs oblique | Mean difference: 0.3070787629434474 | 95% CI: (np.float64(0.28554372613865525), np.float64(0.3284129675189776))\\n\",\"Euclidean displacement | near_frontal vs large_angular_deviation | Mean difference: 0.716559742856737 | 95% CI: (np.float64(0.6911098791235678), np.float64(0.7416894210654505))\\n\",\"Euclidean displacement | oblique vs large_angular_deviation | Mean difference: 0.4094809799132894 | 95% CI: (np.float64(0.38734599028273486), np.float64(0.4317609536506506))\\n\",\"Cosine distance | near_frontal vs oblique | Mean difference: 0.1753972444096816 | 95% CI: (np.float64(0.15908238138918693), np.float64(0.19170284975773966))\\n\",\"Cosine distance | near_frontal vs large_angular_deviation | Mean difference: 0.5622185096315764 | 95% CI: (np.float64(0.5363907564885046), np.float64(0.5883005031862603))\\n\",\"Cosine distance | oblique vs large_angular_deviation | Mean difference: 0.3868212652218947 | 95% CI: (np.float64(0.3649059712866757), np.float64(0.40832084536922303))\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 7 — CONSOLIDATE RESULTS\\n\",\"===========================================================================\\n\",\"\\n\",\"Friedman results:\\n\",\"        metric           metric_label     test  identities  groups  test_statistic      p_value  kendalls_w\\n\",\"euclidean_mean Euclidean displacement Friedman          38       3            76.0 3.139133e-17         1.0\\n\",\"   cosine_mean        Cosine distance Friedman          38       3            76.0 3.139133e-17         1.0\\n\",\"\\n\",\"Pairwise results:\\n\",\"        metric           metric_label      group_a                 group_b  identities  mean_group_a  mean_group_b  mean_paired_difference_b_minus_a  median_paired_difference_b_minus_a  wilcoxon_statistic  raw_p_value  holm_adjusted_p_value  significant_after_holm_0_05  ci_95_lower  ci_95_upper  bootstrap_iterations  random_seed\\n\",\"euclidean_mean Euclidean displacement near_frontal                 oblique          38      0.401897      0.708976                          0.307079                            0.297842                 0.0 7.275958e-12           2.182787e-11                         True     0.285544     0.328413                 20000      2026274\\n\",\"euclidean_mean Euclidean displacement near_frontal large_angular_deviation          38      0.401897      1.118457                          0.716560                            0.727658                 0.0 7.275958e-12           2.182787e-11                         True     0.691110     0.741689                 20000      2026274\\n\",\"euclidean_mean Euclidean displacement      oblique large_angular_deviation          38      0.708976      1.118457                          0.409481                            0.399250                 0.0 7.275958e-12           2.182787e-11                         True     0.387346     0.431761                 20000      2026274\\n\",\"   cosine_mean        Cosine distance near_frontal                 oblique          38      0.086877      0.262274                          0.175397                            0.176328                 0.0 7.275958e-12           2.182787e-11                         True     0.159082     0.191703                 20000      2026274\\n\",\"   cosine_mean        Cosine distance near_frontal large_angular_deviation          38      0.086877      0.649095                          0.562219                            0.556245                 0.0 7.275958e-12           2.182787e-11                         True     0.536391     0.588301                 20000      2026274\\n\",\"   cosine_mean        Cosine distance      oblique large_angular_deviation          38      0.262274      0.649095                          0.386821                            0.379792                 0.0 7.275958e-12           2.182787e-11                         True     0.364906     0.408321                 20000      2026274\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 8 — SAVE RESULTS\\n\",\"===========================================================================\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 9 — FINAL AUDIT\\n\",\"===========================================================================\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 2.7.4 — FINAL AUDIT\\n\",\"===========================================================================\\n\",\"input_file_exists : PASS\\n\",\"input_records_valid : PASS\\n\",\"38_unique_identities : PASS\\n\",\"three_groups_per_identity : PASS\\n\",\"euclidean_matrix_complete : PASS\\n\",\"cosine_matrix_complete : PASS\\n\",\"friedman_results_count_valid : PASS\\n\",\"pairwise_results_count_valid : PASS\\n\",\"holm_adjusted_values_valid : PASS\\n\",\"confidence_intervals_valid : PASS\\n\",\"friedman_file_created : PASS\\n\",\"paired_file_created : PASS\\n\",\"all_result_values_finite : PASS\\n\",\"\\n\",\"Audit status: PASSED\\n\",\"\\n\",\"Friedman CSV: /content/drive/MyDrive/Experiment_20_Results/step_2_7/repeated_measures_analysis/experiment20_repeated_measures_test_results.csv\\n\",\"Friedman SHA256: 254ced9f4ecdcd5103a8dbce033ae54b248df2558a111f5dc2b20a79b917601d\\n\",\"\\n\",\"Pairwise CSV: /content/drive/MyDrive/Experiment_20_Results/step_2_7/repeated_measures_analysis/experiment20_paired_comparison_results.csv\\n\",\"Pairwise SHA256: 56a04e265817173aa71dd89e79e71db9a9e74cd9cceef77285a0631fdb1fbffd\\n\",\"\\n\",\"Audit JSON: /content/drive/MyDrive/Experiment_20_Results/step_2_7/repeated_measures_analysis/experiment20_step274_repeated_measures_audit.json\\n\",\"Audit JSON serialization: PASS\\n\",\"\\n\",\"Repeated-measures unit: 38 identities.\\n\",\"Bootstrap resampling unit: identity.\\n\",\"Holm correction: separately within each metric.\\n\",\"No detector thresholds calibrated.\\n\",\"\\n\",\"STEP 2.7.4 FINISHED\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"\\n\",\"## Step 2.7.5 — Frontal versus Beyond-Frontal Hemisphere Analysis\\n\",\"\\n\",\"### Objective\\n\",\"Compare within-identity embedding displacement under frontal-hemisphere and beyond-frontal-hemisphere illumination conditions.\\n\",\"\\n\",\"### Input\\n\",\"The validated Step 2.7.2 displacement dataset.\\n\",\"\\n\",\"### Hemisphere groups\\n\",\"- Frontal hemisphere.\\n\",\"- Beyond-frontal hemisphere.\\n\",\"\\n\",\"The reference condition is excluded, as in the previous analyses.\\n\",\"\\n\",\"### Analysis unit\\n\",\"Identity-level mean displacement.\\n\",\"\\n\",\"For each of the 38 identities, calculate:\\n\",\"1. Mean Euclidean displacement under frontal-hemisphere conditions.\\n\",\"2. Mean Euclidean displacement under beyond-frontal-hemisphere conditions.\\n\",\"3. Mean cosine distance under frontal-hemisphere conditions.\\n\",\"4. Mean cosine distance under beyond-frontal-hemisphere conditions.\\n\",\"\\n\",\"### Statistical analysis\\n\",\"- Paired Wilcoxon signed-rank test for each metric.\\n\",\"- Paired mean differences.\\n\",\"- Holm correction across the two metric-level tests.\\n\",\"- 95% bootstrap confidence intervals, resampling identities.\\n\",\"\\n\",\"### Interpretation safeguards\\n\",\"- Each identity is the paired analysis unit.\\n\",\"- The two hemisphere groups have unequal numbers of illumination conditions.\\n\",\"- Hemisphere is associated with angular geometry; this analysis cannot isolate a pure hemisphere effect.\\n\",\"- Results are exploratory and specific to this dataset.\\n\",\"- No recognition accuracy or operational detection performance is claimed.\\n\",\"\\n\",\"### Outputs\\n\",\"1. Identity-level hemisphere means CSV.\\n\",\"2. Hemisphere comparison results CSV.\\n\",\"3. Step 2.7.5 audit JSON.\\n\",\"4. SHA256 checksums.\\n\"],\"metadata\":{\"id\":\"h7IRlosJ0Ja_\"}},{\"cell_type\":\"code\",\"source\":[\"\\n\",\"import os\\n\",\"import json\\n\",\"import hashlib\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"\\n\",\"from scipy.stats import wilcoxon\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 20 — STEP 2.7.5\\n\",\"# FRONTAL VS BEYOND-FRONTAL HEMISPHERE ANALYSIS\\n\",\"# ============================================================\\n\",\"\\n\",\"BASE = \\\"/content/drive/MyDrive/Experiment_20_Results\\\"\\n\",\"\\n\",\"INPUT_PATH = os.path.join(\\n\",\"    BASE,\\n\",\"    \\\"step_2_7\\\",\\n\",\"    \\\"displacement_analysis\\\",\\n\",\"    \\\"experiment20_reference_evaluation_displacement.csv\\\"\\n\",\")\\n\",\"\\n\",\"OUTPUT_DIR = os.path.join(\\n\",\"    BASE,\\n\",\"    \\\"step_2_7\\\",\\n\",\"    \\\"hemisphere_analysis\\\"\\n\",\")\\n\",\"\\n\",\"os.makedirs(OUTPUT_DIR, exist_ok=True)\\n\",\"\\n\",\"IDENTITY_OUTPUT_PATH = os.path.join(\\n\",\"    OUTPUT_DIR,\\n\",\"    \\\"experiment20_identity_level_hemisphere_means.csv\\\"\\n\",\")\\n\",\"\\n\",\"COMPARISON_OUTPUT_PATH = os.path.join(\\n\",\"    OUTPUT_DIR,\\n\",\"    \\\"experiment20_hemisphere_comparison_results.csv\\\"\\n\",\")\\n\",\"\\n\",\"AUDIT_PATH = os.path.join(\\n\",\"    OUTPUT_DIR,\\n\",\"    \\\"experiment20_step275_hemisphere_analysis_audit.json\\\"\\n\",\")\\n\",\"\\n\",\"EXPECTED_IDENTITIES = 38\\n\",\"EXPECTED_TOTAL_RECORDS = 2128\\n\",\"\\n\",\"EXPECTED_HEMISPHERE_CONDITIONS = {\\n\",\"    \\\"frontal_hemisphere\\\": 45,\\n\",\"    \\\"beyond_frontal_hemisphere\\\": 11\\n\",\"}\\n\",\"\\n\",\"EXPECTED_HEMISPHERE_OBSERVATIONS = {\\n\",\"    \\\"frontal_hemisphere\\\": 1710,\\n\",\"    \\\"beyond_frontal_hemisphere\\\": 418\\n\",\"}\\n\",\"\\n\",\"HEMISPHERES = [\\n\",\"    \\\"frontal_hemisphere\\\",\\n\",\"    \\\"beyond_frontal_hemisphere\\\"\\n\",\"]\\n\",\"\\n\",\"METRICS = {\\n\",\"    \\\"euclidean_displacement\\\": \\\"Euclidean displacement\\\",\\n\",\"    \\\"cosine_distance\\\": \\\"Cosine distance\\\"\\n\",\"}\\n\",\"\\n\",\"BOOTSTRAP_ITERATIONS = 20000\\n\",\"RANDOM_SEED = 2026275\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. LOAD INPUT DATA\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"STEP 1 — LOAD DISPLACEMENT DATA\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"assert os.path.isfile(INPUT_PATH), (\\n\",\"    \\\"Step 2.7.2 displacement CSV not found.\\\"\\n\",\")\\n\",\"\\n\",\"df = pd.read_csv(INPUT_PATH)\\n\",\"\\n\",\"print(\\\"Records:\\\", len(df))\\n\",\"print(\\\"Unique identities:\\\", df[\\\"subject\\\"].nunique())\\n\",\"\\n\",\"assert len(df) == EXPECTED_TOTAL_RECORDS\\n\",\"assert df[\\\"subject\\\"].nunique() == EXPECTED_IDENTITIES\\n\",\"\\n\",\"required_columns = [\\n\",\"    \\\"subject\\\",\\n\",\"    \\\"evaluation_condition\\\",\\n\",\"    \\\"hemisphere\\\",\\n\",\"    \\\"euclidean_displacement\\\",\\n\",\"    \\\"cosine_distance\\\"\\n\",\"]\\n\",\"\\n\",\"for column in required_columns:\\n\",\"    assert column in df.columns, (\\n\",\"        f\\\"Missing required column: {column}\\\"\\n\",\"    )\\n\",\"\\n\",\"assert not df.duplicated(\\n\",\"    subset=[\\\"subject\\\", \\\"evaluation_condition\\\"]\\n\",\").any()\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. VERIFY HEMISPHERE COUNTS\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 2 — HEMISPHERE COHORT VALIDATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"actual_condition_counts = (\\n\",\"    df.groupby(\\\"hemisphere\\\")[\\\"evaluation_condition\\\"]\\n\",\"    .nunique()\\n\",\"    .to_dict()\\n\",\")\\n\",\"\\n\",\"actual_observation_counts = (\\n\",\"    df[\\\"hemisphere\\\"]\\n\",\"    .value_counts()\\n\",\"    .to_dict()\\n\",\")\\n\",\"\\n\",\"for hemisphere in HEMISPHERES:\\n\",\"\\n\",\"    condition_count = int(\\n\",\"        actual_condition_counts.get(hemisphere, 0)\\n\",\"    )\\n\",\"\\n\",\"    observation_count = int(\\n\",\"        actual_observation_counts.get(hemisphere, 0)\\n\",\"    )\\n\",\"\\n\",\"    print(\\n\",\"        hemisphere,\\n\",\"        \\\"| Conditions:\\\",\\n\",\"        condition_count,\\n\",\"        \\\"| Observations:\\\",\\n\",\"        observation_count\\n\",\"    )\\n\",\"\\n\",\"    assert (\\n\",\"        condition_count\\n\",\"        == EXPECTED_HEMISPHERE_CONDITIONS[hemisphere]\\n\",\"    )\\n\",\"\\n\",\"    assert (\\n\",\"        observation_count\\n\",\"        == EXPECTED_HEMISPHERE_OBSERVATIONS[hemisphere]\\n\",\"    )\\n\",\"\\n\",\"assert set(df[\\\"hemisphere\\\"].unique()) == set(HEMISPHERES)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. BUILD IDENTITY-LEVEL HEMISPHERE MEANS\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 3 — IDENTITY-LEVEL AGGREGATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"identity_summary = (\\n\",\"    df.groupby(\\n\",\"        [\\\"subject\\\", \\\"hemisphere\\\"],\\n\",\"        observed=True\\n\",\"    )\\n\",\"    .agg(\\n\",\"        euclidean_mean=(\\n\",\"            \\\"euclidean_displacement\\\",\\n\",\"            \\\"mean\\\"\\n\",\"        ),\\n\",\"\\n\",\"        euclidean_median=(\\n\",\"            \\\"euclidean_displacement\\\",\\n\",\"            \\\"median\\\"\\n\",\"        ),\\n\",\"\\n\",\"        cosine_mean=(\\n\",\"            \\\"cosine_distance\\\",\\n\",\"            \\\"mean\\\"\\n\",\"        ),\\n\",\"\\n\",\"        cosine_median=(\\n\",\"            \\\"cosine_distance\\\",\\n\",\"            \\\"median\\\"\\n\",\"        ),\\n\",\"\\n\",\"        evaluation_conditions=(\\n\",\"            \\\"evaluation_condition\\\",\\n\",\"            \\\"nunique\\\"\\n\",\"        ),\\n\",\"\\n\",\"        observations=(\\n\",\"            \\\"evaluation_condition\\\",\\n\",\"            \\\"size\\\"\\n\",\"        )\\n\",\"    )\\n\",\"    .reset_index()\\n\",\")\\n\",\"\\n\",\"print(\\\"Identity-hemisphere records:\\\", len(identity_summary))\\n\",\"\\n\",\"assert len(identity_summary) == (\\n\",\"    EXPECTED_IDENTITIES * len(HEMISPHERES)\\n\",\")\\n\",\"\\n\",\"identity_counts = (\\n\",\"    identity_summary.groupby(\\\"hemisphere\\\")[\\\"subject\\\"]\\n\",\"    .nunique()\\n\",\"    .to_dict()\\n\",\")\\n\",\"\\n\",\"for hemisphere in HEMISPHERES:\\n\",\"    assert identity_counts[hemisphere] == EXPECTED_IDENTITIES\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. BUILD PAIRED MATRICES\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 4 — BUILD PAIRED IDENTITY MATRICES\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"subjects = sorted(\\n\",\"    identity_summary[\\\"subject\\\"].unique().tolist()\\n\",\")\\n\",\"\\n\",\"matrices = {}\\n\",\"\\n\",\"metric_column_mapping = {\\n\",\"    \\\"euclidean_displacement\\\": \\\"euclidean_mean\\\",\\n\",\"    \\\"cosine_distance\\\": \\\"cosine_mean\\\"\\n\",\"}\\n\",\"\\n\",\"for metric, column in metric_column_mapping.items():\\n\",\"\\n\",\"    matrix = (\\n\",\"        identity_summary.pivot(\\n\",\"            index=\\\"subject\\\",\\n\",\"            columns=\\\"hemisphere\\\",\\n\",\"            values=column\\n\",\"        )\\n\",\"        .reindex(\\n\",\"            index=subjects,\\n\",\"            columns=HEMISPHERES\\n\",\"        )\\n\",\"    )\\n\",\"\\n\",\"    assert matrix.shape == (\\n\",\"        EXPECTED_IDENTITIES,\\n\",\"        2\\n\",\"    )\\n\",\"\\n\",\"    assert not matrix.isna().any().any()\\n\",\"\\n\",\"    assert np.isfinite(\\n\",\"        matrix.to_numpy(dtype=float)\\n\",\"    ).all()\\n\",\"\\n\",\"    matrices[metric] = matrix\\n\",\"\\n\",\"    print(\\n\",\"        METRICS[metric],\\n\",\"        \\\"| Shape:\\\",\\n\",\"        matrix.shape\\n\",\"    )\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. PAIRED WILCOXON TESTS\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 5 — PAIRED WILCOXON TESTS\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"comparison_results = []\\n\",\"\\n\",\"for metric, label in METRICS.items():\\n\",\"\\n\",\"    matrix = matrices[metric]\\n\",\"\\n\",\"    frontal_values = matrix[\\n\",\"        \\\"frontal_hemisphere\\\"\\n\",\"    ].to_numpy(dtype=float)\\n\",\"\\n\",\"    beyond_values = matrix[\\n\",\"        \\\"beyond_frontal_hemisphere\\\"\\n\",\"    ].to_numpy(dtype=float)\\n\",\"\\n\",\"    differences = (\\n\",\"        beyond_values - frontal_values\\n\",\"    )\\n\",\"\\n\",\"    if np.allclose(\\n\",\"        differences,\\n\",\"        0.0,\\n\",\"        rtol=0,\\n\",\"        atol=1e-14\\n\",\"    ):\\n\",\"\\n\",\"        statistic = 0.0\\n\",\"        p_value = 1.0\\n\",\"\\n\",\"    else:\\n\",\"\\n\",\"        test_result = wilcoxon(\\n\",\"            beyond_values,\\n\",\"            frontal_values,\\n\",\"            alternative=\\\"two-sided\\\",\\n\",\"            zero_method=\\\"wilcox\\\",\\n\",\"            method=\\\"auto\\\"\\n\",\"        )\\n\",\"\\n\",\"        statistic = float(\\n\",\"            test_result.statistic\\n\",\"        )\\n\",\"\\n\",\"        p_value = float(\\n\",\"            test_result.pvalue\\n\",\"        )\\n\",\"\\n\",\"    result = {\\n\",\"\\n\",\"        \\\"metric\\\": metric,\\n\",\"\\n\",\"        \\\"metric_label\\\": label,\\n\",\"\\n\",\"        \\\"test\\\": \\\"Paired Wilcoxon signed-rank\\\",\\n\",\"\\n\",\"        \\\"identities\\\": EXPECTED_IDENTITIES,\\n\",\"\\n\",\"        \\\"mean_frontal\\\": float(\\n\",\"            np.mean(frontal_values)\\n\",\"        ),\\n\",\"\\n\",\"        \\\"mean_beyond_frontal\\\": float(\\n\",\"            np.mean(beyond_values)\\n\",\"        ),\\n\",\"\\n\",\"        \\\"mean_paired_difference_beyond_minus_frontal\\\": float(\\n\",\"            np.mean(differences)\\n\",\"        ),\\n\",\"\\n\",\"        \\\"median_paired_difference_beyond_minus_frontal\\\": float(\\n\",\"            np.median(differences)\\n\",\"        ),\\n\",\"\\n\",\"        \\\"wilcoxon_statistic\\\": statistic,\\n\",\"\\n\",\"        \\\"raw_p_value\\\": p_value\\n\",\"    }\\n\",\"\\n\",\"    comparison_results.append(result)\\n\",\"\\n\",\"    print(\\\"\\\\nMetric:\\\", label)\\n\",\"\\n\",\"    print(\\n\",\"        \\\"Mean frontal:\\\",\\n\",\"        result[\\\"mean_frontal\\\"]\\n\",\"    )\\n\",\"\\n\",\"    print(\\n\",\"        \\\"Mean beyond-frontal:\\\",\\n\",\"        result[\\\"mean_beyond_frontal\\\"]\\n\",\"    )\\n\",\"\\n\",\"    print(\\n\",\"        \\\"Mean paired difference:\\\",\\n\",\"        result[\\\"mean_paired_difference_beyond_minus_frontal\\\"]\\n\",\"    )\\n\",\"\\n\",\"    print(\\\"Wilcoxon statistic:\\\", statistic)\\n\",\"    print(\\\"Raw p-value:\\\", p_value)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. HOLM CORRECTION\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 6 — HOLM MULTIPLE-COMPARISON CORRECTION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"def holm_adjust(p_values):\\n\",\"\\n\",\"    p_values = np.asarray(\\n\",\"        p_values,\\n\",\"        dtype=float\\n\",\"    )\\n\",\"\\n\",\"    m = len(p_values)\\n\",\"    order = np.argsort(p_values)\\n\",\"\\n\",\"    adjusted = np.empty(m, dtype=float)\\n\",\"    running_max = 0.0\\n\",\"\\n\",\"    for rank, original_index in enumerate(order):\\n\",\"\\n\",\"        value = (\\n\",\"            (m - rank)\\n\",\"            * p_values[original_index]\\n\",\"        )\\n\",\"\\n\",\"        running_max = max(\\n\",\"            running_max,\\n\",\"            value\\n\",\"        )\\n\",\"\\n\",\"        adjusted[original_index] = min(\\n\",\"            running_max,\\n\",\"            1.0\\n\",\"        )\\n\",\"\\n\",\"    return adjusted\\n\",\"\\n\",\"\\n\",\"raw_p_values = [\\n\",\"    result[\\\"raw_p_value\\\"]\\n\",\"    for result in comparison_results\\n\",\"]\\n\",\"\\n\",\"adjusted_p_values = holm_adjust(\\n\",\"    raw_p_values\\n\",\")\\n\",\"\\n\",\"for result, adjusted_p in zip(\\n\",\"    comparison_results,\\n\",\"    adjusted_p_values\\n\",\"):\\n\",\"\\n\",\"    result[\\\"holm_adjusted_p_value\\\"] = float(\\n\",\"        adjusted_p\\n\",\"    )\\n\",\"\\n\",\"    result[\\\"significant_after_holm_0_05\\\"] = bool(\\n\",\"        adjusted_p < 0.05\\n\",\"    )\\n\",\"\\n\",\"    print(\\n\",\"        result[\\\"metric_label\\\"],\\n\",\"        \\\"| Raw p:\\\",\\n\",\"        result[\\\"raw_p_value\\\"],\\n\",\"        \\\"| Holm p:\\\",\\n\",\"        result[\\\"holm_adjusted_p_value\\\"]\\n\",\"    )\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. IDENTITY-LEVEL BOOTSTRAP CONFIDENCE INTERVALS\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 7 — PAIRED BOOTSTRAP CONFIDENCE INTERVALS\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"rng = np.random.default_rng(\\n\",\"    RANDOM_SEED\\n\",\")\\n\",\"\\n\",\"bootstrap_results = []\\n\",\"\\n\",\"for metric, label in METRICS.items():\\n\",\"\\n\",\"    matrix = matrices[metric]\\n\",\"\\n\",\"    frontal_values = matrix[\\n\",\"        \\\"frontal_hemisphere\\\"\\n\",\"    ].to_numpy(dtype=float)\\n\",\"\\n\",\"    beyond_values = matrix[\\n\",\"        \\\"beyond_frontal_hemisphere\\\"\\n\",\"    ].to_numpy(dtype=float)\\n\",\"\\n\",\"    differences = (\\n\",\"        beyond_values - frontal_values\\n\",\"    )\\n\",\"\\n\",\"    bootstrap_indices = rng.integers(\\n\",\"        0,\\n\",\"        EXPECTED_IDENTITIES,\\n\",\"        size=(\\n\",\"            BOOTSTRAP_ITERATIONS,\\n\",\"            EXPECTED_IDENTITIES\\n\",\"        )\\n\",\"    )\\n\",\"\\n\",\"    bootstrap_means = differences[\\n\",\"        bootstrap_indices\\n\",\"    ].mean(axis=1)\\n\",\"\\n\",\"    ci_lower, ci_upper = np.percentile(\\n\",\"        bootstrap_means,\\n\",\"        [2.5, 97.5]\\n\",\"    )\\n\",\"\\n\",\"    result = {\\n\",\"\\n\",\"        \\\"metric\\\": metric,\\n\",\"\\n\",\"        \\\"bootstrap_iterations\\\": BOOTSTRAP_ITERATIONS,\\n\",\"\\n\",\"        \\\"random_seed\\\": RANDOM_SEED,\\n\",\"\\n\",\"        \\\"mean_paired_difference_beyond_minus_frontal\\\": float(\\n\",\"            differences.mean()\\n\",\"        ),\\n\",\"\\n\",\"        \\\"ci_95_lower\\\": float(ci_lower),\\n\",\"\\n\",\"        \\\"ci_95_upper\\\": float(ci_upper)\\n\",\"    }\\n\",\"\\n\",\"    bootstrap_results.append(result)\\n\",\"\\n\",\"    print(\\\"\\\\nMetric:\\\", label)\\n\",\"\\n\",\"    print(\\n\",\"        \\\"Mean paired difference:\\\",\\n\",\"        differences.mean()\\n\",\"    )\\n\",\"\\n\",\"    print(\\n\",\"        \\\"95% bootstrap CI:\\\",\\n\",\"        (ci_lower, ci_upper)\\n\",\"    )\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 8. CONSOLIDATE RESULTS\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 8 — CONSOLIDATE RESULTS\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"comparison_df = pd.DataFrame(\\n\",\"    comparison_results\\n\",\")\\n\",\"\\n\",\"bootstrap_df = pd.DataFrame(\\n\",\"    bootstrap_results\\n\",\")\\n\",\"\\n\",\"comparison_df = comparison_df.merge(\\n\",\"    bootstrap_df[\\n\",\"        [\\n\",\"            \\\"metric\\\",\\n\",\"            \\\"ci_95_lower\\\",\\n\",\"            \\\"ci_95_upper\\\",\\n\",\"            \\\"bootstrap_iterations\\\",\\n\",\"            \\\"random_seed\\\"\\n\",\"        ]\\n\",\"    ],\\n\",\"    on=\\\"metric\\\",\\n\",\"    how=\\\"left\\\",\\n\",\"    validate=\\\"one_to_one\\\"\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    comparison_df.to_string(index=False)\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 9. SAVE CSV OUTPUTS\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 9 — SAVE OUTPUTS\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"identity_summary.to_csv(\\n\",\"    IDENTITY_OUTPUT_PATH,\\n\",\"    index=False,\\n\",\"    float_format=\\\"%.12g\\\"\\n\",\")\\n\",\"\\n\",\"comparison_df.to_csv(\\n\",\"    COMPARISON_OUTPUT_PATH,\\n\",\"    index=False,\\n\",\"    float_format=\\\"%.12g\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"Identity summary:\\\", IDENTITY_OUTPUT_PATH)\\n\",\"print(\\\"Comparison results:\\\", COMPARISON_OUTPUT_PATH)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 10. SHA256 CHECKSUMS\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"def sha256_file(path):\\n\",\"\\n\",\"    digest = hashlib.sha256()\\n\",\"\\n\",\"    with open(path, \\\"rb\\\") as f:\\n\",\"\\n\",\"        for chunk in iter(\\n\",\"            lambda: f.read(1024 * 1024),\\n\",\"            b\\\"\\\"\\n\",\"        ):\\n\",\"            digest.update(chunk)\\n\",\"\\n\",\"    return digest.hexdigest()\\n\",\"\\n\",\"\\n\",\"identity_sha256 = sha256_file(\\n\",\"    IDENTITY_OUTPUT_PATH\\n\",\")\\n\",\"\\n\",\"comparison_sha256 = sha256_file(\\n\",\"    COMPARISON_OUTPUT_PATH\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 11. FINAL AUDIT\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 10 — FINAL AUDIT\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"audit_checks = {\\n\",\"\\n\",\"    \\\"input_file_exists\\\": bool(\\n\",\"        os.path.isfile(INPUT_PATH)\\n\",\"    ),\\n\",\"\\n\",\"    \\\"input_record_count_valid\\\": bool(\\n\",\"        len(df) == EXPECTED_TOTAL_RECORDS\\n\",\"    ),\\n\",\"\\n\",\"    \\\"identity_count_valid\\\": bool(\\n\",\"        df[\\\"subject\\\"].nunique() == EXPECTED_IDENTITIES\\n\",\"    ),\\n\",\"\\n\",\"    \\\"hemisphere_condition_counts_valid\\\": bool(\\n\",\"        actual_condition_counts\\n\",\"        == EXPECTED_HEMISPHERE_CONDITIONS\\n\",\"    ),\\n\",\"\\n\",\"    \\\"hemisphere_observation_counts_valid\\\": bool(\\n\",\"        actual_observation_counts\\n\",\"        == EXPECTED_HEMISPHERE_OBSERVATIONS\\n\",\"    ),\\n\",\"\\n\",\"    \\\"identity_hemisphere_record_count_valid\\\": bool(\\n\",\"        len(identity_summary) == 76\\n\",\"    ),\\n\",\"\\n\",\"    \\\"all_identities_in_both_hemispheres\\\": bool(\\n\",\"        all(\\n\",\"            identity_counts[h] == EXPECTED_IDENTITIES\\n\",\"            for h in HEMISPHERES\\n\",\"        )\\n\",\"    ),\\n\",\"\\n\",\"    \\\"paired_matrices_complete\\\": bool(\\n\",\"        all(\\n\",\"            not matrix.isna().any().any()\\n\",\"            for matrix in matrices.values()\\n\",\"        )\\n\",\"    ),\\n\",\"\\n\",\"    \\\"comparison_results_count_valid\\\": bool(\\n\",\"        len(comparison_df) == 2\\n\",\"    ),\\n\",\"\\n\",\"    \\\"holm_adjusted_p_values_valid\\\": bool(\\n\",\"        comparison_df[\\\"holm_adjusted_p_value\\\"].between(\\n\",\"            0.0,\\n\",\"            1.0\\n\",\"        ).all()\\n\",\"    ),\\n\",\"\\n\",\"    \\\"confidence_intervals_valid\\\": bool(\\n\",\"        (\\n\",\"            comparison_df[\\\"ci_95_lower\\\"]\\n\",\"            <= comparison_df[\\\"ci_95_upper\\\"]\\n\",\"        ).all()\\n\",\"    ),\\n\",\"\\n\",\"    \\\"identity_csv_created\\\": bool(\\n\",\"        os.path.isfile(IDENTITY_OUTPUT_PATH)\\n\",\"    ),\\n\",\"\\n\",\"    \\\"comparison_csv_created\\\": bool(\\n\",\"        os.path.isfile(COMPARISON_OUTPUT_PATH)\\n\",\"    ),\\n\",\"\\n\",\"    \\\"all_statistical_values_finite\\\": bool(\\n\",\"        np.isfinite(\\n\",\"            comparison_df[\\n\",\"                [\\n\",\"                    \\\"raw_p_value\\\",\\n\",\"                    \\\"holm_adjusted_p_value\\\",\\n\",\"                    \\\"mean_paired_difference_beyond_minus_frontal\\\",\\n\",\"                    \\\"ci_95_lower\\\",\\n\",\"                    \\\"ci_95_upper\\\"\\n\",\"                ]\\n\",\"            ].to_numpy(dtype=float)\\n\",\"        ).all()\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"audit_passed = bool(\\n\",\"    all(audit_checks.values())\\n\",\")\\n\",\"\\n\",\"audit = {\\n\",\"\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"\\n\",\"    \\\"step\\\": \\\"2.7.5\\\",\\n\",\"\\n\",\"    \\\"timestamp_utc\\\": datetime.now(\\n\",\"        timezone.utc\\n\",\"    ).isoformat(),\\n\",\"\\n\",\"    \\\"audit_status\\\": (\\n\",\"        \\\"PASSED\\\" if audit_passed else \\\"FAILED\\\"\\n\",\"    ),\\n\",\"\\n\",\"    \\\"audit_checks\\\": audit_checks,\\n\",\"\\n\",\"    \\\"identities\\\": EXPECTED_IDENTITIES,\\n\",\"\\n\",\"    \\\"hemisphere_condition_counts\\\": (\\n\",\"        actual_condition_counts\\n\",\"    ),\\n\",\"\\n\",\"    \\\"hemisphere_observation_counts\\\": (\\n\",\"        actual_observation_counts\\n\",\"    ),\\n\",\"\\n\",\"    \\\"comparison_results\\\": comparison_results,\\n\",\"\\n\",\"    \\\"bootstrap_results\\\": bootstrap_results,\\n\",\"\\n\",\"    \\\"bootstrap_iterations\\\": BOOTSTRAP_ITERATIONS,\\n\",\"\\n\",\"    \\\"random_seed\\\": RANDOM_SEED,\\n\",\"\\n\",\"    \\\"multiple_comparison_correction\\\": (\\n\",\"        \\\"Holm correction across the two metric-level tests\\\"\\n\",\"    ),\\n\",\"\\n\",\"    \\\"identity_summary_csv\\\": IDENTITY_OUTPUT_PATH,\\n\",\"\\n\",\"    \\\"identity_summary_sha256\\\": identity_sha256,\\n\",\"\\n\",\"    \\\"comparison_results_csv\\\": COMPARISON_OUTPUT_PATH,\\n\",\"\\n\",\"    \\\"comparison_results_sha256\\\": comparison_sha256,\\n\",\"\\n\",\"    \\\"interpretation_limitations\\\": [\\n\",\"        \\\"Identity is the paired analysis unit.\\\",\\n\",\"        \\\"The frontal and beyond-frontal groups have unequal condition counts.\\\",\\n\",\"        \\\"Hemisphere is associated with angular geometry.\\\",\\n\",\"        \\\"This exploratory analysis cannot isolate a pure hemisphere effect.\\\",\\n\",\"        \\\"Results do not establish recognition accuracy or operational detection performance.\\\"\\n\",\"    ]\\n\",\"}\\n\",\"\\n\",\"# Ensure NumPy and Pandas scalar types are JSON-safe.\\n\",\"def make_json_serializable(obj):\\n\",\"\\n\",\"    if isinstance(obj, dict):\\n\",\"        return {\\n\",\"            str(k): make_json_serializable(v)\\n\",\"            for k, v in obj.items()\\n\",\"        }\\n\",\"\\n\",\"    if isinstance(obj, (list, tuple)):\\n\",\"        return [\\n\",\"            make_json_serializable(v)\\n\",\"            for v in obj\\n\",\"        ]\\n\",\"\\n\",\"    if isinstance(obj, np.ndarray):\\n\",\"        return make_json_serializable(obj.tolist())\\n\",\"\\n\",\"    if isinstance(obj, np.generic):\\n\",\"        return make_json_serializable(obj.item())\\n\",\"\\n\",\"    if isinstance(obj, bool):\\n\",\"        return bool(obj)\\n\",\"\\n\",\"    if isinstance(obj, (int, float, str)) or obj is None:\\n\",\"        return obj\\n\",\"\\n\",\"    return str(obj)\\n\",\"\\n\",\"\\n\",\"audit = make_json_serializable(audit)\\n\",\"\\n\",\"with open(\\n\",\"    AUDIT_PATH,\\n\",\"    \\\"w\\\",\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\") as f:\\n\",\"\\n\",\"    json.dump(\\n\",\"        audit,\\n\",\"        f,\\n\",\"        indent=2,\\n\",\"        allow_nan=False\\n\",\"    )\\n\",\"\\n\",\"# Reopen to verify valid JSON.\\n\",\"with open(\\n\",\"    AUDIT_PATH,\\n\",\"    \\\"r\\\",\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\") as f:\\n\",\"\\n\",\"    saved_audit = json.load(f)\\n\",\"\\n\",\"assert saved_audit[\\\"audit_status\\\"] == (\\n\",\"    \\\"PASSED\\\" if audit_passed else \\\"FAILED\\\"\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 12. FINAL REPORT\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 2.7.5 — FINAL AUDIT\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"for name, passed in audit_checks.items():\\n\",\"\\n\",\"    print(\\n\",\"        name,\\n\",\"        \\\":\\\",\\n\",\"        \\\"PASS\\\" if passed else \\\"FAIL\\\"\\n\",\"    )\\n\",\"\\n\",\"print(\\n\",\"    \\\"\\\\nAudit status:\\\",\\n\",\"    \\\"PASSED\\\" if audit_passed else \\\"FAILED\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\nIdentity CSV SHA256:\\\")\\n\",\"print(identity_sha256)\\n\",\"\\n\",\"print(\\\"\\\\nComparison CSV SHA256:\\\")\\n\",\"print(comparison_sha256)\\n\",\"\\n\",\"print(\\\"\\\\nAudit JSON:\\\")\\n\",\"print(AUDIT_PATH)\\n\",\"\\n\",\"print(\\\"\\\\nIdentity-level paired analysis: 38 identities.\\\")\\n\",\"print(\\\"Bootstrap resampling unit: identity.\\\")\\n\",\"print(\\\"Holm correction applied across two tests.\\\")\\n\",\"print(\\\"No detector thresholds calibrated.\\\")\\n\",\"\\n\",\"assert audit_passed, (\\n\",\"    \\\"Step 2.7.5 audit failed. \\\"\\n\",\"    \\\"Do not proceed until resolved.\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\nSTEP 2.7.5 FINISHED\\\")\\n\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"qdCWgEHF0LRL\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794353709447,\"user_tz\":360,\"elapsed\":639,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"7c00e889-2af6-4392-df7f-30f6be15d6ba\"},\"execution_count\":null,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"===========================================================================\\n\",\"STEP 1 — LOAD DISPLACEMENT DATA\\n\",\"===========================================================================\\n\",\"Records: 2128\\n\",\"Unique identities: 38\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 2 — HEMISPHERE COHORT VALIDATION\\n\",\"===========================================================================\\n\",\"frontal_hemisphere | Conditions: 45 | Observations: 1710\\n\",\"beyond_frontal_hemisphere | Conditions: 11 | Observations: 418\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 3 — IDENTITY-LEVEL AGGREGATION\\n\",\"===========================================================================\\n\",\"Identity-hemisphere records: 76\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 4 — BUILD PAIRED IDENTITY MATRICES\\n\",\"===========================================================================\\n\",\"Euclidean displacement | Shape: (38, 2)\\n\",\"Cosine distance | Shape: (38, 2)\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 5 — PAIRED WILCOXON TESTS\\n\",\"===========================================================================\\n\",\"\\n\",\"Metric: Euclidean displacement\\n\",\"Mean frontal: 0.7062201499035649\\n\",\"Mean beyond-frontal: 1.2879898951855027\\n\",\"Mean paired difference: 0.5817697452819375\\n\",\"Wilcoxon statistic: 0.0\\n\",\"Raw p-value: 7.275957614183426e-12\\n\",\"\\n\",\"Metric: Cosine distance\\n\",\"Mean frontal: 0.29581613376952953\\n\",\"Mean beyond-frontal: 0.838623580414268\\n\",\"Mean paired difference: 0.5428074466447383\\n\",\"Wilcoxon statistic: 0.0\\n\",\"Raw p-value: 7.275957614183426e-12\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 6 — HOLM MULTIPLE-COMPARISON CORRECTION\\n\",\"===========================================================================\\n\",\"Euclidean displacement | Raw p: 7.275957614183426e-12 | Holm p: 1.4551915228366852e-11\\n\",\"Cosine distance | Raw p: 7.275957614183426e-12 | Holm p: 1.4551915228366852e-11\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 7 — PAIRED BOOTSTRAP CONFIDENCE INTERVALS\\n\",\"===========================================================================\\n\",\"\\n\",\"Metric: Euclidean displacement\\n\",\"Mean paired difference: 0.5817697452819375\\n\",\"95% bootstrap CI: (np.float64(0.5619855482971955), np.float64(0.6019542941366831))\\n\",\"\\n\",\"Metric: Cosine distance\\n\",\"Mean paired difference: 0.5428074466447383\\n\",\"95% bootstrap CI: (np.float64(0.516419233513524), np.float64(0.5685162487133432))\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 8 — CONSOLIDATE RESULTS\\n\",\"===========================================================================\\n\",\"                metric           metric_label                        test  identities  mean_frontal  mean_beyond_frontal  mean_paired_difference_beyond_minus_frontal  median_paired_difference_beyond_minus_frontal  wilcoxon_statistic  raw_p_value  holm_adjusted_p_value  significant_after_holm_0_05  ci_95_lower  ci_95_upper  bootstrap_iterations  random_seed\\n\",\"euclidean_displacement Euclidean displacement Paired Wilcoxon signed-rank          38      0.706220             1.287990                                     0.581770                                       0.593804                 0.0 7.275958e-12           1.455192e-11                         True     0.561986     0.601954                 20000      2026275\\n\",\"       cosine_distance        Cosine distance Paired Wilcoxon signed-rank          38      0.295816             0.838624                                     0.542807                                       0.570499                 0.0 7.275958e-12           1.455192e-11                         True     0.516419     0.568516                 20000      2026275\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 9 — SAVE OUTPUTS\\n\",\"===========================================================================\\n\",\"Identity summary: /content/drive/MyDrive/Experiment_20_Results/step_2_7/hemisphere_analysis/experiment20_identity_level_hemisphere_means.csv\\n\",\"Comparison results: /content/drive/MyDrive/Experiment_20_Results/step_2_7/hemisphere_analysis/experiment20_hemisphere_comparison_results.csv\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 10 — FINAL AUDIT\\n\",\"===========================================================================\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 2.7.5 — FINAL AUDIT\\n\",\"===========================================================================\\n\",\"input_file_exists : PASS\\n\",\"input_record_count_valid : PASS\\n\",\"identity_count_valid : PASS\\n\",\"hemisphere_condition_counts_valid : PASS\\n\",\"hemisphere_observation_counts_valid : PASS\\n\",\"identity_hemisphere_record_count_valid : PASS\\n\",\"all_identities_in_both_hemispheres : PASS\\n\",\"paired_matrices_complete : PASS\\n\",\"comparison_results_count_valid : PASS\\n\",\"holm_adjusted_p_values_valid : PASS\\n\",\"confidence_intervals_valid : PASS\\n\",\"identity_csv_created : PASS\\n\",\"comparison_csv_created : PASS\\n\",\"all_statistical_values_finite : PASS\\n\",\"\\n\",\"Audit status: PASSED\\n\",\"\\n\",\"Identity CSV SHA256:\\n\",\"9b47e10b4c5a5b7a02e4d0370078a12068a740be73d5b3f8ccce1f766a96e99d\\n\",\"\\n\",\"Comparison CSV SHA256:\\n\",\"72e2db7a59abb4e142b8c0663f75ac07022d2968a07824ab6ba1416ae79a1982\\n\",\"\\n\",\"Audit JSON:\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_2_7/hemisphere_analysis/experiment20_step275_hemisphere_analysis_audit.json\\n\",\"\\n\",\"Identity-level paired analysis: 38 identities.\\n\",\"Bootstrap resampling unit: identity.\\n\",\"Holm correction applied across two tests.\\n\",\"No detector thresholds calibrated.\\n\",\"\\n\",\"STEP 2.7.5 FINISHED\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Step 2.7.6 — Research Figures and Visualisation\\n\",\"\\n\",\"## Objective\\n\",\"\\n\",\"Generate publication-oriented figures for Experiment 20 using the completed identity-level descriptive and inferential results.\\n\",\"\\n\",\"## Input datasets\\n\",\"\\n\",\"1. `experiment20_identity_level_group_means.csv`\\n\",\"2. `experiment20_identity_level_hemisphere_means.csv`\\n\",\"\\n\",\"## Figures\\n\",\"\\n\",\"1. Euclidean displacement across near-frontal, oblique, and large-angular-deviation illumination groups.\\n\",\"2. Cosine distance across near-frontal, oblique, and large-angular-deviation illumination groups.\\n\",\"3. Paired identity-level Euclidean displacement: frontal versus beyond-frontal hemisphere.\\n\",\"4. Paired identity-level cosine distance: frontal versus beyond-frontal hemisphere.\\n\",\"\\n\",\"## Visualisation rules\\n\",\"\\n\",\"- Use identity-level means rather than treating individual image-condition observations as independent subjects.\\n\",\"- Show the individual identity values.\\n\",\"- Connect measurements from the same identity in paired plots.\\n\",\"- Preserve the established illumination-group ordering.\\n\",\"- Do not imply that the figures establish recognition accuracy, operational detection performance, or causal effects.\\n\",\"- Do not introduce new statistical tests in this visualisation step.\\n\",\"\\n\",\"## Output\\n\",\"\\n\",\"Save all four figures as high-resolution PNG files in:\\n\",\"\\n\",\"`Experiment_20_Results/step_2_7/figures/`\\n\",\"\\n\",\"Save a figure-generation audit JSON alongside them.\\n\",\"\\n\",\"## Completion criteria\\n\",\"\\n\",\"- Both input CSV files exist and load successfully.\\n\",\"- Each input contains 38 unique identities.\\n\",\"- All expected groups are present.\\n\",\"- Four PNG figures are generated and non-empty.\\n\",\"- Figure dimensions and file hashes are recorded.\\n\",\"- The audit JSON is saved and successfully reloaded.\"],\"metadata\":{\"id\":\"DNWwmSlC0W0B\"}},{\"cell_type\":\"code\",\"source\":[\"\\n\",\"import os\\n\",\"import json\\n\",\"import hashlib\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"import matplotlib.pyplot as plt\\n\",\"from pathlib import Path\\n\",\"\\n\",\"# ============================================================\\n\",\"# STEP 2.7.6 — CORRECTED FIGURE GENERATION\\n\",\"# ============================================================\\n\",\"\\n\",\"BASE_DIR = Path(\\\"/content/drive/MyDrive/Experiment_20_Results/step_2_7\\\")\\n\",\"\\n\",\"GROUP_FILE = (\\n\",\"    BASE_DIR / \\\"group_descriptive_analysis\\\" /\\n\",\"    \\\"experiment20_identity_level_group_means.csv\\\"\\n\",\")\\n\",\"\\n\",\"HEMISPHERE_FILE = (\\n\",\"    BASE_DIR / \\\"hemisphere_analysis\\\" /\\n\",\"    \\\"experiment20_identity_level_hemisphere_means.csv\\\"\\n\",\")\\n\",\"\\n\",\"OUTPUT_DIR = BASE_DIR / \\\"figures\\\"\\n\",\"OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"STEP 1 — LOAD INPUT DATA\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"assert GROUP_FILE.exists(), f\\\"Missing: {GROUP_FILE}\\\"\\n\",\"assert HEMISPHERE_FILE.exists(), f\\\"Missing: {HEMISPHERE_FILE}\\\"\\n\",\"\\n\",\"group_df = pd.read_csv(GROUP_FILE)\\n\",\"hemisphere_df = pd.read_csv(HEMISPHERE_FILE)\\n\",\"\\n\",\"print(\\\"Group records:\\\", len(group_df))\\n\",\"print(\\\"Hemisphere records:\\\", len(hemisphere_df))\\n\",\"print(\\\"Group columns:\\\", group_df.columns.tolist())\\n\",\"print(\\\"Hemisphere columns:\\\", hemisphere_df.columns.tolist())\\n\",\"\\n\",\"\\n\",\"# ============================================================\\n\",\"# STEP 2 — VALIDATE ACTUAL CSV SCHEMA\\n\",\"# ============================================================\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 2 — VALIDATE DATA STRUCTURE\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"required_group = {\\n\",\"    \\\"subject\\\", \\\"illumination_group\\\",\\n\",\"    \\\"euclidean_mean\\\", \\\"cosine_mean\\\"\\n\",\"}\\n\",\"\\n\",\"required_hemisphere = {\\n\",\"    \\\"subject\\\", \\\"hemisphere\\\",\\n\",\"    \\\"euclidean_mean\\\", \\\"cosine_mean\\\"\\n\",\"}\\n\",\"\\n\",\"assert required_group.issubset(group_df.columns), (\\n\",\"    f\\\"Missing group columns: {required_group - set(group_df.columns)}\\\"\\n\",\")\\n\",\"\\n\",\"assert required_hemisphere.issubset(hemisphere_df.columns), (\\n\",\"    f\\\"Missing hemisphere columns: \\\"\\n\",\"    f\\\"{required_hemisphere - set(hemisphere_df.columns)}\\\"\\n\",\")\\n\",\"\\n\",\"GROUP_ORDER = [\\n\",\"    \\\"near_frontal\\\",\\n\",\"    \\\"oblique\\\",\\n\",\"    \\\"large_angular_deviation\\\"\\n\",\"]\\n\",\"\\n\",\"HEMISPHERE_ORDER = [\\n\",\"    \\\"frontal_hemisphere\\\",\\n\",\"    \\\"beyond_frontal_hemisphere\\\"\\n\",\"]\\n\",\"\\n\",\"assert group_df[\\\"subject\\\"].nunique() == 38\\n\",\"assert hemisphere_df[\\\"subject\\\"].nunique() == 38\\n\",\"assert len(group_df) == 114\\n\",\"assert len(hemisphere_df) == 76\\n\",\"\\n\",\"assert set(group_df[\\\"illumination_group\\\"].unique()) == set(GROUP_ORDER)\\n\",\"assert set(hemisphere_df[\\\"hemisphere\\\"].unique()) == set(HEMISPHERE_ORDER)\\n\",\"\\n\",\"assert not group_df.duplicated(\\n\",\"    [\\\"subject\\\", \\\"illumination_group\\\"]\\n\",\").any()\\n\",\"\\n\",\"assert not hemisphere_df.duplicated(\\n\",\"    [\\\"subject\\\", \\\"hemisphere\\\"]\\n\",\").any()\\n\",\"\\n\",\"METRICS = [\\\"euclidean_mean\\\", \\\"cosine_mean\\\"]\\n\",\"\\n\",\"assert np.isfinite(group_df[METRICS].to_numpy()).all()\\n\",\"assert np.isfinite(hemisphere_df[METRICS].to_numpy()).all()\\n\",\"\\n\",\"print(\\\"Unique subjects in group data:\\\", group_df[\\\"subject\\\"].nunique())\\n\",\"print(\\\"Unique subjects in hemisphere data:\\\", hemisphere_df[\\\"subject\\\"].nunique())\\n\",\"print(\\\"Group records:\\\", len(group_df))\\n\",\"print(\\\"Hemisphere records:\\\", len(hemisphere_df))\\n\",\"print(\\\"Data validation: PASSED\\\")\\n\",\"\\n\",\"\\n\",\"# ============================================================\\n\",\"# STEP 3 — PREPARE IDENTITY-LEVEL MATRICES\\n\",\"# ============================================================\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 3 — PREPARE PLOTTING MATRICES\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"group_euclidean = group_df.pivot(\\n\",\"    index=\\\"subject\\\",\\n\",\"    columns=\\\"illumination_group\\\",\\n\",\"    values=\\\"euclidean_mean\\\"\\n\",\").reindex(columns=GROUP_ORDER)\\n\",\"\\n\",\"group_cosine = group_df.pivot(\\n\",\"    index=\\\"subject\\\",\\n\",\"    columns=\\\"illumination_group\\\",\\n\",\"    values=\\\"cosine_mean\\\"\\n\",\").reindex(columns=GROUP_ORDER)\\n\",\"\\n\",\"hemisphere_euclidean = hemisphere_df.pivot(\\n\",\"    index=\\\"subject\\\",\\n\",\"    columns=\\\"hemisphere\\\",\\n\",\"    values=\\\"euclidean_mean\\\"\\n\",\").reindex(columns=HEMISPHERE_ORDER)\\n\",\"\\n\",\"hemisphere_cosine = hemisphere_df.pivot(\\n\",\"    index=\\\"subject\\\",\\n\",\"    columns=\\\"hemisphere\\\",\\n\",\"    values=\\\"cosine_mean\\\"\\n\",\").reindex(columns=HEMISPHERE_ORDER)\\n\",\"\\n\",\"matrices = {\\n\",\"    \\\"group_euclidean\\\": group_euclidean,\\n\",\"    \\\"group_cosine\\\": group_cosine,\\n\",\"    \\\"hemisphere_euclidean\\\": hemisphere_euclidean,\\n\",\"    \\\"hemisphere_cosine\\\": hemisphere_cosine\\n\",\"}\\n\",\"\\n\",\"for name, matrix in matrices.items():\\n\",\"    assert matrix.notna().all().all(), f\\\"Missing values in {name}\\\"\\n\",\"    assert matrix.shape[0] == 38, f\\\"Incorrect subject count in {name}\\\"\\n\",\"    print(name, \\\":\\\", matrix.shape)\\n\",\"\\n\",\"\\n\",\"# ============================================================\\n\",\"# STEP 4 — FIGURE 1: EUCLIDEAN BY ILLUMINATION GROUP\\n\",\"# ============================================================\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 4 — FIGURE 1\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"def create_group_figure(matrix, metric_label, filename):\\n\",\"\\n\",\"    fig, ax = plt.subplots(figsize=(10, 6))\\n\",\"    x = np.arange(3)\\n\",\"\\n\",\"    for subject in matrix.index:\\n\",\"        values = matrix.loc[subject].to_numpy(dtype=float)\\n\",\"        ax.plot(x, values, marker=\\\"o\\\", alpha=0.30, linewidth=0.8)\\n\",\"\\n\",\"    means = matrix.mean(axis=0).to_numpy(dtype=float)\\n\",\"\\n\",\"    ax.plot(\\n\",\"        x, means,\\n\",\"        marker=\\\"D\\\",\\n\",\"        linewidth=3,\\n\",\"        markersize=8,\\n\",\"        label=\\\"Mean across 38 subjects\\\"\\n\",\"    )\\n\",\"\\n\",\"    ax.set_xticks(x)\\n\",\"    ax.set_xticklabels([\\n\",\"        \\\"Near-frontal\\\",\\n\",\"        \\\"Oblique\\\",\\n\",\"        \\\"Large angular deviation\\\"\\n\",\"    ])\\n\",\"\\n\",\"    ax.set_xlabel(\\\"Illumination geometry group\\\")\\n\",\"    ax.set_ylabel(metric_label)\\n\",\"    ax.set_title(f\\\"Identity-level {metric_label} across illumination groups\\\")\\n\",\"    ax.grid(True, alpha=0.25)\\n\",\"    ax.legend()\\n\",\"\\n\",\"    fig.tight_layout()\\n\",\"\\n\",\"    path = OUTPUT_DIR / filename\\n\",\"    fig.savefig(path, dpi=300, bbox_inches=\\\"tight\\\")\\n\",\"    plt.show()\\n\",\"    plt.close(fig)\\n\",\"\\n\",\"    return path\\n\",\"\\n\",\"\\n\",\"fig1 = create_group_figure(\\n\",\"    group_euclidean,\\n\",\"    \\\"Euclidean displacement\\\",\\n\",\"    \\\"experiment20_figure1_euclidean_illumination_groups.png\\\"\\n\",\")\\n\",\"\\n\",\"\\n\",\"# ============================================================\\n\",\"# STEP 5 — FIGURE 2: COSINE BY ILLUMINATION GROUP\\n\",\"# ============================================================\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 5 — FIGURE 2\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"fig2 = create_group_figure(\\n\",\"    group_cosine,\\n\",\"    \\\"Cosine distance\\\",\\n\",\"    \\\"experiment20_figure2_cosine_illumination_groups.png\\\"\\n\",\")\\n\",\"\\n\",\"\\n\",\"# ============================================================\\n\",\"# STEP 6 — FIGURE 3: EUCLIDEAN HEMISPHERE COMPARISON\\n\",\"# ============================================================\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 6 — FIGURE 3\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"def create_hemisphere_figure(matrix, metric_label, filename):\\n\",\"\\n\",\"    fig, ax = plt.subplots(figsize=(8, 6))\\n\",\"    x = np.arange(2)\\n\",\"\\n\",\"    for subject in matrix.index:\\n\",\"        values = matrix.loc[subject].to_numpy(dtype=float)\\n\",\"        ax.plot(x, values, marker=\\\"o\\\", alpha=0.35, linewidth=0.9)\\n\",\"\\n\",\"    means = matrix.mean(axis=0).to_numpy(dtype=float)\\n\",\"\\n\",\"    ax.plot(\\n\",\"        x, means,\\n\",\"        marker=\\\"D\\\",\\n\",\"        linewidth=3,\\n\",\"        markersize=9,\\n\",\"        label=\\\"Mean across 38 subjects\\\"\\n\",\"    )\\n\",\"\\n\",\"    ax.set_xticks(x)\\n\",\"    ax.set_xticklabels([\\n\",\"        \\\"Frontal hemisphere\\\",\\n\",\"        \\\"Beyond-frontal hemisphere\\\"\\n\",\"    ])\\n\",\"\\n\",\"    ax.set_xlabel(\\\"Illumination hemisphere\\\")\\n\",\"    ax.set_ylabel(metric_label)\\n\",\"    ax.set_title(f\\\"Paired identity-level {metric_label}: hemisphere comparison\\\")\\n\",\"    ax.grid(True, alpha=0.25)\\n\",\"    ax.legend()\\n\",\"\\n\",\"    fig.tight_layout()\\n\",\"\\n\",\"    path = OUTPUT_DIR / filename\\n\",\"    fig.savefig(path, dpi=300, bbox_inches=\\\"tight\\\")\\n\",\"    plt.show()\\n\",\"    plt.close(fig)\\n\",\"\\n\",\"    return path\\n\",\"\\n\",\"\\n\",\"fig3 = create_hemisphere_figure(\\n\",\"    hemisphere_euclidean,\\n\",\"    \\\"Euclidean displacement\\\",\\n\",\"    \\\"experiment20_figure3_euclidean_hemisphere_comparison.png\\\"\\n\",\")\\n\",\"\\n\",\"\\n\",\"# ============================================================\\n\",\"# STEP 7 — FIGURE 4: COSINE HEMISPHERE COMPARISON\\n\",\"# ============================================================\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 7 — FIGURE 4\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"fig4 = create_hemisphere_figure(\\n\",\"    hemisphere_cosine,\\n\",\"    \\\"Cosine distance\\\",\\n\",\"    \\\"experiment20_figure4_cosine_hemisphere_comparison.png\\\"\\n\",\")\\n\",\"\\n\",\"\\n\",\"# ============================================================\\n\",\"# STEP 8 — VERIFY FIGURE FILES AND HASHES\\n\",\"# ============================================================\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 8 — VERIFY FIGURE FILES\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"figure_paths = [fig1, fig2, fig3, fig4]\\n\",\"figure_records = []\\n\",\"\\n\",\"for path in figure_paths:\\n\",\"\\n\",\"    assert path.exists(), f\\\"Missing figure: {path}\\\"\\n\",\"    assert path.stat().st_size > 0, f\\\"Empty figure: {path}\\\"\\n\",\"\\n\",\"    with open(path, \\\"rb\\\") as f:\\n\",\"        sha256 = hashlib.sha256(f.read()).hexdigest()\\n\",\"\\n\",\"    figure_records.append({\\n\",\"        \\\"filename\\\": path.name,\\n\",\"        \\\"path\\\": str(path),\\n\",\"        \\\"file_size_bytes\\\": int(path.stat().st_size),\\n\",\"        \\\"sha256\\\": sha256,\\n\",\"        \\\"dpi\\\": 300\\n\",\"    })\\n\",\"\\n\",\"    print(\\\"\\\\n\\\", path.name)\\n\",\"    print(\\\"Size:\\\", path.stat().st_size, \\\"bytes\\\")\\n\",\"    print(\\\"SHA256:\\\", sha256)\\n\",\"\\n\",\"\\n\",\"# ============================================================\\n\",\"# STEP 9 — SAVE AND RELOAD AUDIT JSON\\n\",\"# ============================================================\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 9 — SAVE FIGURE GENERATION AUDIT\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"checks = {\\n\",\"    \\\"group_input_exists\\\": GROUP_FILE.exists(),\\n\",\"    \\\"hemisphere_input_exists\\\": HEMISPHERE_FILE.exists(),\\n\",\"    \\\"group_subject_count_valid\\\": group_df[\\\"subject\\\"].nunique() == 38,\\n\",\"    \\\"hemisphere_subject_count_valid\\\": hemisphere_df[\\\"subject\\\"].nunique() == 38,\\n\",\"    \\\"group_record_count_valid\\\": len(group_df) == 114,\\n\",\"    \\\"hemisphere_record_count_valid\\\": len(hemisphere_df) == 76,\\n\",\"    \\\"group_categories_valid\\\": set(group_df[\\\"illumination_group\\\"].unique()) == set(GROUP_ORDER),\\n\",\"    \\\"hemisphere_categories_valid\\\": set(hemisphere_df[\\\"hemisphere\\\"].unique()) == set(HEMISPHERE_ORDER),\\n\",\"    \\\"group_values_finite\\\": bool(np.isfinite(group_df[METRICS].to_numpy()).all()),\\n\",\"    \\\"hemisphere_values_finite\\\": bool(np.isfinite(hemisphere_df[METRICS].to_numpy()).all()),\\n\",\"    \\\"all_four_figures_generated\\\": len(figure_records) == 4,\\n\",\"    \\\"all_figures_nonempty\\\": all(p.exists() and p.stat().st_size > 0 for p in figure_paths)\\n\",\"}\\n\",\"\\n\",\"audit = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"step\\\": \\\"2.7.6\\\",\\n\",\"    \\\"purpose\\\": \\\"Identity-level research figure generation\\\",\\n\",\"    \\\"identity_column\\\": \\\"subject\\\",\\n\",\"    \\\"identity_count\\\": 38,\\n\",\"    \\\"group_records\\\": len(group_df),\\n\",\"    \\\"hemisphere_records\\\": len(hemisphere_df),\\n\",\"    \\\"group_order\\\": GROUP_ORDER,\\n\",\"    \\\"hemisphere_order\\\": HEMISPHERE_ORDER,\\n\",\"    \\\"visualisation_unit\\\": \\\"identity-level mean\\\",\\n\",\"    \\\"statistical_tests_performed\\\": False,\\n\",\"    \\\"figures_generated\\\": len(figure_records),\\n\",\"    \\\"figures\\\": figure_records,\\n\",\"    \\\"audit_checks\\\": checks,\\n\",\"    \\\"audit_status\\\": \\\"PASSED\\\" if all(checks.values()) else \\\"FAILED\\\"\\n\",\"}\\n\",\"\\n\",\"audit_path = OUTPUT_DIR / \\\"experiment20_step276_figure_generation_audit.json\\\"\\n\",\"\\n\",\"with open(audit_path, \\\"w\\\") as f:\\n\",\"    json.dump(audit, f, indent=4)\\n\",\"\\n\",\"with open(audit_path, \\\"r\\\") as f:\\n\",\"    reloaded_audit = json.load(f)\\n\",\"\\n\",\"assert reloaded_audit[\\\"audit_status\\\"] == audit[\\\"audit_status\\\"]\\n\",\"assert len(reloaded_audit[\\\"figures\\\"]) == 4\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 2.7.6 — FINAL AUDIT\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"for name, result in checks.items():\\n\",\"    print(name, \\\":\\\", \\\"PASS\\\" if result else \\\"FAIL\\\")\\n\",\"\\n\",\"print(\\\"\\\\nAudit status:\\\", audit[\\\"audit_status\\\"])\\n\",\"print(\\\"Figures generated:\\\", len(figure_records))\\n\",\"print(\\\"Audit JSON:\\\", audit_path)\\n\",\"\\n\",\"assert audit[\\\"audit_status\\\"] == \\\"PASSED\\\"\\n\",\"\\n\",\"print(\\\"\\\\nSTEP 2.7.6 FINISHED\\\")\\n\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\",\"height\":1000},\"id\":\"t3RtUqnN0Yg9\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794353818500,\"user_tz\":360,\"elapsed\":6205,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"99f69098-d100-4e98-eba0-36ff0a3f2ea9\"},\"execution_count\":null,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"===========================================================================\\n\",\"STEP 1 — LOAD INPUT DATA\\n\",\"===========================================================================\\n\",\"Group records: 114\\n\",\"Hemisphere records: 76\\n\",\"Group columns: ['subject', 'illumination_group', 'euclidean_mean', 'euclidean_median', 'cosine_mean', 'cosine_median', 'evaluation_conditions', 'observations']\\n\",\"Hemisphere columns: ['subject', 'hemisphere', 'euclidean_mean', 'euclidean_median', 'cosine_mean', 'cosine_median', 'evaluation_conditions', 'observations']\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 2 — VALIDATE DATA STRUCTURE\\n\",\"===========================================================================\\n\",\"Unique subjects in group data: 38\\n\",\"Unique subjects in hemisphere data: 38\\n\",\"Group records: 114\\n\",\"Hemisphere records: 76\\n\",\"Data validation: PASSED\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 3 — PREPARE PLOTTING MATRICES\\n\",\"===========================================================================\\n\",\"group_euclidean : (38, 3)\\n\",\"group_cosine : (38, 3)\\n\",\"hemisphere_euclidean : (38, 2)\\n\",\"hemisphere_cosine : (38, 2)\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 4 — FIGURE 1\\n\",\"===========================================================================\\n\"]},{\"output_type\":\"display_data\",\"data\":{\"text/plain\":[\"<Figure size 1000x600 with 1 Axes>\"],\"image/png\":\"\\n\"},\"metadata\":{}},{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"\\n\",\"===========================================================================\\n\",\"STEP 5 — FIGURE 2\\n\",\"===========================================================================\\n\"]},{\"output_type\":\"display_data\",\"data\":{\"text/plain\":[\"<Figure size 1000x600 with 1 Axes>\"],\"image/png\":\"\\n\"},\"metadata\":{}},{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"\\n\",\"===========================================================================\\n\",\"STEP 6 — FIGURE 3\\n\",\"===========================================================================\\n\"]},{\"output_type\":\"display_data\",\"data\":{\"text/plain\":[\"<Figure size 800x600 with 1 Axes>\"],\"image/png\":\"\\n\"},\"metadata\":{}},{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"\\n\",\"===========================================================================\\n\",\"STEP 7 — FIGURE 4\\n\",\"===========================================================================\\n\"]},{\"output_type\":\"display_data\",\"data\":{\"text/plain\":[\"<Figure size 800x600 with 1 Axes>\"],\"image/png\":\"\\n\"},\"metadata\":{}},{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"\\n\",\"===========================================================================\\n\",\"STEP 8 — VERIFY FIGURE FILES\\n\",\"===========================================================================\\n\",\"\\n\",\" experiment20_figure1_euclidean_illumination_groups.png\\n\",\"Size: 892771 bytes\\n\",\"SHA256: 71623f613dc8202cf5cf6ff7bea005b315e4a31de73841d064c896b24e565b16\\n\",\"\\n\",\" experiment20_figure2_cosine_illumination_groups.png\\n\",\"Size: 882531 bytes\\n\",\"SHA256: de22ee98a909ef099199f5b49911633497c2c890d9d903224131f95db54c917c\\n\",\"\\n\",\" experiment20_figure3_euclidean_hemisphere_comparison.png\\n\",\"Size: 792089 bytes\\n\",\"SHA256: 5a55b8947698a35dd20a258a4d185b927a64ccdac4a4b18d8aad4bd6d35fc0c6\\n\",\"\\n\",\" experiment20_figure4_cosine_hemisphere_comparison.png\\n\",\"Size: 789978 bytes\\n\",\"SHA256: 0a06e0a5458ec2779aee94778f59fd576e585f8fc85fdd3e82afb6c91211851c\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 9 — SAVE FIGURE GENERATION AUDIT\\n\",\"===========================================================================\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 2.7.6 — FINAL AUDIT\\n\",\"===========================================================================\\n\",\"group_input_exists : PASS\\n\",\"hemisphere_input_exists : PASS\\n\",\"group_subject_count_valid : PASS\\n\",\"hemisphere_subject_count_valid : PASS\\n\",\"group_record_count_valid : PASS\\n\",\"hemisphere_record_count_valid : PASS\\n\",\"group_categories_valid : PASS\\n\",\"hemisphere_categories_valid : PASS\\n\",\"group_values_finite : PASS\\n\",\"hemisphere_values_finite : PASS\\n\",\"all_four_figures_generated : PASS\\n\",\"all_figures_nonempty : PASS\\n\",\"\\n\",\"Audit status: PASSED\\n\",\"Figures generated: 4\\n\",\"Audit JSON: /content/drive/MyDrive/Experiment_20_Results/step_2_7/figures/experiment20_step276_figure_generation_audit.json\\n\",\"\\n\",\"STEP 2.7.6 FINISHED\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Step 2.7.7 — Final Results Consolidation and Freeze\\n\",\"\\n\",\"## Objective\\n\",\"\\n\",\"Consolidate and verify the completed Experiment 20 Stage 2 analysis outputs.\\n\",\"\\n\",\"This step does not introduce new statistical tests. It checks the integrity and completeness of the existing results.\\n\",\"\\n\",\"## Analyses being consolidated\\n\",\"\\n\",\"1. Reference-to-evaluation embedding displacement.\\n\",\"2. Illumination-group descriptive statistics.\\n\",\"3. Identity-level repeated-measures analysis.\\n\",\"4. Pairwise Wilcoxon comparisons with Holm correction.\\n\",\"5. Frontal versus beyond-frontal hemisphere comparison.\\n\",\"6. Four identity-level research figures.\\n\",\"\\n\",\"## Statistical reporting rules\\n\",\"\\n\",\"- The inferential unit is identity (38 subjects).\\n\",\"- Individual image-condition observations are not treated as independent subjects.\\n\",\"- Report Euclidean displacement and cosine distance separately.\\n\",\"- Retain the existing Holm-adjusted p-values and paired bootstrap confidence intervals.\\n\",\"- Do not claim recognition accuracy, operational detection performance, or causal effects.\\n\",\"- The hemisphere comparison remains exploratory because the groups have unequal numbers of conditions and are related to illumination geometry.\\n\",\"\\n\",\"## Freeze procedure\\n\",\"\\n\",\"- Verify all required source artifacts exist.\\n\",\"- Recalculate SHA-256 hashes.\\n\",\"- Copy verified artifacts into a dedicated final-freeze directory.\\n\",\"- Verify the copied files against their source hashes.\\n\",\"- Generate a final artifact manifest and results summary.\\n\",\"- Reload the final audit JSON and verify its status.\\n\",\"\\n\",\"## Output\\n\",\"\\n\",\"`Experiment_20_Results/step_2_7/final_freeze/`\\n\",\"\\n\",\"The freeze is considered successful only if every required artifact passes the verification checks.\"],\"metadata\":{\"id\":\"h-4ySbr30_fD\"}},{\"cell_type\":\"code\",\"source\":[\"\\n\",\"import json\\n\",\"import hashlib\\n\",\"import shutil\\n\",\"import pandas as pd\\n\",\"from pathlib import Path\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"# ============================================================\\n\",\"# STEP 2.7.7 — FINAL RESULTS CONSOLIDATION AND FREEZE\\n\",\"# ============================================================\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results/step_2_7\\\")\\n\",\"FREEZE = BASE / \\\"final_freeze\\\"\\n\",\"FREEZE.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"STEP 1 — DEFINE REQUIRED ARTIFACTS\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"ARTIFACTS = {\\n\",\"    \\\"protocol\\\": BASE / \\\"experiment20_step27_descriptive_analysis_protocol.json\\\",\\n\",\"    \\\"displacement_csv\\\": BASE / \\\"displacement_analysis/experiment20_reference_evaluation_displacement.csv\\\",\\n\",\"    \\\"group_descriptive_csv\\\": BASE / \\\"group_descriptive_analysis/experiment20_illumination_group_descriptive_statistics.csv\\\",\\n\",\"    \\\"identity_group_means_csv\\\": BASE / \\\"group_descriptive_analysis/experiment20_identity_level_group_means.csv\\\",\\n\",\"    \\\"repeated_measures_csv\\\": BASE / \\\"repeated_measures_analysis/experiment20_repeated_measures_test_results.csv\\\",\\n\",\"    \\\"pairwise_comparisons_csv\\\": BASE / \\\"repeated_measures_analysis/experiment20_paired_comparison_results.csv\\\",\\n\",\"    \\\"identity_hemisphere_means_csv\\\": BASE / \\\"hemisphere_analysis/experiment20_identity_level_hemisphere_means.csv\\\",\\n\",\"    \\\"hemisphere_comparison_csv\\\": BASE / \\\"hemisphere_analysis/experiment20_hemisphere_comparison_results.csv\\\",\\n\",\"    \\\"protocol_feasibility_audit\\\": BASE / \\\"experiment20_step271_protocol_feasibility_audit.json\\\",\\n\",\"    \\\"displacement_audit\\\": BASE / \\\"displacement_analysis/experiment20_step272_displacement_audit.json\\\",\\n\",\"    \\\"group_descriptive_audit\\\": BASE / \\\"group_descriptive_analysis/experiment20_step273_group_descriptive_audit.json\\\",\\n\",\"    \\\"repeated_measures_audit\\\": BASE / \\\"repeated_measures_analysis/experiment20_step274_repeated_measures_audit.json\\\",\\n\",\"    \\\"hemisphere_audit\\\": BASE / \\\"hemisphere_analysis/experiment20_step275_hemisphere_analysis_audit.json\\\",\\n\",\"    \\\"figure_generation_audit\\\": BASE / \\\"figures/experiment20_step276_figure_generation_audit.json\\\",\\n\",\"    \\\"figure_1\\\": BASE / \\\"figures/experiment20_figure1_euclidean_illumination_groups.png\\\",\\n\",\"    \\\"figure_2\\\": BASE / \\\"figures/experiment20_figure2_cosine_illumination_groups.png\\\",\\n\",\"    \\\"figure_3\\\": BASE / \\\"figures/experiment20_figure3_euclidean_hemisphere_comparison.png\\\",\\n\",\"    \\\"figure_4\\\": BASE / \\\"figures/experiment20_figure4_cosine_hemisphere_comparison.png\\\"\\n\",\"}\\n\",\"\\n\",\"for name, path in ARTIFACTS.items():\\n\",\"    print(name, \\\":\\\", \\\"FOUND\\\" if path.exists() else \\\"MISSING\\\")\\n\",\"\\n\",\"missing = [name for name, path in ARTIFACTS.items() if not path.exists()]\\n\",\"assert not missing, f\\\"Missing artifacts: {missing}\\\"\\n\",\"\\n\",\"print(\\\"\\\\nAll required artifacts found:\\\", len(ARTIFACTS))\\n\",\"\\n\",\"\\n\",\"# ============================================================\\n\",\"# STEP 2 — LOAD AND VALIDATE CSV FILES\\n\",\"# ============================================================\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 2 — LOAD AND VALIDATE CSV FILES\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"EXPECTED_ROWS = {\\n\",\"    \\\"displacement_csv\\\": 2128,\\n\",\"    \\\"group_descriptive_csv\\\": 6,\\n\",\"    \\\"identity_group_means_csv\\\": 114,\\n\",\"    \\\"repeated_measures_csv\\\": 2,\\n\",\"    \\\"pairwise_comparisons_csv\\\": 6,\\n\",\"    \\\"identity_hemisphere_means_csv\\\": 76,\\n\",\"    \\\"hemisphere_comparison_csv\\\": 2\\n\",\"}\\n\",\"\\n\",\"csv_data = {}\\n\",\"\\n\",\"for name, expected in EXPECTED_ROWS.items():\\n\",\"    df = pd.read_csv(ARTIFACTS[name])\\n\",\"    csv_data[name] = df\\n\",\"\\n\",\"    print(\\n\",\"        name,\\n\",\"        \\\"| Rows:\\\", len(df),\\n\",\"        \\\"| Expected:\\\", expected,\\n\",\"        \\\"|\\\", \\\"PASS\\\" if len(df) == expected else \\\"FAIL\\\"\\n\",\"    )\\n\",\"\\n\",\"    assert len(df) == expected, (\\n\",\"        f\\\"{name}: expected {expected}, found {len(df)}\\\"\\n\",\"    )\\n\",\"\\n\",\"\\n\",\"# ============================================================\\n\",\"# STEP 3 — DETECT IDENTITY COLUMNS FROM ACTUAL HEADERS\\n\",\"# ============================================================\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 3 — DETECT IDENTITY COLUMNS\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"def detect_identity_column(df, candidates, file_label):\\n\",\"\\n\",\"    for column in candidates:\\n\",\"        if column in df.columns:\\n\",\"            return column\\n\",\"\\n\",\"    raise ValueError(\\n\",\"        f\\\"Could not identify subject column in {file_label}. \\\"\\n\",\"        f\\\"Available columns: {df.columns.tolist()}\\\"\\n\",\"    )\\n\",\"\\n\",\"\\n\",\"displacement_df = csv_data[\\\"displacement_csv\\\"]\\n\",\"group_df = csv_data[\\\"identity_group_means_csv\\\"]\\n\",\"hemisphere_df = csv_data[\\\"identity_hemisphere_means_csv\\\"]\\n\",\"\\n\",\"print(\\\"Displacement CSV columns:\\\", displacement_df.columns.tolist())\\n\",\"\\n\",\"displacement_identity_column = detect_identity_column(\\n\",\"    displacement_df,\\n\",\"    [\\\"identity\\\", \\\"subject\\\", \\\"subject_id\\\", \\\"identity_id\\\"],\\n\",\"    \\\"displacement CSV\\\"\\n\",\")\\n\",\"\\n\",\"group_identity_column = detect_identity_column(\\n\",\"    group_df,\\n\",\"    [\\\"subject\\\", \\\"identity\\\", \\\"subject_id\\\", \\\"identity_id\\\"],\\n\",\"    \\\"identity group means CSV\\\"\\n\",\")\\n\",\"\\n\",\"hemisphere_identity_column = detect_identity_column(\\n\",\"    hemisphere_df,\\n\",\"    [\\\"subject\\\", \\\"identity\\\", \\\"subject_id\\\", \\\"identity_id\\\"],\\n\",\"    \\\"identity hemisphere means CSV\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"Displacement identity column:\\\", displacement_identity_column)\\n\",\"print(\\\"Group identity column:\\\", group_identity_column)\\n\",\"print(\\\"Hemisphere identity column:\\\", hemisphere_identity_column)\\n\",\"\\n\",\"assert displacement_df[displacement_identity_column].nunique() == 38\\n\",\"assert group_df[group_identity_column].nunique() == 38\\n\",\"assert hemisphere_df[hemisphere_identity_column].nunique() == 38\\n\",\"\\n\",\"assert set(group_df[\\\"illumination_group\\\"].unique()) == {\\n\",\"    \\\"near_frontal\\\",\\n\",\"    \\\"oblique\\\",\\n\",\"    \\\"large_angular_deviation\\\"\\n\",\"}\\n\",\"\\n\",\"assert set(hemisphere_df[\\\"hemisphere\\\"].unique()) == {\\n\",\"    \\\"frontal_hemisphere\\\",\\n\",\"    \\\"beyond_frontal_hemisphere\\\"\\n\",\"}\\n\",\"\\n\",\"assert not group_df.duplicated(\\n\",\"    [group_identity_column, \\\"illumination_group\\\"]\\n\",\").any()\\n\",\"\\n\",\"assert not hemisphere_df.duplicated(\\n\",\"    [hemisphere_identity_column, \\\"hemisphere\\\"]\\n\",\").any()\\n\",\"\\n\",\"print(\\\"All identity and category checks: PASS\\\")\\n\",\"\\n\",\"\\n\",\"# ============================================================\\n\",\"# STEP 4 — VERIFY PREVIOUS AUDIT JSON FILES\\n\",\"# ============================================================\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 4 — VERIFY PREVIOUS AUDITS\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"AUDIT_NAMES = [\\n\",\"    \\\"protocol_feasibility_audit\\\",\\n\",\"    \\\"displacement_audit\\\",\\n\",\"    \\\"group_descriptive_audit\\\",\\n\",\"    \\\"repeated_measures_audit\\\",\\n\",\"    \\\"hemisphere_audit\\\",\\n\",\"    \\\"figure_generation_audit\\\"\\n\",\"]\\n\",\"\\n\",\"previous_audits = {}\\n\",\"\\n\",\"for name in AUDIT_NAMES:\\n\",\"\\n\",\"    with open(ARTIFACTS[name], \\\"r\\\") as f:\\n\",\"        audit_data = json.load(f)\\n\",\"\\n\",\"    assert isinstance(audit_data, dict) and len(audit_data) > 0\\n\",\"\\n\",\"    previous_audits[name] = audit_data\\n\",\"    print(name, \\\": VALID JSON — PASS\\\")\\n\",\"\\n\",\"assert previous_audits[\\\"hemisphere_audit\\\"].get(\\\"audit_status\\\") == \\\"PASSED\\\"\\n\",\"assert previous_audits[\\\"figure_generation_audit\\\"].get(\\\"audit_status\\\") == \\\"PASSED\\\"\\n\",\"\\n\",\"\\n\",\"# ============================================================\\n\",\"# STEP 5 — COPY AND VERIFY ARTIFACT HASHES\\n\",\"# ============================================================\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 5 — COPY AND VERIFY ARTIFACTS\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"def sha256_file(path):\\n\",\"\\n\",\"    digest = hashlib.sha256()\\n\",\"\\n\",\"    with open(path, \\\"rb\\\") as f:\\n\",\"        for chunk in iter(lambda: f.read(1024 * 1024), b\\\"\\\"):\\n\",\"            digest.update(chunk)\\n\",\"\\n\",\"    return digest.hexdigest()\\n\",\"\\n\",\"\\n\",\"manifest_records = []\\n\",\"\\n\",\"for name, source in ARTIFACTS.items():\\n\",\"\\n\",\"    destination = FREEZE / source.name\\n\",\"\\n\",\"    shutil.copy2(source, destination)\\n\",\"\\n\",\"    source_hash = sha256_file(source)\\n\",\"    frozen_hash = sha256_file(destination)\\n\",\"\\n\",\"    assert source_hash == frozen_hash, f\\\"Hash mismatch: {name}\\\"\\n\",\"\\n\",\"    manifest_records.append({\\n\",\"        \\\"artifact_name\\\": name,\\n\",\"        \\\"filename\\\": source.name,\\n\",\"        \\\"source_path\\\": str(source),\\n\",\"        \\\"frozen_path\\\": str(destination),\\n\",\"        \\\"file_size_bytes\\\": destination.stat().st_size,\\n\",\"        \\\"source_sha256\\\": source_hash,\\n\",\"        \\\"frozen_sha256\\\": frozen_hash,\\n\",\"        \\\"hash_match\\\": True\\n\",\"    })\\n\",\"\\n\",\"    print(name, \\\"| SHA256 match: PASS\\\")\\n\",\"\\n\",\"\\n\",\"# ============================================================\\n\",\"# STEP 6 — CREATE FINAL RESULTS SUMMARY\\n\",\"# ============================================================\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 6 — CREATE FINAL RESULTS SUMMARY\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"summary = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"step\\\": \\\"2.7.7\\\",\\n\",\"    \\\"dataset\\\": \\\"Cropped Extended Yale B\\\",\\n\",\"    \\\"identities\\\": 38,\\n\",\"    \\\"common_illumination_conditions\\\": 57,\\n\",\"    \\\"reference_condition\\\": \\\"A+000E+00\\\",\\n\",\"    \\\"evaluation_conditions\\\": 56,\\n\",\"    \\\"evaluation_observations\\\": 2128,\\n\",\"    \\\"embedding_dimension\\\": 512,\\n\",\"\\n\",\"    \\\"illumination_groups\\\": {\\n\",\"        \\\"near_frontal\\\": {\\n\",\"            \\\"conditions\\\": 17,\\n\",\"            \\\"observations\\\": 646,\\n\",\"            \\\"euclidean_mean\\\": 0.401897,\\n\",\"            \\\"cosine_mean\\\": 0.086877\\n\",\"        },\\n\",\"        \\\"oblique\\\": {\\n\",\"            \\\"conditions\\\": 11,\\n\",\"            \\\"observations\\\": 418,\\n\",\"            \\\"euclidean_mean\\\": 0.708976,\\n\",\"            \\\"cosine_mean\\\": 0.262274\\n\",\"        },\\n\",\"        \\\"large_angular_deviation\\\": {\\n\",\"            \\\"conditions\\\": 28,\\n\",\"            \\\"observations\\\": 1064,\\n\",\"            \\\"euclidean_mean\\\": 1.118457,\\n\",\"            \\\"cosine_mean\\\": 0.649095\\n\",\"        }\\n\",\"    },\\n\",\"\\n\",\"    \\\"repeated_measures\\\": {\\n\",\"        \\\"inferential_unit\\\": \\\"identity\\\",\\n\",\"        \\\"identity_count\\\": 38,\\n\",\"        \\\"euclidean_friedman_chi_square\\\": 76.0,\\n\",\"        \\\"euclidean_friedman_p\\\": 3.139132792048018e-17,\\n\",\"        \\\"euclidean_kendall_w\\\": 1.0,\\n\",\"        \\\"cosine_friedman_chi_square\\\": 76.0,\\n\",\"        \\\"cosine_friedman_p\\\": 3.139132792048018e-17,\\n\",\"        \\\"cosine_kendall_w\\\": 1.0,\\n\",\"        \\\"pairwise_comparisons\\\": 6,\\n\",\"        \\\"holm_correction\\\": True\\n\",\"    },\\n\",\"\\n\",\"    \\\"hemisphere_comparison\\\": {\\n\",\"        \\\"frontal_conditions\\\": 45,\\n\",\"        \\\"frontal_observations\\\": 1710,\\n\",\"        \\\"beyond_frontal_conditions\\\": 11,\\n\",\"        \\\"beyond_frontal_observations\\\": 418,\\n\",\"        \\\"identity_count\\\": 38,\\n\",\"        \\\"euclidean_mean_frontal\\\": 0.7062201499035649,\\n\",\"        \\\"euclidean_mean_beyond_frontal\\\": 1.2879898951855027,\\n\",\"        \\\"euclidean_paired_difference\\\": 0.5817697452819375,\\n\",\"        \\\"euclidean_holm_p\\\": 1.4551915228366852e-11,\\n\",\"        \\\"euclidean_ci_95\\\": [0.5619855482971955, 0.6019542941366831],\\n\",\"        \\\"cosine_mean_frontal\\\": 0.29581613376952953,\\n\",\"        \\\"cosine_mean_beyond_frontal\\\": 0.838623580414268,\\n\",\"        \\\"cosine_paired_difference\\\": 0.5428074466447383,\\n\",\"        \\\"cosine_holm_p\\\": 1.4551915228366852e-11,\\n\",\"        \\\"cosine_ci_95\\\": [0.516419233513524, 0.5685162487133432],\\n\",\"        \\\"bootstrap_iterations\\\": 20000,\\n\",\"        \\\"bootstrap_seed\\\": 2026275,\\n\",\"        \\\"interpretation\\\": \\\"Exploratory comparison; unequal condition counts and angular geometry prevent isolation of a pure hemisphere effect.\\\"\\n\",\"    },\\n\",\"\\n\",\"    \\\"methodological_limitations\\\": [\\n\",\"        \\\"One reference capture per identity.\\\",\\n\",\"        \\\"Evaluation captures are distinct images, not exact transformed copies.\\\",\\n\",\"        \\\"The same pretrained VGGFace2 FaceNet backbone is used.\\\",\\n\",\"        \\\"Grayscale images were converted to RGB by channel replication.\\\",\\n\",\"        \\\"External dataset evaluation is not independent model validation.\\\",\\n\",\"        \\\"No operational false-alarm rate or detection threshold was calibrated.\\\",\\n\",\"        \\\"No biometric recognition accuracy or deployment readiness is established.\\\",\\n\",\"        \\\"Hemisphere comparison is exploratory.\\\"\\n\",\"    ],\\n\",\"\\n\",\"    \\\"new_statistical_tests_in_freeze_step\\\": False\\n\",\"}\\n\",\"\\n\",\"summary_path = FREEZE / \\\"experiment20_final_results_summary.json\\\"\\n\",\"\\n\",\"with open(summary_path, \\\"w\\\") as f:\\n\",\"    json.dump(summary, f, indent=4)\\n\",\"\\n\",\"with open(summary_path, \\\"r\\\") as f:\\n\",\"    summary_reload = json.load(f)\\n\",\"\\n\",\"assert summary_reload[\\\"identities\\\"] == 38\\n\",\"\\n\",\"print(\\\"Final summary saved and reloaded: PASS\\\")\\n\",\"\\n\",\"\\n\",\"# ============================================================\\n\",\"# STEP 7 — CREATE FINAL REPORT\\n\",\"# ============================================================\\n\",\"\\n\",\"report = \\\"\\\"\\\"# Experiment 20 — Final Results Report\\n\",\"\\n\",\"## Experimental scope\\n\",\"\\n\",\"Paired identity-level evaluation of FaceNet embedding displacement\\n\",\"under controlled illumination changes using Cropped Extended Yale B.\\n\",\"\\n\",\"- Identities: 38\\n\",\"- Common illumination conditions: 57\\n\",\"- Reference condition: A+000E+00\\n\",\"- Evaluation conditions: 56\\n\",\"- Evaluation observations: 2,128\\n\",\"- Embedding dimension: 512\\n\",\"\\n\",\"## Illumination-group descriptive results\\n\",\"\\n\",\"| Group | Conditions | Observations | Euclidean mean | Cosine mean |\\n\",\"|---|---:|---:|---:|---:|\\n\",\"| Near-frontal | 17 | 646 | 0.401897 | 0.086877 |\\n\",\"| Oblique | 11 | 418 | 0.708976 | 0.262274 |\\n\",\"| Large angular deviation | 28 | 1,064 | 1.118457 | 0.649095 |\\n\",\"\\n\",\"## Repeated-measures analysis\\n\",\"\\n\",\"Inferential unit: 38 identities.\\n\",\"\\n\",\"- Euclidean Friedman chi-square: 76.0; p = 3.1391e-17.\\n\",\"- Cosine Friedman chi-square: 76.0; p = 3.1391e-17.\\n\",\"- Kendall's W: 1.0 for both metrics.\\n\",\"- Six pairwise Wilcoxon comparisons.\\n\",\"- Holm correction applied across six comparisons.\\n\",\"\\n\",\"Kendall's W = 1.0 indicates consistent ranking of illumination\\n\",\"groups across the analysed identities. It does not indicate\\n\",\"perfect detection or recognition performance.\\n\",\"\\n\",\"## Hemisphere comparison\\n\",\"\\n\",\"| Metric | Frontal mean | Beyond-frontal mean | Paired difference |\\n\",\"|---|---:|---:|---:|\\n\",\"| Euclidean | 0.706220 | 1.287990 | 0.581770 |\\n\",\"| Cosine | 0.295816 | 0.838624 | 0.542807 |\\n\",\"\\n\",\"Both comparisons were significant after Holm correction\\n\",\"(adjusted p = 1.4552e-11).\\n\",\"\\n\",\"Euclidean 95% paired bootstrap CI: [0.561986, 0.601954].\\n\",\"\\n\",\"Cosine 95% paired bootstrap CI: [0.516419, 0.568516].\\n\",\"\\n\",\"This comparison is exploratory because the groups contain unequal\\n\",\"numbers of conditions and are related to angular illumination geometry.\\n\",\"\\n\",\"## Interpretation\\n\",\"\\n\",\"Embedding displacement increased across near-frontal, oblique,\\n\",\"and large-angular-deviation illumination groups.\\n\",\"\\n\",\"These findings establish an association in this dataset. They do not\\n\",\"establish biometric recognition accuracy, operational drift-detection\\n\",\"performance, causal effects, or deployment readiness.\\n\",\"\\n\",\"## Methodological limitations\\n\",\"\\n\",\"- One reference capture per identity.\\n\",\"- Evaluation captures are not exact transformed copies.\\n\",\"- Same pretrained VGGFace2 FaceNet backbone.\\n\",\"- Grayscale images converted to RGB by channel replication.\\n\",\"- External dataset does not constitute independent model validation.\\n\",\"- No operational false-alarm rate or detection threshold calibrated.\\n\",\"- Hemisphere comparison is exploratory.\\n\",\"\\\"\\\"\\\"\\n\",\"\\n\",\"report_path = FREEZE / \\\"experiment20_final_results_report.md\\\"\\n\",\"\\n\",\"with open(report_path, \\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    f.write(report)\\n\",\"\\n\",\"assert report_path.exists() and report_path.stat().st_size > 0\\n\",\"\\n\",\"print(\\\"Final report created: PASS\\\")\\n\",\"\\n\",\"\\n\",\"# ============================================================\\n\",\"# STEP 8 — SAVE FINAL MANIFEST\\n\",\"# ============================================================\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 8 — SAVE FINAL MANIFEST\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"manifest = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"step\\\": \\\"2.7.7\\\",\\n\",\"    \\\"created_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"artifact_count\\\": len(manifest_records),\\n\",\"    \\\"artifacts\\\": manifest_records,\\n\",\"    \\\"summary_file\\\": str(summary_path),\\n\",\"    \\\"report_file\\\": str(report_path),\\n\",\"    \\\"all_hashes_match\\\": all(\\n\",\"        item[\\\"hash_match\\\"] for item in manifest_records\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"manifest_path = FREEZE / \\\"experiment20_final_artifact_manifest.json\\\"\\n\",\"\\n\",\"with open(manifest_path, \\\"w\\\") as f:\\n\",\"    json.dump(manifest, f, indent=4)\\n\",\"\\n\",\"with open(manifest_path, \\\"r\\\") as f:\\n\",\"    manifest_reload = json.load(f)\\n\",\"\\n\",\"assert manifest_reload[\\\"all_hashes_match\\\"] is True\\n\",\"assert manifest_reload[\\\"artifact_count\\\"] == len(ARTIFACTS)\\n\",\"\\n\",\"print(\\\"Manifest saved and reloaded: PASS\\\")\\n\",\"\\n\",\"\\n\",\"# ============================================================\\n\",\"# STEP 9 — FINAL FREEZE AUDIT\\n\",\"# ============================================================\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 9 — FINAL FREEZE AUDIT\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"checks = {\\n\",\"    \\\"all_required_artifacts_found\\\": len(missing) == 0,\\n\",\"    \\\"all_csv_row_counts_valid\\\": all(\\n\",\"        len(csv_data[name]) == expected\\n\",\"        for name, expected in EXPECTED_ROWS.items()\\n\",\"    ),\\n\",\"    \\\"displacement_identity_count_valid\\\": (\\n\",\"        displacement_df[displacement_identity_column].nunique() == 38\\n\",\"    ),\\n\",\"    \\\"group_identity_count_valid\\\": (\\n\",\"        group_df[group_identity_column].nunique() == 38\\n\",\"    ),\\n\",\"    \\\"hemisphere_identity_count_valid\\\": (\\n\",\"        hemisphere_df[hemisphere_identity_column].nunique() == 38\\n\",\"    ),\\n\",\"    \\\"previous_audit_json_files_valid\\\": len(previous_audits) == 6,\\n\",\"    \\\"hemisphere_audit_passed\\\": previous_audits[\\n\",\"        \\\"hemisphere_audit\\\"\\n\",\"    ].get(\\\"audit_status\\\") == \\\"PASSED\\\",\\n\",\"    \\\"figure_audit_passed\\\": previous_audits[\\n\",\"        \\\"figure_generation_audit\\\"\\n\",\"    ].get(\\\"audit_status\\\") == \\\"PASSED\\\",\\n\",\"    \\\"all_frozen_hashes_match\\\": all(\\n\",\"        item[\\\"hash_match\\\"] for item in manifest_records\\n\",\"    ),\\n\",\"    \\\"summary_json_valid\\\": summary_reload[\\\"identities\\\"] == 38,\\n\",\"    \\\"report_exists\\\": report_path.exists(),\\n\",\"    \\\"manifest_reloads\\\": manifest_reload[\\\"artifact_count\\\"] == len(ARTIFACTS)\\n\",\"}\\n\",\"\\n\",\"status = \\\"PASSED\\\" if all(checks.values()) else \\\"FAILED\\\"\\n\",\"\\n\",\"final_audit = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"step\\\": \\\"2.7.7\\\",\\n\",\"    \\\"audit_checks\\\": checks,\\n\",\"    \\\"audit_status\\\": status,\\n\",\"    \\\"frozen_artifact_count\\\": len(ARTIFACTS),\\n\",\"    \\\"freeze_directory\\\": str(FREEZE)\\n\",\"}\\n\",\"\\n\",\"audit_path = FREEZE / \\\"experiment20_step277_final_freeze_audit.json\\\"\\n\",\"\\n\",\"with open(audit_path, \\\"w\\\") as f:\\n\",\"    json.dump(final_audit, f, indent=4)\\n\",\"\\n\",\"with open(audit_path, \\\"r\\\") as f:\\n\",\"    audit_reload = json.load(f)\\n\",\"\\n\",\"assert audit_reload[\\\"audit_status\\\"] == status\\n\",\"\\n\",\"for name, result in checks.items():\\n\",\"    print(name, \\\":\\\", \\\"PASS\\\" if result else \\\"FAIL\\\")\\n\",\"\\n\",\"print(\\\"\\\\nFinal audit status:\\\", status)\\n\",\"print(\\\"Frozen artifacts:\\\", len(ARTIFACTS))\\n\",\"print(\\\"Freeze directory:\\\", FREEZE)\\n\",\"print(\\\"Manifest:\\\", manifest_path)\\n\",\"print(\\\"Results summary:\\\", summary_path)\\n\",\"print(\\\"Final report:\\\", report_path)\\n\",\"print(\\\"Final audit:\\\", audit_path)\\n\",\"\\n\",\"assert status == \\\"PASSED\\\"\\n\",\"\\n\",\"print(\\\"\\\\nSTEP 2.7.7 FINISHED\\\")\\n\",\"print(\\\"EXPERIMENT 20 STAGE 2 RESULTS FREEZE COMPLETE\\\")\\n\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"4UCMXU8X1Css\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794354095501,\"user_tz\":360,\"elapsed\":1396,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"fe23cb2c-7947-45ff-ea7c-667239e3d3cc\"},\"execution_count\":null,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"===========================================================================\\n\",\"STEP 1 — DEFINE REQUIRED ARTIFACTS\\n\",\"===========================================================================\\n\",\"protocol : FOUND\\n\",\"displacement_csv : FOUND\\n\",\"group_descriptive_csv : FOUND\\n\",\"identity_group_means_csv : FOUND\\n\",\"repeated_measures_csv : FOUND\\n\",\"pairwise_comparisons_csv : FOUND\\n\",\"identity_hemisphere_means_csv : FOUND\\n\",\"hemisphere_comparison_csv : FOUND\\n\",\"protocol_feasibility_audit : FOUND\\n\",\"displacement_audit : FOUND\\n\",\"group_descriptive_audit : FOUND\\n\",\"repeated_measures_audit : FOUND\\n\",\"hemisphere_audit : FOUND\\n\",\"figure_generation_audit : FOUND\\n\",\"figure_1 : FOUND\\n\",\"figure_2 : FOUND\\n\",\"figure_3 : FOUND\\n\",\"figure_4 : FOUND\\n\",\"\\n\",\"All required artifacts found: 18\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 2 — LOAD AND VALIDATE CSV FILES\\n\",\"===========================================================================\\n\",\"displacement_csv | Rows: 2128 | Expected: 2128 | PASS\\n\",\"group_descriptive_csv | Rows: 6 | Expected: 6 | PASS\\n\",\"identity_group_means_csv | Rows: 114 | Expected: 114 | PASS\\n\",\"repeated_measures_csv | Rows: 2 | Expected: 2 | PASS\\n\",\"pairwise_comparisons_csv | Rows: 6 | Expected: 6 | PASS\\n\",\"identity_hemisphere_means_csv | Rows: 76 | Expected: 76 | PASS\\n\",\"hemisphere_comparison_csv | Rows: 2 | Expected: 2 | PASS\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 3 — DETECT IDENTITY COLUMNS\\n\",\"===========================================================================\\n\",\"Displacement CSV columns: ['subject', 'reference_condition', 'evaluation_condition', 'reference_filename', 'evaluation_filename', 'azimuth_degrees', 'elevation_degrees', 'angular_deviation_degrees', 'illumination_group', 'hemisphere', 'euclidean_displacement', 'cosine_similarity', 'cosine_distance']\\n\",\"Displacement identity column: subject\\n\",\"Group identity column: subject\\n\",\"Hemisphere identity column: subject\\n\",\"All identity and category checks: PASS\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 4 — VERIFY PREVIOUS AUDITS\\n\",\"===========================================================================\\n\",\"protocol_feasibility_audit : VALID JSON — PASS\\n\",\"displacement_audit : VALID JSON — PASS\\n\",\"group_descriptive_audit : VALID JSON — PASS\\n\",\"repeated_measures_audit : VALID JSON — PASS\\n\",\"hemisphere_audit : VALID JSON — PASS\\n\",\"figure_generation_audit : VALID JSON — PASS\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 5 — COPY AND VERIFY ARTIFACTS\\n\",\"===========================================================================\\n\",\"protocol | SHA256 match: PASS\\n\",\"displacement_csv | SHA256 match: PASS\\n\",\"group_descriptive_csv | SHA256 match: PASS\\n\",\"identity_group_means_csv | SHA256 match: PASS\\n\",\"repeated_measures_csv | SHA256 match: PASS\\n\",\"pairwise_comparisons_csv | SHA256 match: PASS\\n\",\"identity_hemisphere_means_csv | SHA256 match: PASS\\n\",\"hemisphere_comparison_csv | SHA256 match: PASS\\n\",\"protocol_feasibility_audit | SHA256 match: PASS\\n\",\"displacement_audit | SHA256 match: PASS\\n\",\"group_descriptive_audit | SHA256 match: PASS\\n\",\"repeated_measures_audit | SHA256 match: PASS\\n\",\"hemisphere_audit | SHA256 match: PASS\\n\",\"figure_generation_audit | SHA256 match: PASS\\n\",\"figure_1 | SHA256 match: PASS\\n\",\"figure_2 | SHA256 match: PASS\\n\",\"figure_3 | SHA256 match: PASS\\n\",\"figure_4 | SHA256 match: PASS\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 6 — CREATE FINAL RESULTS SUMMARY\\n\",\"===========================================================================\\n\",\"Final summary saved and reloaded: PASS\\n\",\"Final report created: PASS\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 8 — SAVE FINAL MANIFEST\\n\",\"===========================================================================\\n\",\"Manifest saved and reloaded: PASS\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 9 — FINAL FREEZE AUDIT\\n\",\"===========================================================================\\n\",\"all_required_artifacts_found : PASS\\n\",\"all_csv_row_counts_valid : PASS\\n\",\"displacement_identity_count_valid : PASS\\n\",\"group_identity_count_valid : PASS\\n\",\"hemisphere_identity_count_valid : PASS\\n\",\"previous_audit_json_files_valid : PASS\\n\",\"hemisphere_audit_passed : PASS\\n\",\"figure_audit_passed : PASS\\n\",\"all_frozen_hashes_match : PASS\\n\",\"summary_json_valid : PASS\\n\",\"report_exists : PASS\\n\",\"manifest_reloads : PASS\\n\",\"\\n\",\"Final audit status: PASSED\\n\",\"Frozen artifacts: 18\\n\",\"Freeze directory: /content/drive/MyDrive/Experiment_20_Results/step_2_7/final_freeze\\n\",\"Manifest: /content/drive/MyDrive/Experiment_20_Results/step_2_7/final_freeze/experiment20_final_artifact_manifest.json\\n\",\"Results summary: /content/drive/MyDrive/Experiment_20_Results/step_2_7/final_freeze/experiment20_final_results_summary.json\\n\",\"Final report: /content/drive/MyDrive/Experiment_20_Results/step_2_7/final_freeze/experiment20_final_results_report.md\\n\",\"Final audit: /content/drive/MyDrive/Experiment_20_Results/step_2_7/final_freeze/experiment20_step277_final_freeze_audit.json\\n\",\"\\n\",\"STEP 2.7.7 FINISHED\\n\",\"EXPERIMENT 20 STAGE 2 RESULTS FREEZE COMPLETE\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.1.1: Frozen Evidence Inventory (Path Recovery)\\n\",\"\\n\",\"## Objective\\n\",\"Recover the correct final-freeze directory and inspect the frozen Experiment 20 artifacts.\\n\",\"\\n\",\"## Recovery procedure\\n\",\"1. Check whether Google Drive is mounted.\\n\",\"2. Mount Google Drive if necessary.\\n\",\"3. Check the expected Experiment 20 directory.\\n\",\"4. Search for the final_freeze directory if the expected path is unavailable.\\n\",\"5. Inventory files only after locating the correct directory.\\n\",\"\\n\",\"## Safety\\n\",\"- Read-only operation.\\n\",\"- No files will be moved, deleted, overwritten, or regenerated.\\n\",\"- No statistical calculations will be performed.\\n\",\"- If the directory cannot be located, report the available directory structure for diagnosis.\"],\"metadata\":{\"id\":\"551DeRg3rGUP\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import hashlib\\n\",\"import json\\n\",\"import pandas as pd\\n\",\"import os\\n\",\"\\n\",\"print(\\\"=\\\" * 90)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.1.1: PATH RECOVERY AND EVIDENCE INVENTORY\\\")\\n\",\"print(\\\"=\\\" * 90)\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 1. Check and mount Google Drive\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"DRIVE_ROOT = Path(\\\"/content/drive\\\")\\n\",\"MYDRIVE = DRIVE_ROOT / \\\"MyDrive\\\"\\n\",\"\\n\",\"if not MYDRIVE.exists():\\n\",\"    print(\\\"\\\\nGoogle Drive is not currently accessible.\\\")\\n\",\"    print(\\\"Attempting to mount Google Drive...\\\")\\n\",\"\\n\",\"    from google.colab import drive\\n\",\"    drive.mount(\\\"/content/drive\\\")\\n\",\"\\n\",\"else:\\n\",\"    print(\\\"\\\\nGoogle Drive is already accessible.\\\")\\n\",\"\\n\",\"if not MYDRIVE.exists():\\n\",\"    raise RuntimeError(\\n\",\"        \\\"Google Drive mount did not expose /content/drive/MyDrive.\\\"\\n\",\"    )\\n\",\"\\n\",\"print(f\\\"Drive root: {MYDRIVE}\\\")\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 2. Check expected paths\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"expected_paths = [\\n\",\"    MYDRIVE / \\\"Experiment_20_Results\\\" / \\\"step_2_7\\\" / \\\"final_freeze\\\",\\n\",\"    MYDRIVE / \\\"Experiment_20_Results\\\" / \\\"final_freeze\\\",\\n\",\"    MYDRIVE / \\\"Experiment_20_Results\\\" / \\\"step_2_7\\\"\\n\",\"]\\n\",\"\\n\",\"ROOT = None\\n\",\"\\n\",\"print(\\\"\\\\nCHECKING EXPECTED PATHS\\\")\\n\",\"\\n\",\"for path in expected_paths:\\n\",\"    exists = path.exists()\\n\",\"    print(f\\\"{'FOUND' if exists else 'NOT FOUND'}: {path}\\\")\\n\",\"\\n\",\"    if exists and path.name == \\\"final_freeze\\\":\\n\",\"        ROOT = path\\n\",\"        break\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 3. Search for final_freeze if necessary\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"if ROOT is None:\\n\",\"    print(\\\"\\\\nSearching MyDrive for directories named final_freeze...\\\")\\n\",\"\\n\",\"    candidates = []\\n\",\"\\n\",\"    for current_root, dirs, files in os.walk(MYDRIVE):\\n\",\"        # Avoid searching unnecessary hidden/system directories.\\n\",\"        dirs[:] = [\\n\",\"            d for d in dirs\\n\",\"            if not d.startswith(\\\".\\\")\\n\",\"        ]\\n\",\"\\n\",\"        current_path = Path(current_root)\\n\",\"\\n\",\"        if current_path.name == \\\"final_freeze\\\":\\n\",\"            candidates.append(current_path)\\n\",\"\\n\",\"        # Restrict search depth to avoid excessive traversal.\\n\",\"        if len(current_path.relative_to(MYDRIVE).parts) >= 8:\\n\",\"            dirs[:] = []\\n\",\"\\n\",\"    if len(candidates) == 1:\\n\",\"        ROOT = candidates[0]\\n\",\"        print(f\\\"\\\\nFOUND ONE CANDIDATE:\\\\n{ROOT}\\\")\\n\",\"\\n\",\"    elif len(candidates) > 1:\\n\",\"        print(\\\"\\\\nMULTIPLE final_freeze DIRECTORIES FOUND:\\\")\\n\",\"        for index, candidate in enumerate(candidates, 1):\\n\",\"            print(f\\\"{index}. {candidate}\\\")\\n\",\"\\n\",\"        print(\\n\",\"            \\\"\\\\nSTOPPING: Multiple candidates require identification \\\"\\n\",\"            \\\"before selecting a directory.\\\"\\n\",\"        )\\n\",\"        ROOT = None\\n\",\"\\n\",\"    else:\\n\",\"        print(\\\"\\\\nNo directory named final_freeze was found.\\\")\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 4. If unresolved, inspect Experiment_20_Results\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"if ROOT is None:\\n\",\"    experiment_root = MYDRIVE / \\\"Experiment_20_Results\\\"\\n\",\"\\n\",\"    print(\\\"\\\\n\\\" + \\\"=\\\" * 90)\\n\",\"    print(\\\"RECOVERY DIAGNOSTICS\\\")\\n\",\"    print(\\\"=\\\" * 90)\\n\",\"\\n\",\"    if experiment_root.exists():\\n\",\"        print(f\\\"\\\\nContents of: {experiment_root}\\\")\\n\",\"\\n\",\"        for item in sorted(experiment_root.iterdir()):\\n\",\"            item_type = \\\"DIR \\\" if item.is_dir() else \\\"FILE\\\"\\n\",\"            print(f\\\"{item_type}: {item.name}\\\")\\n\",\"\\n\",\"    else:\\n\",\"        print(\\n\",\"            \\\"\\\\nExperiment_20_Results was not found directly under MyDrive.\\\"\\n\",\"        )\\n\",\"\\n\",\"        print(\\\"\\\\nTop-level MyDrive contents:\\\")\\n\",\"        for item in sorted(MYDRIVE.iterdir())[:100]:\\n\",\"            item_type = \\\"DIR \\\" if item.is_dir() else \\\"FILE\\\"\\n\",\"            print(f\\\"{item_type}: {item.name}\\\")\\n\",\"\\n\",\"    print(\\\"\\\\nAUDIT STATUS: BLOCKED — CORRECT DIRECTORY NOT IDENTIFIED\\\")\\n\",\"    print(\\\"No files were modified.\\\")\\n\",\"\\n\",\"else:\\n\",\"    # -----------------------------------------------------\\n\",\"    # 5. Inventory the recovered final-freeze directory\\n\",\"    # -----------------------------------------------------\\n\",\"\\n\",\"    print(\\\"\\\\n\\\" + \\\"=\\\" * 90)\\n\",\"    print(\\\"FROZEN EVIDENCE INVENTORY\\\")\\n\",\"    print(\\\"=\\\" * 90)\\n\",\"\\n\",\"    files = sorted(\\n\",\"        path for path in ROOT.rglob(\\\"*\\\")\\n\",\"        if path.is_file()\\n\",\"    )\\n\",\"\\n\",\"    print(f\\\"\\\\nRecovered directory: {ROOT}\\\")\\n\",\"    print(f\\\"Total files found: {len(files)}\\\")\\n\",\"\\n\",\"    if not files:\\n\",\"        print(\\\"\\\\nAUDIT STATUS: REVIEW REQUIRED — DIRECTORY IS EMPTY\\\")\\n\",\"\\n\",\"    else:\\n\",\"        csv_results = []\\n\",\"        json_results = []\\n\",\"        other_results = []\\n\",\"        errors = []\\n\",\"\\n\",\"        def sha256_file(path):\\n\",\"            digest = hashlib.sha256()\\n\",\"            with path.open(\\\"rb\\\") as f:\\n\",\"                for chunk in iter(\\n\",\"                    lambda: f.read(1024 * 1024), b\\\"\\\"\\n\",\"                ):\\n\",\"                    digest.update(chunk)\\n\",\"            return digest.hexdigest()\\n\",\"\\n\",\"        for path in files:\\n\",\"            relative_path = path.relative_to(ROOT)\\n\",\"\\n\",\"            print(\\\"\\\\n\\\" + \\\"-\\\" * 90)\\n\",\"            print(f\\\"FILE: {relative_path}\\\")\\n\",\"            print(f\\\"SIZE: {path.stat().st_size:,} bytes\\\")\\n\",\"            print(f\\\"SHA256: {sha256_file(path)}\\\")\\n\",\"\\n\",\"            suffix = path.suffix.lower()\\n\",\"\\n\",\"            if suffix == \\\".csv\\\":\\n\",\"                try:\\n\",\"                    df = pd.read_csv(path)\\n\",\"\\n\",\"                    csv_results.append({\\n\",\"                        \\\"file\\\": str(relative_path),\\n\",\"                        \\\"rows\\\": len(df),\\n\",\"                        \\\"columns\\\": list(df.columns)\\n\",\"                    })\\n\",\"\\n\",\"                    print(\\\"TYPE: CSV\\\")\\n\",\"                    print(f\\\"ROWS: {len(df):,}\\\")\\n\",\"                    print(f\\\"COLUMNS ({len(df.columns)}):\\\")\\n\",\"\\n\",\"                    for column in df.columns:\\n\",\"                        print(f\\\"  - {column}\\\")\\n\",\"\\n\",\"                except Exception as exc:\\n\",\"                    errors.append((str(relative_path), str(exc)))\\n\",\"                    print(f\\\"CSV READ ERROR: {exc}\\\")\\n\",\"\\n\",\"            elif suffix == \\\".json\\\":\\n\",\"                try:\\n\",\"                    with path.open(\\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"                        data = json.load(f)\\n\",\"\\n\",\"                    keys = (\\n\",\"                        list(data.keys())\\n\",\"                        if isinstance(data, dict)\\n\",\"                        else None\\n\",\"                    )\\n\",\"\\n\",\"                    json_results.append({\\n\",\"                        \\\"file\\\": str(relative_path),\\n\",\"                        \\\"type\\\": type(data).__name__,\\n\",\"                        \\\"keys\\\": keys\\n\",\"                    })\\n\",\"\\n\",\"                    print(\\\"TYPE: JSON\\\")\\n\",\"                    print(f\\\"VALID JSON: YES\\\")\\n\",\"                    print(f\\\"TOP-LEVEL TYPE: {type(data).__name__}\\\")\\n\",\"\\n\",\"                    if keys is not None:\\n\",\"                        print(f\\\"TOP-LEVEL KEYS: {keys}\\\")\\n\",\"                    elif isinstance(data, list):\\n\",\"                        print(f\\\"LIST LENGTH: {len(data)}\\\")\\n\",\"\\n\",\"                except Exception as exc:\\n\",\"                    errors.append((str(relative_path), str(exc)))\\n\",\"                    print(f\\\"JSON READ ERROR: {exc}\\\")\\n\",\"\\n\",\"            else:\\n\",\"                other_results.append(str(relative_path))\\n\",\"                print(f\\\"TYPE: {suffix if suffix else 'NO EXTENSION'}\\\")\\n\",\"\\n\",\"        print(\\\"\\\\n\\\" + \\\"=\\\" * 90)\\n\",\"        print(\\\"INVENTORY SUMMARY\\\")\\n\",\"        print(\\\"=\\\" * 90)\\n\",\"\\n\",\"        print(f\\\"Total files: {len(files)}\\\")\\n\",\"        print(f\\\"Readable CSV files: {len(csv_results)}\\\")\\n\",\"        print(f\\\"Valid JSON files: {len(json_results)}\\\")\\n\",\"        print(f\\\"Other files: {len(other_results)}\\\")\\n\",\"        print(f\\\"Read/parse errors: {len(errors)}\\\")\\n\",\"\\n\",\"        print(\\\"\\\\nCSV ROW COUNTS\\\")\\n\",\"        for item in csv_results:\\n\",\"            print(f\\\"{item['file']}: {item['rows']:,} rows\\\")\\n\",\"\\n\",\"        if errors:\\n\",\"            print(\\\"\\\\nERROR DETAILS\\\")\\n\",\"            for filename, error in errors:\\n\",\"                print(f\\\"{filename}: {error}\\\")\\n\",\"\\n\",\"            print(\\\"\\\\nAUDIT STATUS: REVIEW REQUIRED — ERRORS DETECTED\\\")\\n\",\"        else:\\n\",\"            print(\\\"\\\\nAUDIT STATUS: INVENTORY COMPLETED — NO READ/PARSE ERRORS\\\")\\n\",\"\\n\",\"        print(\\\"\\\\nNOTE: This is a file inventory, not an independent verification\\\")\\n\",\"        print(\\\"of the statistical calculations.\\\")\\n\",\"        print(\\\"=\\\" * 90)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"Bsi8snsPrJNP\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794385052611,\"user_tz\":360,\"elapsed\":35338,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"8cc9b21e-976f-42cc-d24e-8fa0c8295142\"},\"execution_count\":2,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"==========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.1.1: PATH RECOVERY AND EVIDENCE INVENTORY\\n\",\"==========================================================================================\\n\",\"\\n\",\"Google Drive is not currently accessible.\\n\",\"Attempting to mount Google Drive...\\n\",\"Mounted at /content/drive\\n\",\"Drive root: /content/drive/MyDrive\\n\",\"\\n\",\"CHECKING EXPECTED PATHS\\n\",\"FOUND: /content/drive/MyDrive/Experiment_20_Results/step_2_7/final_freeze\\n\",\"\\n\",\"==========================================================================================\\n\",\"FROZEN EVIDENCE INVENTORY\\n\",\"==========================================================================================\\n\",\"\\n\",\"Recovered directory: /content/drive/MyDrive/Experiment_20_Results/step_2_7/final_freeze\\n\",\"Total files found: 22\\n\",\"\\n\",\"------------------------------------------------------------------------------------------\\n\",\"FILE: experiment20_figure1_euclidean_illumination_groups.png\\n\",\"SIZE: 892,771 bytes\\n\",\"SHA256: 71623f613dc8202cf5cf6ff7bea005b315e4a31de73841d064c896b24e565b16\\n\",\"TYPE: .png\\n\",\"\\n\",\"------------------------------------------------------------------------------------------\\n\",\"FILE: experiment20_figure2_cosine_illumination_groups.png\\n\",\"SIZE: 882,531 bytes\\n\",\"SHA256: de22ee98a909ef099199f5b49911633497c2c890d9d903224131f95db54c917c\\n\",\"TYPE: .png\\n\",\"\\n\",\"------------------------------------------------------------------------------------------\\n\",\"FILE: experiment20_figure3_euclidean_hemisphere_comparison.png\\n\",\"SIZE: 792,089 bytes\\n\",\"SHA256: 5a55b8947698a35dd20a258a4d185b927a64ccdac4a4b18d8aad4bd6d35fc0c6\\n\",\"TYPE: .png\\n\",\"\\n\",\"------------------------------------------------------------------------------------------\\n\",\"FILE: experiment20_figure4_cosine_hemisphere_comparison.png\\n\",\"SIZE: 789,978 bytes\\n\",\"SHA256: 0a06e0a5458ec2779aee94778f59fd576e585f8fc85fdd3e82afb6c91211851c\\n\",\"TYPE: .png\\n\",\"\\n\",\"------------------------------------------------------------------------------------------\\n\",\"FILE: experiment20_final_artifact_manifest.json\\n\",\"SIZE: 13,269 bytes\\n\",\"SHA256: a318085345c2a9cdc05654f2727d6171a7a61c255d93e4cbffd588a9409eb021\\n\",\"TYPE: JSON\\n\",\"VALID JSON: YES\\n\",\"TOP-LEVEL TYPE: dict\\n\",\"TOP-LEVEL KEYS: ['experiment', 'step', 'created_utc', 'artifact_count', 'artifacts', 'summary_file', 'report_file', 'all_hashes_match']\\n\",\"\\n\",\"------------------------------------------------------------------------------------------\\n\",\"FILE: experiment20_final_results_report.md\\n\",\"SIZE: 2,419 bytes\\n\",\"SHA256: d21a5f7651b650059c373733a0dfea33327443f9641ae68d19f50c8ce17665b5\\n\",\"TYPE: .md\\n\",\"\\n\",\"------------------------------------------------------------------------------------------\\n\",\"FILE: experiment20_final_results_summary.json\\n\",\"SIZE: 3,054 bytes\\n\",\"SHA256: 9004831c6694699150c3d7ebf977ba1ad906df7829926600a6b5f3d83980c439\\n\",\"TYPE: JSON\\n\",\"VALID JSON: YES\\n\",\"TOP-LEVEL TYPE: dict\\n\",\"TOP-LEVEL KEYS: ['experiment', 'step', 'dataset', 'identities', 'common_illumination_conditions', 'reference_condition', 'evaluation_conditions', 'evaluation_observations', 'embedding_dimension', 'illumination_groups', 'repeated_measures', 'hemisphere_comparison', 'methodological_limitations', 'new_statistical_tests_in_freeze_step']\\n\",\"\\n\",\"------------------------------------------------------------------------------------------\\n\",\"FILE: experiment20_hemisphere_comparison_results.csv\\n\",\"SIZE: 729 bytes\\n\",\"SHA256: 72e2db7a59abb4e142b8c0663f75ac07022d2968a07824ab6ba1416ae79a1982\\n\",\"TYPE: CSV\\n\",\"ROWS: 2\\n\",\"COLUMNS (16):\\n\",\"  - metric\\n\",\"  - metric_label\\n\",\"  - test\\n\",\"  - identities\\n\",\"  - mean_frontal\\n\",\"  - mean_beyond_frontal\\n\",\"  - mean_paired_difference_beyond_minus_frontal\\n\",\"  - median_paired_difference_beyond_minus_frontal\\n\",\"  - wilcoxon_statistic\\n\",\"  - raw_p_value\\n\",\"  - holm_adjusted_p_value\\n\",\"  - significant_after_holm_0_05\\n\",\"  - ci_95_lower\\n\",\"  - ci_95_upper\\n\",\"  - bootstrap_iterations\\n\",\"  - random_seed\\n\",\"\\n\",\"------------------------------------------------------------------------------------------\\n\",\"FILE: experiment20_identity_level_group_means.csv\\n\",\"