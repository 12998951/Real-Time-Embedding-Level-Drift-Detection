        "    \"methodological_limitations\": limitation_checks,\n",
        "    \"statistical_limitations\": statistical_checks,\n",
        "    \"research_contribution\": contribution_checks\n",
        "}\n",
        "\n",
        "for category, checks in check_groups.items():\n",
        "    for name, passed in checks.items():\n",
        "        if not passed:\n",
        "            review_flags.append({\n",
        "                \"category\": category,\n",
        "                \"issue\": name,\n",
        "                \"status\": \"REVIEW_REQUIRED\"\n",
        "            })\n",
        "\n",
        "if not future_work_checks[\"future_research_discussed\"]:\n",
        "    review_flags.append({\n",
        "        \"category\": \"future_research\",\n",
        "        \"issue\": \"No explicit future research statement identified.\",\n",
        "        \"status\": \"REVIEW_REQUIRED\"\n",
        "    })\n",
        "\n",
