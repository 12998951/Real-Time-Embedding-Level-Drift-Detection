        "    \"geometry_not_intensity_limitation_stated\":\n",
        "        \"do not represent directly measured illumination intensity\" in section_text,\n",
        "    \"same_identities_across_groups_stated\":\n",
        "        \"same 38 identities were represented in each\" in section_text,\n",
        "    \"not_exact_image_pairs_limitation_stated\":\n",
        "        \"not exact image-level pairs\" in section_text\n",
        "}\n",
        "\n",
        "word_count = len(re.findall(r\"\\b[\\w'-]+\\b\", section_text))\n",
        "\n",
        "markdown_content = f\"# {section_title}\\n\\n{section_text}\\n\"\n",
        "\n",
        "markdown_path = OUTPUT_DIR / \"experiment20_methodology_3_3_subject_condition_selection.md\"\n",
        "json_path = OUTPUT_DIR / \"experiment20_step3393_subject_condition_selection.json\"\n",
        "audit_path = OUTPUT_DIR / \"experiment20_step3393_subject_condition_selection_audit.json\"\n",
        "\n",
        "markdown_path.write_text(markdown_content, encoding=\"utf-8\")\n",
