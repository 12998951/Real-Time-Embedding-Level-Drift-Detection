        "        \"discussion_headings\": discussion_headings\n",
        "    },\n",
        "\n",
        "    \"previous_phase\": {\n",
        "        \"phase\": \"3.4\",\n",
        "        \"report_path\": PHASE34_REPORT,\n",
        "        \"report_sha256\": sha256_file(PHASE34_REPORT),\n",
        "        \"status\": phase34.get(\"status\")\n",
        "    },\n",
        "\n",
        "    \"discussion_interpretation_checks\": discussion_checks,\n",
        "    \"methodological_limitation_checks\": limitation_checks,\n",
        "    \"statistical_interpretation_checks\": statistical_checks,\n",
        "    \"research_contribution_checks\": contribution_checks,\n",
        "    \"future_research_checks\": future_work_checks,\n",
        "    \"potential_overclaim_scan\": overclaim_scan,\n",
        "\n",
        "    \"review_flags\": review_flags,\n",
        "    \"review_flag_count\": len(review_flags),\n",
        "\n",
        "    \"status\": (\n",
        "        \"DISCUSSION_LIMITATIONS_AUDIT_NO_FLAGGED_ITEMS\"\n",
        "        if len(review_flags) == 0\n",
        "        else \"DISCUSSION_LIMITATIONS_REVIEW_REQUIRED\"\n",
        "    ),\n",
        "\n",
        "    \"integrity\": {\n",
        "        \"manuscript_modified\": False,\n",
        "        \"frozen_evidence_modified\": False,\n",
        "        \"previous_phase_reports_modified\": False\n",
        "    }\n",
        "}\n",
        "\n",
        "with open(REPORT_PATH, \"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(report, f, indent=2, default=str)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 10. PRINT RESULTS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"PHASE 3.5 AUDIT RESULTS\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "for category, checks in check_groups.items():\n",
        "\n",
        "    print(\"\\n\" + category.upper())\n",
        "\n",
        "    for name, passed in checks.items():\n",
        "        print((\"PASS\" if passed else \"REVIEW\"), name)\n",
        "\n",
        "print(\"\\nFUTURE RESEARCH\")\n",
        "\n",
        "for name, value in future_work_checks.items():\n",
        "    if name == \"future_research_statements\":\n",
        "        for statement in value:\n",
        "            print(\"FOUND:\", statement)\n",
        "    else:\n",
        "        print((\"PASS\" if value else \"REVIEW\"), name)\n",
        "\n",
        "print(\"\\nPOTENTIAL OVERCLAIM SCAN\")\n",
        "\n",
        "for name, result in overclaim_scan.items():\n",
        "    print(name, \"matches:\", result[\"count\"])\n",
        "\n",
        "print(\"\\nREVIEW FLAGS:\", len(review_flags))\n",
        "\n",
        "for item in review_flags:\n",
        "    print(item[\"category\"], \"|\", item[\"issue\"])\n",
        "\n",
        "print(\"\\nFINAL STATUS:\", report[\"status\"])\n",
        "print(\"Report:\", REPORT_PATH)\n",
        "print(\"Report SHA256:\", sha256_file(REPORT_PATH))\n",
        "print(\"No existing manuscript or evidence files were modified.\")\n",
        "print(\"PHASE 3.5 AUDIT COMPLETED\")"
