        "        \"The two exploratory hemisphere sign tests use a separate Holm correction family.\",\n",
        "        \"Independence across the 38 identities cannot be established from the available evidence.\",\n",
        "        \"The hemisphere analysis remains exploratory and is confounded with angular illumination geometry.\",\n",
        "        \"The findings do not establish recognition accuracy, fairness, causality, or operational drift-detection performance.\"\n",
        "    ],\n",
        "    \"original_frozen_manuscript_modified\": False,\n",
        "    \"frozen_evaluation_csv_modified\": False,\n",
        "    \"prior_audit_reports_modified\": False,\n",
        "    \"final_manuscript\": str(final_path),\n",
        "    \"final_manuscript_sha256\": verified_hashes[\"final_amended_manuscript\"]\n",
        "}\n",
        "\n",
        "with closure_path.open(\"x\", encoding=\"utf-8\") as f:\n",
        "    json.dump(closure, f, indent=2, ensure_ascii=False)\n",
        "\n",
        "print(\"\\nClosure record saved:\", closure_path)\n",
        "print(\"Closure record SHA256:\", sha256(closure_path))\n",
        "print(\"\\nFINAL STATUS: PHASE_4_5_CLOSURE_VERIFICATION_PASSED\")\n"
