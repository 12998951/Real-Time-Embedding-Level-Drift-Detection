            "EXPERIMENT 20 — STEP 3.3.10.2\n",
            "CORRECTED FROZEN-TABLE AND HOLM-CORRECTION AUDIT\n",
            "===========================================================================\n",
            "\n",
            "[1] FROZEN CSV ROW-COUNT VERIFICATION\n",
            "experiment20_reference_evaluation_displacement.csv: expected=2128, actual=2128, PASS\n",
            "experiment20_illumination_group_descriptive_statistics.csv: expected=6, actual=6, PASS\n",
            "experiment20_identity_level_group_means.csv: expected=114, actual=114, PASS\n",
            "experiment20_paired_comparison_results.csv: expected=6, actual=6, PASS\n",
            "experiment20_identity_level_hemisphere_means.csv: expected=76, actual=76, PASS\n",
            "experiment20_hemisphere_comparison_results.csv: expected=2, actual=2, PASS\n",
            "experiment20_repeated_measures_test_results.csv: expected=2, actual=2, PASS\n",
            "\n",
