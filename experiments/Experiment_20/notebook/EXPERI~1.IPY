      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "====================================================================================================\n",
            "EXPERIMENT 20 — STEP 3.1.5.2\n",
            "CORRECT ACQUISITION LISTING VERIFICATION\n",
            "====================================================================================================\n",
            "\n",
            "ACQUISITION RECORD\n",
            "Source URL: https://academictorrents.com/download/aad8bf8e6ee5d8a3bf46c7ab5adfacdd8ad36247.torrent\n",
            "Archive SHA256: 8bbabf3836d077d60626c9ee3c54c2d2851a8d2c15c8b7e13b9bc162e86ea573\n",
            "Archive size: 58493820\n",
            "\n",
            "====================================================================================================\n",
            "LISTING VERIFICATION CHECKS\n",
            "====================================================================================================\n",
            "listing_http_success: PASS\n",
            "listing_info_hash_matches: PASS\n",
            "listing_filename_matches: PASS\n",
            "listing_size_matches: PASS\n",
            "listing_title_matches: PASS\n",
            "acquisition_url_contains_correct_info_hash: PASS\n",
            "acquisition_size_matches_listing: PASS\n",
            "\n",
            "FINAL STATUS: CORRECT_ACQUISITION_LISTING_MATCHED\n",
            "Audit saved: /content/drive/MyDrive/Experiment_20_Results/dataset_audit/experiment20_acquisition_source_reconciliation_audit.json\n",
            "Audit JSON reload: PASS\n",
            "\n",
            "IMPORTANT LIMITATION\n",
            "- Listing metadata does not independently verify torrent piece hashes.\n",
            "- Archive SHA256 establishes file identity, not official Yale authenticity.\n",
