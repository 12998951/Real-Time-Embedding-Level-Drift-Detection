        "\n",
        "import json\n",
        "import pandas as pd\n",
        "from pathlib import Path\n",
        "\n",
        "BASE = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "\n",
        "CSV_PATH = (\n",
        "    BASE / \"step_2_7\" / \"final_freeze\"\n",
        "    / \"experiment20_reference_evaluation_displacement.csv\"\n",
        ")\n",
        "\n",
        "REPORT_PATH = (\n",
        "    BASE / \"step_4_3_displacement_calculation_audit\"\n",
        "    / \"experiment20_phase43_displacement_calculation_audit.json\"\n",
        ")\n",
        "\n",
        "df = pd.read_csv(CSV_PATH)\n",
        "\n",
        "with open(REPORT_PATH, \"r\", encoding=\"utf-8\") as f:\n",
        "    report = json.load(f)\n",
        "\n",
        "print(\"=\" * 90)\n",
        "print(\"PHASE 4.3 — GEOMETRY LABEL DISCREPANCY DIAGNOSTIC\")\n",
        "print(\"=\" * 90)\n",
        "\n",
        "print(\"\\n1. EXACT ILLUMINATION GROUP LABELS IN FROZEN CSV\")\n",
        "print(df[\"illumination_group\"].value_counts(dropna=False).to_string())\n",
        "\n",
        "print(\"\\n2. EXACT HEMISPHERE LABELS IN FROZEN CSV\")\n",
        "print(df[\"hemisphere\"].value_counts(dropna=False).to_string())\n",
        "\n",
        "print(\"\\n3. RECONSTRUCTED GEOMETRY COUNTS\")\n",
        "print(json.dumps(\n",
        "    report[\"observed_cohort\"][\"reconstructed_geometry_counts\"],\n",
        "    indent=2\n",
        "))\n",
        "\n",
        "print(\"\\n4. RECONSTRUCTED HEMISPHERE COUNTS\")\n",
        "print(json.dumps(\n",
        "    report[\"observed_cohort\"][\"reconstructed_hemisphere_counts\"],\n",
        "    indent=2\n",
        "))\n",
        "\n",
        "print(\"\\n5. FROZEN CSV LABELS CROSS-TABULATED BY ANGULAR DEVIATION\")\n",
        "\n",
        "for column in [\"illumination_group\", \"hemisphere\"]:\n",
        "    print(f\"\\n{column.upper()}\")\n",
        "\n",
        "    print(pd.crosstab(\n",
        "        df[column],\n",
        "        pd.cut(\n",
        "            df[\"angular_deviation_degrees\"],\n",
        "            bins=[-1, 30, 60, 90, 180],\n",
        "            labels=[\n",
        "                \"0-30 degrees\",\n",
        "                \">30-60 degrees\",\n",
        "                \">60-90 degrees\",\n",
        "                \">90 degrees\"\n",
        "            ]\n",
        "        ),\n",
        "        dropna=False\n",
        "    ).to_string())\n",
        "\n",
        "print(\"\\n6. AUDIT'S CURRENT CATEGORICAL COMPARISON\")\n",
        "print(json.dumps(report[\"categorical_comparison\"], indent=2))\n",
        "\n",
        "print(\"\\nDIAGNOSTIC COMPLETE — NO FILES MODIFIED.\")\n"
