        "    FILES[\"3.8_statistical_analysis\"].name\n",
        "    == \"experiment20_methodology_3_8_statistical_analysis_v3.md\"\n",
        ")\n",
        "\n",
        "path_groups = {}\n",
        "\n",
        "for section, path in FILES.items():\n",
        "    path_groups.setdefault(str(path), []).append(section)\n",
        "\n",
        "duplicate_mapping = {\n",
        "    path: sections\n",
        "    for path, sections in path_groups.items()\n",
        "    if len(sections) > 1\n",
        "}\n",
        "\n",
        "checks[\"no_duplicate_section_file_mapping\"] = (\n",
        "    len(duplicate_mapping) == 0\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. REPORT CHECKS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n[2] METHODOLOGY CHECKS\")\n",
        "\n",
        "for name, result in checks.items():\n",
        "    print(f\"{name}: {'PASS' if result else 'FAIL'}\")\n",
        "\n",
        "passed = sum(checks.values())\n",
        "failed = len(checks) - passed\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. RECORD FILE HASHES\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "file_hashes = {}\n",
        "\n",
        "for section, path in FILES.items():\n",
        "\n",
        "    file_hashes[section] = hashlib.sha256(\n",
        "        path.read_bytes()\n",
        "    ).hexdigest()\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. SAVE AUDIT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "audit = {\n",
        "    \"experiment\": 20,\n",
        "    \"step\": \"3.3.9.19\",\n",
        "    \"timestamp_utc\": datetime.now(\n",
        "        timezone.utc\n",
        "    ).isoformat(),\n",
        "\n",
        "    \"methodology_sections\": list(documents.keys()),\n",
        "    \"missing_files\": missing_files,\n",
        "\n",
        "    \"file_mapping\": {\n",
        "        section: str(path)\n",
        "        for section, path in FILES.items()\n",
        "    },\n",
        "\n",
        "    \"file_sha256\": file_hashes,\n",
        "\n",
        "    \"checks\": checks,\n",
        "    \"passed_checks\": passed,\n",
        "    \"failed_checks\": failed,\n",
        "\n",
        "    \"duplicate_file_mapping\": duplicate_mapping,\n",
        "\n",
        "    \"status\": (\n",
        "        \"METHODOLOGY_CONSISTENCY_AUDIT_PASSED\"\n",
        "        if failed == 0\n",
        "        else \"METHODOLOGY_REQUIRES_REVIEW\"\n",
        "    )\n",
        "}\n",
        "\n",
        "with open(AUDIT_PATH, \"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(audit, f, indent=4)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. FINAL SUMMARY\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n[3] FILE MAPPING\")\n",
        "print(json.dumps(audit[\"file_mapping\"], indent=4))\n",
        "\n",
        "print(\"\\n[4] DUPLICATE MAPPINGS\")\n",
        "print(json.dumps(duplicate_mapping, indent=4))\n",
        "\n",
        "print(\"\\n[5] FINAL AUDIT\")\n",
        "print(\"Passed:\", passed)\n",
        "print(\"Failed:\", failed)\n",
        "print(\"Missing files:\", len(missing_files))\n",
        "print(\"Duplicate mappings:\", len(duplicate_mapping))\n",
        "print(\"Status:\", audit[\"status\"])\n",
        "\n",
        "print(\"\\nAudit saved:\", AUDIT_PATH)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 75)\n",
        "print(\"STEP 3.3.9.19 COMPLETED\")\n",
        "print(\"=\" * 75)"
      ],
