        "\n",
        "from pathlib import Path\n",
        "import hashlib\n",
        "import json\n",
        "import re\n",
        "from pprint import pprint\n",
        "\n",
        "ROOT = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "\n",
        "MANUSCRIPT = (\n",
        "    ROOT / \"step_4_5_statistical_methodology_audit\"\n",
        "    / \"experiment20_integrated_manuscript_v2_phase45_final.md\"\n",
        ")\n",
        "\n",
        "PHASE44 = (\n",
        "    ROOT / \"step_4_4_statistical_reproducibility\"\n",
        "    / \"experiment20_phase44_statistical_reproducibility_audit_corrected.json\"\n",
        ")\n",
        "\n",
        "EXPECTED_MANUSCRIPT_SHA = (\n",
        "    \"eb175d98a9018797a712e90614ace8972d2589bc1ecfd54fb59b76bdebf203e3\"\n",
        ")\n",
        "\n",
        "EXPECTED_PHASE44_SHA = (\n",
        "    \"9d7f9d825805ccc03d973d462c7427b2c8d11199cb7440e155af65d02718a214\"\n",
        ")\n",
        "\n",
        "def sha(path):\n",
        "    return hashlib.sha256(path.read_bytes()).hexdigest()\n",
        "\n",
        "print(\"=\" * 80)\n",
        "print(\"EXPERIMENT 20 — PHASE 4.6 TABLE 2 EVIDENCE RECONCILIATION\")\n",
        "print(\"=\" * 80)\n",
        "\n",
        "for name, path, expected in [\n",
        "    (\"Manuscript\", MANUSCRIPT, EXPECTED_MANUSCRIPT_SHA),\n",
        "    (\"Phase 4.4 report\", PHASE44, EXPECTED_PHASE44_SHA)\n",
        "]:\n",
        "    if not path.exists():\n",
        "        raise FileNotFoundError(path)\n",
        "\n",
        "    actual = sha(path)\n",
        "    print(f\"{name} SHA256:\", actual)\n",
        "\n",
        "    if actual != expected:\n",
        "        raise RuntimeError(f\"STOP: {name} hash mismatch.\")\n",
        "\n",
        "text = MANUSCRIPT.read_text(encoding=\"utf-8\")\n",
        "report = json.loads(PHASE44.read_text(encoding=\"utf-8\"))\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# Extract Table 2 from the manuscript\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "lines = text.splitlines()\n",
        "table_heading = None\n",
        "\n",
        "for i, line in enumerate(lines):\n",
        "    if re.match(\n",
        "        r\"^\\s{0,3}#{1,6}\\s+Table\\s+2\\.\",\n",
        "        line,\n",
        "        re.IGNORECASE\n",
        "    ):\n",
        "        table_heading = i\n",
        "        break\n",
        "\n",
        "if table_heading is None:\n",
        "    raise RuntimeError(\"Table 2 heading not found.\")\n",
        "\n",
        "table_lines = []\n",
        "\n",
        "for line in lines[table_heading + 1:]:\n",
        "    if line.strip().startswith(\"|\"):\n",
        "        table_lines.append(line)\n",
        "    elif table_lines:\n",
        "        break\n",
        "\n",
        "if len(table_lines) < 8:\n",
        "    raise RuntimeError(\"Table 2 appears incomplete.\")\n",
        "\n",
        "print(\"\\n1. MANUSCRIPT TABLE 2\")\n",
        "print(\"\\n\".join(table_lines))\n",
