        "    \"euclidean_mean\": 0.8204963498696597,\n",
        "    \"euclidean_median\": 0.8173113802009999,\n",
        "    \"cosine_mean\": 0.402439025074746,\n",
        "    \"cosine_median\": 0.333998932473\n",
        "}\n",
        "\n",
        "for key, expected in expected_overall.items():\n",
        "    actual = overall[key]\n",
        "    passed = (\n",
        "        actual == expected\n",
        "        if isinstance(expected, int)\n",
        "        else close(actual, expected, 1e-6)\n",
        "    )\n",
        "    add_check(\n",
        "        f\"Overall numerical verification: {key}\",\n",
        "        passed,\n",
        "        {\"expected\": expected, \"actual\": actual}\n",
        "    )\n",
        "\n",
        "group_counts = d[\"illumination_group\"].value_counts().to_dict()\n",
        "\n",
        "expected_group_counts = {\n",
        "    \"near_frontal\": 646,\n",
        "    \"oblique\": 418,\n",
        "    \"large_angular_deviation\": 1064\n",
        "}\n",
        "\n",
        "for group, expected in expected_group_counts.items():\n",
