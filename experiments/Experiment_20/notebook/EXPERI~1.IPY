            "euclidean_mean near_frontal large_angular_deviation 7.275958e-12           2.182787e-11                    4.365575e-11                     6 One family of six pairwise tests                                2.182787e-11                 4.365575e-11\n",
            "euclidean_mean      oblique large_angular_deviation 7.275958e-12           2.182787e-11                    4.365575e-11                     6 One family of six pairwise tests                                2.182787e-11                 4.365575e-11\n",
            "   cosine_mean near_frontal                 oblique 7.275958e-12           2.182787e-11                    4.365575e-11                     6 One family of six pairwise tests                                2.182787e-11                 4.365575e-11\n",
            "   cosine_mean near_frontal large_angular_deviation 7.275958e-12           2.182787e-11                    4.365575e-11                     6 One family of six pairwise tests                                2.182787e-11                 4.365575e-11\n",
