0_Stage_2_Frozen_Dataset/audits/experiment20_yaleb_source_audit.json\\n\",\"Experiment_20_Stage_2_Frozen_Dataset/audits/experiment20_yaleb_torrent_metadata_audit.json\\n\",\"\\n\",\"====================================================================================================\\n\",\"COHORT EVIDENCE SUMMARY\\n\",\"====================================================================================================\\n\",\"\\n\",\"ACQUISITION_RECORD\\n\",\"step: 2.6.6\\n\",\"dataset: Cropped Extended Yale Face Database B\\n\",\"source: https://academictorrents.com/download/aad8bf8e6ee5d8a3bf46c7ab5adfacdd8ad36247.torrent\\n\",\"archive_path: /content/Experiment20_Downloads/CroppedYale.zip\\n\",\"archive_size_bytes: 58493820\\n\",\"sha256: 8bbabf3836d077d60626c9ee3c54c2d2851a8d2c15c8b7e13b9bc162e86ea573\\n\",\"zip_integrity_passed: True\\n\",\"zip_member_count: 2586\\n\",\"duration_seconds: 8.68\\n\",\"timestamp_utc: 2026-11-10T22:55:47.574813+00:00\\n\",\"acceptance_status: PENDING_CONTENT_AND_PROVENANCE_AUDIT\\n\",\"\\n\",\"FILENAME_COMPLETENESS\\n\",\"step: 2.6.8\\n\",\"timestamp_utc: 2026-11-10T22:58:31.385043+00:00\\n\",\"archive_path: /content/Experiment20_Downloads/CroppedYale.zip\\n\",\"pgm_count: 2452\\n\",\"filename_valid_count: 2414\\n\",\"unmatched_pgm_count: 38\\n\",\"duplicate_condition_count: 0\\n\",\"duplicate_conditions: []\\n\",\"global_illumination_condition_count: 64\\n\",\"subject_count: 38\\n\",\"info_file_count: 38\\n\",\"bad_file_count: 18\\n\",\"log_file_count: 38\\n\",\"acceptance_status: PENDING_IMAGE_CONTENT_VALIDATION\\n\",\"\\n\",\"IMAGE_INTEGRITY\\n\",\"step: 2.6.9\\n\",\"timestamp_utc: 2026-11-10T22:59:22.862878+00:00\\n\",\"archive_path: /content/Experiment20_Downloads/CroppedYale.zip\\n\",\"total_pgm_files: 2452\\n\",\"successfully_decoded: 2452\\n\",\"decode_failures: 0\\n\",\"decode_error_details: []\\n\",\"grayscale_image_count: 2452\\n\",\"non_grayscale_image_count: 0\\n\",\"acceptance_status: PENDING_MODEL_COMPATIBILITY_REVIEW\\n\",\"\\n\",\"COMMON_CONDITION_AUDIT\\n\",\"step: 2.6.10\\n\",\"timestamp_utc: 2026-11-10T23:00:11.893072+00:00\\n\",\"archive_path: /content/Experiment20_Downloads/CroppedYale.zip\\n\",\"subject_count: 38\\n\",\"union_condition_count: 64\\n\",\"common_condition_count: 57\\n\",\"ambient_image_count: 38\\n\",\"unexpected_standard_image_dimensions: []\\n\",\"ambient_images_excluded: True\\n\",\"acceptance_status: PENDING_EXPERIMENTAL_PROTOCOL_REVIEW\\n\",\"\\n\",\"GEOMETRY_GROUPING\\n\",\"step: 2.6.11\\n\",\"timestamp_utc: 2026-11-10T23:01:21.124068+00:00\\n\",\"subject_count: 38\\n\",\"common_condition_count: 57\\n\",\"all_conditions_assigned_once: True\\n\",\"duplicate_assignments: 0\\n\",\"unassigned_conditions: 0\\n\",\"interpretation: Groups represent lighting-direction deviation, not measured illumination intensity.\\n\",\"status: GROUPING_VALIDATED\\n\",\"\\n\",\"====================================================================================================\\n\",\"FINAL EVIDENCE INVENTORY\\n\",\"====================================================================================================\\n\",\"source_audit: AVAILABLE\\n\",\"alternative_source_audit: AVAILABLE\\n\",\"acquisition_record: AVAILABLE\\n\",\"filename_completeness: AVAILABLE\\n\",\"image_integrity: AVAILABLE\\n\",\"common_condition_audit: AVAILABLE\\n\",\"common_condition_manifest: AVAILABLE\\n\",\"geometry_grouping: AVAILABLE\\n\",\"\\n\",\"No dataset files were modified.\\n\",\"No cohort membership was changed.\\n\",\"No new statistical results were calculated.\\n\",\"====================================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.1.5.1: Acquisition-Source Reconciliation\\n\",\"\\n\",\"## Objective\\n\",\"Reconcile the actual acquisition record, torrent metadata audit,\\n\",\"alternative-source audit, and frozen source archive.\\n\",\"\\n\",\"## Checks\\n\",\"1. Compare the audited candidate torrent URL with the actual acquisition URL.\\n\",\"2. Inspect the torrent metadata audit for the acquired torrent.\\n\",\"3. Extract the original CroppedYale.zip from the frozen package.\\n\",\"4. Recalculate its SHA256.\\n\",\"5. Compare the calculated hash with the acquisition record and freeze manifest.\\n\",\"6. Report whether the available evidence establishes source authenticity.\\n\",\"\\n\",\"## Restrictions\\n\",\"- Read-only.\\n\",\"- Do not download another archive.\\n\",\"- Do not replace the frozen dataset.\\n\",\"- Do not change embeddings, metadata, or analysis results.\"],\"metadata\":{\"id\":\"5mhxwEVfuwDI\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"import hashlib\\n\",\"import zipfile\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"\\n\",\"AUDIT_DIR = BASE / \\\"dataset_audit\\\"\\n\",\"\\n\",\"ACQUISITION_FILE = (\\n\",\"    AUDIT_DIR / \\\"experiment20_croppedyale_acquisition_record.json\\\"\\n\",\")\\n\",\"\\n\",\"ALTERNATIVE_FILE = (\\n\",\"    AUDIT_DIR / \\\"experiment20_yaleb_alternative_source_audit.json\\\"\\n\",\")\\n\",\"\\n\",\"TORRENT_FILE = (\\n\",\"    AUDIT_DIR / \\\"experiment20_yaleb_torrent_metadata_audit.json\\\"\\n\",\")\\n\",\"\\n\",\"FREEZE_MANIFEST = (\\n\",\"    BASE / \\\"Experiment_20_Stage_2_Freeze_Manifest.json\\\"\\n\",\")\\n\",\"\\n\",\"FROZEN_ZIP = BASE / \\\"Experiment_20_Stage_2_Frozen_Dataset.zip\\\"\\n\",\"\\n\",\"EXPECTED_ARCHIVE_SHA256 = (\\n\",\"    \\\"8bbabf3836d077d60626c9ee3c54c2d2851a8d2c15c8b7e13b9bc162e86ea573\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"=\\\" * 100)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.1.5.1: ACQUISITION-SOURCE RECONCILIATION\\\")\\n\",\"print(\\\"=\\\" * 100)\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 1. Load source records\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"def load_json(path):\\n\",\"    if not path.exists():\\n\",\"        print(f\\\"MISSING: {path}\\\")\\n\",\"        return None\\n\",\"\\n\",\"    with path.open(\\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"        return json.load(f)\\n\",\"\\n\",\"acquisition = load_json(ACQUISITION_FILE)\\n\",\"alternative = load_json(ALTERNATIVE_FILE)\\n\",\"torrent = load_json(TORRENT_FILE)\\n\",\"freeze_manifest = load_json(FREEZE_MANIFEST)\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 2. Compare source URLs and recorded identifiers\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 100)\\n\",\"print(\\\"SOURCE URL COMPARISON\\\")\\n\",\"print(\\\"=\\\" * 100)\\n\",\"\\n\",\"acquisition_url = (\\n\",\"    acquisition.get(\\\"source\\\") if acquisition else None\\n\",\")\\n\",\"\\n\",\"candidate_url = (\\n\",\"    alternative.get(\\\"source_url\\\") if alternative else None\\n\",\")\\n\",\"\\n\",\"print(\\\"Audited candidate URL:\\\", candidate_url)\\n\",\"print(\\\"Actual acquisition URL:\\\", acquisition_url)\\n\",\"\\n\",\"print(\\n\",\"    \\\"Exact URL match:\\\",\\n\",\"    acquisition_url == candidate_url\\n\",\")\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 3. Inspect torrent metadata audit\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 100)\\n\",\"print(\\\"TORRENT METADATA AUDIT\\\")\\n\",\"print(\\\"=\\\" * 100)\\n\",\"\\n\",\"if torrent is not None:\\n\",\"    print(json.dumps(\\n\",\"        torrent,\\n\",\"        indent=2,\\n\",\"        ensure_ascii=False,\\n\",\"        default=str\\n\",\"    )[:18000])\\n\",\"else:\\n\",\"    print(\\\"Torrent metadata audit unavailable.\\\")\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 4. Locate original source ZIP inside frozen package\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 100)\\n\",\"print(\\\"FROZEN SOURCE ARCHIVE HASH VERIFICATION\\\")\\n\",\"print(\\\"=\\\" * 100)\\n\",\"\\n\",\"if not FROZEN_ZIP.exists():\\n\",\"    raise FileNotFoundError(\\n\",\"        f\\\"Frozen package ZIP not found: {FROZEN_ZIP}\\\"\\n\",\"    )\\n\",\"\\n\",\"with zipfile.ZipFile(FROZEN_ZIP, \\\"r\\\") as archive:\\n\",\"\\n\",\"    candidates = [\\n\",\"        name for name in archive.namelist()\\n\",\"        if name.endswith(\\\"/source/CroppedYale.zip\\\")\\n\",\"    ]\\n\",\"\\n\",\"    if len(candidates) != 1:\\n\",\"        raise RuntimeError(\\n\",\"            f\\\"Expected one source ZIP, found {len(candidates)}: \\\"\\n\",\"            f\\\"{candidates}\\\"\\n\",\"        )\\n\",\"\\n\",\"    source_member = candidates[0]\\n\",\"\\n\",\"    source_bytes = archive.read(source_member)\\n\",\"\\n\",\"actual_sha256 = hashlib.sha256(source_bytes).hexdigest()\\n\",\"\\n\",\"print(\\\"Frozen source member:\\\", source_member)\\n\",\"print(\\\"Extracted source size:\\\", len(source_bytes))\\n\",\"print(\\\"Calculated SHA256:\\\", actual_sha256)\\n\",\"print(\\\"Expected SHA256:\\\", EXPECTED_ARCHIVE_SHA256)\\n\",\"print(\\\"SHA256 MATCH:\\\", actual_sha256 == EXPECTED_ARCHIVE_SHA256)\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 5. Inspect freeze manifest archive references\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 100)\\n\",\"print(\\\"FREEZE MANIFEST ARCHIVE REFERENCES\\\")\\n\",\"print(\\\"=\\\" * 100)\\n\",\"\\n\",\"if freeze_manifest is not None:\\n\",\"\\n\",\"    print(json.dumps(\\n\",\"        freeze_manifest,\\n\",\"        indent=2,\\n\",\"        ensure_ascii=False,\\n\",\"        default=str\\n\",\"    )[:12000])\\n\",\"\\n\",\"else:\\n\",\"    print(\\\"Freeze manifest unavailable.\\\")\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 6. Final reconciliation status\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 100)\\n\",\"print(\\\"RECONCILIATION SUMMARY\\\")\\n\",\"print(\\\"=\\\" * 100)\\n\",\"\\n\",\"print(\\\"Acquisition record available:\\\", acquisition is not None)\\n\",\"print(\\\"Alternative-source audit available:\\\", alternative is not None)\\n\",\"print(\\\"Torrent metadata audit available:\\\", torrent is not None)\\n\",\"print(\\\"Freeze manifest available:\\\", freeze_manifest is not None)\\n\",\"print(\\\"Candidate and acquisition URLs match:\\\",\\n\",\"      acquisition_url == candidate_url)\\n\",\"print(\\\"Frozen source SHA256 matches acquisition hash:\\\",\\n\",\"      actual_sha256 == EXPECTED_ARCHIVE_SHA256)\\n\",\"\\n\",\"print(\\\"\\\\nIMPORTANT:\\\")\\n\",\"print(\\\"A matching SHA256 establishes file identity, not official source authenticity.\\\")\\n\",\"print(\\\"No source authenticity claim is made by this audit.\\\")\\n\",\"print(\\\"=\\\" * 100)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"mQsjehlZuyBU\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794385852023,\"user_tz\":360,\"elapsed\":3404,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"4634ca83-79d8-4ccf-be33-309dbf6103e7\"},\"execution_count\":10,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"====================================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.1.5.1: ACQUISITION-SOURCE RECONCILIATION\\n\",\"====================================================================================================\\n\",\"\\n\",\"====================================================================================================\\n\",\"SOURCE URL COMPARISON\\n\",\"====================================================================================================\\n\",\"Audited candidate URL: htt