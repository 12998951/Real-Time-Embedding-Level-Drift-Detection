        "    \"experiment20_step3398_illumination_geometry.json\",\n",
        "\n",
        "    BASE / \"step_3_3\" / \"step_3398\" /\n",
        "    \"experiment20_step3398_illumination_geometry_audit.json\"\n",
        "]\n",
        "\n",
        "OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "def sha256_file(path):\n",
        "    h = hashlib.sha256()\n",
        "    with open(path, \"rb\") as f:\n",
        "        for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n",
        "            h.update(chunk)\n",
        "    return h.hexdigest()\n",
        "\n",
        "def compact(value, depth=0):\n",
        "    if isinstance(value, dict):\n",
        "        result = {}\n",
        "        for key, item in value.items():\n",
        "            result[key] = compact(item, depth + 1)\n",
        "        return result\n",
        "\n",
        "    if isinstance(value, list):\n",
        "        if len(value) > 15:\n",
        "            return {\n",
        "                \"_list_length\": len(value),\n",
        "                \"_first_5_items\": [\n",
        "                    compact(x, depth + 1) for x in value[:5]\n",
        "                ]\n",
        "            }\n",
        "        return [compact(x, depth + 1) for x in value]\n",
        "\n",
        "    if isinstance(value, str) and len(value) > 500:\n",
        "        return value[:500] + \"...[truncated]\"\n",
        "\n",
        "    return value\n",
        "\n",
        "print(\"=\" * 100)\n",
        "print(\"PHASE 4.1 — DATASET AND COHORT RECONCILIATION\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. Verify manuscript integrity\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "manuscript_hash = sha256_file(MANUSCRIPT)\n",
        "\n",
        "print(\"\\n1. MANUSCRIPT INTEGRITY\")\n",
        "print(\"SHA256:\", manuscript_hash)\n",
        "print(\"Matches frozen V2:\", manuscript_hash == EXPECTED_MANUSCRIPT_HASH)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. Inspect frozen dataset archive without extraction\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "zip_report = {\n",
        "    \"exists\": ZIP_PATH.is_file(),\n",
        "    \"image_count\": None,\n",
        "    \"identity_directories\": [],\n",
        "    \"metadata_files\": [],\n",
        "    \"file_count\": None,\n",
        "    \"error\": None\n",
        "}\n",
        "\n",
        "print(\"\\n2. FROZEN DATASET ARCHIVE\")\n",
        "\n",
        "if ZIP_PATH.is_file():\n",
        "    print(\"Archive:\", ZIP_PATH)\n",
        "    print(\"Archive SHA256:\", sha256_file(ZIP_PATH))\n",
        "\n",
        "    try:\n",
        "        with zipfile.ZipFile(ZIP_PATH, \"r\") as z:\n",
        "            names = z.namelist()\n",
        "            zip_report[\"file_count\"] = len(names)\n",
        "\n",
        "            image_names = [\n",
        "                n for n in names\n",
        "                if Path(n).suffix.lower() in {\n",
        "                    \".png\", \".jpg\", \".jpeg\",\n",
        "                    \".bmp\", \".tif\", \".tiff\"\n",
        "                }\n",
        "            ]\n",
        "\n",
        "            identity_dirs = set()\n",
        "\n",
        "            for name in image_names:\n",
        "                parts = Path(name).parts\n",
        "                for part in parts:\n",
        "                    if re.fullmatch(\n",
        "                        r\"(?i)(?:yale)?b\\d{2}\",\n",
        "                        part\n",
        "                    ):\n",
        "                        identity_dirs.add(part)\n",
        "\n",
        "            metadata_names = [\n",
        "                n for n in names\n",
        "                if n.lower().endswith(\n",
        "                    (\".json\", \".csv\", \".txt\", \".md\")\n",
        "                )\n",
        "            ]\n",
        "\n",
        "            zip_report[\"image_count\"] = len(image_names)\n",
        "            zip_report[\"identity_directories\"] = sorted(\n",
        "                identity_dirs\n",
        "            )\n",
        "            zip_report[\"metadata_files\"] = metadata_names[:50]\n",
        "\n",
        "            print(\"Archive files:\", len(names))\n",
        "            print(\"Image files:\", len(image_names))\n",
        "            print(\"Identity-like directories:\", len(identity_dirs))\n",
        "            print(\"Identity names:\", sorted(identity_dirs))\n",
        "            print(\"Metadata files:\", len(metadata_names))\n",
        "\n",
        "            for name in metadata_names[:30]:\n",
        "                print(\"  \", name)\n",
        "\n",
        "    except Exception as e:\n",
        "        zip_report[\"error\"] = str(e)\n",
        "        print(\"ARCHIVE INSPECTION ERROR:\", e)\n",
        "\n",
        "else:\n",
        "    print(\"REVIEW: Frozen dataset archive not found.\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. Inspect frozen dataset folder\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "folder_report = {\n",
        "    \"exists\": FROZEN_DIR.is_dir(),\n",
        "    \"image_count\": None,\n",
        "    \"identity_directories\": [],\n",
        "    \"metadata_files\": []\n",
        "}\n",
        "\n",
        "print(\"\\n3. FROZEN DATASET DIRECTORY\")\n",
        "\n",
        "if FROZEN_DIR.is_dir():\n",
        "    image_paths = []\n",
        "    metadata_paths = []\n",
        "    identity_dirs = set()\n",
        "\n",
        "    for root, dirs, files in os.walk(FROZEN_DIR):\n",
        "        for filename in files:\n",
        "            path = Path(root) / filename\n",
        "\n",
        "            if path.suffix.lower() in {\n",
        "                \".png\", \".jpg\", \".jpeg\",\n",
        "                \".bmp\", \".tif\", \".tiff\"\n",
        "            }:\n",
        "                image_paths.append(path)\n",
        "\n",
        "                for part in path.parts:\n",
        "                    if re.fullmatch(\n",
        "                        r\"(?i)(?:yale)?b\\d{2}\",\n",
        "                        part\n",
        "                    ):\n",
        "                        identity_dirs.add(part)\n",
        "\n",
        "            elif path.suffix.lower() in {\n",
        "                \".json\", \".csv\", \".txt\", \".md\"\n",
        "            }:\n",
        "                metadata_paths.append(path)\n",
        "\n",
        "    folder_report[\"image_count\"] = len(image_paths)\n",
        "    folder_report[\"identity_directories\"] = sorted(identity_dirs)\n",
        "    folder_report[\"metadata_files\"] = [\n",
        "        str(p) for p in metadata_paths[:50]\n",
        "    ]\n",
        "\n",
        "    print(\"Image files:\", len(image_paths))\n",
        "    print(\"Identity-like directories:\", len(identity_dirs))\n",
        "    print(\"Identity names:\", sorted(identity_dirs))\n",
        "    print(\"Metadata files:\", len(metadata_paths))\n",
        "\n",
        "else:\n",
        "    print(\"REVIEW: Frozen dataset folder not found.\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. Inspect provenance and cohort JSON records\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n4. PROVENANCE AND COHORT JSON INSPECTION\")\n",
        "\n",
        "json_reports = []\n",
        "\n",
        "for path in JSON_FILES:\n",
        "    if not path.is_file():\n",
        "        print(\"\\nNOT FOUND:\", path)\n",
        "        json_reports.append({\n",
        "            \"file\": str(path),\n",
        "            \"status\": \"NOT_FOUND\"\n",
        "        })\n",
        "        continue\n",
        "\n",
        "    try:\n",
        "        with open(path, \"r\", encoding=\"utf-8\") as f:\n",
        "            data = json.load(f)\n",
        "\n",
        "        summary = compact(data)\n",
        "\n",
        "        print(\"\\nFILE:\", path.name)\n",
        "        print(\"SHA256:\", sha256_file(path))\n",
        "        print(json.dumps(\n",
        "            summary,\n",
        "            indent=2,\n",
        "            ensure_ascii=False\n",
        "        )[:12000])\n",
        "\n",
        "        json_reports.append({\n",
        "            \"file\": str(path),\n",
        "            \"status\": \"READ\",\n",
        "            \"sha256\": sha256_file(path),\n",
        "            \"content\": summary\n",
        "        })\n",
        "\n",
        "    except Exception as e:\n",
        "        print(\"\\nERROR:\", path)\n",
        "        print(str(e))\n",
        "\n",
        "        json_reports.append({\n",
        "            \"file\": str(path),\n",
        "            \"status\": \"ERROR\",\n",
        "            \"error\": str(e)\n",
        "        })\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. Correctly inspect evaluation CSV columns\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n5. EVALUATION CSV RECONCILIATION\")\n",
        "\n",
        "if not DISPLACEMENT_CSV.is_file():\n",
        "    raise FileNotFoundError(\n",
        "        f\"Frozen displacement CSV missing: {DISPLACEMENT_CSV}\"\n",
        "    )\n",
        "\n",
        "with open(\n",
        "    DISPLACEMENT_CSV,\n",
        "    \"r\",\n",
        "    encoding=\"utf-8-sig\",\n",
        "    newline=\"\"\n",
        ") as f:\n",
        "    reader = csv.DictReader(f)\n",
        "    fieldnames = reader.fieldnames or []\n",
        "    rows = list(reader)\n",
        "\n",
        "print(\"CSV:\", DISPLACEMENT_CSV)\n",
        "print(\"SHA256:\", sha256_file(DISPLACEMENT_CSV))\n",
        "print(\"Columns:\", fieldnames)\n",
        "print(\"Rows:\", len(rows))\n",
        "\n",
        "required_columns = [\n",
        "    \"subject\",\n",
        "    \"reference_condition\",\n",
        "    \"evaluation_condition\",\n",
        "    \"reference_filename\",\n",
        "    \"evaluation_filename\"\n",
        "]\n",
        "\n",
        "missing_columns = [\n",
        "    c for c in required_columns\n",
        "    if c not in fieldnames\n",
        "]\n",
        "\n",
        "if missing_columns:\n",
        "    raise ValueError(\n",
        "        \"Required columns missing: \" + str(missing_columns)\n",
        "    )\n",
        "\n",
        "subjects = sorted({\n",
        "    row[\"subject\"].strip()\n",
        "    for row in rows\n",
        "    if row[\"subject\"].strip()\n",
        "})\n",
        "\n",
        "reference_conditions = sorted({\n",
        "    row[\"reference_condition\"].strip()\n",
        "    for row in rows\n",
        "    if row[\"reference_condition\"].strip()\n",
        "})\n",
        "\n",
        "evaluation_conditions = sorted({\n",
        "    row[\"evaluation_condition\"].strip()\n",
        "    for row in rows\n",
        "    if row[\"evaluation_condition\"].strip()\n",
        "})\n",
        "\n",
        "reference_filenames = sorted({\n",
        "    row[\"reference_filename\"].strip()\n",
        "    for row in rows\n",
        "    if row[\"reference_filename\"].strip()\n",
        "})\n",
        "\n",
        "evaluation_filenames = sorted({\n",
        "    row[\"evaluation_filename\"].strip()\n",
        "    for row in rows\n",
        "    if row[\"evaluation_filename\"].strip()\n",
        "})\n",
        "\n",
        "subject_reference_pairs = {\n",
        "    (\n",
        "        row[\"subject\"].strip(),\n",
        "        row[\"reference_filename\"].strip()\n",
        "    )\n",
        "    for row in rows\n",
        "    if row[\"subject\"].strip()\n",
        "    and row[\"reference_filename\"].strip()\n",
        "}\n",
        "\n",
        "reference_condition_by_subject = {}\n",
        "\n",
        "for row in rows:\n",
        "    subject = row[\"subject\"].strip()\n",
        "    condition = row[\"reference_condition\"].strip()\n",
        "\n",
        "    if subject:\n",
        "        reference_condition_by_subject.setdefault(\n",
        "            subject, set()\n",
        "        ).add(condition)\n",
        "\n",
        "inconsistent_reference_conditions = {\n",
        "    subject: sorted(conditions)\n",
        "    for subject, conditions in reference_condition_by_subject.items()\n",
        "    if len(conditions) != 1\n",
        "}\n",
        "\n",
        "evaluation_summary = {\n",
        "    \"row_count\": len(rows),\n",
        "    \"unique_subjects\": len(subjects),\n",
        "    \"unique_reference_conditions\": len(reference_conditions),\n",
        "    \"unique_evaluation_conditions\": len(evaluation_conditions),\n",
        "    \"unique_reference_filenames\": len(reference_filenames),\n",
        "    \"unique_evaluation_filenames\": len(evaluation_filenames),\n",
        "    \"unique_subject_reference_pairs\": len(subject_reference_pairs),\n",
        "    \"subjects\": subjects,\n",
        "    \"reference_conditions\": reference_conditions,\n",
        "    \"evaluation_conditions\": evaluation_conditions,\n",
        "    \"inconsistent_reference_conditions_by_subject\":\n",
        "        inconsistent_reference_conditions\n",
        "}\n",
        "\n",
        "for key, value in evaluation_summary.items():\n",
        "    if isinstance(value, list) and len(value) > 20:\n",
        "        print(key, \"count:\", len(value))\n",
        "        print(\"First 10:\", value[:10])\n",
        "    else:\n",
        "        print(key, \":\", value)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. Compare duplicate displacement CSV copies\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n6. DUPLICATE CSV CONSISTENCY\")\n",
        "\n",
        "csv_copy_report = {\n",
        "    \"copy_exists\": CSV_COPY.is_file(),\n",
        "    \"same_sha256\": None\n",
        "}\n",
        "\n",
        "if CSV_COPY.is_file():\n",
        "    primary_hash = sha256_file(DISPLACEMENT_CSV)\n",
        "    copy_hash = sha256_file(CSV_COPY)\n",
        "\n",
        "    csv_copy_report.update({\n",
        "        \"primary_sha256\": primary_hash,\n",
        "        \"copy_sha256\": copy_hash,\n",
        "        \"same_sha256\": primary_hash == copy_hash\n",
        "    })\n",
        "\n",
        "    print(\"Primary SHA256:\", primary_hash)\n",
        "    print(\"Copy SHA256:\", copy_hash)\n",
        "    print(\"Exact copies:\", primary_hash == copy_hash)\n",
        "else:\n",
        "    print(\"Secondary CSV copy not found.\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. Basic arithmetic reconciliation\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n7. COHORT ARITHMETIC\")\n",
        "\n",
        "arithmetic_checks = {\n",
        "    \"evaluation_plus_reference_equals_common_observations\": (\n",
        "        EXPECTED[\"evaluation_observations\"]\n",
        "        + EXPECTED[\"reference_observations\"]\n",
        "        == EXPECTED[\"common_condition_observations\"]\n",
        "    ),\n",
        "    \"evaluation_conditions_plus_reference_condition_equals_common_conditions\": (\n",
        "        EXPECTED[\"evaluation_conditions\"] + 1\n",
        "        == EXPECTED[\"common_conditions\"]\n",
        "    ),\n",
        "    \"observed_evaluation_rows_match_expected\": (\n",
        "        len(rows) == EXPECTED[\"evaluation_observations\"]\n",
        "    ),\n",
        "    \"observed_identity_count_matches_expected\": (\n",
        "        len(subjects) == EXPECTED[\"identities\"]\n",
        "    ),\n",
        "    \"observed_evaluation_condition_count_matches_expected\": (\n",
        "        len(evaluation_conditions)\n",
        "        == EXPECTED[\"evaluation_conditions\"]\n",
        "    ),\n",
        "    \"observed_reference_condition_count_is_one\": (\n",
        "        len(reference_conditions) == 1\n",
        "    ),\n",
        "    \"observed_unique_reference_filenames_match_identities\": (\n",
        "        len(reference_filenames) == EXPECTED[\"reference_observations\"]\n",
        "    )\n",
        "}\n",
        "\n",
        "for key, value in arithmetic_checks.items():\n",
        "    print((\"PASS\" if value else \"REVIEW\"), key, \"=\", value)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 8. Build reconciliation report\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "report = {\n",
        "    \"experiment\": \"Experiment 20\",\n",
        "    \"phase\": \"4.1\",\n",
        "    \"title\": \"Dataset and Cohort Reconciliation\",\n",
        "    \"expected_counts\": EXPECTED,\n",
        "    \"manuscript_sha256\": manuscript_hash,\n",
        "    \"manuscript_matches_frozen_v2\": (\n",
        "        manuscript_hash == EXPECTED_MANUSCRIPT_HASH\n",
        "    ),\n",
        "    \"frozen_dataset_archive\": zip_report,\n",
        "    \"frozen_dataset_directory\": folder_report,\n",
        "    \"provenance_json_inspections\": json_reports,\n",
        "    \"evaluation_csv_summary\": evaluation_summary,\n",
        "    \"duplicate_csv_comparison\": csv_copy_report,\n",
        "    \"arithmetic_checks\": arithmetic_checks,\n",
        "    \"limitations\": [\n",
        "        \"The evaluation CSV contains non-reference evaluation rows, not separate reference rows.\",\n",
        "        \"Reference observations must be traced through the reference manifest or provenance records.\",\n",
        "        \"Dataset image counts must be reconciled against the exact frozen dataset and its exclusions.\",\n",
        "        \"A dataset archive listing alone does not prove that every image entered the final common-condition cohort.\"\n",
        "    ],\n",
        "    \"source_files_modified\": False\n",
        "}\n",
        "\n",
        "with open(REPORT_PATH, \"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(report, f, indent=2, ensure_ascii=False)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"PHASE 4.1 RECONCILIATION REPORT\")\n",
        "print(\"=\" * 100)\n",
        "print(\"Report:\", REPORT_PATH)\n",
        "print(\"Report SHA256:\", sha256_file(REPORT_PATH))\n",
        "print(\"Manuscript unchanged:\", manuscript_hash == EXPECTED_MANUSCRIPT_HASH)\n",
        "print(\"Source files modified: False\")\n",
        "print(\n",
        "    \"STATUS: \"\n",
        "    \"RECONCILIATION_REPORT_CREATED_PENDING_FINAL_REVIEW\"\n",
        ")\n"
      ],
