            "\n",
            "\n",
            "print(\"=\" * 80)\n",
            "print(\"STEP 17.10.6.5 — FINAL RESEARCH EVIDENCE PACKAGE\")\n",
            "print(\"=\" * 80)\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 1. CONFIGURATION AND REQUIRED FILE VERIFICATION\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "RESULTS_DIR = \"/content/drive/MyDrive/Experiment_18_Results\"\n",
            "\n",
            "ORIGINAL_ARCHIVE = os.path.join(\n",
            "    RESULTS_DIR,\n",
            "    \"experiment18_facenet_lfw_embeddings.npz\"\n",
            ")\n",
            "\n",
            "ILLUMINATION_ARCHIVE = os.path.join(\n",
            "    RESULTS_DIR,\n",
            "    \"experiment18_illumination_results.npz\"\n",
            ")\n",
            "\n",
            "METADATA_FILE = os.path.join(\n",
            "    RESULTS_DIR,\n",
            "    \"illumination_metadata.json\"\n",
            ")\n",
            "\n",
            "CSV_FILE = os.path.join(\n",
            "    RESULTS_DIR,\n",
            "    \"illumination_identity_summary.csv\"\n",
            ")\n",
            "\n",
            "required_files = [\n",
            "    ORIGINAL_ARCHIVE,\n",
            "    ILLUMINATION_ARCHIVE,\n",
            "    METADATA_FILE,\n",
            "    CSV_FILE\n",
            "]\n",
            "\n",
            "missing_files = [\n",
            "    path for path in required_files\n",
            "    if not os.path.isfile(path)\n",
            "]\n",
            "\n",
            "assert not missing_files, (\n",
            "    \"Required experiment files are missing:\\n\"\n",
            "    + \"\\n\".join(missing_files)\n",
            ")\n",
            "\n",
            "required_variables = [\n",
            "    \"evaluation_detector_df\",\n",
            "    \"identity_detector_df\",\n",
            "    \"statistical_results\",\n",
            "    \"effect_size_df\"\n",
            "]\n",
            "\n",
            "missing_variables = [\n",
            "    name for name in required_variables\n",
            "    if name not in globals()\n",
            "]\n",
            "\n",
            "assert not missing_variables, (\n",
            "    \"Required validated DataFrames are unavailable: \"\n",
            "    + \", \".join(missing_variables)\n",
            ")\n",
            "\n",
            "for name in required_variables:\n",
            "    assert isinstance(globals()[name], pd.DataFrame), (\n",
            "        f\"{name} is not a DataFrame.\"\n",
            "    )\n",
            "\n",
            "print(\"Section 1: Required files and detector tables verified.\")\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 2. LOAD EXISTING EXPERIMENT OUTPUTS\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "with np.load(\n",
            "    ORIGINAL_ARCHIVE,\n",
            "    allow_pickle=False\n",
            ") as original_data:\n",
            "\n",
            "    original_shapes = {\n",
            "        key: list(original_data[key].shape)\n",
            "        for key in original_data.files\n",
            "    }\n",
            "\n",
            "with np.load(\n",
            "    ILLUMINATION_ARCHIVE,\n",
            "    allow_pickle=False\n",
            ") as illumination_data:\n",
