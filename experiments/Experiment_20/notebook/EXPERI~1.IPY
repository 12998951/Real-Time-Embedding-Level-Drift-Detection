        "    ],\n",
        "    \"Group statistics CSV\"\n",
        ")\n",
        "\n",
        "recomputed_groups = (\n",
        "    d.groupby(\"illumination_group\")\n",
        "    .agg(\n",
        "        observations=(\"subject\", \"size\"),\n",
        "        identities=(\"subject\", \"nunique\"),\n",
        "        conditions=(\"evaluation_condition\", \"nunique\"),\n",
        "        euclidean_mean=(\"euclidean_displacement\", \"mean\"),\n",
        "        euclidean_median=(\"euclidean_displacement\", \"median\"),\n",
        "        euclidean_sd=(\"euclidean_displacement\", \"std\"),\n",
        "        cosine_mean=(\"cosine_distance\", \"mean\"),\n",
        "        cosine_median=(\"cosine_distance\", \"median\"),\n",
        "        cosine_sd=(\"cosine_distance\", \"std\")\n",
        "    )\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "for _, row in group_stats.iterrows():\n",
        "    group = row[\"illumination_group\"]\n",
        "    metric = str(row[\"metric\"]).lower()\n",
        "\n",
        "    match = recomputed_groups[\n",
        "        recomputed_groups[\"illumination_group\"] == group\n",
        "    ]\n",
        "\n",
        "    if match.empty:\n",
        "        add_check(\n",
        "            f\"Group statistics record: {group}\",\n",
        "            False,\n",
        "            \"Group not found in primary displacement data\"\n",
        "        )\n",
        "        continue\n",
        "\n",
        "    source = match.iloc[0]\n",
        "\n",
        "    if \"euclidean\" in metric:\n",
        "        values = (\n",
        "            source[\"euclidean_mean\"],\n",
        "            source[\"euclidean_median\"],\n",
        "            source[\"euclidean_sd\"]\n",
        "        )\n",
        "    elif \"cosine\" in metric:\n",
        "        values = (\n",
        "            source[\"cosine_mean\"],\n",
        "            source[\"cosine_median\"],\n",
        "            source[\"cosine_sd\"]\n",
        "        )\n",
        "    else:\n",
        "        add_check(\n",
        "            f\"Recognised metric: {metric}\",\n",
        "            False,\n",
        "            \"Unrecognised metric label\"\n",
        "        )\n",
        "        continue\n",
        "\n",
        "    for label, frozen_value, recalculated in zip(\n",
        "        [\"mean\", \"median\", \"standard_deviation\"],\n",
        "        [row[\"mean\"], row[\"median\"], row[\"standard_deviation\"]],\n",
        "        values\n",
        "    ):\n",
        "        add_check(\n",
        "            f\"Group {label}: {group}/{metric}\",\n",
        "            close(frozen_value, recalculated),\n",
        "            {\n",
        "                \"frozen\": float(frozen_value),\n",
        "                \"recalculated\": float(recalculated)\n",
        "            }\n",
        "        )\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 8. IDENTITY-LEVEL MEANS\n",
        "# ------------------------------------------------\n",
        "\n",
        "identity_means = data[\"identity_group_means\"]\n",
        "\n",
        "recomputed_identity = (\n",
        "    d.groupby([\"subject\", \"illumination_group\"])\n",
        "    .agg(\n",
        "        euclidean_mean=(\"euclidean_displacement\", \"mean\"),\n",
        "        euclidean_median=(\"euclidean_displacement\", \"median\"),\n",
        "        cosine_mean=(\"cosine_distance\", \"mean\"),\n",
        "        cosine_median=(\"cosine_distance\", \"median\"),\n",
        "        evaluation_conditions=(\"evaluation_condition\", \"nunique\"),\n",
        "        observations=(\"subject\", \"size\")\n",
        "    )\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "merged = identity_means.merge(\n",
        "    recomputed_identity,\n",
        "    on=[\"subject\", \"illumination_group\"],\n",
        "    suffixes=(\"_frozen\", \"_recomputed\"),\n",
        "    validate=\"one_to_one\"\n",
        ")\n",
        "\n",
        "add_check(\n",
        "    \"Identity-level record count\",\n",
        "    len(merged) == 114,\n",
        "    len(merged)\n",
        ")\n",
        "\n",
        "for col in [\n",
        "    \"euclidean_mean\",\n",
        "    \"euclidean_median\",\n",
        "    \"cosine_mean\",\n",
        "    \"cosine_median\",\n",
        "    \"evaluation_conditions\",\n",
        "    \"observations\"\n",
        "]:\n",
        "    a = pd.to_numeric(merged[f\"{col}_frozen\"])\n",
        "    b = pd.to_numeric(merged[f\"{col}_recomputed\"])\n",
        "\n",
        "    add_check(\n",
        "        f\"Identity-level recalculation: {col}\",\n",
        "        np.allclose(a, b, rtol=1e-7, atol=1e-8),\n",
        "        f\"Compared {len(merged)} identity-group records\"\n",
        "    )\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 9. REPEATED-MEASURES RESULTS\n",
        "# ------------------------------------------------\n",
        "\n",
        "repeated = data[\"repeated_measures\"]\n",
        "\n",
        "require_columns(\n",
        "    repeated,\n",
        "    [\n",
        "        \"metric\", \"identities\", \"groups\",\n",
        "        \"test_statistic\", \"p_value\", \"kendalls_w\"\n",
        "    ],\n",
        "    \"Repeated measures CSV\"\n",
        ")\n",
        "\n",
        "for _, row in repeated.iterrows():\n",
        "    metric = str(row[\"metric\"])\n",
        "\n",
        "    add_check(\n",
        "        f\"Friedman identity count: {metric}\",\n",
        "        int(row[\"identities\"]) == 38,\n",
        "        row[\"identities\"]\n",
        "    )\n",
        "\n",
        "    add_check(\n",
        "        f\"Friedman group count: {metric}\",\n",
        "        int(row[\"groups\"]) == 3,\n",
        "        row[\"groups\"]\n",
        "    )\n",
        "\n",
        "    add_check(\n",
        "        f\"Friedman statistic: {metric}\",\n",
        "        close(row[\"test_statistic\"], 76.0),\n",
        "        row[\"test_statistic\"]\n",
        "    )\n",
        "\n",
        "    add_check(\n",
        "        f\"Friedman p-value: {metric}\",\n",
        "        close(row[\"p_value\"], 3.139132792048018e-17, 1e-5),\n",
        "        row[\"p_value\"]\n",
        "    )\n",
        "\n",
        "    add_check(\n",
        "        f\"Kendall W: {metric}\",\n",
        "        close(row[\"kendalls_w\"], 1.0),\n",
        "        row[\"kendalls_w\"]\n",
        "    )\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 10. SIX-TEST HOLM CORRECTION\n",
        "# ------------------------------------------------\n",
        "\n",
        "holm_path = (\n",
        "    STEP_33103 / \"experiment20_manuscript_six_test_holm_results.csv\"\n",
        ")\n",
        "\n",
        "if not holm_path.is_file():\n",
        "    raise FileNotFoundError(holm_path)\n",
        "\n",
        "holm = pd.read_csv(holm_path)\n",
        "\n",
        "require_columns(\n",
        "    holm,\n",
        "    [\"holm_adjusted_p_value\"],\n",
        "    \"Six-test Holm CSV\"\n",
        ")\n",
        "\n",
        "holm_values = pd.to_numeric(\n",
        "    holm[\"holm_adjusted_p_value\"],\n",
        "    errors=\"coerce\"\n",
        ")\n",
        "\n",
        "expected_holm = 4.3655745685080005e-11\n",
        "\n",
        "add_check(\n",
        "    \"Six-test Holm row count\",\n",
        "    len(holm) == 6,\n",
        "    len(holm)\n",
        ")\n",
        "\n",
        "add_check(\n",
        "    \"Six-test Holm adjusted p-values\",\n",
        "    len(holm_values.dropna()) == 6\n",
        "    and np.allclose(\n",
        "        holm_values.dropna(),\n",
        "        expected_holm,\n",
        "        rtol=1e-5,\n",
        "        atol=0\n",
        "    ),\n",
        "    holm_values.tolist()\n",
        ")\n",
        "\n",
        "paired = data[\"paired_comparisons\"]\n",
        "\n",
        "require_columns(\n",
        "    paired,\n",
        "    [\"bootstrap_iterations\", \"random_seed\"],\n",
        "    \"Paired comparisons CSV\"\n",
        ")\n",
        "\n",
        "add_check(\n",
        "    \"Pairwise bootstrap iterations\",\n",
        "    (paired[\"bootstrap_iterations\"] == 20000).all(),\n",
        "    paired[\"bootstrap_iterations\"].tolist()\n",
        ")\n",
        "\n",
        "add_check(\n",
        "    \"Pairwise bootstrap seed\",\n",
        "    (paired[\"random_seed\"] == 2026274).all(),\n",
        "    paired[\"random_seed\"].tolist()\n",
        ")\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 11. CORRECTED HEMISPHERE LABEL DETECTION\n",
        "# ------------------------------------------------\n",
        "\n",
        "print(\"\\nHEMISPHERE LABEL DIAGNOSTIC\")\n",
        "\n",
        "raw_labels = (\n",
        "    d[\"hemisphere\"]\n",
        "    .dropna()\n",
        "    .astype(str)\n",
        "    .unique()\n",
        "    .tolist()\n",
        ")\n",
        "\n",
        "print(\"Actual labels in displacement CSV:\", raw_labels)\n",
        "\n",
        "normalised_labels = {\n",
        "    label: normalise_label(label)\n",
        "    for label in raw_labels\n",
        "}\n",
        "\n",
        "print(\"Normalised labels:\", normalised_labels)\n",
        "\n",
        "# Identify beyond-frontal first to avoid classifying it as frontal.\n",
        "beyond_labels = [\n",
        "    original\n",
        "    for original, norm in normalised_labels.items()\n",
        "    if (\n",
        "        \"beyond\" in norm\n",
        "        or \"nonfrontal\" in norm\n",
        "        or \"non_frontal\" in norm\n",
        "    )\n",
        "]\n",
        "\n",
        "frontal_labels = [\n",
        "    original\n",
        "    for original, norm in normalised_labels.items()\n",
        "    if (\n",
        "        \"frontal\" in norm\n",
        "        and original not in beyond_labels\n",
        "    )\n",
        "]\n",
        "\n",
        "if len(beyond_labels) != 1 or len(frontal_labels) != 1:\n",
        "    raise ValueError(\n",
        "        \"\\nCould not uniquely identify the two hemisphere categories.\\n\"\n",
        "        f\"Actual labels: {raw_labels}\\n\"\n",
        "        f\"Detected frontal labels: {frontal_labels}\\n\"\n",
        "        f\"Detected beyond-frontal labels: {beyond_labels}\\n\"\n",
        "        \"Do not guess the mapping. Inspect the source labels before proceeding.\"\n",
        "    )\n",
        "\n",
        "FRONTAL_LABEL = frontal_labels[0]\n",
        "BEYOND_LABEL = beyond_labels[0]\n",
        "\n",
        "print(\"Detected frontal category:\", FRONTAL_LABEL)\n",
        "print(\"Detected beyond-frontal category:\", BEYOND_LABEL)\n",
        "\n",
        "# Use the actual values, not hard-coded category names.\n",
        "hemisphere_grouped = (\n",
        "    d.groupby(\"hemisphere\")\n",
        "    .agg(\n",
        "        observations=(\"subject\", \"size\"),\n",
        "        conditions=(\"evaluation_condition\", \"nunique\"),\n",
        "        identities=(\"subject\", \"nunique\")\n",
        "    )\n",
        ")\n",
        "\n",
        "print(\"\\nRecalculated hemisphere counts:\")\n",
        "print(hemisphere_grouped)\n",
        "\n",
        "frontal_counts = hemisphere_grouped.loc[FRONTAL_LABEL]\n",
        "beyond_counts = hemisphere_grouped.loc[BEYOND_LABEL]\n",
        "\n",
        "expected_hemisphere_counts = {\n",
        "    \"frontal_conditions\": 45,\n",
        "    \"beyond_frontal_conditions\": 11,\n",
        "    \"frontal_observations\": 1710,\n",
        "    \"beyond_frontal_observations\": 418\n",
        "}\n",
        "\n",
        "actual_hemisphere_counts = {\n",
        "    \"frontal_conditions\": int(frontal_counts[\"conditions\"]),\n",
        "    \"beyond_frontal_conditions\": int(beyond_counts[\"conditions\"]),\n",
        "    \"frontal_observations\": int(frontal_counts[\"observations\"]),\n",
        "    \"beyond_frontal_observations\": int(beyond_counts[\"observations\"])\n",
        "}\n",
        "\n",
        "for key, expected in expected_hemisphere_counts.items():\n",
        "    actual = actual_hemisphere_counts[key]\n",
        "    add_check(\n",
        "        f\"Hemisphere count: {key}\",\n",
        "        actual == expected,\n",
        "        {\"expected\": expected, \"actual\": actual}\n",
        "    )\n",
        "\n",
        "hemisphere_results = data[\"hemisphere_comparisons\"]\n",
        "\n",
        "require_columns(\n",
        "    hemisphere_results,\n",
        "    [\n",
        "        \"metric\",\n",
        "        \"mean_paired_difference_beyond_minus_frontal\",\n",
        "        \"bootstrap_iterations\",\n",
        "        \"random_seed\"\n",
        "    ],\n",
        "    \"Hemisphere comparison CSV\"\n",
        ")\n",
        "\n",
        "expected_differences = {\n",
        "    \"euclidean\": 0.5817697453,\n",
        "    \"cosine\": 0.5428074466\n",
        "}\n",
        "\n",
        "for metric, expected in expected_differences.items():\n",
        "    row = hemisphere_results[\n",
        "        hemisphere_results[\"metric\"].astype(str).str.lower() == metric\n",
        "    ]\n",
        "\n",
        "    if len(row) != 1:\n",
        "        add_check(\n",
        "            f\"Hemisphere comparison row: {metric}\",\n",
        "            False,\n",
        "            f\"Found {len(row)} rows\"\n",
        "        )\n",
        "        continue\n",
        "\n",
        "    actual = float(\n",
        "        row.iloc[0][\"mean_paired_difference_beyond_minus_frontal\"]\n",
        "    )\n",
        "\n",
        "    add_check(\n",
        "        f\"Hemisphere paired difference: {metric}\",\n",
        "        close(actual, expected, 1e-6),\n",
        "        {\"expected\": expected, \"actual\": actual}\n",
        "    )\n",
        "\n",
        "add_check(\n",
        "    \"Hemisphere bootstrap iterations\",\n",
        "    (hemisphere_results[\"bootstrap_iterations\"] == 20000).all(),\n",
        "    hemisphere_results[\"bootstrap_iterations\"].tolist()\n",
        ")\n",
        "\n",
        "add_check(\n",
        "    \"Hemisphere bootstrap seed\",\n",
        "    (hemisphere_results[\"random_seed\"] == 2026275).all(),\n",
        "    hemisphere_results[\"random_seed\"].tolist()\n",
        ")\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 12. FIGURE AUDIT\n",
        "# ------------------------------------------------\n",
        "\n",
        "expected_figures = [\n",
        "    \"experiment20_figure1_euclidean_illumination_groups.png\",\n",
        "    \"experiment20_figure2_cosine_illumination_groups.png\",\n",
        "    \"experiment20_figure3_euclidean_hemisphere_comparison.png\",\n",
        "    \"experiment20_figure4_cosine_hemisphere_comparison.png\"\n",
        "]\n",
        "\n",
        "figure_records = []\n",
        "\n",
        "for filename in expected_figures:\n",
        "    path = FROZEN / filename\n",
        "    exists = path.is_file()\n",
        "\n",
        "    figure_records.append({\n",
        "        \"filename\": filename,\n",
        "        \"exists\": exists,\n",
        "        \"sha256\": sha256_file(path) if exists else None,\n",
        "        \"size_bytes\": path.stat().st_size if exists else None\n",
        "    })\n",
        "\n",
        "    add_check(\n",
        "        f\"Figure exists: {filename}\",\n",
        "        exists,\n",
        "        \"Found\" if exists else \"Missing\"\n",
        "    )\n",
        "\n",
        "markdown_images = re.findall(\n",
        "    r\"!\\[([^\\]]*)\\]\\(([^)]+)\\)\",\n",
        "    manuscript\n",
        ")\n",
        "\n",
        "figure_mentions = re.findall(\n",
        "    r\"(?i)\\bFigure\\s+\\d+\",\n",
        "    manuscript\n",
        ")\n",
        "\n",
        "if not markdown_images:\n",
        "    add_issue(\n",
        "        \"MAJOR\",\n",
        "        \"Figure integration\",\n",
        "        \"No Markdown image embeds detected.\",\n",
        "        {\n",
        "            \"frozen_figures\": len(figure_records),\n",
        "            \"figure_mentions\": len(figure_mentions)\n",
        "        },\n",
        "        \"Integrate the appropriate figures with numbered captions and in-text references.\"\n",
        "    )\n",
        "\n",
        "if not figure_mentions:\n",
        "    add_issue(\n",
        "        \"MAJOR\",\n",
        "        \"Figure references\",\n",
        "        \"No textual Figure references detected.\",\n",
        "        \"No Figure-number references found.\",\n",
        "        \"Add references to relevant figures in the Results and Discussion.\"\n",
        "    )\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 13. TABLE AUDIT\n",
        "# ------------------------------------------------\n",
        "\n",
        "table_lines = re.findall(\n",
        "    r\"(?m)^\\|.*\\|$\",\n",
        "    manuscript\n",
        ")\n",
        "\n",
        "table_separators = re.findall(\n",
        "    r\"(?m)^\\|[\\s:|\\-]+\\|$\",\n",
        "    manuscript\n",
        ")\n",
        "\n",
        "add_check(\n",
        "    \"At least two Markdown tables\",\n",
        "    len(table_separators) >= 2,\n",
        "    len(table_separators)\n",
        ")\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 14. LIMITATIONS AUDIT\n",
        "# ------------------------------------------------\n",
        "\n",
        "limitation_requirements = [\n",
        "    (\"Cropped frontal-pose subset\", [\"cropped\", \"frontal\"]),\n",
        "    (\"Community-hosted provenance\", [\"academic torrents\"]),\n",
        "    (\"Checksum limitation\", [\"checksum\"]),\n",
        "    (\"Different captures\", [\"capture\", \"source image\"]),\n",
        "    (\"Pretrained FaceNet\", [\"facenet\", \"pretrained\"]),\n",
        "    (\"Grayscale to RGB\", [\"grayscale\", \"rgb\"]),\n",
        "    (\"Direct resizing\", [\"resize\"]),\n",
        "    (\"Geometry versus intensity\", [\"geometry\", \"intensity\"]),\n",
        "    (\"Exploratory hemisphere analysis\", [\"exploratory\", \"hemisphere\"]),\n",
        "    (\"Euclidean-cosine relationship\", [\"squared euclidean distance\", \"cosine distance\"]),\n",
        "    (\"Retrospective hypotheses\", [\"retrospective\"])\n",
        "]\n",
        "\n",
        "limitation_results = []\n",
        "\n",
        "for name, terms in limitation_requirements:\n",
        "    present = all(t.lower() in manuscript.lower() for t in terms)\n",
        "\n",
        "    limitation_results.append({\n",
        "        \"limitation\": name,\n",
        "        \"required_terms\": terms,\n",
        "        \"detected\": present\n",
        "    })\n",
        "\n",
        "    add_check(\n",
        "        f\"Limitation: {name}\",\n",
        "        present,\n",
        "        \"Detected\" if present else \"Requires review\"\n",
        "    )\n",
        "\n",
        "    if not present:\n",
        "        add_issue(\n",
        "            \"MAJOR\",\n",
        "            \"Methodological limitations\",\n",
        "            f\"Limitation not detected: {name}\",\n",
        "            terms,\n",
        "            \"Inspect the relevant section and ensure the limitation is explicitly described.\"\n",
        "        )\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 15. OVERCLAIM SCAN\n",
        "# ------------------------------------------------\n",
        "\n",
        "overclaim_patterns = {\n",
        "    \"Recognition accuracy\": [\n",
        "        r\"improves?\\s+recognition\\s+accuracy\",\n",
        "        r\"achieves?\\s+high\\s+recognition\\s+accuracy\"\n",
        "    ],\n",
        "    \"Fairness\": [\n",
        "        r\"ensures?\\s+fairness\",\n",
        "        r\"improves?\\s+biometric\\s+fairness\"\n",
        "    ],\n",
        "    \"Bias mitigation\": [\n",
        "        r\"mitigates?\\s+bias\",\n",
        "        r\"eliminates?\\s+bias\"\n",
        "    ],\n",
        "    \"Deployment readiness\": [\n",
        "        r\"deployment[- ]ready\",\n",
        "        r\"ready\\s+for\\s+production\"\n",
        "    ],\n",
        "    \"Causal illumination claims\": [\n",
        "        r\"caused\\s+by\\s+illumination\",\n",
        "        r\"proves?\\s+that\\s+illumination\\s+causes?\"\n",
        "    ],\n",
        "    \"Established novelty\": [\n",
        "        r\"first[- ]ever\",\n",
        "        r\"unprecedented\",\n",
        "        r\"establishes?\\s+novelty\"\n",
        "    ],\n",
        "    \"Operational drift detection\": [\n",
        "        r\"operational\\s+drift\\s+detection\",\n",
        "        r\"real[- ]time\\s+drift\\s+detection\"\n",
        "    ]\n",
        "}\n",
        "\n",
        "overclaim_results = []\n",
        "\n",
        "for category, patterns in overclaim_patterns.items():\n",
        "    matches = []\n",
        "\n",
        "    for pattern in patterns:\n",
        "        for m in re.finditer(\n",
        "            pattern, manuscript, flags=re.IGNORECASE\n",
        "        ):\n",
        "            matches.append({\n",
        "                \"match\": m.group(0),\n",
        "                \"context\": manuscript[\n",
        "                    max(0, m.start()-100):\n",
        "                    min(len(manuscript), m.end()+150)\n",
        "                ].replace(\"\\n\", \" \")\n",
        "            })\n",
        "\n",
        "    overclaim_results.append({\n",
        "        \"category\": category,\n",
        "        \"matches\": matches,\n",
        "        \"status\": (\n",
        "            \"MANUAL_CONTEXT_REVIEW_REQUIRED\"\n",
        "            if matches else \"NO_CONFIGURED_PATTERN_DETECTED\"\n",
        "        )\n",
        "    })\n",
        "\n",
        "    if matches:\n",
        "        add_issue(\n",
        "            \"MAJOR\",\n",
        "            \"Potential scientific overclaim\",\n",
        "            category,\n",
        "            matches,\n",
        "            \"Read the complete context and qualify or remove unsupported claims.\"\n",
        "        )\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 16. CITATION AND REFERENCE AUDIT\n",
        "# ------------------------------------------------\n",
        "\n",
        "required_citations = [\n",
        "    \"Moses et al. (1994)\",\n",
        "    \"Beveridge et al. (2009)\",\n",
        "    \"Han et al. (2013)\",\n",
        "    \"Ochoa-Villegas et al. (2015)\"\n",
        "]\n",
        "\n",
        "for citation in required_citations:\n",
        "    add_check(\n",
        "        f\"In-text citation: {citation}\",\n",
        "        citation in manuscript,\n",
        "        citation\n",
        "    )\n",
        "\n",
        "required_references = [\n",
        "    \"Beveridge, J. R.\",\n",
        "    \"Han, H.\",\n",
        "    \"Moses, Y.\",\n",
        "    \"Ochoa-Villegas, M. A.\"\n",
        "]\n",
        "\n",
        "for entry in required_references:\n",
        "    add_check(\n",
        "        f\"Reference entry: {entry}\",\n",
        "        entry in references,\n",
        "        entry\n",
        "    )\n",
        "\n",
        "doi_strings = re.findall(\n",
        "    r\"https?://doi\\.org/[^\\s)]+\",\n",
        "    references\n",
        ")\n",
        "\n",
        "add_check(\n",
        "    \"Four DOI strings\",\n",
        "    len(doi_strings) == 4,\n",
        "    doi_strings\n",
        ")\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 17. MANUAL SCIENTIFIC REVIEW REGISTER\n",
        "# ------------------------------------------------\n",
        "\n",
        "manual_review = [\n",
        "    {\n",
        "        \"severity\": \"CRITICAL\",\n",
        "        \"area\": \"Numerical accuracy\",\n",
        "        \"requirement\": \"Check every numerical claim in its paragraph against the correct source CSV and column.\"\n",
        "    },\n",
        "    {\n",
        "        \"severity\": \"CRITICAL\",\n",
        "        \"area\": \"Statistical interpretation\",\n",
        "        \"requirement\": \"Review the Friedman, Wilcoxon, Holm, bootstrap and confidence interval interpretations.\"\n",
        "    },\n",
        "    {\n",
        "        \"severity\": \"MAJOR\",\n",
        "        \"area\": \"Dataset provenance\",\n",
        "        \"requirement\": \"Check the community-hosted source and checksum limitations are accurately described.\"\n",
        "    },\n",
        "    {\n",
        "        \"severity\": \"MAJOR\",\n",
        "        \"area\": \"Capture interpretation\",\n",
        "        \"requirement\": \"Do not describe different captures as transformations of identical source images.\"\n",
        "    },\n",
        "    {\n",
        "        \"severity\": \"MAJOR\",\n",
        "        \"area\": \"Model validation\",\n",
        "        \"requirement\": \"Do not imply independent validation across multiple face recognition architectures.\"\n",
        "    },\n",
        "    {\n",
        "        \"severity\": \"MAJOR\",\n",
        "        \"area\": \"Figures\",\n",
        "        \"requirement\": \"Inspect all four actual figures, captions, numbering and discussion.\"\n",
        "    },\n",
        "    {\n",
        "        \"severity\": \"MAJOR\",\n",
        "        \"area\": \"Research novelty\",\n",
        "        \"requirement\": \"Check that the research gap does not become an unsupported novelty claim.\"\n",
        "    },\n",
        "    {\n",
        "        \"severity\": \"MODERATE\",\n",
        "        \"area\": \"Bibliographic verification\",\n",
        "        \"requirement\": \"Independently verify bibliographic metadata and DOI details.\"\n",
        "    },\n",
        "    {\n",
        "        \"severity\": \"MODERATE\",\n",
        "        \"area\": \"Editorial quality\",\n",
        "        \"requirement\": \"Review grammar, repetition, academic clarity, transitions and consistency.\"\n",
        "    }\n",
        "]\n",
        "\n",
        "for item in manual_review:\n",
        "    add_issue(\n",
        "        item[\"severity\"],\n",
        "        item[\"area\"],\n",
        "        item[\"requirement\"],\n",
        "        \"Direct manual review required.\",\n",
        "        item[\"requirement\"]\n",
        "    )\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 18. REPORTS\n",
        "# ------------------------------------------------\n",
        "\n",
        "passed = sum(x[\"status\"] == \"PASS\" for x in checks)\n",
        "review_required = len(checks) - passed\n",
        "\n",
        "severity_counts = {\n",
        "    s: sum(x[\"severity\"] == s for x in issues)\n",
        "    for s in [\"CRITICAL\", \"MAJOR\", \"MODERATE\", \"MINOR\"]\n",
        "}\n",
        "\n",
        "numerical_audit = {\n",
        "    \"overall_statistics\": overall,\n",
        "    \"group_counts\": group_counts,\n",
        "    \"recomputed_group_statistics\": recomputed_groups.to_dict(\n",
        "        orient=\"records\"\n",
        "    ),\n",
        "    \"identity_group_recalculation_records\": len(merged),\n",
        "    \"holm_adjusted_values\": holm_values.tolist(),\n",
        "    \"expected_six_test_holm_value\": expected_holm,\n",
        "    \"hemisphere_actual_labels\": raw_labels,\n",
        "    \"hemisphere_detected_mapping\": {\n",
        "        \"frontal\": FRONTAL_LABEL,\n",
        "        \"beyond_frontal\": BEYOND_LABEL\n",
        "    },\n",
        "    \"hemisphere_counts\": actual_hemisphere_counts,\n",
        "    \"hemisphere_comparison_results\": hemisphere_results.to_dict(\n",
        "        orient=\"records\"\n",
        "    )\n",
        "}\n",
        "\n",
        "statistical_audit = {\n",
        "    \"repeated_measures\": repeated.to_dict(orient=\"records\"),\n",
        "    \"paired_comparisons\": paired.to_dict(orient=\"records\"),\n",
        "    \"six_test_holm\": holm.to_dict(orient=\"records\"),\n",
        "    \"hemisphere_comparisons\": hemisphere_results.to_dict(\n",
        "        orient=\"records\"\n",
        "    ),\n",
        "    \"bootstrap\": {\n",
        "        \"pairwise_iterations\": 20000,\n",
        "        \"pairwise_seed\": 2026274,\n",
        "        \"hemisphere_iterations\": 20000,\n",
        "        \"hemisphere_seed\": 2026275,\n",
        "        \"resampling_unit\": \"Identity\"\n",
        "    }\n",
        "}\n",
        "\n",
        "figure_table_audit = {\n",
        "    \"figures\": figure_records,\n",
        "    \"markdown_image_embeds\": markdown_images,\n",
        "    \"figure_mentions\": figure_mentions,\n",
        "    \"markdown_table_lines\": len(table_lines),\n",
        "    \"table_separator_rows\": len(table_separators)\n",
        "}\n",
        "\n",
        "report = [\n",
        "    \"# Experiment 20 — Step 3.3.13 Full Manuscript Audit\",\n",
        "    \"\",\n",
        "    f\"Date: {datetime.now(timezone.utc).isoformat()}\",\n",
        "    f\"Manuscript word count: {word_count}\",\n",
        "    f\"Manuscript SHA256: `{manuscript_hash}`\",\n",
        "    \"\",\n",
        "    \"## Automated audit summary\",\n",
        "    f\"- Passed: {passed}\",\n",
        "    f\"- Requiring review: {review_required}\",\n",
        "    \"\",\n",
        "    \"## Direct numerical verification\",\n",
        "    \"```json\",\n",
        "    json.dumps(numerical_audit, indent=2, default=str),\n",
        "    \"```\",\n",
        "    \"\",\n",
        "    \"## Figures and tables\",\n",
        "    f\"- Frozen figures: {len(figure_records)}\",\n",
        "    f\"- Markdown image embeds: {len(markdown_images)}\",\n",
        "    f\"- Figure references: {len(figure_mentions)}\",\n",
        "    f\"- Table lines: {len(table_lines)}\",\n",
        "    f\"- Table separator rows: {len(table_separators)}\",\n",
        "    \"\",\n",
        "    \"## Prioritised issues\"\n",
        "]\n",
        "\n",
        "for issue in issues:\n",
        "    report.extend([\n",
        "        \"\",\n",
        "        f\"### {issue['issue_id']} — {issue['severity']}\",\n",
        "        f\"- Area: {issue['area']}\",\n",
        "        f\"- Issue: {issue['issue']}\",\n",
        "        f\"- Recommendation: {issue['recommended_action']}\"\n",
        "    ])\n",
        "\n",
        "report.extend([\n",
        "    \"\",\n",
        "    \"## Conclusion\",\n",
        "    \"\",\n",
        "    \"Automated checks do not replace direct scientific and editorial review.\",\n",
        "    \"\",\n",
        "    \"**AUTOMATED_AUDIT_COMPLETED_MANUAL_SCIENTIFIC_REVIEW_REQUIRED**\"\n",
        "])\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 19. SAVE OUTPUTS\n",
        "# ------------------------------------------------\n",
        "\n",
        "outputs = {\n",
        "    \"report\": OUT / \"experiment20_step3313_full_manuscript_review_report.md\",\n",
        "    \"scientific\": OUT / \"experiment20_step3313_scientific_editorial_audit.json\",\n",
        "    \"numerical\": OUT / \"experiment20_step3313_numerical_verification_audit.json\",\n",
        "    \"statistical\": OUT / \"experiment20_step3313_statistical_interpretation_audit.json\",\n",
        "    \"limitations\": OUT / \"experiment20_step3313_methodological_limitations_audit.json\",\n",
        "    \"citations\": OUT / \"experiment20_step3313_citation_reference_audit.json\",\n",
        "    \"figures\": OUT / \"experiment20_step3313_figure_table_integration_audit.json\",\n",
        "    \"corrections\": OUT / \"experiment20_step3313_prioritised_correction_register.json\",\n",
        "    \"manuscript_copy\": OUT / \"experiment20_step3313_manuscript_review_copy.md\"\n",
        "}\n",
        "\n",
        "outputs[\"report\"].write_text(\n",
        "    \"\\n\".join(report),\n",
        "    encoding=\"utf-8\"\n",
        ")\n",
        "\n",
        "outputs[\"manuscript_copy\"].write_bytes(original_bytes)\n",
        "\n",
        "save_json(outputs[\"scientific\"], {\n",
        "    \"step\": \"3.3.13\",\n",
        "    \"manuscript_sha256\": manuscript_hash,\n",
        "    \"word_count\": word_count,\n",
        "    \"checks\": checks,\n",
        "    \"checks_passed\": passed,\n",
        "    \"checks_requiring_review\": review_required,\n",
        "    \"evidence_inventory\": evidence,\n",
        "    \"issues\": issues,\n",
        "    \"severity_counts\": severity_counts,\n",
        "    \"status\": \"AUTOMATED_AUDIT_COMPLETED_MANUAL_SCIENTIFIC_REVIEW_REQUIRED\"\n",
        "})\n",
        "\n",
        "save_json(outputs[\"numerical\"], numerical_audit)\n",
        "save_json(outputs[\"statistical\"], statistical_audit)\n",
        "\n",
        "save_json(outputs[\"limitations\"], {\n",
        "    \"limitations\": limitation_results,\n",
        "    \"status\": \"AUTOMATED_TERM_CHECK_ONLY\"\n",
        "})\n",
        "\n",
        "save_json(outputs[\"citations\"], {\n",
        "    \"required_citations\": required_citations,\n",
        "    \"required_references\": required_references,\n",
        "    \"doi_strings\": doi_strings,\n",
        "    \"bibliographic_authentication\": \"NOT_INDEPENDENTLY_PERFORMED\"\n",
        "})\n",
        "\n",
        "save_json(outputs[\"figures\"], figure_table_audit)\n",
        "save_json(outputs[\"corrections\"], issues)\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 20. FINAL INTEGRITY CHECK\n",
        "# ------------------------------------------------\n",
        "\n",
        "if MANUSCRIPT.read_bytes() != original_bytes:\n",
        "    raise RuntimeError(\"Original manuscript was modified.\")\n",
        "\n",
        "if sha256_file(MANUSCRIPT) != manuscript_hash:\n",
        "    raise RuntimeError(\"Original manuscript hash changed.\")\n",
        "\n",
        "if outputs[\"manuscript_copy\"].read_bytes() != original_bytes:\n",
        "    raise RuntimeError(\"Manuscript review copy does not match source.\")\n",
        "\n",
        "for name, path in outputs.items():\n",
        "    if not path.is_file() or path.stat().st_size == 0:\n",
        "        raise RuntimeError(f\"Output missing or empty: {name}\")\n",
        "\n",
        "    if path.suffix == \".json\":\n",
        "        load_json(path)\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 21. FINAL DISPLAY\n",
        "# ------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 90)\n",
        "print(\"STEP 3.3.13 — FINAL AUDIT SUMMARY\")\n",
        "print(\"=\" * 90)\n",
        "\n",
        "print(\"\\nMANUSCRIPT\")\n",
        "print(\"Word count:\", word_count)\n",
        "print(\"SHA256:\", manuscript_hash)\n",
        "\n",
        "print(\"\\nDIRECT NUMERICAL VERIFICATION\")\n",
        "print(\"Observations:\", overall[\"observations\"])\n",
        "print(\"Identities:\", overall[\"identities\"])\n",
        "print(\"Evaluation conditions:\", overall[\"evaluation_conditions\"])\n",
        "print(\"Euclidean mean:\", overall[\"euclidean_mean\"])\n",
        "print(\"Cosine mean:\", overall[\"cosine_mean\"])\n",
        "\n",
        "print(\"\\nHEMISPHERE LABELS\")\n",
        "print(\"Actual source labels:\", raw_labels)\n",
        "print(\"Frontal mapping:\", FRONTAL_LABEL)\n",
        "print(\"Beyond-frontal mapping:\", BEYOND_LABEL)\n",
        "print(\"Recalculated counts:\", actual_hemisphere_counts)\n",
        "\n",
        "print(\"\\nAUTOMATED CHECKS\")\n",
        "print(\"Passed:\", passed)\n",
        "print(\"Requiring review:\", review_required)\n",
        "\n",
        "print(\"\\nFIGURES\")\n",
        "print(\"Frozen figures:\", len(figure_records))\n",
        "print(\"Markdown embeds:\", len(markdown_images))\n",
        "print(\"Figure references:\", len(figure_mentions))\n",
        "\n",
        "print(\"\\nCORRECTION REGISTER\")\n",
        "for severity, count in severity_counts.items():\n",
        "    print(f\"{severity}: {count}\")\n",
        "\n",
        "print(\"\\nOUTPUT FILES\")\n",
        "for name, path in outputs.items():\n",
        "    print(f\"{name}: {path}\")\n",
        "\n",
        "print(\"\\nINTEGRITY\")\n",
        "print(\"Original manuscript modified: NO\")\n",
        "print(\"Review copy verified: YES\")\n",
        "print(\"JSON reload verified: YES\")\n",
        "print(\"Frozen CSV files modified: NO\")\n",
        "\n",
        "print(\"\\nFINAL STATUS:\")\n",
        "print(\n",
        "    \"AUTOMATED_AUDIT_COMPLETED_MANUAL_SCIENTIFIC_REVIEW_REQUIRED\"\n",
        ")\n",
        "\n",
        "print(\"=\" * 90)\n"
