        "# Experiment 20 — Step 3.3.29: Results Section and Figure Content Review\n",
        "\n",
        "## Objective\n",
        "Inspect the exact Results section and visually review all four frozen figures before manuscript integration.\n",
        "\n",
        "## Procedure\n",
        "1. Extract manuscript lines 233–292, covering the complete Results section.\n",
        "2. Display all four frozen figures in their original form.\n",
        "3. Verify that the chart content supports the intended captions and placement.\n",
        "4. Identify the exact paragraphs where each figure should be referenced.\n",
        "\n",
        "## Integrity restrictions\n",
        "- Read-only inspection.\n",
        "- Do not modify manuscript text.\n",
        "- Do not resize, annotate, or regenerate figures.\n",
        "- Do not create replacement figures.\n",
        "\n",
        "## Expected outcome\n",
        "The exact Results paragraphs and visual content needed to prepare accurate captions and in-text references."
      ],
      "metadata": {
        "id": "E3PcLsFHGpcj"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# EXPERIMENT 20 — STEP 3.3.29\n",
        "# RESULTS SECTION AND FIGURE CONTENT REVIEW\n",
        "# READ-ONLY\n",
        "# ============================================================\n",
        "\n",
        "import os\n",
        "import json\n",
        "import hashlib\n",
        "from PIL import Image\n",
        "from IPython.display import display\n",
        "\n",
        "BASE = \"/content/drive/MyDrive/Experiment_20_Results\"\n",
        "\n",
        "MANUSCRIPT = os.path.join(\n",
        "    BASE,\n",
        "    \"step_3_3\",\n",
        "    \"step_3312\",\n",
        "    \"experiment20_integrated_manuscript_v1.md\"\n",
        ")\n",
        "\n",
        "FIGURE_DIR = os.path.join(\n",
        "    BASE, \"step_2_7\", \"final_freeze\"\n",
        ")\n",
        "\n",
        "FIGURES = [\n",
        "    (\n",
        "        \"Figure 1 — Euclidean displacement across illumination groups\",\n",
        "        \"experiment20_figure1_euclidean_illumination_groups.png\"\n",
        "    ),\n",
        "    (\n",
        "        \"Figure 2 — Cosine distance across illumination groups\",\n",
        "        \"experiment20_figure2_cosine_illumination_groups.png\"\n",
        "    ),\n",
        "    (\n",
        "        \"Figure 3 — Euclidean hemisphere comparison\",\n",
        "        \"experiment20_figure3_euclidean_hemisphere_comparison.png\"\n",
        "    ),\n",
        "    (\n",
        "        \"Figure 4 — Cosine hemisphere comparison\",\n",
        "        \"experiment20_figure4_cosine_hemisphere_comparison.png\"\n",
        "    )\n",
        "]\n",
        "\n",
        "OUTPUT_DIR = os.path.join(\n",
        "    BASE, \"step_3_3\", \"step_3329\"\n",
        ")\n",
        "os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
        "\n",
        "REPORT_PATH = os.path.join(\n",
        "    OUTPUT_DIR,\n",
        "    \"experiment20_step3329_results_figure_review.json\"\n",
        ")\n",
        "\n",
        "\n",
        "def sha256_file(path):\n",
        "    h = hashlib.sha256()\n",
        "\n",
        "    with open(path, \"rb\") as f:\n",
        "        for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n",
        "            h.update(chunk)\n",
        "\n",
        "    return h.hexdigest()\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. EXTRACT EXACT RESULTS SECTION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "with open(MANUSCRIPT, \"r\", encoding=\"utf-8\") as f:\n",
        "    manuscript_lines = f.readlines()\n",
        "\n",
        "results_start = None\n",
        "discussion_start = None\n",
        "\n",
        "for i, line in enumerate(manuscript_lines):\n",
        "\n",
        "    stripped = line.strip()\n",
        "\n",
        "    if stripped.startswith(\"# 3. Results\"):\n",
        "        results_start = i\n",
        "\n",
        "    elif stripped.startswith(\"# 4. Discussion\"):\n",
        "        discussion_start = i\n",
        "        break\n",
        "\n",
        "if results_start is None:\n",
        "    raise ValueError(\"Could not locate '# 3. Results'.\")\n",
        "\n",
        "if discussion_start is None:\n",
        "    raise ValueError(\"Could not locate '# 4. Discussion'.\")\n",
        "\n",
        "results_excerpt = manuscript_lines[\n",
        "    results_start:discussion_start\n",
        "]\n",
        "\n",
        "print(\"=\" * 100)\n",
        "print(\"1. COMPLETE RESULTS SECTION\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "for index, line in enumerate(\n",
        "    results_excerpt,\n",
        "    start=results_start + 1\n",
        "):\n",
        "    print(f\"{index}: {line.rstrip()}\")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. DISPLAY ORIGINAL FROZEN FIGURES\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "figure_results = {}\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"2. ORIGINAL FROZEN FIGURES\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "for title, filename in FIGURES:\n",
        "\n",
        "    path = os.path.join(FIGURE_DIR, filename)\n",
        "\n",
        "    if not os.path.isfile(path):\n",
        "        raise FileNotFoundError(path)\n",
        "\n",
        "    image_hash = sha256_file(path)\n",
        "\n",
        "    with Image.open(path) as img:\n",
        "        dimensions = img.size\n",
        "        image_format = img.format\n",
        "\n",
        "    figure_results[filename] = {\n",
        "        \"path\": path,\n",
        "        \"sha256\": image_hash,\n",
        "        \"dimensions\": dimensions,\n",
        "        \"format\": image_format\n",
        "    }\n",
        "\n",
        "    print(\"\\n\" + \"-\" * 100)\n",
        "    print(title)\n",
        "    print(\"File:\", filename)\n",
        "    print(\"SHA256:\", image_hash)\n",
        "    print(\"Dimensions:\", dimensions)\n",
        "    print(\"Format:\", image_format)\n",
        "\n",
        "    display(Image.open(path))\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. RECORD RESULTS SECTION AND FIGURE INVENTORY\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "report = {\n",
        "    \"step\": \"3.3.29\",\n",
        "    \"title\": \"Results Section and Figure Content Review\",\n",
        "    \"manuscript\": {\n",
        "        \"path\": MANUSCRIPT,\n",
        "        \"sha256\": sha256_file(MANUSCRIPT),\n",
        "        \"results_start_line\": results_start + 1,\n",
        "        \"discussion_start_line\": discussion_start + 1,\n",
        "        \"results_excerpt\": [\n",
        "            line.rstrip(\"\\n\")\n",
        "            for line in results_excerpt\n",
        "        ]\n",
        "    },\n",
        "    \"figures\": figure_results,\n",
        "    \"integrity\": {\n",
        "        \"manuscript_modified\": False,\n",
        "        \"figures_modified\": False,\n",
        "        \"frozen_evidence_modified\": False\n",
        "    },\n",
        "    \"status\": \"READ_ONLY_RESULTS_AND_FIGURE_REVIEW_COMPLETED\"\n",
        "}\n",
        "\n",
        "with open(REPORT_PATH, \"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(report, f, indent=2)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"3. REVIEW REPORT\")\n",
        "print(\"=\" * 100)\n",
        "print(\"Report saved:\", REPORT_PATH)\n",
        "print(\"Report SHA256:\", sha256_file(REPORT_PATH))\n",
        "print(\"No existing files were modified.\")\n",
        "print(\"STEP 3.3.29 COMPLETED\")"
      ],
      "metadata": {
