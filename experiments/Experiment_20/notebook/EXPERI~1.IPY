s: 1 | illumination combinations: 63\\n\",\"yaleB18 | images: 63 | poses: 1 | illumination combinations: 63\\n\",\"yaleB19 | images: 64 | poses: 1 | illumination combinations: 64\\n\",\"yaleB20 | images: 64 | poses: 1 | illumination combinations: 64\\n\",\"yaleB21 | images: 64 | poses: 1 | illumination combinations: 64\\n\",\"yaleB22 | images: 64 | poses: 1 | illumination combinations: 64\\n\",\"yaleB23 | images: 64 | poses: 1 | illumination combinations: 64\\n\",\"yaleB24 | images: 64 | poses: 1 | illumination combinations: 64\\n\",\"yaleB25 | images: 64 | poses: 1 | illumination combinations: 64\\n\",\"yaleB26 | images: 64 | poses: 1 | illumination combinations: 64\\n\",\"yaleB27 | images: 64 | poses: 1 | illumination combinations: 64\\n\",\"yaleB28 | images: 64 | poses: 1 | illumination combinations: 64\\n\",\"yaleB29 | images: 64 | poses: 1 | illumination combinations: 64\\n\",\"yaleB30 | images: 64 | poses: 1 | illumination combinations: 64\\n\",\"yaleB31 | images: 64 | poses: 1 | illumination combinations: 64\\n\",\"yaleB32 | images: 64 | poses: 1 | illumination combinations: 64\\n\",\"yaleB33 | images: 64 | poses: 1 | illumination combinations: 64\\n\",\"yaleB34 | images: 64 | poses: 1 | illumination combinations: 64\\n\",\"yaleB35 | images: 64 | poses: 1 | illumination combinations: 64\\n\",\"yaleB36 | images: 64 | poses: 1 | illumination combinations: 64\\n\",\"yaleB37 | images: 64 | poses: 1 | illumination combinations: 64\\n\",\"yaleB38 | images: 64 | poses: 1 | illumination combinations: 64\\n\",\"yaleB39 | images: 64 | poses: 1 | illumination combinations: 64\\n\",\"\\n\",\"[4] GLOBAL POSE AND ILLUMINATION COVERAGE\\n\",\"Unique pose codes: ['00']\\n\",\"Unique illumination combinations: 64\\n\",\"Illumination combinations: [('+000', '+00'), ('+000', '+20'), ('+000', '+45'), ('+000', '+90'), ('+000', '-20'), ('+000', '-35'), ('+005', '+10'), ('+005', '-10'), ('+010', '+00'), ('+010', '-20'), ('+015', '+20'), ('+020', '+10'), ('+020', '-10'), ('+020', '-40'), ('+025', '+00'), ('+035', '+15'), ('+035', '+40'), ('+035', '+65'), ('+035', '-20'), ('+050', '+00'), ('+050', '-40'), ('+060', '+20'), ('+060', '-20'), ('+070', '+00'), ('+070', '+45'), ('+070', '-35'), ('+085', '+20'), ('+085', '-20'), ('+095', '+00'), ('+110', '+15'), ('+110', '+40'), ('+110', '+65'), ('+110', '-20'), ('+120', '+00'), ('+130', '+20'), ('-005', '+10'), ('-005', '-10'), ('-010', '+00'), ('-010', '-20'), ('-015', '+20'), ('-020', '+10'), ('-020', '-10'), ('-020', '-40'), ('-025', '+00'), ('-035', '+15'), ('-035', '+40'), ('-035', '+65'), ('-035', '-20'), ('-050', '+00'), ('-050', '-40'), ('-060', '+20'), ('-060', '-20'), ('-070', '+00'), ('-070', '+45'), ('-070', '-35'), ('-085', '+20'), ('-085', '-20'), ('-095', '+00'), ('-110', '+15'), ('-110', '+40'), ('-110', '+65'), ('-110', '-20'), ('-120', '+00'), ('-130', '+20')]\\n\",\"\\n\",\"[5] OTHER FILE TYPES\\n\",\"'' 1\\n\",\"'.bad' 18\\n\",\"'.info' 38\\n\",\"'.log' 38\\n\",\"'.pgm' 2452\\n\",\"\\n\",\"[6] AUDIT RECORD SAVED\\n\",\"/content/drive/MyDrive/Experiment_20_Results/dataset_audit/experiment20_croppedyale_content_audit.json\\n\",\"\\n\",\"CONTENT AUDIT COMPLETE\\n\",\"No extraction or source-file modification performed.\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"## EXPERIMENT 20 — STEP 2.6.8: IMAGE NAMING AND CONDITION COMPLETENESS AUDIT\\n\",\"\\n\",\"Inspect all PGM filenames in the Cropped Extended Yale B archive.\\n\",\"\\n\",\"Objectives:\\n\",\"1. List all 38 unmatched PGM filenames.\\n\",\"2. Determine whether they represent ambient images or another image category.\\n\",\"3. Identify duplicate image-condition filenames.\\n\",\"4. Identify missing illumination combinations for each subject.\\n\",\"5. Inspect subject metadata files where available.\\n\",\"6. Save the results without extracting or modifying the archive.\\n\",\"\\n\",\"No images will be excluded or accepted based on assumptions.\"],\"metadata\":{\"id\":\"SBMp06GMqdjr\"}},{\"cell_type\":\"code\",\"source\":[\"import os\\n\",\"import re\\n\",\"import json\\n\",\"import zipfile\\n\",\"from collections import defaultdict, Counter\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"ARCHIVE_PATH = \\\"/content/Experiment20_Downloads/CroppedYale.zip\\\"\\n\",\"\\n\",\"AUDIT_DIR = (\\n\",\"    \\\"/content/drive/MyDrive/Experiment_20_Results/dataset_audit\\\"\\n\",\")\\n\",\"\\n\",\"OUTPUT_PATH = os.path.join(\\n\",\"    AUDIT_DIR,\\n\",\"    \\\"experiment20_croppedyale_filename_completeness_audit.json\\\"\\n\",\")\\n\",\"\\n\",\"os.makedirs(AUDIT_DIR, exist_ok=True)\\n\",\"\\n\",\"pattern = re.compile(\\n\",\"    r\\\"^(yaleB\\\\d+)_P(\\\\d{2})A([+-]\\\\d{3})E([+-]\\\\d{2})\\\\.pgm$\\\",\\n\",\"    re.IGNORECASE\\n\",\")\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 2.6.8: FILENAME AND CONDITION AUDIT\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"with zipfile.ZipFile(ARCHIVE_PATH, \\\"r\\\") as archive:\\n\",\"\\n\",\"    names = archive.namelist()\\n\",\"\\n\",\"    pgm_paths = [\\n\",\"        name for name in names\\n\",\"        if name.lower().endswith(\\\".pgm\\\")\\n\",\"    ]\\n\",\"\\n\",\"    parsed_records = []\\n\",\"    unmatched_records = []\\n\",\"    subject_metadata = {}\\n\",\"\\n\",\"    for path in pgm_paths:\\n\",\"        filename = os.path.basename(path)\\n\",\"        match = pattern.match(filename)\\n\",\"\\n\",\"        if match:\\n\",\"            subject, pose, azimuth, elevation = match.groups()\\n\",\"\\n\",\"            parsed_records.append({\\n\",\"                \\\"path\\\": path,\\n\",\"                \\\"subject\\\": subject,\\n\",\"                \\\"pose\\\": pose,\\n\",\"                \\\"azimuth\\\": azimuth,\\n\",\"                \\\"elevation\\\": elevation\\n\",\"            })\\n\",\"        else:\\n\",\"            unmatched_records.append({\\n\",\"                \\\"path\\\": path,\\n\",\"                \\\"filename\\\": filename,\\n\",\"                \\\"directory\\\": os.path.dirname(path)\\n\",\"            })\\n\",\"\\n\",\"    # -----------------------------------------------------\\n\",\"    # 1. UNMATCHED FILENAMES\\n\",\"    # -----------------------------------------------------\\n\",\"\\n\",\"    print(\\\"\\\\n[1] UNMATCHED PGM FILES\\\")\\n\",\"    print(\\\"Count:\\\", len(unmatched_records))\\n\",\"\\n\",\"    for item in unmatched_records:\\n\",\"        print(item[\\\"path\\\"])\\n\",\"\\n\",\"    # -----------------------------------------------------\\n\",\"    # 2. DUPLICATE CONDITION CHECK\\n\",\"    # -----------------------------------------------------\\n\",\"\\n\",\"    print(\\\"\\\\n[2] DUPLICATE CONDITION CHECK\\\")\\n\",\"\\n\",\"    condition_counts = Counter(\\n\",\"        (\\n\",\"            r[\\\"subject\\\"],\\n\",\"            r[\\\"pose\\\"],\\n\",\"            r[\\\"azimuth\\\"],\\n\",\"            r[\\\"elevation\\\"]\\n\",\"        )\\n\",\"        for r in parsed_records\\n\",\"    )\\n\",\"\\n\",\"    duplicates = [\\n\",\"        {\\n\",\"            \\\"subject\\\": key[0],\\n\",\"            \\\"pose\\\": key[1],\\n\",\"            \\\"azimuth\\\": key[2],\\n\",\"            \\\"elevation\\\": key[3],\\n\",\"            \\\"count\\\": count\\n\",\"        }\\n\",\"        for key, count in condition_counts.items()\\n\",\"        if count > 1\\n\",\"    ]\\n\",\"\\n\",\"    print(\\\"Duplicate condition keys:\\\", len(duplicates))\\n\",\"\\n\",\"    for item in duplicates:\\n\",\"        print(item)\\n\",\"\\n\",\"    # -----------------------------------------------------\\n\",\"    # 3. MISSING ILLUMINATION CONDITIONS\\n\",\"    # -----------------------------------------------------\\n\",\"\\n\",\"    print(\\\"\\\\n[3] PER-SUBJECT CONDITION COMPLETENESS\\\")\\n\",\"\\n\",\"    global_conditions = sorted({\\n\",\"        (r[\\\"azimuth\\\"], r[\\\"elevation\\\"])\\n\",\"        for r in parsed_records\\n\",\"    })\\n\",\"\\n\",\"    subject_conditions = defaultdict(set)\\n\",\"    subject_poses = defaultdict(set)\\n\",\"\\n\",\"    for r in parsed_records:\\n\",\"        subject_conditions[r[\\\"subject\\\"]].add(\\n\",\"            (r[\\\"azimuth\\\"], r[\\\"elevation\\\"])\\n\",\"        )\\n\",\"        subject_poses[r[\\\"subject\\\"]].add(r[\\\"pose\\\"])\\n\",\"\\n\",\"    subjects = sorted(subject_conditions)\\n\",\"\\n\",\"    missing_conditions = {}\\n\",\"\\n\",\"    for subject in subjects:\\n\",\"        missing = sorted(\\n\",\"            set(global_conditions) - subject_conditions[subject]\\n\",\"        )\\n\",\"\\n\",\"        missing_conditions[subject] = [\\n\",\"            list(condition) for condition in missing\\n\",\"        ]\\n\",\"\\n\",\"        print(\\n\",\"            subject,\\n\",\"            \\\"| images:\\\", len(subject_conditions[subject]),\\n\",\"            \\\"| poses:\\\", sorted(subject_poses[subject]),\\n\",\"            \\\"| missing conditions:\\\", len(missing)\\n\",\"        )\\n\",\"\\n\",\"    # -----------------------------------------------------\\n\",\"    # 4. SUBJECT INFO FILES\\n\",\"    # -----------------------------------------------------\\n\",\"\\n\",\"    print(\\\"\\\\n[4] SUBJECT INFO FILES\\\")\\n\",\"\\n\",\"    info_paths = [\\n\",\"        name for name in names\\n\",\"        if name.lower().endswith(\\\".info\\\")\\n\",\"    ]\\n\",\"\\n\",\"    info_samples = {}\\n\",\"\\n\",\"    for path in info_paths:\\n\",\"        with archive.open(path) as f:\\n\",\"            content = f.read().decode(\\n\",\"                \\\"utf-8\\\", errors=\\\"replace\\\"\\n\",\"            )\\n\",\"\\n\",\"        info_samples[os.path.basename(path)] = content[:3000]\\n\",\"\\n\",\"    print(\\\"Info files:\\\", len(info_paths))\\n\",\"\\n\",\"    for filename, content in list(info_samples.items())[:3]:\\n\",\"        print(\\\"\\\\n---\\\", filename, \\\"---\\\")\\n\",\"        print(content[:1500])\\n\",\"\\n\",\"    # -----------------------------------------------------\\n\",\"    # 5. NON-IMAGE FILES ASSOCIATED WITH SUBJECTS\\n\",\"    # -----------------------------------------------------\\n\",\"\\n\",\"    print(\\\"\\\\n[5] BAD AND LOG FILE COUNTS\\\")\\n\",\"\\n\",\"    bad_files = [\\n\",\"        name for name in names\\n\",\"        if name.lower().endswith(\\\".bad\\\")\\n\",\"    ]\\n\",\"\\n\",\"    log_files = [\\n\",\"        name for name in names\\n\",\"        if name.lower().endswith(\\\".log\\\")\\n\",\"    ]\\n\",\"\\n\",\"    print(\\\".bad files:\\\", len(bad_files))\\n\",\"    print(\\\".log files:\\\", len(log_files))\\n\",\"\\n\",\"    # -----------------------------------------------------\\n\",\"    # 6. SAVE AUDIT\\n\",\"    # -----------------------------------------------------\\n\",\"\\n\",\"    result = {\\n\",\"        \\\"step\\\": \\\"2.6.8\\\",\\n\",\"        \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"        \\\"archive_path\\\": ARCHIVE_PATH,\\n\",\"        \\\"pgm_count\\\": len(pgm_paths),\\n\",\"        \\\"filename_valid_count\\\": len(parsed_records),\\n\",\"        \\\"unmatched_pgm_count\\\": len(unmatched_records),\\n\",\"        \\\"unmatched_pgm_files\\\": unmatched_records,\\n\",\"        \\\"duplicate_condition_count\\\": len(duplicates),\\n\",\"        \\\"duplicate_conditions\\\": duplicates,\\n\",\"        \\\"global_illumination_condition_count\\\": len(global_conditions),\\n\",\"        \\\"global_illumination_conditions\\\": [\\n\",\"            list(condition) for condition in global_conditions\\n\",\"        ],\\n\",\"        \\\"subject_count\\\": len(subjects),\\n\",\"        \\\"subject_pose_coverage\\\": {\\n\",\"            subject: sorted(subject_poses[subject])\\n\",\"            for subject in subjects\\n\",\"        },\\n\",\"        \\\"missing_conditions_by_subject\\\": missing_conditions,\\n\",\"        \\\"info_file_count\\\": len(info_paths),\\n\",\"        \\\"info_file_samples\\\": info_samples,\\n\",\"        \\\"bad_file_count\\\": len(bad_files),\\n\",\"        \\\"log_file_count\\\": len(log_files),\\n\",\"        \\\"acceptance_status\\\": \\\"PENDING_IMAGE_CONTENT_VALIDATION\\\"\\n\",\"    }\\n\",\"\\n\",\"with open(OUTPUT_PATH, \\\"w\\\") as f:\\n\",\"    json.dump(result, f, indent=2)\\n\",\"\\n\",\"print(\\\"\\\\n[6] AUDIT SAVED\\\")\\n\",\"print(OUTPUT_PATH)\\n\",\"print(\\\"\\\\nNo extraction or archive modification performed.\\\")\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"4HT58Mitqf2s\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794351171204,\"user_tz\":360,\"elapsed\":135,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"12a7b685-452f-4b49-d242-220b8652cdc8\"},\"execution_count\":null,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"===========================================================================\\n\",\"EXPERIMENT 20 — STEP 2.6.8: FILENAME AND CONDITION AUDIT\\n\",\"===========================================================================\\n\",\"\\n\",\"[1] UNMATCHED PGM FILES\\n\",\"Count: 38\\n\",\"CroppedYale/yaleB39/yaleB39_P00_Ambient.pgm\\n\",\"CroppedYale/yaleB02/yaleB02_P00_Ambient.pgm\\n\",\"CroppedYale/yaleB03/yaleB03_P00_Ambient.pgm\\n\",\"CroppedYale/yaleB04/yaleB04_P00_Ambient.pgm\\n\",\"CroppedYale/yaleB05/yaleB05_P00_Ambient.pgm\\n\",\"CroppedYale/yaleB06/yaleB06_P00_Ambient.pgm\\n\",\"CroppedYale/yaleB07/yaleB07_P00_Ambient.pgm\\n\",\"CroppedYale/yaleB08/yaleB08_P00_Ambient.pgm\\n\",\"CroppedYale/yaleB09/yaleB09_P00_Ambient.pgm\\n\",\"CroppedYale/yaleB10/yaleB10_P00_Ambient.pgm\\n\",\"CroppedYale/yaleB11/yaleB11_P00_Ambient.pgm\\n\",\"CroppedYale/yaleB12/yaleB12_P00_Ambient.pgm\\n\",\"CroppedYale/yaleB13/yaleB13_P00_Ambient.pgm\\n\",\"CroppedYale/yaleB15/yaleB15_P00_Ambient.pgm\\n\",\"CroppedYale/yaleB16/yaleB16_P00_Ambient.pgm\\n\",\"CroppedYale/yaleB17/yaleB17_P00_Ambient.pgm\\n\",\"CroppedYale/yaleB18/yaleB18_P00_Ambient.pgm\\n\",\"CroppedYale/yaleB19/yaleB19_