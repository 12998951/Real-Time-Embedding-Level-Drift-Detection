      "cell_type": "markdown",
      "source": [
        "# Experiment 20 — Step 3.3.21: Independent Recalculation of Paired Comparisons\n",
        "\n",
        "## Objective\n",
        "Independently reproduce the six paired Wilcoxon signed-rank tests using the frozen identity-level group-means CSV.\n",
        "\n",
        "## Procedure\n",
        "1. Load the frozen identity-level group means.\n",
        "2. Load the frozen paired-comparison results.\n",
        "3. Validate the identity and group structure.\n",
        "4. Recalculate all six paired Wilcoxon tests using the identity-level means.\n",
        "5. Apply Holm correction once across the combined family of six tests.\n",
        "6. Compare recalculated raw and adjusted p-values against the frozen results.\n",
        "\n",
        "## Integrity restrictions\n",
        "- Read-only inspection of frozen source files.\n",
        "- Do not overwrite or modify frozen CSV files.\n",
        "- Do not modify the manuscript.\n",
        "- Save the verification report in a new Step 3.3.21 directory.\n",
        "\n",
        "## Interpretation\n",
        "This step verifies whether the frozen raw p-values can be reproduced and whether the frozen adjusted p-values match the documented six-test Holm procedure. It does not establish which implementation originally generated the frozen results."
      ],
      "metadata": {
        "id": "M5PPs0cWC3hU"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# EXPERIMENT 20 — STEP 3.3.21\n",
        "# INDEPENDENT RECOMPUTATION OF SIX PAIRED COMPARISONS\n",
        "# READ-ONLY SOURCE FILES; NEW REPORT ONLY\n",
        "# ============================================================\n",
        "\n",
        "import os\n",
        "import json\n",
        "import hashlib\n",
        "import itertools\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "from scipy.stats import wilcoxon\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. PATHS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "ROOT = \"/content/drive/MyDrive/Experiment_20_Results/step_2_7/final_freeze\"\n",
        "\n",
        "IDENTITY_FILE = os.path.join(\n",
        "    ROOT,\n",
        "    \"experiment20_identity_level_group_means.csv\"\n",
        ")\n",
        "\n",
        "FROZEN_RESULTS_FILE = os.path.join(\n",
        "    ROOT,\n",
        "    \"experiment20_paired_comparison_results.csv\"\n",
        ")\n",
        "\n",
        "OUTPUT_DIR = (\n",
        "    \"/content/drive/MyDrive/Experiment_20_Results/\"\n",
        "    \"step_3_3/step_3321\"\n",
        ")\n",
        "\n",
        "os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
        "\n",
        "REPORT_FILE = os.path.join(\n",
        "    OUTPUT_DIR,\n",
        "    \"experiment20_step3321_paired_comparison_verification.json\"\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. FILE HASH FUNCTION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def sha256_file(path):\n",
        "    digest = hashlib.sha256()\n",
        "\n",
        "    with open(path, \"rb\") as f:\n",
        "        for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n",
        "            digest.update(chunk)\n",
        "\n",
        "    return digest.hexdigest()\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. LOAD FROZEN INPUTS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "identity = pd.read_csv(IDENTITY_FILE)\n",
        "frozen = pd.read_csv(FROZEN_RESULTS_FILE)\n",
        "\n",
        "print(\"=\" * 90)\n",
        "print(\"STEP 3.3.21 — SOURCE VALIDATION\")\n",
        "print(\"=\" * 90)\n",
        "\n",
        "print(\"Identity-level source:\", IDENTITY_FILE)\n",
        "print(\"Identity-level SHA256:\", sha256_file(IDENTITY_FILE))\n",
        "print(\"Identity-level shape:\", identity.shape)\n",
        "\n",
        "print(\"\\nFrozen comparison source:\", FROZEN_RESULTS_FILE)\n",
        "print(\"Frozen comparison SHA256:\", sha256_file(FROZEN_RESULTS_FILE))\n",
        "print(\"Frozen comparison shape:\", frozen.shape)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. STRUCTURAL VALIDATION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "required_identity_columns = {\n",
        "    \"subject\",\n",
        "    \"illumination_group\",\n",
        "    \"euclidean_mean\",\n",
        "    \"cosine_mean\"\n",
        "}\n",
        "\n",
        "required_frozen_columns = {\n",
        "    \"metric\",\n",
        "    \"group_a\",\n",
        "    \"group_b\",\n",
        "    \"identities\",\n",
        "    \"raw_p_value\",\n",
        "    \"holm_adjusted_p_value\"\n",
        "}\n",
        "\n",
        "assert required_identity_columns.issubset(identity.columns), (\n",
        "    \"Identity-level CSV is missing required columns.\"\n",
        ")\n",
        "\n",
        "assert required_frozen_columns.issubset(frozen.columns), (\n",
        "    \"Frozen comparison CSV is missing required columns.\"\n",
        ")\n",
        "\n",
        "assert len(frozen) == 6, (\n",
        "    f\"Expected six frozen comparisons, found {len(frozen)}.\"\n",
        ")\n",
        "\n",
        "assert not identity.duplicated(\n",
        "    [\"subject\", \"illumination_group\"]\n",
        ").any(), \"Duplicate subject/group rows detected.\"\n",
        "\n",
        "expected_groups = {\n",
        "    \"near_frontal\",\n",
        "    \"oblique\",\n",
        "    \"large_angular_deviation\"\n",
        "}\n",
        "\n",
        "actual_groups = set(identity[\"illumination_group\"].unique())\n",
        "\n",
        "assert actual_groups == expected_groups, (\n",
        "    f\"Unexpected illumination groups: {actual_groups}\"\n",
        ")\n",
        "\n",
        "subjects_by_group = (\n",
        "    identity.groupby(\"illumination_group\")[\"subject\"]\n",
        "    .nunique()\n",
        "    .to_dict()\n",
        ")\n",
        "\n",
        "print(\"\\nIdentity counts by group:\")\n",
        "print(subjects_by_group)\n",
        "\n",
        "assert all(count == 38 for count in subjects_by_group.values()), (\n",
        "    \"Each illumination group must contain 38 identities.\"\n",
        ")\n",
        "\n",
        "assert identity[\"subject\"].nunique() == 38, (\n",
        "    \"Expected exactly 38 unique identities.\"\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. RECOMPUTE THE SIX PAIRED WILCOXON TESTS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "metric_columns = {\n",
        "    \"euclidean_mean\": \"euclidean_mean\",\n",
        "    \"cosine_mean\": \"cosine_mean\"\n",
        "}\n",
        "\n",
        "recomputed_rows = []\n",
        "\n",
        "for _, frozen_row in frozen.iterrows():\n",
        "\n",
        "    metric = frozen_row[\"metric\"]\n",
        "    group_a = frozen_row[\"group_a\"]\n",
        "    group_b = frozen_row[\"group_b\"]\n",
        "\n",
        "    assert metric in metric_columns, (\n",
        "        f\"Unexpected metric label: {metric}\"\n",
        "    )\n",
        "\n",
        "    value_column = metric_columns[metric]\n",
        "\n",
        "    data_a = (\n",
        "        identity.loc[\n",
        "            identity[\"illumination_group\"] == group_a,\n",
        "            [\"subject\", value_column]\n",
        "        ]\n",
        "        .rename(columns={value_column: \"value_a\"})\n",
        "    )\n",
        "\n",
        "    data_b = (\n",
        "        identity.loc[\n",
        "            identity[\"illumination_group\"] == group_b,\n",
        "            [\"subject\", value_column]\n",
        "        ]\n",
        "        .rename(columns={value_column: \"value_b\"})\n",
        "    )\n",
        "\n",
        "    paired = data_a.merge(\n",
        "        data_b,\n",
        "        on=\"subject\",\n",
        "        how=\"inner\",\n",
        "        validate=\"one_to_one\"\n",
        "    ).sort_values(\"subject\")\n",
        "\n",
        "    assert len(paired) == 38, (\n",
        "        f\"Expected 38 paired identities for \"\n",
        "        f\"{metric}: {group_a} vs {group_b}; \"\n",
        "        f\"found {len(paired)}.\"\n",
        "    )\n",
        "\n",
        "    assert np.isfinite(\n",
        "        paired[[\"value_a\", \"value_b\"]].to_numpy()\n",
        "    ).all(), \"Non-finite paired values detected.\"\n",
        "\n",
        "    differences = (\n",
        "        paired[\"value_b\"].to_numpy()\n",
        "        - paired[\"value_a\"].to_numpy()\n",
        "    )\n",
        "\n",
        "    test_result = wilcoxon(\n",
        "        paired[\"value_a\"].to_numpy(),\n",
        "        paired[\"value_b\"].to_numpy(),\n",
        "        alternative=\"two-sided\"\n",
        "    )\n",
        "\n",
        "    recomputed_rows.append({\n",
        "        \"metric\": metric,\n",
        "        \"group_a\": group_a,\n",
        "        \"group_b\": group_b,\n",
        "        \"identities\": len(paired),\n",
        "        \"wilcoxon_statistic_recomputed\": float(test_result.statistic),\n",
        "        \"raw_p_value_recomputed\": float(test_result.pvalue),\n",
        "        \"mean_paired_difference_recomputed\": float(\n",
        "            np.mean(differences)\n",
        "        ),\n",
        "        \"median_paired_difference_recomputed\": float(\n",
        "            np.median(differences)\n",
        "        ),\n",
        "        \"raw_p_value_frozen\": float(\n",
        "            frozen_row[\"raw_p_value\"]\n",
        "        ),\n",
        "        \"holm_adjusted_p_value_frozen\": float(\n",
        "            frozen_row[\"holm_adjusted_p_value\"]\n",
        "        )\n",
        "    })\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. APPLY HOLM CORRECTION ONCE ACROSS ALL SIX TESTS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def holm_adjust(p_values):\n",
        "\n",
        "    p_values = np.asarray(p_values, dtype=float)\n",
        "\n",
        "    if len(p_values) == 0:\n",
        "        return np.array([])\n",
        "\n",
        "    order = np.argsort(p_values)\n",
        "    sorted_p = p_values[order]\n",
        "\n",
        "    m = len(sorted_p)\n",
        "\n",
        "    adjusted_sorted = np.empty(m, dtype=float)\n",
        "\n",
        "    running_max = 0.0\n",
        "\n",
        "    for i, p in enumerate(sorted_p):\n",
        "        adjusted = (m - i) * p\n",
        "        running_max = max(running_max, adjusted)\n",
        "        adjusted_sorted[i] = min(running_max, 1.0)\n",
        "\n",
        "    adjusted_original = np.empty(m, dtype=float)\n",
        "    adjusted_original[order] = adjusted_sorted\n",
        "\n",
        "    return adjusted_original\n",
        "\n",
        "\n",
        "recomputed = pd.DataFrame(recomputed_rows)\n",
        "\n",
        "recomputed[\"holm_adjusted_p_value_combined_six\"] = holm_adjust(\n",
        "    recomputed[\"raw_p_value_recomputed\"].to_numpy()\n",
        ")\n",
        "\n",
        "recomputed[\"significant_combined_six_alpha_005\"] = (\n",
        "    recomputed[\"holm_adjusted_p_value_combined_six\"] < 0.05\n",
        ")\n",
        "\n",
        "recomputed[\"raw_p_matches_frozen\"] = np.isclose(\n",
        "    recomputed[\"raw_p_value_recomputed\"],\n",
        "    recomputed[\"raw_p_value_frozen\"],\n",
        "    rtol=1e-8,\n",
        "    atol=1e-15\n",
        ")\n",
        "\n",
        "recomputed[\"frozen_holm_matches_combined_six\"] = np.isclose(\n",
        "    recomputed[\"holm_adjusted_p_value_frozen\"],\n",
        "    recomputed[\"holm_adjusted_p_value_combined_six\"],\n",
        "    rtol=1e-8,\n",
        "    atol=1e-15\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. DISPLAY RESULTS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 90)\n",
        "print(\"RECOMPUTED PAIRED COMPARISONS\")\n",
        "print(\"=\" * 90)\n",
        "\n",
        "display_columns = [\n",
        "    \"metric\",\n",
        "    \"group_a\",\n",
        "    \"group_b\",\n",
        "    \"identities\",\n",
        "    \"raw_p_value_recomputed\",\n",
        "    \"raw_p_value_frozen\",\n",
        "    \"holm_adjusted_p_value_frozen\",\n",
        "    \"holm_adjusted_p_value_combined_six\",\n",
        "    \"raw_p_matches_frozen\",\n",
        "    \"frozen_holm_matches_combined_six\"\n",
        "]\n",
        "\n",
        "print(recomputed[display_columns].to_string(index=False))\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 8. SUMMARY CHECKS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "raw_matches = bool(\n",
        "    recomputed[\"raw_p_matches_frozen\"].all()\n",
        ")\n",
        "\n",
        "holm_matches = bool(\n",
        "    recomputed[\"frozen_holm_matches_combined_six\"].all()\n",
        ")\n",
        "\n",
        "all_significant = bool(\n",
        "    recomputed[\"significant_combined_six_alpha_005\"].all()\n",
        ")\n",
        "\n",
        "print(\"\\n\" + \"=\" * 90)\n",
        "print(\"VERIFICATION SUMMARY\")\n",
        "print(\"=\" * 90)\n",
        "\n",
        "print(\"All six raw p-values reproduce frozen values:\", raw_matches)\n",
        "print(\"All frozen Holm values match combined family of six:\", holm_matches)\n",
        "print(\"All six remain significant after combined Holm correction:\", all_significant)\n",
        "\n",
        "print(\n",
        "    \"Recomputed combined-family Holm values:\",\n",
        "    recomputed[\"holm_adjusted_p_value_combined_six\"].tolist()\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 9. SAVE A NEW JSON VERIFICATION REPORT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "report = {\n",
        "    \"step\": \"3.3.21\",\n",
        "    \"title\": \"Independent Recalculation of Six Paired Comparisons\",\n",
        "    \"timestamp_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "\n",
        "    \"source_files\": {\n",
        "        \"identity_level_group_means\": {\n",
        "            \"path\": IDENTITY_FILE,\n",
        "            \"sha256\": sha256_file(IDENTITY_FILE),\n",
        "            \"rows\": int(len(identity))\n",
        "        },\n",
        "        \"frozen_paired_comparison_results\": {\n",
        "            \"path\": FROZEN_RESULTS_FILE,\n",
        "            \"sha256\": sha256_file(FROZEN_RESULTS_FILE),\n",
        "            \"rows\": int(len(frozen))\n",
        "        }\n",
        "    },\n",
        "\n",
        "    \"validation\": {\n",
        "        \"unique_identities\": int(identity[\"subject\"].nunique()),\n",
        "        \"group_counts\": {\n",
        "            str(k): int(v)\n",
        "            for k, v in subjects_by_group.items()\n",
        "        },\n",
        "        \"frozen_comparison_rows\": int(len(frozen)),\n",
        "        \"all_structural_checks_passed\": True\n",
        "    },\n",
        "\n",
        "    \"statistical_recalculation\": {\n",
        "        \"test\": \"Paired Wilcoxon signed-rank\",\n",
        "        \"alternative\": \"two-sided\",\n",
        "        \"holm_family_size\": 6,\n",
        "        \"holm_correction\": \"One combined family of six tests\",\n",
        "        \"results\": recomputed.to_dict(orient=\"records\")\n",
        "    },\n",
        "\n",
        "    \"summary\": {\n",
        "        \"all_raw_p_values_reproduce_frozen\": raw_matches,\n",
        "        \"all_frozen_holm_values_match_combined_six\": holm_matches,\n",
        "        \"all_combined_holm_tests_significant_at_0_05\": all_significant\n",
        "    },\n",
        "\n",
        "    \"integrity\": {\n",
        "        \"frozen_source_files_modified\": False,\n",
        "        \"frozen_results_overwritten\": False,\n",
        "        \"manuscript_modified\": False,\n",
        "        \"new_report_only\": True\n",
        "    }\n",
        "}\n",
        "\n",
        "with open(REPORT_FILE, \"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(report, f, indent=2)\n",
        "\n",
        "print(\"\\nVerification report saved:\")\n",
        "print(REPORT_FILE)\n",
        "\n",
        "print(\"\\nFrozen source files were read only.\")\n",
        "print(\"No source CSV or manuscript was overwritten.\")\n",
        "print(\"\\nSTEP 3.3.21 COMPLETED\")"
      ],
      "metadata": {
