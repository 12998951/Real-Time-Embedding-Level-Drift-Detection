      "cell_type": "markdown",
      "source": [
        "# Experiment 20 — Step 3.3.24: Holm Correction Provenance and Table 2 Verification\n",
        "\n",
        "## Objective\n",
        "Verify the existing six-test Holm correction record and inspect the complete pairwise comparison table in both manuscript copies.\n",
        "\n",
        "## Files\n",
        "1. `step_33103/experiment20_step33103_holm_correction_record.json`\n",
        "2. `step_33103/experiment20_manuscript_six_test_holm_results.csv`\n",
        "3. Integrated manuscript v1.\n",
        "4. Step 3.3.13 manuscript review copy.\n",
        "\n",
        "## Verification questions\n",
        "- Does the correction record specify one family of six tests?\n",
        "- Does it document the raw p-values, corrected values, and correction method?\n",
        "- Does it identify the source data and preserve the original metric-wise values?\n",
        "- Does Manuscript Table 2 report the corrected six-test values for all six comparisons?\n",
        "- Are the two manuscript copies still identical?\n",
        "\n",
        "## Integrity restrictions\n",
        "Read-only inspection. Do not modify any existing files or apply corrections."
      ],
      "metadata": {
        "id": "zJZiZ5XOD4yx"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# EXPERIMENT 20 — STEP 3.3.24\n",
        "# CORRECTION PROVENANCE + MANUSCRIPT TABLE 2 VERIFICATION\n",
        "# READ-ONLY\n",
        "# ============================================================\n",
        "\n",
        "import os\n",
        "import json\n",
        "import hashlib\n",
        "import pandas as pd\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "BASE = \"/content/drive/MyDrive/Experiment_20_Results\"\n",
        "\n",
        "CORRECTION_DIR = os.path.join(\n",
        "    BASE, \"step_3_3\", \"step_33103\"\n",
        ")\n",
        "\n",
        "RECORD_PATH = os.path.join(\n",
        "    CORRECTION_DIR,\n",
        "    \"experiment20_step33103_holm_correction_record.json\"\n",
        ")\n",
        "\n",
        "CORRECTED_CSV_PATH = os.path.join(\n",
        "    CORRECTION_DIR,\n",
        "    \"experiment20_manuscript_six_test_holm_results.csv\"\n",
        ")\n",
        "\n",
        "MANUSCRIPTS = {\n",
        "    \"integrated\": os.path.join(\n",
        "        BASE,\n",
        "        \"step_3_3\",\n",
        "        \"step_3312\",\n",
        "        \"experiment20_integrated_manuscript_v1.md\"\n",
        "    ),\n",
        "    \"review_copy\": os.path.join(\n",
        "        BASE,\n",
        "        \"step_3_3\",\n",
        "        \"step_3313\",\n",
        "        \"experiment20_step3313_manuscript_review_copy.md\"\n",
        "    )\n",
        "}\n",
        "\n",
        "OUTPUT_DIR = os.path.join(\n",
        "    BASE, \"step_3_3\", \"step_3324\"\n",
        ")\n",
        "\n",
        "os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
        "\n",
        "REPORT_PATH = os.path.join(\n",
        "    OUTPUT_DIR,\n",
        "    \"experiment20_step3324_holm_provenance_table2_verification.json\"\n",
        ")\n",
        "\n",
        "\n",
        "def sha256_file(path):\n",
        "    h = hashlib.sha256()\n",
        "    with open(path, \"rb\") as f:\n",
        "        for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n",
        "            h.update(chunk)\n",
        "    return h.hexdigest()\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. INSPECT CORRECTION RECORD\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"=\" * 100)\n",
        "print(\"1. CORRECTION RECORD\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "assert os.path.isfile(RECORD_PATH), (\n",
        "    \"Correction record not found.\"\n",
        ")\n",
        "\n",
        "with open(RECORD_PATH, \"r\", encoding=\"utf-8\") as f:\n",
        "    correction_record = json.load(f)\n",
        "\n",
        "print(\"Path:\", RECORD_PATH)\n",
        "print(\"SHA256:\", sha256_file(RECORD_PATH))\n",
        "print(\"\\nComplete correction record:\")\n",
        "print(json.dumps(correction_record, indent=2))\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. INSPECT CORRECTED CSV AND CHECK SIX ROWS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"2. CORRECTED CSV VALIDATION\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "assert os.path.isfile(CORRECTED_CSV_PATH), (\n",
        "    \"Corrected CSV not found.\"\n",
        ")\n",
        "\n",
        "corrected = pd.read_csv(CORRECTED_CSV_PATH)\n",
        "\n",
        "required_columns = [\n",
        "    \"metric\",\n",
        "    \"group_a\",\n",
        "    \"group_b\",\n",
        "    \"raw_p_value\",\n",
        "    \"holm_adjusted_p_value\",\n",
        "    \"six_test_holm_adjusted_p_value\",\n",
        "    \"six_test_family_size\",\n",
        "    \"correction_scope\",\n",
        "    \"original_metric_wise_holm_adjusted_p_value\",\n",
        "    \"manuscript_adjusted_p_value\"\n",
        "]\n",
        "\n",
        "missing = [\n",
        "    c for c in required_columns\n",
        "    if c not in corrected.columns\n",
        "]\n",
        "\n",
        "assert not missing, f\"Missing columns: {missing}\"\n",
        "assert len(corrected) == 6, (\n",
        "    f\"Expected 6 comparisons; found {len(corrected)}.\"\n",
        ")\n",
        "\n",
        "print(\"Path:\", CORRECTED_CSV_PATH)\n",
        "print(\"SHA256:\", sha256_file(CORRECTED_CSV_PATH))\n",
        "print(\"Rows:\", len(corrected))\n",
        "print(\"\\nRelevant columns:\")\n",
        "print(corrected[required_columns].to_string(index=False))\n",
        "\n",
        "family_sizes = corrected[\"six_test_family_size\"].unique().tolist()\n",
        "scopes = corrected[\"correction_scope\"].unique().tolist()\n",
        "manuscript_values = corrected[\n",
        "    \"manuscript_adjusted_p_value\"\n",
        "].unique().tolist()\n",
        "combined_values = corrected[\n",
        "    \"six_test_holm_adjusted_p_value\"\n",
        "].unique().tolist()\n",
        "\n",
        "print(\"\\nUnique family sizes:\", family_sizes)\n",
        "print(\"Correction scopes:\", scopes)\n",
        "print(\"Unique six-test adjusted values:\", combined_values)\n",
        "print(\"Unique manuscript adjusted values:\", manuscript_values)\n",
        "\n",
        "assert family_sizes == [6], (\n",
        "    \"The CSV does not consistently specify a family size of six.\"\n",
        ")\n",
        "\n",
        "assert len(combined_values) == 1, (\n",
        "    \"Six-test adjusted p-values are not consistent across rows.\"\n",
        ")\n",
        "\n",
        "assert all(\n",
        "    abs(float(a) - float(b)) < 1e-20\n",
        "    for a, b in zip(\n",
        "        corrected[\"six_test_holm_adjusted_p_value\"],\n",
        "        corrected[\"manuscript_adjusted_p_value\"]\n",
        "    )\n",
        "), \"Manuscript adjusted values differ from six-test adjusted values.\"\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. INSPECT COMPLETE TABLE 2 IN BOTH MANUSCRIPTS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"3. COMPLETE MANUSCRIPT TABLE 2\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "manuscript_results = {}\n",
        "\n",
        "for label, path in MANUSCRIPTS.items():\n",
        "\n",
        "    assert os.path.isfile(path), (\n",
        "        f\"Manuscript not found: {path}\"\n",
        "    )\n",
        "\n",
        "    with open(path, \"r\", encoding=\"utf-8\") as f:\n",
        "        lines = f.readlines()\n",
        "\n",
        "    table_start = None\n",
        "\n",
        "    for i, line in enumerate(lines):\n",
        "        if \"Table 2. Identity-level pairwise comparisons\" in line:\n",
        "            table_start = i\n",
        "            break\n",
        "\n",
        "    assert table_start is not None, (\n",
        "        f\"Table 2 heading not found in {label}.\"\n",
        "    )\n",
        "\n",
        "    table_lines = []\n",
        "\n",
        "    # Capture the heading and contiguous Markdown table rows.\n",
        "    for j in range(table_start, len(lines)):\n",
        "        current = lines[j].rstrip(\"\\n\")\n",
        "\n",
        "        if j == table_start:\n",
        "            table_lines.append(current)\n",
        "            continue\n",
        "\n",
        "        if current.strip().startswith(\"|\"):\n",
        "            table_lines.append(current)\n",
        "        elif table_lines:\n",
        "            break\n",
        "\n",
        "    print(\"\\nMANUSCRIPT:\", label)\n",
        "    print(\"Path:\", path)\n",
        "    print(\"SHA256:\", sha256_file(path))\n",
        "    print(\"Table 2 begins at line:\", table_start + 1)\n",
        "\n",
        "    for offset, table_line in enumerate(table_lines):\n",
        "        print(f\"{table_start + offset + 1}: {table_line}\")\n",
        "\n",
        "    manuscript_results[label] = {\n",
        "        \"path\": path,\n",
        "        \"sha256\": sha256_file(path),\n",
        "        \"table_start_line\": table_start + 1,\n",
        "        \"table_lines\": table_lines\n",
        "    }\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. CHECK MANUSCRIPT COPY IDENTITY\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "integrated_hash = manuscript_results[\"integrated\"][\"sha256\"]\n",
        "review_hash = manuscript_results[\"review_copy\"][\"sha256\"]\n",
        "\n",
        "copies_identical = integrated_hash == review_hash\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"4. MANUSCRIPT COPY CHECK\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "print(\"Integrated SHA256:\", integrated_hash)\n",
        "print(\"Review copy SHA256:\", review_hash)\n",
        "print(\"Identical:\", copies_identical)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. SAVE REPORT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "report = {\n",
        "    \"step\": \"3.3.24\",\n",
        "    \"title\": \"Holm Correction Provenance and Table 2 Verification\",\n",
        "    \"timestamp_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "\n",
        "    \"correction_record\": {\n",
        "        \"path\": RECORD_PATH,\n",
        "        \"sha256\": sha256_file(RECORD_PATH),\n",
        "        \"content\": correction_record\n",
        "    },\n",
        "\n",
        "    \"corrected_csv\": {\n",
        "        \"path\": CORRECTED_CSV_PATH,\n",
        "        \"sha256\": sha256_file(CORRECTED_CSV_PATH),\n",
        "        \"rows\": int(len(corrected)),\n",
        "        \"columns\": list(corrected.columns),\n",
        "        \"family_sizes\": family_sizes,\n",
        "        \"correction_scopes\": scopes,\n",
        "        \"six_test_adjusted_values\": [\n",
        "            float(x) for x in combined_values\n",
        "        ],\n",
        "        \"manuscript_adjusted_values\": [\n",
        "            float(x) for x in manuscript_values\n",
        "        ]\n",
        "    },\n",
        "\n",
        "    \"manuscripts\": manuscript_results,\n",
        "\n",
        "    \"manuscript_copies_identical\": copies_identical,\n",
        "\n",
        "    \"integrity\": {\n",
        "        \"existing_files_modified\": False,\n",
        "        \"correction_record_modified\": False,\n",
        "        \"corrected_csv_modified\": False,\n",
        "        \"manuscripts_modified\": False\n",
        "    }\n",
        "}\n",
        "\n",
        "with open(REPORT_PATH, \"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(report, f, indent=2, default=str)\n",
        "\n",
        "print(\"\\nVerification report saved:\")\n",
        "print(REPORT_PATH)\n",
        "\n",
        "print(\"\\nNo existing files were modified.\")\n",
        "print(\"STEP 3.3.24 COMPLETED\")"
      ],
