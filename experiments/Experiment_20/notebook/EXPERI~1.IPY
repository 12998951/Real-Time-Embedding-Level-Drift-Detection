        "# Experiment 20 — Step 3.3.9.13\n",
        "## Audit: Illumination-Angle Unit and Formula Verification\n",
        "\n",
        "Objective:\n",
        "Verify how illumination azimuth and elevation values were converted and used when calculating angular deviation.\n",
        "\n",
        "The audit must establish:\n",
        "1. Whether the source angles were recorded in degrees.\n",
        "2. Whether degree-to-radian conversion was applied before trigonometric operations.\n",
        "3. Whether the inverse cosine result was converted to degrees.\n",
        "4. Whether the implementation matches the documented angular grouping formula.\n",
        "\n",
        "No manuscript or experimental data will be modified in this step."
      ],
      "metadata": {
        "id": "fvZCMQy5NC1w"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from pathlib import Path\n",
        "import re\n",
        "import json\n",
        "\n",
        "BASE = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "\n",
        "SEARCH_DIRS = [\n",
        "    BASE / \"dataset_audit\",\n",
        "    BASE / \"step_2_7\",\n",
        "    BASE / \"step_3_1\",\n",
        "    BASE / \"step_3_2\",\n",
        "    BASE / \"step_3_3\"\n",
        "]\n",
        "\n",
        "PATTERNS = [\n",
        "    r\"arccos\",\n",
        "    r\"acos\",\n",
        "    r\"deg2rad\",\n",
        "    r\"radians\",\n",
        "    r\"rad2deg\",\n",
        "    r\"degrees\",\n",
        "    r\"azimuth\",\n",
        "    r\"elevation\",\n",
        "    r\"illumination.*angle\",\n",
        "    r\"angular.*deviation\",\n",
        "    r\"theta\"\n",
        "]\n",
        "\n",
        "EXTENSIONS = {\".py\", \".ipynb\", \".json\", \".md\", \".txt\"}\n",
        "\n",
        "print(\"=\" * 88)\n",
        "print(\"EXPERIMENT 20 — STEP 3.3.9.13\")\n",
        "print(\"ILLUMINATION-ANGLE UNIT AND FORMULA AUDIT\")\n",
        "print(\"=\" * 88)\n",
        "\n",
        "files_scanned = 0\n",
        "matches_found = 0\n",
        "candidate_files = []\n",
        "\n",
        "for directory in SEARCH_DIRS:\n",
        "    if not directory.exists():\n",
        "        print(f\"\\nDirectory unavailable: {directory}\")\n",
        "        continue\n",
        "\n",
        "    for path in directory.rglob(\"*\"):\n",
        "        if not path.is_file() or path.suffix.lower() not in EXTENSIONS:\n",
        "            continue\n",
        "\n",
        "        try:\n",
        "            content = path.read_text(encoding=\"utf-8\", errors=\"ignore\")\n",
        "        except Exception:\n",
        "            continue\n",
        "\n",
        "        files_scanned += 1\n",
        "        lines = content.splitlines()\n",
        "        matched_lines = []\n",
        "\n",
        "        for index, line in enumerate(lines):\n",
        "            if any(re.search(pattern, line, re.IGNORECASE)\n",
        "                   for pattern in PATTERNS):\n",
        "                start = max(0, index - 2)\n",
        "                end = min(len(lines), index + 3)\n",
        "\n",
        "                snippet = \"\\n\".join(\n",
        "                    f\"{i+1}: {lines[i]}\"\n",
        "                    for i in range(start, end)\n",
        "                )\n",
        "\n",
        "                matched_lines.append(snippet)\n",
        "\n",
        "        if matched_lines:\n",
        "            matches_found += len(matched_lines)\n",
        "            candidate_files.append(path)\n",
        "\n",
        "            print(\"\\n\" + \"-\" * 88)\n",
        "            print(\"FILE:\", path)\n",
        "            print(\"MATCHES:\", len(matched_lines))\n",
        "\n",
        "            for snippet in matched_lines[:12]:\n",
        "                print(\"\\n\" + snippet)\n",
        "\n",
        "            if len(matched_lines) > 12:\n",
        "                print(\"\\nAdditional matches omitted from display.\")\n",
        "\n",
        "print(\"\\n\" + \"=\" * 88)\n",
        "print(\"AUDIT SUMMARY\")\n",
        "print(\"=\" * 88)\n",
        "\n",
        "print(\"Files scanned:\", files_scanned)\n",
        "print(\"Files with relevant matches:\", len(candidate_files))\n",
        "print(\"Relevant match groups:\", matches_found)\n",
        "\n",
        "print(\"\\nCandidate source files:\")\n",
        "for path in candidate_files:\n",
        "    print(path)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 88)\n",
        "print(\"MANUAL VERIFICATION REQUIRED\")\n",
        "print(\"=\" * 88)\n",
        "\n",
        "print(\"\"\"\n",
        "Please inspect the displayed source lines.\n",
        "\n",
        "We need evidence for all three operations:\n",
        "\n",
        "A. Degree-to-radian conversion before cosine:\n",
        "   Example: np.deg2rad(azimuth) and np.deg2rad(elevation)\n",
        "\n",
        "B. Inverse cosine:\n",
        "   Example: np.arccos(...)\n",
        "\n",
        "C. Radian-to-degree conversion after inverse cosine:\n",
        "   Example: np.rad2deg(theta)\n",
        "\n",
        "Do not infer that a conversion occurred merely because the metadata\n",
        "contains angles expressed in degrees.\n",
        "\n",
        "No files were modified by this audit.\n",
        "\"\"\")"
      ],
