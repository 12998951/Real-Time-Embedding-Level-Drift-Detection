        "}\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. RESEARCH CONTRIBUTION AND FUTURE WORK\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "contribution_checks = {\n",
        "    \"empirical_characterisation\": (\n",
