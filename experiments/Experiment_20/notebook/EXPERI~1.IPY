      "cell_type": "code",
      "source": [
        "from pathlib import Path\n",
        "import json\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "BASE = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "STEP_DIR = BASE / \"step_3_3\"\n",
        "SOURCE_DIR = STEP_DIR / \"step_337\"\n",
        "AUDIT_DIR = STEP_DIR / \"step_338\"\n",
        "OUTPUT_DIR = STEP_DIR / \"step_3382\"\n",
        "\n",
        "OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "INTRO_FILE = SOURCE_DIR / \"experiment20_consolidated_introduction.md\"\n",
        "JSON_FILE = SOURCE_DIR / \"experiment20_consolidated_introduction.json\"\n",
        "ANGULAR_AUDIT_FILE = AUDIT_DIR / (\n",
        "    \"experiment20_step3381_angular_grouping_literature_audit.json\"\n",
        ")\n",
        "\n",
        "for path in [INTRO_FILE, JSON_FILE, ANGULAR_AUDIT_FILE]:\n",
        "    if not path.exists():\n",
        "        raise FileNotFoundError(f\"Required file missing: {path}\")\n",
        "\n",
        "with open(INTRO_FILE, \"r\", encoding=\"utf-8\") as f:\n",
        "    original_markdown = f.read()\n",
        "\n",
        "with open(JSON_FILE, \"r\", encoding=\"utf-8\") as f:\n",
        "    original_json = json.load(f)\n",
        "\n",
        "with open(ANGULAR_AUDIT_FILE, \"r\", encoding=\"utf-8\") as f:\n",
        "    angular_audit = json.load(f)\n",
        "\n",
        "# Exact sentence from the existing introduction.\n",
        "old_sentence = (\n",
        "    \"Research using Yale B datasets has also considered illumination \"\n",
        "    \"conditions according to the angular position of light sources, \"\n",
        "    \"demonstrating the relevance of illumination geometry in controlled \"\n",
        "    \"face-image analysis.\"\n",
        ")\n",
        "\n",
        "new_sentence = (\n",
        "    \"Research using Yale Face Database B has also classified illumination \"\n",
        "    \"conditions according to the angle between the light-source direction \"\n",
        "    \"and camera axis. Ochoa-Villegas et al. (2015) describe five angular \"\n",
        "    \"subsets: 0°–12°, 13°–25°, 26°–50°, 51°–77°, and above 77°. \"\n",
        "    \"This provides precedent for angular grouping in illumination studies. \"\n",
        "    \"The present study adopts a different three-group classification, \"\n",
        "    \"with near-frontal conditions defined as θ ≤ 30°, oblique conditions \"\n",
        "    \"as 30° < θ ≤ 60°, and large-angular-deviation conditions as θ > 60°. \"\n",
        "    \"These thresholds represent the analytical grouping adopted in \"\n",
        "    \"Experiment 20 and are not the same as the five subsets reported \"\n",
        "    \"in the survey.\"\n",
        ")\n",
        "\n",
        "if original_markdown.count(old_sentence) != 1:\n",
        "    raise ValueError(\n",
        "        \"Expected sentence was not found exactly once. \"\n",
        "        \"No changes have been made.\"\n",
        "    )\n",
        "\n",
        "updated_markdown = original_markdown.replace(\n",
        "    old_sentence, new_sentence, 1\n",
        ")\n",
        "\n",
        "# Ensure the added source is included in the citation inventory.\n",
        "citation = \"Ochoa-Villegas et al. (2015)\"\n",
        "\n",
        "checks = {\n",
        "    \"original_sentence_replaced\": old_sentence not in updated_markdown,\n",
        "    \"new_five_subset_description_present\": all(\n",
        "        term in updated_markdown\n",
        "        for term in [\"0°–12°\", \"13°–25°\", \"26°–50°\", \"51°–77°\", \"above 77°\"]\n",
        "    ),\n",
        "    \"three_group_thresholds_present\": all(\n",
        "        term in updated_markdown\n",
        "        for term in [\"θ ≤ 30°\", \"30° < θ ≤ 60°\", \"θ > 60°\"]\n",
        "    ),\n",
        "    \"study_specific_thresholds_explained\": (\n",
        "        \"analytical grouping adopted in Experiment 20\" in updated_markdown\n",
        "    ),\n",
        "    \"prior_source_not_claimed_to_validate_exact_thresholds\": (\n",
        "        \"are not the same as the five subsets\" in updated_markdown\n",
        "    ),\n",
        "    \"citation_present\": citation in updated_markdown\n",
        "}\n",
        "\n",
        "if not all(checks.values()):\n",
        "    raise AssertionError(\"Citation integration checks failed.\")\n",
        "\n",
        "# Update the consolidated JSON record.\n",
        "updated_json = dict(original_json)\n",
        "updated_json[\"introduction_markdown\"] = updated_markdown\n",
        "updated_json[\"word_count\"] = len(updated_markdown.split())\n",
        "updated_json[\"citation_inventory\"] = list(\n",
        "    dict.fromkeys(\n",
        "        original_json.get(\"citation_inventory\", []) + [\n",
        "            \"Moses, Adini, and Ullman (1994)\",\n",
        "            \"Beveridge et al. (2009)\",\n",
        "            \"Han et al. (2013)\",\n",
        "            \"Ochoa-Villegas et al. (2015)\"\n",
        "        ]\n",
        "    )\n",
        ")\n",
        "updated_json[\"last_updated_step\"] = \"3.3.8.2\"\n",
        "\n",
        "# Save revised outputs separately to preserve the original files.\n",
        "markdown_output = OUTPUT_DIR / \"experiment20_consolidated_introduction_v2.md\"\n",
        "json_output = OUTPUT_DIR / \"experiment20_consolidated_introduction_v2.json\"\n",
        "audit_output = OUTPUT_DIR / \"experiment20_step3382_citation_integration_audit.json\"\n",
        "\n",
        "with open(markdown_output, \"w\", encoding=\"utf-8\") as f:\n",
        "    f.write(updated_markdown)\n",
        "\n",
        "with open(json_output, \"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(updated_json, f, indent=2, ensure_ascii=False)\n",
        "\n",
        "audit = {\n",
        "    \"experiment\": \"Experiment 20\",\n",
        "    \"phase\": \"3.3\",\n",
        "    \"step\": \"3.3.8.2\",\n",
        "    \"timestamp_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "    \"source_angular_audit\": str(ANGULAR_AUDIT_FILE),\n",
        "    \"checks\": checks,\n",
        "    \"passed_checks\": sum(checks.values()),\n",
        "    \"total_checks\": len(checks),\n",
        "    \"failed_checks\": [\n",
        "        key for key, value in checks.items() if not value\n",
        "    ],\n",
        "    \"word_count\": len(updated_markdown.split()),\n",
        "    \"citation_added\": citation,\n",
        "    \"novelty_established\": False,\n",
        "    \"status\": (\n",
        "        \"CITATION_INTEGRATION_PASSED\"\n",
        "        if all(checks.values())\n",
        "        else \"CITATION_INTEGRATION_REQUIRES_REVIEW\"\n",
        "    )\n",
        "}\n",
        "\n",
        "with open(audit_output, \"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(audit, f, indent=2, ensure_ascii=False)\n",
        "\n",
        "# Reload verification.\n",
        "with open(markdown_output, \"r\", encoding=\"utf-8\") as f:\n",
        "    markdown_reload = f.read()\n",
        "\n",
        "with open(json_output, \"r\", encoding=\"utf-8\") as f:\n",
        "    json_reload = json.load(f)\n",
        "\n",
        "with open(audit_output, \"r\", encoding=\"utf-8\") as f:\n",
        "    audit_reload = json.load(f)\n",
        "\n",
        "assert markdown_reload == updated_markdown\n",
        "assert json_reload[\"introduction_markdown\"] == updated_markdown\n",
