\", len(original_evaluation_means))\\\\nprint(\\\\\\\"Embedding dimensions:\\\\\\\", EMBEDDING_DIMENSION)\\\\n\\\\nprint(\\\\\\\"\\\\\\\\nData integrity checks\\\\\\\")\\\\nprint(\\\\\\\"All shifted values finite:\\\\\\\",\\\"\\n\",\"        }\\n\",\"      ]\\n\",\"    },\\n\",\"    {\\n\",\"      \\\"path\\\": \\\"/content/drive/MyDrive/Colab Notebooks/Copy of Experiment_13_Final_Reproducibility_Audit.ipynb\\\",\\n\",\"      \\\"experiment18_reference\\\": false,\\n\",\"      \\\"evidence\\\": [\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 2,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"embedding_dimension\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"    \\\\\\\"random_seed\\\\\\\": SEED,\\\\n    \\\\\\\"n_seeds\\\\\\\": 20,\\\\n    \\\\\\\"embedding_dimension\\\\\\\": 64,\\\\n    \\\\\\\"reference_samples\\\\\\\": 1000,\\\\n    \\\\\\\"calibration_windows\\\\\\\": 200,\\\\n    \\\\\\\"control_windows\\\\\\\": 500,\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 3,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"embedding_dimension\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"    n_windows=CONFIG[\\\\\\\"reference_samples\\\\\\\"] // CONFIG[\\\\\\\"window_size\\\\\\\"],\\\\n    window_size=CONFIG[\\\\\\\"window_size\\\\\\\"],\\\\n    dimension=CONFIG[\\\\\\\"embedding_dimension\\\\\\\"],\\\\n)\\\\n\\\\ncalibration = generate_embedding_windows(\\\\n    n_windows=CONFIG[\\\\\\\"calibration_windows\\\\\\\"],\\\\ncontrol = generate_embedding_windows(\\\\n    n_windows=CONFIG[\\\\\\\"control_windows\\\\\\\"],\\\\nprint(\\\\\\\"Reference windows:\\\\\\\", reference.shape)\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 6,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"embedding_dimension\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"        n_windows=CONFIG[\\\\\\\"evaluation_windows_per_condition\\\\\\\"],\\\\n        window_size=CONFIG[\\\\\\\"window_size\\\\\\\"],\\\\n        dimension=CONFIG[\\\\\\\"embedding_dimension\\\\\\\"],\\\\n        mean_shift=shift,\\\\n    )\\\\n\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 8,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"embedding_dimension\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"    # Independent datasets for this seed\\\\n    ref = generate_embedding_windows(\\\\n        seed_rng, 50, 20, CONFIG[\\\\\\\"embedding_dimension\\\\\\\"]\\\\n    )\\\\n    cal = generate_embedding_windows(\\\\n        seed_rng, 200, 20, CONFIG[\\\\\\\"embedding_dimension\\\\\\\"]\\\\n    ctrl = generate_embedding_windows(\\\\n        seed_rng, 500, 20, CONFIG[\\\\\\\"embedding_dimension\\\\\\\"]\\\\n\\\\n    # Fit detectors using reference data only\\\\n                    500,\\\\n                    20,\\\\n                    CONFIG[\\\\\\\"embedding_dimension\\\\\\\"],\\\\n                    mean_shift=shift,\\\\n                )\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 9,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"embedding_dimension\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"    # 1. Generate independent datasets for this seed\\\\n    ref = generate_embedding_windows(\\\\n        seed_rng, 50, 20, CONFIG[\\\\\\\"embedding_dimension\\\\\\\"]\\\\n    )\\\\n    cal = generate_embedding_windows(\\\\n        seed_rng, 200, 20, CONFIG[\\\\\\\"embedding_dimension\\\\\\\"]\\\\n    ctrl = generate_embedding_windows(\\\\n        seed_rng, 500, 20, CONFIG[\\\\\\\"embedding_dimension\\\\\\\"]\\\\n\\\\n    # 2. Fit detectors on the same reference data\\\\n            500,\\\\n            20,\\\\n            CONFIG[\\\\\\\"embedding_dimension\\\\\\\"],\\\\n            mean_shift=shift,\\\\n        )\\\\n        for shift in CONFIG[\\\\\\\"mean_shift_strengths\\\\\\\"]\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 18,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"embedding_dimension\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"else:\\\\n    print(\\\\\\\"Required functions and configuration are available.\\\\\\\")\\\\n    print(\\\\\\\"Embedding dimension:\\\\\\\", CONFIG[\\\\\\\"embedding_dimension\\\\\\\"])\\\\n    print(\\\\\\\"Random seed:\\\\\\\", CONFIG[\\\\\\\"random_seed\\\\\\\"])\\\\n    print(\\\\\\\"Detectors:\\\\\\\", CONFIG[\\\\\\\"detectors\\\\\\\"])\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 56,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"Resize\\\",\\n\",\"            \\\"Normalize\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"keywords = [\\\\n    \\\\\\\"preprocess\\\\\\\",\\\\n    \\\\\\\"resize\\\\\\\",\\\\n    \\\\\\\"facenet\\\\\\\",\\\\n    \\\\\\\"embeddings\\\\\\\",\\\\n    \\\\\\\"brightness\\\\\\\",\\\\n    \\\\\\\"standardize\\\\\\\",\\\\n    \\\\\\\"normalize\\\\\\\",\\\\n    \\\\\\\"tfds\\\\\\\",\\\\n    \\\\\\\"lfw\\\\\\\",\\\\n    \\\\\\\"image\\\\\\\"\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 58,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"Normalize\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"\\\\nprint(\\\\\\\"\\\\\\\\n2. NORMALIZATION IMPLEMENTATION\\\\\\\")\\\\nprint(inspect.getsource(embedder._normalize))\\\\nprint(\\\\\\\"\\\\\\\\n3. MODEL INPUT SHAPE\\\\\\\")\\\\nprint(embedder.model.input_shape)\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 61,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"MTCNN\\\",\\n\",\"            \\\"fixed_image_standardization\\\",\\n\",\"            \\\"Resize\\\",\\n\",\"            \\\"Normalize\\\",\\n\",\"            \\\"alignment\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"- Verification date: 2026-11-04\\\\n- Embedding method: FaceNet.embeddings()\\\\n- Image resizing: OpenCV cv2.resize()\\\\n- Target image dimensions: 160 x 160 pixels\\\\n- Input channels: 3\\\\n- Normalization mode: fixed_image_standardization=True\\\\n- Input conversion: NumPy float32\\\\n- Model inference: model.predict()\\\\n- Embedding output dimension: 512\\\\n### Verified embedding pipeline\\\\n\\\\n1. Each input image is resized to 160 x 160 using cv2.resize().\\\\n2. Fixed image standardization is applied.\\\\n3. The normalized image batch is converted to float32.\\\\n4. The batch is passed to the FaceNet model using model.predict().\\\\n5. The model returns 512-dimensional embeddings.\\\\n### Face detection and alignment scope\\\\nThe experiment uses FaceNet.embeddings(), not FaceNet.extract().\\\\nThe extract() method invokes the package's face extraction pathway,\\\\nbut that pathway is not used by this experiment's embedding call.\\\\nTherefore, MTCNN face detection and cropping are not part of the\\\\nverified embedding-generation pathway.\\\\n### Model metadata verification\\\\n- Model metadata image_size: 160\\\\n- Model metadata dimensions: 512\\\\n- fixed_image_standardization: True\\\\n- Model input shape: (None, None, None, 3)\\\\n- Model output shape: (None, 512)\\\\n- Model parameters: 23,497,424\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 98,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"alignment\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"path_entries = builder.path_maker(str(lfw_root))\\\\n\\\\nprint(\\\\\\\"DATASET INDEX ALIGNMENT CHECK\\\\\\\")\\\\nprint(\\\\\\\"=\\\\\\\" * 65)\\\\nprint(\\\\\\\"Path entries:\\\\\\\", len(path_entries))\\\\n    )\\\\nprint(\\\\\\\"\\\\\\\\nSTATUS: INDEX-TO-IDENTITY ALIGNMENT PASSED\\\\\\\")\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 109,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"InceptionResnetV1\\\",\\n\",\"            \\\"alignment\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"Identity folders: 5,749\\\\n\\\\nEmbedding model: FaceNet (InceptionResNetV1)\\\\nEmbedding dimension: 512\\\\nPackage: keras-facenet==0.3.2\\\\nThe regenerated dataset ordering was reconstructed using the\\\\navailable TFDS path-making logic and checked for identity alignment.\\\\nHowever, this does not establish that every dataset index maps\\\\nto exactly the same original image as in the original execution.\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 181,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"embedding_dimension\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"    fitting_images=np.array(len(X_fit)),\\\\n    calibration_images=np.array(len(X_cal)),\\\\n    embedding_dimension=np.array(512),\\\\n    ledoitwolf_shrinkage=np.array(cov_model.shrinkage_)\\\\n)\\\\n\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 213,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"Normalize\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"    \\\\\\\"preprocess\\\\\\\",\\\\n    \\\\\\\"normalization\\\\\\\",\\\\n    \\\\\\\"normalize\\\\\\\",\\\\n    \\\\\\\"image_size\\\\\\\",\\\\n    \\\\\\\"dtype\\\\\\\",\\\\n    \\\\\\\"batch_size\\\\\\\"\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 231,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"alignment\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"print(\\\\\\\"Run 2 equals Run 3:\\\\\\\", run2 == run3)\\\\n\\\\nprint(\\\\\\\"\\\\\\\\n=== METADATA ALIGNMENT ===\\\\\\\")\\\\ntfds_identities = [identity for identity, filename in run1]\\\\nmetadata_identities = metadata[\\\\\\\"identity\\\\\\\"].astype(str).tolist()\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 233,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"alignment\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"assert len(image_paths) == len(metadata) == len(recovered)\\\\n\\\\n# Verify identity alignment before embedding.\\\\npath_identities = [p.parent.name for p in image_paths]\\\\nmetadata_identities = metadata[\\\\\\\"identity\\\\\\\"].astype(str).tolist()\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 260,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"alignment\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\")\\\\n\\\\nprint(\\\\\\\"=== 10-IMAGE EMBEDDING ALIGNMENT TEST ===\\\\\\\")\\\\nprint(\\\\\\\"Fresh embedding shape:\\\\\\\", fresh_embeddings.shape)\\\\nprint(\\\\\\\"Recovered sample shape:\\\\\\\", recovered_sample.shape)\\\\nprint(\\\\\\\"Cosine similarities:\\\\\\\", cosine_similarities)\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 262,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"Normalize\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\")\\\\n\\\\n# Normalize vectors for cosine similarity.\\\\ncandidate_norms = np.linalg.norm(\\\\n    candidate_embeddings, axis=1, keepdims=True\\\\ncandidate_normalized = candidate_embeddings / candidate_norms\\\\nrecovered_rows = np.asarray(recovered[:15])\\\\nrecovered_normalized = recovered_rows / np.linalg.norm(\\\\n    recovered_rows, axis=1, keepdims=True\\\\nsimilarity_matrix = (\\\\n    recovered_normalized @ candidate_normalized.T\\\\nprint(\\\\\\\"=== IDENTITY-RESTRICTED EMBEDDING MATCH TEST ===\\\\\\\")\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 266,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"Normalize\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\")\\\\n\\\\n# Normalize both embedding matrices.\\\\nrecovered_norm = recovered / np.linalg.norm(\\\\n    recovered, axis=1, keepdims=True\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 275,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"alignment\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"recovered_float = np.asarray(recovered, dtype=np.float64)\\\\n\\\\n# Calculate differences after image-level alignment.\\\\nembedding_difference = recovered_float - fresh_aligned\\\\nrow_l2_difference = np.linalg.norm(\\\"\\n\",\"        }\\n\",\"      ]\\n\",\"    },\\n\",\"    {\\n\",\"      \\\"path\\\": \\\"/content/drive/MyDrive/Colab Notebooks/Experiment_13_Final_Reproducibility_Audit.ipynb\\\",\\n\",\"      \\\"experiment18_reference\\\": false,\\n\",\"      \\\"evidence\\\": [\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 2,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"embedding_dimension\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"    \\\\\\\"random_seed\\\\\\\": SEED,\\\\n    \\\\\\\"n_seeds\\\\\\\": 20,\\\\n    \\\\\\\"embedding_dimension\\\\\\\": 64,\\\\n    \\\\\\\"reference_samples\\\\\\\": 1000,\\\\n    \\\\\\\"calibration_windows\\\\\\\": 200,\\\\n    \\\\\\\"control_windows\\\\\\\": 500,\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 3,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"embedding_dimension\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"    n_windows=CONFIG[\\\\\\\"reference_samples\\\\\\\"] // CONFIG[\\\\\\\"window_size\\\\\\\"],\\\\n    window_size=CONFIG[\\\\\\\"window_size\\\\\\\"],\\\\n    dimension=CONFIG[\\\\\\\"embedding_dimension\\\\\\\"],\\\\n)\\\\n\\\\ncalibration = generate_embedding_windows(\\\\n    n_windows=CONFIG[\\\\\\\"calibration_windows\\\\\\\"],\\\\ncontrol = generate_embedding_windows(\\\\n    n_windows=CONFIG[\\\\\\\"control_windows\\\\\\\"],\\\\nprint(\\\\\\\"Reference windows:\\\\\\\", reference.shape)\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 6,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"embedding_dimension\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"        n_windows=CONFIG[\\\\\\\"evaluation_windows_per_condition\\\\\\\"],\\\\n        window_size=CONFIG[\\\\\\\"window_size\\\\\\\"],\\\\n        dimension=CONFIG[\\\\\\\"embedding_dimension\\\\\\\"],\\\\n        mean_shift=shift,\\\\n    )\\\\n\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 8,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"embedding_dimension\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"    # Independent datasets for this seed\\\\n    ref = generate_embedding_windows(\\\\n        seed_rng, 50, 20, CONFIG[\\\\\\\"embedding_dimension\\\\\\\"]\\\\n    )\\\\n    cal = generate_embedding_windows(\\\\n        seed_rng, 200, 20, CONFIG[\\\\\\\"embedding_dimension\\\\\\\"]\\\\n    ctrl = generate_embedding_windows(\\\\n        seed_rng, 500, 20, CONFIG[\\\\\\\"embedding_dimension\\\\\\\"]\\\\n\\\\n    # Fit detectors using reference data only\\\\n                    500,\\\\n                    20,\\\\n                    CONFIG[\\\\\\\"embedding_dimension\\\\\\\"],\\\\n                    mean_shift=shift,\\\\n                )\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 9,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"embedding_dimension\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"    # 1. Generate independent datasets for this seed\\\\n    ref = generate_embedding_windows(\\\\n        seed_rng, 50, 20, CONFIG[\\\\\\\"embedding_dimension\\\\\\\"]\\\\n    )\\\\n    cal = generate_embedding_windows(\\\\n        seed_rng, 200, 20, CONFIG[\\\\\\\"embedding_dimension\\\\\\\"]\\\\n    ctrl = generate_embedding_windows(\\\\n        seed_rng, 500, 20, CONFIG[\\\\\\\"embedding_dimension\\\\\\\"]\\\\n\\\\n    # 2. Fit detectors on the same reference data\\\\n            500,\\\\n            20,\\\\n            CONFIG[\\\\\\\"embedding_dimension\\\\\\\"],\\\\n            mean_shift=shift,\\\\n        )\\\\n        for shift in CONFIG[\\\\\\\"mean_shift_strengths\\\\\\\"]\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 18,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"embedding_dimension\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"else:\\\\n    print(\\\\\\\"Required functions and configuration are available.\\\\\\\")\\\\n    print(\\\\\\\"Embedding dimension:\\\\\\\", CONFIG[\\\\\\\"embedding_dimension\\\\\\\"])\\\\n    print(\\\\\\\"Random seed:\\\\\\\", CONFIG[\\\\\\\"random_seed\\\\\\\"])\\\\n    print(\\\\\\\"Detectors:\\\\\\\", CONFIG[\\\\\\\"detectors\\\\\\\"])\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 56,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"Resize\\\",\\n\",\"            \\\"Normalize\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"keywords = [\\\\n    \\\\\\\"preprocess\\\\\\\",\\\\n    \\\\\\\"resize\\\\\\\",\\\\n    \\\\\\\"facenet\\\\\\\",\\\\n    \\\\\\\"embeddings\\\\\\\",\\\\n    \\\\\\\"brightness\\\\\\\",\\\\n    \\\\\\\"standardize\\\\\\\",\\\\n    \\\\\\\"normalize\\\\\\\",\\\\n    \\\\\\\"tfds\\\\\\\",\\\\n    \\\\\\\"lfw\\\\\\\",\\\\n    \\\\\\\"image\\\\\\\"\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 58,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"Normalize\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"\\\\nprint(\\\\\\\"\\\\\\\\n2. NORMALIZATION IMPLEMENTATION\\\\\\\")\\\\nprint(inspect.getsource(embedder._normalize))\\\\nprint(\\\\\\\"\\\\\\\\n3. MODEL INPUT SHAPE\\\\\\\")\\\\nprint(embedder.model.input_shape)\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 61,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"MTCNN\\\",\\n\",\"            \\\"fixed_image_standardization\\\",\\n\",\"            \\\"Resize\\\",\\n\",\"            \\\"Normalize\\\",\\n\",\"            \\\"alignment\