      "source": [
        "\n",
        "## Step 3.3.18 — Expanded Search for the Original Statistical Analysis Source\n",
        "\n",
        "### Objective\n",
        "\n",
        "Search the wider Google Drive workspace for the original Python script or Colab notebook that generated the Experiment 20 paired-comparison results.\n",
        "\n",
        "### Search Scope\n",
        "\n",
        "The search will extend beyond the Experiment_20_Results directory and inspect Python scripts and Jupyter notebooks throughout MyDrive.\n",
        "\n",
        "### Search Targets\n",
        "\n",
        "- Experiment 20 statistical-analysis notebooks.\n",
        "- Wilcoxon signed-rank implementation.\n",
        "- Holm correction implementation.\n",
        "- Generation of experiment20_paired_comparison_results.csv.\n",
        "- Separate Euclidean and cosine correction operations.\n",
        "\n",
        "### Data Integrity\n",
        "\n",
        "This step is read-only. It will not execute notebooks, modify source files, or change experimental results.\n",
        "\n",
        "### Expected Output\n",
        "\n",
        "A list of candidate source files, matching code excerpts, file locations, and SHA256 hashes.\n",
        "\n",
        "### Completion Criteria\n",
        "\n",
        "Identify the original analysis source or establish that it cannot be located in the accessible Google Drive workspace.\n"
      ],
      "metadata": {
        "id": "3VVikFjzBJYf"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "from pathlib import Path\n",
        "import json\n",
        "import re\n",
        "import hashlib\n",
        "\n",
        "ROOT = Path(\"/content/drive/MyDrive\")\n",
        "\n",
        "if not ROOT.exists():\n",
        "    raise FileNotFoundError(\n",
        "        \"Google Drive MyDrive is not mounted at /content/drive/MyDrive\"\n",
        "    )\n",
        "\n",
        "OUTPUT_DIR = (\n",
        "    ROOT / \"Experiment_20_Results\" /\n",
        "    \"step_3_3\" / \"step_3318\"\n",
        ")\n",
        "OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "TARGETS = [\n",
        "    \"experiment20_paired_comparison_results.csv\",\n",
        "    \"holm_adjusted_p_value\",\n",
        "    \"multipletests\",\n",
        "    \"method='holm'\",\n",
        "    'method=\"holm\"',\n",
        "    \"holm\",\n",
        "    \"wilcoxon\",\n",
        "    \"paired_comparison_results\"\n",
        "]\n",
        "\n",
        "patterns = [\n",
        "    re.compile(re.escape(term), re.IGNORECASE)\n",
        "    for term in TARGETS\n",
        "]\n",
        "\n",
        "EXCLUDED_DIRS = {\n",
        "    \".trash\",\n",
        "    \".ipynb_checkpoints\",\n",
        "    \"__pycache__\",\n",
        "    \"site-packages\",\n",
        "    \"node_modules\",\n",
        "    \".cache\"\n",
        "}\n",
        "\n",
        "MAX_SIZE = 20 * 1024 * 1024\n",
        "MAX_CONTEXT = 4\n",
        "MAX_MATCHES = 25\n",
        "\n",
        "scanned = []\n",
        "candidates = []\n",
        "skipped = []\n",
        "\n",
        "print(\"=\" * 100)\n",
        "print(\"EXPERIMENT 20 — STEP 3.3.18 EXPANDED GOOGLE DRIVE SOURCE SEARCH\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "for directory, subdirs, filenames in __import__(\"os\").walk(ROOT):\n",
        "    subdirs[:] = [\n",
        "        d for d in subdirs\n",
        "        if d.lower() not in EXCLUDED_DIRS\n",
        "        and not d.startswith(\".\")\n",
        "    ]\n",
        "\n",
        "    directory = Path(directory)\n",
        "\n",
        "    for filename in filenames:\n",
        "        path = directory / filename\n",
        "\n",
        "        if path.suffix.lower() not in {\".py\", \".ipynb\"}:\n",
        "            continue\n",
        "\n",
        "        try:\n",
        "            size = path.stat().st_size\n",
        "\n",
        "            if size > MAX_SIZE:\n",
        "                skipped.append({\n",
        "                    \"file\": str(path),\n",
        "                    \"reason\": \"File exceeds size limit\"\n",
        "                })\n",
        "                continue\n",
        "\n",
        "            raw = path.read_bytes()\n",
        "            digest = hashlib.sha256(raw).hexdigest()\n",
        "\n",
        "            if path.suffix.lower() == \".ipynb\":\n",
        "                notebook = json.loads(raw.decode(\"utf-8\"))\n",
        "                lines = []\n",
        "\n",
        "                for cell_index, cell in enumerate(\n",
        "                    notebook.get(\"cells\", [])\n",
        "                ):\n",
        "                    if cell.get(\"cell_type\") not in {\"code\", \"markdown\"}:\n",
        "                        continue\n",
        "\n",
        "                    source = cell.get(\"source\", [])\n",
        "                    if isinstance(source, list):\n",
        "                        source = \"\".join(source)\n",
        "\n",
        "                    lines.append(\n",
        "                        f\"# CELL {cell_index} \"\n",
        "                        f\"({cell.get('cell_type')})\"\n",
        "                    )\n",
        "                    lines.extend(source.splitlines())\n",
        "\n",
        "            else:\n",
        "                lines = raw.decode(\n",
        "                    \"utf-8\", errors=\"replace\"\n",
        "                ).splitlines()\n",
        "\n",
        "            scanned.append({\n",
        "                \"file\": str(path),\n",
        "                \"size_bytes\": size,\n",
        "                \"sha256\": digest\n",
        "            })\n",
        "\n",
        "            file_matches = []\n",
        "\n",
        "            for index, line in enumerate(lines):\n",
        "                matched = [\n",
        "                    term for term, pattern in zip(TARGETS, patterns)\n",
        "                    if pattern.search(line)\n",
        "                ]\n",
        "\n",
        "                if not matched:\n",
        "                    continue\n",
        "\n",
        "                start = max(0, index - MAX_CONTEXT)\n",
        "                end = min(len(lines), index + MAX_CONTEXT + 1)\n",
        "\n",
        "                file_matches.append({\n",
        "                    \"line_number\": index + 1,\n",
        "                    \"matched_terms\": matched,\n",
        "                    \"context\": [\n",
        "                        {\n",
        "                            \"line_number\": j + 1,\n",
        "                            \"text\": lines[j]\n",
        "                        }\n",
        "                        for j in range(start, end)\n",
        "                    ]\n",
        "                })\n",
        "\n",
        "                if len(file_matches) >= MAX_MATCHES:\n",
        "                    break\n",
        "\n",
        "            if file_matches:\n",
        "                candidates.append({\n",
        "                    \"file\": str(path),\n",
        "                    \"sha256\": digest,\n",
        "                    \"matches\": file_matches\n",
        "                })\n",
        "\n",
        "        except Exception as exc:\n",
        "            skipped.append({\n",
        "                \"file\": str(path),\n",
        "                \"reason\": repr(exc)\n",
        "            })\n",
        "\n",
        "print(\"\\n1. SEARCH SUMMARY\")\n",
        "print(\"-\" * 100)\n",
        "print(\"Google Drive root:\", ROOT)\n",
        "print(\"Python/notebook files scanned:\", len(scanned))\n",
        "print(\"Files containing relevant terms:\", len(candidates))\n",
        "print(\"Files skipped or unreadable:\", len(skipped))\n",
        "\n",
        "print(\"\\n2. CANDIDATE SOURCE FILES\")\n",
        "print(\"-\" * 100)\n",
        "\n",
        "for candidate in candidates:\n",
        "    print(\"\\nFILE:\", candidate[\"file\"])\n",
        "    print(\"SHA256:\", candidate[\"sha256\"])\n",
        "\n",
        "    for match_number, record in enumerate(\n",
        "        candidate[\"matches\"], start=1\n",
        "    ):\n",
        "        print(\n",
        "            f\"\\nMatch {match_number} | \"\n",
        "            f\"Line {record['line_number']} | \"\n",
        "            f\"Terms: {', '.join(record['matched_terms'])}\"\n",
        "        )\n",
        "\n",
        "        for context in record[\"context\"]:\n",
        "            print(\n",
        "                f\"{context['line_number']:>6}: \"\n",
        "                f\"{context['text']}\"\n",
        "            )\n",
        "\n",
        "print(\"\\n3. SKIPPED FILES\")\n",
        "print(\"-\" * 100)\n",
        "\n",
        "for item in skipped:\n",
        "    print(item[\"file\"], \"|\", item[\"reason\"])\n",
        "\n",
        "report = {\n",
        "    \"step\": \"3.3.18\",\n",
        "    \"search_root\": str(ROOT),\n",
        "    \"files_scanned\": scanned,\n",
        "    \"candidate_files\": candidates,\n",
        "    \"skipped_files\": skipped,\n",
        "    \"source_files_modified\": False,\n",
        "    \"notebooks_executed\": False,\n",
        "    \"frozen_results_modified\": False\n",
        "}\n",
        "\n",
        "report_path = (\n",
        "    OUTPUT_DIR /\n",
        "    \"experiment20_step3318_expanded_source_search.json\"\n",
        ")\n",
        "\n",
        "with report_path.open(\"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(report, f, indent=2, ensure_ascii=False)\n",
        "\n",
        "print(\"\\n4. SEARCH REPORT\")\n",
        "print(\"-\" * 100)\n",
        "print(\"Saved:\", report_path)\n",
        "print(\"Source files modified: NO\")\n",
        "print(\"Notebooks executed: NO\")\n",
        "print(\"Frozen experimental results modified: NO\")\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"STEP 3.3.18 COMPLETED\")\n",
        "print(\"Send the complete output.\")\n",
        "print(\"=\" * 100)\n"
      ],
      "metadata": {
