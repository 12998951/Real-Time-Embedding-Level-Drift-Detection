      "cell_type": "markdown",
      "source": [
        "## EXPERIMENT 20 — STEP 2.6.9: IMAGE DIMENSION AND PIXEL INTEGRITY AUDIT\n",
        "\n",
        "Inspect PGM image data directly inside the ZIP archive.\n",
        "\n",
        "Objectives:\n",
        "1. Decode all PGM files without extracting them.\n",
        "2. Verify image dimensions.\n",
        "3. Verify grayscale pixel format.\n",
        "4. Record minimum, maximum, and mean pixel intensity.\n",
        "5. Detect unreadable or malformed images.\n",
        "6. Compare image dimensions across subjects and illumination conditions.\n",
        "7. Save a reproducible image-integrity audit.\n",
        "\n",
        "No embeddings will be generated and no source images will be modified."
      ],
      "metadata": {
        "id": "pMov4D8wqoyy"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import os\n",
        "import re\n",
        "import json\n",
        "import zipfile\n",
        "import hashlib\n",
        "import numpy as np\n",
        "from PIL import Image\n",
        "from io import BytesIO\n",
        "from collections import Counter, defaultdict\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "ARCHIVE_PATH = \"/content/Experiment20_Downloads/CroppedYale.zip\"\n",
        "\n",
        "AUDIT_DIR = (\n",
        "    \"/content/drive/MyDrive/Experiment_20_Results/dataset_audit\"\n",
        ")\n",
        "\n",
        "OUTPUT_PATH = os.path.join(\n",
        "    AUDIT_DIR,\n",
        "    \"experiment20_croppedyale_image_integrity_audit.json\"\n",
        ")\n",
        "\n",
        "os.makedirs(AUDIT_DIR, exist_ok=True)\n",
        "\n",
        "print(\"=\" * 75)\n",
        "print(\"EXPERIMENT 20 — STEP 2.6.9: IMAGE INTEGRITY AUDIT\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "results = []\n",
        "errors = []\n",
        "\n",
        "dimension_counts = Counter()\n",
        "mode_counts = Counter()\n",
        "subject_dimensions = defaultdict(Counter)\n",
        "\n",
        "with zipfile.ZipFile(ARCHIVE_PATH, \"r\") as archive:\n",
        "\n",
        "    pgm_files = [\n",
        "        name for name in archive.namelist()\n",
        "        if name.lower().endswith(\".pgm\")\n",
        "    ]\n",
        "\n",
        "    print(\"\\n[1] DECODING PGM IMAGES\")\n",
        "    print(\"Total PGM files:\", len(pgm_files))\n",
        "\n",
        "    for index, path in enumerate(pgm_files, start=1):\n",
        "\n",
        "        try:\n",
        "            image_bytes = archive.read(path)\n",
        "\n",
        "            with Image.open(BytesIO(image_bytes)) as image:\n",
        "                image.load()\n",
        "\n",
        "                width, height = image.size\n",
        "                mode = image.mode\n",
        "\n",
        "                pixels = np.asarray(image)\n",
        "\n",
        "                if pixels.ndim == 2:\n",
        "                    grayscale = True\n",
        "                    pixel_min = int(pixels.min())\n",
        "                    pixel_max = int(pixels.max())\n",
        "                    pixel_mean = float(pixels.mean())\n",
        "                else:\n",
        "                    grayscale = False\n",
        "                    pixel_min = int(pixels.min())\n",
        "                    pixel_max = int(pixels.max())\n",
        "                    pixel_mean = float(pixels.mean())\n",
        "\n",
        "                subject_match = re.search(\n",
        "                    r\"(yaleB\\d+)\",\n",
        "                    path,\n",
        "                    re.IGNORECASE\n",
        "                )\n",
        "\n",
        "                subject = (\n",
        "                    subject_match.group(1)\n",
        "                    if subject_match else \"UNKNOWN\"\n",
        "                )\n",
        "\n",
        "                dimension_counts[(width, height)] += 1\n",
        "                mode_counts[mode] += 1\n",
        "                subject_dimensions[subject][(width, height)] += 1\n",
        "\n",
        "                results.append({\n",
        "                    \"path\": path,\n",
        "                    \"subject\": subject,\n",
        "                    \"width\": width,\n",
        "                    \"height\": height,\n",
        "                    \"mode\": mode,\n",
        "                    \"grayscale\": grayscale,\n",
        "                    \"pixel_min\": pixel_min,\n",
        "                    \"pixel_max\": pixel_max,\n",
        "                    \"pixel_mean\": pixel_mean,\n",
        "                    \"file_bytes\": len(image_bytes)\n",
        "                })\n",
        "\n",
        "        except Exception as exc:\n",
        "            errors.append({\n",
        "                \"path\": path,\n",
        "                \"error\": repr(exc)\n",
        "            })\n",
        "\n",
        "        if index % 250 == 0:\n",
        "            print(f\"Processed {index}/{len(pgm_files)} images\")\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 2. DIMENSION AND MODE SUMMARY\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"\\n[2] IMAGE DIMENSIONS\")\n",
        "\n",
        "for dimensions, count in sorted(dimension_counts.items()):\n",
        "    print(dimensions, \":\", count)\n",
        "\n",
        "print(\"\\n[3] IMAGE MODES\")\n",
        "\n",
        "for mode, count in sorted(mode_counts.items()):\n",
        "    print(mode, \":\", count)\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 3. GRAYSCALE AND PIXEL RANGE\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "grayscale_count = sum(\n",
        "    1 for item in results if item[\"grayscale\"]\n",
        ")\n",
        "\n",
        "pixel_ranges = Counter(\n",
        "    (item[\"pixel_min\"], item[\"pixel_max\"])\n",
        "    for item in results\n",
        ")\n",
        "\n",
        "print(\"\\n[4] PIXEL INTEGRITY\")\n",
        "print(\"Successfully decoded:\", len(results))\n",
        "print(\"Decode failures:\", len(errors))\n",
        "print(\"Grayscale images:\", grayscale_count)\n",
        "\n",
        "print(\"Observed pixel min/max combinations:\")\n",
        "for pixel_range, count in sorted(pixel_ranges.items()):\n",
        "    print(pixel_range, \":\", count)\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 4. SUBJECT DIMENSION CONSISTENCY\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"\\n[5] SUBJECT DIMENSION CONSISTENCY\")\n",
        "\n",
        "subject_dimension_summary = {}\n",
        "\n",
        "for subject, counts in sorted(subject_dimensions.items()):\n",
        "\n",
        "    subject_dimension_summary[subject] = {\n",
        "        f\"{width}x{height}\": count\n",
        "        for (width, height), count in counts.items()\n",
        "    }\n",
        "\n",
        "    print(subject, subject_dimension_summary[subject])\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 5. GLOBAL PIXEL STATISTICS\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "means = [item[\"pixel_mean\"] for item in results]\n",
        "\n",
        "global_statistics = {\n",
        "    \"mean_of_image_means\": float(np.mean(means)) if means else None,\n",
        "    \"median_of_image_means\": float(np.median(means)) if means else None,\n",
        "    \"minimum_image_mean\": float(np.min(means)) if means else None,\n",
        "    \"maximum_image_mean\": float(np.max(means)) if means else None\n",
        "}\n",
        "\n",
        "print(\"\\n[6] GLOBAL INTENSITY STATISTICS\")\n",
        "print(global_statistics)\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 6. SAVE AUDIT\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "audit = {\n",
        "    \"step\": \"2.6.9\",\n",
        "    \"timestamp_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "    \"archive_path\": ARCHIVE_PATH,\n",
        "    \"total_pgm_files\": len(pgm_files),\n",
        "    \"successfully_decoded\": len(results),\n",
        "    \"decode_failures\": len(errors),\n",
        "    \"decode_error_details\": errors,\n",
        "    \"dimension_counts\": {\n",
        "        f\"{width}x{height}\": count\n",
        "        for (width, height), count in dimension_counts.items()\n",
        "    },\n",
        "    \"image_mode_counts\": dict(mode_counts),\n",
        "    \"grayscale_image_count\": grayscale_count,\n",
        "    \"non_grayscale_image_count\": len(results) - grayscale_count,\n",
        "    \"pixel_range_counts\": {\n",
        "        f\"{minimum}-{maximum}\": count\n",
        "        for (minimum, maximum), count in pixel_ranges.items()\n",
        "    },\n",
        "    \"subject_dimension_summary\": subject_dimension_summary,\n",
        "    \"global_intensity_statistics\": global_statistics,\n",
        "    \"acceptance_status\": \"PENDING_MODEL_COMPATIBILITY_REVIEW\"\n",
        "}\n",
        "\n",
        "with open(OUTPUT_PATH, \"w\") as f:\n",
        "    json.dump(audit, f, indent=2)\n",
        "\n",
        "print(\"\\n[7] AUDIT SAVED\")\n",
        "print(OUTPUT_PATH)\n",
        "\n",
        "print(\"\\nIMAGE INTEGRITY AUDIT COMPLETE.\")\n",
        "print(\"No extraction or embedding generation performed.\")"
      ],
