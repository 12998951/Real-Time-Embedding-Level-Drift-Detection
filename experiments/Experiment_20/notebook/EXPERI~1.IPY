      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# EXPERIMENT 20 — PHASE 3.4\n",
        "# RESULTS AND STATISTICAL INTERPRETATION AUDIT\n",
        "# READ-ONLY — NO MANUSCRIPT OR EVIDENCE MODIFICATIONS\n",
        "# ============================================================\n",
        "\n",
        "import os\n",
        "import re\n",
        "import json\n",
        "import hashlib\n",
        "import pandas as pd\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "BASE = \"/content/drive/MyDrive/Experiment_20_Results\"\n",
        "\n",
        "MANUSCRIPT = os.path.join(\n",
        "    BASE, \"step_3_3\", \"step_3330\",\n",
        "    \"experiment20_integrated_manuscript_v2.md\"\n",
        ")\n",
        "\n",
        "FREEZE = os.path.join(\n",
        "    BASE, \"step_2_7\", \"final_freeze\"\n",
        ")\n",
        "\n",
        "OUTPUT_DIR = os.path.join(\n",
        "    BASE, \"step_3_4_results_interpretation\"\n",
        ")\n",
        "os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
        "\n",
        "REPORT_PATH = os.path.join(\n",
        "    OUTPUT_DIR,\n",
        "    \"experiment20_phase34_results_statistical_interpretation_audit.json\"\n",
        ")\n",
        "\n",
        "EXPECTED_MANUSCRIPT_HASH = (\n",
        "    \"2cc4156af63987fae717c37e997e6478e4253d81f584854fb5fab9f18da5e752\"\n",
        ")\n",
        "\n",
        "\n",
        "def sha256_file(path):\n",
        "    h = hashlib.sha256()\n",
        "    with open(path, \"rb\") as f:\n",
        "        for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n",
        "            h.update(chunk)\n",
        "    return h.hexdigest()\n",
        "\n",
        "\n",
        "def section_extract(text, start_pattern, end_pattern=None):\n",
        "    start = re.search(start_pattern, text, flags=re.I | re.M)\n",
        "\n",
        "    if not start:\n",
        "        return None\n",
        "\n",
        "    remaining = text[start.start():]\n",
        "\n",
        "    if end_pattern:\n",
        "        end = re.search(\n",
        "            end_pattern,\n",
        "            remaining[start.end() - start.start():],\n",
        "            flags=re.I | re.M\n",
        "        )\n",
        "\n",
        "        if end:\n",
        "            return remaining[:start.end() - start.start() + end.start()]\n",
        "\n",
        "    return remaining\n",
        "\n",
        "\n",
        "print(\"=\" * 100)\n",
        "print(\"EXPERIMENT 20 — PHASE 3.4\")\n",
        "print(\"RESULTS AND STATISTICAL INTERPRETATION AUDIT\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. LOAD MANUSCRIPT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "assert os.path.isfile(MANUSCRIPT), \"Integrated manuscript v2 not found.\"\n",
        "\n",
        "with open(MANUSCRIPT, \"r\", encoding=\"utf-8\") as f:\n",
        "    manuscript = f.read()\n",
        "\n",
        "manuscript_hash = sha256_file(MANUSCRIPT)\n",
        "\n",
        "assert manuscript_hash == EXPECTED_MANUSCRIPT_HASH, (\n",
        "    \"Manuscript hash differs from the verified Section 3.3 version. \"\n",
        "    \"Stop and investigate before continuing.\"\n",
        ")\n",
        "\n",
        "print(\"\\nManuscript:\", MANUSCRIPT)\n",
        "print(\"SHA256:\", manuscript_hash)\n",
        "print(\"Word count:\", len(manuscript.split()))\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. EXTRACT RESULTS SECTION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "results_match = re.search(\n",
        "    r\"^#{1,3}\\s*3\\.\\s*Results\\b.*$\",\n",
        "    manuscript,\n",
        "    flags=re.I | re.M\n",
        ")\n",
        "\n",
        "if not results_match:\n",
        "    results_match = re.search(\n",
        "        r\"^#{1,3}\\s*Results\\b.*$\",\n",
        "        manuscript,\n",
        "        flags=re.I | re.M\n",
        "    )\n",
        "\n",
        "assert results_match, \"Results section heading not found.\"\n",
        "\n",
        "results_start = results_match.start()\n",
        "\n",
        "next_major_section = re.search(\n",
        "    r\"^#{1,3}\\s*(?:4\\.|Discussion)\\b\",\n",
        "    manuscript[results_start + 1:],\n",
        "    flags=re.I | re.M\n",
        ")\n",
        "\n",
        "results_end = (\n",
        "    results_start + 1 + next_major_section.start()\n",
        "    if next_major_section\n",
        "    else len(manuscript)\n",
        ")\n",
        "\n",
        "results_text = manuscript[results_start:results_end]\n",
        "\n",
        "print(\"\\nResults section extracted.\")\n",
        "print(\"Results word count:\", len(results_text.split()))\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. LOAD FROZEN STATISTICAL EVIDENCE\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "files = {\n",
        "    \"group_descriptive\": os.path.join(\n",
        "        FREEZE,\n",
        "        \"experiment20_illumination_group_descriptive_statistics.csv\"\n",
        "    ),\n",
        "    \"paired_comparisons\": os.path.join(\n",
        "        FREEZE,\n",
        "        \"experiment20_paired_comparison_results.csv\"\n",
        "    ),\n",
        "    \"hemisphere_comparisons\": os.path.join(\n",
        "        FREEZE,\n",
        "        \"experiment20_hemisphere_comparison_results.csv\"\n",
        "    ),\n",
        "    \"identity_group_means\": os.path.join(\n",
        "        FREEZE,\n",
        "        \"experiment20_identity_level_group_means.csv\"\n",
        "    ),\n",
        "    \"identity_hemisphere_means\": os.path.join(\n",
        "        FREEZE,\n",
        "        \"experiment20_identity_level_hemisphere_means.csv\"\n",
        "    )\n",
        "}\n",
        "\n",
        "data = {}\n",
        "file_inventory = {}\n",
        "\n",
        "for name, path in files.items():\n",
        "\n",
        "    if os.path.isfile(path):\n",
        "\n",
        "        df = pd.read_csv(path)\n",
        "        data[name] = df\n",
        "\n",
        "        file_inventory[name] = {\n",
        "            \"exists\": True,\n",
        "            \"path\": path,\n",
        "            \"sha256\": sha256_file(path),\n",
        "            \"rows\": len(df),\n",
        "            \"columns\": list(df.columns)\n",
        "        }\n",
        "\n",
        "    else:\n",
        "        file_inventory[name] = {\n",
        "            \"exists\": False,\n",
        "            \"path\": path\n",
        "        }\n",
        "\n",
        "print(\"\\nFROZEN EVIDENCE INVENTORY\")\n",
        "\n",
        "for name, record in file_inventory.items():\n",
        "    print(\n",
        "        name,\n",
        "        \"FOUND\" if record[\"exists\"] else \"MISSING\",\n",
        "        record.get(\"rows\", \"\")\n",
        "    )\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. CHECK RESULTS REPORTING COMPLETENESS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "result_checks = {\n",
        "    \"cohort_reporting\": {\n",
        "        \"source_image_count\": \"2,414\" in results_text,\n",
        "        \"evaluation_observations\": \"2,128\" in results_text,\n",
        "        \"evaluation_conditions\": \"56\" in results_text,\n",
        "        \"identity_count\": \"38\" in results_text,\n",
        "        \"reference_observations\": \"reference\" in results_text.lower()\n",
        "    },\n",
        "\n",
        "    \"descriptive_statistics\": {\n",
        "        \"euclidean_results\": \"Euclidean\" in results_text,\n",
        "        \"cosine_results\": \"cosine\" in results_text.lower(),\n",
        "        \"near_frontal_group\": \"near-frontal\" in results_text.lower(),\n",
        "        \"oblique_group\": \"oblique\" in results_text.lower(),\n",
        "        \"large_angular_group\": (\n",
        "            \"large-angular\" in results_text.lower()\n",
        "        )\n",
        "    },\n",
        "\n",
        "    \"inferential_statistics\": {\n",
        "        \"friedman_test\": \"Friedman\" in results_text,\n",
        "        \"kendall_w\": \"Kendall\" in results_text,\n",
        "        \"wilcoxon_test\": \"Wilcoxon\" in results_text,\n",
        "        \"holm_correction\": \"Holm\" in results_text,\n",
        "        \"bootstrap_confidence_intervals\": (\n",
        "            \"confidence interval\" in results_text.lower()\n",
        "            or \"95% CI\" in results_text\n",
        "        )\n",
        "    },\n",
        "\n",
        "    \"hemisphere_analysis\": {\n",
        "        \"frontal_comparison\": \"frontal\" in results_text.lower(),\n",
        "        \"beyond_frontal_comparison\": (\n",
        "            \"beyond-frontal\" in results_text.lower()\n",
        "        ),\n",
        "        \"exploratory_label\": \"exploratory\" in results_text.lower()\n",
        "    }\n",
        "}\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. CROSS-CHECK FROZEN RESULTS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "source_checks = {}\n",
        "\n",
        "if \"group_descriptive\" in data:\n",
        "\n",
        "    df = data[\"group_descriptive\"]\n",
        "\n",
        "    source_checks[\"group_descriptive\"] = {\n",
        "        \"six_metric_rows\": len(df) == 6,\n",
        "        \"three_groups\": (\n",
        "            df[\"illumination_group\"].nunique() == 3\n",
        "        ),\n",
        "        \"all_groups_have_38_identities\": (\n",
        "            df[\"identities\"].eq(38).all()\n",
        "        ),\n",
        "        \"all_observation_counts_present\": (\n",
        "            df[\"observations\"].notna().all()\n",
        "        )\n",
        "    }\n",
        "\n",
        "if \"paired_comparisons\" in data:\n",
        "\n",
        "    df = data[\"paired_comparisons\"]\n",
        "\n",
        "    source_checks[\"paired_comparisons\"] = {\n",
        "        \"six_pairwise_comparisons\": len(df) == 6,\n",
        "        \"38_identities_per_comparison\": (\n",
        "            df[\"identities\"].eq(38).all()\n",
        "        ),\n",
        "        \"bootstrap_iterations_20000\": (\n",
        "            df[\"bootstrap_iterations\"].eq(20000).all()\n",
        "        ),\n",
        "        \"raw_p_values_present\": (\n",
        "            df[\"raw_p_value\"].notna().all()\n",
        "        ),\n",
        "        \"confidence_intervals_present\": (\n",
        "            df[\"ci_95_lower\"].notna().all()\n",
        "            and df[\"ci_95_upper\"].notna().all()\n",
        "        )\n",
        "    }\n",
        "\n",
        "if \"hemisphere_comparisons\" in data:\n",
        "\n",
        "    df = data[\"hemisphere_comparisons\"]\n",
        "\n",
        "    source_checks[\"hemisphere_comparisons\"] = {\n",
        "        \"two_metric_comparisons\": len(df) == 2,\n",
        "        \"38_identities_per_comparison\": (\n",
        "            df[\"identities\"].eq(38).all()\n",
        "        ),\n",
        "        \"bootstrap_iterations_20000\": (\n",
        "            df[\"bootstrap_iterations\"].eq(20000).all()\n",
        "        ),\n",
        "        \"confidence_intervals_present\": (\n",
        "            df[\"ci_95_lower\"].notna().all()\n",
        "            and df[\"ci_95_upper\"].notna().all()\n",
        "        )\n",
        "    }\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. CHECK STATISTICAL INTERPRETATION BOUNDARIES\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "interpretation_checks = {\n",
        "    \"euclidean_cosine_relationship\": (\n",
        "        \"mathematically\" in manuscript.lower()\n",
        "        and \"cosine\" in manuscript.lower()\n",
        "        and \"euclidean\" in manuscript.lower()\n",
        "    ),\n",
        "\n",
        "    \"no_recognition_accuracy_overclaim\": (\n",
        "        \"do not establish recognition accuracy\" in manuscript.lower()\n",
        "    ),\n",
        "\n",
        "    \"no_operational_drift_overclaim\": (\n",
        "        \"operational drift-detection\" in manuscript.lower()\n",
        "    ),\n",
        "\n",
        "    \"hemisphere_not_causal\": (\n",
        "        \"isolated causal effect\" in manuscript.lower()\n",
        "    ),\n",
        "\n",
        "    \"hemisphere_exploratory\": (\n",
        "        \"This comparison is exploratory\" in manuscript\n",
        "    ),\n",
        "\n",
        "    \"no_cross_architecture_generalisation_claim\": (\n",
        "        \"generalisation across architectures\" in manuscript.lower()\n",
        "    ),\n",
        "\n",
        "    \"no_fairness_claim\": (\n",
        "        \"does not establish verification accuracy, fairness\" in manuscript.lower()\n",
        "    )\n",
        "}\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. IDENTIFY REPORTING ISSUES\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "issues = []\n",
        "\n",
        "for category, checks in result_checks.items():\n",
        "    for check_name, passed in checks.items():\n",
        "        if not passed:\n",
        "            issues.append({\n",
        "                \"category\": category,\n",
        "                \"issue\": check_name,\n",
        "                \"type\": \"RESULTS_REPORTING_REVIEW\"\n",
        "            })\n",
        "\n",
        "for category, checks in source_checks.items():\n",
        "    for check_name, passed in checks.items():\n",
        "        if not passed:\n",
        "            issues.append({\n",
        "                \"category\": category,\n",
        "                \"issue\": check_name,\n",
        "                \"type\": \"SOURCE_DATA_VERIFICATION\"\n",
        "            })\n",
        "\n",
        "for check_name, passed in interpretation_checks.items():\n",
        "    if not passed:\n",
        "        issues.append({\n",
        "            \"category\": \"scientific_interpretation\",\n",
        "            \"issue\": check_name,\n",
        "            \"type\": \"INTERPRETATION_REVIEW\"\n",
        "        })\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 8. BUILD AUDIT REPORT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "report = {\n",
        "    \"phase\": \"3.4\",\n",
        "    \"title\": \"Results and Statistical Interpretation Audit\",\n",
        "    \"created_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "\n",
        "    \"manuscript\": {\n",
