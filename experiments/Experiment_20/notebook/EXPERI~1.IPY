      "cell_type": "markdown",
      "source": [
        "# Experiment 20 — Step 3.2.7\n",
        "## Frozen ZIP Content and Source-Image Recovery Audit\n",
        "\n",
        "### Objective\n",
        "Determine why the frozen dataset ZIP contains no image files\n",
        "and whether the original Cropped Yale B images remain available.\n",
        "\n",
        "### Inspection\n",
        "1. List every ZIP entry and its file size.\n",
        "2. Inspect the freeze manifest and dataset README.\n",
        "3. Search the Experiment 20 results directory for image archives\n",
        "   and extracted image directories.\n",
        "4. Identify whether the original source archive remains available.\n",
        "5. Compare the discovered files with the 2,414 embedding filenames.\n",
        "\n",
        "### Restrictions\n",
        "- Read-only inspection.\n",
        "- No extraction or modification.\n",
        "- No downloads.\n",
        "- No package installations.\n",
        "- No embedding regeneration.\n",
        "\n",
        "### Decision\n",
        "Do not begin additional model evaluation until the original\n",
        "image cohort is recoverable and its provenance is established."
      ],
      "metadata": {
        "id": "5s6nUgBm2wAp"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from pathlib import Path\n",
        "from zipfile import ZipFile\n",
        "import json\n",
        "import os\n",
        "\n",
        "BASE = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "\n",
        "ZIP_FILE = BASE / \"Experiment_20_Stage_2_Frozen_Dataset.zip\"\n",
        "MANIFEST_FILE = BASE / \"Experiment_20_Stage_2_Freeze_Manifest.json\"\n",
        "NPZ_FILE = BASE / \"embeddings/experiment20_croppedyale_facenet_embeddings.npz\"\n",
        "\n",
        "print(\"=\" * 90)\n",
        "print(\"EXPERIMENT 20 — STEP 3.2.7\")\n",
        "print(\"FROZEN ZIP CONTENT AND SOURCE-IMAGE RECOVERY AUDIT\")\n",
        "print(\"=\" * 90)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. Complete ZIP inventory\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n[1] COMPLETE FROZEN ZIP INVENTORY\")\n",
        "\n",
        "with ZipFile(ZIP_FILE, \"r\") as archive:\n",
        "    entries = archive.infolist()\n",
        "\n",
        "    for entry in entries:\n",
        "        print(\n",
        "            f\"{entry.file_size:>12,} bytes | \"\n",
        "            f\"{entry.filename}\"\n",
        "        )\n",
        "\n",
        "    print(\"\\nTotal entries:\", len(entries))\n",
        "    print(\"Total uncompressed MB:\",\n",
        "          round(sum(e.file_size for e in entries) / (1024 ** 2), 2))\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. Inspect freeze manifest\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n[2] FREEZE MANIFEST\")\n",
        "\n",
        "with open(MANIFEST_FILE, \"r\") as f:\n",
        "    manifest = json.load(f)\n",
        "\n",
        "print(json.dumps(manifest, indent=2)[:15000])\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. Inspect ZIP documentation files\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n[3] ZIP DOCUMENTATION\")\n",
        "\n",
        "with ZipFile(ZIP_FILE, \"r\") as archive:\n",
        "    text_files = [\n",
        "        name for name in archive.namelist()\n",
        "        if name.lower().endswith((\".md\", \".txt\", \".json\"))\n",
        "    ]\n",
        "\n",
        "    for name in text_files:\n",
        "        print(f\"\\n--- {name} ---\")\n",
        "\n",
        "        try:\n",
        "            content = archive.read(name).decode(\"utf-8\", errors=\"replace\")\n",
        "            print(content[:5000])\n",
        "        except Exception as exc:\n",
        "            print(\"Could not read:\", repr(exc))\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. Search Experiment 20 directory\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n[4] EXPERIMENT 20 IMAGE AND ARCHIVE INVENTORY\")\n",
        "\n",
        "image_extensions = {\n",
        "    \".pgm\", \".png\", \".jpg\", \".jpeg\", \".bmp\", \".tif\", \".tiff\"\n",
        "}\n",
        "\n",
        "archive_extensions = {\n",
        "    \".zip\", \".tar\", \".gz\", \".7z\", \".rar\"\n",
        "}\n",
        "\n",
        "image_files = []\n",
        "archive_files = []\n",
        "candidate_directories = []\n",
        "\n",
        "for root, dirs, files in os.walk(BASE):\n",
        "    current = Path(root)\n",
        "\n",
        "    # Avoid excessively large traversal into unrelated folders.\n",
        "    dirs[:] = [\n",
        "        d for d in dirs\n",
        "        if d not in {\".git\", \"__pycache__\"}\n",
        "    ]\n",
        "\n",
        "    for filename in files:\n",
        "        path = current / filename\n",
        "\n",
        "        if path.suffix.lower() in image_extensions:\n",
        "            image_files.append(path)\n",
        "\n",
        "        if path.suffix.lower() in archive_extensions:\n",
        "            archive_files.append(path)\n",
        "\n",
        "    for dirname in dirs:\n",
        "        lower = dirname.lower()\n",
        "\n",
        "        if any(term in lower for term in [\"yale\", \"image\", \"dataset\", \"crop\"]):\n",
        "            candidate_directories.append(current / dirname)\n",
        "\n",
        "print(\"Image files found:\", len(image_files))\n",
        "print(\"Archive files found:\", len(archive_files))\n",
        "\n",
        "print(\"\\nImage file examples:\")\n",
        "for path in image_files[:30]:\n",
        "    print(path)\n",
        "\n",
        "print(\"\\nArchive files:\")\n",
        "for path in archive_files:\n",
        "    print(path, \"size MB:\",\n",
        "          round(path.stat().st_size / (1024 ** 2), 2))\n",
        "\n",
        "print(\"\\nCandidate directories:\")\n",
        "for path in candidate_directories[:50]:\n",
        "    print(path)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. Inspect likely source archive names and sizes\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n[5] SOURCE ARCHIVE CANDIDATES\")\n",
        "\n",
        "for path in archive_files:\n",
        "    if path.name != ZIP_FILE.name:\n",
        "        print({\n",
        "            \"path\": str(path),\n",
        "            \"size_bytes\": path.stat().st_size,\n",
        "            \"size_mb\": round(path.stat().st_size / (1024 ** 2), 2)\n",
        "        })\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. Inspect embedding filenames\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n[6] EXPECTED IMAGE FILENAMES\")\n",
        "\n",
        "import numpy as np\n",
        "\n",
        "data = np.load(NPZ_FILE, allow_pickle=False)\n",
        "filenames = data[\"filenames\"].astype(str)\n",
        "\n",
        "print(\"Expected filenames:\", len(filenames))\n",
        "\n",
        "for filename in filenames[:20]:\n",
        "    print(filename)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. Final assessment\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 90)\n",
        "print(\"STEP 3.2.7 SUMMARY\")\n",
        "print(\"=\" * 90)\n",
        "\n",
        "print(\"Frozen ZIP:\", ZIP_FILE.exists())\n",
        "print(\"ZIP entries:\", len(entries))\n",
        "print(\"Image files in Experiment 20 directory:\", len(image_files))\n",
        "print(\"Other archives:\", len(archive_files))\n",
        "print(\"Source-image recovery status: REQUIRES REVIEW\")\n",
        "\n",
        "print(\"\\nNo files extracted.\")\n",
        "print(\"No files modified.\")\n",
        "print(\"No downloads performed.\")\n",
        "print(\"=\" * 90)"
      ],
