            "import sys\n",
            "import torch\n",
            "import torchvision\n",
            "import numpy as np\n",
            "import PIL\n",
            "\n",
            "print(\"Python version:\", sys.version)\n",
            "print(\"PyTorch version:\", torch.__version__)\n",
            "print(\"Torchvision version:\", torchvision.__version__)\n",
            "print(\"NumPy version:\", np.__version__)\n",
            "print(\"Pillow version:\", PIL.__version__)\n",
            "\n",
            "print(\"\\nInstalling FaceNet library...\")\n",
            "\n",
            "!pip install facenet-pytorch==2.6.0 --no-deps\n",
            "\n",
            "print(\"\\nEnvironment verification completed.\")\n",
            "\n",
            "CELL INDEX: 4\n",
            "MATCH CATEGORIES: model_initialization, software_versions\n",
            "SOURCE CODE:\n",
            "import torch\n",
            "import torchvision\n",
            "from facenet_pytorch import MTCNN, InceptionResnetV1\n",
            "\n",
            "# Configure execution device\n",
            "device = torch.device(\"cpu\")\n",
            "\n",
            "# Initialise MTCNN face detector\n",
            "mtcnn = MTCNN(\n",
            "    image_size=160,\n",
            "    margin=0,\n",
            "    keep_all=False,\n",
            "    device=device\n",
            ")\n",
            "\n",
            "# Load pretrained FaceNet model\n",
            "facenet = InceptionResnetV1(\n",
            "    pretrained=\"vggface2\"\n",
            ").eval().to(device)\n",
            "\n",
            "# Verify model configuration\n",
            "print(\"MTCNN initialised successfully.\")\n",
            "print(\"FaceNet model initialised successfully.\")\n",
            "print(\"Pretrained weights: VGGFace2\")\n",
            "print(\"Execution device:\", device)\n",
            "print(\"Embedding dimension:\", facenet.last_linear.out_features)\n",
            "\n",
            "CELL INDEX: 22\n",
            "MATCH CATEGORIES: model_initialization\n",
            "SOURCE CODE:\n",
            "import numpy as np\n",
            "import json\n",
            "from pathlib import Path\n",
            "\n",
            "output_dir = Path(\"/content/experiment18_results\")\n",
            "output_dir.mkdir(parents=True, exist_ok=True)\n",
            "\n",
            "archive_path = output_dir / \"experiment18_facenet_lfw_embeddings.npz\"\n",
            "\n",
            "np.savez_compressed(\n",
            "    archive_path,\n",
            "\n",
            "    reference_embeddings=reference_embeddings,\n",
            "    reference_labels=reference_labels,\n",
            "\n",
            "    calibration_embeddings=calibration_embeddings,\n",
            "    calibration_labels=calibration_labels,\n",
            "\n",
            "    evaluation_embeddings=evaluation_embeddings,\n",
            "    evaluation_labels=evaluation_labels,\n",
            "\n",
            "    reference_failures=np.array(reference_failures),\n",
            "    calibration_failures=np.array(calibration_failures),\n",
            "    evaluation_failures=np.array(evaluation_failures),\n",
            "\n",
            "    random_seed=np.array(42),\n",
            "    model=np.array(\"InceptionResnetV1\"),\n",
            "    pretrained_weights=np.array(\"VGGFace2\"),\n",
            "    dataset=np.array(\"LFW\"),\n",
            "    embedding_dimension=np.array(512)\n",
            ")\n",
