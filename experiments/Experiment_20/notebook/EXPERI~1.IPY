        "\n",
        "record = {\n",
        "    \"experiment\": \"Experiment 20\",\n",
        "    \"step\": \"3.2.12\",\n",
        "    \"timestamp_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "\n",
        "    \"objective\": (\n",
        "        \"Assess a possible landmark-detection route after \"\n",
        "        \"the unsuccessful MTCNN feasibility test.\"\n",
        "    ),\n",
        "\n",
        "    \"candidate\": {\n",
        "        \"name\": \"MediaPipe Face Landmarker\",\n",
        "        \"official_documentation\": (\n",
        "            \"https://developers.google.com/edge/mediapipe/\"\n",
        "            \"solutions/vision/face_landmarker\"\n",
        "        ),\n",
        "        \"supports_still_images\": True,\n",
        "        \"documented_landmark_count\": 478,\n",
        "        \"landmark_coordinates\": \"Normalized image coordinates\",\n",
        "        \"python_support\": True,\n",
        "        \"five_point_alignment\": (\n",
        "            \"Potentially derivable from selected dense landmarks; \"\n",
        "            \"not yet implemented or validated.\"\n",
        "        )\n",
        "    },\n",
        "\n",
        "    \"proposed_five_points\": [\n",
        "        \"Left eye\",\n",
        "        \"Right eye\",\n",
        "        \"Nose\",\n",
        "        \"Left mouth corner\",\n",
        "        \"Right mouth corner\"\n",
