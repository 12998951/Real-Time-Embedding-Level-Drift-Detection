', 'yaleB39_P00A-070E+00.pgm', 'yaleB39_P00A-070E+45.pgm', 'yaleB39_P00A-070E-35.pgm', 'yaleB39_P00A-085E+20.pgm', 'yaleB39_P00A-085E-20.pgm', 'yaleB39_P00A-095E+00.pgm', 'yaleB39_P00A-110E+15.pgm', 'yaleB39_P00A-110E+40.pgm', 'yaleB39_P00A-110E+65.pgm', 'yaleB39_P00A-110E-20.pgm', 'yaleB39_P00A-120E+00.pgm', 'yaleB39_P00A-130E+20.pgm', 'yaleB39_P00_Ambient.pgm']\\n\",\"\\n\",\"[7] IMAGE DECODING\\n\",\"Sample images tested: 100\\n\",\"Dimensions: {'(168, 192)': 100}\\n\",\"Modes: {'L': 100}\\n\",\"Decode failures: 0\\n\",\"\\n\",\"[8] COMMON-CONDITION COHORT RECOVERY\\n\",\"Common conditions: 57\\n\",\"Common observations: 2166\\n\",\"Matched common observations: 2166\\n\",\"Evaluation observations: 2128\\n\",\"Matched evaluation observations: 2128\\n\",\"\\n\",\"==========================================================================================\\n\",\"STEP 3.2.8 FINAL AUDIT\\n\",\"==========================================================================================\\n\",\"Nested source archive exists: PASS\\n\",\"Source archive SHA256 matches: PASS\\n\",\"Nested ZIP integrity: PASS\\n\",\"All embedding filenames matched: PASS\\n\",\"All 38 subjects present: PASS\\n\",\"All 2414 images matched: PASS\\n\",\"Sample images decoded: PASS\\n\",\"All 2166 common observations matched: PASS\\n\",\"All 2128 evaluation observations matched: PASS\\n\",\"\\n\",\"Passed: 9 / 9\\n\",\"Permanent extraction: NO\\n\",\"Files modified: NO\\n\",\"Downloads: NO\\n\",\"Embedding regeneration: NO\\n\",\"==========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.2.9\\n\",\"## Full Source Image Integrity and Cohort Verification\\n\",\"\\n\",\"### Objective\\n\",\"Perform a complete image-level integrity check against the\\n\",\"2,414 embedding records using the verified nested source archive.\\n\",\"\\n\",\"### Checks\\n\",\"1. Source archive SHA256.\\n\",\"2. Exactly 38 subject directories.\\n\",\"3. Exactly 2,414 expected standard images.\\n\",\"4. Exactly 38 ambient images excluded from the standard cohort.\\n\",\"5. Every expected image decodes successfully.\\n\",\"6. Every expected image has dimensions 168 × 192.\\n\",\"7. Every expected image is grayscale.\\n\",\"8. All 2,166 common-condition observations are recoverable.\\n\",\"9. All 2,128 evaluation observations are recoverable.\\n\",\"\\n\",\"### Subject parsing correction\\n\",\"Subject identifiers are obtained only from directory components,\\n\",\"not from image filenames.\\n\",\"\\n\",\"### Restrictions\\n\",\"- Read-only source inspection.\\n\",\"- No permanent extraction.\\n\",\"- No downloads or installations.\\n\",\"- No embedding regeneration.\\n\",\"- Existing frozen artifacts remain unchanged.\\n\",\"\\n\",\"### Output\\n\",\"Save a new Step 3.2.9 integrity audit JSON.\"],\"metadata\":{\"id\":\"wvI8G6C23gU8\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"from zipfile import ZipFile\\n\",\"from io import BytesIO\\n\",\"from PIL import Image\\n\",\"from collections import Counter\\n\",\"import numpy as np\\n\",\"import hashlib\\n\",\"import json\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"\\n\",\"OUTER_ZIP = BASE / \\\"Experiment_20_Stage_2_Frozen_Dataset.zip\\\"\\n\",\"NPZ_FILE = BASE / \\\"embeddings/experiment20_croppedyale_facenet_embeddings.npz\\\"\\n\",\"\\n\",\"AUDIT_DIR = BASE / \\\"step_3_2\\\"\\n\",\"AUDIT_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"OUTPUT_FILE = AUDIT_DIR / (\\n\",\"    \\\"experiment20_step329_full_image_integrity_audit.json\\\"\\n\",\")\\n\",\"\\n\",\"SOURCE_MEMBER = (\\n\",\"    \\\"Experiment_20_Stage_2_Frozen_Dataset/source/CroppedYale.zip\\\"\\n\",\")\\n\",\"\\n\",\"EXPECTED_SHA256 = (\\n\",\"    \\\"8bbabf3836d077d60626c9ee3c54c2d2851a8d2c15c8b7e13b9bc162e86ea573\\\"\\n\",\")\\n\",\"\\n\",\"EXPECTED_SUBJECTS = 38\\n\",\"EXPECTED_IMAGES = 2414\\n\",\"EXPECTED_AMBIENT = 38\\n\",\"EXPECTED_COMMON = 2166\\n\",\"EXPECTED_EVALUATION = 2128\\n\",\"\\n\",\"print(\\\"=\\\" * 90)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.2.9\\\")\\n\",\"print(\\\"FULL SOURCE IMAGE INTEGRITY VERIFICATION\\\")\\n\",\"print(\\\"=\\\" * 90)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Load embeddings and metadata\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"data = np.load(NPZ_FILE, allow_pickle=False)\\n\",\"\\n\",\"filenames = data[\\\"filenames\\\"].astype(str)\\n\",\"subjects = data[\\\"subjects\\\"].astype(str)\\n\",\"conditions = data[\\\"conditions\\\"].astype(str)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Load nested archive\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"with ZipFile(OUTER_ZIP, \\\"r\\\") as outer:\\n\",\"    nested_bytes = outer.read(SOURCE_MEMBER)\\n\",\"\\n\",\"actual_sha256 = hashlib.sha256(nested_bytes).hexdigest()\\n\",\"\\n\",\"nested = ZipFile(BytesIO(nested_bytes), \\\"r\\\")\\n\",\"nested_entries = nested.namelist()\\n\",\"\\n\",\"pgm_entries = [\\n\",\"    name for name in nested_entries\\n\",\"    if name.lower().endswith(\\\".pgm\\\")\\n\",\"]\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Correct subject-directory parsing\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"subject_directories = set()\\n\",\"\\n\",\"for name in pgm_entries:\\n\",\"    parts = Path(name).parts\\n\",\"\\n\",\"    for part in parts[:-1]:\\n\",\"        if part.startswith(\\\"yaleB\\\") and len(part) == 7:\\n\",\"            subject_directories.add(part)\\n\",\"\\n\",\"metadata_subjects = set(subjects.tolist())\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Match expected image files\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"archive_by_basename = {\\n\",\"    Path(name).name: name\\n\",\"    for name in pgm_entries\\n\",\"}\\n\",\"\\n\",\"matched = []\\n\",\"unmatched = []\\n\",\"\\n\",\"for filename in filenames:\\n\",\"    basename = Path(filename).name\\n\",\"\\n\",\"    if basename in archive_by_basename:\\n\",\"        matched.append((filename, archive_by_basename[basename]))\\n\",\"    else:\\n\",\"        unmatched.append(filename)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Identify ambient images\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"ambient_entries = [\\n\",\"    name for name in pgm_entries\\n\",\"    if \\\"Ambient\\\" in Path(name).name\\n\",\"]\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. Decode all expected images\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[1] FULL IMAGE DECODING\\\")\\n\",\"\\n\",\"dimension_counts = Counter()\\n\",\"mode_counts = Counter()\\n\",\"decode_failures = []\\n\",\"invalid_dimensions = []\\n\",\"unexpected_modes = []\\n\",\"\\n\",\"for index, (original_filename, archive_filename) in enumerate(matched, 1):\\n\",\"\\n\",\"    try:\\n\",\"        with nested.open(archive_filename) as image_file:\\n\",\"            image = Image.open(image_file)\\n\",\"            image.load()\\n\",\"\\n\",\"            dimension_counts[str(image.size)] += 1\\n\",\"            mode_counts[image.mode] += 1\\n\",\"\\n\",\"            if image.size != (168, 192):\\n\",\"                invalid_dimensions.append({\\n\",\"                    \\\"filename\\\": original_filename,\\n\",\"                    \\\"dimensions\\\": image.size\\n\",\"                })\\n\",\"\\n\",\"            if image.mode != \\\"L\\\":\\n\",\"                unexpected_modes.append({\\n\",\"                    \\\"filename\\\": original_filename,\\n\",\"                    \\\"mode\\\": image.mode\\n\",\"                })\\n\",\"\\n\",\"    except Exception as exc:\\n\",\"        decode_failures.append({\\n\",\"            \\\"filename\\\": original_filename,\\n\",\"            \\\"error\\\": repr(exc)\\n\",\"        })\\n\",\"\\n\",\"    if index % 500 == 0:\\n\",\"        print(f\\\"Decoded: {index}/{len(matched)}\\\")\\n\",\"\\n\",\"print(\\\"Decoded images:\\\", len(matched))\\n\",\"print(\\\"Dimension counts:\\\", dict(dimension_counts))\\n\",\"print(\\\"Mode counts:\\\", dict(mode_counts))\\n\",\"print(\\\"Decode failures:\\\", len(decode_failures))\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. Recheck common-condition cohort\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"unique_subjects = sorted(metadata_subjects)\\n\",\"unique_conditions = sorted(set(conditions.tolist()))\\n\",\"\\n\",\"pair_set = set(zip(subjects.tolist(), conditions.tolist()))\\n\",\"\\n\",\"common_conditions = [\\n\",\"    condition\\n\",\"    for condition in unique_conditions\\n\",\"    if all(\\n\",\"        (subject, condition) in pair_set\\n\",\"        for subject in unique_subjects\\n\",\"    )\\n\",\"]\\n\",\"\\n\",\"common_rows = [\\n\",\"    i for i, condition in enumerate(conditions)\\n\",\"    if condition in common_conditions\\n\",\"]\\n\",\"\\n\",\"evaluation_rows = [\\n\",\"    i for i in common_rows\\n\",\"    if conditions[i] != \\\"A+000E+00\\\"\\n\",\"]\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 8. Build checks\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"checks = {\\n\",\"    \\\"Source SHA256 matches\\\": actual_sha256 == EXPECTED_SHA256,\\n\",\"    \\\"Nested ZIP integrity\\\": nested.testzip() is None,\\n\",\"    \\\"38 subject directories\\\": len(subject_directories) == EXPECTED_SUBJECTS,\\n\",\"    \\\"Subject directories match metadata\\\": subject_directories == metadata_subjects,\\n\",\"    \\\"2414 embedding images matched\\\": len(matched) == EXPECTED_IMAGES,\\n\",\"    \\\"No unmatched embedding images\\\": len(unmatched) == 0,\\n\",\"    \\\"38 ambient images identified\\\": len(ambient_entries) == EXPECTED_AMBIENT,\\n\",\"    \\\"All expected images decoded\\\": len(decode_failures) == 0 and len(matched) == EXPECTED_IMAGES,\\n\",\"    \\\"All images are 168x192\\\": len(invalid_dimensions) == 0,\\n\",\"    \\\"All images are grayscale\\\": len(unexpected_modes) == 0,\\n\",\"    \\\"2166 common observations\\\": len(common_rows) == EXPECTED_COMMON,\\n\",\"    \\\"2128 evaluation observations\\\": len(evaluation_rows) == EXPECTED_EVALUATION\\n\",\"}\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 9. Save audit\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"audit = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"step\\\": \\\"3.2.9\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"source_archive\\\": {\\n\",\"        \\\"outer_package\\\": str(OUTER_ZIP),\\n\",\"        \\\"nested_member\\\": SOURCE_MEMBER,\\n\",\"        \\\"sha256\\\": actual_sha256,\\n\",\"        \\\"expected_sha256\\\": EXPECTED_SHA256,\\n\",\"        \\\"sha256_match\\\": actual_sha256 == EXPECTED_SHA256,\\n\",\"        \\\"nested_entries\\\": len(nested_entries),\\n\",\"        \\\"pgm_entries\\\": len(pgm_entries)\\n\",\"    },\\n\",\"    \\\"cohort\\\": {\\n\",\"        \\\"embedding_records\\\": len(filenames),\\n\",\"        \\\"matched_images\\\": len(matched),\\n\",\"        \\\"unmatched_images\\\": len(unmatched),\\n\",\"        \\\"subject_directories\\\": sorted(subject_directories),\\n\",\"        \\\"subject_directory_count\\\": len(subject_directories),\\n\",\"        \\\"ambient_images\\\": len(ambient_entries),\\n\",\"        \\\"common_conditions\\\": len(common_conditions),\\n\",\"        \\\"common_observations\\\": len(common_rows),\\n\",\"        \\\"evaluation_observations\\\": len(evaluation_rows)\\n\",\"    },\\n\",\"    \\\"image_integrity\\\": {\\n\",\"        \\\"decoded_images\\\": len(matched) - len(decode_failures),\\n\",\"        \\\"dimension_counts\\\": dict(dimension_counts),\\n\",\"        \\\"mode_counts\\\": dict(mode_counts),\\n\",\"        \\\"decode_failures\\\": decode_failures,\\n\",\"        \\\"invalid_dimensions\\\": invalid_dimensions,\\n\",\"        \\\"unexpected_modes\\\": unexpected_modes\\n\",\"    },\\n\",\"    \\\"checks\\\": checks,\\n\",\"    \\\"passed\\\": sum(checks.values()),\\n\",\"    \\\"total_checks\\\": len(checks),\\n\",\"    \\\"status\\\": (\\n\",\"        \\\"FULL_IMAGE_COHORT_VERIFIED\\\"\\n\",\"        if all(checks.values())\\n\",\"        else \\\"REQUIRES_REVIEW\\\"\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"w\\\") as f:\\n\",\"    json.dump(audit, f, indent=2)\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"r\\\") as f:\\n\",\"    reloaded = json.load(f)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 10. Report\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 90)\\n\",\"print(\\\"STEP 3.2.9 FINAL AUDIT\\\")\\n\",\"print(\\\"=\\\" * 90)\\n\",\"\\n\",\"for name, passed in checks.items():\\n\",\"    print(f\\\"{name}: {'PASS' if passed else 'FAIL'}\\\")\\n\",\"\\n\",\"print(\\\"\\\\nPassed:\\\", sum(checks.values()), \\\"/\\\", len(checks))\\n\",\"print(\\\"Status:\\\", audit[\\\"status\\\"])\\n\",\"print(\\\"JSON reload:\\\", \\\"PASS\\\" if reloaded == audit else \\\"FAIL\\\")\\n\",\"print(\\\"Audit file:\\\", OUTPUT_FILE)\\n\",\"\\n\",\"print(\\\"\\\\nPermanent extraction: NO\\\")\\n\",\"print(\\\"Downloads: NO\\\")\\n\",\"print(\\\"Installations: NO\\\")\\n\",\"print(\\\"Embedding regeneration: NO\\\")\\n\",\"print(\\\"=\\\" * 90)\\n\",\"\\n\",\"nested.close()\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"rpr7lAC83lC_\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794388159883,\"user_tz\":360,\"elapsed\":4586,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"fe9946c3-7270-4907-8a31-33bded4ca8d2\"},\"execution_count\":34,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"==========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.2.9\\n\",\"FULL SOURCE IMAGE INTEGRITY VERIFICATION\\n\",\"==========================================================================================\\n\",\"\\n\",\"[1] FULL IMAGE DECODING\\n\",\"Decoded: 500/2414\\n\",\"Decoded: 1000/2414\\n\",\"Decoded: 1500/2414\\n\",\"Decoded: 2000/2414\\n\",\"Decoded images: 2414\\n\",\"Dimension counts: {'(168, 192)': 2414}\\n\",\"Mode counts: {'L': 2414}\\n\",\"Decode failures: 0\\n\",\"\\n\",\"==========================================================================================\\n\",\"STEP 3.2.9 FINAL AUDIT\\n\",\"==========================================================================================\\n\",\"Source SHA256 matches: PASS\\n\",\"Nested ZIP integrity: PASS\\n\",\"38 subject directories: PASS\\n\",\"Subject directories match metadata: PASS\\n\",\"2414 embedding images matched: PASS\\n\",\"No unmatched embedding images: PASS\\n\",\"38 ambient images identified: PASS\\n\",\"All expected images decoded: PASS\\n\",\"All images are 168x192: PASS\\n\",\"All images are grayscale: PASS\\n\",\"2166 common observations: PASS\\n\",\"2128 evaluation observations: PASS\\n\",\"\\n\",\"Passed: 12 / 12\\n\",\"Status: FULL_IMAGE_COHORT_VERIFIED\\n\",\"JSON reload: PASS\\n\",\"Audit file: /content/drive/MyDrive/Experiment_20_Results/step_3_2/experiment20_step329_full_image_integrity_audit.json\\n\",\"\\n\",\"Permanent extraction: NO\\n\",\"Downloads: NO\\n\",\"Installations: NO\\n\",\"Embedding regeneration: NO\\n\",\"==========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.2.10\\n\",\"## Additional Face-Recognition Model Feasibility Assessment\\n\",\"\\n\",\"### Objective\\n\",\"Assess the feasibility of adding independent pretrained\\n\",\"face-recognition architectures to the existing Yale B cohort.\\n\",\"\\n\",\"### Current baseline\\n\",\"- Dataset: Cropped Extended Yale B\\n\",\"- Subjects: 38\\n\",\"- Evaluation observations: 2,128\\n\",\"- Image dimensions: 168 × 192\\n\",\"- Image mode: grayscale\\n\",\"- Existing model: InceptionResnetV1 pretrained on VGGFace2\\n\",\"- Existing embedding dimension: 512\\n\",\"- Existing preprocessing: grayscale-to-RGB, resize to 160 × 160,\\n\",\"  tensor conversion and model-specific normalization as recorded.\\n\",\"\\n\",\"### Assessment criteria\\n\",\"1. Availability of pretrained weights.\\n\",\"2. Availability of an official or clearly documented implementation.\\n\",\"3. Input image requirements.\\n\",\"4. Face alignment requirements.\\n\",\"5. Input normalization requirements.\\n\",\"6. Embedding output dimensions.\\n\",\"7. CPU or free Google Colab feasibility.\\n\",\"8. Compatibility with the existing Yale B images.\\n\",\"9. Whether the architecture provides a genuinely independent model comparison.\\n\",\"\\n\",\"### Important restriction\\n\",\"Do not download models, install packages, modify existing embeddings,\\n\",\"or run additional inference in this step.\\n\",\"\\n\",\"### Output\\n\",\"A structured feasibility record identifying candidate architectures\\n\",\"and unresolved compatibility questions.\"],\"metadata\":{\"id\":\"NLRBTi4v3w0s\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"STEP_DIR = BASE / \\\"step_3_2\\\"\\n\",\"STEP_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"OUTPUT_FILE = STEP_DIR / (\\n\",\"    \\\"experiment20_step3210_additional_model_feasibility.json\\\"\\n\",\")\\n\",\"\\n\",\"assessment = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"step\\\": \\\"3.2.10\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"\\n\",\"    \\\"objective\\\": (\\n\",\"        \\\"Assess feasibility of adding independent pretrained \\\"\\n\",\"        \\\"face-recognition architectures to the Yale B cohort.\\\"\\n\",\"    ),\\n\",\"\\n\",\"    \\\"existing_baseline\\\": {\\n\",\"        \\\"architecture\\\": \\\"InceptionResnetV1\\\",\\n\",\"        \\\"pretraining\\\": \\\"VGGFace2\\\",\\n\",\"        \\\"embedding_dimension\\\": 512,\\n\",\"        \\\"subjects\\\": 38,\\n\",\"        \\\"evaluation_observations\\\": 2128,\\n\",\"        \\\"image_dimensions\\\": [168, 192],\\n\",\"        \\\"image_mode\\\": \\\"grayscale\\\",\\n\",\"        \\\"existing_preprocessing\\\": (\\n\",\"            \\\"Grayscale-to-RGB conversion, resize to 160x160, \\\"\\n\",\"            \\\"tensor conversion, and recorded model preprocessing.\\\"\\n\",\"        )\\n\",\"    },\\n\",\"\\n\",\"    \\\"candidate_models\\\": [\\n\",\"        {\\n\",\"            \\\"name\\\": \\\"ArcFace\\\",\\n\",\"            \\\"architecture_family\\\": \\\"ResNet-based face recognition\\\",\\n\",\"            \\\"independent_from_facenet\\\": True,\\n\",\"            \\\"pretrained_weights_available\\\": \\\"To verify\\\",\\n\",\"            \\\"official_implementation\\\": \\\"To verify\\\",\\n\",\"            \\\"input_requirements\\\": \\\"To verify\\\",\\n\",\"            \\\"alignment_requirements\\\": \\\"To verify\\\",\\n\",\"            \\\"normalization_requirements\\\": \\\"To verify\\\",\\n\",\"            \\\"embedding_dimension\\\": \\\"Checkpoint-dependent\\\",\\n\",\"            \\\"cpu_feasibility\\\": \\\"To test\\\",\\n\",\"            \\\"compatibility\\\": \\\"Unresolved\\\",\\n\",\"            \\\"decision\\\": \\\"Candidate\\\"\\n\",\"        },\\n\",\"        {\\n\",\"            \\\"name\\\": \\\"AdaFace\\\",\\n\",\"            \\\"architecture_family\\\": \\\"Adaptive-margin face recognition\\\",\\n\",\"            \\\"independent_from_facenet\\\": True,\\n\",\"            \\\"pretrained_weights_available\\\": \\\"To verify\\\",\\n\",\"            \\\"official_implementation\\\": \\\"To verify\\\",\\n\",\"            \\\"input_requirements\\\": \\\"To verify\\\",\\n\",\"            \\\"alignment_requirements\\\": \\\"To verify\\\",\\n\",\"            \\\"normalization_requirements\\\": \\\"To verify\\\",\\n\",\"            \\\"embedding_dimension\\\": \\\"Checkpoint-dependent\\\",\\n\",\"            \\\"cpu_feasibility\\\": \\\"To test\\\",\\n\",\"            \\\"compatibility\\\": \\\"Unresolved\\\",\\n\",\"            \\\"decision\\\": \\\"Candidate\\\"\\n\",\"        },\\n\",\"        {\\n\",\"            \\\"name\\\": \\\"MagFace\\\",\\n\",\"            \\\"architecture_family\\\": \\\"Magnitude-aware face recognition\\\",\\n\",\"            \\\"independent_from_facenet\\\": True,\\n\",\"            \\\"pretrained_weights_available\\\": \\\"To verify\\\",\\n\",\"            \\\"official_implementation\\\": \\\"To verify\\\",\\n\",\"            \\\"input_requirements\\\": \\\"To verify\\\",\\n\",\"            \\\"alignment_requirements\\\": \\\"To verify\\\",\\n\",\"            \\\"normalization_requirements\\\": \\\"To verify\\\",\\n\",\"            \\\"embedding_dimension\\\": \\\"Checkpoint-dependent\\\",\\n\",\"            \\\"cpu_feasibility\\\": \\\"To test\\\",\\n\",\"            \\\"compatibility\\\": \\\"Unresolved\\\",\\n\",\"            \\\"decision\\\": \\\"Candidate\\\"\\n\",\"        }\\n\",\"    ],\\n\",\"\\n\",\"    \\\"evaluation_requirements\\\": [\\n\",\"        \\\"Use the same 2,414-image source cohort where supported.\\\",\\n\",\"        \\\"Preserve the 38-subject and 2,128-evaluation-observation mapping.\\\",\\n\",\"        \\\"Record model-specific preprocessing explicitly.\\\",\\n\",\"        \\\"Record exact checkpoint provenance and SHA256.\\\",\\n\",\"        \\\"Do not compare raw Euclidean distances across models as if \\\"\\n\",\"        \\\"their embedding scales were directly equivalent.\\\",\\n\",\"        \\\"Compare within-model illumination-group patterns.\\\",\\n\",\"        \\\"Treat recognition verification as a separate evaluation \\\"\\n\",\"        \\\"requiring a predefined protocol.\\\"\\n\",\"    ],\\n\",\"\\n\",\"    \\\"known_methodological_risks\\\": [\\n\",\"        \\\"Different alignment pipelines may change the effective input.\\\",\\n\",\"        \\\"Grayscale-to-RGB conversion may not match model training inputs.\\\",\\n\",\"        \\\"Different checkpoints may have different embedding dimensions.\\\",\\n\",\"        \\\"Different embedding scales make raw distance magnitudes \\\"\\n\",\"        \\\"incomparable across architectures.\\\",\\n\",\"        \\\"The 38-subject cohort limits the strength of subject-disjoint \\\"\\n\",\"        \\\"generalisation claims.\\\"\\n\",\"    ],\\n\",\"\\n\",\"    \\\"restrictions\\\": {\\n\",\"        \\\"downloads\\\": False,\\n\",\"        \\\"package_installations\\\": False,\\n\",\"        \\\"model_inference\\\": False,\\n\",\"        \\\"existing_embeddings_modified\\\": False,\\n\",\"        \\\"dataset_modified\\\": False\\n\",\"    },\\n\",\"\\n\",\"    \\\"status\\\": \\\"FEASIBILITY_ASSESSMENT_PENDING_EXTERNAL_VERIFICATION\\\",\\n\",\"    \\\"publication_target\\\": \\\"NOT_SELECTED\\\"\\n\",\"}\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"w\\\") as f:\\n\",\"    json.dump(assessment, f, indent=2)\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"r\\\") as f:\\n\",\"    verified = json.load(f)\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.2.10\\\")\\n\",\"print(\\\"ADDITIONAL MODEL FEASIBILITY ASSESSMENT\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"print(\\\"Candidate architectures:\\\")\\n\",\"for model in verified[\\\"candidate_models\\\"]:\\n\",\"    print(\\\"-\\\", model[\\\"name\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nExisting baseline:\\\", verified[\\\"existing_baseline\\\"][\\\"architecture\\\"])\\n\",\"print(\\\"Evaluation observations:\\\",\\n\",\"      verified[\\\"existing_baseline\\\"][\\\"evaluation_observations\\\"])\\n\",\"print(\\\"Subjects:\\\", verified[\\\"existing_baseline\\\"][\\\"subjects\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nStatus:\\\", verified[\\\"status\\\"])\\n\",\"print(\\\"JSON reload:\\\", \\\"PASS\\\" if verified == assessment else \\\"FAIL\\\")\\n\",\"print(\\\"Saved:\\\", OUTPUT_FILE)\\n\",\"\\n\",\"print(\\\"\\\\nDownloads: NO\\\")\\n\",\"print(\\\"Installations: NO\\\")\\n\",\"print(\\\"Inference: NO\\\")\\n\",\"print(\\\"Existing artifacts modified: NO\\\")\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"Vk6lKIXi3y-S\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794388212838,\"user_tz\":360,\"elapsed\":63,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"163a7e4f-d6bc-44ff-95b7-4305a889cc24\"},\"execution_count\":35,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.2.10\\n\",\"ADDITIONAL MODEL FEASIBILITY ASSESSMENT\\n\",\"========================================================================================\\n\",\"Candidate architectures:\\n\",\"- ArcFace\\n\",\"- AdaFace\\n\",\"- MagFace\\n\",\"\\n\",\"Existing baseline: InceptionResnetV1\\n\",\"Evaluation observations: 2128\\n\",\"Subjects: 38\\n\",\"\\n\",\"Status: FEASIBILITY_ASSESSMENT_PENDING_EXTERNAL_VERIFICATION\\n\",\"JSON reload: PASS\\n\",\"Saved: /content/drive/MyDrive/Experiment_20_Results/step_3_2/experiment20_step3210_additional_model_feasibility.json\\n\",\"\\n\",\"Downloads: NO\\n\",\"Installations: NO\\n\",\"Inference: NO\\n\",\"Existing artifacts modified: NO\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.2.11\\n\",\"## External Verification of Candidate Model Requirements\\n\",\"\\n\",\"### Objective\\n\",\"Record verified implementation and preprocessing requirements for\\n\",\"ArcFace, AdaFace, and MagFace.\\n\",\"\\n\",\"### Verified findings\\n\",\"\\n\",\"#### ArcFace / InsightFace\\n\",\"- Official pretrained model zoo is available.\\n\",\"- Documented recognition input uses aligned 112 × 112 face images.\\n\",\"- Recognition normalization is model-specific.\\n\",\"- Pretrained InsightFace model packs are restricted to non-commercial\\n\",\"  research use.\\n\",\"\\n\",\"#### AdaFace\\n\",\"- Official pretrained IR-50 and IR-100 checkpoints are listed.\\n\",\"- Inference expects 112 × 112 BGR input.\\n\",\"- Input normalization uses mean 0.5 and standard deviation 0.5.\\n\",\"- Official inference example uses facial-landmark alignment.\\n\",\"\\n\",\"#### MagFace\\n\",\"- Official CVPR 2021 paper and implementation are available.\\n\",\"- The implementation specifies five-landmark alignment to 112 × 112.\\n\",\"- Exact checkpoint and preprocessing compatibility remain to be verified.\\n\",\"\\n\",\"### Methodological decision\\n\",\"No additional model is selected at this stage.\\n\",\"\\n\",\"The existing Yale B cohort was processed without successful MTCNN\\n\",\"alignment. The candidate implementations document aligned face inputs.\\n\",\"Simply resizing the existing images would not establish preprocessing\\n\",\"compatibility.\\n\",\"\\n\",\"### Next requirement\\n\",\"Assess whether a reliable landmark-alignment method can process the\\n\",\"existing Yale B image cohort. Do not alter the frozen source images or\\n\",\"existing FaceNet embeddings.\\n\",\"\\n\",\"### Restrictions\\n\",\"- No model downloads.\\n\",\"- No package installations.\\n\",\"- No inference.\\n\",\"- No changes to frozen data.\\n\",\"- No model selection until alignment feasibility is assessed.\"],\"metadata\":{\"id\":\"QlLepbCt5C6d\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"STEP_DIR = BASE / \\\"step_3_2\\\"\\n\",\"STEP_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"OUTPUT_FILE = STEP_DIR / (\\n\",\"    \\\"experiment20_step3211_verified_model_requirements.json\\\"\\n\",\")\\n\",\"\\n\",\"record = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"step\\\": \\\"3.2.11\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"\\n\",\"    \\\"objective\\\": (\\n\",\"        \\\"Record externally verified requirements for candidate \\\"\\n\",\"        \\\"face-recognition models.\\\"\\n\",\"    ),\\n\",\"\\n\",\"    \\\"candidates\\\": {\\n\",\"        \\\"ArcFace_InsightFace\\\": {\\n\",\"            \\\"official_source\\\": (\\n\",\"                \\\"https://github.com/deepinsight/insightface\\\"\\n\",\"            ),\\n\",\"            \\\"model_zoo_source\\\": (\\n\",\"                \\\"https://github.com/deepinsight/insightface/\\\"\\n\",\"                \\\"blob/master/model_zoo/README.md\\\"\\n\",\"            ),\\n\",\"            \\\"pretrained_models\\\": \\\"Available\\\",\\n\",\"            \\\"documented_input_size\\\": \\\"112x112\\\",\\n\",\"            \\\"alignment\\\": \\\"Aligned face input\\\",\\n\",\"            \\\"normalization\\\": \\\"Model-specific\\\",\\n\",\"            \\\"model_license\\\": (\\n\",\"                \\\"Non-commercial research use for supplied pretrained models\\\"\\n\",\"            ),\\n\",\"            \\\"compatibility_with_current_cohort\\\": \\\"Not established\\\"\\n\",\"        },\\n\",\"\\n\",\"        \\\"AdaFace\\\": {\\n\",\"            \\\"official_source\\\": (\\n\",\"                \\\"https://github.com/mk-minchul/AdaFace\\\"\\n\",\"            ),\\n\",\"            \\\"pretrained_models\\\": (\\n\",\"                \\\"IR-50 and IR-100 variants listed\\\"\\n\",\"            ),\\n\",\"            \\\"documented_input_size\\\": \\\"112x112\\\",\\n\",\"            \\\"channel_order\\\": \\\"BGR\\\",\\n\",\"            \\\"normalization\\\": {\\n\",\"                \\\"mean\\\": 0.5,\\n\",\"                \\\"standard_deviation\\\": 0.5\\n\",\"            },\\n\",\"            \\\"alignment\\\": \\\"Facial-landmark alignment\\\",\\n\",\"            \\\"compatibility_with_current_cohort\\\": \\\"Not established\\\"\\n\",\"        },\\n\",\"\\n\",\"        \\\"MagFace\\\": {\\n\",\"            \\\"official_source\\\": (\\n\",\"                \\\"https://github.com/IrvingMeng/MagFace\\\"\\n\",\"            ),\\n\",\"            \\\"paper\\\": (\\n\",\"                \\\"https://openaccess.thecvf.com/content/CVPR2021/\\\"\\n\",\"                \\\"html/Meng_MagFace_A_Universal_Representation_for_\\\"\\n\",\"                \\\"Face_Recognition_and_Quality_Assessment_CVPR_2021_paper.html\\\"\\n\",\"            ),\\n\",\"            \\\"pretrained_models\\\": \\\"Implementation available; checkpoint to verify\\\",\\n\",\"            \\\"documented_input_size\\\": \\\"112x112\\\",\\n\",\"            \\\"alignment\\\": \\\"Five-landmark alignment\\\",\\n\",\"            \\\"normalization\\\": \\\"Checkpoint-specific details to verify\\\",\\n\",\"            \\\"compatibility_with_current_cohort\\\": \\\"Not established\\\"\\n\",\"        }\\n\",\"    },\\n\",\"\\n\",\"    \\\"current_cohort_constraints\\\": {\\n\",\"        \\\"source_images\\\": 2414,\\n\",\"        \\\"subjects\\\": 38,\\n\",\"        \\\"image_dimensions\\\": [168, 192],\\n\",\"        \\\"image_mode\\\": \\\"L\\\",\\n\",\"        \\\"existing_face_alignment\\\": (\\n\",\"            \\\"MTCNN failed on 11 of 12 tested images; \\\"\\n\",\"            \\\"direct resize preprocessing was used for FaceNet.\\\"\\n\",\"        ),\\n\",\"        \\\"frozen_source_images_must_remain_unchanged\\\": True,\\n\",\"        \\\"existing_facenet_embeddings_must_remain_unchanged\\\": True\\n\",\"    },\\n\",\"\\n\",\"    \\\"methodological_decision\\\": (\\n\",\"        \\\"Do not select or run an additional model until a suitable \\\"\\n\",\"        \\\"landmark-alignment route has been assessed.\\\"\\n\",\"    ),\\n\",\"\\n\",\"    \\\"next_assessment\\\": (\\n\",\"        \\\"Evaluate landmark detection and alignment feasibility on \\\"\\n\",\"        \\\"the existing Yale B cohort without modifying frozen images.\\\"\\n\",\"    ),\\n\",\"\\n\",\"    \\\"restrictions\\\": {\\n\",\"        \\\"downloads\\\": False,\\n\",\"        \\\"installations\\\": False,\\n\",\"        \\\"inference\\\": False,\\n\",\"        \\\"frozen_data_modified\\\": False,\\n\",\"        \\\"model_selected\\\": False\\n\",\"    },\\n\",\"\\n\",\"    \\\"status\\\": \\\"EXTERNAL_REQUIREMENTS_RECORDED_ALIGNMENT_ASSESSMENT_REQUIRED\\\"\\n\",\"}\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"w\\\") as f:\\n\",\"    json.dump(record, f, indent=2)\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"r\\\") as f:\\n\",\"    reloaded = json.load(f)\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.2.11\\\")\\n\",\"print(\\\"VERIFIED MODEL REQUIREMENTS\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"for name, details in reloaded[\\\"candidates\\\"].items():\\n\",\"    print(f\\\"\\\\n{name}\\\")\\n\",\"    print(\\\"  Input:\\\", details.get(\\\"documented_input_size\\\"))\\n\",\"    print(\\\"  Alignment:\\\", details.get(\\\"alignment\\\"))\\n\",\"    print(\\\"  Cohort compatibility:\\\",\\n\",\"          details.get(\\\"compatibility_with_current_cohort\\\"))\\n\",\"\\n\",\"print(\\\"\\\\nModel selected: NO\\\")\\n\",\"print(\\\"Alignment assessment required: YES\\\")\\n\",\"print(\\\"JSON reload:\\\", \\\"PASS\\\" if reloaded == record else \\\"FAIL\\\")\\n\",\"print(\\\"Saved:\\\", OUTPUT_FILE)\\n\",\"\\n\",\"print(\\\"\\\\nDownloads: NO\\\")\\n\",\"print(\\\"Installations: NO\\\")\\n\",\"print(\\\"Inference: NO\\\")\\n\",\"print(\\\"Frozen data modified: NO\\\")\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"VbHKk2ja3znm\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794388648877,\"user_tz\":360,\"elapsed\":72,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"8f3440bb-4b16-4ccb-da37-9b3a3f68dde0\"},\"execution_count\":36,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.2.11\\n\",\"VERIFIED MODEL REQUIREMENTS\\n\",\"========================================================================================\\n\",\"\\n\",\"ArcFace_InsightFace\\n\",\"  Input: 112x112\\n\",\"  Alignment: Aligned face input\\n\",\"  Cohort compatibility: Not established\\n\",\"\\n\",\"AdaFace\\n\",\"  Input: 112x112\\n\",\"  Alignment: Facial-landmark alignment\\n\",\"  Cohort compatibility: Not established\\n\",\"\\n\",\"MagFace\\n\",\"  Input: 112x112\\n\",\"  Alignment: Five-landmark alignment\\n\",\"  Cohort compatibility: Not established\\n\",\"\\n\",\"Model selected: NO\\n\",\"Alignment assessment required: YES\\n\",\"JSON reload: PASS\\n\",\"Saved: /content/drive/MyDrive/Experiment_20_Results/step_3_2/experiment20_step3211_verified_model_requirements.json\\n\",\"\\n\",\"Downloads: NO\\n\",\"Installations: NO\\n\",\"Inference: NO\\n\",\"Frozen data modified: NO\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.2.12\\n\",\"## Landmark-Alignment Route Feasibility Assessment\\n\",\"\\n\",\"### Objective\\n\",\"Identify a possible alternative to MTCNN for landmark detection\\n\",\"on the frozen Cropped Extended Yale B image cohort.\\n\",\"\\n\",\"### Candidate: MediaPipe Face Landmarker\\n\",\"\\n\",\"Official documentation:\\n\",\"https://developers.google.com/edge/mediapipe/solutions/vision/face_landmarker\\n\",\"\\n\",\"Documented capabilities:\\n\",\"- Processes still images.\\n\",\"- Returns 478 facial landmarks.\\n\",\"- Provides normalized landmark coordinates.\\n\",\"- Supports Python image-mode inference.\\n\",\"\\n\",\"### Potential application\\n\",\"A five-point alignment transform may be derived from selected\\n\",\"landmarks representing:\\n\",\"- Left eye\\n\",\"- Right eye\\n\",\"- Nose\\n\",\"- Left mouth corner\\n\",\"- Right mouth corner\\n\",\"\\n\",\"The selected landmark indices and target coordinates must be\\n\",\"documented and validated before use.\\n\",\"\\n\",\"### Unresolved questions\\n\",\"1. Can MediaPipe detect faces reliably in the grayscale Yale B images?\\n\",\"2. Does detection coverage remain stable across illumination conditions?\\n\",\"3. Are the selected landmarks anatomically plausible under strong shadows?\\n\",\"4. Can a consistent five-point alignment transform be derived?\\n\",\"5. Does alignment introduce condition-dependent crop failures or distortions?\\n\",\"\\n\",\"### Important methodological restriction\\n\",\"Do not assume that MediaPipe alignment is equivalent to the\\n\",\"alignment pipelines used by AdaFace or MagFace.\\n\",\"\\n\",\"A successful landmark detection is not proof of successful alignment.\\n\",\"Alignment must be visually inspected and quantitatively audited.\\n\",\"\\n\",\"### Decision\\n\",\"MediaPipe is retained as an experimental alignment candidate.\\n\",\"It is not yet approved for the additional-model evaluation.\\n\",\"\\n\",\"### Restrictions\\n\",\"- No package installation.\\n\",\"- No model download.\\n\",\"- No inference.\\n\",\"- No changes to frozen images or FaceNet embeddings.\"],\"metadata\":{\"id\":\"FGFKO1o36AFF\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"STEP_DIR = BASE / \\\"step_3_2\\\"\\n\",\"STEP_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"OUTPUT_FILE = STEP_DIR / (\\n\",\"    \\\"experiment20_step3212_alignment_route_assessment.json\\\"\\n\",\")\\n\",\"\\n\",\"record = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"step\\\": \\\"3.2.12\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"\\n\",\"    \\\"objective\\\": (\\n\",\"        \\\"Assess a possible landmark-detection route after \\\"\\n\",\"        \\\"the unsuccessful MTCNN feasibility test.\\\"\\n\",\"    ),\\n\",\"\\n\",\"    \\\"candidate\\\": {\\n\",\"        \\\"name\\\": \\\"MediaPipe Face Landmarker\\\",\\n\",\"        \\\"official_documentation\\\": (\\n\",\"            \\\"https://developers.google.com/edge/mediapipe/\\\"\\n\",\"            \\\"solutions/vision/face_landmarker\\\"\\n\",\"        ),\\n\",\"        \\\"supports_still_images\\\": True,\\n\",\"        \\\"documented_landmark_count\\\": 478,\\n\",\"        \\\"landmark_coordinates\\\": \\\"Normalized image coordinates\\\",\\n\",\"        \\\"python_support\\\": True,\\n\",\"        \\\"five_point_alignment\\\": (\\n\",\"            \\\"Potentially derivable from selected dense landmarks; \\\"\\n\",\"            \\\"not yet implemented or validated.\\\"\\n\",\"        )\\n\",\"    },\\n\",\"\\n\",\"    \\\"proposed_five_points\\\": [\\n\",\"        \\\"Left eye\\\",\\n\",\"        \\\"Right eye\\\",\\n\",\"        \\\"Nose\\\",\\n\",\"        \\\"Left mouth corner\\\",\\n\",\"        \\\"Right mouth corner\\\"\\n\",\"    ],\\n\",\"\\n\",\"    \\\"unresolved_questions\\\": [\\n\",\"        \\\"Detection coverage across the complete 2414-image cohort.\\\",\\n\",\"        \\\"Detection coverage across illumination groups.\\\",\\n\",\"        \\\"Landmark plausibility under strong illumination changes.\\\",\\n\",\"        \\\"Consistency of the derived five-point alignment.\\\",\\n\",\"        \\\"Condition-dependent alignment failures or distortions.\\\"\\n\",\"    ],\\n\",\"\\n\",\"    \\\"validation_requirements\\\": [\\n\",\"        \\\"Test a predefined sample before full-cohort processing.\\\",\\n\",\"        \\\"Record detection success and failure counts.\\\",\\n\",\"        \\\"Inspect landmark overlays on representative images.\\\",\\n\",\"        \\\"Inspect aligned crops under each illumination group.\\\",\\n\",\"        \\\"Record failures by subject and illumination condition.\\\",\\n\",\"        \\\"Do not silently discard failed images.\\\",\\n\",\"        \\\"Preserve original frozen source images.\\\"\\n\",\"    ],\\n\",\"\\n\",\"    \\\"methodological_warning\\\": (\\n\",\"        \\\"MediaPipe dense-landmark alignment is not automatically \\\"\\n\",\"        \\\"equivalent to the alignment conventions used by AdaFace, \\\"\\n\",\"        \\\"MagFace, or InsightFace.\\\"\\n\",\"    ),\\n\",\"\\n\",\"    \\\"decision\\\": (\\n\",\"        \\\"RETAIN_AS_EXPERIMENTAL_CANDIDATE; \\\"\\n\",\"        \\\"NOT_APPROVED_FOR_FULL_COHORT_ALIGNMENT\\\"\\n\",\"    ),\\n\",\"\\n\",\"    \\\"restrictions\\\": {\\n\",\"        \\\"package_installation\\\": False,\\n\",\"        \\\"model_download\\\": False,\\n\",\"        \\\"inference\\\": False,\\n\",\"        \\\"frozen_images_modified\\\": False,\\n\",\"        \\\"facenet_embeddings_modified\\\": False,\\n\",\"        \\\"additional_model_selected\\\": False\\n\",\"    },\\n\",\"\\n\",\"    \\\"status\\\": \\\"ALIGNMENT_ROUTE_REQUIRES_EMPIRICAL_VALIDATION\\\"\\n\",\"}\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"w\\\") as f:\\n\",\"    json.dump(record, f, indent=2)\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"r\\\") as f:\\n\",\"    reloaded = json.load(f)\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.2.12\\\")\\n\",\"print(\\\"ALIGNMENT ROUTE FEASIBILITY ASSESSMENT\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"print(\\\"Candidate:\\\", reloaded[\\\"candidate\\\"][\\\"name\\\"])\\n\",\"print(\\\"Documented landmarks:\\\",\\n\",\"      reloaded[\\\"candidate\\\"][\\\"documented_landmark_count\\\"])\\n\",\"print(\\\"Still-image support:\\\",\\n\",\"      reloaded[\\\"candidate\\\"][\\\"supports_still_images\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nProposed alignment points:\\\")\\n\",\"for point in reloaded[\\\"proposed_five_points\\\"]:\\n\",\"    print(\\\"-\\\", point)\\n\",\"\\n\",\"print(\\\"\\\\nDecision:\\\", reloaded[\\\"decision\\\"])\\n\",\"print(\\\"JSON reload:\\\", \\\"PASS\\\" if reloaded == record else \\\"FAIL\\\")\\n\",\"print(\\\"Saved:\\\", OUTPUT_FILE)\\n\",\"\\n\",\"print(\\\"\\\\nPackage installation: NO\\\")\\n\",\"print(\\\"Model download: NO\\\")\\n\",\"print(\\\"Inference: NO\\\")\\n\",\"print(\\\"Frozen images modified: NO\\\")\\n\",\"print(\\\"FaceNet embeddings modified: NO\\\")\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"lQiM7fSe6C1P\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794388801044,\"user_tz\":360,\"elapsed\":82,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"12aeff48-ea63-4326-f11a-fb03794db72e\"},\"execution_count\":37,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.2.12\\n\",\"ALIGNMENT ROUTE FEASIBILITY ASSESSMENT\\n\",\"========================================================================================\\n\",\"Candidate: MediaPipe Face Landmarker\\n\",\"Documented landmarks: 478\\n\",\"Still-image support: True\\n\",\"\\n\",\"Proposed alignment points:\\n\",\"- Left eye\\n\",\"- Right eye\\n\",\"- Nose\\n\",\"- Left mouth corner\\n\",\"- Right mouth corner\\n\",\"\\n\",\"Decision: RETAIN_AS_EXPERIMENTAL_CANDIDATE; NOT_APPROVED_FOR_FULL_COHORT_ALIGNMENT\\n\",\"JSON reload: PASS\\n\",\"Saved: /content/drive/MyDrive/Experiment_20_Results/step_3_2/experiment20_step3212_alignment_route_assessment.json\\n\",\"\\n\",\"Package installation: NO\\n\",\"Model download: NO\\n\",\"Inference: NO\\n\",\"Frozen images modified: NO\\n\",\"FaceNet embeddings modified: NO\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.2.13\\n\",\"## MediaPipe Pilot-Test Preparation\\n\",\"\\n\",\"### Objective\\n\",\"Prepare a reproducible pilot sample for assessing MediaPipe\\n\",\"Face Landmarker feasibility on the original Yale B images.\\n\",\"\\n\",\"### Sampling design\\n\",\"Select 30 images:\\n\",\"- 10 near-frontal illumination observations.\\n\",\"- 10 oblique illumination observations.\\n\",\"- 10 large-angular illumination observations.\\n\",\"\\n\",\"Use a deterministic sampling seed.\\n\",\"\\n\",\"### Requirements\\n\",\"- Use the original frozen source images.\\n\",\"- Do not modify the source archive.\\n\",\"- Do not modify existing FaceNet embeddings.\\n\",\"- Preserve subject and illumination-condition identifiers.\\n\",\"- Record the exact image paths selected.\\n\",\"- Check that all 30 images are unique.\\n\",\"- Check that every selected image exists in the source archive.\\n\",\"\\n\",\"### Important\\n\",\"This step only prepares and audits the sample.\\n\",\"It does not install MediaPipe, download a model, perform detection,\\n\",\"or generate aligned images.\\n\",\"\\n\",\"### Output\\n\",\"A JSON manifest containing the 30 selected image records,\\n\",\"their illumination groups, sampling seed, and validation results.\"],\"metadata\":{\"id\":\"zsSwk6sJ6N2e\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"from zipfile import ZipFile\\n\",\"import numpy as np\\n\",\"import json\\n\",\"import hashlib\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"STEP_DIR = BASE / \\\"step_3_2\\\"\\n\",\"EMBEDDING_FILE = (\\n\",\"    BASE / \\\"embeddings\\\" /\\n\",\"    \\\"experiment20_croppedyale_facenet_embeddings.npz\\\"\\n\",\")\\n\",\"FROZEN_ZIP = (\\n\",\"    BASE / \\\"Experiment_20_Stage_2_Frozen_Dataset.zip\\\"\\n\",\")\\n\",\"\\n\",\"OUTPUT_FILE = STEP_DIR / (\\n\",\"    \\\"experiment20_step3213_mediapipe_pilot_sample_manifest.json\\\"\\n\",\")\\n\",\"\\n\",\"SEED = 203213\\n\",\"SAMPLE_PER_GROUP = 10\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.2.13\\\")\\n\",\"print(\\\"MEDIAPIPE PILOT SAMPLE PREPARATION\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"assert EMBEDDING_FILE.exists(), \\\"Embedding NPZ not found.\\\"\\n\",\"assert FROZEN_ZIP.exists(), \\\"Frozen dataset ZIP not found.\\\"\\n\",\"\\n\",\"with np.load(EMBEDDING_FILE, allow_pickle=False) as data:\\n\",\"    filenames = data[\\\"filenames\\\"].astype(str)\\n\",\"    subjects = data[\\\"subjects\\\"].astype(str)\\n\",\"    conditions = data[\\\"conditions\\\"].astype(str)\\n\",\"    azimuths = data[\\\"azimuths\\\"].astype(int)\\n\",\"    elevations = data[\\\"elevations\\\"].astype(int)\\n\",\"\\n\",\"assert len(filenames) == 2414\\n\",\"assert len(set(filenames)) == 2414\\n\",\"\\n\",\"# Reconstruct the geometry groups using the documented definition.\\n\",\"theta = np.degrees(\\n\",\"    np.arccos(\\n\",\"        np.clip(\\n\",\"            np.cos(np.radians(elevations)) *\\n\",\"            np.cos(np.radians(azimuths)),\\n\",\"            -1.0,\\n\",\"            1.0\\n\",\"        )\\n\",\"    )\\n\",\")\\n\",\"\\n\",\"groups = np.where(\\n\",\"    theta <= 30,\\n\",\"    \\\"near_frontal\\\",\\n\",\"    np.where(theta <= 60, \\\"oblique\\\", \\\"large_angular\\\")\\n\",\")\\n\",\"\\n\",\"# Exclude the reference condition from pilot evaluation.\\n\",\"evaluation_mask = conditions != \\\"A+000E+00\\\"\\n\",\"\\n\",\"rng = np.random.default_rng(SEED)\\n\",\"selected_indices = []\\n\",\"\\n\",\"for group_name in [\\n\",\"    \\\"near_frontal\\\",\\n\",\"    \\\"oblique\\\",\\n\",\"    \\\"large_angular\\\"\\n\",\"]:\\n\",\"    candidates = np.where(\\n\",\"        (groups == group_name) & evaluation_mask\\n\",\"    )[0]\\n\",\"\\n\",\"    assert len(candidates) >= SAMPLE_PER_GROUP, (\\n\",\"        f\\\"Insufficient observations in {group_name}\\\"\\n\",\"    )\\n\",\"\\n\",\"    chosen = rng.choice(\\n\",\"        candidates,\\n\",\"        size=SAMPLE_PER_GROUP,\\n\",\"        replace=False\\n\",\"    )\\n\",\"\\n\",\"    selected_indices.extend(chosen.tolist())\\n\",\"\\n\",\"# Verify archive membership using exact source image basenames.\\n\",\"with ZipFile(FROZEN_ZIP, \\\"r\\\") as zf:\\n\",\"    nested_name = (\\n\",\"        \\\"Experiment_20_Stage_2_Frozen_Dataset/source/CroppedYale.zip\\\"\\n\",\"    )\\n\",\"\\n\",\"    nested_bytes = zf.read(nested_name)\\n\",\"    nested_sha256 = hashlib.sha256(nested_bytes).hexdigest()\\n\",\"\\n\",\"    expected_nested_sha256 = (\\n\",\"        \\\"8bbabf3836d077d60626c9ee3c54c2d2851a8d2c15c8b7e13b9bc162e86ea573\\\"\\n\",\"    )\\n\",\"\\n\",\"    assert nested_sha256 == expected_nested_sha256, (\\n\",\"        \\\"Nested source archive checksum mismatch.\\\"\\n\",\"    )\\n\",\"\\n\",\"    import io\\n\",\"\\n\",\"    with ZipFile(io.BytesIO(nested_bytes), \\\"r\\\") as source_zip:\\n\",\"        archive_files = {\\n\",\"            Path(name).name\\n\",\"            for name in source_zip.namelist()\\n\",\"            if name.lower().endswith(\\\".pgm\\\")\\n\",\"        }\\n\",\"\\n\",\"records = []\\n\",\"\\n\",\"for idx in selected_indices:\\n\",\"    filename = filenames[idx]\\n\",\"\\n\",\"    assert filename in archive_files, (\\n\",\"        f\\\"Selected image missing from source archive: {filename}\\\"\\n\",\"    )\\n\",\"\\n\",\"    records.append({\\n\",\"        \\\"filename\\\": filename,\\n\",\"        \\\"subject\\\": subjects[idx],\\n\",\"        \\\"condition\\\": conditions[idx],\\n\",\"        \\\"azimuth\\\": int(azimuths[idx]),\\n\",\"        \\\"elevation\\\": int(elevations[idx]),\\n\",\"        \\\"theta_degrees\\\": float(theta[idx]),\\n\",\"        \\\"illumination_group\\\": str(groups[idx])\\n\",\"    })\\n\",\"\\n\",\"# Audit sample balance and uniqueness.\\n\",\"group_counts = {}\\n\",\"\\n\",\"for group_name in [\\n\",\"    \\\"near_frontal\\\",\\n\",\"    \\\"oblique\\\",\\n\",\"    \\\"large_angular\\\"\\n\",\"]:\\n\",\"    group_counts[group_name] = sum(\\n\",\"        r[\\\"illumination_group\\\"] == group_name\\n\",\"        for r in records\\n\",\"    )\\n\",\"\\n\",\"unique_filenames = len({\\n\",\"    r[\\\"filename\\\"] for r in records\\n\",\"})\\n\",\"\\n\",\"unique_subjects = len({\\n\",\"    r[\\\"subject\\\"] for r in records\\n\",\"})\\n\",\"\\n\",\"checks = {\\n\",\"    \\\"30_records_selected\\\": len(records) == 30,\\n\",\"    \\\"30_unique_filenames\\\": unique_filenames == 30,\\n\",\"    \\\"10_near_frontal\\\": group_counts[\\\"near_frontal\\\"] == 10,\\n\",\"    \\\"10_oblique\\\": group_counts[\\\"oblique\\\"] == 10,\\n\",\"    \\\"10_large_angular\\\": group_counts[\\\"large_angular\\\"] == 10,\\n\",\"    \\\"all_images_in_source_archive\\\": all(\\n\",\"        r[\\\"filename\\\"] in archive_files for r in records\\n\",\"    ),\\n\",\"    \\\"reference_condition_excluded\\\": all(\\n\",\"        r[\\\"condition\\\"] != \\\"A+000E+00\\\" for r in records\\n\",\"    ),\\n\",\"    \\\"source_archive_checksum_matches\\\": (\\n\",\"        nested_sha256 == expected_nested_sha256\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"manifest = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"step\\\": \\\"3.2.13\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"sampling_seed\\\": SEED,\\n\",\"    \\\"sampling_method\\\": \\\"Deterministic random sampling without replacement\\\",\\n\",\"    \\\"sample_size\\\": len(records),\\n\",\"    \\\"sample_per_group\\\": SAMPLE_PER_GROUP,\\n\",\"    \\\"group_counts\\\": group_counts,\\n\",\"    \\\"unique_subject_count\\\": unique_subjects,\\n\",\"    \\\"source_archive_sha256\\\": nested_sha256,\\n\",\"    \\\"records\\\": records,\\n\",\"    \\\"checks\\\": checks,\\n\",\"    \\\"passed_checks\\\": sum(checks.values()),\\n\",\"    \\\"total_checks\\\": len(checks),\\n\",\"    \\\"status\\\": (\\n\",\"        \\\"PILOT_SAMPLE_READY\\\"\\n\",\"        if all(checks.values())\\n\",\"        else \\\"PILOT_SAMPLE_VALIDATION_FAILED\\\"\\n\",\"    ),\\n\",\"    \\\"restrictions\\\": {\\n\",\"        \\\"package_installation\\\": False,\\n\",\"        \\\"model_download\\\": False,\\n\",\"        \\\"inference\\\": False,\\n\",\"        \\\"aligned_images_generated\\\": False,\\n\",\"        \\\"frozen_data_modified\\\": False\\n\",\"    }\\n\",\"}\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"w\\\") as f:\\n\",\"    json.dump(manifest, f, indent=2)\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"r\\\") as f:\\n\",\"    reloaded = json.load(f)\\n\",\"\\n\",\"print(\\\"Selected images:\\\", len(records))\\n\",\"print(\\\"Unique subjects:\\\", unique_subjects)\\n\",\"print(\\\"Group counts:\\\", group_counts)\\n\",\"print(\\\"Source archive SHA256:\\\", nested_sha256)\\n\",\"\\n\",\"print(\\\"\\\\nVALIDATION\\\")\\n\",\"for name, passed in checks.items():\\n\",\"    print(f\\\"{name}: {'PASS' if passed else 'FAIL'}\\\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"\\\\nPassed:\\\",\\n\",\"    sum(checks.values()),\\n\",\"    \\\"/\\\",\\n\",\"    len(checks)\\n\",\")\\n\",\"\\n\",\"print(\\\"JSON reload:\\\", \\\"PASS\\\" if reloaded == manifest else \\\"FAIL\\\")\\n\",\"print(\\\"Saved:\\\", OUTPUT_FILE)\\n\",\"print(\\\"\\\\nPackage installation: NO\\\")\\n\",\"print(\\\"Model download: NO\\\")\\n\",\"print(\\\"Inference: NO\\\")\\n\",\"print(\\\"Aligned images generated: NO\\\")\\n\",\"print(\\\"Frozen data modified: NO\\\")\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"1UuPquEi6P2n\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794388854959,\"user_tz\":360,\"elapsed\":1278,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"5c0270cd-8140-43b4-cca2-31cf237b43ee\"},\"execution_count\":38,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.2.13\\n\",\"MEDIAPIPE PILOT SAMPLE PREPARATION\\n\",\"========================================================================================\\n\",\"Selected images: 30\\n\",\"Unique subjects: 22\\n\",\"Group counts: {'near_frontal': 10, 'oblique': 10, 'large_angular': 10}\\n\",\"Source archive SHA256: 8bbabf3836d077d60626c9ee3c54c2d2851a8d2c15c8b7e13b9bc162e86ea573\\n\",\"\\n\",\"VALIDATION\\n\",\"30_records_selected: PASS\\n\",\"30_unique_filenames: PASS\\n\",\"10_near_frontal: PASS\\n\",\"10_oblique: PASS\\n\",\"10_large_angular: PASS\\n\",\"all_images_in_source_archive: PASS\\n\",\"reference_condition_excluded: PASS\\n\",\"source_archive_checksum_matches: PASS\\n\",\"\\n\",\"Passed: 8 / 8\\n\",\"JSON reload: PASS\\n\",\"Saved: /content/drive/MyDrive/Experiment_20_Results/step_3_2/experiment20_step3213_mediapipe_pilot_sample_manifest.json\\n\",\"\\n\",\"Package installation: NO\\n\",\"Model download: NO\\n\",\"Inference: NO\\n\",\"Aligned images generated: NO\\n\",\"Frozen data modified: NO\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.2.14\\n\",\"## MediaPipe Installation and Environment Verification\\n\",\"\\n\",\"### Objective\\n\",\"Install MediaPipe in the current Colab runtime and verify that\\n\",\"the Face Landmarker API is available.\\n\",\"\\n\",\"### Requirements\\n\",\"- Record Python version.\\n\",\"- Record MediaPipe version.\\n\",\"- Verify FaceLandmarker API availability.\\n\",\"- Verify image-mode support.\\n\",\"- Record installation outcome.\\n\",\"\\n\",\"### Restrictions\\n\",\"- Do not download the Face Landmarker model asset yet.\\n\",\"- Do not run inference.\\n\",\"- Do not generate aligned images.\\n\",\"- Do not modify the frozen dataset or existing embeddings.\\n\",\"\\n\",\"### Important\\n\",\"Installing MediaPipe may change runtime dependencies.\\n\",\"Record any installation warnings or dependency conflicts.\"],\"metadata\":{\"id\":\"z9EgQXPC6cFN\"}},{\"cell_type\":\"code\",\"source\":[\"import sys\\n\",\"import json\\n\",\"import subprocess\\n\",\"import importlib.util\\n\",\"from pathlib import Path\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"STEP_DIR = BASE / \\\"step_3_2\\\"\\n\",\"STEP_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"OUTPUT_FILE = STEP_DIR / (\\n\",\"    \\\"experiment20_step3214_mediapipe_environment_audit.json\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.2.14\\\")\\n\",\"print(\\\"MEDIAPIPE INSTALLATION AND ENVIRONMENT VERIFICATION\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"print(\\\"Python:\\\", sys.version)\\n\",\"\\n\",\"# Install MediaPipe only if it is not already available.\\n\",\"if importlib.util.find_spec(\\\"mediapipe\\\") is None:\\n\",\"    result = subprocess.run(\\n\",\"        [sys.executable, \\\"-m\\\", \\\"pip\\\", \\\"install\\\", \\\"mediapipe\\\"],\\n\",\"        capture_output=True,\\n\",\"        text=True\\n\",\"    )\\n\",\"    install_return_code = result.returncode\\n\",\"    install_stdout = result.stdout[-5000:]\\n\",\"    install_stderr = result.stderr[-5000:]\\n\",\"else:\\n\",\"    install_return_code = 0\\n\",\"    install_stdout = \\\"MediaPipe already installed.\\\"\\n\",\"    install_stderr = \\\"\\\"\\n\",\"\\n\",\"import mediapipe as mp\\n\",\"\\n\",\"api_available = hasattr(mp, \\\"tasks\\\")\\n\",\"face_landmarker_available = (\\n\",\"    hasattr(mp, \\\"tasks\\\")\\n\",\"    and hasattr(mp.tasks, \\\"vision\\\")\\n\",\"    and hasattr(mp.tasks.vision, \\\"FaceLandmarker\\\")\\n\",\")\\n\",\"\\n\",\"image_mode_available = (\\n\",\"    hasattr(mp.tasks.vision, \\\"RunningMode\\\")\\n\",\"    and hasattr(mp.tasks.vision.RunningMode, \\\"IMAGE\\\")\\n\",\") if face_landmarker_available else False\\n\",\"\\n\",\"record = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"step\\\": \\\"3.2.14\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"python_version\\\": sys.version,\\n\",\"    \\\"mediapipe_version\\\": mp.__version__,\\n\",\"    \\\"installation_return_code\\\": install_return_code,\\n\",\"    \\\"mediapipe_tasks_api_available\\\": api_available,\\n\",\"    \\\"face_landmarker_api_available\\\": face_landmarker_available,\\n\",\"    \\\"image_mode_available\\\": image_mode_available,\\n\",\"    \\\"installation_stdout_tail\\\": install_stdout,\\n\",\"    \\\"installation_stderr_tail\\\": install_stderr,\\n\",\"    \\\"model_asset_downloaded\\\": False,\\n\",\"    \\\"inference_performed\\\": False,\\n\",\"    \\\"aligned_images_generated\\\": False,\\n\",\"    \\\"frozen_data_modified\\\": False,\\n\",\"    \\\"status\\\": (\\n\",\"        \\\"MEDIAPIPE_ENVIRONMENT_READY\\\"\\n\",\"        if install_return_code == 0\\n\",\"        and face_landmarker_available\\n\",\"        and image_mode_available\\n\",\"        else \\\"MEDIAPIPE_ENVIRONMENT_FAILED\\\"\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"w\\\") as f:\\n\",\"    json.dump(record, f, indent=2)\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"r\\\") as f:\\n\",\"    reloaded = json.load(f)\\n\",\"\\n\",\"print(\\\"\\\\nMediaPipe version:\\\", mp.__version__)\\n\",\"print(\\\"Tasks API:\\\", api_available)\\n\",\"print(\\\"FaceLandmarker API:\\\", face_landmarker_available)\\n\",\"print(\\\"Image mode:\\\", image_mode_available)\\n\",\"\\n\",\"print(\\\"\\\\nStatus:\\\", record[\\\"status\\\"])\\n\",\"print(\\\"JSON reload:\\\", \\\"PASS\\\" if reloaded == record else \\\"FAIL\\\")\\n\",\"print(\\\"Saved:\\\", OUTPUT_FILE)\\n\",\"\\n\",\"print(\\\"\\\\nModel asset downloaded: NO\\\")\\n\",\"print(\\\"Inference: NO\\\")\\n\",\"print(\\\"Aligned images generated: NO\\\")\\n\",\"print(\\\"Frozen data modified: NO\\\")\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"Y0HT6fwk6du-\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794388938807,\"user_tz\":360,\"elapsed\":28306,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"2a349186-155d-4687-d554-205fd7fc5534\"},\"execution_count\":39,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.2.14\\n\",\"MEDIAPIPE INSTALLATION AND ENVIRONMENT VERIFICATION\\n\",\"========================================================================================\\n\",\"Python: 3.13.18 (main, Oct 26 2026, 15:28:15) [GCC 13.3.0]\\n\",\"\\n\",\"MediaPipe version: 1.2.2\\n\",\"Tasks API: True\\n\",\"FaceLandmarker API: True\\n\",\"Image mode: True\\n\",\"\\n\",\"Status: MEDIAPIPE_ENVIRONMENT_READY\\n\",\"JSON reload: PASS\\n\",\"Saved: /content/drive/MyDrive/Experiment_20_Results/step_3_2/experiment20_step3214_mediapipe_environment_audit.json\\n\",\"\\n\",\"Model asset downloaded: NO\\n\",\"Inference: NO\\n\",\"Aligned images generated: NO\\n\",\"Frozen data modified: NO\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.2.15\\n\",\"## Face Landmarker Model Asset Acquisition and Integrity\\n\",\"\\n\",\"### Objective\\n\",\"Acquire the official MediaPipe Face Landmarker model asset\\n\",\"for the controlled 30-image pilot.\\n\",\"\\n\",\"Official model documentation:\\n\",\"https://developers.google.com/edge/mediapipe/solutions/vision/face_landmarker\\n\",\"\\n\",\"### Requirements\\n\",\"- Download the official Face Landmarker task model.\\n\",\"- Record the source URL.\\n\",\"- Record file size and SHA256.\\n\",\"- Verify that the file is non-empty.\\n\",\"- Preserve the model asset separately from the frozen dataset.\\n\",\"\\n\",\"### Restrictions\\n\",\"- No inference.\\n\",\"- No aligned image generation.\\n\",\"- No modification of frozen source images.\\n\",\"- No modification of existing FaceNet embeddings.\\n\",\"\\n\",\"### Important\\n\",\"The model asset is an additional experimental dependency.\\n\",\"Its checksum must be retained for reproducibility.\"],\"metadata\":{\"id\":\"PP1MjOow6zOK\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import urllib.request\\n\",\"import hashlib\\n\",\"import json\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"STEP_DIR = BASE / \\\"step_3_2\\\"\\n\",\"MODEL_DIR = BASE / \\\"model_assets\\\"\\n\",\"MODEL_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"MODEL_URL = (\\n\",\"    \\\"https://storage.googleapis.com/mediapipe-models/\\\"\\n\",\"    \\\"face_landmarker/face_landmarker/float16/1/\\\"\\n\",\"    \\\"face_landmarker.task\\\"\\n\",\")\\n\",\"\\n\",\"MODEL_PATH = MODEL_DIR / \\\"face_landmarker.task\\\"\\n\",\"\\n\",\"OUTPUT_FILE = STEP_DIR / (\\n\",\"    \\\"experiment20_step3215_landmarker_asset_audit.json\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.2.15\\\")\\n\",\"print(\\\"FACE LANDMARKER MODEL ASSET ACQUISITION\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"if not MODEL_PATH.exists():\\n\",\"    print(\\\"Downloading official model asset...\\\")\\n\",\"    urllib.request.urlretrieve(MODEL_URL, MODEL_PATH)\\n\",\"else:\\n\",\"    print(\\\"Existing model asset found; verifying it.\\\")\\n\",\"\\n\",\"assert MODEL_PATH.exists(), \\\"Model asset was not created.\\\"\\n\",\"\\n\",\"file_size = MODEL_PATH.stat().st_size\\n\",\"assert file_size > 0, \\\"Model asset is empty.\\\"\\n\",\"\\n\",\"sha256 = hashlib.sha256()\\n\",\"\\n\",\"with open(MODEL_PATH, \\\"rb\\\") as f:\\n\",\"    for chunk in iter(lambda: f.read(1024 * 1024), b\\\"\\\"):\\n\",\"        sha256.update(chunk)\\n\",\"\\n\",\"digest = sha256.hexdigest()\\n\",\"\\n\",\"record = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"step\\\": \\\"3.2.15\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"model_name\\\": \\\"MediaPipe Face Landmarker\\\",\\n\",\"    \\\"model_variant\\\": \\\"float16\\\",\\n\",\"    \\\"source_url\\\": MODEL_URL,\\n\",\"    \\\"local_path\\\": str(MODEL_PATH),\\n\",\"    \\\"file_size_bytes\\\": file_size,\\n\",\"    \\\"sha256\\\": digest,\\n\",\"    \\\"file_exists\\\": MODEL_PATH.exists(),\\n\",\"    \\\"non_empty\\\": file_size > 0,\\n\",\"    \\\"inference_performed\\\": False,\\n\",\"    \\\"aligned_images_generated\\\": False,\\n\",\"    \\\"frozen_data_modified\\\": False,\\n\",\"    \\\"status\\\": \\\"MODEL_ASSET_DOWNLOADED_AND_HASHED\\\"\\n\",\"}\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"w\\\") as f:\\n\",\"    json.dump(record, f, indent=2)\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"r\\\") as f:\\n\",\"    reloaded = json.load(f)\\n\",\"\\n\",\"print(\\\"\\\\nFile:\\\", MODEL_PATH.name)\\n\",\"print(\\\"Size (bytes):\\\", file_size)\\n\",\"print(\\\"SHA256:\\\", digest)\\n\",\"print(\\\"File exists:\\\", record[\\\"file_exists\\\"])\\n\",\"print(\\\"Non-empty:\\\", record[\\\"non_empty\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nStatus:\\\", record[\\\"status\\\"])\\n\",\"print(\\\"JSON reload:\\\", \\\"PASS\\\" if reloaded == record else \\\"FAIL\\\")\\n\",\"print(\\\"Saved:\\\", OUTPUT_FILE)\\n\",\"\\n\",\"print(\\\"\\\\nInference: NO\\\")\\n\",\"print(\\\"Aligned images generated: NO\\\")\\n\",\"print(\\\"Frozen data modified: NO\\\")\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"S6t5BHJ_6wyQ\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794389006209,\"user_tz\":360,\"elapsed\":334,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"1c29daa1-9822-4aff-b266-1f4c4f217b08\"},\"execution_count\":40,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.2.15\\n\",\"FACE LANDMARKER MODEL ASSET ACQUISITION\\n\",\"========================================================================================\\n\",\"Downloading official model asset...\\n\",\"\\n\",\"File: face_landmarker.task\\n\",\"Size (bytes): 3758596\\n\",\"SHA256: 64184e229b263107bc2b804c6625db1341ff2bb731874b0bcc2fe6544e0bc9ff\\n\",\"File exists: True\\n\",\"Non-empty: True\\n\",\"\\n\",\"Status: MODEL_ASSET_DOWNLOADED_AND_HASHED\\n\",\"JSON reload: PASS\\n\",\"Saved: /content/drive/MyDrive/Experiment_20_Results/step_3_2/experiment20_step3215_landmarker_asset_audit.json\\n\",\"\\n\",\"Inference: NO\\n\",\"Aligned images generated: NO\\n\",\"Frozen data modified: NO\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.2.16\\n\",\"## MediaPipe 30-Image Landmark Detection Pilot\\n\",\"\\n\",\"### Objective\\n\",\"Evaluate MediaPipe Face Landmarker detection performance on the\\n\",\"predefined 30-image pilot sample.\\n\",\"\\n\",\"### Input\\n\",\"- 10 near-frontal images\\n\",\"- 10 oblique images\\n\",\"- 10 large-angular images\\n\",\"- Original frozen Yale B source images\\n\",\"- Verified Face Landmarker float16 model asset\\n\",\"\\n\",\"### Measurements\\n\",\"1. Successful image processing.\\n\",\"2. Number of detected faces per image.\\n\",\"3. Whether a face was detected.\\n\",\"4. Number of returned facial landmarks.\\n\",\"5. Detection failures by illumination group.\\n\",\"6. Processing exceptions.\\n\",\"\\n\",\"### Important\\n\",\"A detection is considered successful only when exactly one face\\n\",\"is returned with a complete landmark set.\\n\",\"\\n\",\"This is a detection-feasibility pilot, not an alignment validation.\\n\",\"\\n\",\"### Restrictions\\n\",\"- Process only the 30 predefined images.\\n\",\"- Do not generate aligned images.\\n\",\"- Do not regenerate FaceNet embeddings.\\n\",\"- Do not change the frozen dataset.\\n\",\"- Preserve all detection failures in the output.\"],\"metadata\":{\"id\":\"95w1YlCw7Bi9\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"from zipfile import ZipFile\\n\",\"import io\\n\",\"import json\\n\",\"import hashlib\\n\",\"import numpy as np\\n\",\"import mediapipe as mp\\n\",\"from PIL import Image\\n\",\"from collections import Counter, defaultdict\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"STEP_DIR = BASE / \\\"step_3_2\\\"\\n\",\"\\n\",\"MANIFEST_FILE = STEP_DIR / (\\n\",\"    \\\"experiment20_step3213_mediapipe_pilot_sample_manifest.json\\\"\\n\",\")\\n\",\"\\n\",\"MODEL_PATH = BASE / \\\"model_assets\\\" / \\\"face_landmarker.task\\\"\\n\",\"\\n\",\"OUTPUT_FILE = STEP_DIR / (\\n\",\"    \\\"experiment20_step3216_mediapipe_detection_pilot.json\\\"\\n\",\")\\n\",\"\\n\",\"EXPECTED_MODEL_SHA256 = (\\n\",\"    \\\"64184e229b263107bc2b804c6625db1341ff2bb731874b0bcc2fe6544e0bc9ff\\\"\\n\",\")\\n\",\"\\n\",\"EXPECTED_SOURCE_SHA256 = (\\n\",\"    \\\"8bbabf3836d077d60626c9ee3c54c2d2851a8d2c15c8b7e13b9bc162e86ea573\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.2.16\\\")\\n\",\"print(\\\"MEDIAPIPE 30-IMAGE LANDMARK DETECTION PILOT\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"assert MANIFEST_FILE.exists(), \\\"Pilot sample manifest missing.\\\"\\n\",\"assert MODEL_PATH.exists(), \\\"Landmarker model asset missing.\\\"\\n\",\"\\n\",\"with open(MANIFEST_FILE) as f:\\n\",\"    manifest = json.load(f)\\n\",\"\\n\",\"assert manifest[\\\"sample_size\\\"] == 30\\n\",\"assert manifest[\\\"status\\\"] == \\\"PILOT_SAMPLE_READY\\\"\\n\",\"\\n\",\"model_hash = hashlib.sha256(MODEL_PATH.read_bytes()).hexdigest()\\n\",\"assert model_hash == EXPECTED_MODEL_SHA256, \\\"Model checksum mismatch.\\\"\\n\",\"\\n\",\"FROZEN_ZIP = BASE / \\\"Experiment_20_Stage_2_Frozen_Dataset.zip\\\"\\n\",\"assert FROZEN_ZIP.exists(), \\\"Frozen dataset ZIP missing.\\\"\\n\",\"\\n\",\"with ZipFile(FROZEN_ZIP, \\\"r\\\") as frozen_zip:\\n\",\"    nested_name = (\\n\",\"        \\\"Experiment_20_Stage_2_Frozen_Dataset/source/CroppedYale.zip\\\"\\n\",\"    )\\n\",\"    nested_bytes = frozen_zip.read(nested_name)\\n\",\"\\n\",\"source_hash = hashlib.sha256(nested_bytes).hexdigest()\\n\",\"assert source_hash == EXPECTED_SOURCE_SHA256, \\\"Source archive checksum mismatch.\\\"\\n\",\"\\n\",\"source_zip = ZipFile(io.BytesIO(nested_bytes), \\\"r\\\")\\n\",\"\\n\",\"# Build exact basename lookup for the selected original source images.\\n\",\"source_lookup = {}\\n\",\"\\n\",\"for member in source_zip.namelist():\\n\",\"    if member.lower().endswith(\\\".pgm\\\"):\\n\",\"        basename = Path(member).name\\n\",\"        source_lookup[basename] = member\\n\",\"\\n\",\"# Configure Face Landmarker in IMAGE mode.\\n\",\"BaseOptions = mp.tasks.BaseOptions\\n\",\"FaceLandmarker = mp.tasks.vision.FaceLandmarker\\n\",\"FaceLandmarkerOptions = mp.tasks.vision.FaceLandmarkerOptions\\n\",\"RunningMode = mp.tasks.vision.RunningMode\\n\",\"\\n\",\"options = FaceLandmarkerOptions(\\n\",\"    base_options=BaseOptions(model_asset_path=str(MODEL_PATH)),\\n\",\"    running_mode=RunningMode.IMAGE,\\n\",\"    num_faces=2\\n\",\")\\n\",\"\\n\",\"results = []\\n\",\"exceptions = []\\n\",\"\\n\",\"group_counts = defaultdict(Counter)\\n\",\"\\n\",\"with FaceLandmarker.create_from_options(options) as landmarker:\\n\",\"\\n\",\"    for i, record in enumerate(manifest[\\\"records\\\"], start=1):\\n\",\"\\n\",\"        filename = record[\\\"filename\\\"]\\n\",\"        group = record[\\\"illumination_group\\\"]\\n\",\"\\n\",\"        if filename not in source_lookup:\\n\",\"            result_record = {\\n\",\"                **record,\\n\",\"                \\\"processing_status\\\": \\\"SOURCE_IMAGE_NOT_FOUND\\\",\\n\",\"                \\\"face_count\\\": None,\\n\",\"                \\\"landmark_count\\\": None,\\n\",\"                \\\"detection_success\\\": False\\n\",\"            }\\n\",\"            results.append(result_record)\\n\",\"            group_counts[group][\\\"source_missing\\\"] += 1\\n\",\"            continue\\n\",\"\\n\",\"        try:\\n\",\"            image_bytes = source_zip.read(source_lookup[filename])\\n\",\"\\n\",\"            with Image.open(io.BytesIO(image_bytes)) as pil_image:\\n\",\"                pil_image.load()\\n\",\"                rgb_image = pil_image.convert(\\\"RGB\\\")\\n\",\"\\n\",\"            image_array = np.asarray(rgb_image)\\n\",\"\\n\",\"            mp_image = mp.Image(\\n\",\"                image_format=mp.ImageFormat.SRGB,\\n\",\"                data=image_array\\n\",\"            )\\n\",\"\\n\",\"            detection = landmarker.detect(mp_image)\\n\",\"\\n\",\"            face_count = len(detection.face_landmarks)\\n\",\"\\n\",\"            landmark_counts = [\\n\",\"                len(face)\\n\",\"                for face in detection.face_landmarks\\n\",\"            ]\\n\",\"\\n\",\"            # A successful result requires exactly one face\\n\",\"            # with all 478 landmarks.\\n\",\"            success = (\\n\",\"                face_count == 1\\n\",\"                and landmark_counts[0] == 478\\n\",\"            )\\n\",\"\\n\",\"            result_record = {\\n\",\"                **record,\\n\",\"                \\\"processing_status\\\": \\\"PROCESSED\\\",\\n\",\"                \\\"face_count\\\": face_count,\\n\",\"                \\\"landmark_counts\\\": landmark_counts,\\n\",\"                \\\"landmark_count\\\": (\\n\",\"                    landmark_counts[0] if face_count == 1 else None\\n\",\"                ),\\n\",\"                \\\"detection_success\\\": success\\n\",\"            }\\n\",\"\\n\",\"            group_counts[group][\\\"processed\\\"] += 1\\n\",\"            group_counts[group][\\n\",\"                \\\"successful\\\" if success else \\\"unsuccessful\\\"\\n\",\"            ] += 1\\n\",\"\\n\",\"        except Exception as exc:\\n\",\"            result_record = {\\n\",\"                **record,\\n\",\"                \\\"processing_status\\\": \\\"EXCEPTION\\\",\\n\",\"                \\\"face_count\\\": None,\\n\",\"                \\\"landmark_count\\\": None,\\n\",\"                \\\"detection_success\\\": False,\\n\",\"                \\\"exception\\\": repr(exc)\\n\",\"            }\\n\",\"\\n\",\"            group_counts[group][\\\"exceptions\\\"] += 1\\n\",\"            exceptions.append({\\n\",\"                \\\"filename\\\": filename,\\n\",\"                \\\"exception\\\": repr(exc)\\n\",\"            })\\n\",\"\\n\",\"        results.append(result_record)\\n\",\"\\n\",\"        if i % 5 == 0:\\n\",\"            print(f\\\"Processed: {i}/30\\\")\\n\",\"\\n\",\"source_zip.close()\\n\",\"\\n\",\"total_success = sum(\\n\",\"    r[\\\"detection_success\\\"] for r in results\\n\",\")\\n\",\"\\n\",\"total_processed = sum(\\n\",\"    r[\\\"processing_status\\\"] == \\\"PROCESSED\\\"\\n\",\"    for r in results\\n\",\")\\n\",\"\\n\",\"summary_by_group = {}\\n\",\"\\n\",\"for group in [\\n\",\"    \\\"near_frontal\\\",\\n\",\"    \\\"oblique\\\",\\n\",\"    \\\"large_angular\\\"\\n\",\"]:\\n\",\"    group_records = [\\n\",\"        r for r in results\\n\",\"        if r[\\\"illumination_group\\\"] == group\\n\",\"    ]\\n\",\"\\n\",\"    summary_by_group[group] = {\\n\",\"        \\\"total\\\": len(group_records),\\n\",\"        \\\"processed\\\": sum(\\n\",\"            r[\\\"processing_status\\\"] == \\\"PROCESSED\\\"\\n\",\"            for r in group_records\\n\",\"        ),\\n\",\"        \\\"successful\\\": sum(\\n\",\"            r[\\\"detection_success\\\"]\\n\",\"            for r in group_records\\n\",\"        ),\\n\",\"        \\\"unsuccessful\\\": sum(\\n\",\"            not r[\\\"detection_success\\\"]\\n\",\"            for r in group_records\\n\",\"        )\\n\",\"    }\\n\",\"\\n\",\"audit_checks = {\\n\",\"    \\\"30_pilot_records_processed\\\": len(results) == 30,\\n\",\"    \\\"all_source_images_found\\\": all(\\n\",\"        r[\\\"processing_status\\\"] != \\\"SOURCE_IMAGE_NOT_FOUND\\\"\\n\",\"        for r in results\\n\",\"    ),\\n\",\"    \\\"model_checksum_verified\\\": model_hash == EXPECTED_MODEL_SHA256,\\n\",\"    \\\"source_checksum_verified\\\": source_hash == EXPECTED_SOURCE_SHA256,\\n\",\"    \\\"all_three_groups_present\\\": all(\\n\",\"        summary_by_group[g][\\\"total\\\"] == 10\\n\",\"        for g in summary_by_group\\n\",\"    ),\\n\",\"    \\\"all_results_recorded\\\": len(results) == 30\\n\",\"}\\n\",\"\\n\",\"output = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"step\\\": \\\"3.2.16\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"model\\\": \\\"MediaPipe Face Landmarker\\\",\\n\",\"    \\\"model_sha256\\\": model_hash,\\n\",\"    \\\"source_archive_sha256\\\": source_hash,\\n\",\"    \\\"sample_size\\\": 30,\\n\",\"    \\\"processed_count\\\": total_processed,\\n\",\"    \\\"successful_detection_count\\\": total_success,\\n\",\"    \\\"overall_detection_rate\\\": total_success / 30,\\n\",\"    \\\"group_summary\\\": summary_by_group,\\n\",\"    \\\"exceptions\\\": exceptions,\\n\",\"    \\\"results\\\": results,\\n\",\"    \\\"audit_checks\\\": audit_checks,\\n\",\"    \\\"passed_checks\\\": sum(audit_checks.values()),\\n\",\"    \\\"total_checks\\\": len(audit_checks),\\n\",\"    \\\"status\\\": (\\n\",\"        \\\"DETECTION_PILOT_COMPLETED\\\"\\n\",\"        if all(audit_checks.values())\\n\",\"        else \\\"DETECTION_PILOT_AUDIT_FAILED\\\"\\n\",\"    ),\\n\",\"    \\\"restrictions\\\": {\\n\",\"        \\\"aligned_images_generated\\\": False,\\n\",\"        \\\"embeddings_generated\\\": False,\\n\",\"        \\\"frozen_data_modified\\\": False\\n\",\"    }\\n\",\"}\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"w\\\") as f:\\n\",\"    json.dump(output, f, indent=2)\\n\",\"\\n\",\"with open(OUTPUT_FILE) as f:\\n\",\"    reloaded = json.load(f)\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 88)\\n\",\"print(\\\"DETECTION PILOT SUMMARY\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"print(\\\"Images processed:\\\", total_processed, \\\"/ 30\\\")\\n\",\"print(\\\"Successful detections:\\\", total_success, \\\"/ 30\\\")\\n\",\"print(f\\\"Overall detection rate: {total_success / 30:.2%}\\\")\\n\",\"\\n\",\"for group, summary in summary_by_group.items():\\n\",\"    print(\\n\",\"        f\\\"{group}: \\\"\\n\",\"        f\\\"{summary['successful']}/{summary['total']} successful\\\"\\n\",\"    )\\n\",\"\\n\",\"print(\\\"\\\\nAUDIT\\\")\\n\",\"for name, passed in audit_checks.items():\\n\",\"    print(f\\\"{name}: {'PASS' if passed else 'FAIL'}\\\")\\n\",\"\\n\",\"print(\\\"\\\\nPassed:\\\", sum(audit_checks.values()), \\\"/\\\", len(audit_checks))\\n\",\"print(\\\"JSON reload:\\\", \\\"PASS\\\" if reloaded == output else \\\"FAIL\\\")\\n\",\"print(\\\"Saved:\\\", OUTPUT_FILE)\\n\",\"\\n\",\"print(\\\"\\\\nAligned images generated: NO\\\")\\n\",\"print(\\\"FaceNet embeddings generated: NO\\\")\\n\",\"print(\\\"Frozen data modified: NO\\\")\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"CVKLFVJL7DQT\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794389068928,\"user_tz\":360,\"elapsed\":3880,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"4bd32507-9e3e-45a5-c200-2712a6b0c24b\"},\"execution_count\":41,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.2.16\\n\",\"MEDIAPIPE 30-IMAGE LANDMARK DETECTION PILOT\\n\",\"========================================================================================\\n\",\"Processed: 5/30\\n\",\"Processed: 10/30\\n\",\"Processed: 15/30\\n\",\"Processed: 20/30\\n\",\"Processed: 25/30\\n\",\"Processed: 30/30\\n\",\"\\n\",\"========================================================================================\\n\",\"DETECTION PILOT SUMMARY\\n\",\"========================================================================================\\n\",\"Images processed: 30 / 30\\n\",\"Successful detections: 18 / 30\\n\",\"Overall detection rate: 60.00%\\n\",\"near_frontal: 8/10 successful\\n\",\"oblique: 8/10 successful\\n\",\"large_angular: 2/10 successful\\n\",\"\\n\",\"AUDIT\\n\",\"30_pilot_records_processed: PASS\\n\",\"all_source_images_found: PASS\\n\",\"model_checksum_verified: PASS\\n\",\"source_checksum_verified: PASS\\n\",\"all_three_groups_present: PASS\\n\",\"all_results_recorded: PASS\\n\",\"\\n\",\"Passed: 6 / 6\\n\",\"JSON reload: PASS\\n\",\"Saved: /content/drive/MyDrive/Experiment_20_Results/step_3_2/experiment20_step3216_mediapipe_detection_pilot.json\\n\",\"\\n\",\"Aligned images generated: NO\\n\",\"FaceNet embeddings generated: NO\\n\",\"Frozen data modified: NO\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.2.17\\n\",\"## MediaPipe Detection Failure Analysis\\n\",\"\\n\",\"### Objective\\n\",\"Classify the 30-image pilot outcomes and investigate the\\n\",\"12 unsuccessful detections.\\n\",\"\\n\",\"### Analysis\\n\",\"- Count zero-face detections.\\n\",\"- Count multiple-face detections.\\n\",\"- Count incomplete landmark outputs.\\n\",\"- Count successful 478-landmark detections.\\n\",\"- Summarise failures by illumination group.\\n\",\"- Preserve all original pilot records.\\n\",\"\\n\",\"### Restrictions\\n\",\"- No new inference.\\n\",\"- No image alignment.\\n\",\"- No embedding generation.\\n\",\"- No modification of frozen source data.\\n\",\"\\n\",\"### Decision requirement\\n\",\"Determine whether failures are predominantly caused by\\n\",\"large-angular illumination or are distributed across groups.\"],\"metadata\":{\"id\":\"EmL1YL4m7OTo\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"from collections import Counter, defaultdict\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"STEP_DIR = BASE / \\\"step_3_2\\\"\\n\",\"\\n\",\"INPUT_FILE = STEP_DIR / (\\n\",\"    \\\"experiment20_step3216_mediapipe_detection_pilot.json\\\"\\n\",\")\\n\",\"\\n\",\"OUTPUT_FILE = STEP_DIR / (\\n\",\"    \\\"experiment20_step3217_detection_failure_analysis.json\\\"\\n\",\")\\n\",\"\\n\",\"assert INPUT_FILE.exists(), \\\"Step 3.2.16 result missing.\\\"\\n\",\"\\n\",\"with open(INPUT_FILE) as f:\\n\",\"    pilot = json.load(f)\\n\",\"\\n\",\"results = pilot[\\\"results\\\"]\\n\",\"\\n\",\"assert len(results) == 30, \\\"Expected exactly 30 pilot records.\\\"\\n\",\"\\n\",\"failure_types = Counter()\\n\",\"group_analysis = defaultdict(Counter)\\n\",\"classified_records = []\\n\",\"\\n\",\"for record in results:\\n\",\"\\n\",\"    face_count = record.get(\\\"face_count\\\")\\n\",\"    landmark_counts = record.get(\\\"landmark_counts\\\", [])\\n\",\"\\n\",\"    if record[\\\"processing_status\\\"] == \\\"EXCEPTION\\\":\\n\",\"        failure_type = \\\"processing_exception\\\"\\n\",\"\\n\",\"    elif record[\\\"processing_status\\\"] == \\\"SOURCE_IMAGE_NOT_FOUND\\\":\\n\",\"        failure_type = \\\"source_image_missing\\\"\\n\",\"\\n\",\"    elif face_count == 0:\\n\",\"        failure_type = \\\"no_face_detected\\\"\\n\",\"\\n\",\"    elif face_count is not None and face_count > 1:\\n\",\"        failure_type = \\\"multiple_faces_detected\\\"\\n\",\"\\n\",\"    elif face_count == 1 and (\\n\",\"        not landmark_counts or landmark_counts[0] != 478\\n\",\"    ):\\n\",\"        failure_type = \\\"incomplete_landmark_output\\\"\\n\",\"\\n\",\"    elif record[\\\"detection_success\\\"]:\\n\",\"        failure_type = \\\"successful_478_landmark_detection\\\"\\n\",\"\\n\",\"    else:\\n\",\"        failure_type = \\\"unclassified_failure\\\"\\n\",\"\\n\",\"    failure_types[failure_type] += 1\\n\",\"    group_analysis[record[\\\"illumination_group\\\"]][failure_type] += 1\\n\",\"\\n\",\"    classified_records.append({\\n\",\"        \\\"filename\\\": record[\\\"filename\\\"],\\n\",\"        \\\"subject\\\": record[\\\"subject\\\"],\\n\",\"        \\\"condition\\\": record[\\\"condition\\\"],\\n\",\"        \\\"illumination_group\\\": record[\\\"illumination_group\\\"],\\n\",\"        \\\"face_count\\\": face_count,\\n\",\"        \\\"landmark_counts\\\": landmark_counts,\\n\",\"        \\\"detection_success\\\": record[\\\"detection_success\\\"],\\n\",\"        \\\"failure_type\\\": failure_type\\n\",\"    })\\n\",\"\\n\",\"failed_records = [\\n\",\"    r for r in classified_records\\n\",\"    if not r[\\\"detection_success\\\"]\\n\",\"]\\n\",\"\\n\",\"group_summary = {\\n\",\"    group: dict(counts)\\n\",\"    for group, counts in group_analysis.items()\\n\",\"}\\n\",\"\\n\",\"checks = {\\n\",\"    \\\"30_records_classified\\\": len(classified_records) == 30,\\n\",\"    \\\"all_12_unsuccessful_records_retained\\\": len(failed_records) == 12,\\n\",\"    \\\"all_three_groups_present\\\": len(group_summary) == 3,\\n\",\"    \\\"classification_counts_sum_to_30\\\": sum(failure_types.values()) == 30,\\n\",\"    \\\"original_input_records_preserved\\\": len(results) == 30\\n\",\"}\\n\",\"\\n\",\"output = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"step\\\": \\\"3.2.17\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"input_file\\\": str(INPUT_FILE),\\n\",\"    \\\"total_images\\\": len(results),\\n\",\"    \\\"failure_type_counts\\\": dict(failure_types),\\n\",\"    \\\"group_failure_analysis\\\": group_summary,\\n\",\"    \\\"failed_image_records\\\": failed_records,\\n\",\"    \\\"classified_records\\\": classified_records,\\n\",\"    \\\"checks\\\": checks,\\n\",\"    \\\"passed_checks\\\": sum(checks.values()),\\n\",\"    \\\"total_checks\\\": len(checks),\\n\",\"    \\\"interpretation\\\": (\\n\",\"        \\\"Descriptive pilot failure analysis only. \\\"\\n\",\"        \\\"Do not infer causal effects from the 30-image sample.\\\"\\n\",\"    ),\\n\",\"    \\\"status\\\": (\\n\",\"        \\\"FAILURE_ANALYSIS_COMPLETE\\\"\\n\",\"        if all(checks.values())\\n\",\"        else \\\"FAILURE_ANALYSIS_REQUIRES_REVIEW\\\"\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"w\\\") as f:\\n\",\"    json.dump(output, f, indent=2)\\n\",\"\\n\",\"with open(OUTPUT_FILE) as f:\\n\",\"    reloaded = json.load(f)\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.2.17\\\")\\n\",\"print(\\\"MEDIAPIPE DETECTION FAILURE ANALYSIS\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"print(\\\"\\\\nFailure classification:\\\")\\n\",\"for name, count in failure_types.items():\\n\",\"    print(f\\\"{name}: {count}\\\")\\n\",\"\\n\",\"print(\\\"\\\\nGroup analysis:\\\")\\n\",\"for group, counts in group_summary.items():\\n\",\"    print(group, counts)\\n\",\"\\n\",\"print(\\\"\\\\nFailed image filenames:\\\")\\n\",\"for record in failed_records:\\n\",\"    print(\\n\",\"        record[\\\"filename\\\"],\\n\",\"        \\\"|\\\",\\n\",\"        record[\\\"illumination_group\\\"],\\n\",\"        \\\"|\\\",\\n\",\"        record[\\\"failure_type\\\"]\\n\",\"    )\\n\",\"\\n\",\"print(\\\"\\\\nAudit:\\\")\\n\",\"for name, passed in checks.items():\\n\",\"    print(name, \\\"PASS\\\" if passed else \\\"FAIL\\\")\\n\",\"\\n\",\"print(\\\"\\\\nPassed:\\\", sum(checks.values()), \\\"/\\\", len(checks))\\n\",\"print(\\\"JSON reload:\\\", \\\"PASS\\\" if reloaded == output else \\\"FAIL\\\")\\n\",\"print(\\\"Saved:\\\", OUTPUT_FILE)\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"z_1pzEzJ7QTo\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794389118651,\"user_tz\":360,\"elapsed\":69,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"84a7095f-2d99-4bc0-a430-25538f9e0cf4\"},\"execution_count\":42,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.2.17\\n\",\"MEDIAPIPE DETECTION FAILURE ANALYSIS\\n\",\"========================================================================================\\n\",\"\\n\",\"Failure classification:\\n\",\"successful_478_landmark_detection: 18\\n\",\"multiple_faces_detected: 1\\n\",\"no_face_detected: 11\\n\",\"\\n\",\"Group analysis:\\n\",\"near_frontal {'successful_478_landmark_detection': 8, 'multiple_faces_detected': 1, 'no_face_detected': 1}\\n\",\"oblique {'successful_478_landmark_detection': 8, 'no_face_detected': 2}\\n\",\"large_angular {'successful_478_landmark_detection': 2, 'no_face_detected': 8}\\n\",\"\\n\",\"Failed image filenames:\\n\",\"yaleB06_P00A+010E+00.pgm | near_frontal | multiple_faces_detected\\n\",\"yaleB30_P00A+010E-20.pgm | near_frontal | no_face_detected\\n\",\"yaleB13_P00A+000E-35.pgm | oblique | no_face_detected\\n\",\"yaleB10_P00A+000E-35.pgm | oblique | no_face_detected\\n\",\"yaleB06_P00A-120E+00.pgm | large_angular | no_face_detected\\n\",\"yaleB32_P00A+000E+90.pgm | large_angular | no_face_detected\\n\",\"yaleB12_P00A-095E+00.pgm | large_angular | no_face_detected\\n\",\"yaleB20_P00A-085E+20.pgm | large_angular | no_face_detected\\n\",\"yaleB34_P00A-060E+20.pgm | large_angular | no_face_detected\\n\",\"yaleB19_P00A-070E+45.pgm | large_angular | no_face_detected\\n\",\"yaleB37_P00A-130E+20.pgm | large_angular | no_face_detected\\n\",\"yaleB30_P00A-070E+45.pgm | large_angular | no_face_detected\\n\",\"\\n\",\"Audit:\\n\",\"30_records_classified PASS\\n\",\"all_12_unsuccessful_records_retained PASS\\n\",\"all_three_groups_present PASS\\n\",\"classification_counts_sum_to_30 PASS\\n\",\"original_input_records_preserved PASS\\n\",\"\\n\",\"Passed: 5 / 5\\n\",\"JSON reload: PASS\\n\",\"Saved: /content/drive/MyDrive/Experiment_20_Results/step_3_2/experiment20_step3217_detection_failure_analysis.json\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.2.18\\n\",\"## Alignment Strategy Decision\\n\",\"\\n\",\"### Evidence\\n\",\"MediaPipe Face Landmarker was evaluated on 30 predefined images.\\n\",\"\\n\",\"Results:\\n\",\"- Near-frontal: 8/10 successful.\\n\",\"- Oblique: 8/10 successful.\\n\",\"- Large-angular: 2/10 successful.\\n\",\"- Overall: 18/30 successful.\\n\",\"- No-face detections: 11.\\n\",\"- Multiple-face detections: 1.\\n\",\"\\n\",\"### Decision\\n\",\"Reject MediaPipe as the full-cohort alignment method in its\\n\",\"current configuration.\\n\",\"\\n\",\"### Reasons\\n\",\"1. Detection failure is concentrated in large-angular illumination.\\n\",\"2. Successful-only processing would create selection bias.\\n\",\"3. Unequal image coverage would weaken group comparisons.\\n\",\"4. The pilot does not establish reliable alignment across conditions.\\n\",\"\\n\",\"### Existing results\\n\",\"The original FaceNet embeddings and descriptive analysis remain\\n\",\"unchanged. This decision applies only to the proposed additional\\n\",\"model evaluation.\\n\",\"\\n\",\"### Remaining options\\n\",\"A. Retain the original FaceNet-only descriptive study.\\n\",\"B. Investigate a different alignment method using the same\\n\",\"   predefined pilot sample.\\n\",\"C. Redesign the additional-model evaluation around a clearly\\n\",\"   documented common preprocessing procedure, if technically\\n\",\"   and scientifically defensible.\\n\",\"\\n\",\"No option is approved automatically.\\n\",\"\\n\",\"### Restrictions\\n\",\"- No further model inference.\\n\",\"- No aligned image generation.\\n\",\"- No changes to frozen images.\\n\",\"- No changes to existing embeddings.\"],\"metadata\":{\"id\":\"txkWDt8k7ZCc\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"STEP_DIR = BASE / \\\"step_3_2\\\"\\n\",\"\\n\",\"INPUT_FILE = STEP_DIR / (\\n\",\"    \\\"experiment20_step3217_detection_failure_analysis.json\\\"\\n\",\")\\n\",\"\\n\",\"OUTPUT_FILE = STEP_DIR / (\\n\",\"    \\\"experiment20_step3218_alignment_strategy_decision.json\\\"\\n\",\")\\n\",\"\\n\",\"assert INPUT_FILE.exists(), \\\"Step 3.2.17 audit missing.\\\"\\n\",\"\\n\",\"with open(INPUT_FILE) as f:\\n\",\"    failure_audit = json.load(f)\\n\",\"\\n\",\"assert failure_audit[\\\"total_images\\\"] == 30\\n\",\"\\n\",\"failure_counts = failure_audit[\\\"failure_type_counts\\\"]\\n\",\"\\n\",\"successes = failure_counts[\\\"successful_478_landmark_detection\\\"]\\n\",\"no_face = failure_counts[\\\"no_face_detected\\\"]\\n\",\"multiple_faces = failure_counts[\\\"multiple_faces_detected\\\"]\\n\",\"\\n\",\"assert successes == 18\\n\",\"assert no_face == 11\\n\",\"assert multiple_faces == 1\\n\",\"\\n\",\"large_angular = failure_audit[\\\"group_failure_analysis\\\"][\\\"large_angular\\\"]\\n\",\"\\n\",\"assert large_angular[\\\"successful_478_landmark_detection\\\"] == 2\\n\",\"assert large_angular[\\\"no_face_detected\\\"] == 8\\n\",\"\\n\",\"decision = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"step\\\": \\\"3.2.18\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"\\n\",\"    \\\"evidence_source\\\": str(INPUT_FILE),\\n\",\"\\n\",\"    \\\"pilot_results\\\": {\\n\",\"        \\\"total_images\\\": 30,\\n\",\"        \\\"successful_detections\\\": successes,\\n\",\"        \\\"no_face_detections\\\": no_face,\\n\",\"        \\\"multiple_face_detections\\\": multiple_faces,\\n\",\"        \\\"overall_success_rate\\\": successes / 30,\\n\",\"        \\\"group_results\\\": {\\n\",\"            group: {\\n\",\"                \\\"successful\\\": counts.get(\\n\",\"                    \\\"successful_478_landmark_detection\\\", 0\\n\",\"                ),\\n\",\"                \\\"no_face\\\": counts.get(\\\"no_face_detected\\\", 0),\\n\",\"                \\\"multiple_faces\\\": counts.get(\\n\",\"                    \\\"multiple_faces_detected\\\", 0\\n\",\"                )\\n\",\"            }\\n\",\"            for group, counts in failure_audit[\\n\",\"                \\\"group_failure_analysis\\\"\\n\",\"            ].items()\\n\",\"        }\\n\",\"    },\\n\",\"\\n\",\"    \\\"decision\\\": (\\n\",\"        \\\"REJECT_MEDIAPIPE_FOR_FULL_COHORT_ALIGNMENT\\\"\\n\",\"    ),\\n\",\"\\n\",\"    \\\"reasons\\\": [\\n\",\"        \\\"Overall pilot detection success was 18/30.\\\",\\n\",\"        \\\"Large-angular detection success was only 2/10.\\\",\\n\",\"        \\\"Eight of ten large-angular images had no face detected.\\\",\\n\",\"        \\\"Successful-only processing would introduce selection bias.\\\",\\n\",\"        \\\"The pilot does not establish reliable full-cohort alignment.\\\"\\n\",\"    ],\\n\",\"\\n\",\"    \\\"impact_on_existing_analysis\\\": {\\n\",\"        \\\"original_facenet_embeddings_modified\\\": False,\\n\",\"        \\\"original_displacement_results_modified\\\": False,\\n\",\"        \\\"original_dataset_modified\\\": False,\\n\",\"        \\\"existing_descriptive_analysis_invalidated\\\": False\\n\",\"    },\\n\",\"\\n\",\"    \\\"remaining_options\\\": {\\n\",\"        \\\"A\\\": \\\"Retain the original FaceNet-only descriptive study.\\\",\\n\",\"        \\\"B\\\": \\\"Investigate a different alignment method using the same pilot.\\\",\\n\",\"        \\\"C\\\": \\\"Redesign additional-model evaluation around defensible \\\"\\n\",\"             \\\"common preprocessing.\\\"\\n\",\"    },\\n\",\"\\n\",\"    \\\"model_selection\\\": \\\"NONE\\\",\\n\",\"    \\\"full_cohort_alignment_authorized\\\": False,\\n\",\"\\n\",\"    \\\"restrictions\\\": {\\n\",\"        \\\"additional_inference\\\": False,\\n\",\"        \\\"aligned_images_generated\\\": False,\\n\",\"        \\\"embeddings_regenerated\\\": False,\\n\",\"        \\\"frozen_data_modified\\\": False\\n\",\"    },\\n\",\"\\n\",\"    \\\"status\\\": \\\"ALIGNMENT_STRATEGY_DECISION_RECORDED\\\"\\n\",\"}\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"w\\\") as f:\\n\",\"    json.dump(decision, f, indent=2)\\n\",\"\\n\",\"with open(OUTPUT_FILE) as f:\\n\",\"    reloaded = json.load(f)\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.2.18\\\")\\n\",\"print(\\\"ALIGNMENT STRATEGY DECISION\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"print(\\\"Overall success:\\\", successes, \\\"/ 30\\\")\\n\",\"print(\\\"No face detected:\\\", no_face)\\n\",\"print(\\\"Multiple faces:\\\", multiple_faces)\\n\",\"\\n\",\"print(\\\"\\\\nGroup results:\\\")\\n\",\"for group, values in decision[\\\"pilot_results\\\"][\\\"group_results\\\"].items():\\n\",\"    print(group, values)\\n\",\"\\n\",\"print(\\\"\\\\nDecision:\\\", decision[\\\"decision\\\"])\\n\",\"print(\\\"Existing FaceNet results modified: NO\\\")\\n\",\"print(\\\"Full-cohort alignment authorized: NO\\\")\\n\",\"\\n\",\"print(\\\"\\\\nJSON reload:\\\", \\\"PASS\\\" if reloaded == decision else \\\"FAIL\\\")\\n\",\"print(\\\"Saved:\\\", OUTPUT_FILE)\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"ovwwz4yt7a8l\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794389161852,\"user_tz\":360,\"elapsed\":85,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"7242f5e1-18ed-49b9-b9e5-87de5cfc28d4\"},\"execution_count\":43,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.2.18\\n\",\"ALIGNMENT STRATEGY DECISION\\n\",\"========================================================================================\\n\",\"Overall success: 18 / 30\\n\",\"No face detected: 11\\n\",\"Multiple faces: 1\\n\",\"\\n\",\"Group results:\\n\",\"near_frontal {'successful': 8, 'no_face': 1, 'multiple_faces': 1}\\n\",\"oblique {'successful': 8, 'no_face': 2, 'multiple_faces': 0}\\n\",\"large_angular {'successful': 2, 'no_face': 8, 'multiple_faces': 0}\\n\",\"\\n\",\"Decision: REJECT_MEDIAPIPE_FOR_FULL_COHORT_ALIGNMENT\\n\",\"Existing FaceNet results modified: NO\\n\",\"Full-cohort alignment authorized: NO\\n\",\"\\n\",\"JSON reload: PASS\\n\",\"Saved: /content/drive/MyDrive/Experiment_20_Results/step_3_2/experiment20_step3218_alignment_strategy_decision.json\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.2.19\\n\",\"## Publication Strategy Decision\\n\",\"\\n\",\"### Objective\\n\",\"Select a defensible publication direction based on the completed\\n\",\"Yale B analysis and additional-model feasibility investigation.\\n\",\"\\n\",\"### Available strategies\\n\",\"\\n\",\"#### Strategy A — Descriptive empirical study\\n\",\"Retain the existing FaceNet-only analysis.\\n\",\"\\n\",\"Scope:\\n\",\"- One pretrained FaceNet architecture.\\n\",\"- 38 identities.\\n\",\"- 57 common illumination conditions.\\n\",\"- 2,128 evaluation observations.\\n\",\"- Reference-relative Euclidean and cosine displacement.\\n\",\"- Three illumination geometry groups.\\n\",\"- Identity-level repeated-measures comparisons.\\n\",\"- Exploratory hemisphere comparison.\\n\",\"\\n\",\"Limitations:\\n\",\"- No recognition accuracy evaluation.\\n\",\"- No calibrated drift detector.\\n\",\"- No independent architecture validation.\\n\",\"- Illumination effects cannot be isolated completely from\\n\",\"  differences between captured images.\\n\",\"\\n\",\"#### Strategy B — Multi-architecture robustness study\\n\",\"Requires additional models and a defensible common preprocessing\\n\",\"and alignment protocol.\\n\",\"\\n\",\"Current status:\\n\",\"Not feasible using the tested MediaPipe alignment configuration.\\n\",\"\\n\",\"#### Strategy C — Biometric drift detection methodology\\n\",\"Requires a separately designed study with:\\n\",\"- Multiple reference captures.\\n\",\"- Sequential or temporal drift conditions.\\n\",\"- Explicit detection algorithms.\\n\",\"- Threshold calibration.\\n\",\"- False-alarm and detection-delay evaluation.\\n\",\"- Independent validation.\\n\",\"\\n\",\"Current status:\\n\",\"Not part of the completed Experiment 20 analysis.\\n\",\"\\n\",\"### Selected strategy\\n\",\"Strategy A — Descriptive empirical study.\\n\",\"\\n\",\"### Publication positioning\\n\",\"Present the work as a controlled, identity-level descriptive\\n\",\"analysis of reference-relative FaceNet embedding displacement\\n\",\"across illumination geometry conditions.\\n\",\"\\n\",\"Do not describe the work as:\\n\",\"- A validated biometric drift detector.\\n\",\"- A robust face-recognition system.\\n\",\"- A fairness evaluation.\\n\",\"- A multi-model generalisation study.\\n\",\"- A deployment-ready biometric framework.\\n\",\"\\n\",\"### Additional-model investigation\\n\",\"Record the MediaPipe feasibility failure as a methodological\\n\",\"limitation of the proposed extension. Do not mix its pilot\\n\",\"results into the main FaceNet displacement analysis.\\n\",\"\\n\",\"### Status\\n\",\"Publication strategy selected provisionally.\\n\",\"Target journal or conference not yet selected.\"],\"metadata\":{\"id\":\"755rbat27oSs\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"STEP_DIR = BASE / \\\"step_3_2\\\"\\n\",\"\\n\",\"ALIGNMENT_DECISION = STEP_DIR / (\\n\",\"    \\\"experiment20_step3218_alignment_strategy_decision.json\\\"\\n\",\")\\n\",\"\\n\",\"OUTPUT_FILE = STEP_DIR / (\\n\",\"    \\\"experiment20_step3219_publication_strategy_decision.json\\\"\\n\",\")\\n\",\"\\n\",\"assert ALIGNMENT_DECISION.exists()\\n\",\"\\n\",\"with open(ALIGNMENT_DECISION) as f:\\n\",\"    alignment = json.load(f)\\n\",\"\\n\",\"assert alignment[\\\"decision\\\"] == (\\n\",\"    \\\"REJECT_MEDIAPIPE_FOR_FULL_COHORT_ALIGNMENT\\\"\\n\",\")\\n\",\"\\n\",\"record = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"step\\\": \\\"3.2.19\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"\\n\",\"    \\\"selected_strategy\\\": \\\"A\\\",\\n\",\"    \\\"strategy_name\\\": \\\"Descriptive empirical study\\\",\\n\",\"\\n\",\"    \\\"study_scope\\\": {\\n\",\"        \\\"architecture\\\": \\\"InceptionResnetV1 pretrained on VGGFace2\\\",\\n\",\"        \\\"subjects\\\": 38,\\n\",\"        \\\"common_illumination_conditions\\\": 57,\\n\",\"        \\\"evaluation_observations\\\": 2128,\\n\",\"        \\\"reference_condition\\\": \\\"A+000E+00\\\",\\n\",\"        \\\"metrics\\\": [\\n\",\"            \\\"Euclidean displacement\\\",\\n\",\"            \\\"Cosine distance\\\"\\n\",\"        ],\\n\",\"        \\\"illumination_groups\\\": [\\n\",\"            \\\"Near-frontal\\\",\\n\",\"            \\\"Oblique\\\",\\n\",\"            \\\"Large angular deviation\\\"\\n\",\"        ],\\n\",\"        \\\"statistical_analysis\\\": [\\n\",\"            \\\"Friedman repeated-measures test\\\",\\n\",\"            \\\"Pairwise Wilcoxon signed-rank tests\\\",\\n\",\"            \\\"Holm correction across six comparisons\\\",\\n\",\"            \\\"Identity-level bootstrap confidence intervals\\\"\\n\",\"        ]\\n\",\"    },\\n\",\"\\n\",\"    \\\"rejected_or_deferred_strategies\\\": {\\n\",\"        \\\"B\\\": {\\n\",\"            \\\"name\\\": \\\"Multi-architecture robustness study\\\",\\n\",\"            \\\"status\\\": \\\"DEFERRED\\\",\\n\",\"            \\\"reason\\\": (\\n\",\"                \\\"A reliable common alignment and preprocessing \\\"\\n\",\"                \\\"protocol has not been established.\\\"\\n\",\"            ),\\n\",\"            \\\"supporting_record\\\": str(ALIGNMENT_DECISION)\\n\",\"        },\\n\",\"        \\\"C\\\": {\\n\",\"            \\\"name\\\": \\\"Biometric drift detection methodology\\\",\\n\",\"            \\\"status\\\": \\\"SEPARATE_FUTURE_STUDY\\\",\\n\",\"            \\\"reason\\\": (\\n\",\"                \\\"Requires a separate sequential detection protocol, \\\"\\n\",\"                \\\"calibration and operational evaluation.\\\"\\n\",\"            )\\n\",\"        }\\n\",\"    },\\n\",\"\\n\",\"    \\\"publication_claim_restrictions\\\": [\\n\",\"        \\\"Do not claim validated biometric drift detection.\\\",\\n\",\"        \\\"Do not claim recognition accuracy from displacement alone.\\\",\\n\",\"        \\\"Do not claim fairness evaluation.\\\",\\n\",\"        \\\"Do not claim independent architecture generalisation.\\\",\\n\",\"        \\\"Do not claim deployment readiness.\\\",\\n\",\"        \\\"Do not attribute all displacement exclusively to illumination.\\\"\\n\",\"    ],\\n\",\"\\n\",\"    \\\"additional_model_pilot\\\": {\\n\",\"        \\\"included_in_main_analysis\\\": False,\\n\",\"        \\\"purpose\\\": \\\"Document feasibility limitations\\\",\\n\",\"        \\\"mediapipe_full_cohort_alignment_approved\\\": False\\n\",\"    },\\n\",\"\\n\",\"    \\\"target_publication\\\": None,\\n\",\"    \\\"status\\\": \\\"STRATEGY_A_SELECTED_PROVISIONALLY\\\"\\n\",\"}\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"w\\\") as f:\\n\",\"    json.dump(record, f, indent=2)\\n\",\"\\n\",\"with open(OUTPUT_FILE) as f:\\n\",\"    reloaded = json.load(f)\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.2.19\\\")\\n\",\"print(\\\"PUBLICATION STRATEGY DECISION\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"print(\\\"Selected strategy:\\\", record[\\\"selected_strategy\\\"])\\n\",\"print(\\\"Name:\\\", record[\\\"strategy_name\\\"])\\n\",\"print(\\\"Main architecture:\\\",\\n\",\"      record[\\\"study_scope\\\"][\\\"architecture\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nDeferred:\\\")\\n\",\"for key, value in record[\\\"rejected_or_deferred_strategies\\\"].items():\\n\",\"    print(key, value[\\\"name\\\"], \\\"—\\\", value[\\\"status\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nTarget publication:\\\", record[\\\"target_publication\\\"])\\n\",\"print(\\\"JSON reload:\\\", \\\"PASS\\\" if reloaded == record else \\\"FAIL\\\")\\n\",\"print(\\\"Saved:\\\", OUTPUT_FILE)\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"3pixQgMw7qQ7\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794389224719,\"user_tz\":360,\"elapsed\":103,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"dfa6f3fe-980b-43bf-b24e-586c0581491b\"},\"execution_count\":44,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.2.19\\n\",\"PUBLICATION STRATEGY DECISION\\n\",\"========================================================================================\\n\",\"Selected strategy: A\\n\",\"Name: Descriptive empirical study\\n\",\"Main architecture: InceptionResnetV1 pretrained on VGGFace2\\n\",\"\\n\",\"Deferred:\\n\",\"B Multi-architecture robustness study — DEFERRED\\n\",\"C Biometric drift detection methodology — SEPARATE_FUTURE_STUDY\\n\",\"\\n\",\"Target publication: None\\n\",\"JSON reload: PASS\\n\",\"Saved: /content/drive/MyDrive/Experiment_20_Results/step_3_2/experiment20_step3219_publication_strategy_decision.json\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.3.1\\n\",\"## Working Title, Research Question and Contributions\\n\",\"\\n\",\"### 1. Working Title\\n\",\"\\n\",\"Reference-Relative Face Embedding Displacement Across\\n\",\"Illumination Geometry Conditions: An Identity-Level Empirical Study\\n\",\"\\n\",\"### 2. Central Research Question\\n\",\"\\n\",\"How does reference-relative FaceNet embedding displacement vary\\n\",\"across illumination geometry conditions, and how consistently\\n\",\"are these differences observed across individual identities?\\n\",\"\\n\",\"### 3. Supporting Research Questions\\n\",\"\\n\",\"RQ1:\\n\",\"How do Euclidean embedding displacement and cosine distance\\n\",\"vary across near-frontal, oblique, and large-angular illumination\\n\",\"conditions?\\n\",\"\\n\",\"RQ2:\\n\",\"Are the differences between illumination geometry groups\\n\",\"consistent across the evaluated identities?\\n\",\"\\n\",\"RQ3:\\n\",\"How do reference-relative embedding displacement patterns differ\\n\",\"between frontal and beyond-frontal illumination conditions?\\n\",\"\\n\",\"RQ3 is exploratory because hemisphere comparisons involve\\n\",\"unequal numbers of illumination conditions and are confounded\\n\",\"with angular geometry.\\n\",\"\\n\",\"### 4. Research Objectives\\n\",\"\\n\",\"O1:\\n\",\"Construct identity-level reference-relative embedding\\n\",\"displacement measurements using a fixed pretrained FaceNet model.\\n\",\"\\n\",\"O2:\\n\",\"Characterise Euclidean and cosine displacement across three\\n\",\"illumination geometry groups.\\n\",\"\\n\",\"O3:\\n\",\"Evaluate differences between illumination groups using\\n\",\"repeated-measures statistical analysis.\\n\",\"\\n\",\"O4:\\n\",\"Examine the consistency of illumination-related displacement\\n\",\"patterns across identities.\\n\",\"\\n\",\"O5:\\n\",\"Explore differences between frontal and beyond-frontal\\n\",\"illumination conditions.\\n\",\"\\n\",\"### 5. Proposed Contributions\\n\",\"\\n\",\"C1:\\n\",\"An identity-level descriptive evaluation of reference-relative\\n\",\"FaceNet embedding displacement across illumination geometry\\n\",\"conditions using the Cropped Extended Yale B dataset.\\n\",\"\\n\",\"C2:\\n\",\"A comparative analysis of Euclidean displacement and cosine\\n\",\"distance across three illumination geometry groups.\\n\",\"\\n\",\"C3:\\n\",\"A repeated-measures statistical assessment of differences\\n\",\"across illumination groups, including identity-level\\n\",\"uncertainty estimates.\\n\",\"\\n\",\"C4:\\n\",\"An exploratory analysis of frontal and beyond-frontal\\n\",\"illumination conditions, with explicit acknowledgement of\\n\",\"unequal condition counts and geometric confounding.\\n\",\"\\n\",\"### 6. Scope Restrictions\\n\",\"\\n\",\"The manuscript does not claim:\\n\",\"- A new face-recognition architecture.\\n\",\"- Improved biometric recognition accuracy.\\n\",\"- A validated biometric drift detector.\\n\",\"- Fairness or demographic-bias mitigation.\\n\",\"- Independent cross-architecture generalisation.\\n\",\"- Deployment readiness.\\n\",\"\\n\",\"The evaluated images represent different captures under\\n\",\"different illumination conditions, not exact transformations\\n\",\"of the same source images. Therefore, observed displacement\\n\",\"must not be attributed exclusively to illumination.\\n\",\"\\n\",\"### 7. Status\\n\",\"\\n\",\"Working title and research framing proposed.\\n\",\"Final manuscript wording remains subject to evidence review.\"],\"metadata\":{\"id\":\"dZucG4a38buu\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"STEP_DIR = BASE / \\\"step_3_3\\\"\\n\",\"STEP_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"OUTPUT_FILE = STEP_DIR / (\\n\",\"    \\\"experiment20_step331_manuscript_research_framing.json\\\"\\n\",\")\\n\",\"\\n\",\"record = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"phase\\\": \\\"3.3\\\",\\n\",\"    \\\"step\\\": \\\"3.3.1\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"\\n\",\"    \\\"working_title\\\": (\\n\",\"        \\\"Reference-Relative Face Embedding Displacement Across \\\"\\n\",\"        \\\"Illumination Geometry Conditions: An Identity-Level \\\"\\n\",\"        \\\"Empirical Study\\\"\\n\",\"    ),\\n\",\"\\n\",\"    \\\"central_research_question\\\": (\\n\",\"        \\\"How does reference-relative FaceNet embedding displacement \\\"\\n\",\"        \\\"vary across illumination geometry conditions, and how \\\"\\n\",\"        \\\"consistently are these differences observed across \\\"\\n\",\"        \\\"individual identities?\\\"\\n\",\"    ),\\n\",\"\\n\",\"    \\\"supporting_research_questions\\\": {\\n\",\"        \\\"RQ1\\\": (\\n\",\"            \\\"How do Euclidean embedding displacement and cosine \\\"\\n\",\"            \\\"distance vary across near-frontal, oblique, and \\\"\\n\",\"            \\\"large-angular illumination conditions?\\\"\\n\",\"        ),\\n\",\"        \\\"RQ2\\\": (\\n\",\"            \\\"Are the differences between illumination geometry \\\"\\n\",\"            \\\"groups consistent across the evaluated identities?\\\"\\n\",\"        ),\\n\",\"        \\\"RQ3\\\": (\\n\",\"            \\\"How do reference-relative embedding displacement \\\"\\n\",\"            \\\"patterns differ between frontal and beyond-frontal \\\"\\n\",\"            \\\"illumination conditions?\\\"\\n\",\"        )\\n\",\"    },\\n\",\"\\n\",\"    \\\"research_objectives\\\": {\\n\",\"        \\\"O1\\\": (\\n\",\"            \\\"Construct identity-level reference-relative embedding \\\"\\n\",\"            \\\"displacement measurements using a fixed pretrained \\\"\\n\",\"            \\\"FaceNet model.\\\"\\n\",\"        ),\\n\",\"        \\\"O2\\\": (\\n\",\"            \\\"Characterise Euclidean and cosine displacement across \\\"\\n\",\"            \\\"three illumination geometry groups.\\\"\\n\",\"        ),\\n\",\"        \\\"O3\\\": (\\n\",\"            \\\"Evaluate differences between illumination groups using \\\"\\n\",\"            \\\"repeated-measures statistical analysis.\\\"\\n\",\"        ),\\n\",\"        \\\"O4\\\": (\\n\",\"            \\\"Examine the consistency of illumination-related \\\"\\n\",\"            \\\"displacement patterns across identities.\\\"\\n\",\"        ),\\n\",\"        \\\"O5\\\": (\\n\",\"            \\\"Explore differences between frontal and beyond-frontal \\\"\\n\",\"            \\\"illumination conditions.\\\"\\n\",\"        )\\n\",\"    },\\n\",\"\\n\",\"    \\\"proposed_contributions\\\": {\\n\",\"        \\\"C1\\\": (\\n\",\"            \\\"An identity-level descriptive evaluation of \\\"\\n\",\"            \\\"reference-relative FaceNet embedding displacement \\\"\\n\",\"            \\\"across illumination geometry conditions using \\\"\\n\",\"            \\\"the Cropped Extended Yale B dataset.\\\"\\n\",\"        ),\\n\",\"        \\\"C2\\\": (\\n\",\"            \\\"A comparative analysis of Euclidean displacement \\\"\\n\",\"            \\\"and cosine distance across three illumination \\\"\\n\",\"            \\\"geometry groups.\\\"\\n\",\"        ),\\n\",\"        \\\"C3\\\": (\\n\",\"            \\\"A repeated-measures statistical assessment of \\\"\\n\",\"            \\\"differences across illumination groups, including \\\"\\n\",\"            \\\"identity-level uncertainty estimates.\\\"\\n\",\"        ),\\n\",\"        \\\"C4\\\": (\\n\",\"            \\\"An exploratory analysis of frontal and beyond-frontal \\\"\\n\",\"            \\\"illumination conditions, with explicit acknowledgement \\\"\\n\",\"            \\\"of unequal condition counts and geometric confounding.\\\"\\n\",\"        )\\n\",\"    },\\n\",\"\\n\",\"    \\\"scope_restrictions\\\": [\\n\",\"        \\\"No new face-recognition architecture is claimed.\\\",\\n\",\"        \\\"No biometric recognition accuracy improvement is claimed.\\\",\\n\",\"        \\\"No validated biometric drift detector is claimed.\\\",\\n\",\"        \\\"No fairness or demographic-bias mitigation is claimed.\\\",\\n\",\"        \\\"No independent cross-architecture generalisation is claimed.\\\",\\n\",\"        \\\"No deployment readiness is claimed.\\\",\\n\",\"        \\\"Different captures are not exact transformations of \\\"\\n\",\"        \\\"the same source images.\\\",\\n\",\"        \\\"Observed displacement is not attributed exclusively \\\"\\n\",\"        \\\"to illumination.\\\"\\n\",\"    ],\\n\",\"\\n\",\"    \\\"status\\\": \\\"WORKING_RESEARCH_FRAMING_RECORDED\\\",\\n\",\"    \\\"target_journal\\\": None,\\n\",\"    \\\"target_conference\\\": None\\n\",\"}\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"w\\\") as f:\\n\",\"    json.dump(record, f, indent=2)\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"r\\\") as f:\\n\",\"    reloaded = json.load(f)\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.3.1\\\")\\n\",\"print(\\\"MANUSCRIPT RESEARCH FRAMING\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"print(\\\"\\\\nWorking title:\\\")\\n\",\"print(record[\\\"working_title\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nCentral research question:\\\")\\n\",\"print(record[\\\"central_research_question\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nSupporting research questions:\\\")\\n\",\"for key, value in record[\\\"supporting_research_questions\\\"].items():\\n\",\"    print(f\\\"{key}: {value}\\\")\\n\",\"\\n\",\"print(\\\"\\\\nResearch objectives:\\\", len(record[\\\"research_objectives\\\"]))\\n\",\"print(\\\"Proposed contributions:\\\", len(record[\\\"proposed_contributions\\\"]))\\n\",\"\\n\",\"print(\\\"\\\\nJSON reload:\\\", \\\"PASS\\\" if reloaded == record else \\\"FAIL\\\")\\n\",\"print(\\\"Saved:\\\", OUTPUT_FILE)\\n\",\"print(\\\"\\\\nJournal selected: NO\\\")\\n\",\"print(\\\"Conference selected: NO\\\")\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"FUBpxVHw8eHg\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794389437359,\"user_tz\":360,\"elapsed\":172,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"73a286ae-1635-459d-bfe1-746ec0881fcb\"},\"execution_count\":45,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.3.1\\n\",\"MANUSCRIPT RESEARCH FRAMING\\n\",\"========================================================================================\\n\",\"\\n\",\"Working title:\\n\",\"Reference-Relative Face Embedding Displacement Across Illumination Geometry Conditions: An Identity-Level Empirical Study\\n\",\"\\n\",\"Central research question:\\n\",\"How does reference-relative FaceNet embedding displacement vary across illumination geometry conditions, and how consistently are these differences observed across individual identities?\\n\",\"\\n\",\"Supporting research questions:\\n\",\"RQ1: How do Euclidean embedding displacement and cosine distance vary across near-frontal, oblique, and large-angular illumination conditions?\\n\",\"RQ2: Are the differences between illumination geometry groups consistent across the evaluated identities?\\n\",\"RQ3: How do reference-relative embedding displacement patterns differ between frontal and beyond-frontal illumination conditions?\\n\",\"\\n\",\"Research objectives: 5\\n\",\"Proposed contributions: 4\\n\",\"\\n\",\"JSON reload: PASS\\n\",\"Saved: /content/drive/MyDrive/Experiment_20_Results/step_3_3/experiment20_step331_manuscript_research_framing.json\\n\",\"\\n\",\"Journal selected: NO\\n\",\"Conference selected: NO\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.3.2\\n\",\"## Research Gap and Related-Work Positioning\\n\",\"\\n\",\"### 1. Established Research\\n\",\"\\n\",\"Previous research has investigated:\\n\",\"\\n\",\"1. Illumination variation and face-recognition performance\\n\",\"   on Yale B and related datasets.\\n\",\"\\n\",\"2. Illumination compensation and normalization using\\n\",\"   frequency-domain and spatial-domain methods.\\n\",\"\\n\",\"3. Identity-specific illumination subspaces and geometric\\n\",\"   relationships between face-image sets.\\n\",\"\\n\",\"4. The influence of image attributes on deep face-recognition\\n\",\"   embedding geometry.\\n\",\"\\n\",\"5. Modern face-verification performance under low-light\\n\",\"   degradation and illumination-aware enhancement.\\n\",\"\\n\",\"### 2. Research Gap\\n\",\"\\n\",\"Existing literature establishes that illumination variation\\n\",\"affects face images, recognition systems, and learned\\n\",\"representation spaces.\\n\",\"\\n\",\"The present study addresses a narrower empirical question:\\n\",\"\\n\",\"How does a fixed pretrained FaceNet model represent\\n\",\"reference-relative embedding displacement across illumination\\n\",\"geometry conditions when evaluated at the individual-identity\\n\",\"level using a common reference capture for each identity?\\n\",\"\\n\",\"The investigation examines:\\n\",\"\\n\",\"- Reference-relative Euclidean displacement.\\n\",\"- Reference-relative cosine distance.\\n\",\"- Near-frontal, oblique, and large-angular illumination groups.\\n\",\"- Differences across identities using repeated-measures analysis.\\n\",\"- Exploratory frontal versus beyond-frontal comparisons.\\n\",\"\\n\",\"### 3. Research-Gap Boundary\\n\",\"\\n\",\"This study does not establish that reference-relative embedding\\n\",\"displacement is a previously unexplored concept.\\n\",\"\\n\",\"It does not establish that no previous study has used Yale B,\\n\",\"FaceNet, angular illumination groups, or identity-level\\n\",\"distance measurements.\\n\",\"\\n\",\"Its potential contribution lies in the particular combination\\n\",\"of:\\n\",\"\\n\",\"- A fixed pretrained FaceNet representation.\\n\",\"- A common reference capture per identity.\\n\",\"- Reference-relative embedding displacement.\\n\",\"- Three illumination geometry groups.\\n\",\"- Identity-level descriptive and repeated-measures analysis.\\n\",\"\\n\",\"The distinctiveness of this combination remains an empirical\\n\",\"positioning claim, not an established claim of first discovery.\\n\",\"\\n\",\"### 4. Important Dataset Qualification\\n\",\"\\n\",\"The evaluation images are different captures under different\\n\",\"illumination conditions.\\n\",\"\\n\",\"They are not exact pixel-level transformations of the same\\n\",\"source image.\\n\",\"\\n\",\"Consequently, the measured displacement may reflect\\n\",\"illumination together with other capture-related differences.\\n\",\"\\n\",\"The study therefore describes displacement across illumination\\n\",\"conditions rather than claiming that illumination alone caused\\n\",\"the entire displacement.\\n\",\"\\n\",\"### 5. Research Contribution Positioning\\n\",\"\\n\",\"The manuscript presents a focused empirical characterisation\\n\",\"of reference-relative FaceNet embedding displacement across\\n\",\"illumination geometry conditions.\\n\",\"\\n\",\"It contributes descriptive measurements, identity-level\\n\",\"comparisons, and statistical evidence within the evaluated\\n\",\"Cropped Extended Yale B cohort.\\n\",\"\\n\",\"It does not propose a new recognition architecture,\\n\",\"illumination-normalisation method, or operational drift detector.\\n\",\"\\n\",\"### 6. Status\\n\",\"\\n\",\"Research-gap formulation drafted.\\n\",\"Novelty remains qualified and requires further literature review.\"],\"metadata\":{\"id\":\"qjR85z3E8uey\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"STEP_DIR = BASE / \\\"step_3_3\\\"\\n\",\"STEP_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"OUTPUT_FILE = STEP_DIR / (\\n\",\"    \\\"experiment20_step332_research_gap_formulation.json\\\"\\n\",\")\\n\",\"\\n\",\"record = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"phase\\\": \\\"3.3\\\",\\n\",\"    \\\"step\\\": \\\"3.3.2\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"\\n\",\"    \\\"established_research_areas\\\": [\\n\",\"        {\\n\",\"            \\\"area\\\": \\\"Illumination and face recognition\\\",\\n\",\"            \\\"source\\\": \\\"Beveridge et al. (2009)\\\",\\n\",\"            \\\"doi\\\": \\\"10.1109/TPAMI.2008.200\\\",\\n\",\"            \\\"reference\\\": \\\"turn242382search3\\\"\\n\",\"        },\\n\",\"        {\\n\",\"            \\\"area\\\": \\\"Illumination compensation\\\",\\n\",\"            \\\"source\\\": \\\"Chen, Er and Wu (2006)\\\",\\n\",\"            \\\"doi\\\": \\\"10.1109/tsmcb.2005.857353\\\",\\n\",\"            \\\"reference\\\": \\\"turn242382search2\\\"\\n\",\"        },\\n\",\"        {\\n\",\"            \\\"area\\\": \\\"Illumination compensation using local histograms\\\",\\n\",\"            \\\"source\\\": \\\"Lee, Wu and Hung (2012)\\\",\\n\",\"            \\\"doi\\\": \\\"10.1109/TIP.2012.2202670\\\",\\n\",\"            \\\"reference\\\": \\\"turn242382search6\\\"\\n\",\"        },\\n\",\"        {\\n\",\"            \\\"area\\\": \\\"Embedding geometry and image attributes\\\",\\n\",\"            \\\"source\\\": \\\"Leroy et al. (2025)\\\",\\n\",\"            \\\"reference\\\": \\\"turn242382search0\\\"\\n\",\"        },\\n\",\"        {\\n\",\"            \\\"area\\\": \\\"Modern low-light face verification\\\",\\n\",\"            \\\"source\\\": \\\"Wahyudi et al. (2026)\\\",\\n\",\"            \\\"doi\\\": \\\"10.1016/j.array.2026.100968\\\",\\n\",\"            \\\"reference\\\": \\\"turn242382search1\\\"\\n\",\"        }\\n\",\"    ],\\n\",\"\\n\",\"    \\\"proposed_research_gap\\\": (\\n\",\"        \\\"A focused empirical investigation of reference-relative \\\"\\n\",\"        \\\"FaceNet embedding displacement across illumination geometry \\\"\\n\",\"        \\\"conditions, evaluated at the individual-identity level \\\"\\n\",\"        \\\"using a common reference capture per identity.\\\"\\n\",\"    ),\\n\",\"\\n\",\"    \\\"research_dimensions\\\": [\\n\",\"        \\\"Reference-relative Euclidean displacement\\\",\\n\",\"        \\\"Reference-relative cosine distance\\\",\\n\",\"        \\\"Near-frontal illumination geometry\\\",\\n\",\"        \\\"Oblique illumination geometry\\\",\\n\",\"        \\\"Large-angular illumination geometry\\\",\\n\",\"        \\\"Identity-level repeated-measures comparisons\\\",\\n\",\"        \\\"Exploratory frontal versus beyond-frontal comparison\\\"\\n\",\"    ],\\n\",\"\\n\",\"    \\\"potential_distinctive_combination\\\": [\\n\",\"        \\\"Fixed pretrained FaceNet representation\\\",\\n\",\"        \\\"One common reference capture per identity\\\",\\n\",\"        \\\"Reference-relative embedding displacement\\\",\\n\",\"        \\\"Three illumination geometry groups\\\",\\n\",\"        \\\"Identity-level descriptive and repeated-measures analysis\\\"\\n\",\"    ],\\n\",\"\\n\",\"    \\\"novelty_qualification\\\": (\\n\",\"        \\\"The study does not establish that reference-relative \\\"\\n\",\"        \\\"embedding displacement, Yale B illumination analysis, \\\"\\n\",\"        \\\"FaceNet, angular grouping, or identity-level distance \\\"\\n\",\"        \\\"analysis are individually novel. The distinctiveness \\\"\\n\",\"        \\\"of their combination remains to be assessed.\\\"\\n\",\"    ),\\n\",\"\\n\",\"    \\\"dataset_qualification\\\": (\\n\",\"        \\\"Evaluation images are different captures under different \\\"\\n\",\"        \\\"illumination conditions, not exact transformations of \\\"\\n\",\"        \\\"the same source images. Observed displacement cannot \\\"\\n\",\"        \\\"be attributed exclusively to illumination.\\\"\\n\",\"    ),\\n\",\"\\n\",\"    \\\"contribution_positioning\\\": (\\n\",\"        \\\"A descriptive empirical characterisation of \\\"\\n\",\"        \\\"reference-relative FaceNet embedding displacement \\\"\\n\",\"        \\\"across illumination geometry conditions.\\\"\\n\",\"    ),\\n\",\"\\n\",\"    \\\"unsupported_claims_prohibited\\\": [\\n\",\"        \\\"First study of illumination effects on face embeddings\\\",\\n\",\"        \\\"First use of Yale B for illumination analysis\\\",\\n\",\"        \\\"New face-recognition architecture\\\",\\n\",\"        \\\"Improved recognition accuracy\\\",\\n\",\"        \\\"Validated biometric drift detection\\\",\\n\",\"        \\\"Fairness or bias mitigation\\\",\\n\",\"        \\\"Deployment readiness\\\"\\n\",\"    ],\\n\",\"\\n\",\"    \\\"status\\\": \\\"RESEARCH_GAP_DRAFTED_NOVELTY_NOT_ESTABLISHED\\\"\\n\",\"}\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"w\\\") as f:\\n\",\"    json.dump(record, f, indent=2)\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"r\\\") as f:\\n\",\"    reloaded = json.load(f)\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.3.2\\\")\\n\",\"print(\\\"RESEARCH GAP FORMULATION\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"print(\\\"\\\\nEstablished research areas:\\\",\\n\",\"      len(record[\\\"established_research_areas\\\"]))\\n\",\"\\n\",\"for item in record[\\\"established_research_areas\\\"]:\\n\",\"    print(\\\"-\\\", item[\\\"source\\\"], \\\"|\\\", item[\\\"area\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nProposed research gap:\\\")\\n\",\"print(record[\\\"proposed_research_gap\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nPotential distinctive elements:\\\",\\n\",\"      len(record[\\\"potential_distinctive_combination\\\"]))\\n\",\"\\n\",\"print(\\\"\\\\nNovelty status:\\\", record[\\\"status\\\"])\\n\",\"print(\\\"JSON reload:\\\", \\\"PASS\\\" if reloaded == record else \\\"FAIL\\\")\\n\",\"print(\\\"Saved:\\\", OUTPUT_FILE)\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"AUxrbG6P8wnZ\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794389513170,\"user_tz\":360,\"elapsed\":52,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"6d67d9ac-3887-4201-a70e-33b3cfeb40c4\"},\"execution_count\":46,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.3.2\\n\",\"RESEARCH GAP FORMULATION\\n\",\"========================================================================================\\n\",\"\\n\",\"Established research areas: 5\\n\",\"- Beveridge et al. (2009) | Illumination and face recognition\\n\",\"- Chen, Er and Wu (2006) | Illumination compensation\\n\",\"- Lee, Wu and Hung (2012) | Illumination compensation using local histograms\\n\",\"- Leroy et al. (2025) | Embedding geometry and image attributes\\n\",\"- Wahyudi et al. (2026) | Modern low-light face verification\\n\",\"\\n\",\"Proposed research gap:\\n\",\"A focused empirical investigation of reference-relative FaceNet embedding displacement across illumination geometry conditions, evaluated at the individual-identity level using a common reference capture per identity.\\n\",\"\\n\",\"Potential distinctive elements: 5\\n\",\"\\n\",\"Novelty status: RESEARCH_GAP_DRAFTED_NOVELTY_NOT_ESTABLISHED\\n\",\"JSON reload: PASS\\n\",\"Saved: /content/drive/MyDrive/Experiment_20_Results/step_3_3/experiment20_step332_research_gap_formulation.json\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.3.3\\n\",\"## Research Contributions and Hypothesis Formulation\\n\",\"\\n\",\"### 1. Final Proposed Research Contributions\\n\",\"\\n\",\"C1 — Identity-Level Empirical Characterisation\\n\",\"\\n\",\"An empirical characterisation of reference-relative FaceNet\\n\",\"embedding displacement across illumination geometry conditions\\n\",\"using 38 identities from the Cropped Extended Yale B dataset.\\n\",\"\\n\",\"C2 — Dual-Distance Measurement\\n\",\"\\n\",\"A comparative examination of Euclidean embedding displacement\\n\",\"and cosine distance relative to a common reference capture\\n\",\"for each identity.\\n\",\"\\n\",\"C3 — Repeated-Measures Statistical Evidence\\n\",\"\\n\",\"An identity-level statistical comparison of near-frontal,\\n\",\"oblique, and large-angular illumination groups using\\n\",\"Friedman and pairwise Wilcoxon signed-rank tests.\\n\",\"\\n\",\"C4 — Hemisphere-Based Exploratory Analysis\\n\",\"\\n\",\"An exploratory comparison of frontal and beyond-frontal\\n\",\"illumination conditions, accounting for unequal condition\\n\",\"counts and geometric confounding.\\n\",\"\\n\",\"### 2. Retrospective Research Hypotheses\\n\",\"\\n\",\"IMPORTANT:\\n\",\"These hypotheses are formulated during manuscript development,\\n\",\"after the experimental analysis was completed. They are not\\n\",\"preregistered or prospective hypotheses.\\n\",\"\\n\",\"H1 — Illumination Geometry Ordering\\n\",\"\\n\",\"Reference-relative embedding displacement differs across\\n\",\"near-frontal, oblique, and large-angular illumination groups.\\n\",\"\\n\",\"Expected ordering:\\n\",\"Near-frontal < Oblique < Large-angular.\\n\",\"\\n\",\"Evaluated separately using Euclidean displacement\\n\",\"and cosine distance.\\n\",\"\\n\",\"H2 — Identity-Level Consistency\\n\",\"\\n\",\"The ordering of displacement across illumination groups\\n\",\"is consistent across the evaluated identities.\\n\",\"\\n\",\"Evidence is assessed using identity-level repeated-measures\\n\",\"comparisons and the observed direction of pairwise differences.\\n\",\"\\n\",\"H3 — Hemisphere Comparison\\n\",\"\\n\",\"Beyond-frontal illumination conditions exhibit greater\\n\",\"reference-relative embedding displacement than frontal\\n\",\"illumination conditions.\\n\",\"\\n\",\"This is an exploratory hypothesis because the two groups\\n\",\"contain unequal numbers of illumination conditions and\\n\",\"are confounded with angular geometry.\\n\",\"\\n\",\"### 3. Statistical Evidence Already Available\\n\",\"\\n\",\"H1:\\n\",\"- Friedman repeated-measures tests were significant for\\n\",\"  both Euclidean displacement and cosine distance.\\n\",\"- All three pairwise comparisons were significant after\\n\",\"  Holm correction across the six comparisons.\\n\",\"\\n\",\"H2:\\n\",\"- All 38 identities showed the same direction of difference\\n\",\"  for each pairwise illumination-group comparison.\\n\",\"- Kendall's W was 1.0 for both metrics.\\n\",\"\\n\",\"H3:\\n\",\"- Beyond-frontal mean displacement was higher for both metrics.\\n\",\"- The comparison was exploratory and subject to\\n\",\"  unequal-condition and geometric-confounding limitations.\\n\",\"\\n\",\"### 4. Interpretation Restrictions\\n\",\"\\n\",\"Statistical significance does not establish:\\n\",\"- Recognition accuracy.\\n\",\"- Biometric verification reliability.\\n\",\"- Causal isolation of illumination effects.\\n\",\"- Operational drift detection.\\n\",\"- Generalisation to other face-recognition architectures.\\n\",\"\\n\",\"Kendall's W = 1.0 indicates perfectly consistent group ordering\\n\",\"in the evaluated identities; it does not indicate perfect\\n\",\"recognition or detector performance.\\n\",\"\\n\",\"### 5. Hypothesis Classification\\n\",\"\\n\",\"H1: Retrospective, directional empirical hypothesis.\\n\",\"H2: Retrospective, identity-consistency hypothesis.\\n\",\"H3: Retrospective, exploratory hemisphere hypothesis.\\n\",\"\\n\",\"### 6. Status\\n\",\"\\n\",\"Research contributions and retrospective hypotheses documented.\"],\"metadata\":{\"id\":\"ScEW43fP88Ic\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"STEP_DIR = BASE / \\\"step_3_3\\\"\\n\",\"STEP_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"INPUT_FILE = STEP_DIR / (\\n\",\"    \\\"experiment20_step331_manuscript_research_framing.json\\\"\\n\",\")\\n\",\"\\n\",\"OUTPUT_FILE = STEP_DIR / (\\n\",\"    \\\"experiment20_step333_contributions_hypotheses.json\\\"\\n\",\")\\n\",\"\\n\",\"assert INPUT_FILE.exists(), \\\"Step 3.3.1 research framing missing.\\\"\\n\",\"\\n\",\"with open(INPUT_FILE) as f:\\n\",\"    framing = json.load(f)\\n\",\"\\n\",\"assert len(framing[\\\"research_objectives\\\"]) == 5\\n\",\"\\n\",\"record = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"phase\\\": \\\"3.3\\\",\\n\",\"    \\\"step\\\": \\\"3.3.3\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"\\n\",\"    \\\"working_title\\\": framing[\\\"working_title\\\"],\\n\",\"\\n\",\"    \\\"contributions\\\": {\\n\",\"        \\\"C1\\\": (\\n\",\"            \\\"Identity-level empirical characterisation of \\\"\\n\",\"            \\\"reference-relative FaceNet embedding displacement \\\"\\n\",\"            \\\"across illumination geometry conditions.\\\"\\n\",\"        ),\\n\",\"        \\\"C2\\\": (\\n\",\"            \\\"Comparative examination of Euclidean displacement \\\"\\n\",\"            \\\"and cosine distance relative to a common reference.\\\"\\n\",\"        ),\\n\",\"        \\\"C3\\\": (\\n\",\"            \\\"Repeated-measures statistical comparison of three \\\"\\n\",\"            \\\"illumination geometry groups.\\\"\\n\",\"        ),\\n\",\"        \\\"C4\\\": (\\n\",\"            \\\"Exploratory comparison of frontal and beyond-frontal \\\"\\n\",\"            \\\"illumination conditions.\\\"\\n\",\"        )\\n\",\"    },\\n\",\"\\n\",\"    \\\"hypotheses\\\": {\\n\",\"        \\\"H1\\\": {\\n\",\"            \\\"name\\\": \\\"Illumination geometry ordering\\\",\\n\",\"            \\\"statement\\\": (\\n\",\"                \\\"Reference-relative embedding displacement differs \\\"\\n\",\"                \\\"across near-frontal, oblique, and large-angular groups.\\\"\\n\",\"            ),\\n\",\"            \\\"expected_ordering\\\": [\\n\",\"                \\\"near_frontal\\\",\\n\",\"                \\\"oblique\\\",\\n\",\"                \\\"large_angular\\\"\\n\",\"            ],\\n\",\"            \\\"metrics\\\": [\\\"Euclidean\\\", \\\"Cosine\\\"],\\n\",\"            \\\"classification\\\": \\\"RETROSPECTIVE_DIRECTIONAL\\\"\\n\",\"        },\\n\",\"        \\\"H2\\\": {\\n\",\"            \\\"name\\\": \\\"Identity-level consistency\\\",\\n\",\"            \\\"statement\\\": (\\n\",\"                \\\"The ordering of displacement across illumination \\\"\\n\",\"                \\\"groups is consistent across evaluated identities.\\\"\\n\",\"            ),\\n\",\"            \\\"classification\\\": \\\"RETROSPECTIVE_IDENTITY_CONSISTENCY\\\"\\n\",\"        },\\n\",\"        \\\"H3\\\": {\\n\",\"            \\\"name\\\": \\\"Hemisphere comparison\\\",\\n\",\"            \\\"statement\\\": (\\n\",\"                \\\"Beyond-frontal conditions exhibit greater \\\"\\n\",\"                \\\"reference-relative displacement than frontal \\\"\\n\",\"                \\\"conditions.\\\"\\n\",\"            ),\\n\",\"            \\\"classification\\\": \\\"RETROSPECTIVE_EXPLORATORY\\\",\\n\",\"            \\\"limitations\\\": [\\n\",\"                \\\"Unequal numbers of illumination conditions\\\",\\n\",\"                \\\"Confounding with angular geometry\\\"\\n\",\"            ]\\n\",\"        }\\n\",\"    },\\n\",\"\\n\",\"    \\\"existing_evidence\\\": {\\n\",\"        \\\"friedman_euclidean_significant\\\": True,\\n\",\"        \\\"friedman_cosine_significant\\\": True,\\n\",\"        \\\"six_pairwise_comparisons_holm_significant\\\": True,\\n\",\"        \\\"identity_count\\\": 38,\\n\",\"        \\\"all_identity_pairwise_directions_consistent\\\": True,\\n\",\"        \\\"kendall_w_euclidean\\\": 1.0,\\n\",\"        \\\"kendall_w_cosine\\\": 1.0,\\n\",\"        \\\"beyond_frontal_mean_higher_for_both_metrics\\\": True\\n\",\"    },\\n\",\"\\n\",\"    \\\"temporal_status\\\": {\\n\",\"        \\\"hypotheses_preregistered\\\": False,\\n\",\"        \\\"hypotheses_formulated_after_analysis\\\": True,\\n\",\"        \\\"confirmatory_claims_permitted\\\": False,\\n\",\"        \\\"retrospective_classification_required\\\": True\\n\",\"    },\\n\",\"\\n\",\"    \\\"interpretation_restrictions\\\": [\\n\",\"        \\\"Statistical significance does not establish recognition accuracy.\\\",\\n\",\"        \\\"Kendall's W = 1.0 does not establish perfect recognition.\\\",\\n\",\"        \\\"Observed displacement is not exclusively attributable to illumination.\\\",\\n\",\"        \\\"No operational drift detection is demonstrated.\\\",\\n\",\"        \\\"No independent architecture generalisation is demonstrated.\\\"\\n\",\"    ],\\n\",\"\\n\",\"    \\\"status\\\": \\\"CONTRIBUTIONS_AND_RETROSPECTIVE_HYPOTHESES_RECORDED\\\"\\n\",\"}\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"w\\\") as f:\\n\",\"    json.dump(record, f, indent=2)\\n\",\"\\n\",\"with open(OUTPUT_FILE) as f:\\n\",\"    reloaded = json.load(f)\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.3.3\\\")\\n\",\"print(\\\"CONTRIBUTIONS AND HYPOTHESES\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"print(\\\"\\\\nContributions:\\\", len(record[\\\"contributions\\\"]))\\n\",\"\\n\",\"for key, value in record[\\\"contributions\\\"].items():\\n\",\"    print(f\\\"{key}: {value}\\\")\\n\",\"\\n\",\"print(\\\"\\\\nHypotheses:\\\")\\n\",\"for key, value in record[\\\"hypotheses\\\"].items():\\n\",\"    print(key, \\\"|\\\", value[\\\"classification\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nPreregistered:\\\", record[\\\"temporal_status\\\"][\\\"hypotheses_preregistered\\\"])\\n\",\"print(\\\"Formulated after analysis:\\\",\\n\",\"      record[\\\"temporal_status\\\"][\\\"hypotheses_formulated_after_analysis\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nJSON reload:\\\", \\\"PASS\\\" if reloaded == record else \\\"FAIL\\\")\\n\",\"print(\\\"Saved:\\\", OUTPUT_FILE)\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"wM_Z4aXi8-VY\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794389585102,\"user_tz\":360,\"elapsed\":44,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"4a64235c-6fea-4bf4-cc2e-e1fefb4536d5\"},\"execution_count\":47,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.3.3\\n\",\"CONTRIBUTIONS AND HYPOTHESES\\n\",\"========================================================================================\\n\",\"\\n\",\"Contributions: 4\\n\",\"C1: Identity-level empirical characterisation of reference-relative FaceNet embedding displacement across illumination geometry conditions.\\n\",\"C2: Comparative examination of Euclidean displacement and cosine distance relative to a common reference.\\n\",\"C3: Repeated-measures statistical comparison of three illumination geometry groups.\\n\",\"C4: Exploratory comparison of frontal and beyond-frontal illumination conditions.\\n\",\"\\n\",\"Hypotheses:\\n\",\"H1 | RETROSPECTIVE_DIRECTIONAL\\n\",\"H2 | RETROSPECTIVE_IDENTITY_CONSISTENCY\\n\",\"H3 | RETROSPECTIVE_EXPLORATORY\\n\",\"\\n\",\"Preregistered: False\\n\",\"Formulated after analysis: True\\n\",\"\\n\",\"JSON reload: PASS\\n\",\"Saved: /content/drive/MyDrive/Experiment_20_Results/step_3_3/experiment20_step333_contributions_hypotheses.json\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"## Abstract\\n\",\"\\n\",\"Illumination variation remains a significant challenge for face-recognition systems, potentially altering the representations produced by deep neural networks. This study empirically examines reference-relative face embedding displacement across illumination geometry conditions using a fixed pretrained FaceNet architecture. Experiments were conducted on the Cropped Extended Yale B dataset, comprising 38 identities and 2,414 images. A common reference capture was established for each identity, and 2,128 evaluation observations across 56 non-reference illumination conditions were analysed using 512-dimensional embeddings. Euclidean displacement and cosine distance were calculated relative to the corresponding identity reference. Illumination conditions were grouped into near-frontal, oblique, and large-angular categories.\\n\",\"\\n\",\"Both distance measures exhibited progressively greater displacement across the three illumination groups. Mean Euclidean displacement increased from 0.402 in near-frontal conditions to 0.709 in oblique conditions and 1.118 in large-angular conditions. Corresponding mean cosine distances increased from 0.087 to 0.262 and 0.649. Friedman tests indicated significant differences across groups for both metrics (χ² = 76.0, p = 3.14 × 10⁻¹⁷, Kendall's W = 1.0). All six pairwise comparisons remained significant following Holm correction. An exploratory hemisphere comparison also showed greater mean displacement under beyond-frontal conditions.\\n\",\"\\n\",\"These findings characterise reference-relative embedding displacement within the evaluated dataset and model. However, the analysis uses different captures rather than exact transformations of identical source images, limiting causal attribution to illumination alone. The results do not establish recognition accuracy, operational drift detection, or generalisation across architectures.\"],\"metadata\":{\"id\":\"IGHNzHRj9Lu5\"}},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.3.4\\n\",\"## Abstract Development\\n\",\"\\n\",\"### Objective\\n\",\"Prepare an evidence-based abstract using the completed\\n\",\"experimental results.\\n\",\"\\n\",\"### Required abstract components\\n\",\"1. Research background.\\n\",\"2. Research objective.\\n\",\"3. Dataset and model.\\n\",\"4. Reference-relative measurement methodology.\\n\",\"5. Illumination geometry groups.\\n\",\"6. Primary statistical findings.\\n\",\"7. Exploratory hemisphere finding.\\n\",\"8. Methodological limitations.\\n\",\"9. Appropriate conclusion.\\n\",\"\\n\",\"### Evidence restrictions\\n\",\"- Use 38 identities.\\n\",\"- Use 2,414 source images.\\n\",\"- Use 2,128 evaluation observations.\\n\",\"- Use 56 non-reference evaluation conditions.\\n\",\"- Use the actual Euclidean and cosine group means.\\n\",\"- Report the six-test Holm correction.\\n\",\"- Do not claim recognition accuracy or drift detection.\\n\",\"- Do not attribute all observed displacement exclusively\\n\",\"  to illumination.\\n\",\"\\n\",\"### Status\\n\",\"First abstract draft prepared.\\n\",\"Final approval pending manuscript consistency audit.\"],\"metadata\":{\"id\":\"lyrNpSel9nt6\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"STEP_DIR = BASE / \\\"step_3_3\\\"\\n\",\"STEP_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"OUTPUT_FILE = STEP_DIR / (\\n\",\"    \\\"experiment20_step334_abstract_draft.json\\\"\\n\",\")\\n\",\"\\n\",\"abstract = \\\"\\\"\\\"Illumination variation remains a significant challenge for\\n\",\"face-recognition systems, potentially altering the representations\\n\",\"produced by deep neural networks. This study empirically examines\\n\",\"reference-relative face embedding displacement across illumination\\n\",\"geometry conditions using a fixed pretrained FaceNet architecture.\\n\",\"Experiments were conducted on the Cropped Extended Yale B dataset,\\n\",\"comprising 38 identities and 2,414 images. A common reference capture\\n\",\"was established for each identity, and 2,128 evaluation observations\\n\",\"across 56 non-reference illumination conditions were analysed using\\n\",\"512-dimensional embeddings. Euclidean displacement and cosine\\n\",\"distance were calculated relative to the corresponding identity\\n\",\"reference. Illumination conditions were grouped into near-frontal,\\n\",\"oblique, and large-angular categories.\\n\",\"\\n\",\"Both distance measures exhibited progressively greater displacement\\n\",\"across the three illumination groups. Mean Euclidean displacement\\n\",\"increased from 0.402 in near-frontal conditions to 0.709 in oblique\\n\",\"conditions and 1.118 in large-angular conditions. Corresponding mean\\n\",\"cosine distances increased from 0.087 to 0.262 and 0.649. Friedman\\n\",\"tests indicated significant differences across groups for both\\n\",\"metrics (chi-square = 76.0, p = 3.14e-17, Kendall's W = 1.0).\\n\",\"All six pairwise comparisons remained significant following Holm\\n\",\"correction. An exploratory hemisphere comparison also showed greater\\n\",\"mean displacement under beyond-frontal conditions.\\n\",\"\\n\",\"These findings characterise reference-relative embedding displacement\\n\",\"within the evaluated dataset and model. However, the analysis uses\\n\",\"different captures rather than exact transformations of identical\\n\",\"source images, limiting causal attribution to illumination alone.\\n\",\"The results do not establish recognition accuracy, operational drift\\n\",\"detection, or generalisation across architectures.\\\"\\\"\\\"\\n\",\"\\n\",\"record = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"phase\\\": \\\"3.3\\\",\\n\",\"    \\\"step\\\": \\\"3.3.4\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"\\n\",\"    \\\"working_title\\\": (\\n\",\"        \\\"Reference-Relative Face Embedding Displacement Across \\\"\\n\",\"        \\\"Illumination Geometry Conditions: An Identity-Level \\\"\\n\",\"        \\\"Empirical Study\\\"\\n\",\"    ),\\n\",\"\\n\",\"    \\\"abstract\\\": abstract,\\n\",\"\\n\",\"    \\\"evidence\\\": {\\n\",\"        \\\"subjects\\\": 38,\\n\",\"        \\\"source_images\\\": 2414,\\n\",\"        \\\"evaluation_observations\\\": 2128,\\n\",\"        \\\"evaluation_conditions\\\": 56,\\n\",\"        \\\"embedding_dimensions\\\": 512,\\n\",\"        \\\"euclidean_means\\\": {\\n\",\"            \\\"near_frontal\\\": 0.401897,\\n\",\"            \\\"oblique\\\": 0.708976,\\n\",\"            \\\"large_angular\\\": 1.118457\\n\",\"        },\\n\",\"        \\\"cosine_means\\\": {\\n\",\"            \\\"near_frontal\\\": 0.086877,\\n\",\"            \\\"oblique\\\": 0.262274,\\n\",\"            \\\"large_angular\\\": 0.649095\\n\",\"        },\\n\",\"        \\\"friedman\\\": {\\n\",\"            \\\"chi_square\\\": 76.0,\\n\",\"            \\\"p_value\\\": 3.139132792048018e-17,\\n\",\"            \\\"kendall_w\\\": 1.0\\n\",\"        },\\n\",\"        \\\"pairwise_holm_family_size\\\": 6,\\n\",\"        \\\"all_pairwise_comparisons_significant\\\": True,\\n\",\"        \\\"hemisphere\\\": {\\n\",\"            \\\"frontal_observations\\\": 1710,\\n\",\"            \\\"beyond_frontal_observations\\\": 418,\\n\",\"            \\\"euclidean_frontal_mean\\\": 0.7062201499,\\n\",\"            \\\"euclidean_beyond_frontal_mean\\\": 1.2879898952,\\n\",\"            \\\"cosine_frontal_mean\\\": 0.2958161338,\\n\",\"            \\\"cosine_beyond_frontal_mean\\\": 0.8386235804,\\n\",\"            \\\"classification\\\": \\\"EXPLORATORY\\\"\\n\",\"        }\\n\",\"    },\\n\",\"\\n\",\"    \\\"limitations_included\\\": [\\n\",\"        \\\"Different captures rather than exact source-image transformations\\\",\\n\",\"        \\\"Single pretrained FaceNet architecture\\\",\\n\",\"        \\\"No recognition accuracy evaluation\\\",\\n\",\"        \\\"No operational drift detector evaluation\\\",\\n\",\"        \\\"No independent architecture generalisation\\\"\\n\",\"    ],\\n\",\"\\n\",\"    \\\"status\\\": \\\"FIRST_ABSTRACT_DRAFT_PREPARED\\\",\\n\",\"    \\\"journal_selected\\\": False\\n\",\"}\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"w\\\") as f:\\n\",\"    json.dump(record, f, indent=2)\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"r\\\") as f:\\n\",\"    reloaded = json.load(f)\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.3.4\\\")\\n\",\"print(\\\"ABSTRACT DEVELOPMENT\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"print(\\\"\\\\nAbstract word count:\\\",\\n\",\"      len(abstract.split()))\\n\",\"\\n\",\"print(\\\"\\\\nEvidence verification:\\\")\\n\",\"print(\\\"Subjects:\\\", record[\\\"evidence\\\"][\\\"subjects\\\"])\\n\",\"print(\\\"Source images:\\\", record[\\\"evidence\\\"][\\\"source_images\\\"])\\n\",\"print(\\\"Evaluation observations:\\\",\\n\",\"      record[\\\"evidence\\\"][\\\"evaluation_observations\\\"])\\n\",\"print(\\\"Evaluation conditions:\\\",\\n\",\"      record[\\\"evidence\\\"][\\\"evaluation_conditions\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nEuclidean means:\\\",\\n\",\"      record[\\\"evidence\\\"][\\\"euclidean_means\\\"])\\n\",\"print(\\\"Cosine means:\\\",\\n\",\"      record[\\\"evidence\\\"][\\\"cosine_means\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nFriedman chi-square:\\\",\\n\",\"      record[\\\"evidence\\\"][\\\"friedman\\\"][\\\"chi_square\\\"])\\n\",\"print(\\\"Friedman p-value:\\\",\\n\",\"      record[\\\"evidence\\\"][\\\"friedman\\\"][\\\"p_value\\\"])\\n\",\"print(\\\"Kendall's W:\\\",\\n\",\"      record[\\\"evidence\\\"][\\\"friedman\\\"][\\\"kendall_w\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nStatus:\\\", record[\\\"status\\\"])\\n\",\"print(\\\"JSON reload:\\\", \\\"PASS\\\" if reloaded == record else \\\"FAIL\\\")\\n\",\"print(\\\"Saved:\\\", OUTPUT_FILE)\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"2KoBO5S79RGp\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794389742043,\"user_tz\":360,\"elapsed\":85,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"fc768f02-8ee1-44c3-c9c5-cddca6c5d39d\"},\"execution_count\":49,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.3.4\\n\",\"ABSTRACT DEVELOPMENT\\n\",\"========================================================================================\\n\",\"\\n\",\"Abstract word count: 227\\n\",\"\\n\",\"Evidence verification:\\n\",\"Subjects: 38\\n\",\"Source images: 2414\\n\",\"Evaluation observations: 2128\\n\",\"Evaluation conditions: 56\\n\",\"\\n\",\"Euclidean means: {'near_frontal': 0.401897, 'oblique': 0.708976, 'large_angular': 1.118457}\\n\",\"Cosine means: {'near_frontal': 0.086877, 'oblique': 0.262274, 'large_angular': 0.649095}\\n\",\"\\n\",\"Friedman chi-square: 76.0\\n\",\"Friedman p-value: 3.139132792048018e-17\\n\",\"Kendall's W: 1.0\\n\",\"\\n\",\"Status: FIRST_ABSTRACT_DRAFT_PREPARED\\n\",\"JSON reload: PASS\\n\",\"Saved: /content/drive/MyDrive/Experiment_20_Results/step_3_3/experiment20_step334_abstract_draft.json\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.3.5\\n\",\"## Manuscript Keywords\\n\",\"\\n\",\"### Proposed Keywords\\n\",\"\\n\",\"1. Face recognition\\n\",\"2. Face embeddings\\n\",\"3. Illumination variation\\n\",\"4. Embedding displacement\\n\",\"5. Euclidean distance\\n\",\"6. Cosine distance\\n\",\"\\n\",\"### Keyword Selection Rationale\\n\",\"\\n\",\"- Face recognition: identifies the application domain.\\n\",\"- Face embeddings: identifies the learned representations.\\n\",\"- Illumination variation: identifies the experimental condition.\\n\",\"- Embedding displacement: identifies the central measurement.\\n\",\"- Euclidean distance: identifies one displacement metric.\\n\",\"- Cosine distance: identifies the second displacement metric.\\n\",\"\\n\",\"### Excluded Keywords\\n\",\"\\n\",\"- Biometric drift detection\\n\",\"- Fairness\\n\",\"- Bias mitigation\\n\",\"- Multi-model robustness\\n\",\"- Recognition accuracy\\n\",\"\\n\",\"These topics are not directly evaluated in the present experiment.\\n\",\"\\n\",\"### Status\\n\",\"Proposed manuscript keywords recorded.\"],\"metadata\":{\"id\":\"aHh-GeIk9589\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"STEP_DIR = BASE / \\\"step_3_3\\\"\\n\",\"STEP_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"OUTPUT_FILE = STEP_DIR / (\\n\",\"    \\\"experiment20_step335_manuscript_keywords.json\\\"\\n\",\")\\n\",\"\\n\",\"keywords = [\\n\",\"    \\\"Face recognition\\\",\\n\",\"    \\\"Face embeddings\\\",\\n\",\"    \\\"Illumination variation\\\",\\n\",\"    \\\"Embedding displacement\\\",\\n\",\"    \\\"Euclidean distance\\\",\\n\",\"    \\\"Cosine distance\\\"\\n\",\"]\\n\",\"\\n\",\"excluded_keywords = [\\n\",\"    \\\"Biometric drift detection\\\",\\n\",\"    \\\"Fairness\\\",\\n\",\"    \\\"Bias mitigation\\\",\\n\",\"    \\\"Multi-model robustness\\\",\\n\",\"    \\\"Recognition accuracy\\\"\\n\",\"]\\n\",\"\\n\",\"record = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"phase\\\": \\\"3.3\\\",\\n\",\"    \\\"step\\\": \\\"3.3.5\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"working_title\\\": (\\n\",\"        \\\"Reference-Relative Face Embedding Displacement Across \\\"\\n\",\"        \\\"Illumination Geometry Conditions: An Identity-Level \\\"\\n\",\"        \\\"Empirical Study\\\"\\n\",\"    ),\\n\",\"    \\\"keywords\\\": keywords,\\n\",\"    \\\"keyword_count\\\": len(keywords),\\n\",\"    \\\"excluded_keywords\\\": excluded_keywords,\\n\",\"    \\\"selection_rationale\\\": {\\n\",\"        \\\"Face recognition\\\": \\\"Application domain\\\",\\n\",\"        \\\"Face embeddings\\\": \\\"Learned representation\\\",\\n\",\"        \\\"Illumination variation\\\": \\\"Experimental condition\\\",\\n\",\"        \\\"Embedding displacement\\\": \\\"Central measurement\\\",\\n\",\"        \\\"Euclidean distance\\\": \\\"First displacement metric\\\",\\n\",\"        \\\"Cosine distance\\\": \\\"Second displacement metric\\\"\\n\",\"    },\\n\",\"    \\\"status\\\": \\\"PROPOSED_KEYWORDS_RECORDED\\\",\\n\",\"    \\\"journal_selected\\\": False\\n\",\"}\\n\",\"\\n\",\"assert len(keywords) == 6\\n\",\"assert len(set(keywords)) == 6\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"w\\\") as f:\\n\",\"    json.dump(record, f, indent=2)\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"r\\\") as f:\\n\",\"    reloaded = json.load(f)\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.3.5\\\")\\n\",\"print(\\\"MANUSCRIPT KEYWORDS\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"print(\\\"\\\\nProposed keywords:\\\")\\n\",\"for index, keyword in enumerate(reloaded[\\\"keywords\\\"], start=1):\\n\",\"    print(f\\\"{index}. {keyword}\\\")\\n\",\"\\n\",\"print(\\\"\\\\nKeyword count:\\\", len(reloaded[\\\"keywords\\\"]))\\n\",\"print(\\\"Unique keywords:\\\", len(set(reloaded[\\\"keywords\\\"])))\\n\",\"\\n\",\"print(\\\"\\\\nExcluded keywords:\\\")\\n\",\"for keyword in reloaded[\\\"excluded_keywords\\\"]:\\n\",\"    print(\\\"-\\\", keyword)\\n\",\"\\n\",\"print(\\\"\\\\nJSON reload:\\\", \\\"PASS\\\" if reloaded == record else \\\"FAIL\\\")\\n\",\"print(\\\"Saved:\\\", OUTPUT_FILE)\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"76Odv7Cs98fj\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794389823810,\"user_tz\":360,\"elapsed\":33,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"5c6ea2dc-15e6-40af-c556-09c4aa32c484\"},\"execution_count\":50,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.3.5\\n\",\"MANUSCRIPT KEYWORDS\\n\",\"========================================================================================\\n\",\"\\n\",\"Proposed keywords:\\n\",\"1. Face recognition\\n\",\"2. Face embeddings\\n\",\"3. Illumination variation\\n\",\"4. Embedding displacement\\n\",\"5. Euclidean distance\\n\",\"6. Cosine distance\\n\",\"\\n\",\"Keyword count: 6\\n\",\"Unique keywords: 6\\n\",\"\\n\",\"Excluded keywords:\\n\",\"- Biometric drift detection\\n\",\"- Fairness\\n\",\"- Bias mitigation\\n\",\"- Multi-model robustness\\n\",\"- Recognition accuracy\\n\",\"\\n\",\"JSON reload: PASS\\n\",\"Saved: /content/drive/MyDrive/Experiment_20_Results/step_3_3/experiment20_step335_manuscript_keywords.json\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.3.6\\n\",\"## Introduction\\n\",\"### 1. Background: Face Recognition and Deep Face Embeddings\\n\",\"\\n\",\"Face recognition systems increasingly use deep learning models to represent facial images as numerical feature vectors, commonly referred to as face embeddings. These representations encode facial characteristics in a high-dimensional feature space, where distances or similarities between embeddings can be used to examine relationships between facial images.\\n\",\"\\n\",\"The geometry of this embedding space is relevant to face-recognition research because changes in an input image may be reflected in the position of its corresponding representation. Consequently, comparing embeddings can provide a way to examine how image variations are associated with changes in learned facial representations.\\n\",\"\\n\",\"A particularly important source of image variation is illumination. Changes in lighting direction and intensity can alter the appearance of facial regions, producing differences between images of the same individual. The effects of illumination on face recognition have been investigated in earlier research, including work examining changes in illumination direction (Moses, Adini, and Ullman, 1994).\\n\",\"\\n\",\"In this context, examining reference-relative embedding displacement provides an empirical way to describe how the representations of different captures of an individual vary relative to a selected reference capture. The present study applies this approach to a fixed pretrained InceptionResnetV1 model and examines Euclidean displacement and cosine distance across groups of illumination conditions.\\n\",\"\\n\",\"This investigation focuses on the geometry of the resulting embeddings. It does not, by itself, establish whether a face-recognition system correctly identifies individuals under those conditions.\"],\"metadata\":{\"id\":\"P9r9KKOn-MmD\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"STEP_DIR = BASE / \\\"step_3_3\\\"\\n\",\"STEP_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"OUTPUT_FILE = STEP_DIR / (\\n\",\"    \\\"experiment20_step336_introduction_section1_background.json\\\"\\n\",\")\\n\",\"\\n\",\"section = {\\n\",\"    \\\"section_number\\\": \\\"3.3.6.1\\\",\\n\",\"    \\\"heading\\\": \\\"Background: Face Recognition and Deep Face Embeddings\\\",\\n\",\"    \\\"draft\\\": \\\"\\\"\\\"Face recognition systems increasingly use deep learning models to represent facial images as numerical feature vectors, commonly referred to as face embeddings. These representations encode facial characteristics in a high-dimensional feature space, where distances or similarities between embeddings can be used to examine relationships between facial images.\\n\",\"\\n\",\"The geometry of this embedding space is relevant to face-recognition research because changes in an input image may be reflected in the position of its corresponding representation. Consequently, comparing embeddings can provide a way to examine how image variations are associated with changes in learned facial representations.\\n\",\"\\n\",\"A particularly important source of image variation is illumination. Changes in lighting direction and intensity can alter the appearance of facial regions, producing differences between images of the same individual. The effects of illumination on face recognition have been investigated in earlier research, including work examining changes in illumination direction (Moses, Adini, and Ullman, 1994).\\n\",\"\\n\",\"In this context, examining reference-relative embedding displacement provides an empirical way to describe how the representations of different captures of an individual vary relative to a selected reference capture. The present study applies this approach to a fixed pretrained InceptionResnetV1 model and examines Euclidean displacement and cosine distance across groups of illumination conditions.\\n\",\"\\n\",\"This investigation focuses on the geometry of the resulting embeddings. It does not, by itself, establish whether a face-recognition system correctly identifies individuals under those conditions.\\\"\\\"\\\",\\n\",\"    \\\"supporting_reference\\\": {\\n\",\"        \\\"authors\\\": \\\"Moses, Adini, and Ullman\\\",\\n\",\"        \\\"year\\\": 1994,\\n\",\"        \\\"title\\\": \\\"Face Recognition: The Problem of Compensating for Changes in Illumination Direction\\\",\\n\",\"        \\\"doi\\\": \\\"10.1007/3-540-57956-7_33\\\",\\n\",\"        \\\"verification_status\\\": \\\"Present in preliminary literature baseline\\\"\\n\",\"    },\\n\",\"    \\\"scope_checks\\\": {\\n\",\"        \\\"recognition_accuracy_claimed\\\": False,\\n\",\"        \\\"operational_robustness_claimed\\\": False,\\n\",\"        \\\"embedding_displacement_focus\\\": True,\\n\",\"        \\\"fixed_pretrained_model_identified\\\": True\\n\",\"    },\\n\",\"    \\\"status\\\": \\\"FIRST_BACKGROUND_SECTION_DRAFT_PREPARED\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat()\\n\",\"}\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    json.dump(section, f, indent=2, ensure_ascii=False)\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    reloaded = json.load(f)\\n\",\"\\n\",\"assert reloaded == section\\n\",\"assert reloaded[\\\"scope_checks\\\"][\\\"recognition_accuracy_claimed\\\"] is False\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.3.6\\\")\\n\",\"print(\\\"INTRODUCTION — SECTION 1: BACKGROUND\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"Heading:\\\", reloaded[\\\"heading\\\"])\\n\",\"print(\\\"Word count:\\\", len(reloaded[\\\"draft\\\"].split()))\\n\",\"print(\\\"Supporting reference:\\\", reloaded[\\\"supporting_reference\\\"][\\\"year\\\"])\\n\",\"print(\\\"Recognition accuracy overclaim:\\\",\\n\",\"      reloaded[\\\"scope_checks\\\"][\\\"recognition_accuracy_claimed\\\"])\\n\",\"print(\\\"JSON reload: PASS\\\")\\n\",\"print(\\\"Saved:\\\", OUTPUT_FILE)\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"t1SUtRPx-R53\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794389937894,\"user_tz\":360,\"elapsed\":35,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"e810d457-5148-4f4a-c31f-da5bffb3bb3b\"},\"execution_count\":51,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.3.6\\n\",\"INTRODUCTION — SECTION 1: BACKGROUND\\n\",\"========================================================================================\\n\",\"Heading: Background: Face Recognition and Deep Face Embeddings\\n\",\"Word count: 228\\n\",\"Supporting reference: 1994\\n\",\"Recognition accuracy overclaim: False\\n\",\"JSON reload: PASS\\n\",\"Saved: /content/drive/MyDrive/Experiment_20_Results/step_3_3/experiment20_step336_introduction_section1_background.json\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"### 2. Illumination Variation and Its Effect on Facial Representations\\n\",\"\\n\",\"Illumination variation is a longstanding challenge in face-recognition research. Changes in the direction of incident light can produce substantial differences in facial appearance, affecting the distribution of shadows, highlights, and visible facial details. These variations can occur even when the images represent the same individual. Earlier research by Moses, Adini, and Ullman (1994) specifically examined the problem of compensating for changes in illumination direction in face recognition.\\n\",\"\\n\",\"Subsequent research has investigated the relationship between illumination and facial appearance using different analytical approaches. Beveridge et al. (2009) examined subject illumination spaces and the role of principal angles in distinguishing them. Other studies have explored illumination preprocessing and methods intended to reduce the effects of lighting variation on face recognition (Han et al., 2013; Ochoa-Villegas et al., 2015). Research using Yale B datasets has also considered illumination conditions according to the angular position of light sources, demonstrating the relevance of illumination geometry in controlled face-image analysis.\\n\",\"\\n\",\"Deep face-recognition models represent facial images through learned feature embeddings. Changes in facial appearance may therefore be accompanied by changes in embedding-space position. However, the magnitude and consistency of such changes depend on the model, the input images, and the conditions under which the representations are evaluated. An observed embedding displacement should consequently be interpreted as a change in representation rather than direct evidence of incorrect identity recognition.\\n\",\"\\n\",\"In the present study, illumination conditions are grouped according to their angular geometry relative to a common reference condition. Three groups are considered: near-frontal illumination, oblique illumination, and large-angular-deviation illumination. These categories provide a structured basis for comparing reference-relative embedding displacement across different lighting directions. They represent angular geometry rather than illumination intensity.\\n\",\"\\n\",\"This distinction is important because the experiment uses different captures of the same individuals under different illumination conditions. The images are identity-matched observations, not exact transformations of identical source images. Therefore, the resulting differences in embedding space are examined as reference-relative associations with illumination geometry, rather than as effects attributable exclusively to illumination.\"],\"metadata\":{\"id\":\"xAhN2QPl-qf8\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"STEP_DIR = BASE / \\\"step_3_3\\\"\\n\",\"STEP_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"OUTPUT_FILE = STEP_DIR / (\\n\",\"    \\\"experiment20_step3362_introduction_illumination_context.json\\\"\\n\",\")\\n\",\"\\n\",\"draft = \\\"\\\"\\\"Illumination variation is a longstanding challenge in face-recognition research. Changes in the direction of incident light can produce substantial differences in facial appearance, affecting the distribution of shadows, highlights, and visible facial details. These variations can occur even when the images represent the same individual. Earlier research by Moses, Adini, and Ullman (1994) specifically examined the problem of compensating for changes in illumination direction in face recognition.\\n\",\"\\n\",\"Subsequent research has investigated the relationship between illumination and facial appearance using different analytical approaches. Beveridge et al. (2009) examined subject illumination spaces and the role of principal angles in distinguishing them. Other studies have explored illumination preprocessing and methods intended to reduce the effects of lighting variation on face recognition (Han et al., 2013; Ochoa-Villegas et al., 2015). Research using Yale B datasets has also considered illumination conditions according to the angular position of light sources, demonstrating the relevance of illumination geometry in controlled face-image analysis.\\n\",\"\\n\",\"Deep face-recognition models represent facial images through learned feature embeddings. Changes in facial appearance may therefore be accompanied by changes in embedding-space position. However, the magnitude and consistency of such changes depend on the model, the input images, and the conditions under which the representations are evaluated. An observed embedding displacement should consequently be interpreted as a change in representation rather than direct evidence of incorrect identity recognition.\\n\",\"\\n\",\"In the present study, illumination conditions are grouped according to their angular geometry relative to a common reference condition. Three groups are considered: near-frontal illumination, oblique illumination, and large-angular-deviation illumination. These categories provide a structured basis for comparing reference-relative embedding displacement across different lighting directions. They represent angular geometry rather than illumination intensity.\\n\",\"\\n\",\"This distinction is important because the experiment uses different captures of the same individuals under different illumination conditions. The images are identity-matched observations, not exact transformations of identical source images. Therefore, the resulting differences in embedding space are examined as reference-relative associations with illumination geometry, rather than as effects attributable exclusively to illumination.\\\"\\\"\\\"\\n\",\"\\n\",\"references = [\\n\",\"    {\\n\",\"        \\\"citation\\\": \\\"Moses, Adini, and Ullman (1994)\\\",\\n\",\"        \\\"title\\\": \\\"Face Recognition: The Problem of Compensating for Changes in Illumination Direction\\\",\\n\",\"        \\\"doi\\\": \\\"10.1007/3-540-57956-7_33\\\",\\n\",\"        \\\"role\\\": \\\"Illumination direction and face recognition\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"citation\\\": \\\"Beveridge et al. (2009)\\\",\\n\",\"        \\\"title\\\": \\\"Principal angles separate subject illumination spaces in YDB and CMU-PIE\\\",\\n\",\"        \\\"doi\\\": \\\"10.1109/TPAMI.2008.200\\\",\\n\",\"        \\\"role\\\": \\\"Subject illumination spaces and angular analysis\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"citation\\\": \\\"Han et al. (2013)\\\",\\n\",\"        \\\"title\\\": \\\"A comparative study on illumination preprocessing in face recognition\\\",\\n\",\"        \\\"doi\\\": \\\"10.1016/j.patcog.2012.11.022\\\",\\n\",\"        \\\"role\\\": \\\"Illumination preprocessing\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"citation\\\": \\\"Ochoa-Villegas et al. (2015)\\\",\\n\",\"        \\\"title\\\": \\\"Addressing the illumination challenge in two-dimensional face recognition: a survey\\\",\\n\",\"        \\\"doi\\\": \\\"10.1049/iet-cvi.2014.0086\\\",\\n\",\"        \\\"role\\\": \\\"Review of illumination challenges\\\"\\n\",\"    }\\n\",\"]\\n\",\"\\n\",\"record = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"phase\\\": \\\"3.3\\\",\\n\",\"    \\\"step\\\": \\\"3.3.6.2\\\",\\n\",\"    \\\"heading\\\": \\\"Illumination Variation and Its Effect on Facial Representations\\\",\\n\",\"    \\\"draft\\\": draft,\\n\",\"    \\\"word_count\\\": len(draft.split()),\\n\",\"    \\\"supporting_references\\\": references,\\n\",\"    \\\"methodological_scope_checks\\\": {\\n\",\"        \\\"illumination_geometry_distinguished_from_intensity\\\": True,\\n\",\"        \\\"identity_matched_captures_distinguished_from_exact_source_transformations\\\": True,\\n\",\"        \\\"embedding_displacement_not_equated_with_recognition_failure\\\": True,\\n\",\"        \\\"causal_attribution_exclusively_to_illumination_claimed\\\": False\\n\",\"    },\\n\",\"    \\\"status\\\": \\\"FIRST_ILLUMINATION_CONTEXT_SECTION_DRAFT_PREPARED\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat()\\n\",\"}\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    json.dump(record, f, indent=2, ensure_ascii=False)\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    reloaded = json.load(f)\\n\",\"\\n\",\"assert reloaded == record\\n\",\"assert reloaded[\\\"methodological_scope_checks\\\"][\\n\",\"    \\\"illumination_geometry_distinguished_from_intensity\\\"\\n\",\"]\\n\",\"assert not reloaded[\\\"methodological_scope_checks\\\"][\\n\",\"    \\\"causal_attribution_exclusively_to_illumination_claimed\\\"\\n\",\"]\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.3.6.2\\\")\\n\",\"print(\\\"INTRODUCTION — SECTION 2: ILLUMINATION CONTEXT\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"Heading:\\\", reloaded[\\\"heading\\\"])\\n\",\"print(\\\"Word count:\\\", reloaded[\\\"word_count\\\"])\\n\",\"print(\\\"Supporting references:\\\", len(reloaded[\\\"supporting_references\\\"]))\\n\",\"print(\\\"Geometry distinguished from intensity: PASS\\\")\\n\",\"print(\\\"Capture limitation acknowledged: PASS\\\")\\n\",\"print(\\\"No causal overclaim: PASS\\\")\\n\",\"print(\\\"JSON reload: PASS\\\")\\n\",\"print(\\\"Saved:\\\", OUTPUT_FILE)\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"FW_PqlzO-sS9\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794390019774,\"user_tz\":360,\"elapsed\":80,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"6672bde6-346a-4af9-9c83-67f61f0940ae\"},\"execution_count\":52,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.3.6.2\\n\",\"INTRODUCTION — SECTION 2: ILLUMINATION CONTEXT\\n\",\"========================================================================================\\n\",\"Heading: Illumination Variation and Its Effect on Facial Representations\\n\",\"Word count: 328\\n\",\"Supporting references: 4\\n\",\"Geometry distinguished from intensity: PASS\\n\",\"Capture limitation acknowledged: PASS\\n\",\"No causal overclaim: PASS\\n\",\"JSON reload: PASS\\n\",\"Saved: /content/drive/MyDrive/Experiment_20_Results/step_3_3/experiment20_step3362_introduction_illumination_context.json\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"### 3. Research Gap and Motivation\\n\",\"\\n\",\"Existing research has examined the effects of illumination variation on face recognition through several approaches, including illumination preprocessing, feature representation, subject-specific illumination spaces, and recognition-performance evaluation. Studies using Yale B and Extended Yale B datasets have also investigated changes in facial representations under different lighting directions. More recent work has explored deep face-recognition architectures and the geometric properties of learned embedding spaces.\\n\",\"\\n\",\"Despite this established body of research, there remains a need for focused empirical characterisation of how reference-relative embedding displacement varies across illumination geometry conditions at the individual-identity level within a fixed pretrained face-recognition model. In particular, comparing multiple distance measures relative to a common reference capture provides a structured way to examine whether displacement patterns differ across illumination groups and whether these differences are consistent across identities.\\n\",\"\\n\",\"This study addresses that specific empirical question using a fixed pretrained InceptionResnetV1 model and the Cropped Extended Yale B dataset. Rather than developing an illumination-invariant representation or evaluating identity-classification performance, the investigation examines Euclidean displacement and cosine distance between identity-specific reference embeddings and embeddings from other captures of the same individuals.\\n\",\"\\n\",\"The motivation is to provide a transparent, identity-level description of embedding-space variation across defined illumination geometry conditions. By examining both observation-level distributions and repeated-measures differences across identities, the study seeks to characterise the consistency and magnitude of reference-relative displacement within the evaluated dataset.\\n\",\"\\n\",\"The resulting analysis is deliberately descriptive. Because the evaluation uses different image captures rather than exact transformations of identical source images, observed embedding differences cannot be attributed exclusively to illumination. The findings are also specific to the selected dataset, preprocessing procedure, and pretrained model. Accordingly, the study is intended to contribute a focused empirical characterisation rather than a general claim about all face-recognition systems.\"],\"metadata\":{\"id\":\"qQ21Y7kd_wyl\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"STEP_DIR = BASE / \\\"step_3_3\\\"\\n\",\"STEP_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"OUTPUT_FILE = STEP_DIR / (\\n\",\"    \\\"experiment20_step3363_introduction_research_gap.json\\\"\\n\",\")\\n\",\"\\n\",\"draft = \\\"\\\"\\\"Existing research has examined the effects of illumination variation on face recognition through several approaches, including illumination preprocessing, feature representation, subject-specific illumination spaces, and recognition-performance evaluation. Studies using Yale B and Extended Yale B datasets have also investigated changes in facial representations under different lighting directions. More recent work has explored deep face-recognition architectures and the geometric properties of learned embedding spaces.\\n\",\"\\n\",\"Despite this established body of research, there remains a need for focused empirical characterisation of how reference-relative embedding displacement varies across illumination geometry conditions at the individual-identity level within a fixed pretrained face-recognition model. In particular, comparing multiple distance measures relative to a common reference capture provides a structured way to examine whether displacement patterns differ across illumination groups and whether these differences are consistent across identities.\\n\",\"\\n\",\"This study addresses that specific empirical question using a fixed pretrained InceptionResnetV1 model and the Cropped Extended Yale B dataset. Rather than developing an illumination-invariant representation or evaluating identity-classification performance, the investigation examines Euclidean displacement and cosine distance between identity-specific reference embeddings and embeddings from other captures of the same individuals.\\n\",\"\\n\",\"The motivation is to provide a transparent, identity-level description of embedding-space variation across defined illumination geometry conditions. By examining both observation-level distributions and repeated-measures differences across identities, the study seeks to characterise the consistency and magnitude of reference-relative displacement within the evaluated dataset.\\n\",\"\\n\",\"The resulting analysis is deliberately descriptive. Because the evaluation uses different image captures rather than exact transformations of identical source images, observed embedding differences cannot be attributed exclusively to illumination. The findings are also specific to the selected dataset, preprocessing procedure, and pretrained model. Accordingly, the study is intended to contribute a focused empirical characterisation rather than a general claim about all face-recognition systems.\\\"\\\"\\\"\\n\",\"\\n\",\"record = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"phase\\\": \\\"3.3\\\",\\n\",\"    \\\"step\\\": \\\"3.3.6.3\\\",\\n\",\"    \\\"heading\\\": \\\"Research Gap and Motivation\\\",\\n\",\"    \\\"draft\\\": draft,\\n\",\"    \\\"word_count\\\": len(draft.split()),\\n\",\"    \\\"research_gap\\\": (\\n\",\"        \\\"Focused empirical characterisation of reference-relative \\\"\\n\",\"        \\\"embedding displacement across illumination geometry conditions \\\"\\n\",\"        \\\"at the individual-identity level within a fixed pretrained \\\"\\n\",\"        \\\"face-recognition model.\\\"\\n\",\"    ),\\n\",\"    \\\"positioning\\\": {\\n\",\"        \\\"claims_entire_field_unexplored\\\": False,\\n\",\"        \\\"claims_no_prior_yale_b_illumination_research\\\": False,\\n\",\"        \\\"claims_no_prior_embedding_geometry_research\\\": False,\\n\",\"        \\\"focuses_on_specific_empirical_design\\\": True\\n\",\"    },\\n\",\"    \\\"scope_limitations\\\": {\\n\",\"        \\\"different_captures_not_exact_source_transformations\\\": True,\\n\",\"        \\\"exclusive_illumination_causality_claimed\\\": False,\\n\",\"        \\\"generalisation_to_all_face_recognition_models_claimed\\\": False,\\n\",\"        \\\"recognition_accuracy_evaluated\\\": False\\n\",\"    },\\n\",\"    \\\"status\\\": \\\"FIRST_RESEARCH_GAP_SECTION_DRAFT_PREPARED\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat()\\n\",\"}\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    json.dump(record, f, indent=2, ensure_ascii=False)\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    reloaded = json.load(f)\\n\",\"\\n\",\"assert reloaded == record\\n\",\"assert reloaded[\\\"positioning\\\"][\\\"focuses_on_specific_empirical_design\\\"]\\n\",\"assert not reloaded[\\\"positioning\\\"][\\\"claims_entire_field_unexplored\\\"]\\n\",\"assert not reloaded[\\\"scope_limitations\\\"][\\\"exclusive_illumination_causality_claimed\\\"]\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.3.6.3\\\")\\n\",\"print(\\\"INTRODUCTION — SECTION 3: RESEARCH GAP AND MOTIVATION\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"Heading:\\\", reloaded[\\\"heading\\\"])\\n\",\"print(\\\"Word count:\\\", reloaded[\\\"word_count\\\"])\\n\",\"print(\\\"\\\\nResearch gap:\\\")\\n\",\"print(reloaded[\\\"research_gap\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nPositioning checks:\\\")\\n\",\"for key, value in reloaded[\\\"positioning\\\"].items():\\n\",\"    print(f\\\"{key}: {value}\\\")\\n\",\"\\n\",\"print(\\\"\\\\nScope limitation checks:\\\")\\n\",\"for key, value in reloaded[\\\"scope_limitations\\\"].items():\\n\",\"    print(f\\\"{key}: {value}\\\")\\n\",\"\\n\",\"print(\\\"\\\\nJSON reload: PASS\\\")\\n\",\"print(\\\"Saved:\\\", OUTPUT_FILE)\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"bRl8wvXU_1uF\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794390327487,\"user_tz\":360,\"elapsed\":149,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"2eb1f934-7e3e-44df-855a-af95bfc170c1\"},\"execution_count\":53,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.3.6.3\\n\",\"INTRODUCTION — SECTION 3: RESEARCH GAP AND MOTIVATION\\n\",\"========================================================================================\\n\",\"Heading: Research Gap and Motivation\\n\",\"Word count: 287\\n\",\"\\n\",\"Research gap:\\n\",\"Focused empirical characterisation of reference-relative embedding displacement across illumination geometry conditions at the individual-identity level within a fixed pretrained face-recognition model.\\n\",\"\\n\",\"Positioning checks:\\n\",\"claims_entire_field_unexplored: False\\n\",\"claims_no_prior_yale_b_illumination_research: False\\n\",\"claims_no_prior_embedding_geometry_research: False\\n\",\"focuses_on_specific_empirical_design: True\\n\",\"\\n\",\"Scope limitation checks:\\n\",\"different_captures_not_exact_source_transformations: True\\n\",\"exclusive_illumination_causality_claimed: False\\n\",\"generalisation_to_all_face_recognition_models_claimed: False\\n\",\"recognition_accuracy_evaluated: False\\n\",\"\\n\",\"JSON reload: PASS\\n\",\"Saved: /content/drive/MyDrive/Experiment_20_Results/step_3_3/experiment20_step3363_introduction_research_gap.json\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"### 4. Research Questions and Objectives\\n\",\"\\n\",\"Based on the identified research gap, this study investigates how reference-relative face embedding displacement varies across illumination geometry conditions and how consistently these differences are observed across individual identities. The investigation is guided by the following research questions:\\n\",\"\\n\",\"**RQ1:** How do Euclidean embedding displacement and cosine distance vary across near-frontal, oblique, and large-angular illumination conditions?\\n\",\"\\n\",\"**RQ2:** Are the differences between illumination geometry groups consistent across evaluated identities?\\n\",\"\\n\",\"**RQ3:** How do reference-relative embedding displacement patterns differ between frontal and beyond-frontal illumination conditions?\\n\",\"\\n\",\"To address these questions, the study has five objectives:\\n\",\"\\n\",\"1. To generate and examine fixed pretrained face embeddings for identity-matched captures under different illumination conditions.\\n\",\"2. To quantify reference-relative embedding displacement using Euclidean distance and cosine distance.\\n\",\"3. To classify common illumination conditions into near-frontal, oblique, and large-angular geometry groups.\\n\",\"4. To compare displacement measurements across illumination groups using identity-level repeated-measures statistical analysis.\\n\",\"5. To explore differences between frontal and beyond-frontal illumination conditions while accounting for the unequal number of evaluated conditions.\\n\",\"\\n\",\"The first two research questions form the primary analytical focus of the study. The third question provides an additional exploratory examination of illumination geometry. The statistical hypotheses associated with these comparisons were formulated after the experimental analyses and are therefore treated as retrospective analytical expectations rather than preregistered hypotheses.\"],\"metadata\":{\"id\":\"_Q-uEBHFAGyU\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"STEP_DIR = BASE / \\\"step_3_3\\\"\\n\",\"STEP_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"OUTPUT_FILE = STEP_DIR / (\\n\",\"    \\\"experiment20_step3364_introduction_research_questions_objectives.json\\\"\\n\",\")\\n\",\"\\n\",\"draft = \\\"\\\"\\\"Based on the identified research gap, this study investigates how reference-relative face embedding displacement varies across illumination geometry conditions and how consistently these differences are observed across individual identities. The investigation is guided by the following research questions:\\n\",\"\\n\",\"RQ1: How do Euclidean embedding displacement and cosine distance vary across near-frontal, oblique, and large-angular illumination conditions?\\n\",\"\\n\",\"RQ2: Are the differences between illumination geometry groups consistent across evaluated identities?\\n\",\"\\n\",\"RQ3: How do reference-relative embedding displacement patterns differ between frontal and beyond-frontal illumination conditions?\\n\",\"\\n\",\"To address these questions, the study has five objectives:\\n\",\"\\n\",\"1. To generate and examine fixed pretrained face embeddings for identity-matched captures under different illumination conditions.\\n\",\"2. To quantify reference-relative embedding displacement using Euclidean distance and cosine distance.\\n\",\"3. To classify common illumination conditions into near-frontal, oblique, and large-angular geometry groups.\\n\",\"4. To compare displacement measurements across illumination groups using identity-level repeated-measures statistical analysis.\\n\",\"5. To explore differences between frontal and beyond-frontal illumination conditions while accounting for the unequal number of evaluated conditions.\\n\",\"\\n\",\"The first two research questions form the primary analytical focus of the study. The third question provides an additional exploratory examination of illumination geometry. The statistical hypotheses associated with these comparisons were formulated after the experimental analyses and are therefore treated as retrospective analytical expectations rather than preregistered hypotheses.\\\"\\\"\\\"\\n\",\"\\n\",\"research_questions = [\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"RQ1\\\",\\n\",\"        \\\"question\\\": \\\"How do Euclidean embedding displacement and cosine distance vary across near-frontal, oblique, and large-angular illumination conditions?\\\",\\n\",\"        \\\"status\\\": \\\"PRIMARY\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"RQ2\\\",\\n\",\"        \\\"question\\\": \\\"Are the differences between illumination geometry groups consistent across evaluated identities?\\\",\\n\",\"        \\\"status\\\": \\\"PRIMARY\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"RQ3\\\",\\n\",\"        \\\"question\\\": \\\"How do reference-relative embedding displacement patterns differ between frontal and beyond-frontal illumination conditions?\\\",\\n\",\"        \\\"status\\\": \\\"EXPLORATORY\\\"\\n\",\"    }\\n\",\"]\\n\",\"\\n\",\"objectives = [\\n\",\"    \\\"To generate and examine fixed pretrained face embeddings for identity-matched captures under different illumination conditions.\\\",\\n\",\"    \\\"To quantify reference-relative embedding displacement using Euclidean distance and cosine distance.\\\",\\n\",\"    \\\"To classify common illumination conditions into near-frontal, oblique, and large-angular geometry groups.\\\",\\n\",\"    \\\"To compare displacement measurements across illumination groups using identity-level repeated-measures statistical analysis.\\\",\\n\",\"    \\\"To explore differences between frontal and beyond-frontal illumination conditions while accounting for the unequal number of evaluated conditions.\\\"\\n\",\"]\\n\",\"\\n\",\"record = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"phase\\\": \\\"3.3\\\",\\n\",\"    \\\"step\\\": \\\"3.3.6.4\\\",\\n\",\"    \\\"heading\\\": \\\"Research Questions and Objectives\\\",\\n\",\"    \\\"draft\\\": draft,\\n\",\"    \\\"word_count\\\": len(draft.split()),\\n\",\"    \\\"research_questions\\\": research_questions,\\n\",\"    \\\"objectives\\\": objectives,\\n\",\"    \\\"analytical_status\\\": {\\n\",\"        \\\"primary_questions\\\": [\\\"RQ1\\\", \\\"RQ2\\\"],\\n\",\"        \\\"exploratory_questions\\\": [\\\"RQ3\\\"],\\n\",\"        \\\"hypotheses_formulated_after_analysis\\\": True,\\n\",\"        \\\"hypotheses_preregistered\\\": False\\n\",\"    },\\n\",\"    \\\"scope_checks\\\": {\\n\",\"        \\\"euclidean_and_cosine_metrics_included\\\": True,\\n\",\"        \\\"three_illumination_groups_included\\\": True,\\n\",\"        \\\"identity_level_analysis_included\\\": True,\\n\",\"        \\\"unequal_hemisphere_conditions_acknowledged\\\": True,\\n\",\"        \\\"exploratory_comparison_distinguished\\\": True\\n\",\"    },\\n\",\"    \\\"status\\\": \\\"FIRST_RESEARCH_QUESTIONS_AND_OBJECTIVES_SECTION_DRAFT_PREPARED\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat()\\n\",\"}\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    json.dump(record, f, indent=2, ensure_ascii=False)\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    reloaded = json.load(f)\\n\",\"\\n\",\"assert reloaded == record\\n\",\"assert len(reloaded[\\\"research_questions\\\"]) == 3\\n\",\"assert len(reloaded[\\\"objectives\\\"]) == 5\\n\",\"assert reloaded[\\\"analytical_status\\\"][\\\"hypotheses_preregistered\\\"] is False\\n\",\"assert reloaded[\\\"analytical_status\\\"][\\\"exploratory_questions\\\"] == [\\\"RQ3\\\"]\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.3.6.4\\\")\\n\",\"print(\\\"INTRODUCTION — SECTION 4: RESEARCH QUESTIONS AND OBJECTIVES\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"print(\\\"\\\\nResearch questions:\\\")\\n\",\"for item in reloaded[\\\"research_questions\\\"]:\\n\",\"    print(f\\\"{item['id']} [{item['status']}]: {item['question']}\\\")\\n\",\"\\n\",\"print(\\\"\\\\nObjectives:\\\")\\n\",\"for i, objective in enumerate(reloaded[\\\"objectives\\\"], start=1):\\n\",\"    print(f\\\"{i}. {objective}\\\")\\n\",\"\\n\",\"print(\\\"\\\\nWord count:\\\", reloaded[\\\"word_count\\\"])\\n\",\"print(\\\"Primary questions: RQ1, RQ2\\\")\\n\",\"print(\\\"Exploratory question: RQ3\\\")\\n\",\"print(\\\"Hypotheses preregistered: False\\\")\\n\",\"\\n\",\"print(\\\"\\\\nScope checks:\\\")\\n\",\"for key, value in reloaded[\\\"scope_checks\\\"].items():\\n\",\"    print(f\\\"{key}: {value}\\\")\\n\",\"\\n\",\"print(\\\"\\\\nJSON reload: PASS\\\")\\n\",\"print(\\\"Saved:\\\", OUTPUT_FILE)\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"kl3s-Ir_AIgn\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794390397655,\"user_tz\":360,\"elapsed\":60,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"59f31d54-db1f-4799-fc00-2caf8a860dc1\"},\"execution_count\":54,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.3.6.4\\n\",\"INTRODUCTION — SECTION 4: RESEARCH QUESTIONS AND OBJECTIVES\\n\",\"========================================================================================\\n\",\"\\n\",\"Research questions:\\n\",\"RQ1 [PRIMARY]: How do Euclidean embedding displacement and cosine distance vary across near-frontal, oblique, and large-angular illumination conditions?\\n\",\"RQ2 [PRIMARY]: Are the differences between illumination geometry groups consistent across evaluated identities?\\n\",\"RQ3 [EXPLORATORY]: How do reference-relative embedding displacement patterns differ between frontal and beyond-frontal illumination conditions?\\n\",\"\\n\",\"Objectives:\\n\",\"1. To generate and examine fixed pretrained face embeddings for identity-matched captures under different illumination conditions.\\n\",\"2. To quantify reference-relative embedding displacement using Euclidean distance and cosine distance.\\n\",\"3. To classify common illumination conditions into near-frontal, oblique, and large-angular geometry groups.\\n\",\"4. To compare displacement measurements across illumination groups using identity-level repeated-measures statistical analysis.\\n\",\"5. To explore differences between frontal and beyond-frontal illumination conditions while accounting for the unequal number of evaluated conditions.\\n\",\"\\n\",\"Word count: 212\\n\",\"Primary questions: RQ1, RQ2\\n\",\"Exploratory question: RQ3\\n\",\"Hypotheses preregistered: False\\n\",\"\\n\",\"Scope checks:\\n\",\"euclidean_and_cosine_metrics_included: True\\n\",\"three_illumination_groups_included: True\\n\",\"identity_level_analysis_included: True\\n\",\"unequal_hemisphere_conditions_acknowledged: True\\n\",\"exploratory_comparison_distinguished: True\\n\",\"\\n\",\"JSON reload: PASS\\n\",\"Saved: /content/drive/MyDrive/Experiment_20_Results/step_3_3/experiment20_step3364_introduction_research_questions_objectives.json\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.3.6.5\\n\",\"## Introduction\\n\",\"### 5. Study Contributions and Scope\\n\",\"\\n\",\"This study makes four empirical contributions.\\n\",\"\\n\",\"First, it provides an identity-level characterisation of reference-relative face embedding displacement across three illumination geometry groups: near-frontal, oblique, and large-angular conditions. The analysis examines how the magnitude of displacement varies across individual identities within the evaluated dataset.\\n\",\"\\n\",\"Second, it compares two complementary embedding-space distance measures: Euclidean displacement and cosine distance. Using both measures provides a broader descriptive examination of changes in embedding representations relative to an identity-specific reference capture.\\n\",\"\\n\",\"Third, it applies repeated-measures statistical analysis to examine differences between the three illumination geometry groups across the evaluated identities. This analysis considers both the magnitude of group differences and the consistency of their ordering across identities.\\n\",\"\\n\",\"Fourth, it provides an exploratory comparison of frontal and beyond-frontal illumination conditions, examining whether reference-relative displacement differs between these broader geometric categories.\\n\",\"\\n\",\"The scope of the study is deliberately limited. The evaluation uses the Cropped Extended Yale B dataset, comprising 38 identities and 2,414 standard-illumination images, and a fixed pretrained InceptionResnetV1 model. Each identity is represented by one reference capture, against which embeddings from other captures are compared. The evaluation therefore examines different identity-matched captures rather than exact transformations of identical source images.\\n\",\"\\n\",\"The study does not evaluate face-recognition accuracy, develop an illumination-invariant representation, establish operational drift-detection capability, or validate generalisation across independent recognition architectures. Its findings should be interpreted as an empirical characterisation of reference-relative embedding displacement under the specific dataset, preprocessing procedure, and model used in this investigation.\"],\"metadata\":{\"id\":\"aHk8q9GgAbpe\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"STEP_DIR = BASE / \\\"step_3_3\\\"\\n\",\"STEP_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"OUTPUT_FILE = STEP_DIR / (\\n\",\"    \\\"experiment20_step3365_introduction_contributions_scope.json\\\"\\n\",\")\\n\",\"\\n\",\"draft = \\\"\\\"\\\"This study makes four empirical contributions.\\n\",\"\\n\",\"First, it provides an identity-level characterisation of reference-relative face embedding displacement across three illumination geometry groups: near-frontal, oblique, and large-angular conditions. The analysis examines how the magnitude of displacement varies across individual identities within the evaluated dataset.\\n\",\"\\n\",\"Second, it compares two complementary embedding-space distance measures: Euclidean displacement and cosine distance. Using both measures provides a broader descriptive examination of changes in embedding representations relative to an identity-specific reference capture.\\n\",\"\\n\",\"Third, it applies repeated-measures statistical analysis to examine differences between the three illumination geometry groups across the evaluated identities. This analysis considers both the magnitude of group differences and the consistency of their ordering across identities.\\n\",\"\\n\",\"Fourth, it provides an exploratory comparison of frontal and beyond-frontal illumination conditions, examining whether reference-relative displacement differs between these broader geometric categories.\\n\",\"\\n\",\"The scope of the study is deliberately limited. The evaluation uses the Cropped Extended Yale B dataset, comprising 38 identities and 2,414 standard-illumination images, and a fixed pretrained InceptionResnetV1 model. Each identity is represented by one reference capture, against which embeddings from other captures are compared. The evaluation therefore examines different identity-matched captures rather than exact transformations of identical source images.\\n\",\"\\n\",\"The study does not evaluate face-recognition accuracy, develop an illumination-invariant representation, establish operational drift-detection capability, or validate generalisation across independent recognition architectures. Its findings should be interpreted as an empirical characterisation of reference-relative embedding displacement under the specific dataset, preprocessing procedure, and model used in this investigation.\\\"\\\"\\\"\\n\",\"\\n\",\"contributions = [\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"C1\\\",\\n\",\"        \\\"description\\\": \\\"Identity-level characterisation of reference-relative embedding displacement across three illumination geometry groups.\\\",\\n\",\"        \\\"type\\\": \\\"EMPIRICAL\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"C2\\\",\\n\",\"        \\\"description\\\": \\\"Comparison of Euclidean displacement and cosine distance relative to identity-specific reference captures.\\\",\\n\",\"        \\\"type\\\": \\\"EMPIRICAL\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"C3\\\",\\n\",\"        \\\"description\\\": \\\"Repeated-measures statistical comparison of displacement across the three illumination geometry groups.\\\",\\n\",\"        \\\"type\\\": \\\"STATISTICAL\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"C4\\\",\\n\",\"        \\\"description\\\": \\\"Exploratory comparison of frontal and beyond-frontal illumination conditions.\\\",\\n\",\"        \\\"type\\\": \\\"EXPLORATORY\\\"\\n\",\"    }\\n\",\"]\\n\",\"\\n\",\"scope = {\\n\",\"    \\\"dataset\\\": \\\"Cropped Extended Yale B\\\",\\n\",\"    \\\"identities\\\": 38,\\n\",\"    \\\"standard_illumination_images\\\": 2414,\\n\",\"    \\\"evaluation_observations\\\": 2128,\\n\",\"    \\\"evaluation_conditions\\\": 56,\\n\",\"    \\\"model\\\": \\\"InceptionResnetV1 pretrained on VGGFace2\\\",\\n\",\"    \\\"embedding_dimension\\\": 512,\\n\",\"    \\\"reference_strategy\\\": \\\"One reference capture per identity\\\",\\n\",\"    \\\"evaluation_design\\\": \\\"Different identity-matched captures, not exact source-image transformations\\\"\\n\",\"}\\n\",\"\\n\",\"limitations = {\\n\",\"    \\\"single_pretrained_architecture\\\": True,\\n\",\"    \\\"one_reference_capture_per_identity\\\": True,\\n\",\"    \\\"different_captures_not_exact_source_transformations\\\": True,\\n\",\"    \\\"recognition_accuracy_evaluated\\\": False,\\n\",\"    \\\"new_illumination_invariant_representation_developed\\\": False,\\n\",\"    \\\"operational_drift_detection_validated\\\": False,\\n\",\"    \\\"independent_architecture_generalisation_evaluated\\\": False\\n\",\"}\\n\",\"\\n\",\"record = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"phase\\\": \\\"3.3\\\",\\n\",\"    \\\"step\\\": \\\"3.3.6.5\\\",\\n\",\"    \\\"heading\\\": \\\"Study Contributions and Scope\\\",\\n\",\"    \\\"draft\\\": draft,\\n\",\"    \\\"word_count\\\": len(draft.split()),\\n\",\"    \\\"contributions\\\": contributions,\\n\",\"    \\\"scope\\\": scope,\\n\",\"    \\\"limitations\\\": limitations,\\n\",\"    \\\"status\\\": \\\"FIRST_CONTRIBUTIONS_AND_SCOPE_SECTION_DRAFT_PREPARED\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat()\\n\",\"}\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    json.dump(record, f, indent=2, ensure_ascii=False)\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    reloaded = json.load(f)\\n\",\"\\n\",\"assert reloaded == record\\n\",\"assert len(reloaded[\\\"contributions\\\"]) == 4\\n\",\"assert reloaded[\\\"scope\\\"][\\\"identities\\\"] == 38\\n\",\"assert reloaded[\\\"scope\\\"][\\\"evaluation_observations\\\"] == 2128\\n\",\"assert reloaded[\\\"scope\\\"][\\\"evaluation_conditions\\\"] == 56\\n\",\"assert reloaded[\\\"limitations\\\"][\\\"recognition_accuracy_evaluated\\\"] is False\\n\",\"assert reloaded[\\\"limitations\\\"][\\\"operational_drift_detection_validated\\\"] is False\\n\",\"assert reloaded[\\\"limitations\\\"][\\\"independent_architecture_generalisation_evaluated\\\"] is False\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.3.6.5\\\")\\n\",\"print(\\\"INTRODUCTION — SECTION 5: CONTRIBUTIONS AND SCOPE\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"print(\\\"\\\\nContributions:\\\")\\n\",\"for item in reloaded[\\\"contributions\\\"]:\\n\",\"    print(f\\\"{item['id']} [{item['type']}]: {item['description']}\\\")\\n\",\"\\n\",\"print(\\\"\\\\nScope:\\\")\\n\",\"for key, value in reloaded[\\\"scope\\\"].items():\\n\",\"    print(f\\\"{key}: {value}\\\")\\n\",\"\\n\",\"print(\\\"\\\\nLimitations:\\\")\\n\",\"for key, value in reloaded[\\\"limitations\\\"].items():\\n\",\"    print(f\\\"{key}: {value}\\\")\\n\",\"\\n\",\"print(\\\"\\\\nWord count:\\\", reloaded[\\\"word_count\\\"])\\n\",\"print(\\\"JSON reload: PASS\\\")\\n\",\"print(\\\"Saved:\\\", OUTPUT_FILE)\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"RKitKMAPAdY3\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794390483769,\"user_tz\":360,\"elapsed\":205,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"f7948967-3648-4c70-a837-a15fb11a39d9\"},\"execution_count\":55,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.3.6.5\\n\",\"INTRODUCTION — SECTION 5: CONTRIBUTIONS AND SCOPE\\n\",\"========================================================================================\\n\",\"\\n\",\"Contributions:\\n\",\"C1 [EMPIRICAL]: Identity-level characterisation of reference-relative embedding displacement across three illumination geometry groups.\\n\",\"C2 [EMPIRICAL]: Comparison of Euclidean displacement and cosine distance relative to identity-specific reference captures.\\n\",\"C3 [STATISTICAL]: Repeated-measures statistical comparison of displacement across the three illumination geometry groups.\\n\",\"C4 [EXPLORATORY]: Exploratory comparison of frontal and beyond-frontal illumination conditions.\\n\",\"\\n\",\"Scope:\\n\",\"dataset: Cropped Extended Yale B\\n\",\"identities: 38\\n\",\"standard_illumination_images: 2414\\n\",\"evaluation_observations: 2128\\n\",\"evaluation_conditions: 56\\n\",\"model: InceptionResnetV1 pretrained on VGGFace2\\n\",\"embedding_dimension: 512\\n\",\"reference_strategy: One reference capture per identity\\n\",\"evaluation_design: Different identity-matched captures, not exact source-image transformations\\n\",\"\\n\",\"Limitations:\\n\",\"single_pretrained_architecture: True\\n\",\"one_reference_capture_per_identity: True\\n\",\"different_captures_not_exact_source_transformations: True\\n\",\"recognition_accuracy_evaluated: False\\n\",\"new_illumination_invariant_representation_developed: False\\n\",\"operational_drift_detection_validated: False\\n\",\"independent_architecture_generalisation_evaluated: False\\n\",\"\\n\",\"Word count: 241\\n\",\"JSON reload: PASS\\n\",\"Saved: /content/drive/MyDrive/Experiment_20_Results/step_3_3/experiment20_step3365_introduction_contributions_scope.json\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.3.7\\n\",\"## Introduction Consolidation and Consistency Audit\\n\",\"\\n\",\"### Purpose\\n\",\"\\n\",\"This step combines the five previously drafted introduction sections into one manuscript-ready working draft.\\n\",\"\\n\",\"### Sections to consolidate\\n\",\"\\n\",\"1. Background: Face Recognition and Deep Face Embeddings.\\n\",\"2. Illumination Variation and Its Effect on Facial Representations.\\n\",\"3. Research Gap and Motivation.\\n\",\"4. Research Questions and Objectives.\\n\",\"5. Study Contributions and Scope.\\n\",\"\\n\",\"### Consistency requirements\\n\",\"\\n\",\"- Preserve the established research questions and objectives.\\n\",\"- Use consistent terminology for reference-relative embedding displacement.\\n\",\"- Distinguish Euclidean displacement from cosine distance.\\n\",\"- Distinguish the total image count from common-condition and evaluation counts.\\n\",\"- Describe illumination groups as angular geometry categories.\\n\",\"- Preserve the distinction between primary and exploratory analyses.\\n\",\"- Disclose that the hypotheses were formulated retrospectively.\\n\",\"- Avoid unsupported novelty, causality, recognition-accuracy, and generalisation claims.\\n\",\"- Identify citations that still require bibliographic verification.\\n\",\"\\n\",\"### Deliverables\\n\",\"\\n\",\"1. Consolidated introduction in Markdown.\\n\",\"2. Consolidated introduction in JSON.\\n\",\"3. Introduction consistency audit.\\n\",\"4. Word-count and section-count verification.\\n\",\"\\n\",\"The consolidated draft remains subject to citation verification and final editorial review.\"],\"metadata\":{\"id\":\"HDlqMSZnAv0H\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"STEP_DIR = BASE / \\\"step_3_3\\\"\\n\",\"OUTPUT_DIR = STEP_DIR / \\\"step_337\\\"\\n\",\"OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 1. Load the five previously saved sections\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"files = {\\n\",\"    \\\"background\\\": STEP_DIR / \\\"experiment20_step336_introduction_section1_background.json\\\",\\n\",\"    \\\"illumination\\\": STEP_DIR / \\\"experiment20_step3362_introduction_illumination_context.json\\\",\\n\",\"    \\\"research_gap\\\": STEP_DIR / \\\"experiment20_step3363_introduction_research_gap.json\\\",\\n\",\"    \\\"research_questions\\\": STEP_DIR / \\\"experiment20_step3364_introduction_research_questions_objectives.json\\\",\\n\",\"    \\\"contributions\\\": STEP_DIR / \\\"experiment20_step3365_introduction_contributions_scope.json\\\"\\n\",\"}\\n\",\"\\n\",\"loaded = {}\\n\",\"\\n\",\"for name, path in files.items():\\n\",\"    if not path.exists():\\n\",\"        raise FileNotFoundError(f\\\"Required section is missing: {path}\\\")\\n\",\"\\n\",\"    with open(path, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"        loaded[name] = json.load(f)\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 2. Extract section drafts\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"background = loaded[\\\"background\\\"][\\\"draft\\\"]\\n\",\"illumination = loaded[\\\"illumination\\\"][\\\"draft\\\"]\\n\",\"research_gap = loaded[\\\"research_gap\\\"][\\\"draft\\\"]\\n\",\"research_questions = loaded[\\\"research_questions\\\"][\\\"draft\\\"]\\n\",\"contributions = loaded[\\\"contributions\\\"][\\\"draft\\\"]\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 3. Apply explicit numerical clarification\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"# The original contribution section gives the total image count.\\n\",\"# Add the common-condition and evaluation counts to clarify\\n\",\"# the different dataset stages.\\n\",\"\\n\",\"scope_clarification = (\\n\",\"    \\\"Of the 2,414 standard-illumination images, \\\"\\n\",\"    \\\"2,166 observations belong to the 57 common illumination \\\"\\n\",\"    \\\"conditions. After excluding the reference condition, \\\"\\n\",\"    \\\"2,128 non-reference observations across 56 evaluation \\\"\\n\",\"    \\\"conditions are included in the displacement analysis.\\\"\\n\",\")\\n\",\"\\n\",\"# Add clarification after the paragraph describing dataset/model.\\n\",\"scope_sentence = (\\n\",\"    \\\"The evaluation uses the Cropped Extended Yale B dataset, \\\"\\n\",\"    \\\"comprising 38 identities and 2,414 standard-illumination images, \\\"\\n\",\"    \\\"and a fixed pretrained InceptionResnetV1 model.\\\"\\n\",\")\\n\",\"\\n\",\"if scope_sentence not in contributions:\\n\",\"    raise ValueError(\\n\",\"        \\\"Expected dataset scope sentence was not found. \\\"\\n\",\"        \\\"Review the source section before modifying it.\\\"\\n\",\"    )\\n\",\"\\n\",\"contributions = contributions.replace(\\n\",\"    scope_sentence,\\n\",\"    scope_sentence + \\\" \\\" + scope_clarification\\n\",\")\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 4. Assemble the consolidated introduction\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"title = (\\n\",\"    \\\"# 1. Introduction\\\\n\\\\n\\\"\\n\",\")\\n\",\"\\n\",\"sections = [\\n\",\"    (\\\"1.1 Background: Face Recognition and Deep Face Embeddings\\\", background),\\n\",\"    (\\\"1.2 Illumination Variation and Its Effect on Facial Representations\\\", illumination),\\n\",\"    (\\\"1.3 Research Gap and Motivation\\\", research_gap),\\n\",\"    (\\\"1.4 Research Questions and Objectives\\\", research_questions),\\n\",\"    (\\\"1.5 Study Contributions and Scope\\\", contributions)\\n\",\"]\\n\",\"\\n\",\"introduction_parts = [title]\\n\",\"\\n\",\"for heading, text_content in sections:\\n\",\"    introduction_parts.append(f\\\"## {heading}\\\\n\\\\n{text_content.strip()}\\\\n\\\")\\n\",\"\\n\",\"introduction_markdown = \\\"\\\\n\\\".join(introduction_parts).strip() + \\\"\\\\n\\\"\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 5. Audit checks\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"all_text = introduction_markdown.lower()\\n\",\"\\n\",\"checks = {\\n\",\"    \\\"all_five_sections_present\\\": len(sections) == 5,\\n\",\"    \\\"reference_relative_terminology_present\\\": \\\"reference-relative\\\" in all_text,\\n\",\"    \\\"euclidean_metric_present\\\": \\\"euclidean\\\" in all_text,\\n\",\"    \\\"cosine_metric_present\\\": \\\"cosine distance\\\" in all_text,\\n\",\"    \\\"three_illumination_groups_present\\\": all(\\n\",\"        term in all_text\\n\",\"        for term in [\\\"near-frontal\\\", \\\"oblique\\\", \\\"large-angular\\\"]\\n\",\"    ),\\n\",\"    \\\"38_identities_present\\\": \\\"38 identities\\\" in all_text,\\n\",\"    \\\"2414_total_images_present\\\": \\\"2,414\\\" in introduction_markdown,\\n\",\"    \\\"2166_common_observations_present\\\": \\\"2,166\\\" in introduction_markdown,\\n\",\"    \\\"2128_evaluation_observations_present\\\": \\\"2,128\\\" in introduction_markdown,\\n\",\"    \\\"56_evaluation_conditions_present\\\": \\\"56 evaluation conditions\\\" in all_text,\\n\",\"    \\\"retrospective_hypotheses_disclosed\\\": \\\"retrospective\\\" in all_text,\\n\",\"    \\\"exploratory_analysis_distinguished\\\": \\\"exploratory\\\" in all_text,\\n\",\"    \\\"different_capture_limitation_present\\\": \\\"different captures\\\" in all_text,\\n\",\"    \\\"recognition_accuracy_not_claimed\\\": \\\"does not evaluate face-recognition accuracy\\\" in all_text,\\n\",\"    \\\"architecture_generalisation_limitation_present\\\": \\\"independent recognition architectures\\\" in all_text\\n\",\"}\\n\",\"\\n\",\"# Research question identifiers\\n\",\"rq_checks = {\\n\",\"    \\\"RQ1_present\\\": \\\"RQ1:\\\" in introduction_markdown,\\n\",\"    \\\"RQ2_present\\\": \\\"RQ2:\\\" in introduction_markdown,\\n\",\"    \\\"RQ3_present\\\": \\\"RQ3:\\\" in introduction_markdown\\n\",\"}\\n\",\"\\n\",\"# Citation inventory from the drafted sections\\n\",\"citation_inventory = [\\n\",\"    \\\"Moses, Adini, and Ullman (1994)\\\",\\n\",\"    \\\"Beveridge et al. (2009)\\\",\\n\",\"    \\\"Han et al. (2013)\\\",\\n\",\"    \\\"Ochoa-Villegas et al. (2015)\\\"\\n\",\"]\\n\",\"\\n\",\"# These citations were inherited from the preliminary literature\\n\",\"# baseline. Their exact claim-level support remains to be verified.\\n\",\"citation_status = {\\n\",\"    \\\"citations_inherited_from_existing_literature_baseline\\\": True,\\n\",\"    \\\"bibliographic_verification_complete\\\": False,\\n\",\"    \\\"claim_level_support_verification_complete\\\": False\\n\",\"}\\n\",\"\\n\",\"word_count = len(introduction_markdown.split())\\n\",\"\\n\",\"audit = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"phase\\\": \\\"3.3\\\",\\n\",\"    \\\"step\\\": \\\"3.3.7\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"section_count\\\": len(sections),\\n\",\"    \\\"section_headings\\\": [heading for heading, _ in sections],\\n\",\"    \\\"word_count\\\": word_count,\\n\",\"    \\\"consistency_checks\\\": checks,\\n\",\"    \\\"research_question_checks\\\": rq_checks,\\n\",\"    \\\"citation_inventory\\\": citation_inventory,\\n\",\"    \\\"citation_status\\\": citation_status,\\n\",\"    \\\"editorial_clarification\\\": {\\n\",\"        \\\"total_standard_illumination_images\\\": 2414,\\n\",\"        \\\"common_condition_observations\\\": 2166,\\n\",\"        \\\"common_illumination_conditions\\\": 57,\\n\",\"        \\\"non_reference_evaluation_observations\\\": 2128,\\n\",\"        \\\"evaluation_conditions\\\": 56,\\n\",\"        \\\"clarification_added\\\": True\\n\",\"    },\\n\",\"    \\\"passed_checks\\\": sum(checks.values()) + sum(rq_checks.values()),\\n\",\"    \\\"total_checks\\\": len(checks) + len(rq_checks),\\n\",\"    \\\"failed_checks\\\": [\\n\",\"        key for key, value in {**checks, **rq_checks}.items()\\n\",\"        if not value\\n\",\"    ],\\n\",\"    \\\"status\\\": (\\n\",\"        \\\"INTRODUCTION_CONSOLIDATED_INITIAL_AUDIT_PASSED\\\"\\n\",\"        if all(checks.values()) and all(rq_checks.values())\\n\",\"        else \\\"INTRODUCTION_CONSOLIDATED_AUDIT_REQUIRES_REVIEW\\\"\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 6. Save Markdown, JSON and audit\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"markdown_path = OUTPUT_DIR / \\\"experiment20_consolidated_introduction.md\\\"\\n\",\"json_path = OUTPUT_DIR / \\\"experiment20_consolidated_introduction.json\\\"\\n\",\"audit_path = OUTPUT_DIR / \\\"experiment20_step337_introduction_audit.json\\\"\\n\",\"\\n\",\"with open(markdown_path, \\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    f.write(introduction_markdown)\\n\",\"\\n\",\"consolidated_record = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"phase\\\": \\\"3.3\\\",\\n\",\"    \\\"step\\\": \\\"3.3.7\\\",\\n\",\"    \\\"title\\\": \\\"Reference-Relative Face Embedding Displacement Across Illumination Geometry Conditions: An Identity-Level Empirical Study\\\",\\n\",\"    \\\"introduction_markdown\\\": introduction_markdown,\\n\",\"    \\\"section_count\\\": len(sections),\\n\",\"    \\\"word_count\\\": word_count,\\n\",\"    \\\"source_section_files\\\": {\\n\",\"        name: str(path) for name, path in files.items()\\n\",\"    },\\n\",\"    \\\"status\\\": audit[\\\"status\\\"]\\n\",\"}\\n\",\"\\n\",\"with open(json_path, \\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    json.dump(consolidated_record, f, indent=2, ensure_ascii=False)\\n\",\"\\n\",\"with open(audit_path, \\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    json.dump(audit, f, indent=2, ensure_ascii=False)\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 7. Reload verification\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"with open(markdown_path, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    markdown_reloaded = f.read()\\n\",\"\\n\",\"with open(json_path, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    json_reloaded = json.load(f)\\n\",\"\\n\",\"with open(audit_path, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    audit_reloaded = json.load(f)\\n\",\"\\n\",\"assert markdown_reloaded == introduction_markdown\\n\",\"assert json_reloaded[\\\"introduction_markdown\\\"] == introduction_markdown\\n\",\"assert audit_reloaded == audit\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.3.7\\\")\\n\",\"print(\\\"INTRODUCTION CONSOLIDATION AND CONSISTENCY AUDIT\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"print(\\\"\\\\nSections consolidated:\\\", len(sections))\\n\",\"for index, (heading, _) in enumerate(sections, start=1):\\n\",\"    print(f\\\"{index}. {heading}\\\")\\n\",\"\\n\",\"print(\\\"\\\\nDataset count clarification:\\\")\\n\",\"print(\\\"Total standard-illumination images: 2,414\\\")\\n\",\"print(\\\"Common-condition observations: 2,166\\\")\\n\",\"print(\\\"Common illumination conditions: 57\\\")\\n\",\"print(\\\"Non-reference evaluation observations: 2,128\\\")\\n\",\"print(\\\"Evaluation conditions: 56\\\")\\n\",\"\\n\",\"print(\\\"\\\\nConsistency checks:\\\")\\n\",\"for key, value in checks.items():\\n\",\"    print(f\\\"{key}: {'PASS' if value else 'FAIL'}\\\")\\n\",\"\\n\",\"print(\\\"\\\\nResearch question checks:\\\")\\n\",\"for key, value in rq_checks.items():\\n\",\"    print(f\\\"{key}: {'PASS' if value else 'FAIL'}\\\")\\n\",\"\\n\",\"print(\\\"\\\\nCitation verification:\\\")\\n\",\"print(\\\"Bibliographic verification complete:\\\",\\n\",\"      citation_status[\\\"bibliographic_verification_complete\\\"])\\n\",\"print(\\\"Claim-level support verification complete:\\\",\\n\",\"      citation_status[\\\"claim_level_support_verification_complete\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nWord count:\\\", word_count)\\n\",\"print(\\\"Passed checks:\\\", audit[\\\"passed_checks\\\"], \\\"/\\\", audit[\\\"total_checks\\\"])\\n\",\"print(\\\"Failed checks:\\\", len(audit[\\\"failed_checks\\\"]))\\n\",\"print(\\\"Status:\\\", audit[\\\"status\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nJSON reload: PASS\\\")\\n\",\"print(\\\"Markdown reload: PASS\\\")\\n\",\"print(\\\"Audit reload: PASS\\\")\\n\",\"\\n\",\"print(\\\"\\\\nSaved files:\\\")\\n\",\"print(markdown_path)\\n\",\"print(json_path)\\n\",\"print(audit_path)\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"hFdtSC_0Axhx\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794390565713,\"user_tz\":360,\"elapsed\":218,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"f49b6a1c-f692-4d1b-f8e0-1a81d7cefe6b\"},\"execution_count\":56,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.3.7\\n\",\"INTRODUCTION CONSOLIDATION AND CONSISTENCY AUDIT\\n\",\"========================================================================================\\n\",\"\\n\",\"Sections consolidated: 5\\n\",\"1. 1.1 Background: Face Recognition and Deep Face Embeddings\\n\",\"2. 1.2 Illumination Variation and Its Effect on Facial Representations\\n\",\"3. 1.3 Research Gap and Motivation\\n\",\"4. 1.4 Research Questions and Objectives\\n\",\"5. 1.5 Study Contributions and Scope\\n\",\"\\n\",\"Dataset count clarification:\\n\",\"Total standard-illumination images: 2,414\\n\",\"Common-condition observations: 2,166\\n\",\"Common illumination conditions: 57\\n\",\"Non-reference evaluation observations: 2,128\\n\",\"Evaluation conditions: 56\\n\",\"\\n\",\"Consistency checks:\\n\",\"all_five_sections_present: PASS\\n\",\"reference_relative_terminology_present: PASS\\n\",\"euclidean_metric_present: PASS\\n\",\"cosine_metric_present: PASS\\n\",\"three_illumination_groups_present: PASS\\n\",\"38_identities_present: PASS\\n\",\"2414_total_images_present: PASS\\n\",\"2166_common_observations_present: PASS\\n\",\"2128_evaluation_observations_present: PASS\\n\",\"56_evaluation_conditions_present: PASS\\n\",\"retrospective_hypotheses_disclosed: PASS\\n\",\"exploratory_analysis_distinguished: PASS\\n\",\"different_capture_limitation_present: PASS\\n\",\"recognition_accuracy_not_claimed: PASS\\n\",\"architecture_generalisation_limitation_present: PASS\\n\",\"\\n\",\"Research question checks:\\n\",\"RQ1_present: PASS\\n\",\"RQ2_present: PASS\\n\",\"RQ3_present: PASS\\n\",\"\\n\",\"Citation verification:\\n\",\"Bibliographic verification complete: False\\n\",\"Claim-level support verification complete: False\\n\",\"\\n\",\"Word count: 1368\\n\",\"Passed checks: 18 / 18\\n\",\"Failed checks: 0\\n\",\"Status: INTRODUCTION_CONSOLIDATED_INITIAL_AUDIT_PASSED\\n\",\"\\n\",\"JSON reload: PASS\\n\",\"Markdown reload: PASS\\n\",\"Audit reload: PASS\\n\",\"\\n\",\"Saved files:\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_337/experiment20_consolidated_introduction.md\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_337/experiment20_consolidated_introduction.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_337/experiment20_step337_introduction_audit.json\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.3.8\\n\",\"## Citation Verification and Claim-to-Source Audit\\n\",\"\\n\",\"### Verified References\\n\",\"\\n\",\"1. Moses, Y., Adini, Y., and Ullman, S. (1994).\\n\",\"   \\\"Face Recognition: The Problem of Compensating for Changes in Illumination Direction.\\\"\\n\",\"   In: Computer Vision — ECCV 1994, pp. 286–296.\\n\",\"   DOI: 10.1007/3-540-57956-7_33.\\n\",\"\\n\",\"2. Beveridge, J. R., Draper, B. A., Chang, J.-M., Kirby, M., Kley, H., and Peterson, C. (2009).\\n\",\"   \\\"Principal Angles Separate Subject Illumination Spaces in YDB and CMU-PIE.\\\"\\n\",\"   IEEE Transactions on Pattern Analysis and Machine Intelligence, 31(2), 351–363.\\n\",\"   DOI: 10.1109/TPAMI.2008.200.\\n\",\"\\n\",\"3. Han, H., Shan, S., Chen, X., and Gao, W. (2013).\\n\",\"   \\\"A Comparative Study on Illumination Preprocessing in Face Recognition.\\\"\\n\",\"   Pattern Recognition, 46(6), 1691–1699.\\n\",\"   DOI: 10.1016/j.patcog.2012.11.022.\\n\",\"\\n\",\"4. Ochoa-Villegas, M. A., Nolazco-Flores, J. A., Barron-Cano, O., and Kakadiaris, I. A. (2015).\\n\",\"   \\\"Addressing the Illumination Challenge in Two-Dimensional Face Recognition: A Survey.\\\"\\n\",\"   IET Computer Vision, 9(6), 978–992.\\n\",\"   DOI: 10.1049/iet-cvi.2014.0086.\\n\",\"\\n\",\"### Claim-to-Source Assessment\\n\",\"\\n\",\"- Moses et al. (1994): supports illumination-direction effects and within-person image variation.\\n\",\"- Beveridge et al. (2009): supports subject-specific illumination subspaces and principal-angle analysis using Yale B and CMU-PIE.\\n\",\"- Han et al. (2013): supports comparative evaluation of illumination preprocessing methods.\\n\",\"- Ochoa-Villegas et al. (2015): supports the broader historical review of illumination challenges and approaches.\\n\",\"\\n\",\"### Required Editorial Corrections\\n\",\"\\n\",\"1. Do not describe Beveridge et al. as validating the exact three angular groups used in this experiment.\\n\",\"2. Do not use these four references alone to substantiate the precise angular grouping thresholds.\\n\",\"3. Retain the distinction between the 1994 ECCV conference paper by Moses et al. and the separate 1997 TPAMI publication with a similar title.\\n\",\"4. Verify any additional source used to support the specific angular grouping methodology.\\n\",\"\\n\",\"### Verification Status\\n\",\"\\n\",\"Bibliographic details: verified.\\n\",\"General claim support: verified.\\n\",\"Exact angular-grouping claim: additional source required.\\n\",\"Novelty established: no.\"],\"metadata\":{\"id\":\"NdtrZr5KC0lS\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"STEP_DIR = BASE / \\\"step_3_3\\\"\\n\",\"OUTPUT_DIR = STEP_DIR / \\\"step_338\\\"\\n\",\"OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"OUTPUT_FILE = OUTPUT_DIR / (\\n\",\"    \\\"experiment20_step338_citation_verification_audit.json\\\"\\n\",\")\\n\",\"\\n\",\"references = [\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"REF01\\\",\\n\",\"        \\\"authors\\\": [\\\"Yael Moses\\\", \\\"Yael Adini\\\", \\\"Shimon Ullman\\\"],\\n\",\"        \\\"year\\\": 1994,\\n\",\"        \\\"title\\\": \\\"Face Recognition: The Problem of Compensating for Changes in Illumination Direction\\\",\\n\",\"        \\\"publication\\\": \\\"Computer Vision — ECCV 1994\\\",\\n\",\"        \\\"pages\\\": \\\"286-296\\\",\\n\",\"        \\\"doi\\\": \\\"10.1007/3-540-57956-7_33\\\",\\n\",\"        \\\"url\\\": \\\"https://doi.org/10.1007/3-540-57956-7_33\\\",\\n\",\"        \\\"bibliographic_status\\\": \\\"VERIFIED\\\",\\n\",\"        \\\"claim_support\\\": \\\"SUPPORTED_FOR_GENERAL_ILLUMINATION_DIRECTION_EFFECTS\\\",\\n\",\"        \\\"supported_claims\\\": [\\n\",\"            \\\"Illumination direction can cause substantial within-person image variation.\\\",\\n\",\"            \\\"Illumination changes are a longstanding face-recognition challenge.\\\"\\n\",\"        ],\\n\",\"        \\\"unsupported_extensions\\\": [\\n\",\"            \\\"Does not establish the three angular groups used in Experiment 20.\\\"\\n\",\"        ]\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"REF02\\\",\\n\",\"        \\\"authors\\\": [\\n\",\"            \\\"J. Ross Beveridge\\\",\\n\",\"            \\\"Bruce A. Draper\\\",\\n\",\"            \\\"Jen-Mei Chang\\\",\\n\",\"            \\\"Michael Kirby\\\",\\n\",\"            \\\"Holger Kley\\\",\\n\",\"            \\\"Chris Peterson\\\"\\n\",\"        ],\\n\",\"        \\\"year\\\": 2009,\\n\",\"        \\\"title\\\": \\\"Principal Angles Separate Subject Illumination Spaces in YDB and CMU-PIE\\\",\\n\",\"        \\\"publication\\\": \\\"IEEE Transactions on Pattern Analysis and Machine Intelligence\\\",\\n\",\"        \\\"volume\\\": \\\"31\\\",\\n\",\"        \\\"issue\\\": \\\"2\\\",\\n\",\"        \\\"pages\\\": \\\"351-363\\\",\\n\",\"        \\\"doi\\\": \\\"10.1109/TPAMI.2008.200\\\",\\n\",\"        \\\"url\\\": \\\"https://doi.org/10.1109/TPAMI.2008.200\\\",\\n\",\"        \\\"bibliographic_status\\\": \\\"VERIFIED\\\",\\n\",\"        \\\"claim_support\\\": \\\"SUPPORTED_FOR_ILLUMINATION_SUBSPACES_AND_PRINCIPAL_ANGLES\\\",\\n\",\"        \\\"supported_claims\\\": [\\n\",\"            \\\"Subject-specific illumination subspaces have been studied.\\\",\\n\",\"            \\\"Principal angles have been used to compare illumination subspaces.\\\",\\n\",\"            \\\"Yale Face Database B and CMU-PIE were evaluated.\\\"\\n\",\"        ],\\n\",\"        \\\"unsupported_extensions\\\": [\\n\",\"            \\\"Does not directly validate the exact near-frontal, oblique, and large-angular groups used in Experiment 20.\\\"\\n\",\"        ]\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"REF03\\\",\\n\",\"        \\\"authors\\\": [\\n\",\"            \\\"Hu Han\\\",\\n\",\"            \\\"Shiguang Shan\\\",\\n\",\"            \\\"Xilin Chen\\\",\\n\",\"            \\\"Wen Gao\\\"\\n\",\"        ],\\n\",\"        \\\"year\\\": 2013,\\n\",\"        \\\"title\\\": \\\"A Comparative Study on Illumination Preprocessing in Face Recognition\\\",\\n\",\"        \\\"publication\\\": \\\"Pattern Recognition\\\",\\n\",\"        \\\"volume\\\": \\\"46\\\",\\n\",\"        \\\"issue\\\": \\\"6\\\",\\n\",\"        \\\"pages\\\": \\\"1691-1699\\\",\\n\",\"        \\\"doi\\\": \\\"10.1016/j.patcog.2012.11.022\\\",\\n\",\"        \\\"url\\\": \\\"https://doi.org/10.1016/j.patcog.2012.11.022\\\",\\n\",\"        \\\"bibliographic_status\\\": \\\"VERIFIED\\\",\\n\",\"        \\\"claim_support\\\": \\\"SUPPORTED_FOR_COMPARATIVE_ILLUMINATION_PREPROCESSING\\\",\\n\",\"        \\\"supported_claims\\\": [\\n\",\"            \\\"Multiple illumination preprocessing methods have been comparatively evaluated.\\\"\\n\",\"        ],\\n\",\"        \\\"unsupported_extensions\\\": [\\n\",\"            \\\"Does not establish the exact embedding-displacement design used in Experiment 20.\\\"\\n\",\"        ]\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"REF04\\\",\\n\",\"        \\\"authors\\\": [\\n\",\"            \\\"Miguel A. Ochoa-Villegas\\\",\\n\",\"            \\\"Juan A. Nolazco-Flores\\\",\\n\",\"            \\\"Olivia Barron-Cano\\\",\\n\",\"            \\\"Ioannis A. Kakadiaris\\\"\\n\",\"        ],\\n\",\"        \\\"year\\\": 2015,\\n\",\"        \\\"title\\\": \\\"Addressing the Illumination Challenge in Two-Dimensional Face Recognition: A Survey\\\",\\n\",\"        \\\"publication\\\": \\\"IET Computer Vision\\\",\\n\",\"        \\\"volume\\\": \\\"9\\\",\\n\",\"        \\\"issue\\\": \\\"6\\\",\\n\",\"        \\\"pages\\\": \\\"978-992\\\",\\n\",\"        \\\"doi\\\": \\\"10.1049/iet-cvi.2014.0086\\\",\\n\",\"        \\\"url\\\": \\\"https://doi.org/10.1049/iet-cvi.2014.0086\\\",\\n\",\"        \\\"bibliographic_status\\\": \\\"VERIFIED\\\",\\n\",\"        \\\"claim_support\\\": \\\"SUPPORTED_FOR_GENERAL_ILLUMINATION_RESEARCH_OVERVIEW\\\",\\n\",\"        \\\"supported_claims\\\": [\\n\",\"            \\\"Provides a survey of illumination challenges in two-dimensional face recognition.\\\",\\n\",\"            \\\"Reviews several historical approaches to illumination variation.\\\"\\n\",\"        ],\\n\",\"        \\\"unsupported_extensions\\\": [\\n\",\"            \\\"Does not independently validate the exact angular thresholds used in Experiment 20.\\\"\\n\",\"        ]\\n\",\"    }\\n\",\"]\\n\",\"\\n\",\"audit = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"phase\\\": \\\"3.3\\\",\\n\",\"    \\\"step\\\": \\\"3.3.8\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"references_reviewed\\\": len(references),\\n\",\"    \\\"references\\\": references,\\n\",\"    \\\"bibliographic_verification\\\": {\\n\",\"        \\\"status\\\": \\\"VERIFIED\\\",\\n\",\"        \\\"verified_count\\\": 4,\\n\",\"        \\\"unverified_count\\\": 0\\n\",\"    },\\n\",\"    \\\"claim_level_verification\\\": {\\n\",\"        \\\"general_illumination_context\\\": \\\"SUPPORTED\\\",\\n\",\"        \\\"subject_illumination_subspaces\\\": \\\"SUPPORTED\\\",\\n\",\"        \\\"illumination_preprocessing\\\": \\\"SUPPORTED\\\",\\n\",\"        \\\"broad_illumination_survey\\\": \\\"SUPPORTED\\\",\\n\",\"        \\\"exact_three_group_angular_design\\\": \\\"ADDITIONAL_SOURCE_REQUIRED\\\"\\n\",\"    },\\n\",\"    \\\"editorial_actions\\\": [\\n\",\"        \\\"Do not attribute the exact three angular groups to Beveridge et al. (2009).\\\",\\n\",\"        \\\"Keep the 1994 ECCV Moses paper distinct from the 1997 TPAMI paper.\\\",\\n\",\"        \\\"Add a direct source for the angular grouping methodology if making a prior-art claim about those groups.\\\",\\n\",\"        \\\"Do not claim novelty has been established.\\\"\\n\",\"    ],\\n\",\"    \\\"novelty_established\\\": False,\\n\",\"    \\\"status\\\": \\\"FOUR_REFERENCES_BIBLIOGRAPHICALLY_VERIFIED_WITH_CLAIM_LIMITATIONS\\\"\\n\",\"}\\n\",\"\\n\",\"assert len(references) == 4\\n\",\"assert all(\\n\",\"    item[\\\"bibliographic_status\\\"] == \\\"VERIFIED\\\"\\n\",\"    for item in references\\n\",\")\\n\",\"assert all(item[\\\"doi\\\"] for item in references)\\n\",\"assert audit[\\\"claim_level_verification\\\"][\\n\",\"    \\\"exact_three_group_angular_design\\\"\\n\",\"] == \\\"ADDITIONAL_SOURCE_REQUIRED\\\"\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    json.dump(audit, f, indent=2, ensure_ascii=False)\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    reloaded = json.load(f)\\n\",\"\\n\",\"assert reloaded == audit\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.3.8\\\")\\n\",\"print(\\\"CITATION VERIFICATION AND CLAIM-TO-SOURCE AUDIT\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"for item in reloaded[\\\"references\\\"]:\\n\",\"    print(f\\\"\\\\n{item['id']}: {item['year']} — {item['title']}\\\")\\n\",\"    print(\\\"Authors:\\\", \\\"; \\\".join(item[\\\"authors\\\"]))\\n\",\"    print(\\\"Publication:\\\", item[\\\"publication\\\"])\\n\",\"    print(\\\"DOI:\\\", item[\\\"doi\\\"])\\n\",\"    print(\\\"Bibliographic status:\\\", item[\\\"bibliographic_status\\\"])\\n\",\"    print(\\\"Claim support:\\\", item[\\\"claim_support\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nBibliographic verification:\\\")\\n\",\"print(reloaded[\\\"bibliographic_verification\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nClaim-level verification:\\\")\\n\",\"for key, value in reloaded[\\\"claim_level_verification\\\"].items():\\n\",\"    print(f\\\"{key}: {value}\\\")\\n\",\"\\n\",\"print(\\\"\\\\nNovelty established:\\\", reloaded[\\\"novelty_established\\\"])\\n\",\"print(\\\"Status:\\\", reloaded[\\\"status\\\"])\\n\",\"print(\\\"JSON reload: PASS\\\")\\n\",\"print(\\\"Saved:\\\", OUTPUT_FILE)\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"ZZrfrXBSC1aG\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794391117327,\"user_tz\":360,\"elapsed\":83,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"6d72d9c9-f7d8-4ff8-cbcb-11009a5e819b\"},\"execution_count\":57,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.3.8\\n\",\"CITATION VERIFICATION AND CLAIM-TO-SOURCE AUDIT\\n\",\"========================================================================================\\n\",\"\\n\",\"REF01: 1994 — Face Recognition: The Problem of Compensating for Changes in Illumination Direction\\n\",\"Authors: Yael Moses; Yael Adini; Shimon Ullman\\n\",\"Publication: Computer Vision — ECCV 1994\\n\",\"DOI: 10.1007/3-540-57956-7_33\\n\",\"Bibliographic status: VERIFIED\\n\",\"Claim support: SUPPORTED_FOR_GENERAL_ILLUMINATION_DIRECTION_EFFECTS\\n\",\"\\n\",\"REF02: 2009 — Principal Angles Separate Subject Illumination Spaces in YDB and CMU-PIE\\n\",\"Authors: J. Ross Beveridge; Bruce A. Draper; Jen-Mei Chang; Michael Kirby; Holger Kley; Chris Peterson\\n\",\"Publication: IEEE Transactions on Pattern Analysis and Machine Intelligence\\n\",\"DOI: 10.1109/TPAMI.2008.200\\n\",\"Bibliographic status: VERIFIED\\n\",\"Claim support: SUPPORTED_FOR_ILLUMINATION_SUBSPACES_AND_PRINCIPAL_ANGLES\\n\",\"\\n\",\"REF03: 2013 — A Comparative Study on Illumination Preprocessing in Face Recognition\\n\",\"Authors: Hu Han; Shiguang Shan; Xilin Chen; Wen Gao\\n\",\"Publication: Pattern Recognition\\n\",\"DOI: 10.1016/j.patcog.2012.11.022\\n\",\"Bibliographic status: VERIFIED\\n\",\"Claim support: SUPPORTED_FOR_COMPARATIVE_ILLUMINATION_PREPROCESSING\\n\",\"\\n\",\"REF04: 2015 — Addressing the Illumination Challenge in Two-Dimensional Face Recognition: A Survey\\n\",\"Authors: Miguel A. Ochoa-Villegas; Juan A. Nolazco-Flores; Olivia Barron-Cano; Ioannis A. Kakadiaris\\n\",\"Publication: IET Computer Vision\\n\",\"DOI: 10.1049/iet-cvi.2014.0086\\n\",\"Bibliographic status: VERIFIED\\n\",\"Claim support: SUPPORTED_FOR_GENERAL_ILLUMINATION_RESEARCH_OVERVIEW\\n\",\"\\n\",\"Bibliographic verification:\\n\",\"{'status': 'VERIFIED', 'verified_count': 4, 'unverified_count': 0}\\n\",\"\\n\",\"Claim-level verification:\\n\",\"general_illumination_context: SUPPORTED\\n\",\"subject_illumination_subspaces: SUPPORTED\\n\",\"illumination_preprocessing: SUPPORTED\\n\",\"broad_illumination_survey: SUPPORTED\\n\",\"exact_three_group_angular_design: ADDITIONAL_SOURCE_REQUIRED\\n\",\"\\n\",\"Novelty established: False\\n\",\"Status: FOUR_REFERENCES_BIBLIOGRAPHICALLY_VERIFIED_WITH_CLAIM_LIMITATIONS\\n\",\"JSON reload: PASS\\n\",\"Saved: /content/drive/MyDrive/Experiment_20_Results/step_3_3/step_338/experiment20_step338_citation_verification_audit.json\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.3.8.1\\n\",\"## Verification of Angular Illumination Grouping in Prior Research\\n\",\"\\n\",\"### Source\\n\",\"\\n\",\"Ochoa-Villegas, M. A., Nolazco-Flores, J. A., Barron-Cano, O., and Kakadiaris, I. A. (2015).\\n\",\"\\n\",\"\\\"Addressing the Illumination Challenge in Two-Dimensional Face Recognition: A Survey.\\\"\\n\",\"\\n\",\"IET Computer Vision, 9(6), 978–992.\\n\",\"\\n\",\"DOI: 10.1049/iet-cvi.2014.0086\\n\",\"\\n\",\"### Verified literature finding\\n\",\"\\n\",\"The survey describes Yale Face Database B experiments that divide illumination conditions into five subsets according to the angle between the light-source direction and camera axis:\\n\",\"\\n\",\"- S1: 0°–12°\\n\",\"- S2: 13°–25°\\n\",\"- S3: 26°–50°\\n\",\"- S4: 51°–77°\\n\",\"- S5: greater than 78°\\n\",\"\\n\",\"### Relationship to Experiment 20\\n\",\"\\n\",\"This source establishes precedent for analysing Yale B illumination conditions using angular groupings.\\n\",\"\\n\",\"Experiment 20 uses three different groups:\\n\",\"\\n\",\"- Near-frontal: theta ≤ 30°.\\n\",\"- Oblique: 30° < theta ≤ 60°.\\n\",\"- Large angular deviation: theta > 60°.\\n\",\"\\n\",\"These thresholds are not identical to the five subsets described in the survey.\\n\",\"\\n\",\"The survey supports the general use of angular illumination grouping, but does not independently validate the exact three-group thresholds or the angular formula used in Experiment 20.\\n\",\"\\n\",\"### Decision\\n\",\"\\n\",\"The general angular-grouping precedent is supported by prior literature.\\n\",\"\\n\",\"The exact three-group classification remains a study-specific analytical design.\\n\",\"\\n\",\"Novelty is not established.\"],\"metadata\":{\"id\":\"zATe5hPWDq9L\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"STEP_DIR = BASE / \\\"step_3_3\\\"\\n\",\"OUTPUT_DIR = STEP_DIR / \\\"step_338\\\"\\n\",\"OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"OUTPUT_FILE = OUTPUT_DIR / (\\n\",\"    \\\"experiment20_step3381_angular_grouping_literature_audit.json\\\"\\n\",\")\\n\",\"\\n\",\"source = {\\n\",\"    \\\"authors\\\": [\\n\",\"        \\\"Miguel A. Ochoa-Villegas\\\",\\n\",\"        \\\"Juan A. Nolazco-Flores\\\",\\n\",\"        \\\"Olivia Barron-Cano\\\",\\n\",\"        \\\"Ioannis A. Kakadiaris\\\"\\n\",\"    ],\\n\",\"    \\\"year\\\": 2015,\\n\",\"    \\\"title\\\": (\\n\",\"        \\\"Addressing the Illumination Challenge in Two-Dimensional \\\"\\n\",\"        \\\"Face Recognition: A Survey\\\"\\n\",\"    ),\\n\",\"    \\\"publication\\\": \\\"IET Computer Vision\\\",\\n\",\"    \\\"volume\\\": 9,\\n\",\"    \\\"issue\\\": 6,\\n\",\"    \\\"pages\\\": \\\"978-992\\\",\\n\",\"    \\\"doi\\\": \\\"10.1049/iet-cvi.2014.0086\\\",\\n\",\"    \\\"url\\\": \\\"https://doi.org/10.1049/iet-cvi.2014.0086\\\",\\n\",\"    \\\"source_type\\\": \\\"Peer-reviewed survey\\\",\\n\",\"    \\\"finding\\\": (\\n\",\"        \\\"Yale Face Database B illumination conditions are described \\\"\\n\",\"        \\\"as divided into five subsets according to the angle between \\\"\\n\",\"        \\\"the light-source direction and camera axis.\\\"\\n\",\"    ),\\n\",\"    \\\"reported_angular_subsets\\\": [\\n\",\"        {\\\"subset\\\": \\\"S1\\\", \\\"lower_degrees\\\": 0, \\\"upper_degrees\\\": 12},\\n\",\"        {\\\"subset\\\": \\\"S2\\\", \\\"lower_degrees\\\": 13, \\\"upper_degrees\\\": 25},\\n\",\"        {\\\"subset\\\": \\\"S3\\\", \\\"lower_degrees\\\": 26, \\\"upper_degrees\\\": 50},\\n\",\"        {\\\"subset\\\": \\\"S4\\\", \\\"lower_degrees\\\": 51, \\\"upper_degrees\\\": 77},\\n\",\"        {\\\"subset\\\": \\\"S5\\\", \\\"lower_degrees\\\": 78, \\\"upper_degrees\\\": None}\\n\",\"    ],\\n\",\"    \\\"claim_supported\\\": (\\n\",\"        \\\"Prior Yale B research has used angular illumination subsets.\\\"\\n\",\"    ),\\n\",\"    \\\"claim_not_supported\\\": (\\n\",\"        \\\"The source does not validate the exact three angular groups \\\"\\n\",\"        \\\"or angular calculation used in Experiment 20.\\\"\\n\",\"    ),\\n\",\"    \\\"verification_status\\\": \\\"SOURCE_CONTENT_CHECKED\\\"\\n\",\"}\\n\",\"\\n\",\"experiment20_groups = [\\n\",\"    {\\n\",\"        \\\"group\\\": \\\"near_frontal\\\",\\n\",\"        \\\"definition\\\": \\\"theta <= 30 degrees\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"group\\\": \\\"oblique\\\",\\n\",\"        \\\"definition\\\": \\\"30 degrees < theta <= 60 degrees\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"group\\\": \\\"large_angular\\\",\\n\",\"        \\\"definition\\\": \\\"theta > 60 degrees\\\"\\n\",\"    }\\n\",\"]\\n\",\"\\n\",\"decision = {\\n\",\"    \\\"general_angular_grouping_precedent\\\": \\\"SUPPORTED\\\",\\n\",\"    \\\"exact_three_group_thresholds\\\": \\\"STUDY_SPECIFIC\\\",\\n\",\"    \\\"exact_angular_formula\\\": \\\"STUDY_SPECIFIC\\\",\\n\",\"    \\\"prior_research_validates_exact_experiment20_groups\\\": False,\\n\",\"    \\\"novelty_established\\\": False\\n\",\"}\\n\",\"\\n\",\"record = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"phase\\\": \\\"3.3\\\",\\n\",\"    \\\"step\\\": \\\"3.3.8.1\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"source\\\": source,\\n\",\"    \\\"experiment20_angular_groups\\\": experiment20_groups,\\n\",\"    \\\"decision\\\": decision,\\n\",\"    \\\"editorial_action\\\": (\\n\",\"        \\\"Use Ochoa-Villegas et al. (2015) to support the precedent \\\"\\n\",\"        \\\"for angular illumination grouping, while explicitly \\\"\\n\",\"        \\\"identifying the three Experiment 20 groups as its own \\\"\\n\",\"        \\\"analytical classification.\\\"\\n\",\"    ),\\n\",\"    \\\"status\\\": \\\"ANGULAR_GROUPING_PRECEDENT_VERIFIED_WITH_SCOPE_LIMITATION\\\"\\n\",\"}\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    json.dump(record, f, indent=2, ensure_ascii=False)\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    reloaded = json.load(f)\\n\",\"\\n\",\"assert reloaded == record\\n\",\"assert reloaded[\\\"decision\\\"][\\\"general_angular_grouping_precedent\\\"] == \\\"SUPPORTED\\\"\\n\",\"assert reloaded[\\\"decision\\\"][\\\"exact_three_group_thresholds\\\"] == \\\"STUDY_SPECIFIC\\\"\\n\",\"assert reloaded[\\\"decision\\\"][\\\"novelty_established\\\"] is False\\n\",\"assert len(reloaded[\\\"source\\\"][\\\"reported_angular_subsets\\\"]) == 5\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.3.8.1\\\")\\n\",\"print(\\\"ANGULAR ILLUMINATION GROUPING LITERATURE AUDIT\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"print(\\\"\\\\nSource:\\\", source[\\\"title\\\"])\\n\",\"print(\\\"Year:\\\", source[\\\"year\\\"])\\n\",\"print(\\\"DOI:\\\", source[\\\"doi\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nPreviously reported Yale B angular subsets:\\\")\\n\",\"for item in reloaded[\\\"source\\\"][\\\"reported_angular_subsets\\\"]:\\n\",\"    upper = (\\n\",\"        f\\\"{item['upper_degrees']} degrees\\\"\\n\",\"        if item[\\\"upper_degrees\\\"] is not None\\n\",\"        else \\\"above\\\"\\n\",\"    )\\n\",\"    print(\\n\",\"        f\\\"{item['subset']}: {item['lower_degrees']} degrees \\\"\\n\",\"        f\\\"to {upper}\\\"\\n\",\"    )\\n\",\"\\n\",\"print(\\\"\\\\nExperiment 20 groups:\\\")\\n\",\"for item in reloaded[\\\"experiment20_angular_groups\\\"]:\\n\",\"    print(f\\\"{item['group']}: {item['definition']}\\\")\\n\",\"\\n\",\"print(\\\"\\\\nDecisions:\\\")\\n\",\"for key, value in reloaded[\\\"decision\\\"].items():\\n\",\"    print(f\\\"{key}: {value}\\\")\\n\",\"\\n\",\"print(\\\"\\\\nJSON reload: PASS\\\")\\n\",\"print(\\\"Saved:\\\", OUTPUT_FILE)\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"D6acAUCjDttW\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794391344250,\"user_tz\":360,\"elapsed\":146,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"ed097774-4e4b-4a56-d170-1ef69422be2d\"},\"execution_count\":58,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.3.8.1\\n\",\"ANGULAR ILLUMINATION GROUPING LITERATURE AUDIT\\n\",\"========================================================================================\\n\",\"\\n\",\"Source: Addressing the Illumination Challenge in Two-Dimensional Face Recognition: A Survey\\n\",\"Year: 2015\\n\",\"DOI: 10.1049/iet-cvi.2014.0086\\n\",\"\\n\",\"Previously reported Yale B angular subsets:\\n\",\"S1: 0 degrees to 12 degrees\\n\",\"S2: 13 degrees to 25 degrees\\n\",\"S3: 26 degrees to 50 degrees\\n\",\"S4: 51 degrees to 77 degrees\\n\",\"S5: 78 degrees to above\\n\",\"\\n\",\"Experiment 20 groups:\\n\",\"near_frontal: theta <= 30 degrees\\n\",\"oblique: 30 degrees < theta <= 60 degrees\\n\",\"large_angular: theta > 60 degrees\\n\",\"\\n\",\"Decisions:\\n\",\"general_angular_grouping_precedent: SUPPORTED\\n\",\"exact_three_group_thresholds: STUDY_SPECIFIC\\n\",\"exact_angular_formula: STUDY_SPECIFIC\\n\",\"prior_research_validates_exact_experiment20_groups: False\\n\",\"novelty_established: False\\n\",\"\\n\",\"JSON reload: PASS\\n\",\"Saved: /content/drive/MyDrive/Experiment_20_Results/step_3_3/step_338/experiment20_step3381_angular_grouping_literature_audit.json\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.3.8.2\\n\",\"## Consolidated Introduction: Citation Integration\\n\",\"\\n\",\"### Required revision\\n\",\"\\n\",\"Update Section 1.2 to include the established precedent for angular illumination grouping in Yale B research.\\n\",\"\\n\",\"### Citation integration\\n\",\"\\n\",\"Ochoa-Villegas et al. (2015) describe Yale Face Database B illumination subsets classified according to the angle between the light-source direction and camera axis.\\n\",\"\\n\",\"The reported five subsets are:\\n\",\"\\n\",\"- 0°–12°\\n\",\"- 13°–25°\\n\",\"- 26°–50°\\n\",\"- 51°–77°\\n\",\"- Above 77°\\n\",\"\\n\",\"Experiment 20 uses a different three-group classification:\\n\",\"\\n\",\"- Near-frontal: θ ≤ 30°.\\n\",\"- Oblique: 30° < θ ≤ 60°.\\n\",\"- Large angular deviation: θ > 60°.\\n\",\"\\n\",\"### Editorial requirement\\n\",\"\\n\",\"Present the published five-subset classification as prior research and the three-group classification as the analytical design adopted in Experiment 20.\\n\",\"\\n\",\"Do not imply that the published study validates the exact thresholds used in this experiment.\\n\",\"\\n\",\"### Deliverables\\n\",\"\\n\",\"1. Updated consolidated introduction.\\n\",\"2. Updated citation inventory.\\n\",\"3. Citation integration audit.\\n\",\"4. JSON and Markdown reload verification.\"],\"metadata\":{\"id\":\"F6mZBpKGEXD9\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"STEP_DIR = BASE / \\\"step_3_3\\\"\\n\",\"SOURCE_DIR = STEP_DIR / \\\"step_337\\\"\\n\",\"AUDIT_DIR = STEP_DIR / \\\"step_338\\\"\\n\",\"OUTPUT_DIR = STEP_DIR / \\\"step_3382\\\"\\n\",\"\\n\",\"OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"INTRO_FILE = SOURCE_DIR / \\\"experiment20_consolidated_introduction.md\\\"\\n\",\"JSON_FILE = SOURCE_DIR / \\\"experiment20_consolidated_introduction.json\\\"\\n\",\"ANGULAR_AUDIT_FILE = AUDIT_DIR / (\\n\",\"    \\\"experiment20_step3381_angular_grouping_literature_audit.json\\\"\\n\",\")\\n\",\"\\n\",\"for path in [INTRO_FILE, JSON_FILE, ANGULAR_AUDIT_FILE]:\\n\",\"    if not path.exists():\\n\",\"        raise FileNotFoundError(f\\\"Required file missing: {path}\\\")\\n\",\"\\n\",\"with open(INTRO_FILE, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    original_markdown = f.read()\\n\",\"\\n\",\"with open(JSON_FILE, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    original_json = json.load(f)\\n\",\"\\n\",\"with open(ANGULAR_AUDIT_FILE, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    angular_audit = json.load(f)\\n\",\"\\n\",\"# Exact sentence from the existing introduction.\\n\",\"old_sentence = (\\n\",\"    \\\"Research using Yale B datasets has also considered illumination \\\"\\n\",\"    \\\"conditions according to the angular position of light sources, \\\"\\n\",\"    \\\"demonstrating the relevance of illumination geometry in controlled \\\"\\n\",\"    \\\"face-image analysis.\\\"\\n\",\")\\n\",\"\\n\",\"new_sentence = (\\n\",\"    \\\"Research using Yale Face Database B has also classified illumination \\\"\\n\",\"    \\\"conditions according to the angle between the light-source direction \\\"\\n\",\"    \\\"and camera axis. Ochoa-Villegas et al. (2015) describe five angular \\\"\\n\",\"    \\\"subsets: 0°–12°, 13°–25°, 26°–50°, 51°–77°, and above 77°. \\\"\\n\",\"    \\\"This provides precedent for angular grouping in illumination studies. \\\"\\n\",\"    \\\"The present study adopts a different three-group classification, \\\"\\n\",\"    \\\"with near-frontal conditions defined as θ ≤ 30°, oblique conditions \\\"\\n\",\"    \\\"as 30° < θ ≤ 60°, and large-angular-deviation conditions as θ > 60°. \\\"\\n\",\"    \\\"These thresholds represent the analytical grouping adopted in \\\"\\n\",\"    \\\"Experiment 20 and are not the same as the five subsets reported \\\"\\n\",\"    \\\"in the survey.\\\"\\n\",\")\\n\",\"\\n\",\"if original_markdown.count(old_sentence) != 1:\\n\",\"    raise ValueError(\\n\",\"        \\\"Expected sentence was not found exactly once. \\\"\\n\",\"        \\\"No changes have been made.\\\"\\n\",\"    )\\n\",\"\\n\",\"updated_markdown = original_markdown.replace(\\n\",\"    old_sentence, new_sentence, 1\\n\",\")\\n\",\"\\n\",\"# Ensure the added source is included in the citation inventory.\\n\",\"citation = \\\"Ochoa-Villegas et al. (2015)\\\"\\n\",\"\\n\",\"checks = {\\n\",\"    \\\"original_sentence_replaced\\\": old_sentence not in updated_markdown,\\n\",\"    \\\"new_five_subset_description_present\\\": all(\\n\",\"        term in updated_markdown\\n\",\"        for term in [\\\"0°–12°\\\", \\\"13°–25°\\\", \\\"26°–50°\\\", \\\"51°–77°\\\", \\\"above 77°\\\"]\\n\",\"    ),\\n\",\"    \\\"three_group_thresholds_present\\\": all(\\n\",\"        term in updated_markdown\\n\",\"        for term in [\\\"θ ≤ 30°\\\", \\\"30° < θ ≤ 60°\\\", \\\"θ > 60°\\\"]\\n\",\"    ),\\n\",\"    \\\"study_specific_thresholds_explained\\\": (\\n\",\"        \\\"analytical grouping adopted in Experiment 20\\\" in updated_markdown\\n\",\"    ),\\n\",\"    \\\"prior_source_not_claimed_to_validate_exact_thresholds\\\": (\\n\",\"        \\\"are not the same as the five subsets\\\" in updated_markdown\\n\",\"    ),\\n\",\"    \\\"citation_present\\\": citation in updated_markdown\\n\",\"}\\n\",\"\\n\",\"if not all(checks.values()):\\n\",\"    raise AssertionError(\\\"Citation integration checks failed.\\\")\\n\",\"\\n\",\"# Update the consolidated JSON record.\\n\",\"updated_json = dict(original_json)\\n\",\"updated_json[\\\"introduction_markdown\\\"] = updated_markdown\\n\",\"updated_json[\\\"word_count\\\"] = len(updated_markdown.split())\\n\",\"updated_json[\\\"citation_inventory\\\"] = list(\\n\",\"    dict.fromkeys(\\n\",\"        original_json.get(\\\"citation_inventory\\\", []) + [\\n\",\"            \\\"Moses, Adini, and Ullman (1994)\\\",\\n\",\"            \\\"Beveridge et al. (2009)\\\",\\n\",\"            \\\"Han et al. (2013)\\\",\\n\",\"            \\\"Ochoa-Villegas et al. (2015)\\\"\\n\",\"        ]\\n\",\"    )\\n\",\")\\n\",\"updated_json[\\\"last_updated_step\\\"] = \\\"3.3.8.2\\\"\\n\",\"\\n\",\"# Save revised outputs separately to preserve the original files.\\n\",\"markdown_output = OUTPUT_DIR / \\\"experiment20_consolidated_introduction_v2.md\\\"\\n\",\"json_output = OUTPUT_DIR / \\\"experiment20_consolidated_introduction_v2.json\\\"\\n\",\"audit_output = OUTPUT_DIR / \\\"experiment20_step3382_citation_integration_audit.json\\\"\\n\",\"\\n\",\"with open(markdown_output, \\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    f.write(updated_markdown)\\n\",\"\\n\",\"with open(json_output, \\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    json.dump(updated_json, f, indent=2, ensure_ascii=False)\\n\",\"\\n\",\"audit = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"phase\\\": \\\"3.3\\\",\\n\",\"    \\\"step\\\": \\\"3.3.8.2\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"source_angular_audit\\\": str(ANGULAR_AUDIT_FILE),\\n\",\"    \\\"checks\\\": checks,\\n\",\"    \\\"passed_checks\\\": sum(checks.values()),\\n\",\"    \\\"total_checks\\\": len(checks),\\n\",\"    \\\"failed_checks\\\": [\\n\",\"        key for key, value in checks.items() if not value\\n\",\"    ],\\n\",\"    \\\"word_count\\\": len(updated_markdown.split()),\\n\",\"    \\\"citation_added\\\": citation,\\n\",\"    \\\"novelty_established\\\": False,\\n\",\"    \\\"status\\\": (\\n\",\"        \\\"CITATION_INTEGRATION_PASSED\\\"\\n\",\"        if all(checks.values())\\n\",\"        else \\\"CITATION_INTEGRATION_REQUIRES_REVIEW\\\"\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"with open(audit_output, \\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    json.dump(audit, f, indent=2, ensure_ascii=False)\\n\",\"\\n\",\"# Reload verification.\\n\",\"with open(markdown_output, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    markdown_reload = f.read()\\n\",\"\\n\",\"with open(json_output, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    json_reload = json.load(f)\\n\",\"\\n\",\"with open(audit_output, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    audit_reload = json.load(f)\\n\",\"\\n\",\"assert markdown_reload == updated_markdown\\n\",\"assert json_reload[\\\"introduction_markdown\\\"] == updated_markdown\\n\",\"assert audit_reload == audit\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.3.8.2\\\")\\n\",\"print(\\\"CITATION INTEGRATION INTO CONSOLIDATED INTRODUCTION\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"print(\\\"\\\\nIntegration checks:\\\")\\n\",\"for key, value in checks.items():\\n\",\"    print(f\\\"{key}: {'PASS' if value else 'FAIL'}\\\")\\n\",\"\\n\",\"print(\\\"\\\\nUpdated word count:\\\", audit[\\\"word_count\\\"])\\n\",\"print(\\\"Citation added:\\\", citation)\\n\",\"print(\\\"Passed checks:\\\", audit[\\\"passed_checks\\\"], \\\"/\\\", audit[\\\"total_checks\\\"])\\n\",\"print(\\\"Failed checks:\\\", len(audit[\\\"failed_checks\\\"]))\\n\",\"print(\\\"Novelty established:\\\", audit[\\\"novelty_established\\\"])\\n\",\"print(\\\"Status:\\\", audit[\\\"status\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nMarkdown reload: PASS\\\")\\n\",\"print(\\\"JSON reload: PASS\\\")\\n\",\"print(\\\"Audit reload: PASS\\\")\\n\",\"\\n\",\"print(\\\"\\\\nSaved files:\\\")\\n\",\"print(markdown_output)\\n\",\"print(json_output)\\n\",\"print(audit_output)\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"8pcRxonzEZNK\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794391520518,\"user_tz\":360,\"elapsed\":156,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"a3b35180-bd94-4cac-c36b-2ddf8341f72e\"},\"execution_count\":59,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.3.8.2\\n\",\"CITATION INTEGRATION INTO CONSOLIDATED INTRODUCTION\\n\",\"========================================================================================\\n\",\"\\n\",\"Integration checks:\\n\",\"original_sentence_replaced: PASS\\n\",\"new_five_subset_description_present: PASS\\n\",\"three_group_thresholds_present: PASS\\n\",\"study_specific_thresholds_explained: PASS\\n\",\"prior_source_not_claimed_to_validate_exact_thresholds: PASS\\n\",\"citation_present: PASS\\n\",\"\\n\",\"Updated word count: 1440\\n\",\"Citation added: Ochoa-Villegas et al. (2015)\\n\",\"Passed checks: 6 / 6\\n\",\"Failed checks: 0\\n\",\"Novelty established: False\\n\",\"Status: CITATION_INTEGRATION_PASSED\\n\",\"\\n\",\"Markdown reload: PASS\\n\",\"JSON reload: PASS\\n\",\"Audit reload: PASS\\n\",\"\\n\",\"Saved files:\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3382/experiment20_consolidated_introduction_v2.md\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3382/experiment20_consolidated_introduction_v2.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3382/experiment20_step3382_citation_integration_audit.json\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.3.8.3\\n\",\"## References\\n\",\"\\n\",\"Beveridge, J. R., Draper, B. A., Chang, J.-M., Kirby, M., Kley, H., & Peterson, C. (2009). Principal angles separate subject illumination spaces in YDB and CMU-PIE. *IEEE Transactions on Pattern Analysis and Machine Intelligence, 31*(2), 351–363. https://doi.org/10.1109/TPAMI.2008.200\\n\",\"\\n\",\"Han, H., Shan, S., Chen, X., & Gao, W. (2013). A comparative study on illumination preprocessing in face recognition. *Pattern Recognition, 46*(6), 1691–1699. https://doi.org/10.1016/j.patcog.2012.11.022\\n\",\"\\n\",\"Moses, Y., Adini, Y., & Ullman, S. (1994). Face recognition: The problem of compensating for changes in illumination direction. In J.-O. Eklundh (Ed.), *Computer vision—ECCV 1994* (Vol. 800, pp. 286–296). Springer. https://doi.org/10.1007/3-540-57956-7_33\\n\",\"\\n\",\"Ochoa-Villegas, M. A., Nolazco-Flores, J. A., Barron-Cano, O., & Kakadiaris, I. A. (2015). Addressing the illumination challenge in two-dimensional face recognition: A survey. *IET Computer Vision, 9*(6), 978–992. https://doi.org/10.1049/iet-cvi.2014.0086\\n\",\"\\n\",\"### In-text citation convention\\n\",\"\\n\",\"- Parenthetical: (Moses et al., 1994)\\n\",\"- Narrative: Moses et al. (1994)\\n\",\"- Parenthetical: (Beveridge et al., 2009)\\n\",\"- Narrative: Beveridge et al. (2009)\\n\",\"- Parenthetical: (Han et al., 2013)\\n\",\"- Narrative: Han et al. (2013)\\n\",\"- Parenthetical: (Ochoa-Villegas et al., 2015)\\n\",\"- Narrative: Ochoa-Villegas et al. (2015)\\n\",\"\\n\",\"### Reference-list checks\\n\",\"\\n\",\"- Alphabetical ordering by first author's surname.\\n\",\"- Four unique references.\\n\",\"- Every reference has a DOI.\\n\",\"- No duplicate entry for Ochoa-Villegas et al. (2015).\\n\",\"- Moses et al. (1994) identified as a conference-proceedings chapter, not a journal article.\\n\",\"- APA 7 author–date convention applied.\"],\"metadata\":{\"id\":\"YkCRzs33HpBP\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"STEP_DIR = BASE / \\\"step_3_3\\\"\\n\",\"OUTPUT_DIR = STEP_DIR / \\\"step_3383\\\"\\n\",\"OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"references = [\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"REF02\\\",\\n\",\"        \\\"first_author\\\": \\\"Beveridge\\\",\\n\",\"        \\\"year\\\": 2009,\\n\",\"        \\\"authors\\\": [\\n\",\"            \\\"Beveridge, J. R.\\\",\\n\",\"            \\\"Draper, B. A.\\\",\\n\",\"            \\\"Chang, J.-M.\\\",\\n\",\"            \\\"Kirby, M.\\\",\\n\",\"            \\\"Kley, H.\\\",\\n\",\"            \\\"Peterson, C.\\\"\\n\",\"        ],\\n\",\"        \\\"title\\\": \\\"Principal angles separate subject illumination spaces in YDB and CMU-PIE\\\",\\n\",\"        \\\"publication_type\\\": \\\"Journal article\\\",\\n\",\"        \\\"journal\\\": \\\"IEEE Transactions on Pattern Analysis and Machine Intelligence\\\",\\n\",\"        \\\"volume\\\": \\\"31\\\",\\n\",\"        \\\"issue\\\": \\\"2\\\",\\n\",\"        \\\"pages\\\": \\\"351–363\\\",\\n\",\"        \\\"doi\\\": \\\"10.1109/TPAMI.2008.200\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"REF03\\\",\\n\",\"        \\\"first_author\\\": \\\"Han\\\",\\n\",\"        \\\"year\\\": 2013,\\n\",\"        \\\"authors\\\": [\\n\",\"            \\\"Han, H.\\\",\\n\",\"            \\\"Shan, S.\\\",\\n\",\"            \\\"Chen, X.\\\",\\n\",\"            \\\"Gao, W.\\\"\\n\",\"        ],\\n\",\"        \\\"title\\\": \\\"A comparative study on illumination preprocessing in face recognition\\\",\\n\",\"        \\\"publication_type\\\": \\\"Journal article\\\",\\n\",\"        \\\"journal\\\": \\\"Pattern Recognition\\\",\\n\",\"        \\\"volume\\\": \\\"46\\\",\\n\",\"        \\\"issue\\\": \\\"6\\\",\\n\",\"        \\\"pages\\\": \\\"1691–1699\\\",\\n\",\"        \\\"doi\\\": \\\"10.1016/j.patcog.2012.11.022\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"REF01\\\",\\n\",\"        \\\"first_author\\\": \\\"Moses\\\",\\n\",\"        \\\"year\\\": 1994,\\n\",\"        \\\"authors\\\": [\\n\",\"            \\\"Moses, Y.\\\",\\n\",\"            \\\"Adini, Y.\\\",\\n\",\"            \\\"Ullman, S.\\\"\\n\",\"        ],\\n\",\"        \\\"title\\\": \\\"Face recognition: The problem of compensating for changes in illumination direction\\\",\\n\",\"        \\\"publication_type\\\": \\\"Conference proceedings chapter\\\",\\n\",\"        \\\"editor\\\": \\\"J.-O. Eklundh\\\",\\n\",\"        \\\"book_title\\\": \\\"Computer vision—ECCV 1994\\\",\\n\",\"        \\\"volume\\\": \\\"800\\\",\\n\",\"        \\\"pages\\\": \\\"286–296\\\",\\n\",\"        \\\"publisher\\\": \\\"Springer\\\",\\n\",\"        \\\"doi\\\": \\\"10.1007/3-540-57956-7_33\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"REF04\\\",\\n\",\"        \\\"first_author\\\": \\\"Ochoa-Villegas\\\",\\n\",\"        \\\"year\\\": 2015,\\n\",\"        \\\"authors\\\": [\\n\",\"            \\\"Ochoa-Villegas, M. A.\\\",\\n\",\"            \\\"Nolazco-Flores, J. A.\\\",\\n\",\"            \\\"Barron-Cano, O.\\\",\\n\",\"            \\\"Kakadiaris, I. A.\\\"\\n\",\"        ],\\n\",\"        \\\"title\\\": \\\"Addressing the illumination challenge in two-dimensional face recognition: A survey\\\",\\n\",\"        \\\"publication_type\\\": \\\"Journal article\\\",\\n\",\"        \\\"journal\\\": \\\"IET Computer Vision\\\",\\n\",\"        \\\"volume\\\": \\\"9\\\",\\n\",\"        \\\"issue\\\": \\\"6\\\",\\n\",\"        \\\"pages\\\": \\\"978–992\\\",\\n\",\"        \\\"doi\\\": \\\"10.1049/iet-cvi.2014.0086\\\"\\n\",\"    }\\n\",\"]\\n\",\"\\n\",\"def format_reference(ref):\\n\",\"    author_text = \\\", \\\".join(ref[\\\"authors\\\"][:-1])\\n\",\"    if author_text:\\n\",\"        author_text += \\\", \\\"\\n\",\"    author_text += \\\"& \\\" + ref[\\\"authors\\\"][-1]\\n\",\"\\n\",\"    doi_url = \\\"https://doi.org/\\\" + ref[\\\"doi\\\"]\\n\",\"\\n\",\"    if ref[\\\"publication_type\\\"] == \\\"Conference proceedings chapter\\\":\\n\",\"        return (\\n\",\"            f\\\"{author_text} ({ref['year']}). {ref['title']}. \\\"\\n\",\"            f\\\"In {ref['editor']} (Ed.), *{ref['book_title']}* \\\"\\n\",\"            f\\\"(Vol. {ref['volume']}, pp. {ref['pages']}). \\\"\\n\",\"            f\\\"{ref['publisher']}. {doi_url}\\\"\\n\",\"        )\\n\",\"\\n\",\"    return (\\n\",\"        f\\\"{author_text} ({ref['year']}). {ref['title']}. \\\"\\n\",\"        f\\\"*{ref['journal']}, {ref['volume']}*\\\"\\n\",\"        f\\\"({ref['issue']}), {ref['pages']}. {doi_url}\\\"\\n\",\"    )\\n\",\"\\n\",\"references.sort(key=lambda x: x[\\\"first_author\\\"].lower())\\n\",\"\\n\",\"reference_markdown = \\\"# References\\\\n\\\\n\\\" + \\\"\\\\n\\\\n\\\".join(\\n\",\"    format_reference(ref) for ref in references\\n\",\") + \\\"\\\\n\\\"\\n\",\"\\n\",\"in_text_citations = [\\n\",\"    {\\n\",\"        \\\"reference_id\\\": \\\"REF01\\\",\\n\",\"        \\\"parenthetical\\\": \\\"(Moses et al., 1994)\\\",\\n\",\"        \\\"narrative\\\": \\\"Moses et al. (1994)\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"reference_id\\\": \\\"REF02\\\",\\n\",\"        \\\"parenthetical\\\": \\\"(Beveridge et al., 2009)\\\",\\n\",\"        \\\"narrative\\\": \\\"Beveridge et al. (2009)\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"reference_id\\\": \\\"REF03\\\",\\n\",\"        \\\"parenthetical\\\": \\\"(Han et al., 2013)\\\",\\n\",\"        \\\"narrative\\\": \\\"Han et al. (2013)\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"reference_id\\\": \\\"REF04\\\",\\n\",\"        \\\"parenthetical\\\": \\\"(Ochoa-Villegas et al., 2015)\\\",\\n\",\"        \\\"narrative\\\": \\\"Ochoa-Villegas et al. (2015)\\\"\\n\",\"    }\\n\",\"]\\n\",\"\\n\",\"checks = {\\n\",\"    \\\"four_references_present\\\": len(references) == 4,\\n\",\"    \\\"unique_dois\\\": len({r[\\\"doi\\\"] for r in references}) == 4,\\n\",\"    \\\"alphabetical_order\\\": [\\n\",\"        r[\\\"first_author\\\"].lower() for r in references\\n\",\"    ] == sorted(r[\\\"first_author\\\"].lower() for r in references),\\n\",\"    \\\"all_references_have_authors\\\": all(r[\\\"authors\\\"] for r in references),\\n\",\"    \\\"all_references_have_years\\\": all(r[\\\"year\\\"] for r in references),\\n\",\"    \\\"all_references_have_doi\\\": all(r[\\\"doi\\\"] for r in references),\\n\",\"    \\\"moses_correctly_classified_as_conference_chapter\\\": (\\n\",\"        next(r for r in references if r[\\\"id\\\"] == \\\"REF01\\\")[\\n\",\"            \\\"publication_type\\\"\\n\",\"        ] == \\\"Conference proceedings chapter\\\"\\n\",\"    ),\\n\",\"    \\\"all_four_in_text_citations_defined\\\": len(in_text_citations) == 4,\\n\",\"    \\\"apa_three_author_et_al_convention\\\": all(\\n\",\"        \\\"et al.\\\" in c[\\\"parenthetical\\\"]\\n\",\"        for c in in_text_citations\\n\",\"    ),\\n\",\"    \\\"no_duplicate_ochoa_reference\\\": sum(\\n\",\"        r[\\\"doi\\\"] == \\\"10.1049/iet-cvi.2014.0086\\\"\\n\",\"        for r in references\\n\",\"    ) == 1\\n\",\"}\\n\",\"\\n\",\"record = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"phase\\\": \\\"3.3\\\",\\n\",\"    \\\"step\\\": \\\"3.3.8.3\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"reference_style\\\": \\\"APA 7th edition\\\",\\n\",\"    \\\"references\\\": references,\\n\",\"    \\\"in_text_citation_convention\\\": in_text_citations,\\n\",\"    \\\"checks\\\": checks,\\n\",\"    \\\"passed_checks\\\": sum(checks.values()),\\n\",\"    \\\"total_checks\\\": len(checks),\\n\",\"    \\\"failed_checks\\\": [\\n\",\"        key for key, value in checks.items() if not value\\n\",\"    ],\\n\",\"    \\\"editorial_correction\\\": (\\n\",\"        \\\"Use Moses et al. (1994), not Moses, Adini, and Ullman (1994), \\\"\\n\",\"        \\\"for APA 7 in-text citations.\\\"\\n\",\"    ),\\n\",\"    \\\"status\\\": (\\n\",\"        \\\"REFERENCE_LIST_PREPARED_INITIAL_CHECKS_PASSED\\\"\\n\",\"        if all(checks.values())\\n\",\"        else \\\"REFERENCE_LIST_REQUIRES_REVIEW\\\"\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"md_path = OUTPUT_DIR / \\\"experiment20_reference_list_apa7.md\\\"\\n\",\"json_path = OUTPUT_DIR / \\\"experiment20_reference_list_apa7.json\\\"\\n\",\"\\n\",\"with open(md_path, \\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    f.write(reference_markdown)\\n\",\"\\n\",\"with open(json_path, \\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    json.dump(record, f, indent=2, ensure_ascii=False)\\n\",\"\\n\",\"with open(md_path, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    md_reload = f.read()\\n\",\"\\n\",\"with open(json_path, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    json_reload = json.load(f)\\n\",\"\\n\",\"assert md_reload == reference_markdown\\n\",\"assert json_reload == record\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.3.8.3\\\")\\n\",\"print(\\\"COMPLETE REFERENCE-LIST PREPARATION\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"print(\\\"\\\\nReference entries:\\\")\\n\",\"for ref in references:\\n\",\"    print(f\\\"{ref['first_author']} et al. ({ref['year']})\\\")\\n\",\"    print(\\\"DOI:\\\", ref[\\\"doi\\\"])\\n\",\"    print(\\\"Type:\\\", ref[\\\"publication_type\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nIn-text citations:\\\")\\n\",\"for item in in_text_citations:\\n\",\"    print(item[\\\"parenthetical\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nChecks:\\\")\\n\",\"for key, value in checks.items():\\n\",\"    print(f\\\"{key}: {'PASS' if value else 'FAIL'}\\\")\\n\",\"\\n\",\"print(\\\"\\\\nPassed:\\\", record[\\\"passed_checks\\\"], \\\"/\\\", record[\\\"total_checks\\\"])\\n\",\"print(\\\"Failed:\\\", len(record[\\\"failed_checks\\\"]))\\n\",\"print(\\\"Status:\\\", record[\\\"status\\\"])\\n\",\"print(\\\"Markdown reload: PASS\\\")\\n\",\"print(\\\"JSON reload: PASS\\\")\\n\",\"print(\\\"\\\\nSaved:\\\")\\n\",\"print(md_path)\\n\",\"print(json_path)\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"6dKHBbNaHsON\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794392378693,\"user_tz\":360,\"elapsed\":141,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"f5c21320-b6fc-4512-82eb-029124ddbbc0\"},\"execution_count\":60,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.3.8.3\\n\",\"COMPLETE REFERENCE-LIST PREPARATION\\n\",\"========================================================================================\\n\",\"\\n\",\"Reference entries:\\n\",\"Beveridge et al. (2009)\\n\",\"DOI: 10.1109/TPAMI.2008.200\\n\",\"Type: Journal article\\n\",\"Han et al. (2013)\\n\",\"DOI: 10.1016/j.patcog.2012.11.022\\n\",\"Type: Journal article\\n\",\"Moses et al. (1994)\\n\",\"DOI: 10.1007/3-540-57956-7_33\\n\",\"Type: Conference proceedings chapter\\n\",\"Ochoa-Villegas et al. (2015)\\n\",\"DOI: 10.1049/iet-cvi.2014.0086\\n\",\"Type: Journal article\\n\",\"\\n\",\"In-text citations:\\n\",\"(Moses et al., 1994)\\n\",\"(Beveridge et al., 2009)\\n\",\"(Han et al., 2013)\\n\",\"(Ochoa-Villegas et al., 2015)\\n\",\"\\n\",\"Checks:\\n\",\"four_references_present: PASS\\n\",\"unique_dois: PASS\\n\",\"alphabetical_order: PASS\\n\",\"all_references_have_authors: PASS\\n\",\"all_references_have_years: PASS\\n\",\"all_references_have_doi: PASS\\n\",\"moses_correctly_classified_as_conference_chapter: PASS\\n\",\"all_four_in_text_citations_defined: PASS\\n\",\"apa_three_author_et_al_convention: PASS\\n\",\"no_duplicate_ochoa_reference: PASS\\n\",\"\\n\",\"Passed: 10 / 10\\n\",\"Failed: 0\\n\",\"Status: REFERENCE_LIST_PREPARED_INITIAL_CHECKS_PASSED\\n\",\"Markdown reload: PASS\\n\",\"JSON reload: PASS\\n\",\"\\n\",\"Saved:\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3383/experiment20_reference_list_apa7.md\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3383/experiment20_reference_list_apa7.json\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.3.8.4\\n\",\"## In-Text Citation Consistency Audit\\n\",\"\\n\",\"### Objective\\n\",\"\\n\",\"Verify consistency between the consolidated introduction and the APA 7 reference list.\\n\",\"\\n\",\"### Required citation forms\\n\",\"\\n\",\"- Moses et al. (1994)\\n\",\"- Beveridge et al. (2009)\\n\",\"- Han et al. (2013)\\n\",\"- Ochoa-Villegas et al. (2015)\\n\",\"\\n\",\"### Checks\\n\",\"\\n\",\"1. Replace outdated three-author narrative citation formatting.\\n\",\"2. Identify all cited author-year combinations.\\n\",\"3. Confirm every citation has a corresponding reference entry.\\n\",\"4. Identify unused reference entries.\\n\",\"5. Confirm the angular-grouping citation remains present.\\n\",\"6. Preserve the existing introduction content apart from citation corrections.\\n\",\"\\n\",\"### Deliverables\\n\",\"\\n\",\"- Corrected consolidated introduction.\\n\",\"- Citation consistency audit JSON.\\n\",\"- Markdown and JSON reload verification.\"],\"metadata\":{\"id\":\"xT3DZuOVH43S\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"import re\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"STEP_DIR = BASE / \\\"step_3_3\\\"\\n\",\"\\n\",\"INTRO_DIR = STEP_DIR / \\\"step_3382\\\"\\n\",\"REF_DIR = STEP_DIR / \\\"step_3383\\\"\\n\",\"OUTPUT_DIR = STEP_DIR / \\\"step_3384\\\"\\n\",\"OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"INTRO_FILE = INTRO_DIR / \\\"experiment20_consolidated_introduction_v2.md\\\"\\n\",\"REF_FILE = REF_DIR / \\\"experiment20_reference_list_apa7.json\\\"\\n\",\"\\n\",\"for path in [INTRO_FILE, REF_FILE]:\\n\",\"    if not path.exists():\\n\",\"        raise FileNotFoundError(f\\\"Missing required file: {path}\\\")\\n\",\"\\n\",\"with open(INTRO_FILE, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    original_intro = f.read()\\n\",\"\\n\",\"with open(REF_FILE, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    reference_record = json.load(f)\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 1. Correct APA 7 narrative citation\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"corrected_intro = original_intro.replace(\\n\",\"    \\\"Moses, Adini, and Ullman (1994)\\\",\\n\",\"    \\\"Moses et al. (1994)\\\"\\n\",\")\\n\",\"\\n\",\"corrected_intro = corrected_intro.replace(\\n\",\"    \\\"Moses, Adini & Ullman (1994)\\\",\\n\",\"    \\\"Moses et al. (1994)\\\"\\n\",\")\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 2. Define expected author-year references\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"expected_citations = {\\n\",\"    \\\"Moses et al. (1994)\\\": \\\"REF01\\\",\\n\",\"    \\\"Beveridge et al. (2009)\\\": \\\"REF02\\\",\\n\",\"    \\\"Han et al. (2013)\\\": \\\"REF03\\\",\\n\",\"    \\\"Ochoa-Villegas et al. (2015)\\\": \\\"REF04\\\"\\n\",\"}\\n\",\"\\n\",\"references = reference_record[\\\"references\\\"]\\n\",\"\\n\",\"reference_ids = {\\n\",\"    ref[\\\"id\\\"]: ref for ref in references\\n\",\"}\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 3. Detect expected citations and reference coverage\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"citation_presence = {\\n\",\"    citation: citation in corrected_intro\\n\",\"    for citation in expected_citations\\n\",\"}\\n\",\"\\n\",\"reference_coverage = {\\n\",\"    citation: expected_citations[citation] in reference_ids\\n\",\"    for citation in expected_citations\\n\",\"}\\n\",\"\\n\",\"# Detect the older Moses form.\\n\",\"old_moses_form_present = (\\n\",\"    \\\"Moses, Adini, and Ullman (1994)\\\" in corrected_intro\\n\",\"    or \\\"Moses, Adini & Ullman (1994)\\\" in corrected_intro\\n\",\")\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 4. Detect unused references\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"unused_references = []\\n\",\"\\n\",\"for citation, reference_id in expected_citations.items():\\n\",\"    if not citation_presence[citation]:\\n\",\"        unused_references.append(reference_id)\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 5. Check the angular grouping citation\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"angular_citation_present = (\\n\",\"    \\\"Ochoa-Villegas et al. (2015)\\\" in corrected_intro\\n\",\")\\n\",\"\\n\",\"angular_grouping_description_present = all(\\n\",\"    value in corrected_intro\\n\",\"    for value in [\\n\",\"        \\\"0°–12°\\\",\\n\",\"        \\\"13°–25°\\\",\\n\",\"        \\\"26°–50°\\\",\\n\",\"        \\\"51°–77°\\\",\\n\",\"        \\\"above 77°\\\"\\n\",\"    ]\\n\",\")\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 6. Build audit\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"checks = {\\n\",\"    \\\"moses_apa7_narrative_form\\\": (\\n\",\"        \\\"Moses et al. (1994)\\\" in corrected_intro\\n\",\"    ),\\n\",\"    \\\"old_moses_form_removed\\\": not old_moses_form_present,\\n\",\"    \\\"beveridge_citation_present\\\": citation_presence[\\n\",\"        \\\"Beveridge et al. (2009)\\\"\\n\",\"    ],\\n\",\"    \\\"han_citation_present\\\": citation_presence[\\n\",\"        \\\"Han et al. (2013)\\\"\\n\",\"    ],\\n\",\"    \\\"ochoa_citation_present\\\": citation_presence[\\n\",\"        \\\"Ochoa-Villegas et al. (2015)\\\"\\n\",\"    ],\\n\",\"    \\\"all_four_reference_entries_available\\\": all(\\n\",\"        reference_coverage.values()\\n\",\"    ),\\n\",\"    \\\"no_unused_reference_entries\\\": len(unused_references) == 0,\\n\",\"    \\\"angular_grouping_citation_preserved\\\": angular_citation_present,\\n\",\"    \\\"five_subset_description_preserved\\\": angular_grouping_description_present\\n\",\"}\\n\",\"\\n\",\"audit = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"phase\\\": \\\"3.3\\\",\\n\",\"    \\\"step\\\": \\\"3.3.8.4\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"citation_style\\\": \\\"APA 7th edition\\\",\\n\",\"    \\\"citation_presence\\\": citation_presence,\\n\",\"    \\\"reference_coverage\\\": reference_coverage,\\n\",\"    \\\"unused_reference_ids\\\": unused_references,\\n\",\"    \\\"checks\\\": checks,\\n\",\"    \\\"passed_checks\\\": sum(checks.values()),\\n\",\"    \\\"total_checks\\\": len(checks),\\n\",\"    \\\"failed_checks\\\": [\\n\",\"        key for key, value in checks.items() if not value\\n\",\"    ],\\n\",\"    \\\"status\\\": (\\n\",\"        \\\"IN_TEXT_CITATION_CONSISTENCY_PASSED\\\"\\n\",\"        if all(checks.values())\\n\",\"        else \\\"IN_TEXT_CITATION_CONSISTENCY_REQUIRES_REVIEW\\\"\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 7. Save corrected introduction and audit\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"markdown_path = OUTPUT_DIR / (\\n\",\"    \\\"experiment20_consolidated_introduction_apa7_corrected.md\\\"\\n\",\")\\n\",\"\\n\",\"json_path = OUTPUT_DIR / (\\n\",\"    \\\"experiment20_step3384_citation_consistency_audit.json\\\"\\n\",\")\\n\",\"\\n\",\"with open(markdown_path, \\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    f.write(corrected_intro)\\n\",\"\\n\",\"with open(json_path, \\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    json.dump(audit, f, indent=2, ensure_ascii=False)\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 8. Reload verification\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"with open(markdown_path, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    markdown_reload = f.read()\\n\",\"\\n\",\"with open(json_path, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    audit_reload = json.load(f)\\n\",\"\\n\",\"assert markdown_reload == corrected_intro\\n\",\"assert audit_reload == audit\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.3.8.4\\\")\\n\",\"print(\\\"IN-TEXT CITATION CONSISTENCY AUDIT\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"print(\\\"\\\\nCitation presence:\\\")\\n\",\"for citation, present in citation_presence.items():\\n\",\"    print(f\\\"{citation}: {'PASS' if present else 'FAIL'}\\\")\\n\",\"\\n\",\"print(\\\"\\\\nReference coverage:\\\")\\n\",\"for citation, covered in reference_coverage.items():\\n\",\"    print(f\\\"{citation}: {'PASS' if covered else 'FAIL'}\\\")\\n\",\"\\n\",\"print(\\\"\\\\nConsistency checks:\\\")\\n\",\"for key, value in checks.items():\\n\",\"    print(f\\\"{key}: {'PASS' if value else 'FAIL'}\\\")\\n\",\"\\n\",\"print(\\\"\\\\nUnused references:\\\", unused_references)\\n\",\"print(\\\"Passed checks:\\\", audit[\\\"passed_checks\\\"], \\\"/\\\", audit[\\\"total_checks\\\"])\\n\",\"print(\\\"Failed checks:\\\", len(audit[\\\"failed_checks\\\"]))\\n\",\"print(\\\"Status:\\\", audit[\\\"status\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nMarkdown reload: PASS\\\")\\n\",\"print(\\\"Audit JSON reload: PASS\\\")\\n\",\"\\n\",\"print(\\\"\\\\nSaved files:\\\")\\n\",\"print(markdown_path)\\n\",\"print(json_path)\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"zqJSzygdH67Q\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794392451989,\"user_tz\":360,\"elapsed\":285,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"ac233db6-0140-4555-83e5-4a8735437726\"},\"execution_count\":61,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.3.8.4\\n\",\"IN-TEXT CITATION CONSISTENCY AUDIT\\n\",\"========================================================================================\\n\",\"\\n\",\"Citation presence:\\n\",\"Moses et al. (1994): PASS\\n\",\"Beveridge et al. (2009): PASS\\n\",\"Han et al. (2013): FAIL\\n\",\"Ochoa-Villegas et al. (2015): PASS\\n\",\"\\n\",\"Reference coverage:\\n\",\"Moses et al. (1994): PASS\\n\",\"Beveridge et al. (2009): PASS\\n\",\"Han et al. (2013): PASS\\n\",\"Ochoa-Villegas et al. (2015): PASS\\n\",\"\\n\",\"Consistency checks:\\n\",\"moses_apa7_narrative_form: PASS\\n\",\"old_moses_form_removed: PASS\\n\",\"beveridge_citation_present: PASS\\n\",\"han_citation_present: FAIL\\n\",\"ochoa_citation_present: PASS\\n\",\"all_four_reference_entries_available: PASS\\n\",\"no_unused_reference_entries: FAIL\\n\",\"angular_grouping_citation_preserved: PASS\\n\",\"five_subset_description_preserved: PASS\\n\",\"\\n\",\"Unused references: ['REF03']\\n\",\"Passed checks: 7 / 9\\n\",\"Failed checks: 2\\n\",\"Status: IN_TEXT_CITATION_CONSISTENCY_REQUIRES_REVIEW\\n\",\"\\n\",\"Markdown reload: PASS\\n\",\"Audit JSON reload: PASS\\n\",\"\\n\",\"Saved files:\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3384/experiment20_consolidated_introduction_apa7_corrected.md\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3384/experiment20_step3384_citation_consistency_audit.json\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[],\"metadata\":{\"id\":\"yNxAIe5hIM7s\"}},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.3.8.5\\n\",\"## Correction of Citation Detection Logic\\n\",\"\\n\",\"### Problem identified\\n\",\"\\n\",\"The previous audit searched for narrative citations only.\\n\",\"\\n\",\"It failed to recognise the valid APA 7 parenthetical citation:\\n\",\"\\n\",\"(Han et al., 2013)\\n\",\"\\n\",\"### Correction\\n\",\"\\n\",\"The revised audit will recognise both:\\n\",\"\\n\",\"- Narrative: Han et al. (2013)\\n\",\"- Parenthetical: (Han et al., 2013)\\n\",\"\\n\",\"### Verification requirements\\n\",\"\\n\",\"1. Detect narrative citations.\\n\",\"2. Detect parenthetical citations.\\n\",\"3. Confirm all four references are actually cited.\\n\",\"4. Identify genuinely unused references.\\n\",\"5. Preserve the introduction without unnecessary citation insertion.\\n\",\"6. Save a corrected audit and verify file reloads.\\n\",\"\\n\",\"The previous failed result will remain preserved as an audit-history record.\"],\"metadata\":{\"id\":\"8r8JemVIINH_\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"import re\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"STEP_DIR = BASE / \\\"step_3_3\\\"\\n\",\"\\n\",\"INPUT_FILE = (\\n\",\"    STEP_DIR / \\\"step_3384\\\" /\\n\",\"    \\\"experiment20_consolidated_introduction_apa7_corrected.md\\\"\\n\",\")\\n\",\"\\n\",\"REFERENCE_FILE = (\\n\",\"    STEP_DIR / \\\"step_3383\\\" /\\n\",\"    \\\"experiment20_reference_list_apa7.json\\\"\\n\",\")\\n\",\"\\n\",\"OUTPUT_DIR = STEP_DIR / \\\"step_3385\\\"\\n\",\"OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"for path in [INPUT_FILE, REFERENCE_FILE]:\\n\",\"    if not path.exists():\\n\",\"        raise FileNotFoundError(f\\\"Missing file: {path}\\\")\\n\",\"\\n\",\"with open(INPUT_FILE, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    introduction = f.read()\\n\",\"\\n\",\"with open(REFERENCE_FILE, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    reference_record = json.load(f)\\n\",\"\\n\",\"# Recognise both APA 7 narrative and parenthetical citations.\\n\",\"citation_patterns = {\\n\",\"    \\\"REF01\\\": {\\n\",\"        \\\"author\\\": \\\"Moses\\\",\\n\",\"        \\\"year\\\": 1994,\\n\",\"        \\\"pattern\\\": r\\\"Moses\\\\s+et\\\\s+al\\\\.\\\\s*,?\\\\s*\\\\(1994\\\\)\\\"\\n\",\"    },\\n\",\"    \\\"REF02\\\": {\\n\",\"        \\\"author\\\": \\\"Beveridge\\\",\\n\",\"        \\\"year\\\": 2009,\\n\",\"        \\\"pattern\\\": r\\\"Beveridge\\\\s+et\\\\s+al\\\\.\\\\s*,?\\\\s*\\\\(2009\\\\)\\\"\\n\",\"    },\\n\",\"    \\\"REF03\\\": {\\n\",\"        \\\"author\\\": \\\"Han\\\",\\n\",\"        \\\"year\\\": 2013,\\n\",\"        \\\"pattern\\\": r\\\"Han\\\\s+et\\\\s+al\\\\.\\\\s*,?\\\\s*\\\\(2013\\\\)\\\"\\n\",\"    },\\n\",\"    \\\"REF04\\\": {\\n\",\"        \\\"author\\\": \\\"Ochoa-Villegas\\\",\\n\",\"        \\\"year\\\": 2015,\\n\",\"        \\\"pattern\\\": r\\\"Ochoa-Villegas\\\\s+et\\\\s+al\\\\.\\\\s*,?\\\\s*\\\\(2015\\\\)\\\"\\n\",\"    }\\n\",\"}\\n\",\"\\n\",\"reference_ids = {\\n\",\"    ref[\\\"id\\\"] for ref in reference_record[\\\"references\\\"]\\n\",\"}\\n\",\"\\n\",\"citation_results = {}\\n\",\"\\n\",\"for reference_id, info in citation_patterns.items():\\n\",\"    matches = list(\\n\",\"        re.finditer(info[\\\"pattern\\\"], introduction, flags=re.IGNORECASE)\\n\",\"    )\\n\",\"\\n\",\"    citation_results[reference_id] = {\\n\",\"        \\\"author\\\": info[\\\"author\\\"],\\n\",\"        \\\"year\\\": info[\\\"year\\\"],\\n\",\"        \\\"occurrences\\\": len(matches),\\n\",\"        \\\"present\\\": len(matches) > 0,\\n\",\"        \\\"reference_entry_exists\\\": reference_id in reference_ids\\n\",\"    }\\n\",\"\\n\",\"# Check the older, non-APA narrative form.\\n\",\"old_moses_form = bool(\\n\",\"    re.search(\\n\",\"        r\\\"Moses\\\\s*,\\\\s*Adini\\\\s*,?\\\\s*and\\\\s+Ullman\\\\s*\\\\(1994\\\\)\\\",\\n\",\"        introduction,\\n\",\"        flags=re.IGNORECASE\\n\",\"    )\\n\",\")\\n\",\"\\n\",\"# Check the angular grouping citation and description.\\n\",\"angular_citation_present = citation_results[\\\"REF04\\\"][\\\"present\\\"]\\n\",\"\\n\",\"angular_grouping_present = all(\\n\",\"    term in introduction\\n\",\"    for term in [\\\"0°–12°\\\", \\\"13°–25°\\\", \\\"26°–50°\\\", \\\"51°–77°\\\", \\\"above 77°\\\"]\\n\",\")\\n\",\"\\n\",\"# A reference is genuinely unused only if neither narrative\\n\",\"# nor parenthetical forms are detected.\\n\",\"unused_references = [\\n\",\"    reference_id\\n\",\"    for reference_id, result in citation_results.items()\\n\",\"    if not result[\\\"present\\\"]\\n\",\"]\\n\",\"\\n\",\"checks = {\\n\",\"    \\\"moses_citation_detected\\\": citation_results[\\\"REF01\\\"][\\\"present\\\"],\\n\",\"    \\\"beveridge_citation_detected\\\": citation_results[\\\"REF02\\\"][\\\"present\\\"],\\n\",\"    \\\"han_citation_detected\\\": citation_results[\\\"REF03\\\"][\\\"present\\\"],\\n\",\"    \\\"ochoa_citation_detected\\\": citation_results[\\\"REF04\\\"][\\\"present\\\"],\\n\",\"    \\\"all_citations_have_reference_entries\\\": all(\\n\",\"        result[\\\"reference_entry_exists\\\"]\\n\",\"        for result in citation_results.values()\\n\",\"        if result[\\\"present\\\"]\\n\",\"    ),\\n\",\"    \\\"no_genuinely_unused_references\\\": len(unused_references) == 0,\\n\",\"    \\\"old_moses_citation_removed\\\": not old_moses_form,\\n\",\"    \\\"angular_grouping_citation_preserved\\\": angular_citation_present,\\n\",\"    \\\"angular_grouping_description_preserved\\\": angular_grouping_present\\n\",\"}\\n\",\"\\n\",\"audit = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"phase\\\": \\\"3.3\\\",\\n\",\"    \\\"step\\\": \\\"3.3.8.5\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"citation_style\\\": \\\"APA 7th edition\\\",\\n\",\"    \\\"detection_support\\\": [\\n\",\"        \\\"Narrative citations\\\",\\n\",\"        \\\"Parenthetical citations\\\"\\n\",\"    ],\\n\",\"    \\\"citation_results\\\": citation_results,\\n\",\"    \\\"unused_references\\\": unused_references,\\n\",\"    \\\"checks\\\": checks,\\n\",\"    \\\"passed_checks\\\": sum(checks.values()),\\n\",\"    \\\"total_checks\\\": len(checks),\\n\",\"    \\\"failed_checks\\\": [\\n\",\"        key for key, value in checks.items() if not value\\n\",\"    ],\\n\",\"    \\\"introduction_modified\\\": False,\\n\",\"    \\\"previous_audit_failure_explanation\\\": (\\n\",\"        \\\"The previous checker searched for narrative citations only \\\"\\n\",\"        \\\"and did not recognise valid parenthetical citations.\\\"\\n\",\"    ),\\n\",\"    \\\"status\\\": (\\n\",\"        \\\"CORRECTED_CITATION_AUDIT_PASSED\\\"\\n\",\"        if all(checks.values())\\n\",\"        else \\\"CORRECTED_CITATION_AUDIT_REQUIRES_REVIEW\\\"\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"OUTPUT_FILE = OUTPUT_DIR / (\\n\",\"    \\\"experiment20_step3385_corrected_citation_audit.json\\\"\\n\",\")\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    json.dump(audit, f, indent=2, ensure_ascii=False)\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    reloaded = json.load(f)\\n\",\"\\n\",\"assert reloaded == audit\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.3.8.5\\\")\\n\",\"print(\\\"CORRECTED APA 7 CITATION DETECTION\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"print(\\\"\\\\nCitation detection:\\\")\\n\",\"for reference_id, result in citation_results.items():\\n\",\"    print(\\n\",\"        f\\\"{result['author']} et al. ({result['year']}): \\\"\\n\",\"        f\\\"{'PASS' if result['present'] else 'FAIL'} \\\"\\n\",\"        f\\\"| Occurrences: {result['occurrences']}\\\"\\n\",\"    )\\n\",\"\\n\",\"print(\\\"\\\\nUnused references:\\\", unused_references)\\n\",\"\\n\",\"print(\\\"\\\\nAudit checks:\\\")\\n\",\"for key, value in checks.items():\\n\",\"    print(f\\\"{key}: {'PASS' if value else 'FAIL'}\\\")\\n\",\"\\n\",\"print(\\\"\\\\nPassed:\\\", audit[\\\"passed_checks\\\"], \\\"/\\\", audit[\\\"total_checks\\\"])\\n\",\"print(\\\"Failed:\\\", len(audit[\\\"failed_checks\\\"]))\\n\",\"print(\\\"Introduction modified:\\\", audit[\\\"introduction_modified\\\"])\\n\",\"print(\\\"Status:\\\", audit[\\\"status\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nJSON reload: PASS\\\")\\n\",\"print(\\\"Saved:\\\", OUTPUT_FILE)\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"KLys3i08IPGF\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794392522076,\"user_tz\":360,\"elapsed\":92,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"5c7e2ccc-209d-453e-92eb-bc22ec8e9ec8\"},\"execution_count\":62,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.3.8.5\\n\",\"CORRECTED APA 7 CITATION DETECTION\\n\",\"========================================================================================\\n\",\"\\n\",\"Citation detection:\\n\",\"Moses et al. (1994): PASS | Occurrences: 1\\n\",\"Beveridge et al. (2009): PASS | Occurrences: 1\\n\",\"Han et al. (2013): FAIL | Occurrences: 0\\n\",\"Ochoa-Villegas et al. (2015): PASS | Occurrences: 1\\n\",\"\\n\",\"Unused references: ['REF03']\\n\",\"\\n\",\"Audit checks:\\n\",\"moses_citation_detected: PASS\\n\",\"beveridge_citation_detected: PASS\\n\",\"han_citation_detected: FAIL\\n\",\"ochoa_citation_detected: PASS\\n\",\"all_citations_have_reference_entries: PASS\\n\",\"no_genuinely_unused_references: FAIL\\n\",\"old_moses_citation_removed: PASS\\n\",\"angular_grouping_citation_preserved: PASS\\n\",\"angular_grouping_description_preserved: PASS\\n\",\"\\n\",\"Passed: 7 / 9\\n\",\"Failed: 2\\n\",\"Introduction modified: False\\n\",\"Status: CORRECTED_CITATION_AUDIT_REQUIRES_REVIEW\\n\",\"\\n\",\"JSON reload: PASS\\n\",\"Saved: /content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3385/experiment20_step3385_corrected_citation_audit.json\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.3.8.6\\n\",\"## Locate the Appropriate Position for the Han et al. (2013) Citation\\n\",\"\\n\",\"The previous audit confirmed that Han et al. (2013) is included in the reference list but is not cited in the consolidated introduction.\\n\",\"\\n\",\"This step inspects the existing introduction for statements about illumination preprocessing and related approaches.\\n\",\"\\n\",\"No manuscript changes will be made in this step.\\n\",\"\\n\",\"The citation will only be inserted where the existing statement is supported by the cited study.\"],\"metadata\":{\"id\":\"KsCrgy1CIbXP\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import re\\n\",\"\\n\",\"INPUT_FILE = Path(\\n\",\"    \\\"/content/drive/MyDrive/Experiment_20_Results/\\\"\\n\",\"    \\\"step_3_3/step_3384/\\\"\\n\",\"    \\\"experiment20_consolidated_introduction_apa7_corrected.md\\\"\\n\",\")\\n\",\"\\n\",\"if not INPUT_FILE.exists():\\n\",\"    raise FileNotFoundError(INPUT_FILE)\\n\",\"\\n\",\"text = INPUT_FILE.read_text(encoding=\\\"utf-8\\\")\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.3.8.6\\\")\\n\",\"print(\\\"HAN ET AL. CITATION PLACEMENT INSPECTION\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"paragraphs = [\\n\",\"    p.strip()\\n\",\"    for p in re.split(r\\\"\\\\n\\\\s*\\\\n\\\", text)\\n\",\"    if p.strip()\\n\",\"]\\n\",\"\\n\",\"keywords = [\\n\",\"    \\\"preprocess\\\",\\n\",\"    \\\"enhancement\\\",\\n\",\"    \\\"illumination variation\\\",\\n\",\"    \\\"illumination compensation\\\",\\n\",\"    \\\"normalization\\\",\\n\",\"    \\\"normalisation\\\",\\n\",\"    \\\"lighting condition\\\",\\n\",\"    \\\"illumination method\\\"\\n\",\"]\\n\",\"\\n\",\"matches = []\\n\",\"\\n\",\"for index, paragraph in enumerate(paragraphs, start=1):\\n\",\"    if any(keyword in paragraph.lower() for keyword in keywords):\\n\",\"        matches.append((index, paragraph))\\n\",\"\\n\",\"print(f\\\"\\\\nTotal paragraphs: {len(paragraphs)}\\\")\\n\",\"print(f\\\"Relevant paragraphs found: {len(matches)}\\\")\\n\",\"\\n\",\"for index, paragraph in matches:\\n\",\"    print(f\\\"\\\\n--- PARAGRAPH {index} ---\\\")\\n\",\"    print(paragraph)\\n\",\"\\n\",\"print(\\\"\\\\nExisting Han citation occurrences:\\\",\\n\",\"      len(re.findall(r\\\"Han\\\\s+et\\\\s+al\\\\.\\\", text, flags=re.IGNORECASE)))\\n\",\"\\n\",\"print(\\\"\\\\nManuscript unchanged: inspection only\\\")\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"JzHP3TpOIdbo\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794392582261,\"user_tz\":360,\"elapsed\":101,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"a720f535-857f-442b-97eb-460b49b8a6c6\"},\"execution_count\":63,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.3.8.6\\n\",\"HAN ET AL. CITATION PLACEMENT INSPECTION\\n\",\"========================================================================================\\n\",\"\\n\",\"Total paragraphs: 35\\n\",\"Relevant paragraphs found: 6\\n\",\"\\n\",\"--- PARAGRAPH 8 ---\\n\",\"## 1.2 Illumination Variation and Its Effect on Facial Representations\\n\",\"\\n\",\"--- PARAGRAPH 9 ---\\n\",\"Illumination variation is a longstanding challenge in face-recognition research. Changes in the direction of incident light can produce substantial differences in facial appearance, affecting the distribution of shadows, highlights, and visible facial details. These variations can occur even when the images represent the same individual. Earlier research by Moses et al. (1994) specifically examined the problem of compensating for changes in illumination direction in face recognition.\\n\",\"\\n\",\"--- PARAGRAPH 10 ---\\n\",\"Subsequent research has investigated the relationship between illumination and facial appearance using different analytical approaches. Beveridge et al. (2009) examined subject illumination spaces and the role of principal angles in distinguishing them. Other studies have explored illumination preprocessing and methods intended to reduce the effects of lighting variation on face recognition (Han et al., 2013; Ochoa-Villegas et al., 2015). Research using Yale Face Database B has also classified illumination conditions according to the angle between the light-source direction and camera axis. Ochoa-Villegas et al. (2015) describe five angular subsets: 0°–12°, 13°–25°, 26°–50°, 51°–77°, and above 77°. This provides precedent for angular grouping in illumination studies. The present study adopts a different three-group classification, with near-frontal conditions defined as θ ≤ 30°, oblique conditions as 30° < θ ≤ 60°, and large-angular-deviation conditions as θ > 60°. These thresholds represent the analytical grouping adopted in Experiment 20 and are not the same as the five subsets reported in the survey.\\n\",\"\\n\",\"--- PARAGRAPH 15 ---\\n\",\"Existing research has examined the effects of illumination variation on face recognition through several approaches, including illumination preprocessing, feature representation, subject-specific illumination spaces, and recognition-performance evaluation. Studies using Yale B and Extended Yale B datasets have also investigated changes in facial representations under different lighting directions. More recent work has explored deep face-recognition architectures and the geometric properties of learned embedding spaces.\\n\",\"\\n\",\"--- PARAGRAPH 19 ---\\n\",\"The resulting analysis is deliberately descriptive. Because the evaluation uses different image captures rather than exact transformations of identical source images, observed embedding differences cannot be attributed exclusively to illumination. The findings are also specific to the selected dataset, preprocessing procedure, and pretrained model. Accordingly, the study is intended to contribute a focused empirical characterisation rather than a general claim about all face-recognition systems.\\n\",\"\\n\",\"--- PARAGRAPH 35 ---\\n\",\"The study does not evaluate face-recognition accuracy, develop an illumination-invariant representation, establish operational drift-detection capability, or validate generalisation across independent recognition architectures. Its findings should be interpreted as an empirical characterisation of reference-relative embedding displacement under the specific dataset, preprocessing procedure, and model used in this investigation.\\n\",\"\\n\",\"Existing Han citation occurrences: 1\\n\",\"\\n\",\"Manuscript unchanged: inspection only\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.3.8.7\\n\",\"## Final APA 7 Citation Consistency Verification\\n\",\"\\n\",\"### Finding\\n\",\"\\n\",\"The Han et al. (2013) reference is already cited in paragraph 10:\\n\",\"\\n\",\"(Han et al., 2013; Ochoa-Villegas et al., 2015)\\n\",\"\\n\",\"The previous audit incorrectly classified REF03 as unused because its regular expression did not recognise the parenthetical APA 7 format.\\n\",\"\\n\",\"### Correction\\n\",\"\\n\",\"The revised audit will:\\n\",\"\\n\",\"1. Recognise narrative and parenthetical APA 7 citations.\\n\",\"2. Verify all four references against the introduction.\\n\",\"3. Confirm the Han citation appears in the illumination-preprocessing discussion.\\n\",\"4. Confirm that the manuscript remains unchanged.\\n\",\"5. Preserve the previous audit records as historical evidence.\\n\",\"\\n\",\"No additional citation will be inserted.\"],\"metadata\":{\"id\":\"YbkV_o0pIpAL\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import re\\n\",\"import json\\n\",\"import hashlib\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"STEP_DIR = BASE / \\\"step_3_3\\\"\\n\",\"\\n\",\"SOURCE = (\\n\",\"    STEP_DIR / \\\"step_3384\\\" /\\n\",\"    \\\"experiment20_consolidated_introduction_apa7_corrected.md\\\"\\n\",\")\\n\",\"\\n\",\"REFERENCE_FILE = (\\n\",\"    STEP_DIR / \\\"step_3383\\\" /\\n\",\"    \\\"experiment20_reference_list_apa7.json\\\"\\n\",\")\\n\",\"\\n\",\"OUTPUT_DIR = STEP_DIR / \\\"step_3387\\\"\\n\",\"OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"if not SOURCE.exists() or not REFERENCE_FILE.exists():\\n\",\"    raise FileNotFoundError(\\\"Required manuscript or reference file missing.\\\")\\n\",\"\\n\",\"manuscript = SOURCE.read_text(encoding=\\\"utf-8\\\")\\n\",\"\\n\",\"with open(REFERENCE_FILE, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    reference_data = json.load(f)\\n\",\"\\n\",\"# Detect both narrative and parenthetical APA 7 citation forms.\\n\",\"patterns = {\\n\",\"    \\\"REF01\\\": r\\\"Moses\\\\s+et\\\\s+al\\\\.\\\\s*,?\\\\s*\\\\(1994\\\\)\\\",\\n\",\"    \\\"REF02\\\": r\\\"Beveridge\\\\s+et\\\\s+al\\\\.\\\\s*,?\\\\s*\\\\(2009\\\\)\\\",\\n\",\"    \\\"REF03\\\": r\\\"Han\\\\s+et\\\\s+al\\\\.\\\\s*,?\\\\s*\\\\(2013\\\\)\\\",\\n\",\"    \\\"REF04\\\": r\\\"Ochoa-Villegas\\\\s+et\\\\s+al\\\\.\\\\s*,?\\\\s*\\\\(2015\\\\)\\\"\\n\",\"}\\n\",\"\\n\",\"reference_ids = {\\n\",\"    item[\\\"id\\\"] for item in reference_data[\\\"references\\\"]\\n\",\"}\\n\",\"\\n\",\"citation_results = {}\\n\",\"\\n\",\"for ref_id, pattern in patterns.items():\\n\",\"    matches = list(\\n\",\"        re.finditer(pattern, manuscript, flags=re.IGNORECASE)\\n\",\"    )\\n\",\"\\n\",\"    citation_results[ref_id] = {\\n\",\"        \\\"occurrences\\\": len(matches),\\n\",\"        \\\"present\\\": len(matches) > 0,\\n\",\"        \\\"reference_entry_available\\\": ref_id in reference_ids\\n\",\"    }\\n\",\"\\n\",\"# Verify the Han citation is in the illumination-preprocessing paragraph.\\n\",\"paragraphs = [\\n\",\"    p.strip() for p in re.split(r\\\"\\\\n\\\\s*\\\\n\\\", manuscript)\\n\",\"    if p.strip()\\n\",\"]\\n\",\"\\n\",\"han_context = [\\n\",\"    p for p in paragraphs\\n\",\"    if \\\"Han et al., 2013\\\" in p\\n\",\"    and \\\"preprocessing\\\" in p.lower()\\n\",\"]\\n\",\"\\n\",\"# Verify the combined parenthetical citation.\\n\",\"combined_citation_present = bool(\\n\",\"    re.search(\\n\",\"        r\\\"\\\\(\\\\s*Han\\\\s+et\\\\s+al\\\\.,\\\\s*2013\\\\s*;\\\\s*\\\"\\n\",\"        r\\\"Ochoa-Villegas\\\\s+et\\\\s+al\\\\.,\\\\s*2015\\\\s*\\\\)\\\",\\n\",\"        manuscript\\n\",\"    )\\n\",\")\\n\",\"\\n\",\"# Check the reference list for genuinely unused entries.\\n\",\"unused_references = [\\n\",\"    ref_id for ref_id, result in citation_results.items()\\n\",\"    if not result[\\\"present\\\"]\\n\",\"]\\n\",\"\\n\",\"checks = {\\n\",\"    \\\"moses_citation_present\\\": citation_results[\\\"REF01\\\"][\\\"present\\\"],\\n\",\"    \\\"beveridge_citation_present\\\": citation_results[\\\"REF02\\\"][\\\"present\\\"],\\n\",\"    \\\"han_citation_present\\\": citation_results[\\\"REF03\\\"][\\\"present\\\"],\\n\",\"    \\\"ochoa_citation_present\\\": citation_results[\\\"REF04\\\"][\\\"present\\\"],\\n\",\"    \\\"all_four_reference_entries_available\\\": all(\\n\",\"        citation_results[ref_id][\\\"reference_entry_available\\\"]\\n\",\"        for ref_id in patterns\\n\",\"    ),\\n\",\"    \\\"no_unused_references\\\": len(unused_references) == 0,\\n\",\"    \\\"han_citation_in_preprocessing_context\\\": len(han_context) == 1,\\n\",\"    \\\"combined_parenthetical_citation_valid\\\": combined_citation_present,\\n\",\"    \\\"manuscript_file_unchanged_by_this_step\\\": True\\n\",\"}\\n\",\"\\n\",\"source_hash = hashlib.sha256(\\n\",\"    SOURCE.read_bytes()\\n\",\").hexdigest()\\n\",\"\\n\",\"audit = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"step\\\": \\\"3.3.8.7\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"citation_style\\\": \\\"APA 7\\\",\\n\",\"    \\\"citation_detection\\\": citation_results,\\n\",\"    \\\"han_citation_context_verified\\\": bool(han_context),\\n\",\"    \\\"unused_references\\\": unused_references,\\n\",\"    \\\"source_manuscript\\\": str(SOURCE),\\n\",\"    \\\"source_manuscript_sha256\\\": source_hash,\\n\",\"    \\\"manuscript_modified\\\": False,\\n\",\"    \\\"checks\\\": checks,\\n\",\"    \\\"passed_checks\\\": sum(checks.values()),\\n\",\"    \\\"total_checks\\\": len(checks),\\n\",\"    \\\"failed_checks\\\": [\\n\",\"        key for key, value in checks.items() if not value\\n\",\"    ],\\n\",\"    \\\"status\\\": (\\n\",\"        \\\"FINAL_CITATION_CONSISTENCY_VERIFIED\\\"\\n\",\"        if all(checks.values())\\n\",\"        else \\\"CITATION_CONSISTENCY_REQUIRES_REVIEW\\\"\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"AUDIT_FILE = OUTPUT_DIR / (\\n\",\"    \\\"experiment20_step3387_final_citation_consistency_audit.json\\\"\\n\",\")\\n\",\"\\n\",\"with open(AUDIT_FILE, \\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    json.dump(audit, f, indent=2, ensure_ascii=False)\\n\",\"\\n\",\"with open(AUDIT_FILE, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    reloaded = json.load(f)\\n\",\"\\n\",\"assert reloaded == audit\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.3.8.7\\\")\\n\",\"print(\\\"FINAL APA 7 CITATION CONSISTENCY VERIFICATION\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"for ref_id, result in citation_results.items():\\n\",\"    print(\\n\",\"        f\\\"{ref_id}: \\\"\\n\",\"        f\\\"{'PASS' if result['present'] else 'FAIL'} \\\"\\n\",\"        f\\\"| Occurrences: {result['occurrences']}\\\"\\n\",\"    )\\n\",\"\\n\",\"print(\\\"\\\\nHan preprocessing context:\\\", \\\"PASS\\\" if han_context else \\\"FAIL\\\")\\n\",\"print(\\\"Combined parenthetical citation:\\\",\\n\",\"      \\\"PASS\\\" if combined_citation_present else \\\"FAIL\\\")\\n\",\"\\n\",\"print(\\\"\\\\nUnused references:\\\", unused_references)\\n\",\"\\n\",\"print(\\\"\\\\nChecks:\\\")\\n\",\"for name, passed in checks.items():\\n\",\"    print(f\\\"{name}: {'PASS' if passed else 'FAIL'}\\\")\\n\",\"\\n\",\"print(f\\\"\\\\nPassed: {audit['passed_checks']} / {audit['total_checks']}\\\")\\n\",\"print(\\\"Failed:\\\", len(audit[\\\"failed_checks\\\"]))\\n\",\"print(\\\"Manuscript modified:\\\", audit[\\\"manuscript_modified\\\"])\\n\",\"print(\\\"Status:\\\", audit[\\\"status\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nAudit JSON reload: PASS\\\")\\n\",\"print(\\\"Manuscript SHA256:\\\", source_hash)\\n\",\"print(\\\"Saved:\\\", AUDIT_FILE)\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"KNDH4oR0IrFX\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794392636848,\"user_tz\":360,\"elapsed\":91,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"746f6c96-4f37-4dd1-85f9-324cd87f822c\"},\"execution_count\":64,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.3.8.7\\n\",\"FINAL APA 7 CITATION CONSISTENCY VERIFICATION\\n\",\"========================================================================================\\n\",\"REF01: PASS | Occurrences: 1\\n\",\"REF02: PASS | Occurrences: 1\\n\",\"REF03: FAIL | Occurrences: 0\\n\",\"REF04: PASS | Occurrences: 1\\n\",\"\\n\",\"Han preprocessing context: PASS\\n\",\"Combined parenthetical citation: PASS\\n\",\"\\n\",\"Unused references: ['REF03']\\n\",\"\\n\",\"Checks:\\n\",\"moses_citation_present: PASS\\n\",\"beveridge_citation_present: PASS\\n\",\"han_citation_present: FAIL\\n\",\"ochoa_citation_present: PASS\\n\",\"all_four_reference_entries_available: PASS\\n\",\"no_unused_references: FAIL\\n\",\"han_citation_in_preprocessing_context: PASS\\n\",\"combined_parenthetical_citation_valid: PASS\\n\",\"manuscript_file_unchanged_by_this_step: PASS\\n\",\"\\n\",\"Passed: 7 / 9\\n\",\"Failed: 2\\n\",\"Manuscript modified: False\\n\",\"Status: CITATION_CONSISTENCY_REQUIRES_REVIEW\\n\",\"\\n\",\"Audit JSON reload: PASS\\n\",\"Manuscript SHA256: ca3ab908d847959898ace51269ca4ecf5f0103e86cd5d4cc03d2dd1f0c95166f\\n\",\"Saved: /content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3387/experiment20_step3387_final_citation_consistency_audit.json\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.3.8.8\\n\",\"## Final APA 7 Citation Audit — Regex Correction\\n\",\"\\n\",\"The previous audit incorrectly detected the Han citation because its regular expression did not support the comma-separated author-year format used in parenthetical citations.\\n\",\"\\n\",\"The revised detector will recognise:\\n\",\"\\n\",\"- Narrative: Han et al. (2013)\\n\",\"- Parenthetical: (Han et al., 2013)\\n\",\"\\n\",\"The same dual-format detection will be applied to all four references.\\n\",\"\\n\",\"No manuscript content will be changed.\\n\",\"\\n\",\"The audit will verify citation presence, reference coverage, the Han preprocessing context, and the unchanged manuscript checksum.\"],\"metadata\":{\"id\":\"GnWbk7_9JAMU\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import re\\n\",\"import json\\n\",\"import hashlib\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"STEP_DIR = BASE / \\\"step_3_3\\\"\\n\",\"\\n\",\"SOURCE = (\\n\",\"    STEP_DIR / \\\"step_3384\\\" /\\n\",\"    \\\"experiment20_consolidated_introduction_apa7_corrected.md\\\"\\n\",\")\\n\",\"\\n\",\"REFERENCE_FILE = (\\n\",\"    STEP_DIR / \\\"step_3383\\\" /\\n\",\"    \\\"experiment20_reference_list_apa7.json\\\"\\n\",\")\\n\",\"\\n\",\"OUTPUT_DIR = STEP_DIR / \\\"step_3388\\\"\\n\",\"OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"if not SOURCE.exists():\\n\",\"    raise FileNotFoundError(SOURCE)\\n\",\"\\n\",\"if not REFERENCE_FILE.exists():\\n\",\"    raise FileNotFoundError(REFERENCE_FILE)\\n\",\"\\n\",\"manuscript = SOURCE.read_text(encoding=\\\"utf-8\\\")\\n\",\"\\n\",\"with open(REFERENCE_FILE, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    reference_data = json.load(f)\\n\",\"\\n\",\"# Each pattern accepts either:\\n\",\"# Narrative: Author et al. (YEAR)\\n\",\"# Parenthetical: Author et al., YEAR\\n\",\"\\n\",\"patterns = {\\n\",\"    \\\"REF01\\\": (\\n\",\"        r\\\"Moses\\\\s+et\\\\s+al\\\\.\\\\s*\\\"\\n\",\"        r\\\"(?:\\\\(\\\\s*1994\\\\s*\\\\)|,\\\\s*1994)\\\"\\n\",\"    ),\\n\",\"    \\\"REF02\\\": (\\n\",\"        r\\\"Beveridge\\\\s+et\\\\s+al\\\\.\\\\s*\\\"\\n\",\"        r\\\"(?:\\\\(\\\\s*2009\\\\s*\\\\)|,\\\\s*2009)\\\"\\n\",\"    ),\\n\",\"    \\\"REF03\\\": (\\n\",\"        r\\\"Han\\\\s+et\\\\s+al\\\\.\\\\s*\\\"\\n\",\"        r\\\"(?:\\\\(\\\\s*2013\\\\s*\\\\)|,\\\\s*2013)\\\"\\n\",\"    ),\\n\",\"    \\\"REF04\\\": (\\n\",\"        r\\\"Ochoa-Villegas\\\\s+et\\\\s+al\\\\.\\\\s*\\\"\\n\",\"        r\\\"(?:\\\\(\\\\s*2015\\\\s*\\\\)|,\\\\s*2015)\\\"\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"reference_ids = {\\n\",\"    item[\\\"id\\\"] for item in reference_data[\\\"references\\\"]\\n\",\"}\\n\",\"\\n\",\"citation_results = {}\\n\",\"\\n\",\"for ref_id, pattern in patterns.items():\\n\",\"    matches = list(\\n\",\"        re.finditer(pattern, manuscript, flags=re.IGNORECASE)\\n\",\"    )\\n\",\"\\n\",\"    citation_results[ref_id] = {\\n\",\"        \\\"occurrences\\\": len(matches),\\n\",\"        \\\"present\\\": len(matches) > 0,\\n\",\"        \\\"reference_entry_available\\\": ref_id in reference_ids,\\n\",\"        \\\"matched_text\\\": [m.group(0) for m in matches]\\n\",\"    }\\n\",\"\\n\",\"paragraphs = [\\n\",\"    p.strip()\\n\",\"    for p in re.split(r\\\"\\\\n\\\\s*\\\\n\\\", manuscript)\\n\",\"    if p.strip()\\n\",\"]\\n\",\"\\n\",\"han_context = [\\n\",\"    p for p in paragraphs\\n\",\"    if re.search(\\n\",\"        r\\\"Han\\\\s+et\\\\s+al\\\\.,\\\\s*2013\\\",\\n\",\"        p,\\n\",\"        flags=re.IGNORECASE\\n\",\"    )\\n\",\"    and \\\"preprocessing\\\" in p.lower()\\n\",\"]\\n\",\"\\n\",\"combined_citation = bool(\\n\",\"    re.search(\\n\",\"        r\\\"\\\\(\\\\s*Han\\\\s+et\\\\s+al\\\\.,\\\\s*2013\\\\s*;\\\\s*\\\"\\n\",\"        r\\\"Ochoa-Villegas\\\\s+et\\\\s+al\\\\.,\\\\s*2015\\\\s*\\\\)\\\",\\n\",\"        manuscript,\\n\",\"        flags=re.IGNORECASE\\n\",\"    )\\n\",\")\\n\",\"\\n\",\"unused_references = [\\n\",\"    ref_id\\n\",\"    for ref_id, result in citation_results.items()\\n\",\"    if not result[\\\"present\\\"]\\n\",\"]\\n\",\"\\n\",\"# Check old Moses author format is absent.\\n\",\"old_moses_form = bool(\\n\",\"    re.search(\\n\",\"        r\\\"Moses\\\\s*,\\\\s*Adini\\\\s*,?\\\\s*and\\\\s+Ullman\\\\s*\\\\(1994\\\\)\\\",\\n\",\"        manuscript,\\n\",\"        flags=re.IGNORECASE\\n\",\"    )\\n\",\")\\n\",\"\\n\",\"# Check angular grouping description remains present.\\n\",\"angular_terms = [\\n\",\"    \\\"0°–12°\\\",\\n\",\"    \\\"13°–25°\\\",\\n\",\"    \\\"26°–50°\\\",\\n\",\"    \\\"51°–77°\\\",\\n\",\"    \\\"above 77°\\\"\\n\",\"]\\n\",\"\\n\",\"angular_description_present = all(\\n\",\"    term in manuscript for term in angular_terms\\n\",\")\\n\",\"\\n\",\"# Compare current source checksum with the checksum from Step 3.3.8.7.\\n\",\"previous_audit_file = (\\n\",\"    STEP_DIR / \\\"step_3387\\\" /\\n\",\"    \\\"experiment20_step3387_final_citation_consistency_audit.json\\\"\\n\",\")\\n\",\"\\n\",\"current_hash = hashlib.sha256(SOURCE.read_bytes()).hexdigest()\\n\",\"\\n\",\"previous_hash_check = None\\n\",\"\\n\",\"if previous_audit_file.exists():\\n\",\"    previous_audit = json.loads(\\n\",\"        previous_audit_file.read_text(encoding=\\\"utf-8\\\")\\n\",\"    )\\n\",\"    previous_hash_check = (\\n\",\"        previous_audit.get(\\\"source_manuscript_sha256\\\") == current_hash\\n\",\"    )\\n\",\"\\n\",\"checks = {\\n\",\"    \\\"moses_citation_detected\\\": citation_results[\\\"REF01\\\"][\\\"present\\\"],\\n\",\"    \\\"beveridge_citation_detected\\\": citation_results[\\\"REF02\\\"][\\\"present\\\"],\\n\",\"    \\\"han_citation_detected\\\": citation_results[\\\"REF03\\\"][\\\"present\\\"],\\n\",\"    \\\"ochoa_citation_detected\\\": citation_results[\\\"REF04\\\"][\\\"present\\\"],\\n\",\"    \\\"all_reference_entries_available\\\": all(\\n\",\"        result[\\\"reference_entry_available\\\"]\\n\",\"        for result in citation_results.values()\\n\",\"    ),\\n\",\"    \\\"no_unused_references\\\": len(unused_references) == 0,\\n\",\"    \\\"han_citation_in_preprocessing_context\\\": len(han_context) == 1,\\n\",\"    \\\"combined_parenthetical_citation_valid\\\": combined_citation,\\n\",\"    \\\"old_moses_form_removed\\\": not old_moses_form,\\n\",\"    \\\"angular_grouping_description_preserved\\\": angular_description_present,\\n\",\"    \\\"manuscript_checksum_matches_previous_audit\\\": (\\n\",\"        previous_hash_check is True\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"audit = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"step\\\": \\\"3.3.8.8\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"citation_style\\\": \\\"APA 7\\\",\\n\",\"    \\\"detector_support\\\": [\\n\",\"        \\\"Narrative author-year citations\\\",\\n\",\"        \\\"Parenthetical author-year citations\\\"\\n\",\"    ],\\n\",\"    \\\"citation_results\\\": citation_results,\\n\",\"    \\\"han_preprocessing_context_verified\\\": len(han_context) == 1,\\n\",\"    \\\"unused_references\\\": unused_references,\\n\",\"    \\\"manuscript_path\\\": str(SOURCE),\\n\",\"    \\\"manuscript_sha256\\\": current_hash,\\n\",\"    \\\"manuscript_modified\\\": False,\\n\",\"    \\\"previous_audit_checksum_match\\\": previous_hash_check,\\n\",\"    \\\"checks\\\": checks,\\n\",\"    \\\"passed_checks\\\": sum(checks.values()),\\n\",\"    \\\"total_checks\\\": len(checks),\\n\",\"    \\\"failed_checks\\\": [\\n\",\"        key for key, value in checks.items() if not value\\n\",\"    ],\\n\",\"    \\\"status\\\": (\\n\",\"        \\\"FINAL_CITATION_CONSISTENCY_VERIFIED\\\"\\n\",\"        if all(checks.values())\\n\",\"        else \\\"CITATION_CONSISTENCY_REQUIRES_REVIEW\\\"\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"OUTPUT_FILE = (\\n\",\"    OUTPUT_DIR /\\n\",\"    \\\"experiment20_step3388_final_apa7_citation_audit.json\\\"\\n\",\")\\n\",\"\\n\",\"with open(OUTPUT_FILE, \\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    json.dump(audit, f, indent=2, ensure_ascii=False)\\n\",\"\\n\",\"reloaded = json.loads(\\n\",\"    OUTPUT_FILE.read_text(encoding=\\\"utf-8\\\")\\n\",\")\\n\",\"\\n\",\"assert reloaded == audit\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.3.8.8\\\")\\n\",\"print(\\\"FINAL APA 7 CITATION CONSISTENCY AUDIT\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"print(\\\"\\\\nCitation detection:\\\")\\n\",\"\\n\",\"for ref_id, result in citation_results.items():\\n\",\"    print(\\n\",\"        f\\\"{ref_id}: {'PASS' if result['present'] else 'FAIL'} \\\"\\n\",\"        f\\\"| Occurrences: {result['occurrences']} \\\"\\n\",\"        f\\\"| Matches: {result['matched_text']}\\\"\\n\",\"    )\\n\",\"\\n\",\"print(\\\"\\\\nHan preprocessing context:\\\",\\n\",\"      \\\"PASS\\\" if len(han_context) == 1 else \\\"FAIL\\\")\\n\",\"\\n\",\"print(\\\"Combined parenthetical citation:\\\",\\n\",\"      \\\"PASS\\\" if combined_citation else \\\"FAIL\\\")\\n\",\"\\n\",\"print(\\\"Unused references:\\\", unused_references)\\n\",\"\\n\",\"print(\\\"\\\\nConsistency checks:\\\")\\n\",\"\\n\",\"for name, passed in checks.items():\\n\",\"    print(f\\\"{name}: {'PASS' if passed else 'FAIL'}\\\")\\n\",\"\\n\",\"print(f\\\"\\\\nPassed: {audit['passed_checks']} / {audit['total_checks']}\\\")\\n\",\"print(\\\"Failed:\\\", len(audit[\\\"failed_checks\\\"]))\\n\",\"print(\\\"Manuscript modified:\\\", audit[\\\"manuscript_modified\\\"])\\n\",\"print(\\\"Status:\\\", audit[\\\"status\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nAudit JSON reload: PASS\\\")\\n\",\"print(\\\"Manuscript SHA256:\\\", current_hash)\\n\",\"print(\\\"Saved:\\\", OUTPUT_FILE)\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"s9nsgL7-JB6s\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794392730508,\"user_tz\":360,\"elapsed\":426,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"c5218b84-6c0c-460b-c8ff-e25c1c7a850f\"},\"execution_count\":65,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.3.8.8\\n\",\"FINAL APA 7 CITATION CONSISTENCY AUDIT\\n\",\"========================================================================================\\n\",\"\\n\",\"Citation detection:\\n\",\"REF01: PASS | Occurrences: 1 | Matches: ['Moses et al. (1994)']\\n\",\"REF02: PASS | Occurrences: 1 | Matches: ['Beveridge et al. (2009)']\\n\",\"REF03: PASS | Occurrences: 1 | Matches: ['Han et al., 2013']\\n\",\"REF04: PASS | Occurrences: 2 | Matches: ['Ochoa-Villegas et al., 2015', 'Ochoa-Villegas et al. (2015)']\\n\",\"\\n\",\"Han preprocessing context: PASS\\n\",\"Combined parenthetical citation: PASS\\n\",\"Unused references: []\\n\",\"\\n\",\"Consistency checks:\\n\",\"moses_citation_detected: PASS\\n\",\"beveridge_citation_detected: PASS\\n\",\"han_citation_detected: PASS\\n\",\"ochoa_citation_detected: PASS\\n\",\"all_reference_entries_available: PASS\\n\",\"no_unused_references: PASS\\n\",\"han_citation_in_preprocessing_context: PASS\\n\",\"combined_parenthetical_citation_valid: PASS\\n\",\"old_moses_form_removed: PASS\\n\",\"angular_grouping_description_preserved: PASS\\n\",\"manuscript_checksum_matches_previous_audit: PASS\\n\",\"\\n\",\"Passed: 11 / 11\\n\",\"Failed: 0\\n\",\"Manuscript modified: False\\n\",\"Status: FINAL_CITATION_CONSISTENCY_VERIFIED\\n\",\"\\n\",\"Audit JSON reload: PASS\\n\",\"Manuscript SHA256: ca3ab908d847959898ace51269ca4ecf5f0103e86cd5d4cc03d2dd1f0c95166f\\n\",\"Saved: /content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3388/experiment20_step3388_final_apa7_citation_audit.json\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.3.9.1\\n\",\"## Methodology: Research Design and Experimental Overview\\n\",\"\\n\",\"This subsection establishes the research design, analytical framework, evaluation population, and scope of the experiment.\\n\",\"\\n\",\"The manuscript will describe the work as a descriptive empirical investigation of reference-relative face-embedding displacement across illumination geometry conditions. The text must distinguish the experimental observations from operational drift detection, biometric recognition performance, and causal claims about illumination.\"],\"metadata\":{\"id\":\"JTXVuD2aJaHW\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"import re\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"STEP_DIR = BASE / \\\"step_3_3\\\"\\n\",\"OUTPUT_DIR = STEP_DIR / \\\"step_3391\\\"\\n\",\"OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"# Methodology subsection draft\\n\",\"section_title = \\\"3.1 Research Design and Experimental Overview\\\"\\n\",\"\\n\",\"section_text = \\\"\\\"\\\"\\n\",\"Experiment 20 employed a descriptive empirical design to examine reference-relative displacement in deep face-recognition embeddings across illumination geometry conditions. The analysis focused on the extent to which the embedding representation of an identity's facial image differed from that identity's embedding under a designated reference illumination condition. Rather than developing or evaluating an operational drift-detection algorithm, the experiment characterised these differences using two distance measures: Euclidean displacement and cosine distance.\\n\",\"\\n\",\"The evaluation used the Cropped Extended Yale B dataset, comprising 2,414 standard-illumination images from 38 identities. A common-condition selection procedure identified 57 illumination conditions represented across all 38 identities, yielding 2,166 identity-condition observations. One observation per identity corresponded to the designated reference condition, A+000E+00. These 38 reference observations were used to establish the identity-specific reference embeddings. After excluding the reference condition, the primary evaluation comprised 2,128 non-reference observations across 56 illumination conditions.\\n\",\"\\n\",\"The primary unit of observation was an identity-condition pair, while identity served as the repeated-measures unit for group-level statistical comparisons. This structure allowed displacement measurements from the same 38 identities to be examined across near-frontal, oblique, and large-angular-deviation illumination groups. The observations represent identity-condition-matched captures under different illumination conditions; they are not pairs produced by applying controlled transformations to identical source images.\\n\",\"\\n\",\"The analysis was conducted using 512-dimensional embeddings generated by a fixed pretrained InceptionResnetV1 model with VGGFace2 weights. Each evaluation embedding was compared with the corresponding identity's reference embedding. Euclidean displacement and cosine distance were then summarised across illumination geometry groups and examined using identity-level repeated-measures statistical procedures.\\n\",\"\\n\",\"The study was intentionally restricted to descriptive embedding-space analysis. It did not estimate calibrated detection thresholds, operational false-alarm rates, or recognition accuracy. It also did not evaluate an independent face-recognition architecture. Consequently, the results characterise reference-relative embedding displacement within the selected dataset, preprocessing procedure, and pretrained model; they do not establish that illumination alone caused the observed differences or that the findings generalise to other recognition systems.\\n\",\"\\\"\\\"\\\".strip()\\n\",\"\\n\",\"# Core facts to be checked against the frozen protocol.\\n\",\"expected_facts = {\\n\",\"    \\\"dataset\\\": \\\"Cropped Extended Yale B\\\",\\n\",\"    \\\"source_images\\\": 2414,\\n\",\"    \\\"identities\\\": 38,\\n\",\"    \\\"common_conditions\\\": 57,\\n\",\"    \\\"common_condition_observations\\\": 2166,\\n\",\"    \\\"reference_condition\\\": \\\"A+000E+00\\\",\\n\",\"    \\\"reference_observations\\\": 38,\\n\",\"    \\\"evaluation_conditions\\\": 56,\\n\",\"    \\\"evaluation_observations\\\": 2128,\\n\",\"    \\\"embedding_dimension\\\": 512,\\n\",\"    \\\"model\\\": \\\"InceptionResnetV1\\\",\\n\",\"    \\\"pretrained_weights\\\": \\\"VGGFace2\\\",\\n\",\"    \\\"analysis_type\\\": \\\"descriptive empirical analysis\\\"\\n\",\"}\\n\",\"\\n\",\"checks = {\\n\",\"    \\\"descriptive_empirical_design_stated\\\":\\n\",\"        \\\"descriptive empirical design\\\" in section_text,\\n\",\"    \\\"dataset_name_stated\\\":\\n\",\"        expected_facts[\\\"dataset\\\"] in section_text,\\n\",\"    \\\"2414_source_images_stated\\\":\\n\",\"        \\\"2,414\\\" in section_text,\\n\",\"    \\\"38_identities_stated\\\":\\n\",\"        \\\"38 identities\\\" in section_text,\\n\",\"    \\\"2166_common_observations_stated\\\":\\n\",\"        \\\"2,166\\\" in section_text,\\n\",\"    \\\"57_common_conditions_stated\\\":\\n\",\"        \\\"57 illumination conditions\\\" in section_text,\\n\",\"    \\\"reference_condition_stated\\\":\\n\",\"        expected_facts[\\\"reference_condition\\\"] in section_text,\\n\",\"    \\\"2128_evaluation_observations_stated\\\":\\n\",\"        \\\"2,128\\\" in section_text,\\n\",\"    \\\"56_evaluation_conditions_stated\\\":\\n\",\"        \\\"56 illumination conditions\\\" in section_text,\\n\",\"    \\\"repeated_measures_unit_identified\\\":\\n\",\"        \\\"identity served as the repeated-measures unit\\\" in section_text,\\n\",\"    \\\"different_capture_limitation_stated\\\":\\n\",\"        \\\"not pairs produced by applying controlled transformations\\\" in section_text,\\n\",\"    \\\"embedding_dimension_stated\\\":\\n\",\"        \\\"512-dimensional embeddings\\\" in section_text,\\n\",\"    \\\"model_and_weights_stated\\\":\\n\",\"        \\\"InceptionResnetV1 model with VGGFace2 weights\\\" in section_text,\\n\",\"    \\\"euclidean_and_cosine_metrics_stated\\\":\\n\",\"        \\\"Euclidean displacement and cosine distance\\\" in section_text,\\n\",\"    \\\"no_operational_detection_claim\\\":\\n\",\"        \\\"operational false-alarm rates\\\" in section_text,\\n\",\"    \\\"no_recognition_accuracy_claim\\\":\\n\",\"        \\\"recognition accuracy\\\" in section_text,\\n\",\"    \\\"no_independent_architecture_claim\\\":\\n\",\"        \\\"independent face-recognition architecture\\\" in section_text\\n\",\"}\\n\",\"\\n\",\"word_count = len(re.findall(r\\\"\\\\b[\\\\w'-]+\\\\b\\\", section_text))\\n\",\"\\n\",\"markdown_content = f\\\"# {section_title}\\\\n\\\\n{section_text}\\\\n\\\"\\n\",\"\\n\",\"markdown_path = OUTPUT_DIR / \\\"experiment20_methodology_3_1_research_design.md\\\"\\n\",\"json_path = OUTPUT_DIR / \\\"experiment20_step3391_research_design.json\\\"\\n\",\"audit_path = OUTPUT_DIR / \\\"experiment20_step3391_research_design_audit.json\\\"\\n\",\"\\n\",\"markdown_path.write_text(markdown_content, encoding=\\\"utf-8\\\")\\n\",\"\\n\",\"record = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"phase\\\": \\\"3.3\\\",\\n\",\"    \\\"step\\\": \\\"3.3.9.1\\\",\\n\",\"    \\\"subsection\\\": section_title,\\n\",\"    \\\"created_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"research_design\\\": \\\"Descriptive empirical analysis\\\",\\n\",\"    \\\"draft_text\\\": section_text,\\n\",\"    \\\"verified_protocol_facts\\\": expected_facts,\\n\",\"    \\\"word_count\\\": word_count,\\n\",\"    \\\"checks\\\": checks,\\n\",\"    \\\"passed_checks\\\": sum(checks.values()),\\n\",\"    \\\"total_checks\\\": len(checks),\\n\",\"    \\\"failed_checks\\\": [\\n\",\"        name for name, passed in checks.items() if not passed\\n\",\"    ],\\n\",\"    \\\"status\\\": (\\n\",\"        \\\"DRAFT_CONSISTENCY_CHECK_PASSED\\\"\\n\",\"        if all(checks.values())\\n\",\"        else \\\"DRAFT_REQUIRES_REVIEW\\\"\\n\",\"    ),\\n\",\"    \\\"limitations_preserved\\\": [\\n\",\"        \\\"Different captures across illumination conditions, not exact source-image transformations\\\",\\n\",\"        \\\"Descriptive embedding displacement, not operational drift detection\\\",\\n\",\"        \\\"No recognition-accuracy evaluation\\\",\\n\",\"        \\\"No independent architecture evaluation\\\",\\n\",\"        \\\"No causal attribution to illumination alone\\\"\\n\",\"    ]\\n\",\"}\\n\",\"\\n\",\"json_path.write_text(\\n\",\"    json.dumps(record, indent=2, ensure_ascii=False),\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\")\\n\",\"\\n\",\"audit = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"step\\\": \\\"3.3.9.1\\\",\\n\",\"    \\\"created_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"word_count\\\": word_count,\\n\",\"    \\\"checks\\\": checks,\\n\",\"    \\\"passed_checks\\\": sum(checks.values()),\\n\",\"    \\\"total_checks\\\": len(checks),\\n\",\"    \\\"failed_checks\\\": record[\\\"failed_checks\\\"],\\n\",\"    \\\"status\\\": record[\\\"status\\\"],\\n\",\"    \\\"files\\\": {\\n\",\"        \\\"markdown\\\": str(markdown_path),\\n\",\"        \\\"json\\\": str(json_path)\\n\",\"    }\\n\",\"}\\n\",\"\\n\",\"audit_path.write_text(\\n\",\"    json.dumps(audit, indent=2, ensure_ascii=False),\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\")\\n\",\"\\n\",\"# Reload and verify saved artifacts.\\n\",\"reloaded_markdown = markdown_path.read_text(encoding=\\\"utf-8\\\")\\n\",\"reloaded_record = json.loads(json_path.read_text(encoding=\\\"utf-8\\\"))\\n\",\"reloaded_audit = json.loads(audit_path.read_text(encoding=\\\"utf-8\\\"))\\n\",\"\\n\",\"assert reloaded_markdown == markdown_content\\n\",\"assert reloaded_record == record\\n\",\"assert reloaded_audit == audit\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.3.9.1\\\")\\n\",\"print(\\\"RESEARCH DESIGN AND EXPERIMENTAL OVERVIEW\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"print(\\\"\\\\nWord count:\\\", word_count)\\n\",\"print(\\\"\\\\nConsistency checks:\\\")\\n\",\"\\n\",\"for name, passed in checks.items():\\n\",\"    print(f\\\"{name}: {'PASS' if passed else 'FAIL'}\\\")\\n\",\"\\n\",\"print(f\\\"\\\\nPassed: {record['passed_checks']} / {record['total_checks']}\\\")\\n\",\"print(\\\"Failed:\\\", len(record[\\\"failed_checks\\\"]))\\n\",\"print(\\\"Status:\\\", record[\\\"status\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nMarkdown reload: PASS\\\")\\n\",\"print(\\\"JSON reload: PASS\\\")\\n\",\"print(\\\"Audit reload: PASS\\\")\\n\",\"\\n\",\"print(\\\"\\\\nSaved files:\\\")\\n\",\"print(markdown_path)\\n\",\"print(json_path)\\n\",\"print(audit_path)\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 88)\\n\",\"print(\\\"DRAFT TEXT\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(markdown_content)\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"N52bezTXJdgH\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794392843400,\"user_tz\":360,\"elapsed\":280,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"eb20eac2-42d5-45ad-b5d6-f117466f02e2\"},\"execution_count\":66,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.3.9.1\\n\",\"RESEARCH DESIGN AND EXPERIMENTAL OVERVIEW\\n\",\"========================================================================================\\n\",\"\\n\",\"Word count: 322\\n\",\"\\n\",\"Consistency checks:\\n\",\"descriptive_empirical_design_stated: PASS\\n\",\"dataset_name_stated: PASS\\n\",\"2414_source_images_stated: PASS\\n\",\"38_identities_stated: PASS\\n\",\"2166_common_observations_stated: PASS\\n\",\"57_common_conditions_stated: PASS\\n\",\"reference_condition_stated: PASS\\n\",\"2128_evaluation_observations_stated: PASS\\n\",\"56_evaluation_conditions_stated: PASS\\n\",\"repeated_measures_unit_identified: PASS\\n\",\"different_capture_limitation_stated: PASS\\n\",\"embedding_dimension_stated: PASS\\n\",\"model_and_weights_stated: PASS\\n\",\"euclidean_and_cosine_metrics_stated: PASS\\n\",\"no_operational_detection_claim: PASS\\n\",\"no_recognition_accuracy_claim: PASS\\n\",\"no_independent_architecture_claim: PASS\\n\",\"\\n\",\"Passed: 17 / 17\\n\",\"Failed: 0\\n\",\"Status: DRAFT_CONSISTENCY_CHECK_PASSED\\n\",\"\\n\",\"Markdown reload: PASS\\n\",\"JSON reload: PASS\\n\",\"Audit reload: PASS\\n\",\"\\n\",\"Saved files:\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3391/experiment20_methodology_3_1_research_design.md\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3391/experiment20_step3391_research_design.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3391/experiment20_step3391_research_design_audit.json\\n\",\"\\n\",\"========================================================================================\\n\",\"DRAFT TEXT\\n\",\"========================================================================================\\n\",\"# 3.1 Research Design and Experimental Overview\\n\",\"\\n\",\"Experiment 20 employed a descriptive empirical design to examine reference-relative displacement in deep face-recognition embeddings across illumination geometry conditions. The analysis focused on the extent to which the embedding representation of an identity's facial image differed from that identity's embedding under a designated reference illumination condition. Rather than developing or evaluating an operational drift-detection algorithm, the experiment characterised these differences using two distance measures: Euclidean displacement and cosine distance.\\n\",\"\\n\",\"The evaluation used the Cropped Extended Yale B dataset, comprising 2,414 standard-illumination images from 38 identities. A common-condition selection procedure identified 57 illumination conditions represented across all 38 identities, yielding 2,166 identity-condition observations. One observation per identity corresponded to the designated reference condition, A+000E+00. These 38 reference observations were used to establish the identity-specific reference embeddings. After excluding the reference condition, the primary evaluation comprised 2,128 non-reference observations across 56 illumination conditions.\\n\",\"\\n\",\"The primary unit of observation was an identity-condition pair, while identity served as the repeated-measures unit for group-level statistical comparisons. This structure allowed displacement measurements from the same 38 identities to be examined across near-frontal, oblique, and large-angular-deviation illumination groups. The observations represent identity-condition-matched captures under different illumination conditions; they are not pairs produced by applying controlled transformations to identical source images.\\n\",\"\\n\",\"The analysis was conducted using 512-dimensional embeddings generated by a fixed pretrained InceptionResnetV1 model with VGGFace2 weights. Each evaluation embedding was compared with the corresponding identity's reference embedding. Euclidean displacement and cosine distance were then summarised across illumination geometry groups and examined using identity-level repeated-measures statistical procedures.\\n\",\"\\n\",\"The study was intentionally restricted to descriptive embedding-space analysis. It did not estimate calibrated detection thresholds, operational false-alarm rates, or recognition accuracy. It also did not evaluate an independent face-recognition architecture. Consequently, the results characterise reference-relative embedding displacement within the selected dataset, preprocessing procedure, and pretrained model; they do not establish that illumination alone caused the observed differences or that the findings generalise to other recognition systems.\\n\",\"\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.3.9.2\\n\",\"## Methodology: Dataset and Acquisition Provenance\\n\",\"\\n\",\"This subsection documents the dataset source, acquisition procedure, image composition, condition coverage, integrity checks, and provenance limitations.\\n\",\"\\n\",\"The dataset is the Cropped Extended Yale B frontal-pose illumination subset. It must not be described as the complete multi-pose Extended Yale B dataset.\\n\",\"\\n\",\"The acquisition record identifies a community-hosted Academic Torrents listing as the source. The archive passed ZIP integrity testing and its SHA-256 checksum was recorded. However, the archive was not independently authenticated against an official UCSD checksum.\\n\",\"\\n\",\"The dataset composition must distinguish all decoded PGM images, the standard-illumination images retained for analysis, the excluded ambient reference images, and the common-condition subset.\"],\"metadata\":{\"id\":\"z8HRQZ_wJpXc\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"import re\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"STEP_DIR = BASE / \\\"step_3_3\\\"\\n\",\"OUTPUT_DIR = STEP_DIR / \\\"step_3392\\\"\\n\",\"OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"section_title = \\\"3.2 Dataset and Acquisition Provenance\\\"\\n\",\"\\n\",\"section_text = \\\"\\\"\\\"\\n\",\"The external evaluation dataset used in Experiment 20 was the Cropped Extended Yale B frontal-pose illumination subset. It contains cropped grayscale facial images captured under different illumination conditions for 38 identities. This subset should be distinguished from the complete multi-pose Extended Yale B dataset.\\n\",\"\\n\",\"The dataset archive was acquired through a community-hosted Academic Torrents listing. The acquisition record identifies the source listing and records an archive size of 58,493,820 bytes. The downloaded ZIP archive passed its integrity test and contained 2,586 members. Its SHA-256 checksum was recorded as 8bbabf3836d077d60626c9ee3c54c2d2851a8d2c15c8b7e13b9bc162e86ea573. The archive provenance remains subject to an important limitation: it was not independently authenticated against an official UCSD checksum. Accordingly, the acquisition record and checksum provide traceability for the downloaded archive but do not establish official dataset authenticity.\\n\",\"\\n\",\"The archive contained 2,452 PGM image files, all of which were successfully decoded during the image-integrity audit. Filename and condition validation identified 2,414 standard-illumination images and 38 ambient reference images. The ambient images were excluded from the standard-illumination analysis. The retained standard-illumination images represented 64 distinct illumination conditions across the 38 identities. Seven identities did not contain every condition in the overall set.\\n\",\"\\n\",\"To support comparisons with complete identity coverage, the analysis used the 57 illumination conditions shared by all 38 identities. This common-condition subset comprised 2,166 identity-condition observations. The remaining conditions that were not shared by every identity were not included in analyses requiring complete identity-condition coverage. One observation per identity corresponded to the reference condition, A+000E+00; after its exclusion, 2,128 non-reference observations across 56 conditions formed the primary evaluation cohort.\\n\",\"\\n\",\"The dataset was frozen for the Stage 2 analysis, with acquisition records, image-integrity results, condition manifests, embedding artifacts, and associated checksums retained in the project archive. These records support reproducibility and traceability of the analysed cohort. They do not remove the limitation arising from the community-hosted source or establish authentication against an official dataset checksum.\\n\",\"\\\"\\\"\\\".strip()\\n\",\"\\n\",\"# Explicit facts from the acquisition and frozen dataset records.\\n\",\"facts = {\\n\",\"    \\\"dataset\\\": \\\"Cropped Extended Yale B\\\",\\n\",\"    \\\"subset\\\": \\\"frontal-pose illumination subset\\\",\\n\",\"    \\\"source\\\": \\\"Community-hosted Academic Torrents listing\\\",\\n\",\"    \\\"archive_size_bytes\\\": 58493820,\\n\",\"    \\\"zip_member_count\\\": 2586,\\n\",\"    \\\"archive_sha256\\\": \\\"8bbabf3836d077d60626c9ee3c54c2d2851a8d2c15c8b7e13b9bc162e86ea573\\\",\\n\",\"    \\\"total_pgm_files\\\": 2452,\\n\",\"    \\\"successfully_decoded_pgm_files\\\": 2452,\\n\",\"    \\\"standard_illumination_images\\\": 2414,\\n\",\"    \\\"ambient_reference_images_excluded\\\": 38,\\n\",\"    \\\"identities\\\": 38,\\n\",\"    \\\"overall_illumination_conditions\\\": 64,\\n\",\"    \\\"common_illumination_conditions\\\": 57,\\n\",\"    \\\"common_condition_observations\\\": 2166,\\n\",\"    \\\"incomplete_identities\\\": 7,\\n\",\"    \\\"reference_condition\\\": \\\"A+000E+00\\\",\\n\",\"    \\\"reference_observations\\\": 38,\\n\",\"    \\\"evaluation_conditions\\\": 56,\\n\",\"    \\\"evaluation_observations\\\": 2128,\\n\",\"    \\\"official_ucsd_checksum_authenticated\\\": False\\n\",\"}\\n\",\"\\n\",\"checks = {\\n\",\"    \\\"correct_dataset_subset_named\\\":\\n\",\"        \\\"Cropped Extended Yale B frontal-pose illumination subset\\\" in section_text,\\n\",\"    \\\"community_hosted_source_disclosed\\\":\\n\",\"        \\\"community-hosted Academic Torrents listing\\\" in section_text,\\n\",\"    \\\"archive_size_correct\\\":\\n\",\"        \\\"58,493,820 bytes\\\" in section_text,\\n\",\"    \\\"archive_member_count_correct\\\":\\n\",\"        \\\"2,586 members\\\" in section_text,\\n\",\"    \\\"archive_sha256_correct\\\":\\n\",\"        facts[\\\"archive_sha256\\\"] in section_text,\\n\",\"    \\\"official_checksum_limitation_disclosed\\\":\\n\",\"        \\\"not independently authenticated against an official UCSD checksum\\\" in section_text,\\n\",\"    \\\"all_decoded_pgm_files_reported\\\":\\n\",\"        \\\"2,452 PGM image files, all of which were successfully decoded\\\" in section_text,\\n\",\"    \\\"standard_and_ambient_counts_distinguished\\\":\\n\",\"        \\\"2,414 standard-illumination images and 38 ambient reference images\\\" in section_text,\\n\",\"    \\\"ambient_images_exclusion_stated\\\":\\n\",\"        \\\"ambient images were excluded\\\" in section_text,\\n\",\"    \\\"overall_condition_count_correct\\\":\\n\",\"        \\\"64 distinct illumination conditions\\\" in section_text,\\n\",\"    \\\"common_condition_count_correct\\\":\\n\",\"        \\\"57 illumination conditions shared by all 38 identities\\\" in section_text,\\n\",\"    \\\"common_observation_count_correct\\\":\\n\",\"        \\\"2,166 identity-condition observations\\\" in section_text,\\n\",\"    \\\"incomplete_identity_count_correct\\\":\\n\",\"        \\\"Seven identities\\\" in section_text,\\n\",\"    \\\"reference_and_evaluation_counts_correct\\\":\\n\",\"        \\\"2,128 non-reference observations across 56 conditions\\\" in section_text,\\n\",\"    \\\"not_misrepresented_as_complete_dataset\\\":\\n\",\"        \\\"complete multi-pose Extended Yale B dataset\\\" in section_text\\n\",\"}\\n\",\"\\n\",\"word_count = len(re.findall(r\\\"\\\\b[\\\\w'-]+\\\\b\\\", section_text))\\n\",\"\\n\",\"markdown_content = f\\\"# {section_title}\\\\n\\\\n{section_text}\\\\n\\\"\\n\",\"\\n\",\"markdown_path = OUTPUT_DIR / \\\"experiment20_methodology_3_2_dataset_provenance.md\\\"\\n\",\"json_path = OUTPUT_DIR / \\\"experiment20_step3392_dataset_provenance.json\\\"\\n\",\"audit_path = OUTPUT_DIR / \\\"experiment20_step3392_dataset_provenance_audit.json\\\"\\n\",\"\\n\",\"markdown_path.write_text(markdown_content, encoding=\\\"utf-8\\\")\\n\",\"\\n\",\"record = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"phase\\\": \\\"3.3\\\",\\n\",\"    \\\"step\\\": \\\"3.3.9.2\\\",\\n\",\"    \\\"subsection\\\": section_title,\\n\",\"    \\\"created_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"draft_text\\\": section_text,\\n\",\"    \\\"verified_dataset_facts\\\": facts,\\n\",\"    \\\"word_count\\\": word_count,\\n\",\"    \\\"checks\\\": checks,\\n\",\"    \\\"passed_checks\\\": sum(checks.values()),\\n\",\"    \\\"total_checks\\\": len(checks),\\n\",\"    \\\"failed_checks\\\": [\\n\",\"        key for key, passed in checks.items() if not passed\\n\",\"    ],\\n\",\"    \\\"status\\\": (\\n\",\"        \\\"DRAFT_CONSISTENCY_CHECK_PASSED\\\"\\n\",\"        if all(checks.values())\\n\",\"        else \\\"DRAFT_REQUIRES_REVIEW\\\"\\n\",\"    ),\\n\",\"    \\\"provenance_limitations\\\": [\\n\",\"        \\\"Community-hosted Academic Torrents source\\\",\\n\",\"        \\\"No independent official UCSD checksum authentication\\\",\\n\",\"        \\\"Cropped frontal-pose subset rather than complete multi-pose dataset\\\"\\n\",\"    ]\\n\",\"}\\n\",\"\\n\",\"json_path.write_text(\\n\",\"    json.dumps(record, indent=2, ensure_ascii=False),\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\")\\n\",\"\\n\",\"audit = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"step\\\": \\\"3.3.9.2\\\",\\n\",\"    \\\"created_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"word_count\\\": word_count,\\n\",\"    \\\"checks\\\": checks,\\n\",\"    \\\"passed_checks\\\": sum(checks.values()),\\n\",\"    \\\"total_checks\\\": len(checks),\\n\",\"    \\\"failed_checks\\\": record[\\\"failed_checks\\\"],\\n\",\"    \\\"status\\\": record[\\\"status\\\"],\\n\",\"    \\\"files\\\": {\\n\",\"        \\\"markdown\\\": str(markdown_path),\\n\",\"        \\\"json\\\": str(json_path)\\n\",\"    }\\n\",\"}\\n\",\"\\n\",\"audit_path.write_text(\\n\",\"    json.dumps(audit, indent=2, ensure_ascii=False),\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\")\\n\",\"\\n\",\"# Reload and verify all three saved files.\\n\",\"assert markdown_path.read_text(encoding=\\\"utf-8\\\") == markdown_content\\n\",\"assert json.loads(json_path.read_text(encoding=\\\"utf-8\\\")) == record\\n\",\"assert json.loads(audit_path.read_text(encoding=\\\"utf-8\\\")) == audit\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.3.9.2\\\")\\n\",\"print(\\\"DATASET AND ACQUISITION PROVENANCE\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"print(\\\"\\\\nWord count:\\\", word_count)\\n\",\"\\n\",\"print(\\\"\\\\nConsistency checks:\\\")\\n\",\"for name, passed in checks.items():\\n\",\"    print(f\\\"{name}: {'PASS' if passed else 'FAIL'}\\\")\\n\",\"\\n\",\"print(f\\\"\\\\nPassed: {record['passed_checks']} / {record['total_checks']}\\\")\\n\",\"print(\\\"Failed:\\\", len(record[\\\"failed_checks\\\"]))\\n\",\"print(\\\"Status:\\\", record[\\\"status\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nMarkdown reload: PASS\\\")\\n\",\"print(\\\"JSON reload: PASS\\\")\\n\",\"print(\\\"Audit reload: PASS\\\")\\n\",\"\\n\",\"print(\\\"\\\\nSaved files:\\\")\\n\",\"print(markdown_path)\\n\",\"print(json_path)\\n\",\"print(audit_path)\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 88)\\n\",\"print(\\\"DRAFT TEXT\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(markdown_content)\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"lkYX4k0LJrgL\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794392900909,\"user_tz\":360,\"elapsed\":141,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"5245a0c5-8d28-4b17-d775-43f58a225474\"},\"execution_count\":67,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.3.9.2\\n\",\"DATASET AND ACQUISITION PROVENANCE\\n\",\"========================================================================================\\n\",\"\\n\",\"Word count: 323\\n\",\"\\n\",\"Consistency checks:\\n\",\"correct_dataset_subset_named: PASS\\n\",\"community_hosted_source_disclosed: PASS\\n\",\"archive_size_correct: PASS\\n\",\"archive_member_count_correct: PASS\\n\",\"archive_sha256_correct: PASS\\n\",\"official_checksum_limitation_disclosed: PASS\\n\",\"all_decoded_pgm_files_reported: PASS\\n\",\"standard_and_ambient_counts_distinguished: PASS\\n\",\"ambient_images_exclusion_stated: PASS\\n\",\"overall_condition_count_correct: PASS\\n\",\"common_condition_count_correct: PASS\\n\",\"common_observation_count_correct: PASS\\n\",\"incomplete_identity_count_correct: PASS\\n\",\"reference_and_evaluation_counts_correct: PASS\\n\",\"not_misrepresented_as_complete_dataset: PASS\\n\",\"\\n\",\"Passed: 15 / 15\\n\",\"Failed: 0\\n\",\"Status: DRAFT_CONSISTENCY_CHECK_PASSED\\n\",\"\\n\",\"Markdown reload: PASS\\n\",\"JSON reload: PASS\\n\",\"Audit reload: PASS\\n\",\"\\n\",\"Saved files:\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3392/experiment20_methodology_3_2_dataset_provenance.md\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3392/experiment20_step3392_dataset_provenance.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3392/experiment20_step3392_dataset_provenance_audit.json\\n\",\"\\n\",\"========================================================================================\\n\",\"DRAFT TEXT\\n\",\"========================================================================================\\n\",\"# 3.2 Dataset and Acquisition Provenance\\n\",\"\\n\",\"The external evaluation dataset used in Experiment 20 was the Cropped Extended Yale B frontal-pose illumination subset. It contains cropped grayscale facial images captured under different illumination conditions for 38 identities. This subset should be distinguished from the complete multi-pose Extended Yale B dataset.\\n\",\"\\n\",\"The dataset archive was acquired through a community-hosted Academic Torrents listing. The acquisition record identifies the source listing and records an archive size of 58,493,820 bytes. The downloaded ZIP archive passed its integrity test and contained 2,586 members. Its SHA-256 checksum was recorded as 8bbabf3836d077d60626c9ee3c54c2d2851a8d2c15c8b7e13b9bc162e86ea573. The archive provenance remains subject to an important limitation: it was not independently authenticated against an official UCSD checksum. Accordingly, the acquisition record and checksum provide traceability for the downloaded archive but do not establish official dataset authenticity.\\n\",\"\\n\",\"The archive contained 2,452 PGM image files, all of which were successfully decoded during the image-integrity audit. Filename and condition validation identified 2,414 standard-illumination images and 38 ambient reference images. The ambient images were excluded from the standard-illumination analysis. The retained standard-illumination images represented 64 distinct illumination conditions across the 38 identities. Seven identities did not contain every condition in the overall set.\\n\",\"\\n\",\"To support comparisons with complete identity coverage, the analysis used the 57 illumination conditions shared by all 38 identities. This common-condition subset comprised 2,166 identity-condition observations. The remaining conditions that were not shared by every identity were not included in analyses requiring complete identity-condition coverage. One observation per identity corresponded to the reference condition, A+000E+00; after its exclusion, 2,128 non-reference observations across 56 conditions formed the primary evaluation cohort.\\n\",\"\\n\",\"The dataset was frozen for the Stage 2 analysis, with acquisition records, image-integrity results, condition manifests, embedding artifacts, and associated checksums retained in the project archive. These records support reproducibility and traceability of the analysed cohort. They do not remove the limitation arising from the community-hosted source or establish authentication against an official dataset checksum.\\n\",\"\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.3.9.3\\n\",\"## Methodology: Subject Selection and Illumination-Condition Coverage\\n\",\"\\n\",\"This subsection describes the identity cohort, common-condition selection, reference-condition assignment, and construction of the evaluation observations.\\n\",\"\\n\",\"The analysis included 38 identities. Although the standard-illumination dataset contained 64 distinct conditions, only 57 were represented for every identity. The common-condition subset was therefore used to maintain complete identity coverage.\\n\",\"\\n\",\"The reference condition, A+000E+00, contributed one reference observation per identity. The remaining 56 conditions formed the evaluation set. The resulting design contained 38 reference observations and 2,128 non-reference evaluation observations.\\n\",\"\\n\",\"The three illumination geometry groups were assigned using the frozen condition manifest. The groups describe the angular deviation of the light-source direction and should not be interpreted as measured illumination intensity.\"],\"metadata\":{\"id\":\"wDb16jB0J13a\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"import re\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"STEP_DIR = BASE / \\\"step_3_3\\\"\\n\",\"OUTPUT_DIR = STEP_DIR / \\\"step_3393\\\"\\n\",\"OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"section_title = \\\"3.3 Subject Selection and Illumination-Condition Coverage\\\"\\n\",\"\\n\",\"section_text = \\\"\\\"\\\"\\n\",\"The subject cohort comprised 38 identities represented in the Cropped Extended Yale B frontal-pose illumination subset. The standard-illumination image collection contained 64 distinct illumination conditions across the cohort; however, not every condition was available for every identity. Seven identities had incomplete condition coverage. To preserve a consistent identity set across the primary condition-based comparisons, the analysis retained only conditions represented for all 38 identities.\\n\",\"\\n\",\"This complete-case condition selection produced 57 common illumination conditions and 2,166 identity-condition observations, corresponding to 38 observations for each condition. The selection was based on shared condition availability rather than on embedding displacement values or statistical outcomes. Conditions not represented across all 38 identities were excluded from analyses requiring complete identity-condition coverage.\\n\",\"\\n\",\"The condition A+000E+00 was designated as the reference condition. One reference observation was available for each of the 38 identities, providing an identity-specific reference embedding. The reference observations were retained for calculating reference-relative distances but excluded from the non-reference evaluation set. Consequently, the primary evaluation comprised the remaining 56 common conditions and 2,128 identity-condition observations.\\n\",\"\\n\",\"The 56 non-reference conditions were assigned to three illumination geometry groups using the frozen condition-grouping manifest: near-frontal, oblique, and large-angular-deviation. The corresponding evaluation counts were 17, 11, and 28 conditions, respectively, representing 646, 418, and 1,064 observations. The reference condition belonged to the near-frontal group but was excluded from these evaluation counts.\\n\",\"\\n\",\"The geometry groups represent the angular deviation of the illumination direction relative to the camera axis, as defined by the study's condition-grouping procedure. They do not represent directly measured illumination intensity. The same 38 identities were represented in each of the three evaluation groups, enabling identity-level repeated-measures comparisons. The resulting observations are identity-condition-matched captures under different lighting conditions, not exact image-level pairs generated from a single source image.\\n\",\"\\\"\\\"\\\".strip()\\n\",\"\\n\",\"facts = {\\n\",\"    \\\"identity_count\\\": 38,\\n\",\"    \\\"standard_illumination_condition_count\\\": 64,\\n\",\"    \\\"incomplete_identity_count\\\": 7,\\n\",\"    \\\"common_condition_count\\\": 57,\\n\",\"    \\\"common_condition_observation_count\\\": 2166,\\n\",\"    \\\"observations_per_common_condition\\\": 38,\\n\",\"    \\\"reference_condition\\\": \\\"A+000E+00\\\",\\n\",\"    \\\"reference_observation_count\\\": 38,\\n\",\"    \\\"evaluation_condition_count\\\": 56,\\n\",\"    \\\"evaluation_observation_count\\\": 2128,\\n\",\"    \\\"evaluation_groups\\\": {\\n\",\"        \\\"near_frontal\\\": {\\n\",\"            \\\"conditions\\\": 17,\\n\",\"            \\\"observations\\\": 646\\n\",\"        },\\n\",\"        \\\"oblique\\\": {\\n\",\"            \\\"conditions\\\": 11,\\n\",\"            \\\"observations\\\": 418\\n\",\"        },\\n\",\"        \\\"large_angular_deviation\\\": {\\n\",\"            \\\"conditions\\\": 28,\\n\",\"            \\\"observations\\\": 1064\\n\",\"        }\\n\",\"    },\\n\",\"    \\\"grouping_interpretation\\\": \\\"Angular deviation of illumination direction, not measured intensity\\\"\\n\",\"}\\n\",\"\\n\",\"checks = {\\n\",\"    \\\"38_identity_cohort_stated\\\":\\n\",\"        \\\"38 identities\\\" in section_text,\\n\",\"    \\\"64_total_conditions_stated\\\":\\n\",\"        \\\"64 distinct illumination conditions\\\" in section_text,\\n\",\"    \\\"seven_incomplete_identities_stated\\\":\\n\",\"        \\\"Seven identities\\\" in section_text,\\n\",\"    \\\"57_common_conditions_stated\\\":\\n\",\"        \\\"57 common illumination conditions\\\" in section_text,\\n\",\"    \\\"2166_common_observations_stated\\\":\\n\",\"        \\\"2,166 identity-condition observations\\\" in section_text,\\n\",\"    \\\"complete_case_selection_explained\\\":\\n\",\"        \\\"represented for all 38 identities\\\" in section_text,\\n\",\"    \\\"reference_condition_correct\\\":\\n\",\"        \\\"A+000E+00\\\" in section_text,\\n\",\"    \\\"38_reference_observations_stated\\\":\\n\",\"        \\\"38 reference observations\\\" in section_text,\\n\",\"    \\\"56_evaluation_conditions_stated\\\":\\n\",\"        \\\"56 common conditions\\\" in section_text,\\n\",\"    \\\"2128_evaluation_observations_stated\\\":\\n\",\"        \\\"2,128 identity-condition observations\\\" in section_text,\\n\",\"    \\\"three_geometry_groups_named\\\": all(\\n\",\"        group in section_text\\n\",\"        for group in [\\n\",\"            \\\"near-frontal\\\",\\n\",\"            \\\"oblique\\\",\\n\",\"            \\\"large-angular-deviation\\\"\\n\",\"        ]\\n\",\"    ),\\n\",\"    \\\"group_condition_and_observation_counts_stated\\\": all(\\n\",\"        value in section_text\\n\",\"        for value in [\\n\",\"            \\\"17, 11, and 28 conditions\\\",\\n\",\"            \\\"646, 418, and 1,064 observations\\\"\\n\",\"        ]\\n\",\"    ),\\n\",\"    \\\"reference_excluded_from_evaluation_counts\\\":\\n\",\"        \\\"excluded from these evaluation counts\\\" in section_text,\\n\",\"    \\\"geometry_not_intensity_limitation_stated\\\":\\n\",\"        \\\"do not represent directly measured illumination intensity\\\" in section_text,\\n\",\"    \\\"same_identities_across_groups_stated\\\":\\n\",\"        \\\"same 38 identities were represented in each\\\" in section_text,\\n\",\"    \\\"not_exact_image_pairs_limitation_stated\\\":\\n\",\"        \\\"not exact image-level pairs\\\" in section_text\\n\",\"}\\n\",\"\\n\",\"word_count = len(re.findall(r\\\"\\\\b[\\\\w'-]+\\\\b\\\", section_text))\\n\",\"\\n\",\"markdown_content = f\\\"# {section_title}\\\\n\\\\n{section_text}\\\\n\\\"\\n\",\"\\n\",\"markdown_path = OUTPUT_DIR / \\\"experiment20_methodology_3_3_subject_condition_selection.md\\\"\\n\",\"json_path = OUTPUT_DIR / \\\"experiment20_step3393_subject_condition_selection.json\\\"\\n\",\"audit_path = OUTPUT_DIR / \\\"experiment20_step3393_subject_condition_selection_audit.json\\\"\\n\",\"\\n\",\"markdown_path.write_text(markdown_content, encoding=\\\"utf-8\\\")\\n\",\"\\n\",\"record = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"phase\\\": \\\"3.3\\\",\\n\",\"    \\\"step\\\": \\\"3.3.9.3\\\",\\n\",\"    \\\"subsection\\\": section_title,\\n\",\"    \\\"created_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"draft_text\\\": section_text,\\n\",\"    \\\"verified_selection_facts\\\": facts,\\n\",\"    \\\"word_count\\\": word_count,\\n\",\"    \\\"checks\\\": checks,\\n\",\"    \\\"passed_checks\\\": sum(checks.values()),\\n\",\"    \\\"total_checks\\\": len(checks),\\n\",\"    \\\"failed_checks\\\": [\\n\",\"        name for name, passed in checks.items() if not passed\\n\",\"    ],\\n\",\"    \\\"status\\\": (\\n\",\"        \\\"DRAFT_CONSISTENCY_CHECK_PASSED\\\"\\n\",\"        if all(checks.values())\\n\",\"        else \\\"DRAFT_REQUIRES_REVIEW\\\"\\n\",\"    ),\\n\",\"    \\\"selection_notes\\\": [\\n\",\"        \\\"Common-condition selection maintains complete identity coverage.\\\",\\n\",\"        \\\"Reference observations are used for distance calculation but excluded from non-reference evaluation counts.\\\",\\n\",\"        \\\"Geometry groups describe angular deviation, not measured illumination intensity.\\\"\\n\",\"    ]\\n\",\"}\\n\",\"\\n\",\"json_path.write_text(\\n\",\"    json.dumps(record, indent=2, ensure_ascii=False),\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\")\\n\",\"\\n\",\"audit = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"step\\\": \\\"3.3.9.3\\\",\\n\",\"    \\\"created_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"word_count\\\": word_count,\\n\",\"    \\\"checks\\\": checks,\\n\",\"    \\\"passed_checks\\\": sum(checks.values()),\\n\",\"    \\\"total_checks\\\": len(checks),\\n\",\"    \\\"failed_checks\\\": record[\\\"failed_checks\\\"],\\n\",\"    \\\"status\\\": record[\\\"status\\\"],\\n\",\"    \\\"files\\\": {\\n\",\"        \\\"markdown\\\": str(markdown_path),\\n\",\"        \\\"json\\\": str(json_path)\\n\",\"    }\\n\",\"}\\n\",\"\\n\",\"audit_path.write_text(\\n\",\"    json.dumps(audit, indent=2, ensure_ascii=False),\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\")\\n\",\"\\n\",\"# Reload and verify saved artifacts.\\n\",\"assert markdown_path.read_text(encoding=\\\"utf-8\\\") == markdown_content\\n\",\"assert json.loads(json_path.read_text(encoding=\\\"utf-8\\\")) == record\\n\",\"assert json.loads(audit_path.read_text(encoding=\\\"utf-8\\\")) == audit\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.3.9.3\\\")\\n\",\"print(\\\"SUBJECT SELECTION AND ILLUMINATION-CONDITION COVERAGE\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"print(\\\"\\\\nWord count:\\\", word_count)\\n\",\"\\n\",\"print(\\\"\\\\nConsistency checks:\\\")\\n\",\"for name, passed in checks.items():\\n\",\"    print(f\\\"{name}: {'PASS' if passed else 'FAIL'}\\\")\\n\",\"\\n\",\"print(f\\\"\\\\nPassed: {record['passed_checks']} / {record['total_checks']}\\\")\\n\",\"print(\\\"Failed:\\\", len(record[\\\"failed_checks\\\"]))\\n\",\"print(\\\"Status:\\\", record[\\\"status\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nMarkdown reload: PASS\\\")\\n\",\"print(\\\"JSON reload: PASS\\\")\\n\",\"print(\\\"Audit reload: PASS\\\")\\n\",\"\\n\",\"print(\\\"\\\\nSaved files:\\\")\\n\",\"print(markdown_path)\\n\",\"print(json_path)\\n\",\"print(audit_path)\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 88)\\n\",\"print(\\\"DRAFT TEXT\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(markdown_content)\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"3Vm8J2v8J31b\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794392951196,\"user_tz\":360,\"elapsed\":233,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"5dbd4fcd-e820-4a7f-e04b-8d287c33fa0c\"},\"execution_count\":68,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.3.9.3\\n\",\"SUBJECT SELECTION AND ILLUMINATION-CONDITION COVERAGE\\n\",\"========================================================================================\\n\",\"\\n\",\"Word count: 296\\n\",\"\\n\",\"Consistency checks:\\n\",\"38_identity_cohort_stated: PASS\\n\",\"64_total_conditions_stated: PASS\\n\",\"seven_incomplete_identities_stated: PASS\\n\",\"57_common_conditions_stated: PASS\\n\",\"2166_common_observations_stated: PASS\\n\",\"complete_case_selection_explained: PASS\\n\",\"reference_condition_correct: PASS\\n\",\"38_reference_observations_stated: FAIL\\n\",\"56_evaluation_conditions_stated: PASS\\n\",\"2128_evaluation_observations_stated: PASS\\n\",\"three_geometry_groups_named: PASS\\n\",\"group_condition_and_observation_counts_stated: PASS\\n\",\"reference_excluded_from_evaluation_counts: PASS\\n\",\"geometry_not_intensity_limitation_stated: PASS\\n\",\"same_identities_across_groups_stated: PASS\\n\",\"not_exact_image_pairs_limitation_stated: PASS\\n\",\"\\n\",\"Passed: 15 / 16\\n\",\"Failed: 1\\n\",\"Status: DRAFT_REQUIRES_REVIEW\\n\",\"\\n\",\"Markdown reload: PASS\\n\",\"JSON reload: PASS\\n\",\"Audit reload: PASS\\n\",\"\\n\",\"Saved files:\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3393/experiment20_methodology_3_3_subject_condition_selection.md\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3393/experiment20_step3393_subject_condition_selection.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3393/experiment20_step3393_subject_condition_selection_audit.json\\n\",\"\\n\",\"========================================================================================\\n\",\"DRAFT TEXT\\n\",\"========================================================================================\\n\",\"# 3.3 Subject Selection and Illumination-Condition Coverage\\n\",\"\\n\",\"The subject cohort comprised 38 identities represented in the Cropped Extended Yale B frontal-pose illumination subset. The standard-illumination image collection contained 64 distinct illumination conditions across the cohort; however, not every condition was available for every identity. Seven identities had incomplete condition coverage. To preserve a consistent identity set across the primary condition-based comparisons, the analysis retained only conditions represented for all 38 identities.\\n\",\"\\n\",\"This complete-case condition selection produced 57 common illumination conditions and 2,166 identity-condition observations, corresponding to 38 observations for each condition. The selection was based on shared condition availability rather than on embedding displacement values or statistical outcomes. Conditions not represented across all 38 identities were excluded from analyses requiring complete identity-condition coverage.\\n\",\"\\n\",\"The condition A+000E+00 was designated as the reference condition. One reference observation was available for each of the 38 identities, providing an identity-specific reference embedding. The reference observations were retained for calculating reference-relative distances but excluded from the non-reference evaluation set. Consequently, the primary evaluation comprised the remaining 56 common conditions and 2,128 identity-condition observations.\\n\",\"\\n\",\"The 56 non-reference conditions were assigned to three illumination geometry groups using the frozen condition-grouping manifest: near-frontal, oblique, and large-angular-deviation. The corresponding evaluation counts were 17, 11, and 28 conditions, respectively, representing 646, 418, and 1,064 observations. The reference condition belonged to the near-frontal group but was excluded from these evaluation counts.\\n\",\"\\n\",\"The geometry groups represent the angular deviation of the illumination direction relative to the camera axis, as defined by the study's condition-grouping procedure. They do not represent directly measured illumination intensity. The same 38 identities were represented in each of the three evaluation groups, enabling identity-level repeated-measures comparisons. The resulting observations are identity-condition-matched captures under different lighting conditions, not exact image-level pairs generated from a single source image.\\n\",\"\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.3.9.4\\n\",\"## Correction of Reference Observation Count Audit\\n\",\"\\n\",\"The previous audit reported one failure because its text-matching rule expected the exact phrase \\\"38 reference observations\\\".\\n\",\"\\n\",\"The manuscript already states that one reference observation was available for each of the 38 identities.\\n\",\"\\n\",\"This is equivalent to 38 reference observations.\\n\",\"\\n\",\"The revised audit will verify the actual meaning through both statements. The manuscript will remain unchanged.\"],\"metadata\":{\"id\":\"Diw89PPwJ_tq\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"import re\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"STEP_DIR = BASE / \\\"step_3_3\\\"\\n\",\"\\n\",\"SOURCE = (\\n\",\"    STEP_DIR / \\\"step_3393\\\" /\\n\",\"    \\\"experiment20_methodology_3_3_subject_condition_selection.md\\\"\\n\",\")\\n\",\"\\n\",\"OUTPUT_DIR = STEP_DIR / \\\"step_3394\\\"\\n\",\"OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"if not SOURCE.exists():\\n\",\"    raise FileNotFoundError(SOURCE)\\n\",\"\\n\",\"manuscript = SOURCE.read_text(encoding=\\\"utf-8\\\")\\n\",\"\\n\",\"# Verify the semantic components of the reference count.\\n\",\"one_reference_per_identity = bool(\\n\",\"    re.search(\\n\",\"        r\\\"One reference observation was available for each \\\"\\n\",\"        r\\\"of the 38 identities\\\",\\n\",\"        manuscript,\\n\",\"        flags=re.IGNORECASE\\n\",\"    )\\n\",\")\\n\",\"\\n\",\"reference_count_equivalent = (\\n\",\"    one_reference_per_identity and 38 == 38\\n\",\")\\n\",\"\\n\",\"checks = {\\n\",\"    \\\"one_reference_per_each_identity_explicitly_stated\\\":\\n\",\"        one_reference_per_identity,\\n\",\"    \\\"reference_observation_count_equals_38\\\":\\n\",\"        reference_count_equivalent,\\n\",\"    \\\"reference_condition_correct\\\":\\n\",\"        \\\"A+000E+00\\\" in manuscript,\\n\",\"    \\\"reference_excluded_from_evaluation\\\":\\n\",\"        \\\"excluded from the non-reference evaluation set\\\" in manuscript,\\n\",\"    \\\"evaluation_observation_count_correct\\\":\\n\",\"        \\\"2,128 identity-condition observations\\\" in manuscript,\\n\",\"    \\\"evaluation_condition_count_correct\\\":\\n\",\"        \\\"56 non-reference conditions\\\" in manuscript\\n\",\"}\\n\",\"\\n\",\"audit = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"step\\\": \\\"3.3.9.4\\\",\\n\",\"    \\\"created_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"source_manuscript\\\": str(SOURCE),\\n\",\"    \\\"manuscript_modified\\\": False,\\n\",\"    \\\"reference_observation_verification\\\": {\\n\",\"        \\\"identities\\\": 38,\\n\",\"        \\\"observations_per_identity\\\": 1,\\n\",\"        \\\"total_reference_observations\\\": 38,\\n\",\"        \\\"evidence\\\": (\\n\",\"            \\\"One reference observation was available for each \\\"\\n\",\"            \\\"of the 38 identities.\\\"\\n\",\"        )\\n\",\"    },\\n\",\"    \\\"checks\\\": checks,\\n\",\"    \\\"passed_checks\\\": sum(checks.values()),\\n\",\"    \\\"total_checks\\\": len(checks),\\n\",\"    \\\"failed_checks\\\": [\\n\",\"        key for key, value in checks.items() if not value\\n\",\"    ],\\n\",\"    \\\"status\\\": (\\n\",\"        \\\"REFERENCE_COUNT_VERIFICATION_PASSED\\\"\\n\",\"        if all(checks.values())\\n\",\"        else \\\"REFERENCE_COUNT_REQUIRES_REVIEW\\\"\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"OUTPUT_FILE = (\\n\",\"    OUTPUT_DIR /\\n\",\"    \\\"experiment20_step3394_reference_count_audit.json\\\"\\n\",\")\\n\",\"\\n\",\"OUTPUT_FILE.write_text(\\n\",\"    json.dumps(audit, indent=2, ensure_ascii=False),\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\")\\n\",\"\\n\",\"reloaded = json.loads(\\n\",\"    OUTPUT_FILE.read_text(encoding=\\\"utf-8\\\")\\n\",\")\\n\",\"\\n\",\"assert reloaded == audit\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.3.9.4\\\")\\n\",\"print(\\\"REFERENCE OBSERVATION COUNT VERIFICATION\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"for name, passed in checks.items():\\n\",\"    print(f\\\"{name}: {'PASS' if passed else 'FAIL'}\\\")\\n\",\"\\n\",\"print(f\\\"\\\\nPassed: {audit['passed_checks']} / {audit['total_checks']}\\\")\\n\",\"print(\\\"Failed:\\\", len(audit[\\\"failed_checks\\\"]))\\n\",\"print(\\\"Manuscript modified:\\\", audit[\\\"manuscript_modified\\\"])\\n\",\"print(\\\"Status:\\\", audit[\\\"status\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nAudit JSON reload: PASS\\\")\\n\",\"print(\\\"Saved:\\\", OUTPUT_FILE)\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"ug9nyAe2KBfA\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794392990252,\"user_tz\":360,\"elapsed\":106,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"7a46653d-3c4d-4c3d-beec-3c597e2f92cb\"},\"execution_count\":69,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.3.9.4\\n\",\"REFERENCE OBSERVATION COUNT VERIFICATION\\n\",\"========================================================================================\\n\",\"one_reference_per_each_identity_explicitly_stated: PASS\\n\",\"reference_observation_count_equals_38: PASS\\n\",\"reference_condition_correct: PASS\\n\",\"reference_excluded_from_evaluation: PASS\\n\",\"evaluation_observation_count_correct: PASS\\n\",\"evaluation_condition_count_correct: PASS\\n\",\"\\n\",\"Passed: 6 / 6\\n\",\"Failed: 0\\n\",\"Manuscript modified: False\\n\",\"Status: REFERENCE_COUNT_VERIFICATION_PASSED\\n\",\"\\n\",\"Audit JSON reload: PASS\\n\",\"Saved: /content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3394/experiment20_step3394_reference_count_audit.json\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.3.9.5\\n\",\"## Methodology: Face-Image Preprocessing\\n\",\"\\n\",\"This subsection documents the image preprocessing procedure applied before embedding extraction.\\n\",\"\\n\",\"The description must reflect the frozen Stage 2 preprocessing record. It must not imply that MTCNN detection or facial alignment was performed. The distinction between implicit torchvision resize defaults and explicitly configured parameters must also be preserved.\"],\"metadata\":{\"id\":\"cMPbVH9IKVQb\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"import re\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"STEP_DIR = BASE / \\\"step_3_3\\\"\\n\",\"OUTPUT_DIR = STEP_DIR / \\\"step_3395\\\"\\n\",\"OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"section_title = \\\"3.4 Face-Image Preprocessing\\\"\\n\",\"\\n\",\"section_text = \\\"\\\"\\\"\\n\",\"The Cropped Extended Yale B images were supplied as grayscale PGM files. Before embedding extraction, each image was converted to an RGB representation by replicating its grayscale channel across the three colour channels. The resulting images were resized directly to 160 × 160 pixels and converted to tensors using torchvision.transforms.ToTensor().\\n\",\"\\n\",\"Face detection and facial alignment were not applied during this preprocessing stage. An initial MTCNN compatibility test detected only one face in twelve tested Yale B images. Consequently, the experiment used direct image resizing rather than MTCNN-based detection and alignment. This decision was consistent with the cropped-image format of the selected dataset, but it means that the preprocessing procedure should not be described as a face-detection or landmark-alignment pipeline.\\n\",\"\\n\",\"The original resize operation did not explicitly specify interpolation or antialiasing arguments. The recorded torchvision version was 0.29.1+cpu, for which the applicable Resize defaults were bilinear interpolation and antialiasing enabled. These settings are therefore documented as library defaults rather than as manually specified experimental parameters.\\n\",\"\\n\",\"This preprocessing procedure differs from the MTCNN-based preprocessing used in Experiment 18. Accordingly, results obtained from the two experimental stages should not be treated as directly interchangeable without accounting for their different image-processing procedures.\\n\",\"\\\"\\\"\\\".strip()\\n\",\"\\n\",\"facts = {\\n\",\"    \\\"input_format\\\": \\\"PGM\\\",\\n\",\"    \\\"input_image_type\\\": \\\"grayscale\\\",\\n\",\"    \\\"grayscale_to_rgb\\\": \\\"replicate grayscale channel across three channels\\\",\\n\",\"    \\\"resize_dimensions\\\": [160, 160],\\n\",\"    \\\"tensor_conversion\\\": \\\"torchvision.transforms.ToTensor()\\\",\\n\",\"    \\\"face_detection_used\\\": False,\\n\",\"    \\\"face_alignment_used\\\": False,\\n\",\"    \\\"mtcnn_compatibility_test\\\": {\\n\",\"        \\\"detected_faces\\\": 1,\\n\",\"        \\\"tested_images\\\": 12\\n\",\"    },\\n\",\"    \\\"torchvision_version\\\": \\\"0.29.1+cpu\\\",\\n\",\"    \\\"resize_interpolation_default\\\": \\\"bilinear\\\",\\n\",\"    \\\"resize_antialias_default\\\": True,\\n\",\"    \\\"resize_arguments_explicitly_configured\\\": False,\\n\",\"    \\\"difference_from_experiment_18\\\": \\\"Experiment 18 used MTCNN-based preprocessing\\\"\\n\",\"}\\n\",\"\\n\",\"checks = {\\n\",\"    \\\"pgm_grayscale_input_documented\\\":\\n\",\"        \\\"grayscale PGM files\\\" in section_text,\\n\",\"    \\\"channel_replication_documented\\\":\\n\",\"        \\\"replicating its grayscale channel across the three colour channels\\\" in section_text,\\n\",\"    \\\"resize_dimensions_correct\\\":\\n\",\"        \\\"160 × 160 pixels\\\" in section_text,\\n\",\"    \\\"tensor_conversion_documented\\\":\\n\",\"        \\\"torchvision.transforms.ToTensor()\\\" in section_text,\\n\",\"    \\\"no_face_detection_claimed\\\":\\n\",\"        \\\"Face detection and facial alignment were not applied\\\" in section_text,\\n\",\"    \\\"mtcnn_test_result_correct\\\":\\n\",\"        \\\"only one face in twelve tested\\\" in section_text,\\n\",\"    \\\"direct_resize_reason_documented\\\":\\n\",\"        \\\"direct image resizing rather than MTCNN-based detection and alignment\\\" in section_text,\\n\",\"    \\\"implicit_resize_defaults_distinguished\\\":\\n\",\"        \\\"did not explicitly specify interpolation or antialiasing arguments\\\" in section_text,\\n\",\"    \\\"bilinear_default_documented\\\":\\n\",\"        \\\"bilinear interpolation\\\" in section_text,\\n\",\"    \\\"antialias_default_documented\\\":\\n\",\"        \\\"antialiasing enabled\\\" in section_text,\\n\",\"    \\\"torchvision_version_documented\\\":\\n\",\"        \\\"0.29.1+cpu\\\" in section_text,\\n\",\"    \\\"difference_from_experiment18_documented\\\":\\n\",\"        \\\"differs from the MTCNN-based preprocessing used in Experiment 18\\\" in section_text\\n\",\"}\\n\",\"\\n\",\"word_count = len(re.findall(r\\\"\\\\b[\\\\w'-]+\\\\b\\\", section_text))\\n\",\"\\n\",\"markdown_content = f\\\"# {section_title}\\\\n\\\\n{section_text}\\\\n\\\"\\n\",\"\\n\",\"markdown_path = OUTPUT_DIR / \\\"experiment20_methodology_3_4_face_preprocessing.md\\\"\\n\",\"json_path = OUTPUT_DIR / \\\"experiment20_step3395_face_preprocessing.json\\\"\\n\",\"audit_path = OUTPUT_DIR / \\\"experiment20_step3395_face_preprocessing_audit.json\\\"\\n\",\"\\n\",\"markdown_path.write_text(markdown_content, encoding=\\\"utf-8\\\")\\n\",\"\\n\",\"record = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"phase\\\": \\\"3.3\\\",\\n\",\"    \\\"step\\\": \\\"3.3.9.5\\\",\\n\",\"    \\\"subsection\\\": section_title,\\n\",\"    \\\"created_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"draft_text\\\": section_text,\\n\",\"    \\\"verified_preprocessing_facts\\\": facts,\\n\",\"    \\\"word_count\\\": word_count,\\n\",\"    \\\"checks\\\": checks,\\n\",\"    \\\"passed_checks\\\": sum(checks.values()),\\n\",\"    \\\"total_checks\\\": len(checks),\\n\",\"    \\\"failed_checks\\\": [\\n\",\"        name for name, passed in checks.items() if not passed\\n\",\"    ],\\n\",\"    \\\"status\\\": (\\n\",\"        \\\"DRAFT_CONSISTENCY_CHECK_PASSED\\\"\\n\",\"        if all(checks.values())\\n\",\"        else \\\"DRAFT_REQUIRES_REVIEW\\\"\\n\",\"    ),\\n\",\"    \\\"methodological_limitations\\\": [\\n\",\"        \\\"No MTCNN face detection was applied.\\\",\\n\",\"        \\\"No facial alignment was applied.\\\",\\n\",\"        \\\"Resize interpolation and antialiasing were implicit library defaults.\\\",\\n\",\"        \\\"Preprocessing differs from Experiment 18.\\\"\\n\",\"    ]\\n\",\"}\\n\",\"\\n\",\"json_path.write_text(\\n\",\"    json.dumps(record, indent=2, ensure_ascii=False),\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\")\\n\",\"\\n\",\"audit = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"step\\\": \\\"3.3.9.5\\\",\\n\",\"    \\\"created_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"word_count\\\": word_count,\\n\",\"    \\\"checks\\\": checks,\\n\",\"    \\\"passed_checks\\\": sum(checks.values()),\\n\",\"    \\\"total_checks\\\": len(checks),\\n\",\"    \\\"failed_checks\\\": record[\\\"failed_checks\\\"],\\n\",\"    \\\"status\\\": record[\\\"status\\\"],\\n\",\"    \\\"files\\\": {\\n\",\"        \\\"markdown\\\": str(markdown_path),\\n\",\"        \\\"json\\\": str(json_path)\\n\",\"    }\\n\",\"}\\n\",\"\\n\",\"audit_path.write_text(\\n\",\"    json.dumps(audit, indent=2, ensure_ascii=False),\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\")\\n\",\"\\n\",\"# Reload and verify all saved artifacts.\\n\",\"assert markdown_path.read_text(encoding=\\\"utf-8\\\") == markdown_content\\n\",\"assert json.loads(json_path.read_text(encoding=\\\"utf-8\\\")) == record\\n\",\"assert json.loads(audit_path.read_text(encoding=\\\"utf-8\\\")) == audit\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.3.9.5\\\")\\n\",\"print(\\\"FACE-IMAGE PREPROCESSING\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"print(\\\"\\\\nWord count:\\\", word_count)\\n\",\"\\n\",\"print(\\\"\\\\nConsistency checks:\\\")\\n\",\"for name, passed in checks.items():\\n\",\"    print(f\\\"{name}: {'PASS' if passed else 'FAIL'}\\\")\\n\",\"\\n\",\"print(f\\\"\\\\nPassed: {record['passed_checks']} / {record['total_checks']}\\\")\\n\",\"print(\\\"Failed:\\\", len(record[\\\"failed_checks\\\"]))\\n\",\"print(\\\"Status:\\\", record[\\\"status\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nMarkdown reload: PASS\\\")\\n\",\"print(\\\"JSON reload: PASS\\\")\\n\",\"print(\\\"Audit reload: PASS\\\")\\n\",\"\\n\",\"print(\\\"\\\\nSaved files:\\\")\\n\",\"print(markdown_path)\\n\",\"print(json_path)\\n\",\"print(audit_path)\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 88)\\n\",\"print(\\\"DRAFT TEXT\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(markdown_content)\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"OhgiCeGmKXI1\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794393079079,\"user_tz\":360,\"elapsed\":183,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"ef2140fd-697c-4009-c4d9-369b32e6b256\"},\"execution_count\":70,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.3.9.5\\n\",\"FACE-IMAGE PREPROCESSING\\n\",\"========================================================================================\\n\",\"\\n\",\"Word count: 202\\n\",\"\\n\",\"Consistency checks:\\n\",\"pgm_grayscale_input_documented: PASS\\n\",\"channel_replication_documented: PASS\\n\",\"resize_dimensions_correct: PASS\\n\",\"tensor_conversion_documented: PASS\\n\",\"no_face_detection_claimed: PASS\\n\",\"mtcnn_test_result_correct: PASS\\n\",\"direct_resize_reason_documented: PASS\\n\",\"implicit_resize_defaults_distinguished: PASS\\n\",\"bilinear_default_documented: PASS\\n\",\"antialias_default_documented: PASS\\n\",\"torchvision_version_documented: PASS\\n\",\"difference_from_experiment18_documented: PASS\\n\",\"\\n\",\"Passed: 12 / 12\\n\",\"Failed: 0\\n\",\"Status: DRAFT_CONSISTENCY_CHECK_PASSED\\n\",\"\\n\",\"Markdown reload: PASS\\n\",\"JSON reload: PASS\\n\",\"Audit reload: PASS\\n\",\"\\n\",\"Saved files:\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3395/experiment20_methodology_3_4_face_preprocessing.md\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3395/experiment20_step3395_face_preprocessing.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3395/experiment20_step3395_face_preprocessing_audit.json\\n\",\"\\n\",\"========================================================================================\\n\",\"DRAFT TEXT\\n\",\"========================================================================================\\n\",\"# 3.4 Face-Image Preprocessing\\n\",\"\\n\",\"The Cropped Extended Yale B images were supplied as grayscale PGM files. Before embedding extraction, each image was converted to an RGB representation by replicating its grayscale channel across the three colour channels. The resulting images were resized directly to 160 × 160 pixels and converted to tensors using torchvision.transforms.ToTensor().\\n\",\"\\n\",\"Face detection and facial alignment were not applied during this preprocessing stage. An initial MTCNN compatibility test detected only one face in twelve tested Yale B images. Consequently, the experiment used direct image resizing rather than MTCNN-based detection and alignment. This decision was consistent with the cropped-image format of the selected dataset, but it means that the preprocessing procedure should not be described as a face-detection or landmark-alignment pipeline.\\n\",\"\\n\",\"The original resize operation did not explicitly specify interpolation or antialiasing arguments. The recorded torchvision version was 0.29.1+cpu, for which the applicable Resize defaults were bilinear interpolation and antialiasing enabled. These settings are therefore documented as library defaults rather than as manually specified experimental parameters.\\n\",\"\\n\",\"This preprocessing procedure differs from the MTCNN-based preprocessing used in Experiment 18. Accordingly, results obtained from the two experimental stages should not be treated as directly interchangeable without accounting for their different image-processing procedures.\\n\",\"\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.3.9.6\\n\",\"## Methodology: FaceNet Architecture and Embedding Extraction\\n\",\"\\n\",\"This subsection documents the pretrained face-recognition architecture and embedding extraction procedure used in Stage 2. The description must distinguish the model architecture and pretrained training source from the unavailable exact weight-file checksum.\"],\"metadata\":{\"id\":\"oqPaf2MrK-g_\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"import re\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"OUTPUT_DIR = BASE / \\\"step_3_3\\\" / \\\"step_3396\\\"\\n\",\"OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"section_title = \\\"3.5 FaceNet Architecture and Embedding Extraction\\\"\\n\",\"\\n\",\"section_text = \\\"\\\"\\\"\\n\",\"Face embeddings were generated using the InceptionResnetV1 architecture implemented in facenet-pytorch, with pretrained weights associated with the VGGFace2 training dataset. The model was used as a fixed pretrained feature extractor rather than being fine-tuned on the Cropped Extended Yale B images. The same model configuration was applied throughout the Stage 2 embedding extraction procedure.\\n\",\"\\n\",\"The model produced a 512-dimensional embedding for each preprocessed image. Embedding extraction was performed with the model in evaluation mode, and gradient computation was disabled. These settings were used to obtain feature representations without updating model parameters during inference. The extracted embeddings were L2-normalised, providing the representations used in the subsequent reference-relative distance calculations.\\n\",\"\\n\",\"The recorded software environment included Python 3.13.18, PyTorch 2.14.1+cpu, torchvision 0.29.1+cpu, and facenet-pytorch 2.6.0. The embedding-generation procedure used the pretrained InceptionResnetV1 model configured for VGGFace2 weights.\\n\",\"\\n\",\"Although the model architecture, pretrained training source, software versions, output dimensionality, and inference settings were recorded, the exact pretrained weight-file identity and its SHA256 checksum were not preserved. Consequently, the model configuration is documented at the architecture and pretrained-source level, but exact weight-file reproducibility cannot be independently established from the retained records.\\n\",\"\\n\",\"The resulting embeddings were retained with row-aligned image and identity metadata, including filenames, subject identifiers, illumination azimuths, elevations, and condition labels. These records enabled each non-reference embedding to be associated with the corresponding identity-specific reference representation during the displacement analysis.\\n\",\"\\\"\\\"\\\".strip()\\n\",\"\\n\",\"facts = {\\n\",\"    \\\"architecture\\\": \\\"InceptionResnetV1\\\",\\n\",\"    \\\"implementation\\\": \\\"facenet-pytorch\\\",\\n\",\"    \\\"facenet_pytorch_version\\\": \\\"2.6.0\\\",\\n\",\"    \\\"pretrained_source\\\": \\\"VGGFace2\\\",\\n\",\"    \\\"fine_tuning_on_yaleb\\\": False,\\n\",\"    \\\"embedding_dimension\\\": 512,\\n\",\"    \\\"model_evaluation_mode\\\": True,\\n\",\"    \\\"gradient_computation_disabled\\\": True,\\n\",\"    \\\"l2_normalisation\\\": True,\\n\",\"    \\\"python_version\\\": \\\"3.13.18\\\",\\n\",\"    \\\"pytorch_version\\\": \\\"2.14.1+cpu\\\",\\n\",\"    \\\"torchvision_version\\\": \\\"0.29.1+cpu\\\",\\n\",\"    \\\"exact_weight_file_identity_preserved\\\": False,\\n\",\"    \\\"exact_weight_file_sha256_preserved\\\": False,\\n\",\"    \\\"metadata_arrays\\\": [\\n\",\"        \\\"filenames\\\",\\n\",\"        \\\"subjects\\\",\\n\",\"        \\\"subject_numbers\\\",\\n\",\"        \\\"azimuths\\\",\\n\",\"        \\\"elevations\\\",\\n\",\"        \\\"conditions\\\"\\n\",\"    ]\\n\",\"}\\n\",\"\\n\",\"checks = {\\n\",\"    \\\"architecture_correct\\\":\\n\",\"        \\\"InceptionResnetV1\\\" in section_text,\\n\",\"    \\\"implementation_correct\\\":\\n\",\"        \\\"facenet-pytorch\\\" in section_text,\\n\",\"    \\\"pretrained_source_correct\\\":\\n\",\"        \\\"VGGFace2\\\" in section_text,\\n\",\"    \\\"fixed_feature_extractor_documented\\\":\\n\",\"        \\\"rather than being fine-tuned\\\" in section_text,\\n\",\"    \\\"embedding_dimension_correct\\\":\\n\",\"        \\\"512-dimensional embedding\\\" in section_text,\\n\",\"    \\\"evaluation_mode_documented\\\":\\n\",\"        \\\"evaluation mode\\\" in section_text,\\n\",\"    \\\"gradients_disabled_documented\\\":\\n\",\"        \\\"gradient computation was disabled\\\" in section_text,\\n\",\"    \\\"l2_normalisation_documented\\\":\\n\",\"        \\\"L2-normalised\\\" in section_text,\\n\",\"    \\\"python_version_correct\\\":\\n\",\"        \\\"Python 3.13.18\\\" in section_text,\\n\",\"    \\\"pytorch_version_correct\\\":\\n\",\"        \\\"PyTorch 2.14.1+cpu\\\" in section_text,\\n\",\"    \\\"torchvision_version_correct\\\":\\n\",\"        \\\"torchvision 0.29.1+cpu\\\" in section_text,\\n\",\"    \\\"facenet_version_correct\\\":\\n\",\"        \\\"facenet-pytorch 2.6.0\\\" in section_text,\\n\",\"    \\\"missing_weight_hash_disclosed\\\":\\n\",\"        \\\"SHA256 checksum were not preserved\\\" in section_text,\\n\",\"    \\\"no_exact_weight_reproducibility_claim\\\":\\n\",\"        \\\"cannot be independently established\\\" in section_text,\\n\",\"    \\\"row_aligned_metadata_documented\\\":\\n\",\"        \\\"row-aligned image and identity metadata\\\" in section_text\\n\",\"}\\n\",\"\\n\",\"word_count = len(re.findall(r\\\"\\\\b[\\\\w'-]+\\\\b\\\", section_text))\\n\",\"\\n\",\"markdown_content = f\\\"# {section_title}\\\\n\\\\n{section_text}\\\\n\\\"\\n\",\"\\n\",\"markdown_path = OUTPUT_DIR / \\\"experiment20_methodology_3_5_facenet_embedding_extraction.md\\\"\\n\",\"json_path = OUTPUT_DIR / \\\"experiment20_step3396_facenet_embedding_extraction.json\\\"\\n\",\"audit_path = OUTPUT_DIR / \\\"experiment20_step3396_facenet_embedding_extraction_audit.json\\\"\\n\",\"\\n\",\"markdown_path.write_text(markdown_content, encoding=\\\"utf-8\\\")\\n\",\"\\n\",\"record = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"phase\\\": \\\"3.3\\\",\\n\",\"    \\\"step\\\": \\\"3.3.9.6\\\",\\n\",\"    \\\"subsection\\\": section_title,\\n\",\"    \\\"created_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"draft_text\\\": section_text,\\n\",\"    \\\"verified_model_facts\\\": facts,\\n\",\"    \\\"word_count\\\": word_count,\\n\",\"    \\\"checks\\\": checks,\\n\",\"    \\\"passed_checks\\\": sum(checks.values()),\\n\",\"    \\\"total_checks\\\": len(checks),\\n\",\"    \\\"failed_checks\\\": [\\n\",\"        name for name, passed in checks.items() if not passed\\n\",\"    ],\\n\",\"    \\\"status\\\": (\\n\",\"        \\\"DRAFT_CONSISTENCY_CHECK_PASSED\\\"\\n\",\"        if all(checks.values())\\n\",\"        else \\\"DRAFT_REQUIRES_REVIEW\\\"\\n\",\"    ),\\n\",\"    \\\"reproducibility_limitation\\\": (\\n\",\"        \\\"Exact pretrained weight-file identity and SHA256 checksum \\\"\\n\",\"        \\\"were not preserved.\\\"\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"json_path.write_text(\\n\",\"    json.dumps(record, indent=2, ensure_ascii=False),\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\")\\n\",\"\\n\",\"audit = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"step\\\": \\\"3.3.9.6\\\",\\n\",\"    \\\"created_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"word_count\\\": word_count,\\n\",\"    \\\"checks\\\": checks,\\n\",\"    \\\"passed_checks\\\": sum(checks.values()),\\n\",\"    \\\"total_checks\\\": len(checks),\\n\",\"    \\\"failed_checks\\\": record[\\\"failed_checks\\\"],\\n\",\"    \\\"status\\\": record[\\\"status\\\"],\\n\",\"    \\\"files\\\": {\\n\",\"        \\\"markdown\\\": str(markdown_path),\\n\",\"        \\\"json\\\": str(json_path)\\n\",\"    }\\n\",\"}\\n\",\"\\n\",\"audit_path.write_text(\\n\",\"    json.dumps(audit, indent=2, ensure_ascii=False),\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\")\\n\",\"\\n\",\"# Reload and verify all saved artifacts.\\n\",\"assert markdown_path.read_text(encoding=\\\"utf-8\\\") == markdown_content\\n\",\"assert json.loads(json_path.read_text(encoding=\\\"utf-8\\\")) == record\\n\",\"assert json.loads(audit_path.read_text(encoding=\\\"utf-8\\\")) == audit\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.3.9.6\\\")\\n\",\"print(\\\"FACENET ARCHITECTURE AND EMBEDDING EXTRACTION\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"print(\\\"\\\\nWord count:\\\", word_count)\\n\",\"\\n\",\"print(\\\"\\\\nConsistency checks:\\\")\\n\",\"for name, passed in checks.items():\\n\",\"    print(f\\\"{name}: {'PASS' if passed else 'FAIL'}\\\")\\n\",\"\\n\",\"print(f\\\"\\\\nPassed: {record['passed_checks']} / {record['total_checks']}\\\")\\n\",\"print(\\\"Failed:\\\", len(record[\\\"failed_checks\\\"]))\\n\",\"print(\\\"Status:\\\", record[\\\"status\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nMarkdown reload: PASS\\\")\\n\",\"print(\\\"JSON reload: PASS\\\")\\n\",\"print(\\\"Audit reload: PASS\\\")\\n\",\"\\n\",\"print(\\\"\\\\nSaved files:\\\")\\n\",\"print(markdown_path)\\n\",\"print(json_path)\\n\",\"print(audit_path)\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 88)\\n\",\"print(\\\"DRAFT TEXT\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(markdown_content)\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"OroFVceXLAHv\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794393247054,\"user_tz\":360,\"elapsed\":189,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"5d9f381a-de72-4027-8b34-a143943361ee\"},\"execution_count\":71,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.3.9.6\\n\",\"FACENET ARCHITECTURE AND EMBEDDING EXTRACTION\\n\",\"========================================================================================\\n\",\"\\n\",\"Word count: 236\\n\",\"\\n\",\"Consistency checks:\\n\",\"architecture_correct: PASS\\n\",\"implementation_correct: PASS\\n\",\"pretrained_source_correct: PASS\\n\",\"fixed_feature_extractor_documented: PASS\\n\",\"embedding_dimension_correct: PASS\\n\",\"evaluation_mode_documented: PASS\\n\",\"gradients_disabled_documented: PASS\\n\",\"l2_normalisation_documented: PASS\\n\",\"python_version_correct: PASS\\n\",\"pytorch_version_correct: PASS\\n\",\"torchvision_version_correct: PASS\\n\",\"facenet_version_correct: PASS\\n\",\"missing_weight_hash_disclosed: PASS\\n\",\"no_exact_weight_reproducibility_claim: PASS\\n\",\"row_aligned_metadata_documented: PASS\\n\",\"\\n\",\"Passed: 15 / 15\\n\",\"Failed: 0\\n\",\"Status: DRAFT_CONSISTENCY_CHECK_PASSED\\n\",\"\\n\",\"Markdown reload: PASS\\n\",\"JSON reload: PASS\\n\",\"Audit reload: PASS\\n\",\"\\n\",\"Saved files:\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3396/experiment20_methodology_3_5_facenet_embedding_extraction.md\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3396/experiment20_step3396_facenet_embedding_extraction.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3396/experiment20_step3396_facenet_embedding_extraction_audit.json\\n\",\"\\n\",\"========================================================================================\\n\",\"DRAFT TEXT\\n\",\"========================================================================================\\n\",\"# 3.5 FaceNet Architecture and Embedding Extraction\\n\",\"\\n\",\"Face embeddings were generated using the InceptionResnetV1 architecture implemented in facenet-pytorch, with pretrained weights associated with the VGGFace2 training dataset. The model was used as a fixed pretrained feature extractor rather than being fine-tuned on the Cropped Extended Yale B images. The same model configuration was applied throughout the Stage 2 embedding extraction procedure.\\n\",\"\\n\",\"The model produced a 512-dimensional embedding for each preprocessed image. Embedding extraction was performed with the model in evaluation mode, and gradient computation was disabled. These settings were used to obtain feature representations without updating model parameters during inference. The extracted embeddings were L2-normalised, providing the representations used in the subsequent reference-relative distance calculations.\\n\",\"\\n\",\"The recorded software environment included Python 3.13.18, PyTorch 2.14.1+cpu, torchvision 0.29.1+cpu, and facenet-pytorch 2.6.0. The embedding-generation procedure used the pretrained InceptionResnetV1 model configured for VGGFace2 weights.\\n\",\"\\n\",\"Although the model architecture, pretrained training source, software versions, output dimensionality, and inference settings were recorded, the exact pretrained weight-file identity and its SHA256 checksum were not preserved. Consequently, the model configuration is documented at the architecture and pretrained-source level, but exact weight-file reproducibility cannot be independently established from the retained records.\\n\",\"\\n\",\"The resulting embeddings were retained with row-aligned image and identity metadata, including filenames, subject identifiers, illumination azimuths, elevations, and condition labels. These records enabled each non-reference embedding to be associated with the corresponding identity-specific reference representation during the displacement analysis.\\n\",\"\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.3.9.7\\n\",\"## Methodology: Embedding Normalisation and Reference-Relative Distance Calculation\\n\",\"\\n\",\"This subsection documents how the L2-normalised embeddings were compared with identity-specific reference embeddings. The calculations and terminology must remain consistent with the retained displacement-analysis records.\"],\"metadata\":{\"id\":\"-TavUDdiLVSd\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"import re\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"OUTPUT_DIR = BASE / \\\"step_3_3\\\" / \\\"step_3397\\\"\\n\",\"OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"section_title = \\\"3.6 Embedding Normalisation and Reference-Relative Distance Calculation\\\"\\n\",\"\\n\",\"section_text = \\\"\\\"\\\"\\n\",\"The extracted 512-dimensional embeddings were L2-normalised before the reference-relative displacement analysis. For each of the 38 identities, the embedding associated with the reference illumination condition A+000E+00 served as that identity's reference representation. This produced 38 identity-specific reference embeddings.\\n\",\"\\n\",\"Each non-reference embedding was matched to the reference embedding belonging to the same identity. The evaluation therefore compared identity-condition observations with their corresponding within-identity reference representations rather than using a single reference vector shared across all subjects. After excluding the reference observations, the analysis included 2,128 non-reference observations across 56 common evaluation conditions.\\n\",\"\\n\",\"Two distance measures were used to characterise reference-relative embedding displacement. Euclidean displacement measured the L2 distance between an evaluation embedding and its corresponding identity-specific reference embedding. Cosine distance measured the angular difference between the same pair of embedding vectors. Both measures were calculated for each evaluation observation and retained alongside its identity and illumination-condition metadata.\\n\",\"\\n\",\"The resulting observation-level distances were subsequently grouped by illumination geometry for descriptive and identity-level statistical analysis. The distance calculations quantify changes in embedding representation relative to the selected reference capture. They do not, by themselves, establish a change in recognition accuracy, identity verification performance, or an operational biometric drift event.\\n\",\"\\n\",\"The analysis was descriptive: no operational detection thresholds, calibrated false-alarm rates, or classification decisions were derived from these distances. The reference-relative comparisons should also be interpreted in light of the use of different image captures across illumination conditions, rather than exact transformations of identical source images.\\n\",\"\\\"\\\"\\\".strip()\\n\",\"\\n\",\"facts = {\\n\",\"    \\\"embedding_dimension\\\": 512,\\n\",\"    \\\"embeddings_l2_normalised\\\": True,\\n\",\"    \\\"reference_condition\\\": \\\"A+000E+00\\\",\\n\",\"    \\\"number_of_identities\\\": 38,\\n\",\"    \\\"reference_embeddings\\\": 38,\\n\",\"    \\\"reference_assignment\\\": \\\"one identity-specific reference embedding per identity\\\",\\n\",\"    \\\"evaluation_matching\\\": \\\"each non-reference observation matched to the reference of the same identity\\\",\\n\",\"    \\\"evaluation_observations\\\": 2128,\\n\",\"    \\\"evaluation_conditions\\\": 56,\\n\",\"    \\\"distance_measures\\\": [\\n\",\"        \\\"Euclidean displacement\\\",\\n\",\"        \\\"Cosine distance\\\"\\n\",\"    ],\\n\",\"    \\\"analysis_type\\\": \\\"descriptive\\\",\\n\",\"    \\\"operational_thresholds_used\\\": False,\\n\",\"    \\\"calibrated_false_alarm_rates_used\\\": False,\\n\",\"    \\\"recognition_accuracy_evaluated\\\": False,\\n\",\"    \\\"source_images\\\": \\\"different identity-condition captures, not exact transformations of identical source images\\\"\\n\",\"}\\n\",\"\\n\",\"checks = {\\n\",\"    \\\"l2_normalisation_documented\\\":\\n\",\"        \\\"L2-normalised\\\" in section_text,\\n\",\"    \\\"reference_condition_correct\\\":\\n\",\"        \\\"A+000E+00\\\" in section_text,\\n\",\"    \\\"38_identity_specific_references_documented\\\":\\n\",\"        \\\"38 identity-specific reference embeddings\\\" in section_text,\\n\",\"    \\\"same_identity_matching_documented\\\":\\n\",\"        \\\"belonging to the same identity\\\" in section_text,\\n\",\"    \\\"no_global_reference_claim\\\":\\n\",\"        \\\"rather than using a single reference vector shared across all subjects\\\" in section_text,\\n\",\"    \\\"evaluation_count_correct\\\":\\n\",\"        \\\"2,128 non-reference observations\\\" in section_text,\\n\",\"    \\\"evaluation_condition_count_correct\\\":\\n\",\"        \\\"56 common evaluation conditions\\\" in section_text,\\n\",\"    \\\"euclidean_distance_documented\\\":\\n\",\"        \\\"Euclidean displacement measured the L2 distance\\\" in section_text,\\n\",\"    \\\"cosine_distance_documented\\\":\\n\",\"        \\\"Cosine distance measured the angular difference\\\" in section_text,\\n\",\"    \\\"observation_level_calculation_documented\\\":\\n\",\"        \\\"for each evaluation observation\\\" in section_text,\\n\",\"    \\\"descriptive_analysis_documented\\\":\\n\",\"        \\\"The analysis was descriptive\\\" in section_text,\\n\",\"    \\\"no_operational_thresholds_claimed\\\":\\n\",\"        \\\"no operational detection thresholds\\\" in section_text,\\n\",\"    \\\"no_accuracy_claim\\\":\\n\",\"        \\\"do not, by themselves, establish a change in recognition accuracy\\\" in section_text,\\n\",\"    \\\"different_capture_limitation_documented\\\":\\n\",\"        \\\"different image captures across illumination conditions\\\" in section_text\\n\",\"}\\n\",\"\\n\",\"word_count = len(re.findall(r\\\"\\\\b[\\\\w'-]+\\\\b\\\", section_text))\\n\",\"\\n\",\"markdown_content = f\\\"# {section_title}\\\\n\\\\n{section_text}\\\\n\\\"\\n\",\"\\n\",\"markdown_path = OUTPUT_DIR / \\\"experiment20_methodology_3_6_reference_relative_distances.md\\\"\\n\",\"json_path = OUTPUT_DIR / \\\"experiment20_step3397_reference_relative_distances.json\\\"\\n\",\"audit_path = OUTPUT_DIR / \\\"experiment20_step3397_reference_relative_distances_audit.json\\\"\\n\",\"\\n\",\"markdown_path.write_text(markdown_content, encoding=\\\"utf-8\\\")\\n\",\"\\n\",\"record = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"phase\\\": \\\"3.3\\\",\\n\",\"    \\\"step\\\": \\\"3.3.9.7\\\",\\n\",\"    \\\"subsection\\\": section_title,\\n\",\"    \\\"created_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"draft_text\\\": section_text,\\n\",\"    \\\"verified_analysis_facts\\\": facts,\\n\",\"    \\\"word_count\\\": word_count,\\n\",\"    \\\"checks\\\": checks,\\n\",\"    \\\"passed_checks\\\": sum(checks.values()),\\n\",\"    \\\"total_checks\\\": len(checks),\\n\",\"    \\\"failed_checks\\\": [\\n\",\"        name for name, passed in checks.items() if not passed\\n\",\"    ],\\n\",\"    \\\"status\\\": (\\n\",\"        \\\"DRAFT_CONSISTENCY_CHECK_PASSED\\\"\\n\",\"        if all(checks.values())\\n\",\"        else \\\"DRAFT_REQUIRES_REVIEW\\\"\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"json_path.write_text(\\n\",\"    json.dumps(record, indent=2, ensure_ascii=False),\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\")\\n\",\"\\n\",\"audit = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"step\\\": \\\"3.3.9.7\\\",\\n\",\"    \\\"created_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"word_count\\\": word_count,\\n\",\"    \\\"checks\\\": checks,\\n\",\"    \\\"passed_checks\\\": sum(checks.values()),\\n\",\"    \\\"total_checks\\\": len(checks),\\n\",\"    \\\"failed_checks\\\": record[\\\"failed_checks\\\"],\\n\",\"    \\\"status\\\": record[\\\"status\\\"],\\n\",\"    \\\"files\\\": {\\n\",\"        \\\"markdown\\\": str(markdown_path),\\n\",\"        \\\"json\\\": str(json_path)\\n\",\"    }\\n\",\"}\\n\",\"\\n\",\"audit_path.write_text(\\n\",\"    json.dumps(audit, indent=2, ensure_ascii=False),\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\")\\n\",\"\\n\",\"# Reload and verify saved artifacts.\\n\",\"assert markdown_path.read_text(encoding=\\\"utf-8\\\") == markdown_content\\n\",\"assert json.loads(json_path.read_text(encoding=\\\"utf-8\\\")) == record\\n\",\"assert json.loads(audit_path.read_text(encoding=\\\"utf-8\\\")) == audit\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.3.9.7\\\")\\n\",\"print(\\\"EMBEDDING NORMALISATION AND REFERENCE-RELATIVE DISTANCES\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"print(\\\"\\\\nWord count:\\\", word_count)\\n\",\"\\n\",\"print(\\\"\\\\nConsistency checks:\\\")\\n\",\"for name, passed in checks.items():\\n\",\"    print(f\\\"{name}: {'PASS' if passed else 'FAIL'}\\\")\\n\",\"\\n\",\"print(f\\\"\\\\nPassed: {record['passed_checks']} / {record['total_checks']}\\\")\\n\",\"print(\\\"Failed:\\\", len(record[\\\"failed_checks\\\"]))\\n\",\"print(\\\"Status:\\\", record[\\\"status\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nMarkdown reload: PASS\\\")\\n\",\"print(\\\"JSON reload: PASS\\\")\\n\",\"print(\\\"Audit reload: PASS\\\")\\n\",\"\\n\",\"print(\\\"\\\\nSaved files:\\\")\\n\",\"print(markdown_path)\\n\",\"print(json_path)\\n\",\"print(audit_path)\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 88)\\n\",\"print(\\\"DRAFT TEXT\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(markdown_content)\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"5oLuL8hpLXiG\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794393344568,\"user_tz\":360,\"elapsed\":336,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"fac640f4-214a-411a-e383-a69673cebb64\"},\"execution_count\":72,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.3.9.7\\n\",\"EMBEDDING NORMALISATION AND REFERENCE-RELATIVE DISTANCES\\n\",\"========================================================================================\\n\",\"\\n\",\"Word count: 245\\n\",\"\\n\",\"Consistency checks:\\n\",\"l2_normalisation_documented: PASS\\n\",\"reference_condition_correct: PASS\\n\",\"38_identity_specific_references_documented: PASS\\n\",\"same_identity_matching_documented: PASS\\n\",\"no_global_reference_claim: PASS\\n\",\"evaluation_count_correct: PASS\\n\",\"evaluation_condition_count_correct: PASS\\n\",\"euclidean_distance_documented: PASS\\n\",\"cosine_distance_documented: PASS\\n\",\"observation_level_calculation_documented: PASS\\n\",\"descriptive_analysis_documented: PASS\\n\",\"no_operational_thresholds_claimed: PASS\\n\",\"no_accuracy_claim: PASS\\n\",\"different_capture_limitation_documented: PASS\\n\",\"\\n\",\"Passed: 14 / 14\\n\",\"Failed: 0\\n\",\"Status: DRAFT_CONSISTENCY_CHECK_PASSED\\n\",\"\\n\",\"Markdown reload: PASS\\n\",\"JSON reload: PASS\\n\",\"Audit reload: PASS\\n\",\"\\n\",\"Saved files:\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3397/experiment20_methodology_3_6_reference_relative_distances.md\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3397/experiment20_step3397_reference_relative_distances.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3397/experiment20_step3397_reference_relative_distances_audit.json\\n\",\"\\n\",\"========================================================================================\\n\",\"DRAFT TEXT\\n\",\"========================================================================================\\n\",\"# 3.6 Embedding Normalisation and Reference-Relative Distance Calculation\\n\",\"\\n\",\"The extracted 512-dimensional embeddings were L2-normalised before the reference-relative displacement analysis. For each of the 38 identities, the embedding associated with the reference illumination condition A+000E+00 served as that identity's reference representation. This produced 38 identity-specific reference embeddings.\\n\",\"\\n\",\"Each non-reference embedding was matched to the reference embedding belonging to the same identity. The evaluation therefore compared identity-condition observations with their corresponding within-identity reference representations rather than using a single reference vector shared across all subjects. After excluding the reference observations, the analysis included 2,128 non-reference observations across 56 common evaluation conditions.\\n\",\"\\n\",\"Two distance measures were used to characterise reference-relative embedding displacement. Euclidean displacement measured the L2 distance between an evaluation embedding and its corresponding identity-specific reference embedding. Cosine distance measured the angular difference between the same pair of embedding vectors. Both measures were calculated for each evaluation observation and retained alongside its identity and illumination-condition metadata.\\n\",\"\\n\",\"The resulting observation-level distances were subsequently grouped by illumination geometry for descriptive and identity-level statistical analysis. The distance calculations quantify changes in embedding representation relative to the selected reference capture. They do not, by themselves, establish a change in recognition accuracy, identity verification performance, or an operational biometric drift event.\\n\",\"\\n\",\"The analysis was descriptive: no operational detection thresholds, calibrated false-alarm rates, or classification decisions were derived from these distances. The reference-relative comparisons should also be interpreted in light of the use of different image captures across illumination conditions, rather than exact transformations of identical source images.\\n\",\"\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.3.9.8\\n\",\"## Methodology: Illumination Geometry Classification\\n\",\"\\n\",\"This subsection documents the angular geometry calculation and the three illumination groups used in the Stage 2 analysis. The classification describes the direction of illumination relative to the camera-facing orientation. It does not represent illumination intensity or exposure level.\"],\"metadata\":{\"id\":\"ea-6uPZjLmDx\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"import re\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"OUTPUT_DIR = BASE / \\\"step_3_3\\\" / \\\"step_3398\\\"\\n\",\"OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"section_title = \\\"3.7 Illumination Geometry Classification\\\"\\n\",\"\\n\",\"section_text = \\\"\\\"\\\"\\n\",\"Illumination conditions were grouped according to the angular deviation of the light source from the camera-facing direction. The angular deviation, denoted by θ, was calculated from the recorded illumination azimuth and elevation angles using θ = cos⁻¹(cos(elevation) × cos(azimuth)). The angular values were expressed in degrees for interpretation and grouping.\\n\",\"\\n\",\"Three study-specific illumination geometry groups were defined. Near-frontal conditions comprised observations with θ ≤ 30°. Oblique conditions comprised observations with 30° < θ ≤ 60°. Large-angular conditions comprised observations with θ > 60°. These mutually exclusive intervals assigned each evaluated illumination condition to one geometry group.\\n\",\"\\n\",\"Across the 56 non-reference evaluation conditions, 17 conditions were classified as near-frontal, 11 as oblique, and 28 as large-angular. Across the 38 identities, these groups contained 646, 418, and 1,064 evaluation observations, respectively. All three groups therefore included observations from the same 38 identities, supporting the repeated-measures comparisons conducted at the identity level.\\n\",\"\\n\",\"The groups represent the angular geometry of the illumination direction rather than its intensity. They should not be interpreted as brightness levels, exposure categories, or measurements of lighting power. The three angular boundaries were selected for this study and are not presented as universal or standard illumination categories. Previous face-recognition research has used angular subsets to examine illumination variation, but the thresholds and grouping scheme used here are study-specific.\\n\",\"\\\"\\\"\\\".strip()\\n\",\"\\n\",\"facts = {\\n\",\"    \\\"angular_deviation_symbol\\\": \\\"theta\\\",\\n\",\"    \\\"angular_deviation_formula\\\": \\\"acos(cos(elevation) * cos(azimuth))\\\",\\n\",\"    \\\"angle_unit\\\": \\\"degrees\\\",\\n\",\"    \\\"groups\\\": {\\n\",\"        \\\"near_frontal\\\": {\\n\",\"            \\\"rule\\\": \\\"theta <= 30 degrees\\\",\\n\",\"            \\\"conditions\\\": 17,\\n\",\"            \\\"observations\\\": 646\\n\",\"        },\\n\",\"        \\\"oblique\\\": {\\n\",\"            \\\"rule\\\": \\\"30 degrees < theta <= 60 degrees\\\",\\n\",\"            \\\"conditions\\\": 11,\\n\",\"            \\\"observations\\\": 418\\n\",\"        },\\n\",\"        \\\"large_angular\\\": {\\n\",\"            \\\"rule\\\": \\\"theta > 60 degrees\\\",\\n\",\"            \\\"conditions\\\": 28,\\n\",\"            \\\"observations\\\": 1064\\n\",\"        }\\n\",\"    },\\n\",\"    \\\"evaluation_conditions\\\": 56,\\n\",\"    \\\"evaluation_observations\\\": 2128,\\n\",\"    \\\"identities\\\": 38,\\n\",\"    \\\"all_groups_include_same_identities\\\": True,\\n\",\"    \\\"groups_measure\\\": \\\"illumination direction geometry\\\",\\n\",\"    \\\"groups_do_not_measure\\\": \\\"illumination intensity\\\",\\n\",\"    \\\"thresholds_are_study_specific\\\": True\\n\",\"}\\n\",\"\\n\",\"checks = {\\n\",\"    \\\"angular_formula_documented\\\":\\n\",\"        \\\"cos⁻¹(cos(elevation) × cos(azimuth))\\\" in section_text,\\n\",\"    \\\"angle_unit_documented\\\":\\n\",\"        \\\"expressed in degrees\\\" in section_text,\\n\",\"    \\\"near_frontal_threshold_correct\\\":\\n\",\"        \\\"θ ≤ 30°\\\" in section_text,\\n\",\"    \\\"oblique_threshold_correct\\\":\\n\",\"        \\\"30° < θ ≤ 60°\\\" in section_text,\\n\",\"    \\\"large_angular_threshold_correct\\\":\\n\",\"        \\\"θ > 60°\\\" in section_text,\\n\",\"    \\\"near_frontal_counts_correct\\\":\\n\",\"        \\\"17 conditions\\\" in section_text and \\\"646\\\" in section_text,\\n\",\"    \\\"oblique_counts_correct\\\":\\n\",\"        \\\"11 as oblique\\\" in section_text and \\\"418\\\" in section_text,\\n\",\"    \\\"large_angular_counts_correct\\\":\\n\",\"        \\\"28 as large-angular\\\" in section_text and \\\"1,064\\\" in section_text,\\n\",\"    \\\"all_38_identities_documented\\\":\\n\",\"        \\\"same 38 identities\\\" in section_text,\\n\",\"    \\\"geometry_not_intensity_distinction\\\":\\n\",\"        \\\"rather than its intensity\\\" in section_text,\\n\",\"    \\\"not_universal_categories\\\":\\n\",\"        \\\"not presented as universal or standard illumination categories\\\" in section_text,\\n\",\"    \\\"study_specific_thresholds\\\":\\n\",\"        \\\"thresholds and grouping scheme used here are study-specific\\\" in section_text\\n\",\"}\\n\",\"\\n\",\"word_count = len(re.findall(r\\\"\\\\b[\\\\w'-]+\\\\b\\\", section_text))\\n\",\"\\n\",\"markdown_content = f\\\"# {section_title}\\\\n\\\\n{section_text}\\\\n\\\"\\n\",\"\\n\",\"markdown_path = OUTPUT_DIR / \\\"experiment20_methodology_3_7_illumination_geometry.md\\\"\\n\",\"json_path = OUTPUT_DIR / \\\"experiment20_step3398_illumination_geometry.json\\\"\\n\",\"audit_path = OUTPUT_DIR / \\\"experiment20_step3398_illumination_geometry_audit.json\\\"\\n\",\"\\n\",\"markdown_path.write_text(markdown_content, encoding=\\\"utf-8\\\")\\n\",\"\\n\",\"record = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"phase\\\": \\\"3.3\\\",\\n\",\"    \\\"step\\\": \\\"3.3.9.8\\\",\\n\",\"    \\\"subsection\\\": section_title,\\n\",\"    \\\"created_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"draft_text\\\": section_text,\\n\",\"    \\\"verified_geometry_facts\\\": facts,\\n\",\"    \\\"word_count\\\": word_count,\\n\",\"    \\\"checks\\\": checks,\\n\",\"    \\\"passed_checks\\\": sum(checks.values()),\\n\",\"    \\\"total_checks\\\": len(checks),\\n\",\"    \\\"failed_checks\\\": [\\n\",\"        name for name, passed in checks.items() if not passed\\n\",\"    ],\\n\",\"    \\\"status\\\": (\\n\",\"        \\\"DRAFT_CONSISTENCY_CHECK_PASSED\\\"\\n\",\"        if all(checks.values())\\n\",\"        else \\\"DRAFT_REQUIRES_REVIEW\\\"\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"json_path.write_text(\\n\",\"    json.dumps(record, indent=2, ensure_ascii=False),\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\")\\n\",\"\\n\",\"audit = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"step\\\": \\\"3.3.9.8\\\",\\n\",\"    \\\"created_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"word_count\\\": word_count,\\n\",\"    \\\"checks\\\": checks,\\n\",\"    \\\"passed_checks\\\": sum(checks.values()),\\n\",\"    \\\"total_checks\\\": len(checks),\\n\",\"    \\\"failed_checks\\\": record[\\\"failed_checks\\\"],\\n\",\"    \\\"status\\\": record[\\\"status\\\"],\\n\",\"    \\\"files\\\": {\\n\",\"        \\\"markdown\\\": str(markdown_path),\\n\",\"        \\\"json\\\": str(json_path)\\n\",\"    }\\n\",\"}\\n\",\"\\n\",\"audit_path.write_text(\\n\",\"    json.dumps(audit, indent=2, ensure_ascii=False),\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\")\\n\",\"\\n\",\"assert markdown_path.read_text(encoding=\\\"utf-8\\\") == markdown_content\\n\",\"assert json.loads(json_path.read_text(encoding=\\\"utf-8\\\")) == record\\n\",\"assert json.loads(audit_path.read_text(encoding=\\\"utf-8\\\")) == audit\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.3.9.8\\\")\\n\",\"print(\\\"ILLUMINATION GEOMETRY CLASSIFICATION\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"print(\\\"\\\\nWord count:\\\", word_count)\\n\",\"\\n\",\"print(\\\"\\\\nConsistency checks:\\\")\\n\",\"for name, passed in checks.items():\\n\",\"    print(f\\\"{name}: {'PASS' if passed else 'FAIL'}\\\")\\n\",\"\\n\",\"print(f\\\"\\\\nPassed: {record['passed_checks']} / {record['total_checks']}\\\")\\n\",\"print(\\\"Failed:\\\", len(record[\\\"failed_checks\\\"]))\\n\",\"print(\\\"Status:\\\", record[\\\"status\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nMarkdown reload: PASS\\\")\\n\",\"print(\\\"JSON reload: PASS\\\")\\n\",\"print(\\\"Audit reload: PASS\\\")\\n\",\"\\n\",\"print(\\\"\\\\nSaved files:\\\")\\n\",\"print(markdown_path)\\n\",\"print(json_path)\\n\",\"print(audit_path)\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 88)\\n\",\"print(\\\"DRAFT TEXT\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(markdown_content)\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"fhDWjmyFLoPA\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794393411881,\"user_tz\":360,\"elapsed\":162,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"1b06d8e4-b236-4a6b-cbca-8ce51c0e92c3\"},\"execution_count\":73,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.3.9.8\\n\",\"ILLUMINATION GEOMETRY CLASSIFICATION\\n\",\"========================================================================================\\n\",\"\\n\",\"Word count: 217\\n\",\"\\n\",\"Consistency checks:\\n\",\"angular_formula_documented: PASS\\n\",\"angle_unit_documented: PASS\\n\",\"near_frontal_threshold_correct: PASS\\n\",\"oblique_threshold_correct: PASS\\n\",\"large_angular_threshold_correct: PASS\\n\",\"near_frontal_counts_correct: PASS\\n\",\"oblique_counts_correct: PASS\\n\",\"large_angular_counts_correct: PASS\\n\",\"all_38_identities_documented: PASS\\n\",\"geometry_not_intensity_distinction: PASS\\n\",\"not_universal_categories: PASS\\n\",\"study_specific_thresholds: PASS\\n\",\"\\n\",\"Passed: 12 / 12\\n\",\"Failed: 0\\n\",\"Status: DRAFT_CONSISTENCY_CHECK_PASSED\\n\",\"\\n\",\"Markdown reload: PASS\\n\",\"JSON reload: PASS\\n\",\"Audit reload: PASS\\n\",\"\\n\",\"Saved files:\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3398/experiment20_methodology_3_7_illumination_geometry.md\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3398/experiment20_step3398_illumination_geometry.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3398/experiment20_step3398_illumination_geometry_audit.json\\n\",\"\\n\",\"========================================================================================\\n\",\"DRAFT TEXT\\n\",\"========================================================================================\\n\",\"# 3.7 Illumination Geometry Classification\\n\",\"\\n\",\"Illumination conditions were grouped according to the angular deviation of the light source from the camera-facing direction. The angular deviation, denoted by θ, was calculated from the recorded illumination azimuth and elevation angles using θ = cos⁻¹(cos(elevation) × cos(azimuth)). The angular values were expressed in degrees for interpretation and grouping.\\n\",\"\\n\",\"Three study-specific illumination geometry groups were defined. Near-frontal conditions comprised observations with θ ≤ 30°. Oblique conditions comprised observations with 30° < θ ≤ 60°. Large-angular conditions comprised observations with θ > 60°. These mutually exclusive intervals assigned each evaluated illumination condition to one geometry group.\\n\",\"\\n\",\"Across the 56 non-reference evaluation conditions, 17 conditions were classified as near-frontal, 11 as oblique, and 28 as large-angular. Across the 38 identities, these groups contained 646, 418, and 1,064 evaluation observations, respectively. All three groups therefore included observations from the same 38 identities, supporting the repeated-measures comparisons conducted at the identity level.\\n\",\"\\n\",\"The groups represent the angular geometry of the illumination direction rather than its intensity. They should not be interpreted as brightness levels, exposure categories, or measurements of lighting power. The three angular boundaries were selected for this study and are not presented as universal or standard illumination categories. Previous face-recognition research has used angular subsets to examine illumination variation, but the thresholds and grouping scheme used here are study-specific.\\n\",\"\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.3.9.9\\n\",\"## Methodology: Statistical Analysis\\n\",\"\\n\",\"This subsection documents the identity-level aggregation, repeated-measures tests, pairwise comparisons, multiple-comparison correction, confidence intervals, and effect-size reporting used in the Stage 2 analysis.\\n\",\"\\n\",\"The statistical description must reflect the completed analysis. It must not introduce unrecorded software, bootstrap settings, or prospective hypothesis registration.\"],\"metadata\":{\"id\":\"h0DGiy6zL362\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"import re\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"OUTPUT_DIR = BASE / \\\"step_3_3\\\" / \\\"step_3399\\\"\\n\",\"OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"section_title = \\\"3.8 Statistical Analysis\\\"\\n\",\"\\n\",\"section_text = \\\"\\\"\\\"\\n\",\"Statistical comparisons were conducted using identity-level summaries of the reference-relative distances. For each identity, the mean Euclidean displacement and mean cosine distance were calculated separately within the near-frontal, oblique, and large-angular illumination geometry groups. This aggregation provided three repeated measurements for each metric from each of the 38 identities.\\n\",\"\\n\",\"Differences across the three illumination geometry groups were evaluated using the Friedman test, a non-parametric repeated-measures procedure. The test was applied separately to Euclidean displacement and cosine distance. Kendall's coefficient of concordance (W) was reported as the corresponding effect-size measure.\\n\",\"\\n\",\"Pairwise differences between illumination geometry groups were examined using Wilcoxon signed-rank tests on the paired identity-level summaries. Three pairwise comparisons were conducted for each distance metric: near-frontal versus oblique, near-frontal versus large-angular, and oblique versus large-angular. Holm's step-down procedure was applied across the combined family of six pairwise tests, comprising the three Euclidean comparisons and the three cosine comparisons, to account for multiple testing.\\n\",\"\\n\",\"Bootstrap confidence intervals were also calculated for the identity-level mean differences in the pairwise comparisons. The identity served as the resampling unit, preserving the paired structure of the repeated-measures observations. The reported intervals were 95% confidence intervals.\\n\",\"\\n\",\"An exploratory comparison between frontal and beyond-frontal illumination conditions was additionally conducted using identity-level summaries. This comparison was interpreted cautiously because the two hemispheric categories contained unequal numbers of illumination conditions and observations and were associated with differences in angular geometry.\\n\",\"\\n\",\"The research hypotheses were formulated retrospectively after the experimental results had been examined. They were not preregistered and should therefore be interpreted as hypotheses used to organise the analysis rather than as prospectively specified tests. Statistical significance was assessed using the corrected pairwise p-values, while effect sizes and confidence intervals were considered alongside the test results.\\n\",\"\\\"\\\"\\\".strip()\\n\",\"\\n\",\"facts = {\\n\",\"    \\\"identity_count\\\": 38,\\n\",\"    \\\"aggregation_unit\\\": \\\"identity\\\",\\n\",\"    \\\"repeated_measures_groups\\\": [\\n\",\"        \\\"near-frontal\\\",\\n\",\"        \\\"oblique\\\",\\n\",\"        \\\"large-angular\\\"\\n\",\"    ],\\n\",\"    \\\"metrics\\\": [\\n\",\"        \\\"Euclidean displacement\\\",\\n\",\"        \\\"Cosine distance\\\"\\n\",\"    ],\\n\",\"    \\\"omnibus_test\\\": \\\"Friedman test\\\",\\n\",\"    \\\"omnibus_test_type\\\": \\\"non-parametric repeated-measures test\\\",\\n\",\"    \\\"effect_size\\\": \\\"Kendall's W\\\",\\n\",\"    \\\"pairwise_test\\\": \\\"Wilcoxon signed-rank test\\\",\\n\",\"    \\\"pairwise_comparisons_per_metric\\\": 3,\\n\",\"    \\\"total_pairwise_comparisons\\\": 6,\\n\",\"    \\\"multiple_comparison_correction\\\": \\\"Holm step-down procedure\\\",\\n\",\"    \\\"correction_family\\\": \\\"one combined family of six tests across both metrics\\\",\\n\",\"    \\\"confidence_interval_method\\\": \\\"bootstrap\\\",\\n\",\"    \\\"confidence_interval_level\\\": 0.95,\\n\",\"    \\\"bootstrap_resampling_unit\\\": \\\"identity\\\",\\n\",\"    \\\"hemisphere_comparison\\\": \\\"exploratory\\\",\\n\",\"    \\\"hypotheses_preregistered\\\": False,\\n\",\"    \\\"hypotheses_formulated\\\": \\\"retrospectively after results were examined\\\"\\n\",\"}\\n\",\"\\n\",\"checks = {\\n\",\"    \\\"identity_level_aggregation_documented\\\":\\n\",\"        \\\"identity-level summaries\\\" in section_text,\\n\",\"    \\\"38_identities_documented\\\":\\n\",\"        \\\"38 identities\\\" in section_text,\\n\",\"    \\\"three_repeated_measure_groups_documented\\\":\\n\",\"        all(group in section_text for group in [\\n\",\"            \\\"near-frontal\\\", \\\"oblique\\\", \\\"large-angular\\\"\\n\",\"        ]),\\n\",\"    \\\"both_metrics_documented\\\":\\n\",\"        \\\"Euclidean displacement\\\" in section_text and\\n\",\"        \\\"cosine distance\\\" in section_text,\\n\",\"    \\\"friedman_test_documented\\\":\\n\",\"        \\\"Friedman test\\\" in section_text,\\n\",\"    \\\"kendall_w_documented\\\":\\n\",\"        \\\"Kendall's coefficient of concordance (W)\\\" in section_text,\\n\",\"    \\\"wilcoxon_test_documented\\\":\\n\",\"        \\\"Wilcoxon signed-rank tests\\\" in section_text,\\n\",\"    \\\"three_pairwise_comparisons_documented\\\":\\n\",\"        \\\"Three pairwise comparisons\\\" in section_text,\\n\",\"    \\\"combined_six_test_holm_family_documented\\\":\\n\",\"        \\\"combined family of six pairwise tests\\\" in section_text,\\n\",\"    \\\"holm_correction_documented\\\":\\n\",\"        \\\"Holm's step-down procedure\\\" in section_text,\\n\",\"    \\\"bootstrap_confidence_intervals_documented\\\":\\n\",\"        \\\"Bootstrap confidence intervals\\\" in section_text,\\n\",\"    \\\"identity_resampling_unit_documented\\\":\\n\",\"        \\\"identity served as the resampling unit\\\" in section_text,\\n\",\"    \\\"confidence_level_correct\\\":\\n\",\"        \\\"95% confidence intervals\\\" in section_text,\\n\",\"    \\\"hemisphere_analysis_exploratory\\\":\\n\",\"        \\\"exploratory comparison\\\" in section_text,\\n\",\"    \\\"unequal_hemisphere_counts_limitation\\\":\\n\",\"        \\\"unequal numbers of illumination conditions and observations\\\" in section_text,\\n\",\"    \\\"retrospective_hypotheses_disclosed\\\":\\n\",\"        \\\"formulated retrospectively\\\" in section_text,\\n\",\"    \\\"not_preregistered_disclosed\\\":\\n\",\"        \\\"They were not preregistered\\\" in section_text\\n\",\"}\\n\",\"\\n\",\"word_count = len(re.findall(r\\\"\\\\b[\\\\w'-]+\\\\b\\\", section_text))\\n\",\"\\n\",\"markdown_content = f\\\"# {section_title}\\\\n\\\\n{section_text}\\\\n\\\"\\n\",\"\\n\",\"markdown_path = OUTPUT_DIR / \\\"experiment20_methodology_3_8_statistical_analysis.md\\\"\\n\",\"json_path = OUTPUT_DIR / \\\"experiment20_step3399_statistical_analysis.json\\\"\\n\",\"audit_path = OUTPUT_DIR / \\\"experiment20_step3399_statistical_analysis_audit.json\\\"\\n\",\"\\n\",\"markdown_path.write_text(markdown_content, encoding=\\\"utf-8\\\")\\n\",\"\\n\",\"record = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"phase\\\": \\\"3.3\\\",\\n\",\"    \\\"step\\\": \\\"3.3.9.9\\\",\\n\",\"    \\\"subsection\\\": section_title,\\n\",\"    \\\"created_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"draft_text\\\": section_text,\\n\",\"    \\\"verified_statistical_facts\\\": facts,\\n\",\"    \\\"word_count\\\": word_count,\\n\",\"    \\\"checks\\\": checks,\\n\",\"    \\\"passed_checks\\\": sum(checks.values()),\\n\",\"    \\\"total_checks\\\": len(checks),\\n\",\"    \\\"failed_checks\\\": [\\n\",\"        name for name, passed in checks.items() if not passed\\n\",\"    ],\\n\",\"    \\\"status\\\": (\\n\",\"        \\\"DRAFT_CONSISTENCY_CHECK_PASSED\\\"\\n\",\"        if all(checks.values())\\n\",\"        else \\\"DRAFT_REQUIRES_REVIEW\\\"\\n\",\"    ),\\n\",\"    \\\"details_not_specified_in_this_draft\\\": [\\n\",\"        \\\"Exact bootstrap resample count\\\",\\n\",\"        \\\"Bootstrap random seed\\\",\\n\",\"        \\\"Statistical software and version\\\",\\n\",\"        \\\"Any exact test implementation options\\\"\\n\",\"    ]\\n\",\"}\\n\",\"\\n\",\"json_path.write_text(\\n\",\"    json.dumps(record, indent=2, ensure_ascii=False),\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\")\\n\",\"\\n\",\"audit = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"step\\\": \\\"3.3.9.9\\\",\\n\",\"    \\\"created_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"word_count\\\": word_count,\\n\",\"    \\\"checks\\\": checks,\\n\",\"    \\\"passed_checks\\\": sum(checks.values()),\\n\",\"    \\\"total_checks\\\": len(checks),\\n\",\"    \\\"failed_checks\\\": record[\\\"failed_checks\\\"],\\n\",\"    \\\"status\\\": record[\\\"status\\\"],\\n\",\"    \\\"files\\\": {\\n\",\"        \\\"markdown\\\": str(markdown_path),\\n\",\"        \\\"json\\\": str(json_path)\\n\",\"    }\\n\",\"}\\n\",\"\\n\",\"audit_path.write_text(\\n\",\"    json.dumps(audit, indent=2, ensure_ascii=False),\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\")\\n\",\"\\n\",\"assert markdown_path.read_text(encoding=\\\"utf-8\\\") == markdown_content\\n\",\"assert json.loads(json_path.read_text(encoding=\\\"utf-8\\\")) == record\\n\",\"assert json.loads(audit_path.read_text(encoding=\\\"utf-8\\\")) == audit\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.3.9.9\\\")\\n\",\"print(\\\"STATISTICAL ANALYSIS\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"print(\\\"\\\\nWord count:\\\", word_count)\\n\",\"\\n\",\"print(\\\"\\\\nConsistency checks:\\\")\\n\",\"for name, passed in checks.items():\\n\",\"    print(f\\\"{name}: {'PASS' if passed else 'FAIL'}\\\")\\n\",\"\\n\",\"print(f\\\"\\\\nPassed: {record['passed_checks']} / {record['total_checks']}\\\")\\n\",\"print(\\\"Failed:\\\", len(record[\\\"failed_checks\\\"]))\\n\",\"print(\\\"Status:\\\", record[\\\"status\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nDetails deliberately not specified:\\\")\\n\",\"for item in record[\\\"details_not_specified_in_this_draft\\\"]:\\n\",\"    print(\\\"-\\\", item)\\n\",\"\\n\",\"print(\\\"\\\\nMarkdown reload: PASS\\\")\\n\",\"print(\\\"JSON reload: PASS\\\")\\n\",\"print(\\\"Audit reload: PASS\\\")\\n\",\"\\n\",\"print(\\\"\\\\nSaved files:\\\")\\n\",\"print(markdown_path)\\n\",\"print(json_path)\\n\",\"print(audit_path)\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 88)\\n\",\"print(\\\"DRAFT TEXT\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(markdown_content)\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"PABRzlVWL6MS\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794393487520,\"user_tz\":360,\"elapsed\":239,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"ee872bd1-9b71-462f-c2df-abbf37831792\"},\"execution_count\":74,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.3.9.9\\n\",\"STATISTICAL ANALYSIS\\n\",\"========================================================================================\\n\",\"\\n\",\"Word count: 287\\n\",\"\\n\",\"Consistency checks:\\n\",\"identity_level_aggregation_documented: PASS\\n\",\"38_identities_documented: PASS\\n\",\"three_repeated_measure_groups_documented: PASS\\n\",\"both_metrics_documented: PASS\\n\",\"friedman_test_documented: PASS\\n\",\"kendall_w_documented: PASS\\n\",\"wilcoxon_test_documented: PASS\\n\",\"three_pairwise_comparisons_documented: PASS\\n\",\"combined_six_test_holm_family_documented: PASS\\n\",\"holm_correction_documented: PASS\\n\",\"bootstrap_confidence_intervals_documented: PASS\\n\",\"identity_resampling_unit_documented: PASS\\n\",\"confidence_level_correct: PASS\\n\",\"hemisphere_analysis_exploratory: PASS\\n\",\"unequal_hemisphere_counts_limitation: PASS\\n\",\"retrospective_hypotheses_disclosed: PASS\\n\",\"not_preregistered_disclosed: PASS\\n\",\"\\n\",\"Passed: 17 / 17\\n\",\"Failed: 0\\n\",\"Status: DRAFT_CONSISTENCY_CHECK_PASSED\\n\",\"\\n\",\"Details deliberately not specified:\\n\",\"- Exact bootstrap resample count\\n\",\"- Bootstrap random seed\\n\",\"- Statistical software and version\\n\",\"- Any exact test implementation options\\n\",\"\\n\",\"Markdown reload: PASS\\n\",\"JSON reload: PASS\\n\",\"Audit reload: PASS\\n\",\"\\n\",\"Saved files:\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3399/experiment20_methodology_3_8_statistical_analysis.md\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3399/experiment20_step3399_statistical_analysis.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3399/experiment20_step3399_statistical_analysis_audit.json\\n\",\"\\n\",\"========================================================================================\\n\",\"DRAFT TEXT\\n\",\"========================================================================================\\n\",\"# 3.8 Statistical Analysis\\n\",\"\\n\",\"Statistical comparisons were conducted using identity-level summaries of the reference-relative distances. For each identity, the mean Euclidean displacement and mean cosine distance were calculated separately within the near-frontal, oblique, and large-angular illumination geometry groups. This aggregation provided three repeated measurements for each metric from each of the 38 identities.\\n\",\"\\n\",\"Differences across the three illumination geometry groups were evaluated using the Friedman test, a non-parametric repeated-measures procedure. The test was applied separately to Euclidean displacement and cosine distance. Kendall's coefficient of concordance (W) was reported as the corresponding effect-size measure.\\n\",\"\\n\",\"Pairwise differences between illumination geometry groups were examined using Wilcoxon signed-rank tests on the paired identity-level summaries. Three pairwise comparisons were conducted for each distance metric: near-frontal versus oblique, near-frontal versus large-angular, and oblique versus large-angular. Holm's step-down procedure was applied across the combined family of six pairwise tests, comprising the three Euclidean comparisons and the three cosine comparisons, to account for multiple testing.\\n\",\"\\n\",\"Bootstrap confidence intervals were also calculated for the identity-level mean differences in the pairwise comparisons. The identity served as the resampling unit, preserving the paired structure of the repeated-measures observations. The reported intervals were 95% confidence intervals.\\n\",\"\\n\",\"An exploratory comparison between frontal and beyond-frontal illumination conditions was additionally conducted using identity-level summaries. This comparison was interpreted cautiously because the two hemispheric categories contained unequal numbers of illumination conditions and observations and were associated with differences in angular geometry.\\n\",\"\\n\",\"The research hypotheses were formulated retrospectively after the experimental results had been examined. They were not preregistered and should therefore be interpreted as hypotheses used to organise the analysis rather than as prospectively specified tests. Statistical significance was assessed using the corrected pairwise p-values, while effect sizes and confidence intervals were considered alongside the test results.\\n\",\"\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.3.9.10\\n\",\"## Methodology: Exploratory Hemisphere-Based Analysis\\n\",\"\\n\",\"This subsection documents the secondary comparison between frontal and beyond-frontal illumination conditions. It must be presented as exploratory rather than as a primary illumination-group analysis.\"],\"metadata\":{\"id\":\"MI0df70OMPUs\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"import re\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"OUTPUT_DIR = BASE / \\\"step_3_3\\\" / \\\"step_3310\\\"\\n\",\"OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"section_title = \\\"3.9 Exploratory Hemisphere-Based Analysis\\\"\\n\",\"\\n\",\"section_text = \\\"\\\"\\\"\\n\",\"A secondary exploratory analysis compared reference-relative embedding displacement between frontal and beyond-frontal illumination conditions. The grouping was based on the angular hemisphere classification recorded in the Stage 2 analysis. The frontal category comprised 45 non-reference evaluation conditions, corresponding to 1,710 observations across the 38 identities. The beyond-frontal category comprised 11 evaluation conditions and 418 observations.\\n\",\"\\n\",\"For each identity, mean Euclidean displacement and mean cosine distance were calculated separately for the frontal and beyond-frontal categories. The resulting identity-level summaries were compared using paired statistical tests, with the identity serving as the unit of comparison. This approach retained the within-identity structure of the analysis.\\n\",\"\\n\",\"The hemisphere comparison was treated as exploratory and secondary to the three-group illumination geometry analysis. The two categories contained unequal numbers of illumination conditions and observations. In addition, hemisphere membership was associated with differences in angular illumination geometry. Consequently, the comparison does not isolate a hemisphere effect independently of the underlying angular distribution and should not be interpreted as evidence of a causal effect of illumination direction.\\n\",\"\\n\",\"The results are therefore reported as descriptive evidence of differences between the evaluated frontal and beyond-frontal condition sets. They are not used to establish a generalised performance claim or an operational biometric drift-detection capability.\\n\",\"\\\"\\\"\\\".strip()\\n\",\"\\n\",\"facts = {\\n\",\"    \\\"analysis_status\\\": \\\"exploratory and secondary\\\",\\n\",\"    \\\"frontal_conditions\\\": 45,\\n\",\"    \\\"frontal_observations\\\": 1710,\\n\",\"    \\\"beyond_frontal_conditions\\\": 11,\\n\",\"    \\\"beyond_frontal_observations\\\": 418,\\n\",\"    \\\"identities\\\": 38,\\n\",\"    \\\"identity_level_aggregation\\\": True,\\n\",\"    \\\"paired_comparison\\\": True,\\n\",\"    \\\"metrics\\\": [\\n\",\"        \\\"Euclidean displacement\\\",\\n\",\"        \\\"Cosine distance\\\"\\n\",\"    ],\\n\",\"    \\\"unequal_condition_counts\\\": True,\\n\",\"    \\\"angular_geometry_confounding\\\": True,\\n\",\"    \\\"causal_effect_claimed\\\": False\\n\",\"}\\n\",\"\\n\",\"checks = {\\n\",\"    \\\"exploratory_status_documented\\\":\\n\",\"        \\\"exploratory and secondary\\\" in section_text,\\n\",\"    \\\"frontal_condition_count_correct\\\":\\n\",\"        \\\"45 non-reference evaluation conditions\\\" in section_text,\\n\",\"    \\\"frontal_observation_count_correct\\\":\\n\",\"        \\\"1,710 observations\\\" in section_text,\\n\",\"    \\\"beyond_frontal_condition_count_correct\\\":\\n\",\"        \\\"11 evaluation conditions\\\" in section_text,\\n\",\"    \\\"beyond_frontal_observation_count_correct\\\":\\n\",\"        \\\"418 observations\\\" in section_text,\\n\",\"    \\\"identity_count_correct\\\":\\n\",\"        \\\"38 identities\\\" in section_text,\\n\",\"    \\\"identity_level_summaries_documented\\\":\\n\",\"        \\\"identity-level summaries\\\" in section_text,\\n\",\"    \\\"paired_comparison_documented\\\":\\n\",\"        \\\"paired statistical tests\\\" in section_text,\\n\",\"    \\\"both_metrics_documented\\\":\\n\",\"        \\\"mean Euclidean displacement\\\" in section_text and\\n\",\"        \\\"mean cosine distance\\\" in section_text,\\n\",\"    \\\"unequal_counts_limitation_documented\\\":\\n\",\"        \\\"unequal numbers of illumination conditions and observations\\\" in section_text,\\n\",\"    \\\"angular_confounding_documented\\\":\\n\",\"        \\\"associated with differences in angular illumination geometry\\\" in section_text,\\n\",\"    \\\"no_causal_claim\\\":\\n\",\"        \\\"does not isolate a hemisphere effect independently\\\" in section_text,\\n\",\"    \\\"no_operational_drift_claim\\\":\\n\",\"        \\\"operational biometric drift-detection capability\\\" in section_text\\n\",\"}\\n\",\"\\n\",\"word_count = len(re.findall(r\\\"\\\\b[\\\\w'-]+\\\\b\\\", section_text))\\n\",\"\\n\",\"markdown_content = f\\\"# {section_title}\\\\n\\\\n{section_text}\\\\n\\\"\\n\",\"\\n\",\"markdown_path = OUTPUT_DIR / \\\"experiment20_methodology_3_9_hemisphere_analysis.md\\\"\\n\",\"json_path = OUTPUT_DIR / \\\"experiment20_step3310_hemisphere_analysis.json\\\"\\n\",\"audit_path = OUTPUT_DIR / \\\"experiment20_step3310_hemisphere_analysis_audit.json\\\"\\n\",\"\\n\",\"markdown_path.write_text(markdown_content, encoding=\\\"utf-8\\\")\\n\",\"\\n\",\"record = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"phase\\\": \\\"3.3\\\",\\n\",\"    \\\"step\\\": \\\"3.3.9.10\\\",\\n\",\"    \\\"subsection\\\": section_title,\\n\",\"    \\\"created_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"draft_text\\\": section_text,\\n\",\"    \\\"verified_analysis_facts\\\": facts,\\n\",\"    \\\"word_count\\\": word_count,\\n\",\"    \\\"checks\\\": checks,\\n\",\"    \\\"passed_checks\\\": sum(checks.values()),\\n\",\"    \\\"total_checks\\\": len(checks),\\n\",\"    \\\"failed_checks\\\": [\\n\",\"        name for name, passed in checks.items() if not passed\\n\",\"    ],\\n\",\"    \\\"status\\\": (\\n\",\"        \\\"DRAFT_CONSISTENCY_CHECK_PASSED\\\"\\n\",\"        if all(checks.values())\\n\",\"        else \\\"DRAFT_REQUIRES_REVIEW\\\"\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"json_path.write_text(\\n\",\"    json.dumps(record, indent=2, ensure_ascii=False),\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\")\\n\",\"\\n\",\"audit = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"step\\\": \\\"3.3.9.10\\\",\\n\",\"    \\\"created_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"word_count\\\": word_count,\\n\",\"    \\\"checks\\\": checks,\\n\",\"    \\\"passed_checks\\\": sum(checks.values()),\\n\",\"    \\\"total_checks\\\": len(checks),\\n\",\"    \\\"failed_checks\\\": record[\\\"failed_checks\\\"],\\n\",\"    \\\"status\\\": record[\\\"status\\\"],\\n\",\"    \\\"files\\\": {\\n\",\"        \\\"markdown\\\": str(markdown_path),\\n\",\"        \\\"json\\\": str(json_path)\\n\",\"    }\\n\",\"}\\n\",\"\\n\",\"audit_path.write_text(\\n\",\"    json.dumps(audit, indent=2, ensure_ascii=False),\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\")\\n\",\"\\n\",\"assert markdown_path.read_text(encoding=\\\"utf-8\\\") == markdown_content\\n\",\"assert json.loads(json_path.read_text(encoding=\\\"utf-8\\\")) == record\\n\",\"assert json.loads(audit_path.read_text(encoding=\\\"utf-8\\\")) == audit\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.3.9.10\\\")\\n\",\"print(\\\"EXPLORATORY HEMISPHERE-BASED ANALYSIS\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"print(\\\"\\\\nWord count:\\\", word_count)\\n\",\"\\n\",\"print(\\\"\\\\nConsistency checks:\\\")\\n\",\"for name, passed in checks.items():\\n\",\"    print(f\\\"{name}: {'PASS' if passed else 'FAIL'}\\\")\\n\",\"\\n\",\"print(f\\\"\\\\nPassed: {record['passed_checks']} / {record['total_checks']}\\\")\\n\",\"print(\\\"Failed:\\\", len(record[\\\"failed_checks\\\"]))\\n\",\"print(\\\"Status:\\\", record[\\\"status\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nMarkdown reload: PASS\\\")\\n\",\"print(\\\"JSON reload: PASS\\\")\\n\",\"print(\\\"Audit reload: PASS\\\")\\n\",\"\\n\",\"print(\\\"\\\\nSaved files:\\\")\\n\",\"print(markdown_path)\\n\",\"print(json_path)\\n\",\"print(audit_path)\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 88)\\n\",\"print(\\\"DRAFT TEXT\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(markdown_content)\\n\",\"print(\\\"=\\\" * 88)\\n\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"GMQ2bUr5MSYG\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794393602280,\"user_tz\":360,\"elapsed\":90,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"5825034a-d21a-4bd2-dc99-4d472261e99c\"},\"execution_count\":75,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.3.9.10\\n\",\"EXPLORATORY HEMISPHERE-BASED ANALYSIS\\n\",\"========================================================================================\\n\",\"\\n\",\"Word count: 204\\n\",\"\\n\",\"Consistency checks:\\n\",\"exploratory_status_documented: PASS\\n\",\"frontal_condition_count_correct: PASS\\n\",\"frontal_observation_count_correct: PASS\\n\",\"beyond_frontal_condition_count_correct: PASS\\n\",\"beyond_frontal_observation_count_correct: PASS\\n\",\"identity_count_correct: PASS\\n\",\"identity_level_summaries_documented: PASS\\n\",\"paired_comparison_documented: PASS\\n\",\"both_metrics_documented: PASS\\n\",\"unequal_counts_limitation_documented: PASS\\n\",\"angular_confounding_documented: PASS\\n\",\"no_causal_claim: PASS\\n\",\"no_operational_drift_claim: PASS\\n\",\"\\n\",\"Passed: 13 / 13\\n\",\"Failed: 0\\n\",\"Status: DRAFT_CONSISTENCY_CHECK_PASSED\\n\",\"\\n\",\"Markdown reload: PASS\\n\",\"JSON reload: PASS\\n\",\"Audit reload: PASS\\n\",\"\\n\",\"Saved files:\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3310/experiment20_methodology_3_9_hemisphere_analysis.md\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3310/experiment20_step3310_hemisphere_analysis.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3310/experiment20_step3310_hemisphere_analysis_audit.json\\n\",\"\\n\",\"========================================================================================\\n\",\"DRAFT TEXT\\n\",\"========================================================================================\\n\",\"# 3.9 Exploratory Hemisphere-Based Analysis\\n\",\"\\n\",\"A secondary exploratory analysis compared reference-relative embedding displacement between frontal and beyond-frontal illumination conditions. The grouping was based on the angular hemisphere classification recorded in the Stage 2 analysis. The frontal category comprised 45 non-reference evaluation conditions, corresponding to 1,710 observations across the 38 identities. The beyond-frontal category comprised 11 evaluation conditions and 418 observations.\\n\",\"\\n\",\"For each identity, mean Euclidean displacement and mean cosine distance were calculated separately for the frontal and beyond-frontal categories. The resulting identity-level summaries were compared using paired statistical tests, with the identity serving as the unit of comparison. This approach retained the within-identity structure of the analysis.\\n\",\"\\n\",\"The hemisphere comparison was treated as exploratory and secondary to the three-group illumination geometry analysis. The two categories contained unequal numbers of illumination conditions and observations. In addition, hemisphere membership was associated with differences in angular illumination geometry. Consequently, the comparison does not isolate a hemisphere effect independently of the underlying angular distribution and should not be interpreted as evidence of a causal effect of illumination direction.\\n\",\"\\n\",\"The results are therefore reported as descriptive evidence of differences between the evaluated frontal and beyond-frontal condition sets. They are not used to establish a generalised performance claim or an operational biometric drift-detection capability.\\n\",\"\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.3.9.11\\n\",\"## Methodology: Limitations and Reproducibility\\n\",\"\\n\",\"This subsection consolidates the methodological limitations relevant to interpreting and reproducing the Stage 2 evaluation. It must distinguish documented experimental choices from unresolved reproducibility limitations and must not imply that the study validates recognition accuracy, operational drift detection, or generalisation across architectures.\"],\"metadata\":{\"id\":\"Z-JsLfEqMlw4\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"import re\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"OUTPUT_DIR = BASE / \\\"step_3_3\\\" / \\\"step_3311\\\"\\n\",\"OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"section_title = \\\"3.10 Methodological Limitations and Reproducibility\\\"\\n\",\"\\n\",\"section_text = \\\"\\\"\\\"\\n\",\"Several methodological limitations should be considered when interpreting the findings and assessing reproducibility. First, the Cropped Extended Yale B subset was obtained through a community-hosted Academic Torrents listing. Although the acquired archive and frozen dataset were recorded using SHA256 checksums and integrity checks, the source was not independently authenticated against an official UCSD checksum. The dataset should therefore be described according to its documented acquisition provenance rather than as an independently authenticated official release.\\n\",\"\\n\",\"Second, the exact pretrained InceptionResnetV1 weight-file identity and its SHA256 checksum were not preserved. The architecture, VGGFace2 pretrained source, software versions, and inference configuration were recorded, but these records do not establish that an independent reproduction would load byte-identical model weights.\\n\",\"\\n\",\"Third, the illumination conditions comprise different image captures of the same identities rather than exact transformations of identical source images. The observed embedding differences therefore cannot be attributed exclusively to illumination; other capture-related variation may also contribute. In addition, the analysis used one reference embedding per identity, which does not provide sufficient observations to estimate identity-specific covariance reliably.\\n\",\"\\n\",\"Fourth, the selected cropped images were processed using direct resizing without MTCNN face detection or facial alignment. This procedure differs from the MTCNN-based preprocessing used in Experiment 18, limiting direct comparability between the two experimental stages. The Stage 2 evaluation also used a single pretrained architecture and did not include independent architecture validation.\\n\",\"\\n\",\"Finally, the study characterises reference-relative embedding displacement rather than biometric recognition performance or an operational drift-detection system. It does not establish verification accuracy, fairness, deployment readiness, or generalisation to other datasets and recognition architectures. These boundaries should be retained when interpreting the empirical findings.\\n\",\"\\\"\\\"\\\".strip()\\n\",\"\\n\",\"facts = {\\n\",\"    \\\"dataset_provenance\\\": {\\n\",\"        \\\"source\\\": \\\"community-hosted Academic Torrents listing\\\",\\n\",\"        \\\"official_ucsd_checksum_authenticated\\\": False,\\n\",\"        \\\"archive_sha256_recorded\\\": True,\\n\",\"        \\\"archive_integrity_checks_recorded\\\": True\\n\",\"    },\\n\",\"    \\\"model_reproducibility\\\": {\\n\",\"        \\\"architecture\\\": \\\"InceptionResnetV1\\\",\\n\",\"        \\\"pretrained_source\\\": \\\"VGGFace2\\\",\\n\",\"        \\\"exact_weight_file_identity_preserved\\\": False,\\n\",\"        \\\"exact_weight_file_sha256_preserved\\\": False\\n\",\"    },\\n\",\"    \\\"image_pairing\\\": {\\n\",\"        \\\"same_identity_different_capture_conditions\\\": True,\\n\",\"        \\\"exact_source_image_transformations\\\": False\\n\",\"    },\\n\",\"    \\\"reference_design\\\": {\\n\",\"        \\\"reference_embeddings_per_identity\\\": 1,\\n\",\"        \\\"identity_specific_covariance_estimation_supported\\\": False\\n\",\"    },\\n\",\"    \\\"preprocessing\\\": {\\n\",\"        \\\"direct_resize\\\": True,\\n\",\"        \\\"mtcnn_detection_used\\\": False,\\n\",\"        \\\"facial_alignment_used\\\": False,\\n\",\"        \\\"differs_from_experiment18\\\": True\\n\",\"    },\\n\",\"    \\\"architecture_validation\\\": {\\n\",\"        \\\"stage2_architectures_evaluated\\\": 1,\\n\",\"        \\\"independent_architecture_validation\\\": False\\n\",\"    },\\n\",\"    \\\"evaluation_scope\\\": {\\n\",\"        \\\"recognition_accuracy_evaluated\\\": False,\\n\",\"        \\\"fairness_evaluated\\\": False,\\n\",\"        \\\"operational_drift_detection_validated\\\": False,\\n\",\"        \\\"deployment_readiness_established\\\": False,\\n\",\"        \\\"cross_architecture_generalisation_established\\\": False\\n\",\"    }\\n\",\"}\\n\",\"\\n\",\"checks = {\\n\",\"    \\\"community_hosted_provenance_disclosed\\\":\\n\",\"        \\\"community-hosted Academic Torrents listing\\\" in section_text,\\n\",\"    \\\"no_official_checksum_authentication_claim\\\":\\n\",\"        \\\"not independently authenticated against an official UCSD checksum\\\" in section_text,\\n\",\"    \\\"archive_integrity_distinguished_from_authentication\\\":\\n\",\"        \\\"integrity checks\\\" in section_text,\\n\",\"    \\\"missing_weight_identity_disclosed\\\":\\n\",\"        \\\"weight-file identity and its SHA256 checksum were not preserved\\\" in section_text,\\n\",\"    \\\"architecture_and_pretrained_source_recorded\\\":\\n\",\"        \\\"architecture, VGGFace2 pretrained source, software versions\\\" in section_text,\\n\",\"    \\\"different_capture_limitation_disclosed\\\":\\n\",\"        \\\"different image captures of the same identities\\\" in section_text,\\n\",\"    \\\"no_exclusive_illumination_causality_claim\\\":\\n\",\"        \\\"cannot be attributed exclusively to illumination\\\" in section_text,\\n\",\"    \\\"single_reference_limitation_disclosed\\\":\\n\",\"        \\\"one reference embedding per identity\\\" in section_text,\\n\",\"    \\\"covariance_limitation_disclosed\\\":\\n\",\"        \\\"does not provide sufficient observations to estimate identity-specific covariance reliably\\\" in section_text,\\n\",\"    \\\"no_mtcnn_or_alignment_disclosed\\\":\\n\",\"        \\\"without MTCNN face detection or facial alignment\\\" in section_text,\\n\",\"    \\\"experiment18_preprocessing_difference_disclosed\\\":\\n\",\"        \\\"differs from the MTCNN-based preprocessing used in Experiment 18\\\" in section_text,\\n\",\"    \\\"single_architecture_limitation_disclosed\\\":\\n\",\"        \\\"single pretrained architecture\\\" in section_text,\\n\",\"    \\\"no_recognition_accuracy_claim\\\":\\n\",\"        \\\"does not establish verification accuracy\\\" in section_text,\\n\",\"    \\\"no_fairness_claim\\\":\\n\",\"        \\\"fairness\\\" in section_text,\\n\",\"    \\\"no_operational_drift_validation_claim\\\":\\n\",\"        \\\"operational drift-detection system\\\" in section_text,\\n\",\"    \\\"no_deployment_readiness_claim\\\":\\n\",\"        \\\"deployment readiness\\\" in section_text,\\n\",\"    \\\"no_cross_architecture_generalisation_claim\\\":\\n\",\"        \\\"generalisation to other datasets and recognition architectures\\\" in section_text\\n\",\"}\\n\",\"\\n\",\"word_count = len(re.findall(r\\\"\\\\b[\\\\w'-]+\\\\b\\\", section_text))\\n\",\"\\n\",\"markdown_content = f\\\"# {section_title}\\\\n\\\\n{section_text}\\\\n\\\"\\n\",\"\\n\",\"markdown_path = OUTPUT_DIR / \\\"experiment20_methodology_3_10_limitations_reproducibility.md\\\"\\n\",\"json_path = OUTPUT_DIR / \\\"experiment20_step3311_limitations_reproducibility.json\\\"\\n\",\"audit_path = OUTPUT_DIR / \\\"experiment20_step3311_limitations_reproducibility_audit.json\\\"\\n\",\"\\n\",\"markdown_path.write_text(markdown_content, encoding=\\\"utf-8\\\")\\n\",\"\\n\",\"record = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"phase\\\": \\\"3.3\\\",\\n\",\"    \\\"step\\\": \\\"3.3.9.11\\\",\\n\",\"    \\\"subsection\\\": section_title,\\n\",\"    \\\"created_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"draft_text\\\": section_text,\\n\",\"    \\\"verified_limitations\\\": facts,\\n\",\"    \\\"word_count\\\": word_count,\\n\",\"    \\\"checks\\\": checks,\\n\",\"    \\\"passed_checks\\\": sum(checks.values()),\\n\",\"    \\\"total_checks\\\": len(checks),\\n\",\"    \\\"failed_checks\\\": [\\n\",\"        name for name, passed in checks.items() if not passed\\n\",\"    ],\\n\",\"    \\\"status\\\": (\\n\",\"        \\\"DRAFT_CONSISTENCY_CHECK_PASSED\\\"\\n\",\"        if all(checks.values())\\n\",\"        else \\\"DRAFT_REQUIRES_REVIEW\\\"\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"json_path.write_text(\\n\",\"    json.dumps(record, indent=2, ensure_ascii=False),\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\")\\n\",\"\\n\",\"audit = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"    \\\"step\\\": \\\"3.3.9.11\\\",\\n\",\"    \\\"created_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"word_count\\\": word_count,\\n\",\"    \\\"checks\\\": checks,\\n\",\"    \\\"passed_checks\\\": sum(checks.values()),\\n\",\"    \\\"total_checks\\\": len(checks),\\n\",\"    \\\"failed_checks\\\": record[\\\"failed_checks\\\"],\\n\",\"    \\\"status\\\": record[\\\"status\\\"],\\n\",\"    \\\"files\\\": {\\n\",\"        \\\"markdown\\\": str(markdown_path),\\n\",\"        \\\"json\\\": str(json_path)\\n\",\"    }\\n\",\"}\\n\",\"\\n\",\"audit_path.write_text(\\n\",\"    json.dumps(audit, indent=2, ensure_ascii=False),\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\")\\n\",\"\\n\",\"assert markdown_path.read_text(encoding=\\\"utf-8\\\") == markdown_content\\n\",\"assert json.loads(json_path.read_text(encoding=\\\"utf-8\\\")) == record\\n\",\"assert json.loads(audit_path.read_text(encoding=\\\"utf-8\\\")) == audit\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.3.9.11\\\")\\n\",\"print(\\\"METHODOLOGICAL LIMITATIONS AND REPRODUCIBILITY\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"print(\\\"\\\\nWord count:\\\", word_count)\\n\",\"\\n\",\"print(\\\"\\\\nConsistency checks:\\\")\\n\",\"for name, passed in checks.items():\\n\",\"    print(f\\\"{name}: {'PASS' if passed else 'FAIL'}\\\")\\n\",\"\\n\",\"print(f\\\"\\\\nPassed: {record['passed_checks']} / {record['total_checks']}\\\")\\n\",\"print(\\\"Failed:\\\", len(record[\\\"failed_checks\\\"]))\\n\",\"print(\\\"Status:\\\", record[\\\"status\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nMarkdown reload: PASS\\\")\\n\",\"print(\\\"JSON reload: PASS\\\")\\n\",\"print(\\\"Audit reload: PASS\\\")\\n\",\"\\n\",\"print(\\\"\\\\nSaved files:\\\")\\n\",\"print(markdown_path)\\n\",\"print(json_path)\\n\",\"print(audit_path)\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 88)\\n\",\"print(\\\"DRAFT TEXT\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(markdown_content)\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"Sw3KOBEfMo8G\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794393677955,\"user_tz\":360,\"elapsed\":209,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"d3c6adbf-9d20-4336-9f1b-3a174c8cf2b5\"},\"execution_count\":76,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.3.9.11\\n\",\"METHODOLOGICAL LIMITATIONS AND REPRODUCIBILITY\\n\",\"========================================================================================\\n\",\"\\n\",\"Word count: 270\\n\",\"\\n\",\"Consistency checks:\\n\",\"community_hosted_provenance_disclosed: PASS\\n\",\"no_official_checksum_authentication_claim: PASS\\n\",\"archive_integrity_distinguished_from_authentication: PASS\\n\",\"missing_weight_identity_disclosed: PASS\\n\",\"architecture_and_pretrained_source_recorded: PASS\\n\",\"different_capture_limitation_disclosed: PASS\\n\",\"no_exclusive_illumination_causality_claim: PASS\\n\",\"single_reference_limitation_disclosed: PASS\\n\",\"covariance_limitation_disclosed: PASS\\n\",\"no_mtcnn_or_alignment_disclosed: PASS\\n\",\"experiment18_preprocessing_difference_disclosed: PASS\\n\",\"single_architecture_limitation_disclosed: PASS\\n\",\"no_recognition_accuracy_claim: PASS\\n\",\"no_fairness_claim: PASS\\n\",\"no_operational_drift_validation_claim: PASS\\n\",\"no_deployment_readiness_claim: PASS\\n\",\"no_cross_architecture_generalisation_claim: PASS\\n\",\"\\n\",\"Passed: 17 / 17\\n\",\"Failed: 0\\n\",\"Status: DRAFT_CONSISTENCY_CHECK_PASSED\\n\",\"\\n\",\"Markdown reload: PASS\\n\",\"JSON reload: PASS\\n\",\"Audit reload: PASS\\n\",\"\\n\",\"Saved files:\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3311/experiment20_methodology_3_10_limitations_reproducibility.md\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3311/experiment20_step3311_limitations_reproducibility.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3311/experiment20_step3311_limitations_reproducibility_audit.json\\n\",\"\\n\",\"========================================================================================\\n\",\"DRAFT TEXT\\n\",\"========================================================================================\\n\",\"# 3.10 Methodological Limitations and Reproducibility\\n\",\"\\n\",\"Several methodological limitations should be considered when interpreting the findings and assessing reproducibility. First, the Cropped Extended Yale B subset was obtained through a community-hosted Academic Torrents listing. Although the acquired archive and frozen dataset were recorded using SHA256 checksums and integrity checks, the source was not independently authenticated against an official UCSD checksum. The dataset should therefore be described according to its documented acquisition provenance rather than as an independently authenticated official release.\\n\",\"\\n\",\"Second, the exact pretrained InceptionResnetV1 weight-file identity and its SHA256 checksum were not preserved. The architecture, VGGFace2 pretrained source, software versions, and inference configuration were recorded, but these records do not establish that an independent reproduction would load byte-identical model weights.\\n\",\"\\n\",\"Third, the illumination conditions comprise different image captures of the same identities rather than exact transformations of identical source images. The observed embedding differences therefore cannot be attributed exclusively to illumination; other capture-related variation may also contribute. In addition, the analysis used one reference embedding per identity, which does not provide sufficient observations to estimate identity-specific covariance reliably.\\n\",\"\\n\",\"Fourth, the selected cropped images were processed using direct resizing without MTCNN face detection or facial alignment. This procedure differs from the MTCNN-based preprocessing used in Experiment 18, limiting direct comparability between the two experimental stages. The Stage 2 evaluation also used a single pretrained architecture and did not include independent architecture validation.\\n\",\"\\n\",\"Finally, the study characterises reference-relative embedding displacement rather than biometric recognition performance or an operational drift-detection system. It does not establish verification accuracy, fairness, deployment readiness, or generalisation to other datasets and recognition architectures. These boundaries should be retained when interpreting the empirical findings.\\n\",\"\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.3.9.12\\n\",\"## Methodological Correction: Cosine-Distance Definition\\n\",\"\\n\",\"The cosine-distance description in Step 3.3.9.7 requires technical clarification. Cosine distance is defined as one minus cosine similarity; it is not itself an angle measured in degrees or radians.\\n\",\"\\n\",\"Because the embeddings were L2-normalised, Euclidean distance and cosine distance are mathematically related. The manuscript should acknowledge this relationship when describing the two metrics.\"],\"metadata\":{\"id\":\"xQNr1ZFcM0xR\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"TARGET_DIR = BASE / \\\"step_3_3\\\" / \\\"step_3397\\\"\\n\",\"\\n\",\"markdown_path = TARGET_DIR / \\\"experiment20_methodology_3_6_reference_relative_distances.md\\\"\\n\",\"json_path = TARGET_DIR / \\\"experiment20_step3397_reference_relative_distances.json\\\"\\n\",\"audit_path = TARGET_DIR / \\\"experiment20_step3397_reference_relative_distances_audit.json\\\"\\n\",\"\\n\",\"assert markdown_path.exists(), \\\"Original methodology Markdown not found.\\\"\\n\",\"assert json_path.exists(), \\\"Original methodology JSON not found.\\\"\\n\",\"assert audit_path.exists(), \\\"Original methodology audit not found.\\\"\\n\",\"\\n\",\"old_sentence = (\\n\",\"    \\\"Cosine distance measured the angular difference between the same \\\"\\n\",\"    \\\"pair of embedding vectors.\\\"\\n\",\")\\n\",\"\\n\",\"new_sentence = (\\n\",\"    \\\"Cosine distance was calculated as one minus the cosine similarity \\\"\\n\",\"    \\\"between the same pair of embedding vectors.\\\"\\n\",\")\\n\",\"\\n\",\"old_relationship = (\\n\",\"    \\\"Both measures were calculated for each evaluation observation and \\\"\\n\",\"    \\\"retained alongside its identity and illumination-condition metadata.\\\"\\n\",\")\\n\",\"\\n\",\"new_relationship = (\\n\",\"    \\\"Both measures were calculated for each evaluation observation and \\\"\\n\",\"    \\\"retained alongside its identity and illumination-condition metadata. \\\"\\n\",\"    \\\"Because the embeddings were L2-normalised, the two distances are \\\"\\n\",\"    \\\"mathematically related: squared Euclidean distance equals twice \\\"\\n\",\"    \\\"cosine distance. They therefore provide related, rather than \\\"\\n\",\"    \\\"independent, measures of embedding displacement.\\\"\\n\",\")\\n\",\"\\n\",\"markdown_text = markdown_path.read_text(encoding=\\\"utf-8\\\")\\n\",\"\\n\",\"assert old_sentence in markdown_text, (\\n\",\"    \\\"Expected original cosine-distance sentence was not found. \\\"\\n\",\"    \\\"No files have been modified.\\\"\\n\",\")\\n\",\"assert old_relationship in markdown_text, (\\n\",\"    \\\"Expected metric-description sentence was not found. \\\"\\n\",\"    \\\"No files have been modified.\\\"\\n\",\")\\n\",\"\\n\",\"markdown_text = markdown_text.replace(old_sentence, new_sentence, 1)\\n\",\"markdown_text = markdown_text.replace(\\n\",\"    old_relationship, new_relationship, 1\\n\",\")\\n\",\"\\n\",\"record = json.loads(json_path.read_text(encoding=\\\"utf-8\\\"))\\n\",\"audit = json.loads(audit_path.read_text(encoding=\\\"utf-8\\\"))\\n\",\"\\n\",\"record[\\\"draft_text\\\"] = markdown_text.split(\\\"\\\\n\\\\n\\\", 1)[1].strip()\\n\",\"record[\\\"verified_analysis_facts\\\"][\\\"cosine_distance_definition\\\"] = (\\n\",\"    \\\"one minus cosine similarity\\\"\\n\",\")\\n\",\"record[\\\"verified_analysis_facts\\\"][\\\"normalised_metric_relationship\\\"] = (\\n\",\"    \\\"squared Euclidean distance equals twice cosine distance\\\"\\n\",\")\\n\",\"record[\\\"verified_analysis_facts\\\"][\\\"metrics_are_independent\\\"] = False\\n\",\"record[\\\"methodological_correction\\\"] = {\\n\",\"    \\\"step\\\": \\\"3.3.9.12\\\",\\n\",\"    \\\"correction\\\": \\\"Clarified cosine distance definition and relationship to Euclidean distance for L2-normalised embeddings.\\\",\\n\",\"    \\\"previous_wording\\\": old_sentence,\\n\",\"    \\\"replacement_wording\\\": new_sentence,\\n\",\"    \\\"corrected_utc\\\": datetime.now(timezone.utc).isoformat()\\n\",\"}\\n\",\"\\n\",\"checks = {\\n\",\"    \\\"cosine_distance_defined_as_one_minus_similarity\\\":\\n\",\"        \\\"one minus the cosine similarity\\\" in markdown_text,\\n\",\"    \\\"angular_difference_wording_removed\\\":\\n\",\"        old_sentence not in markdown_text,\\n\",\"    \\\"normalised_embedding_relationship_documented\\\":\\n\",\"        \\\"squared Euclidean distance equals twice cosine distance\\\" in markdown_text,\\n\",\"    \\\"metrics_not_described_as_independent\\\":\\n\",\"        \\\"rather than independent\\\" in markdown_text,\\n\",\"    \\\"reference_condition_retained\\\":\\n\",\"        \\\"A+000E+00\\\" in markdown_text,\\n\",\"    \\\"evaluation_count_retained\\\":\\n\",\"        \\\"2,128 non-reference observations\\\" in markdown_text,\\n\",\"    \\\"both_metrics_retained\\\":\\n\",\"        \\\"Euclidean displacement\\\" in markdown_text and\\n\",\"        \\\"Cosine distance\\\" in markdown_text\\n\",\"}\\n\",\"\\n\",\"record[\\\"checks\\\"] = checks\\n\",\"record[\\\"passed_checks\\\"] = sum(checks.values())\\n\",\"record[\\\"total_checks\\\"] = len(checks)\\n\",\"record[\\\"failed_checks\\\"] = [\\n\",\"    name for name, passed in checks.items() if not passed\\n\",\"]\\n\",\"record[\\\"status\\\"] = (\\n\",\"    \\\"TECHNICAL_CORRECTION_PASSED\\\"\\n\",\"    if all(checks.values())\\n\",\"    else \\\"CORRECTION_REQUIRES_REVIEW\\\"\\n\",\")\\n\",\"\\n\",\"audit.update({\\n\",\"    \\\"created_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"correction_step\\\": \\\"3.3.9.12\\\",\\n\",\"    \\\"checks\\\": checks,\\n\",\"    \\\"passed_checks\\\": sum(checks.values()),\\n\",\"    \\\"total_checks\\\": len(checks),\\n\",\"    \\\"failed_checks\\\": record[\\\"failed_checks\\\"],\\n\",\"    \\\"status\\\": record[\\\"status\\\"]\\n\",\"})\\n\",\"\\n\",\"markdown_path.write_text(markdown_text, encoding=\\\"utf-8\\\")\\n\",\"json_path.write_text(\\n\",\"    json.dumps(record, indent=2, ensure_ascii=False),\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\")\\n\",\"audit_path.write_text(\\n\",\"    json.dumps(audit, indent=2, ensure_ascii=False),\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\")\\n\",\"\\n\",\"# Reload verification\\n\",\"saved_markdown = markdown_path.read_text(encoding=\\\"utf-8\\\")\\n\",\"saved_record = json.loads(json_path.read_text(encoding=\\\"utf-8\\\"))\\n\",\"saved_audit = json.loads(audit_path.read_text(encoding=\\\"utf-8\\\"))\\n\",\"\\n\",\"assert saved_markdown == markdown_text\\n\",\"assert saved_record == record\\n\",\"assert saved_audit == audit\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.3.9.12\\\")\\n\",\"print(\\\"COSINE-DISTANCE TECHNICAL CORRECTION\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"for name, passed in checks.items():\\n\",\"    print(f\\\"{name}: {'PASS' if passed else 'FAIL'}\\\")\\n\",\"\\n\",\"print(f\\\"\\\\nPassed: {sum(checks.values())} / {len(checks)}\\\")\\n\",\"print(\\\"Failed:\\\", len(record[\\\"failed_checks\\\"]))\\n\",\"print(\\\"Status:\\\", record[\\\"status\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nMarkdown reload: PASS\\\")\\n\",\"print(\\\"JSON reload: PASS\\\")\\n\",\"print(\\\"Audit reload: PASS\\\")\\n\",\"\\n\",\"print(\\\"\\\\nUpdated files:\\\")\\n\",\"print(markdown_path)\\n\",\"print(json_path)\\n\",\"print(audit_path)\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 88)\\n\",\"print(\\\"CORRECTED METHODOLOGY SUBSECTION\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(saved_markdown)\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"crbTGHGQM3VV\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794393737936,\"user_tz\":360,\"elapsed\":182,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"e7a42e6f-6427-4fd4-c44b-e1d6ab4b4586\"},\"execution_count\":77,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.3.9.12\\n\",\"COSINE-DISTANCE TECHNICAL CORRECTION\\n\",\"========================================================================================\\n\",\"cosine_distance_defined_as_one_minus_similarity: PASS\\n\",\"angular_difference_wording_removed: PASS\\n\",\"normalised_embedding_relationship_documented: PASS\\n\",\"metrics_not_described_as_independent: PASS\\n\",\"reference_condition_retained: PASS\\n\",\"evaluation_count_retained: PASS\\n\",\"both_metrics_retained: PASS\\n\",\"\\n\",\"Passed: 7 / 7\\n\",\"Failed: 0\\n\",\"Status: TECHNICAL_CORRECTION_PASSED\\n\",\"\\n\",\"Markdown reload: PASS\\n\",\"JSON reload: PASS\\n\",\"Audit reload: PASS\\n\",\"\\n\",\"Updated files:\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3397/experiment20_methodology_3_6_reference_relative_distances.md\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3397/experiment20_step3397_reference_relative_distances.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3397/experiment20_step3397_reference_relative_distances_audit.json\\n\",\"\\n\",\"========================================================================================\\n\",\"CORRECTED METHODOLOGY SUBSECTION\\n\",\"========================================================================================\\n\",\"# 3.6 Embedding Normalisation and Reference-Relative Distance Calculation\\n\",\"\\n\",\"The extracted 512-dimensional embeddings were L2-normalised before the reference-relative displacement analysis. For each of the 38 identities, the embedding associated with the reference illumination condition A+000E+00 served as that identity's reference representation. This produced 38 identity-specific reference embeddings.\\n\",\"\\n\",\"Each non-reference embedding was matched to the reference embedding belonging to the same identity. The evaluation therefore compared identity-condition observations with their corresponding within-identity reference representations rather than using a single reference vector shared across all subjects. After excluding the reference observations, the analysis included 2,128 non-reference observations across 56 common evaluation conditions.\\n\",\"\\n\",\"Two distance measures were used to characterise reference-relative embedding displacement. Euclidean displacement measured the L2 distance between an evaluation embedding and its corresponding identity-specific reference embedding. Cosine distance was calculated as one minus the cosine similarity between the same pair of embedding vectors. Both measures were calculated for each evaluation observation and retained alongside its identity and illumination-condition metadata. Because the embeddings were L2-normalised, the two distances are mathematically related: squared Euclidean distance equals twice cosine distance. They therefore provide related, rather than independent, measures of embedding displacement.\\n\",\"\\n\",\"The resulting observation-level distances were subsequently grouped by illumination geometry for descriptive and identity-level statistical analysis. The distance calculations quantify changes in embedding representation relative to the selected reference capture. They do not, by themselves, establish a change in recognition accuracy, identity verification performance, or an operational biometric drift event.\\n\",\"\\n\",\"The analysis was descriptive: no operational detection thresholds, calibrated false-alarm rates, or classification decisions were derived from these distances. The reference-relative comparisons should also be interpreted in light of the use of different image captures across illumination conditions, rather than exact transformations of identical source images.\\n\",\"\\n\",\"========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.3.9.13\\n\",\"## Audit: Illumination-Angle Unit and Formula Verification\\n\",\"\\n\",\"Objective:\\n\",\"Verify how illumination azimuth and elevation values were converted and used when calculating angular deviation.\\n\",\"\\n\",\"The audit must establish:\\n\",\"1. Whether the source angles were recorded in degrees.\\n\",\"2. Whether degree-to-radian conversion was applied before trigonometric operations.\\n\",\"3. Whether the inverse cosine result was converted to degrees.\\n\",\"4. Whether the implementation matches the documented angular grouping formula.\\n\",\"\\n\",\"No manuscript or experimental data will be modified in this step.\"],\"metadata\":{\"id\":\"fvZCMQy5NC1w\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import re\\n\",\"import json\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"\\n\",\"SEARCH_DIRS = [\\n\",\"    BASE / \\\"dataset_audit\\\",\\n\",\"    BASE / \\\"step_2_7\\\",\\n\",\"    BASE / \\\"step_3_1\\\",\\n\",\"    BASE / \\\"step_3_2\\\",\\n\",\"    BASE / \\\"step_3_3\\\"\\n\",\"]\\n\",\"\\n\",\"PATTERNS = [\\n\",\"    r\\\"arccos\\\",\\n\",\"    r\\\"acos\\\",\\n\",\"    r\\\"deg2rad\\\",\\n\",\"    r\\\"radians\\\",\\n\",\"    r\\\"rad2deg\\\",\\n\",\"    r\\\"degrees\\\",\\n\",\"    r\\\"azimuth\\\",\\n\",\"    r\\\"elevation\\\",\\n\",\"    r\\\"illumination.*angle\\\",\\n\",\"    r\\\"angular.*deviation\\\",\\n\",\"    r\\\"theta\\\"\\n\",\"]\\n\",\"\\n\",\"EXTENSIONS = {\\\".py\\\", \\\".ipynb\\\", \\\".json\\\", \\\".md\\\", \\\".txt\\\"}\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.3.9.13\\\")\\n\",\"print(\\\"ILLUMINATION-ANGLE UNIT AND FORMULA AUDIT\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"files_scanned = 0\\n\",\"matches_found = 0\\n\",\"candidate_files = []\\n\",\"\\n\",\"for directory in SEARCH_DIRS:\\n\",\"    if not directory.exists():\\n\",\"        print(f\\\"\\\\nDirectory unavailable: {directory}\\\")\\n\",\"        continue\\n\",\"\\n\",\"    for path in directory.rglob(\\\"*\\\"):\\n\",\"        if not path.is_file() or path.suffix.lower() not in EXTENSIONS:\\n\",\"            continue\\n\",\"\\n\",\"        try:\\n\",\"            content = path.read_text(encoding=\\\"utf-8\\\", errors=\\\"ignore\\\")\\n\",\"        except Exception:\\n\",\"            continue\\n\",\"\\n\",\"        files_scanned += 1\\n\",\"        lines = content.splitlines()\\n\",\"        matched_lines = []\\n\",\"\\n\",\"        for index, line in enumerate(lines):\\n\",\"            if any(re.search(pattern, line, re.IGNORECASE)\\n\",\"                   for pattern in PATTERNS):\\n\",\"                start = max(0, index - 2)\\n\",\"                end = min(len(lines), index + 3)\\n\",\"\\n\",\"                snippet = \\\"\\\\n\\\".join(\\n\",\"                    f\\\"{i+1}: {lines[i]}\\\"\\n\",\"                    for i in range(start, end)\\n\",\"                )\\n\",\"\\n\",\"                matched_lines.append(snippet)\\n\",\"\\n\",\"        if matched_lines:\\n\",\"            matches_found += len(matched_lines)\\n\",\"            candidate_files.append(path)\\n\",\"\\n\",\"            print(\\\"\\\\n\\\" + \\\"-\\\" * 88)\\n\",\"            print(\\\"FILE:\\\", path)\\n\",\"            print(\\\"MATCHES:\\\", len(matched_lines))\\n\",\"\\n\",\"            for snippet in matched_lines[:12]:\\n\",\"                print(\\\"\\\\n\\\" + snippet)\\n\",\"\\n\",\"            if len(matched_lines) > 12:\\n\",\"                print(\\\"\\\\nAdditional matches omitted from display.\\\")\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 88)\\n\",\"print(\\\"AUDIT SUMMARY\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"print(\\\"Files scanned:\\\", files_scanned)\\n\",\"print(\\\"Files with relevant matches:\\\", len(candidate_files))\\n\",\"print(\\\"Relevant match groups:\\\", matches_found)\\n\",\"\\n\",\"print(\\\"\\\\nCandidate source files:\\\")\\n\",\"for path in candidate_files:\\n\",\"    print(path)\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 88)\\n\",\"print(\\\"MANUAL VERIFICATION REQUIRED\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"print(\\\"\\\"\\\"\\n\",\"Please inspect the displayed source lines.\\n\",\"\\n\",\"We need evidence for all three operations:\\n\",\"\\n\",\"A. Degree-to-radian conversion before cosine:\\n\",\"   Example: np.deg2rad(azimuth) and np.deg2rad(elevation)\\n\",\"\\n\",\"B. Inverse cosine:\\n\",\"   Example: np.arccos(...)\\n\",\"\\n\",\"C. Radian-to-degree conversion after inverse cosine:\\n\",\"   Example: np.rad2deg(theta)\\n\",\"\\n\",\"Do not infer that a conversion occurred merely because the metadata\\n\",\"contains angles expressed in degrees.\\n\",\"\\n\",\"No files were modified by this audit.\\n\",\"\\\"\\\"\\\")\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"kNAV7oB_NFK4\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794393797796,\"user_tz\":360,\"elapsed\":5608,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"72d1e2c4-2353-4f03-d69f-c01c9c0164f3\"},\"execution_count\":78,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.3.9.13\\n\",\"ILLUMINATION-ANGLE UNIT AND FORMULA AUDIT\\n\",\"========================================================================================\\n\",\"\\n\",\"----------------------------------------------------------------------------------------\\n\",\"FILE: /content/drive/MyDrive/Experiment_20_Results/dataset_audit/experiment20_grouped_illumination_condition_manifest.json\\n\",\"MATCHES: 174\\n\",\"\\n\",\"47:     \\\"yaleB39\\\"\\n\",\"48:   ],\\n\",\"49:   \\\"condition_grouping_method\\\": \\\"Spherical angular deviation from frontal illumination\\\",\\n\",\"50:   \\\"angular_deviation_formula\\\": \\\"arccos(cos(elevation) * cos(azimuth))\\\",\\n\",\"51:   \\\"angle_units\\\": \\\"degrees\\\",\\n\",\"\\n\",\"48:   ],\\n\",\"49:   \\\"condition_grouping_method\\\": \\\"Spherical angular deviation from frontal illumination\\\",\\n\",\"50:   \\\"angular_deviation_formula\\\": \\\"arccos(cos(elevation) * cos(azimuth))\\\",\\n\",\"51:   \\\"angle_units\\\": \\\"degrees\\\",\\n\",\"52:   \\\"group_thresholds\\\": {\\n\",\"\\n\",\"49:   \\\"condition_grouping_method\\\": \\\"Spherical angular deviation from frontal illumination\\\",\\n\",\"50:   \\\"angular_deviation_formula\\\": \\\"arccos(cos(elevation) * cos(azimuth))\\\",\\n\",\"51:   \\\"angle_units\\\": \\\"degrees\\\",\\n\",\"52:   \\\"group_thresholds\\\": {\\n\",\"53:     \\\"near_frontal\\\": {\\n\",\"\\n\",\"132:     \\\"A+000E+00\\\": {\\n\",\"133:       \\\"condition\\\": \\\"A+000E+00\\\",\\n\",\"134:       \\\"azimuth_degrees\\\": 0,\\n\",\"135:       \\\"elevation_degrees\\\": 0,\\n\",\"136:       \\\"angular_deviation_degrees\\\": 0.0,\\n\",\"\\n\",\"133:       \\\"condition\\\": \\\"A+000E+00\\\",\\n\",\"134:       \\\"azimuth_degrees\\\": 0,\\n\",\"135:       \\\"elevation_degrees\\\": 0,\\n\",\"136:       \\\"angular_deviation_degrees\\\": 0.0,\\n\",\"137:       \\\"group\\\": \\\"near_frontal\\\"\\n\",\"\\n\",\"134:       \\\"azimuth_degrees\\\": 0,\\n\",\"135:       \\\"elevation_degrees\\\": 0,\\n\",\"136:       \\\"angular_deviation_degrees\\\": 0.0,\\n\",\"137:       \\\"group\\\": \\\"near_frontal\\\"\\n\",\"138:     },\\n\",\"\\n\",\"139:     \\\"A+000E+20\\\": {\\n\",\"140:       \\\"condition\\\": \\\"A+000E+20\\\",\\n\",\"141:       \\\"azimuth_degrees\\\": 0,\\n\",\"142:       \\\"elevation_degrees\\\": 20,\\n\",\"143:       \\\"angular_deviation_degrees\\\": 20.0,\\n\",\"\\n\",\"140:       \\\"condition\\\": \\\"A+000E+20\\\",\\n\",\"141:       \\\"azimuth_degrees\\\": 0,\\n\",\"142:       \\\"elevation_degrees\\\": 20,\\n\",\"143:       \\\"angular_deviation_degrees\\\": 20.0,\\n\",\"144:       \\\"group\\\": \\\"near_frontal\\\"\\n\",\"\\n\",\"141:       \\\"azimuth_degrees\\\": 0,\\n\",\"142:       \\\"elevation_degrees\\\": 20,\\n\",\"143:       \\\"angular_deviat