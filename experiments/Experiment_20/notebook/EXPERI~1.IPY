        "\n",
        "BASE = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "STEP_DIR = BASE / \"step_3_3\"\n",
        "STEP_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "INPUT_FILE = STEP_DIR / (\n",
        "    \"experiment20_step331_manuscript_research_framing.json\"\n",
        ")\n",
        "\n",
        "OUTPUT_FILE = STEP_DIR / (\n",
        "    \"experiment20_step333_contributions_hypotheses.json\"\n",
        ")\n",
        "\n",
        "assert INPUT_FILE.exists(), \"Step 3.3.1 research framing missing.\"\n",
        "\n",
        "with open(INPUT_FILE) as f:\n",
        "    framing = json.load(f)\n",
        "\n",
        "assert len(framing[\"research_objectives\"]) == 5\n",
        "\n",
        "record = {\n",
        "    \"experiment\": \"Experiment 20\",\n",
        "    \"phase\": \"3.3\",\n",
        "    \"step\": \"3.3.3\",\n",
        "    \"timestamp_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "\n",
        "    \"working_title\": framing[\"working_title\"],\n",
        "\n",
        "    \"contributions\": {\n",
        "        \"C1\": (\n",
        "            \"Identity-level empirical characterisation of \"\n",
        "            \"reference-relative FaceNet embedding displacement \"\n",
        "            \"across illumination geometry conditions.\"\n",
        "        ),\n",
        "        \"C2\": (\n",
        "            \"Comparative examination of Euclidean displacement \"\n",
        "            \"and cosine distance relative to a common reference.\"\n",
        "        ),\n",
        "        \"C3\": (\n",
        "            \"Repeated-measures statistical comparison of three \"\n",
        "            \"illumination geometry groups.\"\n",
        "        ),\n",
        "        \"C4\": (\n",
        "            \"Exploratory comparison of frontal and beyond-frontal \"\n",
        "            \"illumination conditions.\"\n",
        "        )\n",
        "    },\n",
        "\n",
        "    \"hypotheses\": {\n",
        "        \"H1\": {\n",
        "            \"name\": \"Illumination geometry ordering\",\n",
        "            \"statement\": (\n",
        "                \"Reference-relative embedding displacement differs \"\n",
        "                \"across near-frontal, oblique, and large-angular groups.\"\n",
        "            ),\n",
        "            \"expected_ordering\": [\n",
        "                \"near_frontal\",\n",
        "                \"oblique\",\n",
        "                \"large_angular\"\n",
        "            ],\n",
        "            \"metrics\": [\"Euclidean\", \"Cosine\"],\n",
        "            \"classification\": \"RETROSPECTIVE_DIRECTIONAL\"\n",
        "        },\n",
        "        \"H2\": {\n",
        "            \"name\": \"Identity-level consistency\",\n",
        "            \"statement\": (\n",
        "                \"The ordering of displacement across illumination \"\n",
        "                \"groups is consistent across evaluated identities.\"\n",
