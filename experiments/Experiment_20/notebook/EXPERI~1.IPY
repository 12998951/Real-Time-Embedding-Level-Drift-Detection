    {
      "cell_type": "markdown",
      "source": [
        "\n",
        "# Experiment 20 — Phase 4.3\n",
        "## Reference-Relative Displacement Calculation Audit\n",
        "\n",
        "### Objective\n",
        "\n",
        "Independently reconstruct and verify the reference-relative Euclidean displacement, cosine similarity, and cosine distance calculations using the frozen 512-dimensional FaceNet embedding archive.\n",
        "\n",
        "### Frozen inputs\n",
        "\n",
        "- FaceNet embedding archive: `experiment20_croppedyale_facenet_embeddings.npz`\n",
        "- Frozen evaluation results: `experiment20_reference_evaluation_displacement.csv`\n",
        "- Reference condition: `A+000E+00`\n",
        "- Expected identities: 38\n",
        "- Expected common illumination conditions: 57\n",
        "- Expected reference observations: 38\n",
        "- Expected evaluation observations: 2,128\n",
        "- Expected evaluation conditions: 56\n",
        "\n",
        "### Audit scope\n",
        "\n",
        "1. Verify the embedding archive and evaluation CSV hashes.\n",
        "2. Reconstruct one reference embedding for each identity.\n",
        "3. Match every evaluation observation to its correct identity-specific reference.\n",
        "4. Independently calculate Euclidean displacement.\n",
        "5. Independently calculate cosine similarity and cosine distance.\n",
        "6. Reconstruct angular deviation and illumination geometry groups.\n",
        "7. Compare reconstructed values and metadata against all frozen evaluation records.\n",
        "8. Report missing, duplicate, mismatched, or numerically inconsistent records.\n",
        "\n",
        "### Scientific boundaries\n",
        "\n",
        "- This is a computational reconstruction audit, not a new embedding-generation experiment.\n",
        "- The frozen embedding archive and evaluation CSV must remain unchanged.\n",
        "- The audit must not modify the manuscript or previously frozen evidence.\n",
        "- Numerical agreement verifies calculation consistency, not face-recognition accuracy, fairness, or deployment readiness.\n"
      ],
      "metadata": {
        "id": "g1_R5OKXScHq"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "import json\n",
        "import hashlib\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "from pathlib import Path\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "# ============================================================\n",
        "# EXPERIMENT 20 — PHASE 4.3\n",
        "# REFERENCE-RELATIVE DISPLACEMENT CALCULATION AUDIT\n",
        "# ============================================================\n",
        "\n",
        "BASE = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "\n",
        "EMBEDDING_ARCHIVE = (\n",
        "    BASE / \"embeddings\"\n",
        "    / \"experiment20_croppedyale_facenet_embeddings.npz\"\n",
        ")\n",
        "\n",
        "EVALUATION_CSV = (\n",
        "    BASE / \"step_2_7\" / \"final_freeze\"\n",
        "    / \"experiment20_reference_evaluation_displacement.csv\"\n",
        ")\n",
        "\n",
        "OUTPUT_DIR = BASE / \"step_4_3_displacement_calculation_audit\"\n",
        "\n",
        "REPORT_PATH = (\n",
        "    OUTPUT_DIR\n",
        "    / \"experiment20_phase43_displacement_calculation_audit.json\"\n",
        ")\n",
        "\n",
        "REFERENCE_CONDITION = \"A+000E+00\"\n",
        "EXPECTED_IDENTITIES = 38\n",
        "EXPECTED_COMMON_CONDITIONS = 57\n",
        "EXPECTED_REFERENCE_ROWS = 38\n",
        "EXPECTED_EVALUATION_ROWS = 2128\n",
        "EXPECTED_EVALUATION_CONDITIONS = 56\n",
        "\n",
        "EXPECTED_ARCHIVE_SHA256 = (\n",
        "    \"127ffb6e71b871ebab9ed10fd8ce5f2b78b9f3971db4075cf14b44f7df2d3c4c\"\n",
        ")\n",
        "\n",
        "EXPECTED_CSV_SHA256 = (\n",
        "    \"d24a2a6d628eca608b8ab8e6c056fb50bc7b0e1c6c34e253dfae7c9354c9892f\"\n",
        ")\n",
        "\n",
        "TOLERANCE = 1e-6\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. Utility functions\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def sha256_file(path):\n",
        "    digest = hashlib.sha256()\n",
        "    with open(path, \"rb\") as f:\n",
        "        for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n",
        "            digest.update(chunk)\n",
        "    return digest.hexdigest()\n",
        "\n",
        "\n",
        "def normalise_filename(value):\n",
        "    return Path(str(value).replace(\"\\\\\", \"/\")).name\n",
        "\n",
        "\n",
        "def normalise_label(value):\n",
        "    return str(value).strip().lower().replace(\"_\", \"-\").replace(\" \", \"-\")\n",
        "\n",
        "\n",
        "def close_enough(a, b, tolerance=TOLERANCE):\n",
        "    return bool(np.isclose(a, b, atol=tolerance, rtol=tolerance))\n",
        "\n",
        "\n",
        "checks = {}\n",
        "findings = []\n",
        "numerical_results = {}\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. Verify input files and hashes\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"=\" * 100)\n",
        "print(\"EXPERIMENT 20 — PHASE 4.3\")\n",
        "print(\"REFERENCE-RELATIVE DISPLACEMENT CALCULATION AUDIT\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "for path in [EMBEDDING_ARCHIVE, EVALUATION_CSV]:\n",
        "    if not path.exists():\n",
        "        raise FileNotFoundError(f\"Required frozen input missing: {path}\")\n",
        "\n",
        "archive_hash = sha256_file(EMBEDDING_ARCHIVE)\n",
        "csv_hash = sha256_file(EVALUATION_CSV)\n",
        "\n",
        "checks[\"embedding_archive_hash_match\"] = (\n",
        "    archive_hash == EXPECTED_ARCHIVE_SHA256\n",
        ")\n",
        "\n",
        "checks[\"evaluation_csv_hash_match\"] = (\n",
        "    csv_hash == EXPECTED_CSV_SHA256\n",
        ")\n",
        "\n",
        "print(\"\\n1. INPUT INTEGRITY\")\n",
        "print(\"Embedding archive SHA256:\", archive_hash)\n",
        "print(\"Expected archive hash:\", EXPECTED_ARCHIVE_SHA256)\n",
        "print(\"Archive hash match:\", checks[\"embedding_archive_hash_match\"])\n",
        "\n",
        "print(\"\\nEvaluation CSV SHA256:\", csv_hash)\n",
        "print(\"Expected CSV hash:\", EXPECTED_CSV_SHA256)\n",
        "print(\"CSV hash match:\", checks[\"evaluation_csv_hash_match\"])\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. Load frozen embeddings and evaluation records\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "data = np.load(EMBEDDING_ARCHIVE, allow_pickle=False)\n",
        "\n",
        "required_arrays = [\n",
        "    \"embeddings\",\n",
        "    \"filenames\",\n",
        "    \"subjects\",\n",
        "    \"azimuths\",\n",
        "    \"elevations\",\n",
        "    \"conditions\"\n",
        "]\n",
        "\n",
        "missing_arrays = [x for x in required_arrays if x not in data.files]\n",
        "\n",
        "if missing_arrays:\n",
        "    raise KeyError(f\"Missing embedding archive arrays: {missing_arrays}\")\n",
        "\n",
        "embeddings = np.asarray(data[\"embeddings\"], dtype=np.float64)\n",
        "filenames = np.asarray(data[\"filenames\"]).astype(str)\n",
        "subjects = np.asarray(data[\"subjects\"]).astype(str)\n",
        "azimuths = np.asarray(data[\"azimuths\"], dtype=float)\n",
        "elevations = np.asarray(data[\"elevations\"], dtype=float)\n",
        "conditions = np.asarray(data[\"conditions\"]).astype(str)\n",
        "\n",
        "evaluation = pd.read_csv(EVALUATION_CSV)\n",
        "\n",
        "required_columns = [\n",
        "    \"subject\",\n",
        "    \"reference_condition\",\n",
        "    \"evaluation_condition\",\n",
        "    \"reference_filename\",\n",
        "    \"evaluation_filename\",\n",
        "    \"azimuth_degrees\",\n",
        "    \"elevation_degrees\",\n",
        "    \"angular_deviation_degrees\",\n",
        "    \"illumination_group\",\n",
        "    \"hemisphere\",\n",
        "    \"euclidean_displacement\",\n",
        "    \"cosine_similarity\",\n",
        "    \"cosine_distance\"\n",
        "]\n",
        "\n",
        "missing_columns = [\n",
        "    col for col in required_columns if col not in evaluation.columns\n",
        "]\n",
        "\n",
        "if missing_columns:\n",
        "    raise KeyError(f\"Missing evaluation CSV columns: {missing_columns}\")\n",
        "\n",
        "print(\"\\n2. INPUT DIMENSIONS\")\n",
        "print(\"Embedding shape:\", embeddings.shape)\n",
        "print(\"Evaluation CSV rows:\", len(evaluation))\n",
        "print(\"Unique archive identities:\", len(np.unique(subjects)))\n",
        "print(\"Unique archive conditions:\", len(np.unique(conditions)))\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. Validate archive structure and build lookup\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "array_lengths = {\n",
        "    len(embeddings),\n",
        "    len(filenames),\n",
        "    len(subjects),\n",
        "    len(azimuths),\n",
        "    len(elevations),\n",
        "    len(conditions)\n",
        "}\n",
        "\n",
        "checks[\"archive_array_lengths_consistent\"] = len(array_lengths) == 1\n",
        "\n",
        "checks[\"embedding_shape_valid\"] = (\n",
        "    embeddings.ndim == 2\n",
        "    and embeddings.shape[1] == 512\n",
        "    and embeddings.shape[0] == 2414\n",
        ")\n",
        "\n",
        "checks[\"embeddings_all_finite\"] = bool(np.isfinite(embeddings).all())\n",
        "\n",
        "row_norms = np.linalg.norm(embeddings, axis=1)\n",
        "\n",
        "checks[\"embeddings_l2_normalised\"] = bool(\n",
        "    np.allclose(row_norms, 1.0, atol=1e-5, rtol=1e-5)\n",
        ")\n",
        "\n",
        "archive_df = pd.DataFrame({\n",
        "    \"filename\": [normalise_filename(x) for x in filenames],\n",
        "    \"subject\": subjects,\n",
        "    \"condition\": conditions,\n",
        "    \"azimuth\": azimuths,\n",
        "    \"elevation\": elevations,\n",
        "    \"embedding_index\": np.arange(len(embeddings))\n",
        "})\n",
        "\n",
        "checks[\"archive_filename_unique\"] = (\n",
        "    not archive_df[\"filename\"].duplicated().any()\n",
        ")\n",
        "\n",
        "checks[\"archive_subject_condition_filename_unique\"] = (\n",
        "    not archive_df.duplicated(\n",
        "        subset=[\"subject\", \"condition\", \"filename\"]\n",
        "    ).any()\n",
        ")\n",
        "\n",
        "archive_lookup = {}\n",
        "\n",
        "for record in archive_df.to_dict(\"records\"):\n",
        "    key = (record[\"subject\"], record[\"filename\"])\n",
        "    archive_lookup[key] = record\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. Reconstruct reference observations\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "reference_rows = archive_df[\n",
        "    archive_df[\"condition\"] == REFERENCE_CONDITION\n",
        "].copy()\n",
        "\n",
        "reference_counts = reference_rows.groupby(\"subject\").size()\n",
        "\n",
        "reference_map = {}\n",
        "\n",
        "for record in reference_rows.to_dict(\"records\"):\n",
        "    subject = record[\"subject\"]\n",
        "    reference_map[subject] = record\n",
        "\n",
        "checks[\"reference_row_count_valid\"] = (\n",
        "    len(reference_rows) == EXPECTED_REFERENCE_ROWS\n",
        ")\n",
        "\n",
        "checks[\"reference_identity_count_valid\"] = (\n",
        "    reference_rows[\"subject\"].nunique() == EXPECTED_IDENTITIES\n",
        ")\n",
        "\n",
        "checks[\"one_reference_per_identity\"] = (\n",
        "    len(reference_counts) == EXPECTED_IDENTITIES\n",
        "    and bool((reference_counts == 1).all())\n",
        ")\n",
        "\n",
        "print(\"\\n3. REFERENCE RECONSTRUCTION\")\n",
        "print(\"Reference condition:\", REFERENCE_CONDITION)\n",
        "print(\"Reference observations:\", len(reference_rows))\n",
        "print(\"Reference identities:\", reference_rows[\"subject\"].nunique())\n",
        "print(\"One reference per identity:\", checks[\"one_reference_per_identity\"])\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. Reconstruct all evaluation calculations\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "reconstructed = []\n",
        "\n",
        "missing_evaluation_embeddings = []\n",
        "missing_reference_embeddings = []\n",
        "reference_filename_mismatches = []\n",
        "\n",
        "for row in evaluation.itertuples(index=False):\n",
        "\n",
        "    subject = str(row.subject)\n",
        "\n",
        "    evaluation_filename = normalise_filename(row.evaluation_filename)\n",
        "    reference_filename = normalise_filename(row.reference_filename)\n",
        "\n",
        "    eval_key = (subject, evaluation_filename)\n",
        "    ref_key = (subject, reference_filename)\n",
        "\n",
        "    if eval_key not in archive_lookup:\n",
        "        missing_evaluation_embeddings.append(eval_key)\n",
        "        continue\n",
        "\n",
        "    if ref_key not in archive_lookup:\n",
        "        missing_reference_embeddings.append(ref_key)\n",
        "        continue\n",
        "\n",
        "    expected_reference = reference_map.get(subject)\n",
        "\n",
        "    if expected_reference is None:\n",
        "        missing_reference_embeddings.append((subject, \"reference condition missing\"))\n",
        "        continue\n",
        "\n",
        "    if reference_filename != expected_reference[\"filename\"]:\n",
        "        reference_filename_mismatches.append({\n",
        "            \"subject\": subject,\n",
        "            \"csv_reference_filename\": reference_filename,\n",
        "            \"archive_reference_filename\": expected_reference[\"filename\"]\n",
        "        })\n",
        "\n",
        "    eval_record = archive_lookup[eval_key]\n",
        "    ref_record = archive_lookup[ref_key]\n",
        "\n",
        "    eval_embedding = embeddings[eval_record[\"embedding_index\"]]\n",
        "    ref_embedding = embeddings[ref_record[\"embedding_index\"]]\n",
        "\n",
        "    # Independent Euclidean displacement\n",
        "    euclidean = float(np.linalg.norm(eval_embedding - ref_embedding))\n",
        "\n",
        "    # Independent cosine similarity\n",
        "    denominator = (\n",
        "        np.linalg.norm(eval_embedding)\n",
        "        * np.linalg.norm(ref_embedding)\n",
        "    )\n",
        "\n",
        "    if denominator == 0:\n",
        "        cosine_similarity = float(\"nan\")\n",
        "    else:\n",
        "        cosine_similarity = float(\n",
        "            np.dot(eval_embedding, ref_embedding) / denominator\n",
        "        )\n",
        "\n",
        "    cosine_distance = float(1.0 - cosine_similarity)\n",
        "\n",
        "    # Reconstruct angular deviation from archived geometry\n",
        "    azimuth = float(eval_record[\"azimuth\"])\n",
        "    elevation = float(eval_record[\"elevation\"])\n",
        "\n",
        "    cosine_angle = (\n",
        "        np.cos(np.radians(elevation))\n",
        "        * np.cos(np.radians(azimuth))\n",
        "    )\n",
        "\n",
        "    angular_deviation = float(\n",
        "        np.degrees(np.arccos(np.clip(cosine_angle, -1.0, 1.0)))\n",
        "    )\n",
        "\n",
        "    if angular_deviation <= 30:\n",
        "        illumination_group = \"near-frontal\"\n",
        "    elif angular_deviation <= 60:\n",
        "        illumination_group = \"oblique\"\n",
        "    else:\n",
        "        illumination_group = \"large-angular\"\n",
        "\n",
        "    hemisphere = (\n",
        "        \"frontal\"\n",
        "        if angular_deviation <= 90\n",
        "        else \"beyond-frontal\"\n",
        "    )\n",
        "\n",
        "    reconstructed.append({\n",
        "        \"subject\": subject,\n",
        "        \"reference_filename\": reference_filename,\n",
        "        \"evaluation_filename\": evaluation_filename,\n",
        "        \"reference_condition\": ref_record[\"condition\"],\n",
        "        \"evaluation_condition\": eval_record[\"condition\"],\n",
        "        \"azimuth_degrees\": azimuth,\n",
        "        \"elevation_degrees\": elevation,\n",
        "        \"angular_deviation_degrees\": angular_deviation,\n",
        "        \"illumination_group\": illumination_group,\n",
        "        \"hemisphere\": hemisphere,\n",
        "        \"euclidean_displacement\": euclidean,\n",
        "        \"cosine_similarity\": cosine_similarity,\n",
        "        \"cosine_distance\": cosine_distance\n",
        "    })\n",
        "\n",
        "reconstructed_df = pd.DataFrame(reconstructed)\n",
        "\n",
        "checks[\"all_evaluation_embeddings_found\"] = (\n",
        "    len(missing_evaluation_embeddings) == 0\n",
        ")\n",
        "\n",
        "checks[\"all_reference_embeddings_found\"] = (\n",
        "    len(missing_reference_embeddings) == 0\n",
        ")\n",
        "\n",
        "checks[\"reference_filename_mapping_valid\"] = (\n",
        "    len(reference_filename_mismatches) == 0\n",
        ")\n",
        "\n",
        "checks[\"reconstructed_row_count_valid\"] = (\n",
        "    len(reconstructed_df) == EXPECTED_EVALUATION_ROWS\n",
        ")\n",
        "\n",
        "print(\"\\n4. RECONSTRUCTION\")\n",
        "print(\"Reconstructed rows:\", len(reconstructed_df))\n",
        "print(\"Missing evaluation embeddings:\", len(missing_evaluation_embeddings))\n",
        "print(\"Missing reference embeddings:\", len(missing_reference_embeddings))\n",
        "print(\"Reference filename mismatches:\", len(reference_filename_mismatches))\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. Compare numerical calculations with frozen CSV\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "if len(reconstructed_df) != len(evaluation):\n",
        "    findings.append(\n",
        "        \"Reconstructed row count differs from frozen evaluation CSV.\"\n",
        "    )\n",
        "\n",
        "comparison = evaluation.copy()\n",
        "\n",
        "comparison[\"_evaluation_filename_key\"] = (\n",
        "    comparison[\"evaluation_filename\"].map(normalise_filename)\n",
        ")\n",
        "\n",
        "comparison[\"_reference_filename_key\"] = (\n",
        "    comparison[\"reference_filename\"].map(normalise_filename)\n",
        ")\n",
        "\n",
        "reconstructed_df[\"_evaluation_filename_key\"] = (\n",
        "    reconstructed_df[\"evaluation_filename\"].map(normalise_filename)\n",
        ")\n",
        "\n",
        "reconstructed_df[\"_reference_filename_key\"] = (\n",
        "    reconstructed_df[\"reference_filename\"].map(normalise_filename)\n",
        ")\n",
        "\n",
        "comparison_key = [\n",
        "    \"subject\",\n",
        "    \"_reference_filename_key\",\n",
        "    \"_evaluation_filename_key\"\n",
        "]\n",
        "\n",
        "checks[\"evaluation_keys_unique\"] = (\n",
        "    not comparison.duplicated(subset=comparison_key).any()\n",
        ")\n",
        "\n",
        "checks[\"reconstructed_keys_unique\"] = (\n",
        "    not reconstructed_df.duplicated(subset=comparison_key).any()\n",
        ")\n",
        "\n",
        "merged = comparison.merge(\n",
        "    reconstructed_df,\n",
        "    on=comparison_key,\n",
        "    how=\"outer\",\n",
        "    suffixes=(\"_csv\", \"_reconstructed\"),\n",
        "    indicator=True\n",
        ")\n",
        "\n",
        "checks[\"all_records_matched\"] = bool((merged[\"_merge\"] == \"both\").all())\n",
        "\n",
        "matched = merged[merged[\"_merge\"] == \"both\"].copy()\n",
        "\n",
        "numeric_fields = [\n",
        "    \"euclidean_displacement\",\n",
        "    \"cosine_similarity\",\n",
        "    \"cosine_distance\",\n",
        "    \"azimuth_degrees\",\n",
        "    \"elevation_degrees\",\n",
        "    \"angular_deviation_degrees\"\n",
        "]\n",
        "\n",
        "numeric_comparison = {}\n",
        "\n",
        "for field in numeric_fields:\n",
        "    csv_values = pd.to_numeric(\n",
        "        matched[f\"{field}_csv\"], errors=\"coerce\"\n",
        "    ).to_numpy(dtype=float)\n",
        "\n",
        "    reconstructed_values = pd.to_numeric(\n",
        "        matched[f\"{field}_reconstructed\"], errors=\"coerce\"\n",
        "    ).to_numpy(dtype=float)\n",
        "\n",
        "    finite = (\n",
        "        np.isfinite(csv_values)\n",
        "        & np.isfinite(reconstructed_values)\n",
        "    )\n",
        "\n",
        "    if finite.all() and len(csv_values) > 0:\n",
        "        differences = np.abs(csv_values - reconstructed_values)\n",
        "\n",
        "        numeric_comparison[field] = {\n",
        "            \"rows_compared\": int(len(csv_values)),\n",
        "            \"maximum_absolute_difference\": float(differences.max()),\n",
        "            \"mean_absolute_difference\": float(differences.mean()),\n",
        "            \"within_tolerance\": bool(\n",
        "                np.allclose(\n",
        "                    csv_values,\n",
        "                    reconstructed_values,\n",
        "                    atol=TOLERANCE,\n",
        "                    rtol=TOLERANCE\n",
        "                )\n",
        "            )\n",
        "        }\n",
        "    else:\n",
        "        numeric_comparison[field] = {\n",
        "            \"rows_compared\": int(len(csv_values)),\n",
        "            \"within_tolerance\": False,\n",
        "            \"nonfinite_values_detected\": True\n",
        "        }\n",
        "\n",
        "    checks[f\"{field}_matches\"] = (\n",
        "        numeric_comparison[field][\"within_tolerance\"]\n",
        "    )\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 8. Compare categorical metadata\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "categorical_fields = [\n",
        "    \"reference_condition\",\n",
        "    \"evaluation_condition\",\n",
        "    \"illumination_group\",\n",
        "    \"hemisphere\"\n",
        "]\n",
        "\n",
        "categorical_comparison = {}\n",
        "\n",
        "for field in categorical_fields:\n",
        "    csv_values = matched[f\"{field}_csv\"].astype(str).map(normalise_label)\n",
        "    reconstructed_values = (\n",
        "        matched[f\"{field}_reconstructed\"]\n",
        "        .astype(str)\n",
        "        .map(normalise_label)\n",
        "    )\n",
        "\n",
        "    mismatches = int((csv_values != reconstructed_values).sum())\n",
        "\n",
        "    categorical_comparison[field] = {\n",
        "        \"rows_compared\": int(len(matched)),\n",
        "        \"mismatches\": mismatches,\n",
        "        \"match\": mismatches == 0\n",
        "    }\n",
        "\n",
        "    checks[f\"{field}_matches\"] = mismatches == 0\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 9. Verify cohort and condition counts\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "checks[\"evaluation_identity_count_valid\"] = (\n",
        "    evaluation[\"subject\"].nunique() == EXPECTED_IDENTITIES\n",
        ")\n",
        "\n",
        "checks[\"evaluation_condition_count_valid\"] = (\n",
        "    evaluation[\"evaluation_condition\"].nunique()\n",
        "    == EXPECTED_EVALUATION_CONDITIONS\n",
        ")\n",
        "\n",
        "checks[\"evaluation_reference_condition_valid\"] = (\n",
        "    evaluation[\"reference_condition\"].nunique() == 1\n",
        "    and evaluation[\"reference_condition\"].iloc[0] == REFERENCE_CONDITION\n",
        ")\n",
        "\n",
        "checks[\"evaluation_subject_reference_pairs_valid\"] = (\n",
        "    evaluation[[\"subject\", \"reference_filename\"]]\n",
        "    .drop_duplicates()\n",
        "    .shape[0] == EXPECTED_IDENTITIES\n",
        ")\n",
        "\n",
        "# Reconstructed geometry counts\n",
        "geometry_counts = (\n",
        "    reconstructed_df[\"illumination_group\"].value_counts().to_dict()\n",
        "    if len(reconstructed_df) else {}\n",
        ")\n",
        "\n",
        "hemisphere_counts = (\n",
        "    reconstructed_df[\"hemisphere\"].value_counts().to_dict()\n",
        "    if len(reconstructed_df) else {}\n",
        ")\n",
        "\n",
        "condition_counts = (\n",
        "    reconstructed_df[\"evaluation_condition\"].nunique()\n",
        "    if len(reconstructed_df) else 0\n",
        ")\n",
        "\n",
        "checks[\"reconstructed_condition_count_valid\"] = (\n",
        "    condition_counts == EXPECTED_EVALUATION_CONDITIONS\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 10. Numerical relationship diagnostic\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "if len(reconstructed_df):\n",
        "    euclidean_squared = (\n",
        "        reconstructed_df[\"euclidean_displacement\"].to_numpy() ** 2\n",
        "    )\n",
        "\n",
        "    twice_cosine_distance = (\n",
        "        2.0 * reconstructed_df[\"cosine_distance\"].to_numpy()\n",
        "    )\n",
        "\n",
        "    relation_error = np.abs(\n",
        "        euclidean_squared - twice_cosine_distance\n",
        "    )\n",
        "\n",
        "    numerical_results[\"l2_euclidean_cosine_identity\"] = {\n",
        "        \"maximum_absolute_difference\": float(relation_error.max()),\n",
        "        \"within_tolerance\": bool(\n",
        "            np.allclose(\n",
        "                euclidean_squared,\n",
        "                twice_cosine_distance,\n",
        "                atol=1e-5,\n",
        "                rtol=1e-5\n",
        "            )\n",
        "        ),\n",
        "        \"interpretation\": (\n",
        "            \"For L2-normalised embeddings, squared Euclidean distance \"\n",
        "            \"should equal twice the cosine distance.\"\n",
        "        )\n",
        "    }\n",
        "\n",
        "    checks[\"l2_euclidean_cosine_relationship_valid\"] = (\n",
        "        numerical_results[\"l2_euclidean_cosine_identity\"][\"within_tolerance\"]\n",
        "    )\n",
        "else:\n",
        "    checks[\"l2_euclidean_cosine_relationship_valid\"] = False\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 11. Final audit summary\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "failed_checks = [\n",
        "    key for key, value in checks.items()\n",
        "    if value is not True\n",
        "]\n",
        "\n",
        "audit_status = (\n",
        "    \"PHASE_4_3_PASSED\"\n",
        "    if not failed_checks\n",
        "    else \"PHASE_4_3_REVIEW_REQUIRED\"\n",
        ")\n",
        "\n",
        "report = {\n",
        "    \"experiment\": \"Experiment 20\",\n",
        "    \"phase\": \"4.3\",\n",
        "    \"audit_name\": \"Reference-Relative Displacement Calculation Audit\",\n",
        "    \"timestamp_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "\n",
        "    \"input_files\": {\n",
        "        \"embedding_archive\": str(EMBEDDING_ARCHIVE),\n",
        "        \"embedding_archive_sha256\": archive_hash,\n",
        "        \"evaluation_csv\": str(EVALUATION_CSV),\n",
        "        \"evaluation_csv_sha256\": csv_hash,\n",
        "        \"expected_archive_sha256\": EXPECTED_ARCHIVE_SHA256,\n",
        "        \"expected_evaluation_csv_sha256\": EXPECTED_CSV_SHA256\n",
        "    },\n",
        "\n",
        "    \"expected_cohort\": {\n",
        "        \"identities\": EXPECTED_IDENTITIES,\n",
        "        \"common_conditions\": EXPECTED_COMMON_CONDITIONS,\n",
        "        \"reference_condition\": REFERENCE_CONDITION,\n",
        "        \"reference_observations\": EXPECTED_REFERENCE_ROWS,\n",
        "        \"evaluation_conditions\": EXPECTED_EVALUATION_CONDITIONS,\n",
        "        \"evaluation_observations\": EXPECTED_EVALUATION_ROWS\n",
        "    },\n",
        "\n",
        "    \"observed_cohort\": {\n",
        "        \"embedding_rows\": int(len(embeddings)),\n",
        "        \"embedding_dimensions\": int(embeddings.shape[1]),\n",
        "        \"archive_identities\": int(len(np.unique(subjects))),\n",
        "        \"archive_conditions\": int(len(np.unique(conditions))),\n",
        "        \"reference_rows\": int(len(reference_rows)),\n",
        "        \"reference_identities\": int(reference_rows[\"subject\"].nunique()),\n",
        "        \"evaluation_rows\": int(len(evaluation)),\n",
        "        \"reconstructed_rows\": int(len(reconstructed_df)),\n",
        "        \"evaluation_identities\": int(evaluation[\"subject\"].nunique()),\n",
        "        \"evaluation_conditions\": int(evaluation[\"evaluation_condition\"].nunique()),\n",
        "        \"reconstructed_geometry_counts\": geometry_counts,\n",
        "        \"reconstructed_hemisphere_counts\": hemisphere_counts\n",
        "    },\n",
        "\n",
        "    \"checks\": checks,\n",
        "    \"numeric_comparison\": numeric_comparison,\n",
        "    \"categorical_comparison\": categorical_comparison,\n",
        "    \"numerical_diagnostics\": numerical_results,\n",
        "\n",
        "    \"mapping_errors\": {\n",
        "        \"missing_evaluation_embeddings\": missing_evaluation_embeddings[:50],\n",
        "        \"missing_reference_embeddings\": missing_reference_embeddings[:50],\n",
        "        \"reference_filename_mismatches\": reference_filename_mismatches[:50]\n",
        "    },\n",
        "\n",
        "    \"failed_checks\": failed_checks,\n",
        "    \"audit_status\": audit_status,\n",
        "\n",
        "    \"limitations\": [\n",
        "        \"This audit reconstructs displacement calculations from frozen embeddings; it does not regenerate embeddings from source images.\",\n",
        "        \"Calculation agreement does not establish identity recognition accuracy.\",\n",
        "        \"Euclidean displacement and cosine distance are mathematically related for L2-normalised embeddings and are not independent evidence.\",\n",
        "        \"The audit does not establish fairness, causal illumination effects, or deployment readiness.\"\n",
        "    ],\n",
        "\n",
        "    \"modification_record\": {\n",
        "        \"manuscript_modified\": False,\n",
        "        \"embedding_archive_modified\": False,\n",
        "        \"evaluation_csv_modified\": False,\n",
        "        \"frozen_evidence_overwritten\": False\n",
        "    }\n",
        "}\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 12. Save new audit report only\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "with open(REPORT_PATH, \"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(report, f, indent=2, ensure_ascii=False)\n",
        "\n",
        "report_hash = sha256_file(REPORT_PATH)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 13. Display results\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"5. NUMERICAL COMPARISON\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "for field, result in numeric_comparison.items():\n",
        "    print(\n",
        "        f\"{field}: \"\n",
        "        f\"rows={result['rows_compared']}, \"\n",
        "        f\"max_abs_diff={result.get('maximum_absolute_difference')}, \"\n",
        "        f\"PASS={result['within_tolerance']}\"\n",
        "    )\n",
        "\n",
        "print(\"\\n6. CATEGORICAL COMPARISON\")\n",
        "\n",
        "for field, result in categorical_comparison.items():\n",
        "    print(\n",
        "        f\"{field}: \"\n",
        "        f\"mismatches={result['mismatches']}, \"\n",
        "        f\"PASS={result['match']}\"\n",
        "    )\n",
        "\n",
        "print(\"\\n7. GEOMETRY COUNTS\")\n",
        "print(json.dumps(geometry_counts, indent=2))\n",
        "\n",
        "print(\"\\n8. HEMISPHERE COUNTS\")\n",
        "print(json.dumps(hemisphere_counts, indent=2))\n",
        "\n",
        "print(\"\\n9. ALL CHECKS\")\n",
        "for key, value in checks.items():\n",
        "    print((\"PASS\" if value else \"FAIL\"), key)\n",
        "\n",
        "print(\"\\nFAILED CHECKS:\", failed_checks)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"PHASE 4.3 FINAL STATUS:\", audit_status)\n",
        "print(\"=\" * 100)\n",
        "\n",
        "print(\"\\nAudit report:\", REPORT_PATH)\n",
        "print(\"Report SHA256:\", report_hash)\n",
        "\n",
        "print(\"\\nFrozen manuscript modified: False\")\n",
        "print(\"Frozen embedding archive modified: False\")\n",
        "print(\"Frozen evaluation CSV modified: False\")\n",
        "print(\"Frozen evidence overwritten: False\")\n",
        "\n",
        "print(\"\\nFINAL RESULT:\", audit_status)\n"
      ],
