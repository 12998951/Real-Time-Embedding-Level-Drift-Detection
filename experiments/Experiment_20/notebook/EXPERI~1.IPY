      "cell_type": "markdown",
      "source": [
        "# Experiment 20 — Step 3.2.15\n",
        "## Face Landmarker Model Asset Acquisition and Integrity\n",
        "\n",
        "### Objective\n",
        "Acquire the official MediaPipe Face Landmarker model asset\n",
        "for the controlled 30-image pilot.\n",
        "\n",
        "Official model documentation:\n",
        "https://developers.google.com/edge/mediapipe/solutions/vision/face_landmarker\n",
        "\n",
        "### Requirements\n",
        "- Download the official Face Landmarker task model.\n",
        "- Record the source URL.\n",
        "- Record file size and SHA256.\n",
        "- Verify that the file is non-empty.\n",
        "- Preserve the model asset separately from the frozen dataset.\n",
        "\n",
        "### Restrictions\n",
        "- No inference.\n",
        "- No aligned image generation.\n",
        "- No modification of frozen source images.\n",
        "- No modification of existing FaceNet embeddings.\n",
        "\n",
        "### Important\n",
        "The model asset is an additional experimental dependency.\n",
        "Its checksum must be retained for reproducibility."
      ],
      "metadata": {
        "id": "PP1MjOow6zOK"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from pathlib import Path\n",
        "import urllib.request\n",
        "import hashlib\n",
        "import json\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "BASE = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "STEP_DIR = BASE / \"step_3_2\"\n",
        "MODEL_DIR = BASE / \"model_assets\"\n",
        "MODEL_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "MODEL_URL = (\n",
        "    \"https://storage.googleapis.com/mediapipe-models/\"\n",
        "    \"face_landmarker/face_landmarker/float16/1/\"\n",
        "    \"face_landmarker.task\"\n",
        ")\n",
        "\n",
        "MODEL_PATH = MODEL_DIR / \"face_landmarker.task\"\n",
        "\n",
        "OUTPUT_FILE = STEP_DIR / (\n",
        "    \"experiment20_step3215_landmarker_asset_audit.json\"\n",
        ")\n",
        "\n",
        "print(\"=\" * 88)\n",
        "print(\"EXPERIMENT 20 — STEP 3.2.15\")\n",
        "print(\"FACE LANDMARKER MODEL ASSET ACQUISITION\")\n",
        "print(\"=\" * 88)\n",
        "\n",
        "if not MODEL_PATH.exists():\n",
        "    print(\"Downloading official model asset...\")\n",
        "    urllib.request.urlretrieve(MODEL_URL, MODEL_PATH)\n",
        "else:\n",
        "    print(\"Existing model asset found; verifying it.\")\n",
        "\n",
        "assert MODEL_PATH.exists(), \"Model asset was not created.\"\n",
        "\n",
        "file_size = MODEL_PATH.stat().st_size\n",
        "assert file_size > 0, \"Model asset is empty.\"\n",
        "\n",
        "sha256 = hashlib.sha256()\n",
        "\n",
        "with open(MODEL_PATH, \"rb\") as f:\n",
        "    for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n",
        "        sha256.update(chunk)\n",
        "\n",
        "digest = sha256.hexdigest()\n",
        "\n",
        "record = {\n",
        "    \"experiment\": \"Experiment 20\",\n",
        "    \"step\": \"3.2.15\",\n",
        "    \"timestamp_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "    \"model_name\": \"MediaPipe Face Landmarker\",\n",
        "    \"model_variant\": \"float16\",\n",
        "    \"source_url\": MODEL_URL,\n",
        "    \"local_path\": str(MODEL_PATH),\n",
        "    \"file_size_bytes\": file_size,\n",
        "    \"sha256\": digest,\n",
        "    \"file_exists\": MODEL_PATH.exists(),\n",
        "    \"non_empty\": file_size > 0,\n",
        "    \"inference_performed\": False,\n",
        "    \"aligned_images_generated\": False,\n",
        "    \"frozen_data_modified\": False,\n",
        "    \"status\": \"MODEL_ASSET_DOWNLOADED_AND_HASHED\"\n",
        "}\n",
        "\n",
        "with open(OUTPUT_FILE, \"w\") as f:\n",
        "    json.dump(record, f, indent=2)\n",
        "\n",
        "with open(OUTPUT_FILE, \"r\") as f:\n",
        "    reloaded = json.load(f)\n",
        "\n",
        "print(\"\\nFile:\", MODEL_PATH.name)\n",
        "print(\"Size (bytes):\", file_size)\n",
        "print(\"SHA256:\", digest)\n",
        "print(\"File exists:\", record[\"file_exists\"])\n",
        "print(\"Non-empty:\", record[\"non_empty\"])\n",
        "\n",
        "print(\"\\nStatus:\", record[\"status\"])\n",
        "print(\"JSON reload:\", \"PASS\" if reloaded == record else \"FAIL\")\n",
        "print(\"Saved:\", OUTPUT_FILE)\n",
        "\n",
        "print(\"\\nInference: NO\")\n",
        "print(\"Aligned images generated: NO\")\n",
        "print(\"Frozen data modified: NO\")\n",
        "print(\"=\" * 88)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
