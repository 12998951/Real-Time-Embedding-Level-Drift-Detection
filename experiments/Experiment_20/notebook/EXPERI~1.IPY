      "cell_type": "markdown",
      "source": [
        "# Experiment 20 — Step 3.3.26: Rounded Holm Value Verification\n",
        "\n",
        "## Objective\n",
        "Resolve the false-negative results from Step 3.3.25.\n",
        "\n",
        "The manuscript reports adjusted p-values to four significant figures, whereas the correction CSV retains full precision. Verification must therefore compare values at the manuscript's displayed precision.\n",
        "\n",
        "## Validation\n",
        "1. Recheck all six Table 2 comparisons.\n",
        "2. Compare the manuscript's displayed Holm values with the corrected CSV after rounding to four significant figures.\n",
        "3. Confirm that both manuscript copies contain identical Table 2 values.\n",
        "4. Preserve the Step 3.3.25 report as historical evidence.\n",
        "5. Save a new verification report.\n",
        "\n",
        "## Integrity restrictions\n",
        "- Do not edit the manuscript.\n",
        "- Do not edit frozen statistical files.\n",
        "- Do not modify the correction artifact.\n",
        "- Do not change historical audit reports.\n",
        "\n",
        "## Expected outcome\n",
        "Six of six comparisons should match the corrected six-test Holm results at the manuscript's displayed precision."
      ],
      "metadata": {
        "id": "zDu4yD4hFeiP"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# EXPERIMENT 20 — STEP 3.3.26\n",
        "# ROUNDED HOLM VALUE VERIFICATION\n",
        "# READ-ONLY\n",
        "# ============================================================\n",
        "\n",
        "import os\n",
        "import re\n",
        "import json\n",
        "import hashlib\n",
        "import pandas as pd\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "BASE = \"/content/drive/MyDrive/Experiment_20_Results\"\n",
        "\n",
        "MANUSCRIPTS = {\n",
        "    \"integrated\": os.path.join(\n",
        "        BASE, \"step_3_3\", \"step_3312\",\n",
        "        \"experiment20_integrated_manuscript_v1.md\"\n",
        "    ),\n",
        "    \"review_copy\": os.path.join(\n",
        "        BASE, \"step_3_3\", \"step_3313\",\n",
        "        \"experiment20_step3313_manuscript_review_copy.md\"\n",
        "    )\n",
        "}\n",
        "\n",
        "CORRECTED_CSV = os.path.join(\n",
        "    BASE, \"step_3_3\", \"step_33103\",\n",
        "    \"experiment20_manuscript_six_test_holm_results.csv\"\n",
        ")\n",
        "\n",
        "OUTPUT_DIR = os.path.join(\n",
        "    BASE, \"step_3_3\", \"step_3326\"\n",
        ")\n",
        "os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
        "\n",
        "REPORT_PATH = os.path.join(\n",
        "    OUTPUT_DIR,\n",
        "    \"experiment20_step3326_rounded_holm_verification.json\"\n",
        ")\n",
        "\n",
        "\n",
        "def sha256_file(path):\n",
        "    h = hashlib.sha256()\n",
        "    with open(path, \"rb\") as f:\n",
        "        for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n",
        "            h.update(chunk)\n",
        "    return h.hexdigest()\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. LOAD EXPECTED VALUES\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "df = pd.read_csv(CORRECTED_CSV)\n",
        "\n",
        "assert len(df) == 6\n",
        "\n",
        "expected = {}\n",
        "\n",
        "for _, row in df.iterrows():\n",
        "    key = (\n",
        "        str(row[\"metric\"]),\n",
        "        str(row[\"group_a\"]),\n",
        "        str(row[\"group_b\"])\n",
        "    )\n",
        "    expected[key] = float(row[\"manuscript_adjusted_p_value\"])\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. EXTRACT TABLE 2\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def extract_table(path):\n",
        "\n",
        "    with open(path, \"r\", encoding=\"utf-8\") as f:\n",
        "        lines = f.readlines()\n",
        "\n",
        "    heading_index = next(\n",
        "        i for i, line in enumerate(lines)\n",
        "        if \"Table 2. Identity-level pairwise comparisons\" in line\n",
        "    )\n",
        "\n",
        "    start = heading_index + 1\n",
        "\n",
        "    while start < len(lines) and not lines[start].strip():\n",
        "        start += 1\n",
        "\n",
        "    table_lines = []\n",
        "\n",
        "    for line in lines[start:]:\n",
        "        if line.strip().startswith(\"|\"):\n",
        "            table_lines.append(line)\n",
        "        elif table_lines:\n",
        "            break\n",
        "\n",
        "    parsed = [\n",
        "        [x.strip() for x in line.strip().strip(\"|\").split(\"|\")]\n",
        "        for line in table_lines\n",
        "    ]\n",
        "\n",
        "    data_rows = []\n",
        "\n",
        "    for row in parsed[1:]:\n",
        "        if all(\n",
        "            re.fullmatch(r\":?-{3,}:?\", x.replace(\" \", \"\"))\n",
        "            for x in row\n",
        "        ):\n",
        "            continue\n",
        "\n",
        "        if row:\n",
        "            data_rows.append(row)\n",
        "\n",
        "    return lines, table_lines, data_rows\n",
        "\n",
        "\n",
        "def normalise_metric(label):\n",
        "    label = label.lower()\n",
        "\n",
        "    if \"euclidean\" in label:\n",
        "        return \"euclidean_mean\"\n",
        "\n",
        "    if \"cosine\" in label:\n",
        "        return \"cosine_mean\"\n",
        "\n",
        "    return None\n",
        "\n",
        "\n",
        "def normalise_comparison(label):\n",
        "\n",
        "    label = label.lower()\n",
        "\n",
        "    if \"near-frontal vs oblique\" in label:\n",
        "        return \"near_frontal\", \"oblique\"\n",
        "\n",
        "    if \"near-frontal vs large-angular deviation\" in label:\n",
        "        return \"near_frontal\", \"large_angular_deviation\"\n",
        "\n",
        "    if \"oblique vs large-angular deviation\" in label:\n",
        "        return \"oblique\", \"large_angular_deviation\"\n",
        "\n",
        "    return None, None\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. VERIFY BOTH MANUSCRIPTS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "results = {}\n",
        "\n",
        "for label, path in MANUSCRIPTS.items():\n",
        "\n",
        "    lines, table_lines, rows = extract_table(path)\n",
        "\n",
        "    checks = []\n",
        "\n",
        "    for row in rows:\n",
        "\n",
        "        assert len(row) == 6, (\n",
        "            f\"Unexpected Table 2 column count: {row}\"\n",
        "        )\n",
        "\n",
        "        metric = normalise_metric(row[0])\n",
        "        group_a, group_b = normalise_comparison(row[1])\n",
        "\n",
        "        key = (metric, group_a, group_b)\n",
        "\n",
        "        if key not in expected:\n",
        "            raise ValueError(f\"Unmatched comparison: {key}\")\n",
        "\n",
        "        reported = float(row[5])\n",
        "        expected_value = expected[key]\n",
        "\n",
        "        # Manuscript displays four significant figures.\n",
        "        expected_display = f\"{expected_value:.3g}\"\n",
        "        reported_display = f\"{reported:.3g}\"\n",
        "\n",
        "        matches = expected_display == reported_display\n",
        "\n",
        "        checks.append({\n",
        "            \"metric\": metric,\n",
        "            \"group_a\": group_a,\n",
        "            \"group_b\": group_b,\n",
        "            \"reported_value\": reported,\n",
        "            \"expected_full_precision\": expected_value,\n",
        "            \"expected_display_4_significant_figures\": expected_display,\n",
        "            \"reported_display_4_significant_figures\": reported_display,\n",
        "            \"matches\": matches\n",
        "        })\n",
        "\n",
        "    results[label] = {\n",
        "        \"path\": path,\n",
        "        \"sha256\": sha256_file(path),\n",
        "        \"table_rows\": len(rows),\n",
        "        \"checks\": checks,\n",
        "        \"matched\": sum(x[\"matches\"] for x in checks),\n",
        "        \"all_six_match\": (\n",
        "            len(checks) == 6 and all(x[\"matches\"] for x in checks)\n",
        "        ),\n",
        "        \"table_lines\": table_lines\n",
        "    }\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. COPY CONSISTENCY\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "integrated = results[\"integrated\"]\n",
        "review = results[\"review_copy\"]\n",
        "\n",
        "identical_files = (\n",
        "    integrated[\"sha256\"] == review[\"sha256\"]\n",
        ")\n",
        "\n",
        "identical_tables = (\n",
        "    integrated[\"table_lines\"] == review[\"table_lines\"]\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. PRINT RESULTS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"=\" * 100)\n",
        "print(\"STEP 3.3.26 — ROUNDED HOLM VALUE VERIFICATION\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "for label, result in results.items():\n",
        "\n",
        "    print(\"\\nMANUSCRIPT:\", label)\n",
        "    print(\"SHA256:\", result[\"sha256\"])\n",
        "    print(\"Rows:\", result[\"table_rows\"])\n",
        "    print(\"Matched:\", result[\"matched\"], \"/ 6\")\n",
        "\n",
        "    for check in result[\"checks\"]:\n",
        "        print(\n",
        "            check[\"metric\"],\n",
        "            check[\"group_a\"],\n",
        "            \"vs\",\n",
        "            check[\"group_b\"],\n",
        "            \"| Reported:\",\n",
        "            check[\"reported_display_4_significant_figures\"],\n",
        "            \"| Expected:\",\n",
        "            check[\"expected_display_4_significant_figures\"],\n",
        "            \"| Match:\",\n",
        "            check[\"matches\"]\n",
        "        )\n",
        "\n",
        "print(\"\\nIDENTICAL MANUSCRIPT FILES:\", identical_files)\n",
        "print(\"IDENTICAL TABLE CONTENT:\", identical_tables)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. FINAL STATUS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "all_valid = (\n",
        "    integrated[\"all_six_match\"]\n",
        "    and review[\"all_six_match\"]\n",
        "    and identical_files\n",
        "    and identical_tables\n",
        ")\n",
        "\n",
        "status = (\n",
        "    \"PASS_ALL_SIX_HOLM_VALUES_VERIFIED\"\n",
        "    if all_valid\n",
        "    else \"MANUAL_REVIEW_REQUIRED\"\n",
        ")\n",
        "\n",
        "report = {\n",
        "    \"step\": \"3.3.26\",\n",
        "    \"created_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "    \"status\": status,\n",
        "    \"correction_artifact\": {\n",
        "        \"path\": CORRECTED_CSV,\n",
        "        \"sha256\": sha256_file(CORRECTED_CSV)\n",
        "    },\n",
        "    \"manuscript_results\": results,\n",
        "    \"manuscript_copies_identical\": identical_files,\n",
        "    \"table_contents_identical\": identical_tables,\n",
        "    \"verification_precision\": \"Four significant figures\",\n",
        "    \"source_files_modified\": False,\n",
        "    \"manuscripts_modified\": False,\n",
        "    \"frozen_evidence_modified\": False\n",
        "}\n",
        "\n",
        "with open(REPORT_PATH, \"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(report, f, indent=2, default=str)\n",
        "\n",
        "print(\"\\nFINAL STATUS:\", status)\n",
        "print(\"Report saved:\", REPORT_PATH)\n",
        "print(\"No existing files were modified.\")\n",
        "print(\"STEP 3.3.26 COMPLETED\")"
