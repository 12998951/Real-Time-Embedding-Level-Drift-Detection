            "SOURCE CODE:\n",
            "import numpy as np\n",
            "import pandas as pd\n",
            "import sklearn\n",
            "from pathlib import Path\n",
            "from sklearn.model_selection import train_test_split\n",
            "\n",
            "# --------------------------------------------------\n",
            "# CONFIGURATION\n",
            "# --------------------------------------------------\n",
            "\n",
            "out = Path(\"/content/experiment13_lfw_regenerated\")\n",
            "\n",
            "metadata_path = out / \"lfw_embedding_metadata.csv\"\n",
            "split_path = out / \"lfw_identity_split_indices.npz\"\n",
            "\n",
            "if split_path.exists():\n",
            "    raise FileExistsError(\n",
            "        f\"{split_path} already exists. Nothing overwritten.\"\n",
            "    )\n",
            "\n",
            "metadata = pd.read_csv(metadata_path)\n",
            "\n",
            "assert len(metadata) == 13233\n",
            "assert metadata[\"identity\"].notna().all()\n",
            "\n",
            "# --------------------------------------------------\n",
            "# REPRODUCE ORIGINAL IDENTITY SPLIT\n",
            "# --------------------------------------------------\n",
            "\n",
            "print(\"ARTIFACT 3 — IDENTITY-DISJOINT SPLIT\")\n",
            "print(\"=\" * 65)\n",
            "\n",
            "identities = metadata[\"identity\"].unique()\n",
            "\n",
            "reference_ids, evaluation_ids = train_test_split(\n",
            "    identities,\n",
            "    test_size=0.30,\n",
            "    random_state=202613\n",
            ")\n",
            "\n",
            "reference_mask = metadata[\"identity\"].isin(\n",
            "    reference_ids\n",
            ").to_numpy()\n",
            "\n",
            "evaluation_mask = metadata[\"identity\"].isin(\n",
            "    evaluation_ids\n",
            ").to_numpy()\n",
            "\n",
            "reference_indices = np.flatnonzero(reference_mask)\n",
            "evaluation_indices = np.flatnonzero(evaluation_mask)\n",
            "\n",
            "reference_identity_set = set(reference_ids)\n",
            "evaluation_identity_set = set(evaluation_ids)\n",
            "\n",
            "# --------------------------------------------------\n",
            "# VALIDATION\n",
            "# --------------------------------------------------\n",
            "\n",
            "assert reference_identity_set.isdisjoint(evaluation_identity_set)\n",
            "assert len(reference_indices) + len(evaluation_indices) == len(metadata)\n",
            "assert len(np.intersect1d(reference_indices, evaluation_indices)) == 0\n",
            "\n",
            "# --------------------------------------------------\n",
            "# SAVE\n",
            "# --------------------------------------------------\n",
            "\n",
            "np.savez(\n",
            "    split_path,\n",
            "    reference_indices=reference_indices,\n",
            "    evaluation_indices=evaluation_indices\n",
            ")\n",
            "\n",
            "# --------------------------------------------------\n",
            "# REPORT\n",
            "# --------------------------------------------------\n",
            "\n",
            "print(\"scikit-learn version:\", sklearn.__version__)\n",
            "print(\"Total images:\", len(metadata))\n",
            "print(\"Total identities:\", len(identities))\n",
            "\n",
            "print(\"\\nReference identities:\", len(reference_identity_set))\n",
            "print(\"Evaluation identities:\", len(evaluation_identity_set))\n",
            "\n",
            "print(\"Reference images:\", len(reference_indices))\n",
            "print(\"Evaluation images:\", len(evaluation_indices))\n",
            "\n",
            "print(\"Identity overlap:\",\n",
            "      len(reference_identity_set & evaluation_identity_set))\n",
            "\n",
            "print(\"Image index overlap:\",\n",
            "      len(np.intersect1d(reference_indices, evaluation_indices)))\n",
            "\n",
            "print(\"\\nSaved:\", split_path)\n",
            "print(\"Identity-disjoint check: PASSED\")\n",
            "print(\"STATUS: REGENERATED — ORIGINAL SPLIT LOGIC\")\n",
            "\n",
