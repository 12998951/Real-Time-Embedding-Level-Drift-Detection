      "source": [
        "# Experiment 20 — Step 3.3.36: Final Integrity Audit and Section 3.3 Closure\n",
        "\n",
        "## Objective\n",
        "Perform the final read-only verification of manuscript v2 and its supporting evidence.\n",
        "\n",
        "## Required checks\n",
        "1. Verify all six Table 1 values against the frozen observation-level descriptive-statistics CSV, including counts and values rounded to four decimal places.\n",
        "2. Confirm the duplicate descriptive-statistics CSV has the same SHA256 as the frozen copy.\n",
        "3. Verify all six Table 2 Holm-adjusted values against the combined six-test correction.\n",
        "4. Verify both hemisphere comparison values and their separately corrected two-test Holm values.\n",
        "5. Verify all four embedded figure files exist and match their frozen SHA256 hashes.\n",
        "6. Verify that the manuscript and key audit reports exist.\n",
        "7. Confirm the manuscript has not been changed since Step 3.3.30.\n",
        "\n",
        "## Integrity restrictions\n",
        "- Read-only audit.\n",
        "- Do not modify the manuscript, figures, CSV files, or prior audit records.\n",
        "- Do not treat the two identical CSV copies as independent evidence.\n",
        "- Do not describe the two distance metrics as independent confirmation.\n",
        "- Do not upgrade descriptive findings into recognition-performance or deployment claims.\n",
        "\n",
        "## Closure criterion\n",
        "Section 3.3 can be marked complete only if all required numerical, figure, and manuscript-integrity checks pass. Any failed check must remain explicitly unresolved."
      ],
      "metadata": {
        "id": "NJhnSIeYLfpl"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# EXPERIMENT 20 — STEP 3.3.36\n",
        "# FINAL MANUSCRIPT INTEGRITY AUDIT AND SECTION 3.3 CLOSURE\n",
        "# READ-ONLY\n",
        "# ============================================================\n",
        "\n",
        "import os\n",
        "import re\n",
        "import json\n",
        "import math\n",
        "import hashlib\n",
        "import pandas as pd\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "BASE = \"/content/drive/MyDrive/Experiment_20_Results\"\n",
        "\n",
        "MANUSCRIPT = os.path.join(\n",
        "    BASE, \"step_3_3\", \"step_3330\",\n",
        "    \"experiment20_integrated_manuscript_v2.md\"\n",
        ")\n",
        "\n",
        "FREEZE = os.path.join(\n",
        "    BASE, \"step_2_7\", \"final_freeze\"\n",
        ")\n",
        "\n",
        "FROZEN_STATS = os.path.join(\n",
        "    FREEZE,\n",
        "    \"experiment20_illumination_group_descriptive_statistics.csv\"\n",
        ")\n",
        "\n",
        "DUPLICATE_STATS = os.path.join(\n",
        "    BASE, \"step_2_7\", \"group_descriptive_analysis\",\n",
        "    \"experiment20_illumination_group_descriptive_statistics.csv\"\n",
        ")\n",
        "\n",
        "PAIRED_CSV = os.path.join(\n",
        "    FREEZE, \"experiment20_paired_comparison_results.csv\"\n",
        ")\n",
        "\n",
        "HEMISPHERE_CSV = os.path.join(\n",
        "    FREEZE, \"experiment20_hemisphere_comparison_results.csv\"\n",
        ")\n",
        "\n",
        "OUTPUT_DIR = os.path.join(\n",
        "    BASE, \"step_3_3\", \"step_3336\"\n",
        ")\n",
        "os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
        "\n",
        "REPORT_PATH = os.path.join(\n",
        "    OUTPUT_DIR,\n",
        "    \"experiment20_step3336_final_integrity_and_closure_report.json\"\n",
        ")\n",
        "\n",
        "\n",
        "def sha256_file(path):\n",
        "    h = hashlib.sha256()\n",
        "    with open(path, \"rb\") as f:\n",
        "        for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n",
        "            h.update(chunk)\n",
        "    return h.hexdigest()\n",
        "\n",
        "\n",
        "def close(a, b, tolerance=0.000051):\n",
        "    return abs(float(a) - float(b)) <= tolerance\n",
        "\n",
        "\n",
        "checks = {}\n",
        "details = {}\n",
        "\n",
        "print(\"=\" * 100)\n",
        "print(\"STEP 3.3.36 — FINAL MANUSCRIPT INTEGRITY AUDIT\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. MANUSCRIPT INTEGRITY\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "assert os.path.isfile(MANUSCRIPT), \"Manuscript v2 not found.\"\n",
        "\n",
        "with open(MANUSCRIPT, \"r\", encoding=\"utf-8\") as f:\n",
        "    manuscript = f.read()\n",
        "\n",
        "manuscript_hash = sha256_file(MANUSCRIPT)\n",
        "\n",
        "EXPECTED_MANUSCRIPT_HASH = (\n",
        "    \"2cc4156af63987fae717c37e997e6478e4253d81f584854fb5fab9f18da5e752\"\n",
        ")\n",
        "\n",
        "checks[\"manuscript_hash_unchanged\"] = (\n",
        "    manuscript_hash == EXPECTED_MANUSCRIPT_HASH\n",
        ")\n",
        "\n",
        "details[\"manuscript\"] = {\n",
        "    \"path\": MANUSCRIPT,\n",
        "    \"sha256\": manuscript_hash,\n",
        "    \"expected_sha256\": EXPECTED_MANUSCRIPT_HASH,\n",
        "    \"word_count\": len(manuscript.split())\n",
        "}\n",
        "\n",
        "print(\"\\nMANUSCRIPT HASH:\", manuscript_hash)\n",
        "print(\"Manuscript unchanged:\", checks[\"manuscript_hash_unchanged\"])\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. TABLE 1 — ALL SIX ROWS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "assert os.path.isfile(FROZEN_STATS), \"Frozen descriptive CSV missing.\"\n",
        "assert os.path.isfile(DUPLICATE_STATS), \"Duplicate descriptive CSV missing.\"\n",
        "\n",
        "stats = pd.read_csv(FROZEN_STATS)\n",
        "duplicate_stats = pd.read_csv(DUPLICATE_STATS)\n",
        "\n",
        "frozen_stats_hash = sha256_file(FROZEN_STATS)\n",
        "duplicate_stats_hash = sha256_file(DUPLICATE_STATS)\n",
        "\n",
        "checks[\"descriptive_csv_copies_identical\"] = (\n",
        "    frozen_stats_hash == duplicate_stats_hash\n",
        ")\n",
        "\n",
        "checks[\"descriptive_csv_has_six_rows\"] = len(stats) == 6\n",
        "\n",
        "expected_table1 = {\n",
        "    \"near_frontal\": {\n",
        "        \"observations\": 646,\n",
        "        \"identities\": 38,\n",
        "        \"conditions\": 17,\n",
        "        \"euclidean_mean\": 0.4019,\n",
        "        \"euclidean_sd\": 0.1107,\n",
        "        \"cosine_mean\": 0.0869,\n",
        "        \"cosine_sd\": 0.0479\n",
        "    },\n",
        "    \"oblique\": {\n",
        "        \"observations\": 418,\n",
        "        \"identities\": 38,\n",
        "        \"conditions\": 11,\n",
        "        \"euclidean_mean\": 0.7090,\n",
        "        \"euclidean_sd\": 0.1482,\n",
        "        \"cosine_mean\": 0.2623,\n",
        "        \"cosine_sd\": 0.1062\n",
        "    },\n",
        "    \"large_angular_deviation\": {\n",
        "        \"observations\": 1064,\n",
        "        \"identities\": 38,\n",
        "        \"conditions\": 28,\n",
        "        \"euclidean_mean\": 1.1185,\n",
        "        \"euclidean_sd\": 0.2175,\n",
        "        \"cosine_mean\": 0.6491,\n",
        "        \"cosine_sd\": 0.2388\n",
        "    }\n",
        "}\n",
        "\n",
        "table1_results = {}\n",
        "\n",
        "for group, expected in expected_table1.items():\n",
        "\n",
        "    group_rows = stats[\n",
        "        stats[\"illumination_group\"] == group\n",
        "    ]\n",
        "\n",
        "    group_result = {\n",
        "        \"group_rows_found\": len(group_rows),\n",
        "        \"checks\": {}\n",
        "    }\n",
        "\n",
        "    if len(group_rows) != 2:\n",
        "        group_result[\"status\"] = \"FAIL_EXPECTED_TWO_METRIC_ROWS\"\n",
        "        table1_results[group] = group_result\n",
        "        continue\n",
        "\n",
        "    euclidean = group_rows[\n",
        "        group_rows[\"metric\"] == \"euclidean_displacement\"\n",
        "    ]\n",
        "\n",
        "    cosine = group_rows[\n",
        "        group_rows[\"metric\"] == \"cosine_distance\"\n",
        "    ]\n",
        "\n",
        "    if len(euclidean) != 1 or len(cosine) != 1:\n",
        "        group_result[\"status\"] = \"FAIL_METRIC_ROW_STRUCTURE\"\n",
        "        table1_results[group] = group_result\n",
        "        continue\n",
        "\n",
        "    e = euclidean.iloc[0]\n",
        "    c = cosine.iloc[0]\n",
        "\n",
        "    comparisons = {\n",
        "        \"observations\": (\n",
        "            int(e[\"observations\"]) == expected[\"observations\"]\n",
        "            and int(c[\"observations\"]) == expected[\"observations\"]\n",
        "        ),\n",
        "        \"identities\": (\n",
        "            int(e[\"identities\"]) == expected[\"identities\"]\n",
        "            and int(c[\"identities\"]) == expected[\"identities\"]\n",
        "        ),\n",
        "        \"conditions\": (\n",
        "            int(e[\"conditions\"]) == expected[\"conditions\"]\n",
        "            and int(c[\"conditions\"]) == expected[\"conditions\"]\n",
        "        ),\n",
        "        \"euclidean_mean_4dp\": close(\n",
        "            round(float(e[\"mean\"]), 4),\n",
        "            expected[\"euclidean_mean\"],\n",
        "            1e-10\n",
        "        ),\n",
        "        \"euclidean_sd_4dp\": close(\n",
        "            round(float(e[\"standard_deviation\"]), 4),\n",
        "            expected[\"euclidean_sd\"],\n",
        "            1e-10\n",
        "        ),\n",
        "        \"cosine_mean_4dp\": close(\n",
        "            round(float(c[\"mean\"]), 4),\n",
        "            expected[\"cosine_mean\"],\n",
        "            1e-10\n",
        "        ),\n",
        "        \"cosine_sd_4dp\": close(\n",
        "            round(float(c[\"standard_deviation\"]), 4),\n",
        "            expected[\"cosine_sd\"],\n",
        "            1e-10\n",
        "        )\n",
        "    }\n",
        "\n",
        "    group_result[\"checks\"] = comparisons\n",
        "    group_result[\"status\"] = (\n",
        "        \"PASS\" if all(comparisons.values()) else \"FAIL\"\n",
        "    )\n",
        "\n",
        "    table1_results[group] = group_result\n",
        "\n",
        "checks[\"table1_all_six_rows_verified\"] = (\n",
        "    len(table1_results) == 3\n",
        "    and all(\n",
        "        item.get(\"status\") == \"PASS\"\n",
        "        for item in table1_results.values()\n",
        "    )\n",
        ")\n",
        "\n",
        "details[\"table1\"] = {\n",
        "    \"frozen_csv\": FROZEN_STATS,\n",
        "    \"frozen_sha256\": frozen_stats_hash,\n",
        "    \"duplicate_csv\": DUPLICATE_STATS,\n",
        "    \"duplicate_sha256\": duplicate_stats_hash,\n",
        "    \"duplicate_is_byte_identical\": checks[\n",
        "        \"descriptive_csv_copies_identical\"\n",
        "    ],\n",
        "    \"row_count\": len(stats),\n",
        "    \"group_results\": table1_results\n",
        "}\n",
        "\n",
        "print(\"\\nTABLE 1 VERIFICATION\")\n",
        "print(\"Frozen CSV SHA256:\", frozen_stats_hash)\n",
        "print(\"Duplicate CSV SHA256:\", duplicate_stats_hash)\n",
        "print(\"Copies identical:\", checks[\"descriptive_csv_copies_identical\"])\n",
        "\n",
        "for group, result in table1_results.items():\n",
        "    print(group, \"=>\", result[\"status\"])\n",
        "    for name, passed in result.get(\"checks\", {}).items():\n",
        "        print(\"  \", name, passed)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. TABLE 2 — COMBINED SIX-TEST HOLM VALUES\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "assert os.path.isfile(PAIRED_CSV), \"Paired comparison CSV missing.\"\n",
        "\n",
        "paired = pd.read_csv(PAIRED_CSV)\n",
        "\n",
        "checks[\"paired_csv_has_six_rows\"] = len(paired) == 6\n",
        "\n",
        "# Combined six-test Holm adjusted p-value independently\n",
        "# documented in the correction record and manuscript.\n",
        "EXPECTED_COMBINED_HOLM = 4.365574568508e-11\n",
        "\n",
        "table2_holm_values = []\n",
        "\n",
        "for value in paired[\"raw_p_value\"].astype(float):\n",
        "    table2_holm_values.append(value)\n",
        "\n",
        "# The frozen CSV retains the historical metric-wise correction.\n",
        "# Verify manuscript reporting separately by extracting Table 2.\n",
        "table2_start = manuscript.find(\"Table 2.\")\n",
        "\n",
        "table2_section = (\n",
        "    manuscript[table2_start:]\n",
        "    if table2_start >= 0\n",
        "    else \"\"\n",
        ")\n",
        "\n",
        "table2_lines = [\n",
        "    line for line in table2_section.splitlines()\n",
        "    if line.strip().startswith(\"|\")\n",
        "]\n",
        "\n",
        "table2_data_lines = [\n",
        "    line for line in table2_lines\n",
        "    if re.search(r\"\\d\", line)\n",
        "    and not re.match(r\"\\|\\s*:?-+\", line)\n",
        "]\n",
        "\n",
        "# Extract scientific-notation values from the table body.\n",
        "table2_scientific_values = []\n",
        "\n",
        "for line in table2_data_lines:\n",
        "    for value in re.findall(\n",
        "        r\"(?<![A-Za-z])(?:\\d+(?:\\.\\d+)?)[eE][+-]?\\d+\",\n",
        "        line\n",
        "    ):\n",
        "        table2_scientific_values.append(float(value))\n",
        "\n",
        "# The table should contain six combined-Holm values.\n",
        "# Check the actual table rows and values rather than relying\n",
        "# on the frozen CSV's historical Holm column.\n",
        "table2_verified = (\n",
        "    len(table2_scientific_values) >= 6\n",
        "    and all(\n",
        "        close(value, EXPECTED_COMBINED_HOLM, 5e-14)\n",
        "        for value in table2_scientific_values[-6:]\n",
        "    )\n",
        ")\n",
        "\n",
        "checks[\"table2_six_combined_holm_values_verified\"] = table2_verified\n",
        "\n",
        "details[\"table2\"] = {\n",
        "    \"paired_csv_rows\": len(paired),\n",
        "    \"frozen_csv_holm_values\": (\n",
        "        paired[\"holm_adjusted_p_value\"].astype(float).tolist()\n",
        "        if \"holm_adjusted_p_value\" in paired.columns\n",
        "        else None\n",
        "    ),\n",
        "    \"expected_combined_six_test_holm\": EXPECTED_COMBINED_HOLM,\n",
        "    \"manuscript_scientific_values_extracted\": table2_scientific_values,\n",
        "    \"manuscript_combined_holm_values_verified\": table2_verified,\n",
        "    \"historical_frozen_csv_discrepancy_preserved\": True\n",
        "}\n",
        "\n",
        "print(\"\\nTABLE 2\")\n",
        "print(\"Paired CSV rows:\", len(paired))\n",
        "print(\"Extracted scientific values:\", table2_scientific_values)\n",
        "print(\"Combined six-test Holm verified:\", table2_verified)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. HEMISPHERE COMPARISON\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "assert os.path.isfile(HEMISPHERE_CSV), \"Hemisphere CSV missing.\"\n",
        "\n",
        "hemisphere = pd.read_csv(HEMISPHERE_CSV)\n",
        "\n",
        "expected_hemisphere = {\n",
        "    \"euclidean_displacement\": {\n",
        "        \"mean_frontal\": 0.706220,\n",
        "        \"mean_beyond_frontal\": 1.287990,\n",
        "        \"difference\": 0.581770,\n",
        "        \"holm\": 1.455192e-11\n",
        "    },\n",
        "    \"cosine_distance\": {\n",
        "        \"mean_frontal\": 0.295816,\n",
        "        \"mean_beyond_frontal\": 0.838624,\n",
        "        \"difference\": 0.542807,\n",
        "        \"holm\": 1.455192e-11\n",
        "    }\n",
        "}\n",
        "\n",
        "hemisphere_results = {}\n",
        "\n",
        "for metric, expected in expected_hemisphere.items():\n",
        "\n",
        "    rows = hemisphere[hemisphere[\"metric\"] == metric]\n",
        "\n",
        "    if len(rows) != 1:\n",
        "        hemisphere_results[metric] = {\n",
        "            \"status\": \"FAIL_ROW_COUNT\"\n",
        "        }\n",
        "        continue\n",
        "\n",
        "    row = rows.iloc[0]\n",
        "\n",
        "    comparisons = {\n",
        "        \"frontal_mean\": close(\n",
        "            round(float(row[\"mean_frontal\"]), 6),\n",
        "            expected[\"mean_frontal\"],\n",
        "            1e-10\n",
        "        ),\n",
        "        \"beyond_frontal_mean\": close(\n",
        "            round(float(row[\"mean_beyond_frontal\"]), 6),\n",
        "            expected[\"mean_beyond_frontal\"],\n",
        "            1e-10\n",
        "        ),\n",
        "        \"paired_difference\": close(\n",
        "            round(\n",
        "                float(row[\"mean_paired_difference_beyond_minus_frontal\"]),\n",
