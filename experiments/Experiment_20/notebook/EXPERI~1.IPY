    {
      "cell_type": "code",
      "source": [
        "from pathlib import Path\n",
        "import re\n",
        "import json\n",
        "import hashlib\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "BASE = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "STEP_DIR = BASE / \"step_3_3\"\n",
        "\n",
        "SOURCE = (\n",
        "    STEP_DIR / \"step_3384\" /\n",
        "    \"experiment20_consolidated_introduction_apa7_corrected.md\"\n",
        ")\n",
        "\n",
        "REFERENCE_FILE = (\n",
        "    STEP_DIR / \"step_3383\" /\n",
        "    \"experiment20_reference_list_apa7.json\"\n",
        ")\n",
        "\n",
        "OUTPUT_DIR = STEP_DIR / \"step_3388\"\n",
        "OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "if not SOURCE.exists():\n",
        "    raise FileNotFoundError(SOURCE)\n",
        "\n",
        "if not REFERENCE_FILE.exists():\n",
        "    raise FileNotFoundError(REFERENCE_FILE)\n",
        "\n",
        "manuscript = SOURCE.read_text(encoding=\"utf-8\")\n",
        "\n",
        "with open(REFERENCE_FILE, \"r\", encoding=\"utf-8\") as f:\n",
        "    reference_data = json.load(f)\n",
        "\n",
        "# Each pattern accepts either:\n",
        "# Narrative: Author et al. (YEAR)\n",
        "# Parenthetical: Author et al., YEAR\n",
        "\n",
        "patterns = {\n",
        "    \"REF01\": (\n",
        "        r\"Moses\\s+et\\s+al\\.\\s*\"\n",
        "        r\"(?:\\(\\s*1994\\s*\\)|,\\s*1994)\"\n",
        "    ),\n",
        "    \"REF02\": (\n",
        "        r\"Beveridge\\s+et\\s+al\\.\\s*\"\n",
        "        r\"(?:\\(\\s*2009\\s*\\)|,\\s*2009)\"\n",
        "    ),\n",
        "    \"REF03\": (\n",
        "        r\"Han\\s+et\\s+al\\.\\s*\"\n",
        "        r\"(?:\\(\\s*2013\\s*\\)|,\\s*2013)\"\n",
        "    ),\n",
        "    \"REF04\": (\n",
        "        r\"Ochoa-Villegas\\s+et\\s+al\\.\\s*\"\n",
        "        r\"(?:\\(\\s*2015\\s*\\)|,\\s*2015)\"\n",
        "    )\n",
        "}\n",
        "\n",
        "reference_ids = {\n",
        "    item[\"id\"] for item in reference_data[\"references\"]\n",
        "}\n",
        "\n",
        "citation_results = {}\n",
        "\n",
        "for ref_id, pattern in patterns.items():\n",
        "    matches = list(\n",
        "        re.finditer(pattern, manuscript, flags=re.IGNORECASE)\n",
        "    )\n",
        "\n",
        "    citation_results[ref_id] = {\n",
        "        \"occurrences\": len(matches),\n",
        "        \"present\": len(matches) > 0,\n",
        "        \"reference_entry_available\": ref_id in reference_ids,\n",
        "        \"matched_text\": [m.group(0) for m in matches]\n",
        "    }\n",
        "\n",
        "paragraphs = [\n",
        "    p.strip()\n",
        "    for p in re.split(r\"\\n\\s*\\n\", manuscript)\n",
        "    if p.strip()\n",
        "]\n",
        "\n",
        "han_context = [\n",
        "    p for p in paragraphs\n",
        "    if re.search(\n",
        "        r\"Han\\s+et\\s+al\\.,\\s*2013\",\n",
        "        p,\n",
        "        flags=re.IGNORECASE\n",
        "    )\n",
        "    and \"preprocessing\" in p.lower()\n",
        "]\n",
        "\n",
        "combined_citation = bool(\n",
        "    re.search(\n",
        "        r\"\\(\\s*Han\\s+et\\s+al\\.,\\s*2013\\s*;\\s*\"\n",
        "        r\"Ochoa-Villegas\\s+et\\s+al\\.,\\s*2015\\s*\\)\",\n",
        "        manuscript,\n",
        "        flags=re.IGNORECASE\n",
        "    )\n",
        ")\n",
        "\n",
        "unused_references = [\n",
        "    ref_id\n",
        "    for ref_id, result in citation_results.items()\n",
        "    if not result[\"present\"]\n",
        "]\n",
        "\n",
        "# Check old Moses author format is absent.\n",
        "old_moses_form = bool(\n",
        "    re.search(\n",
        "        r\"Moses\\s*,\\s*Adini\\s*,?\\s*and\\s+Ullman\\s*\\(1994\\)\",\n",
        "        manuscript,\n",
        "        flags=re.IGNORECASE\n",
        "    )\n",
        ")\n",
        "\n",
        "# Check angular grouping description remains present.\n",
        "angular_terms = [\n",
        "    \"0°–12°\",\n",
        "    \"13°–25°\",\n",
        "    \"26°–50°\",\n",
        "    \"51°–77°\",\n",
        "    \"above 77°\"\n",
        "]\n",
        "\n",
        "angular_description_present = all(\n",
        "    term in manuscript for term in angular_terms\n",
        ")\n",
        "\n",
        "# Compare current source checksum with the checksum from Step 3.3.8.7.\n",
        "previous_audit_file = (\n",
        "    STEP_DIR / \"step_3387\" /\n",
        "    \"experiment20_step3387_final_citation_consistency_audit.json\"\n",
        ")\n",
        "\n",
        "current_hash = hashlib.sha256(SOURCE.read_bytes()).hexdigest()\n",
        "\n",
        "previous_hash_check = None\n",
        "\n",
        "if previous_audit_file.exists():\n",
        "    previous_audit = json.loads(\n",
        "        previous_audit_file.read_text(encoding=\"utf-8\")\n",
        "    )\n",
        "    previous_hash_check = (\n",
        "        previous_audit.get(\"source_manuscript_sha256\") == current_hash\n",
        "    )\n",
        "\n",
        "checks = {\n",
        "    \"moses_citation_detected\": citation_results[\"REF01\"][\"present\"],\n",
        "    \"beveridge_citation_detected\": citation_results[\"REF02\"][\"present\"],\n",
        "    \"han_citation_detected\": citation_results[\"REF03\"][\"present\"],\n",
        "    \"ochoa_citation_detected\": citation_results[\"REF04\"][\"present\"],\n",
        "    \"all_reference_entries_available\": all(\n",
        "        result[\"reference_entry_available\"]\n",
        "        for result in citation_results.values()\n",
        "    ),\n",
        "    \"no_unused_references\": len(unused_references) == 0,\n",
        "    \"han_citation_in_preprocessing_context\": len(han_context) == 1,\n",
        "    \"combined_parenthetical_citation_valid\": combined_citation,\n",
        "    \"old_moses_form_removed\": not old_moses_form,\n",
        "    \"angular_grouping_description_preserved\": angular_description_present,\n",
        "    \"manuscript_checksum_matches_previous_audit\": (\n",
        "        previous_hash_check is True\n",
        "    )\n",
        "}\n",
        "\n",
        "audit = {\n",
        "    \"experiment\": \"Experiment 20\",\n",
        "    \"step\": \"3.3.8.8\",\n",
        "    \"timestamp_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "    \"citation_style\": \"APA 7\",\n",
        "    \"detector_support\": [\n",
        "        \"Narrative author-year citations\",\n",
        "        \"Parenthetical author-year citations\"\n",
        "    ],\n",
        "    \"citation_results\": citation_results,\n",
        "    \"han_preprocessing_context_verified\": len(han_context) == 1,\n",
        "    \"unused_references\": unused_references,\n",
        "    \"manuscript_path\": str(SOURCE),\n",
        "    \"manuscript_sha256\": current_hash,\n",
        "    \"manuscript_modified\": False,\n",
        "    \"previous_audit_checksum_match\": previous_hash_check,\n",
        "    \"checks\": checks,\n",
        "    \"passed_checks\": sum(checks.values()),\n",
        "    \"total_checks\": len(checks),\n",
        "    \"failed_checks\": [\n",
        "        key for key, value in checks.items() if not value\n",
        "    ],\n",
        "    \"status\": (\n",
        "        \"FINAL_CITATION_CONSISTENCY_VERIFIED\"\n",
        "        if all(checks.values())\n",
        "        else \"CITATION_CONSISTENCY_REQUIRES_REVIEW\"\n",
        "    )\n",
        "}\n",
        "\n",
        "OUTPUT_FILE = (\n",
        "    OUTPUT_DIR /\n",
        "    \"experiment20_step3388_final_apa7_citation_audit.json\"\n",
        ")\n",
        "\n",
        "with open(OUTPUT_FILE, \"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(audit, f, indent=2, ensure_ascii=False)\n",
        "\n",
        "reloaded = json.loads(\n",
        "    OUTPUT_FILE.read_text(encoding=\"utf-8\")\n",
        ")\n",
        "\n",
        "assert reloaded == audit\n",
        "\n",
        "print(\"=\" * 88)\n",
