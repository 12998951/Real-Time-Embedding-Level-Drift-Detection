      "cell_type": "code",
      "source": [
        "\n",
        "# ============================================================\n",
        "# EXPERIMENT 20 — STEP 3.3.10.6\n",
        "# HEMISPHERE-BASED RESULTS VERIFICATION\n",
        "# READ-ONLY SOURCE AUDIT — NO FROZEN FILES MODIFIED\n",
        "# ============================================================\n",
        "\n",
        "import os\n",
        "import json\n",
        "import hashlib\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "from pathlib import Path\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. GOOGLE DRIVE AND PATH INITIALISATION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "from google.colab import drive\n",
        "\n",
        "if not Path(\"/content/drive/MyDrive\").exists():\n",
        "    drive.mount(\"/content/drive\", force_remount=False)\n",
        "\n",
        "ROOT = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "FREEZE = ROOT / \"step_2_7\" / \"final_freeze\"\n",
        "OUT = ROOT / \"step_3_3\" / \"step_33106\"\n",
        "\n",
        "if not ROOT.exists():\n",
        "    raise FileNotFoundError(\n",
        "        f\"Experiment_20_Results not found: {ROOT}\"\n",
        "    )\n",
        "\n",
        "OUT.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "FILES = {\n",
        "    \"identity_means\": (\n",
        "        FREEZE /\n",
        "        \"experiment20_identity_level_hemisphere_means.csv\"\n",
        "    ),\n",
        "    \"comparisons\": (\n",
        "        FREEZE /\n",
        "        \"experiment20_hemisphere_comparison_results.csv\"\n",
        "    ),\n",
        "    \"hemisphere_audit\": (\n",
        "        FREEZE /\n",
        "        \"experiment20_step275_hemisphere_analysis_audit.json\"\n",
        "    )\n",
        "}\n",
        "\n",
        "missing = [\n",
        "    str(path)\n",
        "    for path in FILES.values()\n",
        "    if not path.is_file()\n",
        "]\n",
        "\n",
        "if missing:\n",
        "    raise FileNotFoundError(\n",
        "        \"Required frozen source files are missing:\\n\"\n",
        "        + \"\\n\".join(missing)\n",
        "    )\n",
        "\n",
        "print(\"=\" * 75)\n",
        "print(\"EXPERIMENT 20 — STEP 3.3.10.6\")\n",
        "print(\"HEMISPHERE-BASED RESULTS VERIFICATION\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. LOAD FROZEN SOURCE FILES\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "identity = pd.read_csv(FILES[\"identity_means\"])\n",
        "comparisons = pd.read_csv(FILES[\"comparisons\"])\n",
        "\n",
        "with open(\n",
        "    FILES[\"hemisphere_audit\"],\n",
        "    \"r\",\n",
        "    encoding=\"utf-8\"\n",
        ") as f:\n",
        "    audit_source = json.load(f)\n",
        "\n",
        "print(\"\\n[1] SOURCE TABLE STRUCTURES\")\n",
        "\n",
        "for name, df in [\n",
        "    (\"Identity-level hemisphere means\", identity),\n",
        "    (\"Hemisphere comparisons\", comparisons)\n",
        "]:\n",
        "    print(f\"\\n{name}: {df.shape}\")\n",
        "    print(\"Columns:\", df.columns.tolist())\n",
        "    print(df.to_string(index=False))\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. HELPER FUNCTIONS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def normalise(value):\n",
        "    return (\n",
        "        str(value).strip().lower()\n",
        "        .replace(\"-\", \"_\")\n",
        "        .replace(\" \", \"_\")\n",
        "    )\n",
        "\n",
        "def find_column(df, candidates):\n",
        "    normalised = {\n",
        "        normalise(col): col\n",
        "        for col in df.columns\n",
        "    }\n",
        "\n",
        "    for candidate in candidates:\n",
        "        key = normalise(candidate)\n",
        "        if key in normalised:\n",
        "            return normalised[key]\n",
        "\n",
        "    return None\n",
        "\n",
        "def sha256_file(path):\n",
        "    digest = hashlib.sha256()\n",
        "\n",
        "    with open(path, \"rb\") as f:\n",
        "        for chunk in iter(\n",
        "            lambda: f.read(1024 * 1024),\n",
        "            b\"\"\n",
        "        ):\n",
        "            digest.update(chunk)\n",
        "\n",
        "    return digest.hexdigest()\n",
        "\n",
        "def close(actual, expected, tolerance=1e-9):\n",
        "    return bool(\n",
        "        np.isclose(\n",
        "            float(actual),\n",
        "            float(expected),\n",
        "            atol=tolerance,\n",
        "            rtol=1e-8\n",
        "        )\n",
        "    )\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. DETECT IDENTITY-LEVEL TABLE COLUMNS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "subject_col = find_column(\n",
        "    identity,\n",
        "    [\"subject\", \"identity\", \"subject_id\", \"identity_id\"]\n",
        ")\n",
        "\n",
        "hemisphere_col = find_column(\n",
        "    identity,\n",
        "    [\"hemisphere\", \"hemisphere_group\", \"illumination_hemisphere\"]\n",
        ")\n",
        "\n",
        "euclidean_col = find_column(\n",
        "    identity,\n",
        "    [\"euclidean_mean\", \"euclidean_displacement_mean\",\n",
        "     \"euclidean_displacement\"]\n",
        ")\n",
        "\n",
        "cosine_col = find_column(\n",
        "    identity,\n",
        "    [\"cosine_mean\", \"cosine_distance_mean\", \"cosine_distance\"]\n",
        ")\n",
        "\n",
        "condition_col = find_column(\n",
        "    identity,\n",
        "    [\"evaluation_conditions\", \"conditions\", \"condition_count\"]\n",
        ")\n",
        "\n",
        "observation_col = find_column(\n",
        "    identity,\n",
        "    [\"observations\", \"observation_count\", \"n_observations\"]\n",
        ")\n",
        "\n",
        "detected_identity_columns = {\n",
        "    \"subject\": subject_col,\n",
        "    \"hemisphere\": hemisphere_col,\n",
        "    \"euclidean\": euclidean_col,\n",
        "    \"cosine\": cosine_col,\n",
        "    \"conditions\": condition_col,\n",
        "    \"observations\": observation_col\n",
        "}\n",
        "\n",
        "print(\"\\n[2] DETECTED IDENTITY TABLE COLUMNS\")\n",
        "print(json.dumps(detected_identity_columns, indent=2))\n",
        "\n",
        "checks = {}\n",
        "\n",
        "required_identity_columns = [\n",
        "    subject_col,\n",
        "    hemisphere_col,\n",
        "    euclidean_col,\n",
        "    cosine_col\n",
        "]\n",
        "\n",
        "checks[\"identity_table_required_columns_found\"] = (\n",
        "    all(col is not None for col in required_identity_columns)\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. IDENTITY COVERAGE VERIFICATION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "checks[\"identity_table_has_76_rows\"] = len(identity) == 76\n",
        "\n",
        "if subject_col and hemisphere_col:\n",
        "\n",
        "    checks[\"identity_table_has_38_unique_identities\"] = (\n",
        "        identity[subject_col].nunique() == 38\n",
        "    )\n",
        "\n",
        "    hemisphere_counts = (\n",
        "        identity.groupby(hemisphere_col)[subject_col].nunique()\n",
        "    )\n",
        "\n",
        "    checks[\"identity_table_has_two_hemisphere_groups\"] = (\n",
        "        len(hemisphere_counts) == 2\n",
        "    )\n",
        "\n",
        "    checks[\"each_hemisphere_has_38_identities\"] = (\n",
        "        len(hemisphere_counts) == 2\n",
        "        and bool((hemisphere_counts == 38).all())\n",
        "    )\n",
        "\n",
        "    print(\"\\nIDENTITIES PER HEMISPHERE\")\n",
        "    print(hemisphere_counts.to_string())\n",
        "\n",
        "else:\n",
        "    checks[\"identity_coverage_columns_found\"] = False\n",
        "    hemisphere_counts = pd.Series(dtype=int)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. NORMALISE HEMISPHERE LABELS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "if hemisphere_col:\n",
        "\n",
        "    identity[\"_hemisphere_normalised\"] = (\n",
        "        identity[hemisphere_col]\n",
        "        .map(normalise)\n",
        "    )\n",
        "\n",
        "    frontal_labels = {\n",
        "        \"frontal\",\n",
        "        \"front\",\n",
        "        \"frontal_hemisphere\"\n",
        "    }\n",
        "\n",
        "    beyond_labels = {\n",
        "        \"beyond_frontal\",\n",
        "        \"beyond_frontal_hemisphere\",\n",
        "        \"beyond\",\n",
        "        \"non_frontal\"\n",
        "    }\n",
        "\n",
        "    available_labels = set(\n",
        "        identity[\"_hemisphere_normalised\"].unique()\n",
        "    )\n",
        "\n",
        "    frontal_label = next(\n",
        "        (\n",
        "            label for label in available_labels\n",
        "            if label in frontal_labels\n",
        "        ),\n",
        "        None\n",
        "    )\n",
        "\n",
        "    beyond_label = next(\n",
        "        (\n",
        "            label for label in available_labels\n",
        "            if label in beyond_labels\n",
        "        ),\n",
        "        None\n",
        "    )\n",
        "\n",
        "    checks[\"frontal_and_beyond_frontal_labels_found\"] = (\n",
        "        frontal_label is not None\n",
        "        and beyond_label is not None\n",
        "    )\n",
        "\n",
        "else:\n",
        "    frontal_label = None\n",
        "    beyond_label = None\n",
        "    checks[\"hemisphere_labels_found\"] = False\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. RECALCULATE IDENTITY-LEVEL HEMISPHERE MEANS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "recalculated = {}\n",
        "\n",
        "if (\n",
        "    subject_col\n",
        "    and hemisphere_col\n",
        "    and euclidean_col\n",
        "    and cosine_col\n",
        "    and frontal_label\n",
        "    and beyond_label\n",
        "):\n",
        "\n",
        "    for label, display_name in [\n",
        "        (frontal_label, \"frontal\"),\n",
        "        (beyond_label, \"beyond_frontal\")\n",
        "    ]:\n",
        "\n",
        "        subset = identity[\n",
        "            identity[\"_hemisphere_normalised\"] == label\n",
        "        ]\n",
        "\n",
        "        recalculated[display_name] = {\n",
        "            \"identities\": int(subset[subject_col].nunique()),\n",
        "            \"euclidean_mean\": float(\n",
        "                subset[euclidean_col].mean()\n",
        "            ),\n",
        "            \"cosine_mean\": float(\n",
        "                subset[cosine_col].mean()\n",
        "            ),\n",
        "            \"identity_rows\": int(len(subset))\n",
        "        }\n",
        "\n",
        "    print(\"\\n[3] RECALCULATED HEMISPHERE MEANS\")\n",
        "    print(json.dumps(recalculated, indent=2))\n",
        "\n",
        "    checks[\"frontal_euclidean_mean_matches\"] = close(\n",
        "        recalculated[\"frontal\"][\"euclidean_mean\"],\n",
        "        0.7062201499\n",
        "    )\n",
        "\n",
        "    checks[\"beyond_frontal_euclidean_mean_matches\"] = close(\n",
        "        recalculated[\"beyond_frontal\"][\"euclidean_mean\"],\n",
        "        1.2879898952\n",
        "    )\n",
        "\n",
        "    checks[\"frontal_cosine_mean_matches\"] = close(\n",
        "        recalculated[\"frontal\"][\"cosine_mean\"],\n",
        "        0.2958161338\n",
        "    )\n",
        "\n",
        "    checks[\"beyond_frontal_cosine_mean_matches\"] = close(\n",
        "        recalculated[\"beyond_frontal\"][\"cosine_mean\"],\n",
        "        0.8386235804\n",
        "    )\n",
        "\n",
        "else:\n",
        "    checks[\"identity_level_means_recalculated\"] = False\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 8. VERIFY CONDITION AND OBSERVATION COUNTS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "if (\n",
        "    condition_col\n",
        "    and observation_col\n",
        "    and hemisphere_col\n",
        "    and frontal_label\n",
        "    and beyond_label\n",
        "):\n",
        "\n",
        "    frontal_data = identity[\n",
        "        identity[\"_hemisphere_normalised\"] == frontal_label\n",
        "    ]\n",
        "\n",
        "    beyond_data = identity[\n",
        "        identity[\"_hemisphere_normalised\"] == beyond_label\n",
        "    ]\n",
        "\n",
        "    frontal_conditions = int(\n",
        "        frontal_data[condition_col].sum()\n",
        "    )\n",
        "\n",
        "    beyond_conditions = int(\n",
        "        beyond_data[condition_col].sum()\n",
        "    )\n",
        "\n",
        "    frontal_observations = int(\n",
        "        frontal_data[observation_col].sum()\n",
        "    )\n",
        "\n",
        "    beyond_observations = int(\n",
        "        beyond_data[observation_col].sum()\n",
        "    )\n",
        "\n",
        "    checks[\"frontal_conditions_equal_45\"] = (\n",
        "        frontal_conditions == 45 * 38\n",
        "    )\n",
        "\n",
        "    checks[\"beyond_frontal_conditions_equal_11\"] = (\n",
        "        beyond_conditions == 11 * 38\n",
        "    )\n",
        "\n",
        "    checks[\"frontal_observations_equal_1710\"] = (\n",
        "        frontal_observations == 1710\n",
        "    )\n",
        "\n",
        "    checks[\"beyond_frontal_observations_equal_418\"] = (\n",
        "        beyond_observations == 418\n",
        "    )\n",
        "\n",
        "    condition_summary = {\n",
        "        \"frontal\": {\n",
        "            \"conditions_per_identity\": 45,\n",
        "            \"identity_condition_records\": frontal_conditions,\n",
        "            \"observations\": frontal_observations\n",
        "        },\n",
        "        \"beyond_frontal\": {\n",
        "            \"conditions_per_identity\": 11,\n",
        "            \"identity_condition_records\": beyond_conditions,\n",
        "            \"observations\": beyond_observations\n",
        "        }\n",
        "    }\n",
        "\n",
        "    print(\"\\n[4] CONDITION AND OBSERVATION COVERAGE\")\n",
        "    print(json.dumps(condition_summary, indent=2))\n",
        "\n",
        "else:\n",
        "    condition_summary = {}\n",
        "    checks[\"condition_and_observation_columns_found\"] = False\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 9. DETECT COMPARISON TABLE COLUMNS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "metric_col = find_column(\n",
        "    comparisons,\n",
        "    [\"metric\", \"distance_metric\"]\n",
        ")\n",
        "\n",
        "raw_p_col = find_column(\n",
        "    comparisons,\n",
        "    [\"raw_p_value\", \"p_value\", \"pvalue\"]\n",
        ")\n",
        "\n",
        "holm_col = find_column(\n",
        "    comparisons,\n",
        "    [\"holm_adjusted_p_value\", \"adjusted_p_value\"]\n",
        ")\n",
        "\n",
        "significant_col = find_column(\n",
        "    comparisons,\n",
        "    [\"significant_after_holm_0_05\", \"significant\"]\n",
        ")\n",
        "\n",
        "lower_col = find_column(\n",
        "    comparisons,\n",
        "    [\"ci_95_lower\", \"ci_lower\", \"lower_ci\"]\n",
        ")\n",
        "\n",
        "upper_col = find_column(\n",
        "    comparisons,\n",
        "    [\"ci_95_upper\", \"ci_upper\", \"upper_ci\"]\n",
        ")\n",
        "\n",
        "difference_col = find_column(\n",
        "    comparisons,\n",
        "    [\n",
        "        \"mean_paired_difference_beyond_minus_frontal\",\n",
        "        \"mean_paired_difference\",\n",
        "        \"mean_difference_beyond_minus_frontal\"\n",
        "    ]\n",
        ")\n",
        "\n",
        "comparison_columns = {\n",
        "    \"metric\": metric_col,\n",
        "    \"raw_p_value\": raw_p_col,\n",
        "    \"holm_adjusted_p_value\": holm_col,\n",
        "    \"significance\": significant_col,\n",
        "    \"ci_lower\": lower_col,\n",
        "    \"ci_upper\": upper_col,\n",
        "    \"mean_difference\": difference_col\n",
        "}\n",
        "\n",
        "print(\"\\n[5] DETECTED COMPARISON COLUMNS\")\n",
        "print(json.dumps(comparison_columns, indent=2))\n",
        "\n",
        "checks[\"comparison_table_has_two_rows\"] = (\n",
        "    len(comparisons) == 2\n",
        ")\n",
        "\n",
        "checks[\"comparison_required_columns_found\"] = (\n",
        "    all(value is not None for value in comparison_columns.values())\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 10. VERIFY PAIRED COMPARISONS AND HOLM CORRECTION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "expected_comparisons = {\n",
        "    \"euclidean\": {\n",
        "        \"difference\": 0.5817697453,\n",
        "        \"lower\": 0.5619855483,\n",
        "        \"upper\": 0.6019542941\n",
        "    },\n",
        "    \"cosine\": {\n",
        "        \"difference\": 0.5428074466,\n",
        "        \"lower\": 0.5164192335,\n",
        "        \"upper\": 0.5685162487\n",
        "    }\n",
        "}\n",
        "\n",
        "comparison_results = {}\n",
        "\n",
        "if all(value is not None for value in comparison_columns.values()):\n",
        "\n",
        "    normalised_metrics = comparisons[metric_col].map(normalise)\n",
        "\n",
        "    for metric_name, expected in expected_comparisons.items():\n",
        "\n",
        "        if metric_name == \"euclidean\":\n",
        "            mask = normalised_metrics.str.contains(\n",
        "                \"euclidean\", regex=False\n",
        "            )\n",
        "        else:\n",
        "            mask = normalised_metrics.str.contains(\n",
        "                \"cosine\", regex=False\n",
        "            )\n",
        "\n",
        "        subset = comparisons[mask]\n",
        "\n",
        "        if len(subset) != 1:\n",
        "            comparison_results[metric_name] = {\n",
        "                \"found_rows\": int(len(subset)),\n",
        "                \"verified\": False\n",
        "            }\n",
        "            continue\n",
        "\n",
        "        row = subset.iloc[0]\n",
        "\n",
        "        difference = float(row[difference_col])\n",
        "        lower = float(row[lower_col])\n",
        "        upper = float(row[upper_col])\n",
        "        raw_p = float(row[raw_p_col])\n",
        "        adjusted_p = float(row[holm_col])\n",
        "\n",
        "        comparison_results[metric_name] = {\n",
        "            \"mean_paired_difference\": difference,\n",
        "            \"ci_95_lower\": lower,\n",
        "            \"ci_95_upper\": upper,\n",
        "            \"raw_p_value\": raw_p,\n",
        "            \"holm_adjusted_p_value\": adjusted_p\n",
        "        }\n",
        "\n",
        "        checks[f\"{metric_name}_paired_difference_matches\"] = close(\n",
        "            difference,\n",
        "            expected[\"difference\"]\n",
        "        )\n",
        "\n",
        "        checks[f\"{metric_name}_ci_lower_matches\"] = close(\n",
        "            lower,\n",
        "            expected[\"lower\"]\n",
        "        )\n",
        "\n",
        "        checks[f\"{metric_name}_ci_upper_matches\"] = close(\n",
        "            upper,\n",
        "            expected[\"upper\"]\n",
        "        )\n",
        "\n",
        "        checks[f\"{metric_name}_holm_p_matches\"] = close(\n",
        "            adjusted_p,\n",
        "            1.4551915228366852e-11,\n",
        "            tolerance=1e-14\n",
        "        )\n",
        "\n",
        "        checks[f\"{metric_name}_raw_p_is_significant\"] = (\n",
        "            raw_p < 0.05\n",
        "        )\n",
        "\n",
        "        checks[f\"{metric_name}_holm_p_is_significant\"] = (\n",
        "            adjusted_p < 0.05\n",
        "        )\n",
        "\n",
        "    print(\"\\n[6] PAIRED COMPARISON RESULTS\")\n",
        "    print(json.dumps(comparison_results, indent=2))\n",
        "\n",
        "    if significant_col:\n",
        "        checks[\"both_comparisons_marked_significant\"] = (\n",
        "            len(comparisons) == 2\n",
        "            and bool(comparisons[significant_col].astype(bool).all())\n",
        "        )\n",
        "\n",
        "else:\n",
        "    comparison_results = {}\n",
        "    checks[\"paired_comparison_fields_verified\"] = False\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 11. VERIFY BOOTSTRAP EVIDENCE AGAINST ORIGINAL AUDIT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "bootstrap_results = audit_source.get(\"bootstrap_results\", [])\n",
        "\n",
        "checks[\"audit_has_two_bootstrap_results\"] = (\n",
        "    len(bootstrap_results) == 2\n",
        ")\n",
        "\n",
        "bootstrap_evidence = {}\n",
        "\n",
        "for item in bootstrap_results:\n",
        "\n",
        "    metric = normalise(item.get(\"metric\", \"\"))\n",
        "\n",
        "    bootstrap_evidence[metric] = {\n",
        "        \"iterations\": item.get(\"bootstrap_iterations\"),\n",
        "        \"random_seed\": item.get(\"random_seed\"),\n",
        "        \"mean_difference\": item.get(\n",
        "            \"mean_paired_difference_beyond_minus_frontal\"\n",
        "        ),\n",
        "        \"ci_95_lower\": item.get(\"ci_95_lower\"),\n",
        "        \"ci_95_upper\": item.get(\"ci_95_upper\")\n",
        "    }\n",
        "\n",
        "checks[\"both_bootstrap_results_use_20000_iterations\"] = (\n",
        "    len(bootstrap_results) == 2\n",
        "    and all(\n",
        "        item.get(\"bootstrap_iterations\") == 20000\n",
        "        for item in bootstrap_results\n",
        "    )\n",
        ")\n",
        "\n",
        "checks[\"both_bootstrap_results_use_seed_2026275\"] = (\n",
        "    len(bootstrap_results) == 2\n",
        "    and all(\n",
        "        item.get(\"random_seed\") == 2026275\n",
        "        for item in bootstrap_results\n",
        "    )\n",
        ")\n",
        "\n",
        "checks[\"bootstrap_results_have_95_percent_intervals\"] = (\n",
        "    len(bootstrap_results) == 2\n",
        "    and all(\n",
        "        item.get(\"ci_95_lower\") is not None\n",
        "        and item.get(\"ci_95_upper\") is not None\n",
        "        for item in bootstrap_results\n",
        "    )\n",
        ")\n",
        "\n",
        "print(\"\\n[7] ORIGINAL BOOTSTRAP AUDIT EVIDENCE\")\n",
        "print(json.dumps(bootstrap_evidence, indent=2))\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 12. VERIFY SOURCE FILE INTEGRITY\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "source_hashes = {\n",
        "    name: sha256_file(path)\n",
        "    for name, path in FILES.items()\n",
        "}\n",
        "\n",
        "print(\"\\n[8] SOURCE SHA256 HASHES\")\n",
        "\n",
        "for name, digest in source_hashes.items():\n",
        "    print(name, digest)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 13. SAVE SEPARATE VERIFICATION RECORD\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "passed = sum(bool(value) for value in checks.values())\n",
        "failed = sum(not bool(value) for value in checks.values())\n",
        "\n",
        "result = {\n",
        "    \"experiment\": 20,\n",
        "    \"step\": \"3.3.10.6\",\n",
        "    \"title\": \"Hemisphere-based results verification\",\n",
        "    \"timestamp_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "\n",
        "    \"source_files\": {\n",
        "        name: str(path)\n",
        "        for name, path in FILES.items()\n",
        "    },\n",
        "\n",
        "    \"source_sha256\": source_hashes,\n",
        "\n",
        "    \"table_shapes\": {\n",
        "        \"identity_means\": list(identity.shape),\n",
        "        \"comparisons\": list(comparisons.shape)\n",
        "    },\n",
        "\n",
        "    \"detected_columns\": {\n",
        "        \"identity\": detected_identity_columns,\n",
        "        \"comparisons\": comparison_columns\n",
        "    },\n",
        "\n",
        "    \"identity_level_means\": recalculated,\n",
        "    \"condition_summary\": condition_summary,\n",
        "    \"paired_comparison_results\": comparison_results,\n",
        "    \"bootstrap_evidence\": bootstrap_evidence,\n",
        "\n",
        "    \"checks\": {\n",
        "        name: bool(value)\n",
        "        for name, value in checks.items()\n",
        "    },\n",
        "\n",
        "    \"passed\": int(passed),\n",
        "    \"failed\": int(failed),\n",
        "\n",
        "    \"status\": (\n",
        "        \"HEMISPHERE_RESULTS_VERIFIED\"\n",
        "        if failed == 0\n",
        "        else \"REVIEW_REQUIRED\"\n",
        "    ),\n",
        "\n",
        "    \"limitations\": [\n",
        "        \"Hemisphere analysis is exploratory.\",\n",
        "        \"Frontal and beyond-frontal groups contain unequal numbers of illumination conditions.\",\n",
        "        \"Hemisphere membership is related to angular illumination geometry.\",\n",
        "        \"The observed differences cannot be attributed exclusively to hemisphere direction.\",\n",
        "        \"The analysis does not establish recognition accuracy or deployment readiness.\"\n",
        "    ],\n",
        "\n",
        "    \"preservation\": (\n",
        "        \"Original frozen CSV files and the original hemisphere \"\n",
        "        \"audit were read only and were not modified.\"\n",
        "    )\n",
        "}\n",
        "\n",
        "OUTPUT = (\n",
        "    OUT /\n",
        "    \"experiment20_step33106_hemisphere_results_verification.json\"\n",
        ")\n",
        "\n",
        "OUTPUT.write_text(\n",
        "    json.dumps(result, indent=2, allow_nan=False),\n",
        "    encoding=\"utf-8\"\n",
        ")\n",
        "\n",
        "# Reload saved JSON.\n",
        "reloaded = json.loads(\n",
        "    OUTPUT.read_text(encoding=\"utf-8\")\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 14. FINAL VERIFICATION REPORT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 75)\n",
        "print(\"STEP 3.3.10.6 — FINAL VERIFICATION\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "for name, passed_check in checks.items():\n",
        "    print(\n",
        "        (\"PASS\" if passed_check else \"FAIL\"),\n",
        "        name\n",
        "    )\n",
        "\n",
        "print(\"\\nPASSED:\", reloaded[\"passed\"])\n",
        "print(\"FAILED:\", reloaded[\"failed\"])\n",
        "print(\"STATUS:\", reloaded[\"status\"])\n",
        "print(\"AUDIT:\", OUTPUT)\n",
        "print(\"JSON RELOAD: SUCCESS\")\n",
        "print(\"\\nOriginal frozen source files were not modified.\")\n",
        "\n",
        "print(\"=\" * 75)\n"
      ],
