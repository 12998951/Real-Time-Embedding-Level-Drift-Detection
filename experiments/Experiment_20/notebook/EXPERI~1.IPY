      "cell_type": "markdown",
      "source": [
        "# Experiment 20 — Step 3.1.9: Original Notebook Source Inspection\n",
        "\n",
        "## Objective\n",
        "Search the existing Google Drive Colab notebooks for the original\n",
        "Experiment 20 embedding-generation code.\n",
        "\n",
        "Recover, if available:\n",
        "\n",
        "1. The exact torchvision Resize invocation.\n",
        "2. Whether interpolation was explicitly specified.\n",
        "3. The FaceNet model initialization statement.\n",
        "4. The pretrained-weight loading configuration.\n",
        "5. Any model checkpoint saving or loading operation.\n",
        "6. The software version information recorded during generation.\n",
        "\n",
        "## Restrictions\n",
        "- Read-only inspection.\n",
        "- Do not execute notebook cells.\n",
        "- Do not regenerate embeddings.\n",
        "- Do not modify notebook files.\n",
        "- Do not assume defaults when source code is incomplete.\n",
        "\n",
        "## Output\n",
        "Print matching notebook paths, cell indices, and relevant source-code excerpts."
      ],
      "metadata": {
        "id": "kDac9R5Xv34H"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from pathlib import Path\n",
        "import json\n",
        "import re\n",
        "\n",
        "DRIVE_ROOT = Path(\"/content/drive/MyDrive\")\n",
        "\n",
        "SEARCH_ROOTS = [\n",
        "    DRIVE_ROOT / \"Colab Notebooks\",\n",
        "    DRIVE_ROOT / \"Experiment_20_Results\"\n",
        "]\n",
        "\n",
        "PATTERNS = {\n",
        "    \"resize\": re.compile(\n",
        "        r\"transforms\\.Resize|Resize\\(|InterpolationMode|interpolation\\s*=\",\n",
        "        re.IGNORECASE\n",
        "    ),\n",
        "    \"model_initialization\": re.compile(\n",
        "        r\"InceptionResnetV1|pretrained\\s*=\\s*['\\\"]VGGFace2\",\n",
        "        re.IGNORECASE\n",
        "    ),\n",
        "    \"checkpoint_operations\": re.compile(\n",
        "        r\"torch\\.save|torch\\.load|load_state_dict|state_dict|checkpoint\",\n",
        "        re.IGNORECASE\n",
        "    ),\n",
        "    \"software_versions\": re.compile(\n",
        "        r\"facenet.?pytorch|torchvision|torch\\.__version__|\"\n",
        "        r\"__version__|version\\(\",\n",
        "        re.IGNORECASE\n",
        "    )\n",
        "}\n",
        "\n",
        "print(\"=\" * 100)\n",
        "print(\"EXPERIMENT 20 — STEP 3.1.9\")\n",
        "print(\"ORIGINAL NOTEBOOK SOURCE INSPECTION\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "notebooks = []\n",
        "\n",
        "for root in SEARCH_ROOTS:\n",
        "    if root.exists():\n",
        "        notebooks.extend(root.rglob(\"*.ipynb\"))\n",
        "\n",
        "print(\"Notebooks discovered:\", len(notebooks))\n",
        "\n",
        "matches_found = 0\n",
        "\n",
        "for notebook_path in sorted(notebooks):\n",
        "    try:\n",
        "        with notebook_path.open(\"r\", encoding=\"utf-8\") as f:\n",
        "            notebook = json.load(f)\n",
        "\n",
        "        cells = notebook.get(\"cells\", [])\n",
        "\n",
        "        notebook_matches = []\n",
        "\n",
        "        for index, cell in enumerate(cells):\n",
        "            if cell.get(\"cell_type\") != \"code\":\n",
        "                continue\n",
        "\n",
        "            source = cell.get(\"source\", \"\")\n",
        "            if isinstance(source, list):\n",
        "                source = \"\".join(source)\n",
        "\n",
        "            matched_categories = [\n",
        "                category\n",
        "                for category, pattern in PATTERNS.items()\n",
        "                if pattern.search(source)\n",
        "            ]\n",
        "\n",
        "            if matched_categories:\n",
        "                notebook_matches.append(\n",
        "                    (index, matched_categories, source)\n",
        "                )\n",
        "\n",
        "        if notebook_matches:\n",
        "            print(\"\\n\" + \"-\" * 100)\n",
        "            print(\"NOTEBOOK:\", notebook_path)\n",
        "            print(\"MATCHING CODE CELLS:\", len(notebook_matches))\n",
        "\n",
        "            for index, categories, source in notebook_matches:\n",
        "                matches_found += 1\n",
        "\n",
        "                print(\"\\nCELL INDEX:\", index)\n",
        "                print(\"MATCH CATEGORIES:\", \", \".join(categories))\n",
        "                print(\"SOURCE CODE:\")\n",
        "                print(source[:6000])\n",
        "\n",
        "    except Exception as exc:\n",
        "        print(\"\\nNOTEBOOK READ ERROR:\", notebook_path)\n",
        "        print(repr(exc))\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"INSPECTION SUMMARY\")\n",
        "print(\"=\" * 100)\n",
        "print(\"Notebooks discovered:\", len(notebooks))\n",
        "print(\"Matching code cells:\", matches_found)\n",
        "print(\"Notebook files modified: NO\")\n",
        "print(\"Notebook cells executed: NO\")\n",
        "print(\"=\" * 100)"
      ],
