      "source": [
        "# Experiment 20 — Step 3.1.7: Final Unresolved-Decision Register\n",
        "\n",
        "## Objective\n",
        "Record unresolved methodological and reporting decisions before closing the methodological review.\n",
        "\n",
        "This step must not modify the frozen experiment or recalculate results.\n",
        "\n",
        "## Decisions to track\n",
        "1. Holm correction family justification.\n",
        "2. Resize interpolation and missing preprocessing details.\n",
        "3. Exact model/checkpoint and software-version documentation.\n",
        "4. Official dataset checksum authentication limitation.\n",
        "5. Correct scope description of the cropped frontal-pose subset.\n",
        "\n",
        "## Output\n",
        "A JSON register containing each decision, its current status,\n",
        "required action, and whether it blocks manuscript submission."
      ],
      "metadata": {
        "id": "gunXCRXkvXTR"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from pathlib import Path\n",
        "from datetime import datetime, timezone\n",
        "import json\n",
        "\n",
        "BASE = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "OUTPUT_DIR = BASE / \"step_3_1\"\n",
        "OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "OUTPUT_FILE = (\n",
        "    OUTPUT_DIR /\n",
        "    \"experiment20_step317_unresolved_decisions.json\"\n",
        ")\n",
        "\n",
        "decisions = [\n",
        "    {\n",
        "        \"id\": \"D01\",\n",
        "        \"decision\": \"Multiple-comparison correction family\",\n",
        "        \"current_status\": \"UNRESOLVED\",\n",
        "        \"current_analysis\": \"Holm correction applied separately to three pairwise comparisons for each metric.\",\n",
        "        \"required_action\": \"Justify the two metric-wise outcome families or recalculate using one six-comparison family.\",\n",
        "        \"blocks_manuscript_submission\": True\n",
        "    },\n",
        "    {\n",
        "        \"id\": \"D02\",\n",
        "        \"decision\": \"Resize interpolation method\",\n",
        "        \"current_status\": \"NOT_FULLY_DOCUMENTED\",\n",
        "        \"current_analysis\": \"Images resized to 160x160; interpolation method not established in the reviewed records.\",\n",
        "        \"required_action\": \"Recover the interpolation method from the original execution environment if possible; otherwise disclose it as unavailable.\",\n",
        "        \"blocks_manuscript_submission\": True\n",
        "    },\n",
        "    {\n",
        "        \"id\": \"D03\",\n",
        "        \"decision\": \"Exact model checkpoint and software versions\",\n",
        "        \"current_status\": \"PARTIALLY_DOCUMENTED\",\n",
        "        \"current_analysis\": \"InceptionResnetV1 pretrained on VGGFace2 is documented; complete checkpoint identity and environment versions remain insufficiently established.\",\n",
        "        \"required_action\": \"Recover checkpoint identity and relevant package versions where possible; disclose unrecoverable details.\",\n",
        "        \"blocks_manuscript_submission\": True\n",
        "    },\n",
        "    {\n",
        "        \"id\": \"D04\",\n",
        "        \"decision\": \"Official dataset authenticity\",\n",
        "        \"current_status\": \"KNOWN_LIMITATION\",\n",
        "        \"current_analysis\": \"Acquisition listing and archive hash match, but no independent official Yale checksum authentication was performed.\",\n",
        "        \"required_action\": \"Disclose the community-hosted source and absence of official checksum authentication.\",\n",
        "        \"blocks_manuscript_submission\": False\n",
        "    },\n",
        "    {\n",
        "        \"id\": \"D05\",\n",
        "        \"decision\": \"Dataset scope terminology\",\n",
        "        \"current_status\": \"RESOLVED\",\n",
        "        \"current_analysis\": \"The acquired data represent a cropped frontal-pose subset, not the complete multi-pose Extended Yale B dataset.\",\n",
        "        \"required_action\": \"Use the precise dataset scope consistently throughout the manuscript.\",\n",
        "        \"blocks_manuscript_submission\": False\n",
        "    }\n",
        "]\n",
        "\n",
        "register = {\n",
        "    \"experiment\": 20,\n",
        "    \"step\": \"3.1.7\",\n",
        "    \"timestamp_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "    \"decision_count\": len(decisions),\n",
        "    \"decisions\": decisions,\n",
        "    \"submission_blocking_count\": sum(\n",
        "        d[\"blocks_manuscript_submission\"] for d in decisions\n",
        "    )\n",
        "}\n",
        "\n",
        "with OUTPUT_FILE.open(\"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(register, f, indent=2, ensure_ascii=False)\n",
        "\n",
        "with OUTPUT_FILE.open(\"r\", encoding=\"utf-8\") as f:\n",
        "    verified = json.load(f)\n",
        "\n",
        "assert len(verified[\"decisions\"]) == 5\n",
        "assert len({d[\"id\"] for d in verified[\"decisions\"]}) == 5\n",
        "assert verified[\"submission_blocking_count\"] == 3\n",
        "\n",
        "print(\"=\" * 100)\n",
        "print(\"EXPERIMENT 20 — STEP 3.1.7\")\n",
        "print(\"FINAL UNRESOLVED-DECISION REGISTER\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "for item in verified[\"decisions\"]:\n",
        "    print(f\"\\n{item['id']} — {item['decision']}\")\n",
        "    print(\"Status:\", item[\"current_status\"])\n",
        "    print(\"Blocks submission:\", item[\"blocks_manuscript_submission\"])\n",
        "    print(\"Required action:\", item[\"required_action\"])\n",
        "\n",
        "print(\"\\nTotal decisions:\", verified[\"decision_count\"])\n",
        "print(\"Submission-blocking decisions:\", verified[\"submission_blocking_count\"])\n",
        "print(\"JSON reload: PASS\")\n",
        "print(\"Saved:\", OUTPUT_FILE)\n",
        "print(\"=\" * 100)"
      ],
