            "[5] DATASET AND METHODOLOGICAL LIMITATIONS\n",
            "-------------------------------------------------------------------------------------\n",
            "\n",
            "[FOUND] Methodological limitations (Section 2.10)\n",
            "Words: 270\n",
            "\n",
            "[FOUND] Discussion limitations (Section 4.6)\n",
            "Words: 374\n",
            "[FOUND] Dataset provenance\n",
            "[FOUND] Dataset acquisition constraints\n",
            "[FOUND] Reference capture limitation\n",
            "[FOUND] Architecture limitation\n",
