      "cell_type": "code",
      "source": [
        "\n",
        "import pandas as pd\n",
        "from pathlib import Path\n",
        "\n",
        "ROOT = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "FREEZE = ROOT / \"step_2_7\" / \"final_freeze\"\n",
        "\n",
        "files = {\n",
        "    \"Group statistics\": FREEZE / \"experiment20_illumination_group_descriptive_statistics.csv\",\n",
        "    \"Friedman results\": FREEZE / \"experiment20_repeated_measures_test_results.csv\",\n",
        "    \"Hemisphere comparisons\": FREEZE / \"experiment20_hemisphere_comparison_results.csv\",\n",
        "    \"Displacement\": FREEZE / \"experiment20_reference_evaluation_displacement.csv\",\n",
        "}\n",
        "\n",
        "for label, path in files.items():\n",
