      "cell_type": "code",
      "source": [
        "from pathlib import Path\n",
        "import json\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "BASE = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "STEP_DIR = BASE / \"step_3_3\"\n",
        "OUTPUT_DIR = STEP_DIR / \"step_337\"\n",
        "OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 1. Load the five previously saved sections\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "files = {\n",
        "    \"background\": STEP_DIR / \"experiment20_step336_introduction_section1_background.json\",\n",
        "    \"illumination\": STEP_DIR / \"experiment20_step3362_introduction_illumination_context.json\",\n",
        "    \"research_gap\": STEP_DIR / \"experiment20_step3363_introduction_research_gap.json\",\n",
        "    \"research_questions\": STEP_DIR / \"experiment20_step3364_introduction_research_questions_objectives.json\",\n",
        "    \"contributions\": STEP_DIR / \"experiment20_step3365_introduction_contributions_scope.json\"\n",
        "}\n",
        "\n",
        "loaded = {}\n",
        "\n",
        "for name, path in files.items():\n",
        "    if not path.exists():\n",
        "        raise FileNotFoundError(f\"Required section is missing: {path}\")\n",
        "\n",
        "    with open(path, \"r\", encoding=\"utf-8\") as f:\n",
        "        loaded[name] = json.load(f)\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 2. Extract section drafts\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "background = loaded[\"background\"][\"draft\"]\n",
        "illumination = loaded[\"illumination\"][\"draft\"]\n",
        "research_gap = loaded[\"research_gap\"][\"draft\"]\n",
        "research_questions = loaded[\"research_questions\"][\"draft\"]\n",
        "contributions = loaded[\"contributions\"][\"draft\"]\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 3. Apply explicit numerical clarification\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "# The original contribution section gives the total image count.\n",
        "# Add the common-condition and evaluation counts to clarify\n",
        "# the different dataset stages.\n",
        "\n",
        "scope_clarification = (\n",
        "    \"Of the 2,414 standard-illumination images, \"\n",
        "    \"2,166 observations belong to the 57 common illumination \"\n",
        "    \"conditions. After excluding the reference condition, \"\n",
        "    \"2,128 non-reference observations across 56 evaluation \"\n",
        "    \"conditions are included in the displacement analysis.\"\n",
        ")\n",
        "\n",
        "# Add clarification after the paragraph describing dataset/model.\n",
        "scope_sentence = (\n",
        "    \"The evaluation uses the Cropped Extended Yale B dataset, \"\n",
        "    \"comprising 38 identities and 2,414 standard-illumination images, \"\n",
        "    \"and a fixed pretrained InceptionResnetV1 model.\"\n",
        ")\n",
        "\n",
        "if scope_sentence not in contributions:\n",
        "    raise ValueError(\n",
        "        \"Expected dataset scope sentence was not found. \"\n",
        "        \"Review the source section before modifying it.\"\n",
        "    )\n",
        "\n",
        "contributions = contributions.replace(\n",
        "    scope_sentence,\n",
        "    scope_sentence + \" \" + scope_clarification\n",
        ")\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 4. Assemble the consolidated introduction\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "title = (\n",
        "    \"# 1. Introduction\\n\\n\"\n",
        ")\n",
        "\n",
        "sections = [\n",
        "    (\"1.1 Background: Face Recognition and Deep Face Embeddings\", background),\n",
        "    (\"1.2 Illumination Variation and Its Effect on Facial Representations\", illumination),\n",
        "    (\"1.3 Research Gap and Motivation\", research_gap),\n",
        "    (\"1.4 Research Questions and Objectives\", research_questions),\n",
        "    (\"1.5 Study Contributions and Scope\", contributions)\n",
        "]\n",
        "\n",
        "introduction_parts = [title]\n",
        "\n",
        "for heading, text_content in sections:\n",
        "    introduction_parts.append(f\"## {heading}\\n\\n{text_content.strip()}\\n\")\n",
        "\n",
        "introduction_markdown = \"\\n\".join(introduction_parts).strip() + \"\\n\"\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 5. Audit checks\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "all_text = introduction_markdown.lower()\n",
        "\n",
        "checks = {\n",
        "    \"all_five_sections_present\": len(sections) == 5,\n",
        "    \"reference_relative_terminology_present\": \"reference-relative\" in all_text,\n",
        "    \"euclidean_metric_present\": \"euclidean\" in all_text,\n",
        "    \"cosine_metric_present\": \"cosine distance\" in all_text,\n",
        "    \"three_illumination_groups_present\": all(\n",
        "        term in all_text\n",
        "        for term in [\"near-frontal\", \"oblique\", \"large-angular\"]\n",
        "    ),\n",
        "    \"38_identities_present\": \"38 identities\" in all_text,\n",
        "    \"2414_total_images_present\": \"2,414\" in introduction_markdown,\n",
        "    \"2166_common_observations_present\": \"2,166\" in introduction_markdown,\n",
        "    \"2128_evaluation_observations_present\": \"2,128\" in introduction_markdown,\n",
        "    \"56_evaluation_conditions_present\": \"56 evaluation conditions\" in all_text,\n",
        "    \"retrospective_hypotheses_disclosed\": \"retrospective\" in all_text,\n",
        "    \"exploratory_analysis_distinguished\": \"exploratory\" in all_text,\n",
        "    \"different_capture_limitation_present\": \"different captures\" in all_text,\n",
        "    \"recognition_accuracy_not_claimed\": \"does not evaluate face-recognition accuracy\" in all_text,\n",
        "    \"architecture_generalisation_limitation_present\": \"independent recognition architectures\" in all_text\n",
        "}\n",
        "\n",
        "# Research question identifiers\n",
        "rq_checks = {\n",
        "    \"RQ1_present\": \"RQ1:\" in introduction_markdown,\n",
        "    \"RQ2_present\": \"RQ2:\" in introduction_markdown,\n",
