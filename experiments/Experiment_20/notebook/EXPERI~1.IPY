', 'repeated_measures_groups', 'friedman_results', 'pairwise_results', 'bootstrap_results', 'bootstrap_iterations', 'random_seed', 'multiple_comparison_correction', 'friedman_results_csv', 'friedman_results_sha256', 'paired_results_csv', 'paired_results_sha256', 'interpretation_limitations']\\n\",\"\\n\",\"------------------------------------------------------------------------------------------\\n\",\"FILE: experiment20_step275_hemisphere_analysis_audit.json\\n\",\"SIZE: 3,760 bytes\\n\",\"SHA256: 8e67df43014df6f386c96af58da4054a39e1b00539453669d7d3fc62a88a20b4\\n\",\"TYPE: JSON\\n\",\"VALID JSON: YES\\n\",\"TOP-LEVEL TYPE: dict\\n\",\"TOP-LEVEL KEYS: ['experiment', 'step', 'timestamp_utc', 'audit_status', 'audit_checks', 'identities', 'hemisphere_condition_counts', 'hemisphere_observation_counts', 'comparison_results', 'bootstrap_results', 'bootstrap_iterations', 'random_seed', 'multiple_comparison_correction', 'identity_summary_csv', 'identity_summary_sha256', 'comparison_results_csv', 'comparison_results_sha256', 'interpretation_limitations']\\n\",\"\\n\",\"------------------------------------------------------------------------------------------\\n\",\"FILE: experiment20_step276_figure_generation_audit.json\\n\",\"SIZE: 2,717 bytes\\n\",\"SHA256: 826b76dbe0471f7c8014d8619b766e40464f1106502a42d596f1887471de325a\\n\",\"TYPE: JSON\\n\",\"VALID JSON: YES\\n\",\"TOP-LEVEL TYPE: dict\\n\",\"TOP-LEVEL KEYS: ['experiment', 'step', 'purpose', 'identity_column', 'identity_count', 'group_records', 'hemisphere_records', 'group_order', 'hemisphere_order', 'visualisation_unit', 'statistical_tests_performed', 'figures_generated', 'figures', 'audit_checks', 'audit_status']\\n\",\"\\n\",\"------------------------------------------------------------------------------------------\\n\",\"FILE: experiment20_step277_final_freeze_audit.json\\n\",\"SIZE: 744 bytes\\n\",\"SHA256: a281eb4e48aa21c9380a8516abda49552e5a0a7f5758a3dfc886a138d1e1e0eb\\n\",\"TYPE: JSON\\n\",\"VALID JSON: YES\\n\",\"TOP-LEVEL TYPE: dict\\n\",\"TOP-LEVEL KEYS: ['experiment', 'step', 'audit_checks', 'audit_status', 'frozen_artifact_count', 'freeze_directory']\\n\",\"\\n\",\"------------------------------------------------------------------------------------------\\n\",\"FILE: experiment20_step27_descriptive_analysis_protocol.json\\n\",\"SIZE: 17,182 bytes\\n\",\"SHA256: 2bea63ee5d3eeece5d7db34ae5581e541ad9b340883a753967d5be3e73af106e\\n\",\"TYPE: JSON\\n\",\"VALID JSON: YES\\n\",\"TOP-LEVEL TYPE: dict\\n\",\"TOP-LEVEL KEYS: ['experiment', 'step', 'title', 'protocol_status', 'analysis_type', 'dataset', 'unit_of_analysis', 'illumination_groups', 'condition_geometry', 'hemisphere_counts', 'primary_metrics', 'secondary_analysis', 'statistical_plan', 'detector_feasibility', 'preprocessing', 'limitations']\\n\",\"\\n\",\"==========================================================================================\\n\",\"INVENTORY SUMMARY\\n\",\"==========================================================================================\\n\",\"Total files: 22\\n\",\"Readable CSV files: 7\\n\",\"Valid JSON files: 10\\n\",\"Other files: 5\\n\",\"Read/parse errors: 0\\n\",\"\\n\",\"CSV ROW COUNTS\\n\",\"experiment20_hemisphere_comparison_results.csv: 2 rows\\n\",\"experiment20_identity_level_group_means.csv: 114 rows\\n\",\"experiment20_identity_level_hemisphere_means.csv: 76 rows\\n\",\"experiment20_illumination_group_descriptive_statistics.csv: 6 rows\\n\",\"experiment20_paired_comparison_results.csv: 6 rows\\n\",\"experiment20_reference_evaluation_displacement.csv: 2,128 rows\\n\",\"experiment20_repeated_measures_test_results.csv: 2 rows\\n\",\"\\n\",\"AUDIT STATUS: INVENTORY COMPLETED — NO READ/PARSE ERRORS\\n\",\"\\n\",\"NOTE: This is a file inventory, not an independent verification\\n\",\"of the statistical calculations.\\n\",\"==========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.1.2: Protocol and Preprocessing Review\\n\",\"\\n\",\"## Objective\\n\",\"Review the frozen analysis protocol and supporting audit records to identify methodological strengths, inconsistencies, and undocumented assumptions.\\n\",\"\\n\",\"## Documents examined\\n\",\"1. experiment20_step27_descriptive_analysis_protocol.json\\n\",\"2. experiment20_step271_protocol_feasibility_audit.json\\n\",\"3. experiment20_step272_displacement_audit.json\\n\",\"4. experiment20_step273_group_descriptive_audit.json\\n\",\"5. experiment20_step277_final_freeze_audit.json\\n\",\"\\n\",\"## Review areas\\n\",\"- Dataset cohort and common-condition selection\\n\",\"- Reference and evaluation design\\n\",\"- Illumination-angle calculations and grouping\\n\",\"- Embedding preprocessing\\n\",\"- Analysis-unit definitions\\n\",\"- Documented methodological limitations\\n\",\"\\n\",\"## Restrictions\\n\",\"- Read-only inspection.\\n\",\"- No modifications to frozen results.\\n\",\"- No new statistical tests.\\n\",\"- Do not infer undocumented preprocessing details.\\n\",\"\\n\",\"## Expected output\\n\",\"A structured evidence report separating:\\n\",\"1. What the documents explicitly establish.\\n\",\"2. What remains ambiguous or insufficiently documented.\\n\",\"3. Methodological issues requiring correction or qualification in the manuscript.\"],\"metadata\":{\"id\":\"e5BltjQHr9ae\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"\\n\",\"ROOT = Path(\\n\",\"    \\\"/content/drive/MyDrive/Experiment_20_Results/step_2_7/final_freeze\\\"\\n\",\")\\n\",\"\\n\",\"FILES = {\\n\",\"    \\\"protocol\\\": \\\"experiment20_step27_descriptive_analysis_protocol.json\\\",\\n\",\"    \\\"protocol_audit\\\": \\\"experiment20_step271_protocol_feasibility_audit.json\\\",\\n\",\"    \\\"displacement_audit\\\": \\\"experiment20_step272_displacement_audit.json\\\",\\n\",\"    \\\"group_audit\\\": \\\"experiment20_step273_group_descriptive_audit.json\\\",\\n\",\"    \\\"freeze_audit\\\": \\\"experiment20_step277_final_freeze_audit.json\\\"\\n\",\"}\\n\",\"\\n\",\"def load_json(filename):\\n\",\"    path = ROOT / filename\\n\",\"    if not path.exists():\\n\",\"        raise FileNotFoundError(f\\\"Required frozen file missing: {path}\\\")\\n\",\"    with path.open(\\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"        return json.load(f)\\n\",\"\\n\",\"documents = {\\n\",\"    name: load_json(filename)\\n\",\"    for name, filename in FILES.items()\\n\",\"}\\n\",\"\\n\",\"def print_section(title):\\n\",\"    print(\\\"\\\\n\\\" + \\\"=\\\" * 100)\\n\",\"    print(title)\\n\",\"    print(\\\"=\\\" * 100)\\n\",\"\\n\",\"def print_value(label, value):\\n\",\"    print(f\\\"\\\\n{label}:\\\")\\n\",\"    print(json.dumps(value, indent=2, ensure_ascii=False, default=str))\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 1. Protocol overview\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"protocol = documents[\\\"protocol\\\"]\\n\",\"\\n\",\"print_section(\\\"1. FROZEN PROTOCOL — CORE DESIGN\\\")\\n\",\"\\n\",\"for key in [\\n\",\"    \\\"experiment\\\",\\n\",\"    \\\"step\\\",\\n\",\"    \\\"title\\\",\\n\",\"    \\\"protocol_status\\\",\\n\",\"    \\\"analysis_type\\\",\\n\",\"    \\\"dataset\\\",\\n\",\"    \\\"unit_of_analysis\\\",\\n\",\"    \\\"illumination_groups\\\",\\n\",\"    \\\"hemisphere_counts\\\",\\n\",\"    \\\"primary_metrics\\\",\\n\",\"    \\\"secondary_analysis\\\",\\n\",\"    \\\"statistical_plan\\\",\\n\",\"    \\\"detector_feasibility\\\",\\n\",\"    \\\"preprocessing\\\",\\n\",\"    \\\"limitations\\\"\\n\",\"]:\\n\",\"    if key in protocol:\\n\",\"        print_value(key, protocol[key])\\n\",\"    else:\\n\",\"        print(f\\\"\\\\nMISSING PROTOCOL FIELD: {key}\\\")\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 2. Protocol feasibility audit\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print_section(\\\"2. PROTOCOL FEASIBILITY AUDIT\\\")\\n\",\"\\n\",\"protocol_audit = documents[\\\"protocol_audit\\\"]\\n\",\"\\n\",\"for key in [\\n\",\"    \\\"audit_status\\\",\\n\",\"    \\\"reference_condition\\\",\\n\",\"    \\\"reference_observations\\\",\\n\",\"    \\\"evaluation_conditions\\\",\\n\",\"    \\\"evaluation_observations\\\",\\n\",\"    \\\"group_condition_counts\\\",\\n\",\"    \\\"evaluation_group_counts\\\",\\n\",\"    \\\"hemisphere_counts\\\",\\n\",\"    \\\"statistical_feasibility\\\",\\n\",\"    \\\"audit_checks\\\"\\n\",\"]:\\n\",\"    if key in protocol_audit:\\n\",\"        print_value(key, protocol_audit[key])\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 3. Displacement audit\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print_section(\\\"3. DISPLACEMENT AUDIT\\\")\\n\",\"\\n\",\"displacement_audit = documents[\\\"displacement_audit\\\"]\\n\",\"\\n\",\"for key in [\\n\",\"    \\\"audit_status\\\",\\n\",\"    \\\"reference_condition\\\",\\n\",\"    \\\"reference_embeddings\\\",\\n\",\"    \\\"common_conditions\\\",\\n\",\"    \\\"evaluation_conditions\\\",\\n\",\"    \\\"evaluation_records\\\",\\n\",\"    \\\"unique_identities\\\",\\n\",\"    \\\"unique_evaluation_conditions\\\",\\n\",\"    \\\"group_observation_counts\\\",\\n\",\"    \\\"displacement_summary\\\",\\n\",\"    \\\"interpretation_limitations\\\",\\n\",\"    \\\"audit_checks\\\"\\n\",\"]:\\n\",\"    if key in displacement_audit:\\n\",\"        print_value(key, displacement_audit[key])\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 4. Group descriptive audit\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print_section(\\\"4. GROUP DESCRIPTIVE AUDIT\\\")\\n\",\"\\n\",\"group_audit = documents[\\\"group_audit\\\"]\\n\",\"\\n\",\"for key in [\\n\",\"    \\\"audit_status\\\",\\n\",\"    \\\"input_records\\\",\\n\",\"    \\\"unique_identities\\\",\\n\",\"    \\\"group_observation_counts\\\",\\n\",\"    \\\"identity_level_records\\\",\\n\",\"    \\\"identity_group_counts\\\",\\n\",\"    \\\"interpretation_limitations\\\",\\n\",\"    \\\"audit_checks\\\"\\n\",\"]:\\n\",\"    if key in group_audit:\\n\",\"        print_value(key, group_audit[key])\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 5. Final freeze audit\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print_section(\\\"5. FINAL FREEZE AUDIT\\\")\\n\",\"\\n\",\"freeze_audit = documents[\\\"freeze_audit\\\"]\\n\",\"\\n\",\"for key in [\\n\",\"    \\\"audit_status\\\",\\n\",\"    \\\"frozen_artifact_count\\\",\\n\",\"    \\\"freeze_directory\\\",\\n\",\"    \\\"audit_checks\\\"\\n\",\"]:\\n\",\"    if key in freeze_audit:\\n\",\"        print_value(key, freeze_audit[key])\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 6. Explicit evidence gaps\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print_section(\\\"6. DOCUMENTATION GAP CHECK\\\")\\n\",\"\\n\",\"checks = {\\n\",\"    \\\"Dataset provenance documented\\\": (\\n\",\"        \\\"dataset\\\" in protocol\\n\",\"    ),\\n\",\"    \\\"Reference condition documented\\\": (\\n\",\"        \\\"reference_condition\\\" in protocol_audit\\n\",\"    ),\\n\",\"    \\\"Evaluation cohort documented\\\": (\\n\",\"        \\\"evaluation_conditions\\\" in protocol_audit\\n\",\"        and \\\"evaluation_observations\\\" in protocol_audit\\n\",\"    ),\\n\",\"    \\\"Preprocessing documented\\\": (\\n\",\"        \\\"preprocessing\\\" in protocol\\n\",\"    ),\\n\",\"    \\\"Analysis unit documented\\\": (\\n\",\"        \\\"unit_of_analysis\\\" in protocol\\n\",\"    ),\\n\",\"    \\\"Interpretation limitations documented\\\": (\\n\",\"        \\\"limitations\\\" in protocol\\n\",\"        or \\\"interpretation_limitations\\\" in displacement_audit\\n\",\"    ),\\n\",\"    \\\"Final freeze audit present\\\": (\\n\",\"        freeze_audit.get(\\\"audit_status\\\") is not None\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"for label, passed in checks.items():\\n\",\"    print(f\\\"{'PRESENT' if passed else 'MISSING'}: {label}\\\")\\n\",\"\\n\",\"print_section(\\\"7. REVIEW STATUS\\\")\\n\",\"\\n\",\"print(\\\"Protocol and audit documents loaded successfully.\\\")\\n\",\"print(\\\"This step checks documentation, not the truth of every methodological claim.\\\")\\n\",\"print(\\\"No frozen files were modified.\\\")\\n\",\"print(\\\"\\\\nEND OF STEP 3.1.2\\\")\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"8o9hHBdyr_tt\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794385117554,\"user_tz\":360,\"elapsed\":117,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"fdc1224b-fe97-4f39-8983-a58292f427de\"},\"execution_count\":3,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"\\n\",\"====================================================================================================\\n\",\"1. FROZEN PROTOCOL — CORE DESIGN\\n\",\"====================================================================================================\\n\",\"\\n\",\"experiment:\\n\",\"\\\"Experiment 20\\\"\\n\",\"\\n\",\"step:\\n\",\"\\\"2.7.1\\\"\\n\",\"\\n\",\"title:\\n\",\"\\\"Descriptive Analysis of Within-Identity FaceNet Embedding Drift Under Controlled Illumination Conditions\\\"\\n\",\"\\n\",\"protocol_status:\\n\",\"\\\"DEFINED\\\"\\n\",\"\\n\",\"analysis_type:\\n\",\"\\\"descriptive_drift_analysis\\\"\\n\",\"\\n\",\"dataset:\\n\",\"{\\n\",\"  \\\"name\\\": \\\"Cropped Extended Yale B\\\",\\n\",\"  \\\"embedding_archive\\\": \\\"/content/drive/MyDrive/Experiment_20_Results/embeddings/experiment20_croppedyale_facenet_embeddings.npz\\\",\\n\",\"  \\\"identities\\\": 38,\\n\",\"  \\\"embedding_dimension\\\": 512,\\n\",\"  \\\"total_embedding_rows\\\": 2414,\\n\",\"  \\\"common_conditions\\\": 57,\\n\",\"  \\\"reference_condition\\\": \\\"A+000E+00\\\",\\n\",\"  \\\"reference_observations\\\": 38,\\n\",\"  \\\"evaluation_conditions\\\": 56,\\n\",\"  \\\"evaluation_observations\\\": 2128\\n\",\"}\\n\",\"\\n\",\"unit_of_analysis:\\n\",\"{\\n\",\"  \\\"primary\\\": \\\"identity-condition observation\\\",\\n\",\"  \\\"repeated_measures_unit\\\": \\\"identity\\\",\\n\",\"  \\\"condition_unit\\\": \\\"illumination condition\\\",\\n\",\"  \\\"pairing_description\\\": \\\"Identity-condition matched repeated captures; not exact source-image pairs.\\\"\\n\",\"}\\n\",\"\\n\",\"illumination_groups:\\n\",\"{\\n\",\"  \\\"near_frontal\\\": {\\n\",\"    \\\"conditions\\\": [\\n\",\"      \\\"A+000E+00\\\",\\n\",\"      \\\"A+000E+20\\\",\\n\",\"      \\\"A+000E-20\\\",\\n\",\"      \\\"A+005E+10\\\",\\n\",\"      \\\"A+005E-10\\\",\\n\",\"      \\\"A+010E+00\\\",\\n\",\"      \\\"A+010E-20\\\",\\n\",\"      \\\"A+015E+20\\\",\\n\",\"      \\\"A+020E+10\\\",\\n\",\"      \\\"A+020E-10\\\",\\n\",\"      \\\"A+025E+00\\\",\\n\",\"      \\\"A-005E+10\\\",\\n\",\"      \\\"A-005E-10\\\",\\n\",\"      \\\"A-010E-20\\\",\\n\",\"      \\\"A-015E+20\\\",\\n\",\"      \\\"A-020E+10\\\",\\n\",\"      \\\"A-020E-10\\\",\\n\",\"      \\\"A-025E+00\\\"\\n\",\"    ],\\n\",\"    \\\"condition_count\\\": 18,\\n\",\"    \\\"evaluation_condition_count\\\": 17,\\n\",\"    \\\"evaluation_observation_count\\\": 646\\n\",\"  },\\n\",\"  \\\"oblique\\\": {\\n\",\"    \\\"conditions\\\": [\\n\",\"      \\\"A+000E+45\\\",\\n\",\"      \\\"A+000E-35\\\",\\n\",\"      \\\"A+020E-40\\\",\\n\",\"      \\\"A+035E+15\\\",\\n\",\"      \\\"A+035E+40\\\",\\n\",\"      \\\"A+035E-20\\\",\\n\",\"      \\\"A+050E+00\\\",\\n\",\"      \\\"A-020E-40\\\",\\n\",\"      \\\"A-035E+15\\\",\\n\",\"      \\\"A-035E-20\\\",\\n\",\"      \\\"A-050E+00\\\"\\n\",\"    ],\\n\",\"    \\\"condition_count\\\": 11,\\n\",\"    \\\"evaluation_condition_count\\\": 11,\\n\",\"    \\\"evaluation_observation_count\\\": 418\\n\",\"  },\\n\",\"  \\\"large_angular_deviation\\\": {\\n\",\"    \\\"conditions\\\": [\\n\",\"      \\\"A+000E+90\\\",\\n\",\"      \\\"A+035E+65\\\",\\n\",\"      \\\"A+060E+20\\\",\\n\",\"      \\\"A+060E-20\\\",\\n\",\"      \\\"A+070E+00\\\",\\n\",\"      \\\"A+070E+45\\\",\\n\",\"      \\\"A+070E-35\\\",\\n\",\"      \\\"A+085E+20\\\",\\n\",\"      \\\"A+085E-20\\\",\\n\",\"      \\\"A+110E+15\\\",\\n\",\"      \\\"A+110E+40\\\",\\n\",\"      \\\"A+110E+65\\\",\\n\",\"      \\\"A+110E-20\\\",\\n\",\"      \\\"A+120E+00\\\",\\n\",\"      \\\"A+130E+20\\\",\\n\",\"      \\\"A-035E+65\\\",\\n\",\"      \\\"A-060E+20\\\",\\n\",\"      \\\"A-060E-20\\\",\\n\",\"      \\\"A-070E+00\\\",\\n\",\"      \\\"A-070E+45\\\",\\n\",\"      \\\"A-070E-35\\\",\\n\",\"      \\\"A-085E+20\\\",\\n\",\"      \\\"A-085E-20\\\",\\n\",\"      \\\"A-095E+00\\\",\\n\",\"      \\\"A-110E+40\\\",\\n\",\"      \\\"A-110E+65\\\",\\n\",\"      \\\"A-120E+00\\\",\\n\",\"      \\\"A-130E+20\\\"\\n\",\"    ],\\n\",\"    \\\"condition_count\\\": 28,\\n\",\"    \\\"evaluation_condition_count\\\": 28,\\n\",\"    \\\"evaluation_observation_count\\\": 1064\\n\",\"  }\\n\",\"}\\n\",\"\\n\",\"hemisphere_counts:\\n\",\"{\\n\",\"  \\\"frontal_hemisphere\\\": 46,\\n\",\"  \\\"beyond_frontal_hemisphere\\\": 11\\n\",\"}\\n\",\"\\n\",\"primary_metrics:\\n\",\"[\\n\",\"  \\\"Euclidean displacement from identity reference embedding\\\",\\n\",\"  \\\"Cosine distance from identity reference embedding\\\",\\n\",\"  \\\"Group-level displacement distributions\\\",\\n\",\"  \\\"Identity-level displacement variation\\\"\\n\",\"]\\n\",\"\\n\",\"secondary_analysis:\\n\",\"[\\n\",\"  \\\"Frontal versus beyond-frontal hemisphere comparisons\\\"\\n\",\"]\\n\",\"\\n\",\"statistical_plan:\\n\",\"{\\n\",\"  \\\"report_identity_level_variation\\\": true,\\n\",\"  \\\"avoid_pseudoreplication\\\": true,\\n\",\"  \\\"report_effect_sizes\\\": true,\\n\",\"  \\\"report_confidence_intervals\\\": true,\\n\",\"  \\\"multiple_comparison_correction\\\": true,\\n\",\"  \\\"operational_false_alarm_claims\\\": false,\\n\",\"  \\\"calibrated_thresholds\\\": false\\n\",\"}\\n\",\"\\n\",\"detector_feasibility:\\n\",\"{\\n\",\"  \\\"within_identity_euclidean_displacement\\\": {\\n\",\"    \\\"status\\\": \\\"SUPPORTED\\\",\\n\",\"    \\\"reason\\\": \\\"Each identity has one reference embedding and one embedding for each common illumination condition.\\\"\\n\",\"  },\\n\",\"  \\\"within_identity_cosine_distance\\\": {\\n\",\"    \\\"status\\\": \\\"SUPPORTED\\\",\\n\",\"    \\\"reason\\\": \\\"Cosine distance can be computed between each identity's reference and evaluation embeddings.\\\"\\n\",\"  },\\n\",\"  \\\"identity_level_repeated_measures\\\": {\\n\",\"    \\\"status\\\": \\\"SUPPORTED\\\",\\n\",\"    \\\"reason\\\": \\\"The same 38 identities are observed across the 56 evaluation conditions.\\\"\\n\",\"  },\\n\",\"  \\\"identity_conditioned_covariance_detector\\\": {\\n\",\"    \\\"status\\\": \\\"NOT_SUPPORTED_WITH_CURRENT_REFERENCE\\\",\\n\",\"    \\\"reason\\\": \\\"Only one reference embedding per identity is available. An individual within-identity covariance matrix cannot be estimated from one observation.\\\"\\n\",\"  },\\n\",\"  \\\"global_mahalanobis_detector\\\": {\\n\",\"    \\\"status\\\": \\\"REQUIRES_SEPARATE_JUSTIFICATION\\\",\\n\",\"    \\\"reason\\\": \\\"The reference cohort contains 38 observations in 512 dimensions. The empirical covariance matrix cannot be full rank without regularisation or dimension reduction.\\\"\\n\",\"  },\\n\",\"  \\\"operational_false_alarm_rate\\\": {\\n\",\"    \\\"status\\\": \\\"NOT_SUPPORTED\\\",\\n\",\"    \\\"reason\\\": \\\"The current design does not provide an independent unchanged-control sequence for operational false-alarm estimation.\\\"\\n\",\"  },\\n\",\"  \\\"calibrated_detection_thresholds\\\": {\\n\",\"    \\\"status\\\": \\\"NOT_USED\\\",\\n\",\"    \\\"reason\\\": \\\"The selected primary analysis is descriptive.\\\"\\n\",\"  }\\n\",\"}\\n\",\"\\n\",\"preprocessing:\\n\",\"{\\n\",\"  \\\"grayscale_to_rgb\\\": true,\\n\",\"  \\\"resize\\\": [\\n\",\"    160,\\n\",\"    160\\n\",\"  ],\\n\",\"  \\\"tensor_conversion\\\": \\\"ToTensor\\\",\\n\",\"  \\\"face_detection\\\": false,\\n\",\"  \\\"face_alignment\\\": false\\n\",\"}\\n\",\"\\n\",\"limitations:\\n\",\"[\\n\",\"  \\\"The dataset contains different captures across illumination conditions.\\\",\\n\",\"  \\\"The observations are not exact source-image perturbation pairs.\\\",\\n\",\"  \\\"There is only one reference embedding per identity.\\\",\\n\",\"  \\\"Identity-conditioned covariance cannot be estimated from the current reference cohort.\\\",\\n\",\"  \\\"Global covariance-based Mahalanobis analysis requires separate justification.\\\",\\n\",\"  \\\"Descriptive displacement does not establish recognition accuracy.\\\",\\n\",\"  \\\"Descriptive analysis does not establish operational false-alarm control.\\\"\\n\",\"]\\n\",\"\\n\",\"====================================================================================================\\n\",\"2. PROTOCOL FEASIBILITY AUDIT\\n\",\"====================================================================================================\\n\",\"\\n\",\"audit_status:\\n\",\"\\\"PASSED\\\"\\n\",\"\\n\",\"reference_condition:\\n\",\"\\\"A+000E+00\\\"\\n\",\"\\n\",\"reference_observations:\\n\",\"38\\n\",\"\\n\",\"evaluation_conditions:\\n\",\"56\\n\",\"\\n\",\"evaluation_observations:\\n\",\"2128\\n\",\"\\n\",\"group_condition_counts:\\n\",\"{\\n\",\"  \\\"near_frontal\\\": 18,\\n\",\"  \\\"oblique\\\": 11,\\n\",\"  \\\"large_angular_deviation\\\": 28\\n\",\"}\\n\",\"\\n\",\"evaluation_group_counts:\\n\",\"{\\n\",\"  \\\"near_frontal\\\": {\\n\",\"    \\\"conditions\\\": 17,\\n\",\"    \\\"observations\\\": 646\\n\",\"  },\\n\",\"  \\\"oblique\\\": {\\n\",\"    \\\"conditions\\\": 11,\\n\",\"    \\\"observations\\\": 418\\n\",\"  },\\n\",\"  \\\"large_angular_deviation\\\": {\\n\",\"    \\\"conditions\\\": 28,\\n\",\"    \\\"observations\\\": 1064\\n\",\"  }\\n\",\"}\\n\",\"\\n\",\"hemisphere_counts:\\n\",\"{\\n\",\"  \\\"frontal_hemisphere\\\": 46,\\n\",\"  \\\"beyond_frontal_hemisphere\\\": 11\\n\",\"}\\n\",\"\\n\",\"statistical_feasibility:\\n\",\"{\\n\",\"  \\\"within_identity_euclidean_displacement\\\": {\\n\",\"    \\\"status\\\": \\\"SUPPORTED\\\",\\n\",\"    \\\"reason\\\": \\\"Each identity has one reference embedding and one embedding for each common illumination condition.\\\"\\n\",\"  },\\n\",\"  \\\"within_identity_cosine_distance\\\": {\\n\",\"    \\\"status\\\": \\\"SUPPORTED\\\",\\n\",\"    \\\"reason\\\": \\\"Cosine distance can be computed between each identity's reference and evaluation embeddings.\\\"\\n\",\"  },\\n\",\"  \\\"identity_level_repeated_measures\\\": {\\n\",\"    \\\"status\\\": \\\"SUPPORTED\\\",\\n\",\"    \\\"reason\\\": \\\"The same 38 identities are observed across the 56 evaluation conditions.\\\"\\n\",\"  },\\n\",\"  \\\"identity_conditioned_covariance_detector\\\": {\\n\",\"    \\\"status\\\": \\\"NOT_SUPPORTED_WITH_CURRENT_REFERENCE\\\",\\n\",\"    \\\"reason\\\": \\\"Only one reference embedding per identity is available. An individual within-identity covariance matrix cannot be estimated from one observation.\\\"\\n\",\"  },\\n\",\"  \\\"global_mahalanobis_detector\\\": {\\n\",\"    \\\"status\\\": \\\"REQUIRES_SEPARATE_JUSTIFICATION\\\",\\n\",\"    \\\"reason\\\": \\\"The reference cohort contains 38 observations in 512 dimensions. The empirical covariance matrix cannot be full rank without regularisation or dimension reduction.\\\"\\n\",\"  },\\n\",\"  \\\"operational_false_alarm_rate\\\": {\\n\",\"    \\\"status\\\": \\\"NOT_SUPPORTED\\\",\\n\",\"    \\\"reason\\\": \\\"The current design does not provide an independent unchanged-control sequence for operational false-alarm estimation.\\\"\\n\",\"  },\\n\",\"  \\\"calibrated_detection_thresholds\\\": {\\n\",\"    \\\"status\\\": \\\"NOT_USED\\\",\\n\",\"    \\\"reason\\\": \\\"The selected primary analysis is descriptive.\\\"\\n\",\"  }\\n\",\"}\\n\",\"\\n\",\"audit_checks:\\n\",\"{\\n\",\"  \\\"correct_embedding_shape\\\": true,\\n\",\"  \\\"all_embeddings_finite\\\": true,\\n\",\"  \\\"38_unique_identities\\\": true,\\n\",\"  \\\"57_common_conditions\\\": true,\\n\",\"  \\\"reference_condition_present\\\": true,\\n\",\"  \\\"one_reference_per_identity\\\": true,\\n\",\"  \\\"56_evaluation_conditions\\\": true,\\n\",\"  \\\"2128_evaluation_observations\\\": true,\\n\",\"  \\\"illumination_group_counts_valid\\\": true,\\n\",\"  \\\"hemisphere_counts_valid\\\": true\\n\",\"}\\n\",\"\\n\",\"====================================================================================================\\n\",\"3. DISPLACEMENT AUDIT\\n\",\"====================================================================================================\\n\",\"\\n\",\"audit_status:\\n\",\"\\\"PASSED\\\"\\n\",\"\\n\",\"reference_condition:\\n\",\"\\\"A+000E+00\\\"\\n\",\"\\n\",\"reference_embeddings:\\n\",\"38\\n\",\"\\n\",\"common_conditions:\\n\",\"57\\n\",\"\\n\",\"evaluation_conditions:\\n\",\"56\\n\",\"\\n\",\"evaluation_records:\\n\",\"2128\\n\",\"\\n\",\"unique_identities:\\n\",\"38\\n\",\"\\n\",\"unique_evaluation_conditions:\\n\",\"56\\n\",\"\\n\",\"group_observation_counts:\\n\",\"{\\n\",\"  \\\"large_angular_deviation\\\": 1064,\\n\",\"  \\\"near_frontal\\\": 646,\\n\",\"  \\\"oblique\\\": 418\\n\",\"}\\n\",\"\\n\",\"displacement_summary:\\n\",\"{\\n\",\"  \\\"euclidean_min\\\": 0.1516810430391137,\\n\",\"  \\\"euclidean_max\\\": 1.522514104406745,\\n\",\"  \\\"euclidean_mean\\\": 0.8204963498696879,\\n\",\"  \\\"euclidean_median\\\": 0.817311380200809,\\n\",\"  \\\"cosine_distance_min\\\": 0.011503569787168377,\\n\",\"  \\\"cosine_distance_max\\\": 1.1590245954458218,\\n\",\"  \\\"cosine_distance_mean\\\": 0.40243902507475376,\\n\",\"  \\\"cosine_distance_median\\\": 0.333998932472858\\n\",\"}\\n\",\"\\n\",\"interpretation_limitations:\\n\",\"[\\n\",\"  \\\"Displacement is descriptive, not a calibrated detector score.\\\",\\n\",\"  \\\"Observations are repeated within identity.\\\",\\n\",\"  \\\"The dataset does not establish operational false-alarm rates.\\\",\\n\",\"  \\\"Embedding displacement does not directly establish recognition accuracy.\\\"\\n\",\"]\\n\",\"\\n\",\"audit_checks:\\n\",\"{\\n\",\"  \\\"embedding_archive_shape_valid\\\": true,\\n\",\"  \\\"embedding_values_finite\\\": true,\\n\",\"  \\\"reference_embeddings_valid\\\": true,\\n\",\"  \\\"common_conditions_from_frozen_protocol\\\": true,\\n\",\"  \\\"evaluation_conditions_valid\\\": true,\\n\",\"  \\\"evaluation_record_count_valid\\\": true,\\n\",\"  \\\"identity_condition_pairs_unique\\\": true,\\n\",\"  \\\"all_displacements_finite\\\": true,\\n\",\"  \\\"all_cosine_distances_valid\\\": true,\\n\",\"  \\\"reference_condition_excluded\\\": true,\\n\",\"  \\\"illumination_group_counts_valid\\\": true,\\n\",\"  \\\"csv_file_created\\\": true\\n\",\"}\\n\",\"\\n\",\"====================================================================================================\\n\",\"4. GROUP DESCRIPTIVE AUDIT\\n\",\"====================================================================================================\\n\",\"\\n\",\"audit_status:\\n\",\"\\\"PASSED\\\"\\n\",\"\\n\",\"input_records:\\n\",\"2128\\n\",\"\\n\",\"unique_identities:\\n\",\"38\\n\",\"\\n\",\"group_observation_counts:\\n\",\"{\\n\",\"  \\\"large_angular_deviation\\\": 1064,\\n\",\"  \\\"near_frontal\\\": 646,\\n\",\"  \\\"oblique\\\": 418\\n\",\"}\\n\",\"\\n\",\"identity_level_records:\\n\",\"114\\n\",\"\\n\",\"identity_group_counts:\\n\",\"{\\n\",\"  \\\"large_angular_deviation\\\": 38,\\n\",\"  \\\"near_frontal\\\": 38,\\n\",\"  \\\"oblique\\\": 38\\n\",\"}\\n\",\"\\n\",\"interpretation_limitations:\\n\",\"[\\n\",\"  \\\"Observation-level values are repeated within identity.\\\",\\n\",\"  \\\"Identity-level group means are the appropriate input for subsequent repeated-measures comparisons.\\\",\\n\",\"  \\\"No statistical significance is established in this step.\\\",\\n\",\"  \\\"No calibrated detection performance is established.\\\"\\n\",\"]\\n\",\"\\n\",\"audit_checks:\\n\",\"{\\n\",\"  \\\"input_csv_exists\\\": true,\\n\",\"  \\\"input_record_count_valid\\\": true,\\n\",\"  \\\"identity_count_valid\\\": true,\\n\",\"  \\\"identity_condition_records_unique\\\": true,\\n\",\"  \\\"all_metrics_finite\\\": true,\\n\",\"  \\\"illumination_group_counts_valid\\\": true,\\n\",\"  \\\"three_groups_present\\\": true,\\n\",\"  \\\"identity_level_record_count_valid\\\": true,\\n\",\"  \\\"all_identities_present_in_each_group\\\": true,\\n\",\"  \\\"group_summary_file_created\\\": true,\\n\",\"  \\\"identity_summary_file_created\\\": true,\\n\",\"  \\\"group_summary_rows_valid\\\": true,\\n\",\"  \\\"identity_distribution_rows_valid\\\": true\\n\",\"}\\n\",\"\\n\",\"====================================================================================================\\n\",\"5. FINAL FREEZE AUDIT\\n\",\"====================================================================================================\\n\",\"\\n\",\"audit_status:\\n\",\"\\\"PASSED\\\"\\n\",\"\\n\",\"frozen_artifact_count:\\n\",\"18\\n\",\"\\n\",\"freeze_directory:\\n\",\"\\\"/content/drive/MyDrive/Experiment_20_Results/step_2_7/final_freeze\\\"\\n\",\"\\n\",\"audit_checks:\\n\",\"{\\n\",\"  \\\"all_required_artifacts_found\\\": true,\\n\",\"  \\\"all_csv_row_counts_valid\\\": true,\\n\",\"  \\\"displacement_identity_count_valid\\\": true,\\n\",\"  \\\"group_identity_count_valid\\\": true,\\n\",\"  \\\"hemisphere_identity_count_valid\\\": true,\\n\",\"  \\\"previous_audit_json_files_valid\\\": true,\\n\",\"  \\\"hemisphere_audit_passed\\\": true,\\n\",\"  \\\"figure_audit_passed\\\": true,\\n\",\"  \\\"all_frozen_hashes_match\\\": true,\\n\",\"  \\\"summary_json_valid\\\": true,\\n\",\"  \\\"report_exists\\\": true,\\n\",\"  \\\"manifest_reloads\\\": true\\n\",\"}\\n\",\"\\n\",\"====================================================================================================\\n\",\"6. DOCUMENTATION GAP CHECK\\n\",\"====================================================================================================\\n\",\"PRESENT: Dataset provenance documented\\n\",\"PRESENT: Reference condition documented\\n\",\"PRESENT: Evaluation cohort documented\\n\",\"PRESENT: Preprocessing documented\\n\",\"PRESENT: Analysis unit documented\\n\",\"PRESENT: Interpretation limitations documented\\n\",\"PRESENT: Final freeze audit present\\n\",\"\\n\",\"====================================================================================================\\n\",\"7. REVIEW STATUS\\n\",\"====================================================================================================\\n\",\"Protocol and audit documents loaded successfully.\\n\",\"This step checks documentation, not the truth of every methodological claim.\\n\",\"No frozen files were modified.\\n\",\"\\n\",\"END OF STEP 3.1.2\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.1.3: Independent Statistical Reproduction (Corrected)\\n\",\"\\n\",\"## Objective\\n\",\"Independently reproduce the frozen repeated-measures results, including the original Holm correction procedure.\\n\",\"\\n\",\"## Statistical tests\\n\",\"- Friedman tests for both displacement metrics.\\n\",\"- Kendall's W for each Friedman test.\\n\",\"- Three paired Wilcoxon comparisons per metric.\\n\",\"- Holm correction applied separately within each metric's three-comparison family.\\n\",\"\\n\",\"## Correction-family clarification\\n\",\"The original frozen results use two separate correction families:\\n\",\"1. Three Euclidean pairwise comparisons.\\n\",\"2. Three cosine pairwise comparisons.\\n\",\"\\n\",\"A separate six-comparison correction would be more conservative but would not reproduce the original analysis.\\n\",\"\\n\",\"## Validation\\n\",\"Recalculated statistics, raw p-values, Kendall's W, and Holm-adjusted p-values will be compared with the frozen result tables.\\n\",\"\\n\",\"## Restrictions\\n\",\"- Identity remains the inferential unit (n = 38).\\n\",\"- Frozen source files will not be modified.\\n\",\"- This step reproduces the original analysis; it does not resolve the protocol's undocumented correction-family choice.\"],\"metadata\":{\"id\":\"kYzcGwRysjer\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"from scipy.stats import friedmanchisquare, wilcoxon\\n\",\"\\n\",\"ROOT = Path(\\n\",\"    \\\"/content/drive/MyDrive/Experiment_20_Results/step_2_7/final_freeze\\\"\\n\",\")\\n\",\"\\n\",\"identity_df = pd.read_csv(\\n\",\"    ROOT / \\\"experiment20_identity_level_group_means.csv\\\"\\n\",\")\\n\",\"\\n\",\"frozen_friedman = pd.read_csv(\\n\",\"    ROOT / \\\"experiment20_repeated_measures_test_results.csv\\\"\\n\",\")\\n\",\"\\n\",\"frozen_pairwise = pd.read_csv(\\n\",\"    ROOT / \\\"experiment20_paired_comparison_results.csv\\\"\\n\",\")\\n\",\"\\n\",\"groups = [\\n\",\"    \\\"near_frontal\\\",\\n\",\"    \\\"oblique\\\",\\n\",\"    \\\"large_angular_deviation\\\"\\n\",\"]\\n\",\"\\n\",\"metrics = [\\\"euclidean_mean\\\", \\\"cosine_mean\\\"]\\n\",\"\\n\",\"pairs = [\\n\",\"    (\\\"near_frontal\\\", \\\"oblique\\\"),\\n\",\"    (\\\"near_frontal\\\", \\\"large_angular_deviation\\\"),\\n\",\"    (\\\"oblique\\\", \\\"large_angular_deviation\\\")\\n\",\"]\\n\",\"\\n\",\"print(\\\"=\\\" * 100)\\n\",\"print(\\\"CORRECTED INDEPENDENT STATISTICAL REPRODUCTION\\\")\\n\",\"print(\\\"=\\\" * 100)\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 1. Validate identity-level data\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"if len(identity_df) != 114:\\n\",\"    raise ValueError(\\\"Expected 114 identity-group records.\\\")\\n\",\"\\n\",\"if identity_df[\\\"subject\\\"].nunique() != 38:\\n\",\"    raise ValueError(\\\"Expected 38 unique identities.\\\")\\n\",\"\\n\",\"if identity_df.duplicated([\\\"subject\\\", \\\"illumination_group\\\"]).any():\\n\",\"    raise ValueError(\\\"Duplicate identity-group records found.\\\")\\n\",\"\\n\",\"wide = {}\\n\",\"\\n\",\"for metric in metrics:\\n\",\"    pivot = identity_df.pivot(\\n\",\"        index=\\\"subject\\\",\\n\",\"        columns=\\\"illumination_group\\\",\\n\",\"        values=metric\\n\",\"    )[groups].sort_index()\\n\",\"\\n\",\"    if pivot.isna().any().any():\\n\",\"        raise ValueError(f\\\"Missing values in {metric}.\\\")\\n\",\"\\n\",\"    if not np.isfinite(pivot.to_numpy()).all():\\n\",\"        raise ValueError(f\\\"Non-finite values in {metric}.\\\")\\n\",\"\\n\",\"    wide[metric] = pivot\\n\",\"\\n\",\"print(\\\"Identity-level validation: PASSED\\\")\\n\",\"print(\\\"Identities: 38\\\")\\n\",\"print(\\\"Repeated-measures groups: 3\\\")\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 2. Friedman tests and Kendall's W\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"friedman_ok = True\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 100)\\n\",\"print(\\\"FRIEDMAN TESTS\\\")\\n\",\"print(\\\"=\\\" * 100)\\n\",\"\\n\",\"for metric, pivot in wide.items():\\n\",\"\\n\",\"    result = friedmanchisquare(\\n\",\"        *[pivot[group].to_numpy() for group in groups]\\n\",\"    )\\n\",\"\\n\",\"    kendalls_w = result.statistic / (len(pivot) * (len(groups) - 1))\\n\",\"\\n\",\"    frozen = frozen_friedman[\\n\",\"        frozen_friedman[\\\"metric\\\"] == metric\\n\",\"    ]\\n\",\"\\n\",\"    if len(frozen) != 1:\\n\",\"        raise ValueError(f\\\"Unexpected frozen Friedman rows for {metric}.\\\")\\n\",\"\\n\",\"    frozen = frozen.iloc[0]\\n\",\"\\n\",\"    checks = [\\n\",\"        np.isclose(result.statistic, frozen[\\\"test_statistic\\\"]),\\n\",\"        np.isclose(result.pvalue, frozen[\\\"p_value\\\"], rtol=1e-8, atol=1e-15),\\n\",\"        np.isclose(kendalls_w, frozen[\\\"kendalls_w\\\"])\\n\",\"    ]\\n\",\"\\n\",\"    friedman_ok = friedman_ok and all(checks)\\n\",\"\\n\",\"    print(f\\\"\\\\n{metric}\\\")\\n\",\"    print(f\\\"Statistic: recalculated={result.statistic:.12g} | frozen={frozen['test_statistic']:.12g}\\\")\\n\",\"    print(f\\\"P-value: recalculated={result.pvalue:.12g} | frozen={frozen['p_value']:.12g}\\\")\\n\",\"    print(f\\\"Kendall's W: recalculated={kendalls_w:.12g} | frozen={frozen['kendalls_w']:.12g}\\\")\\n\",\"    print(f\\\"All checks passed: {all(checks)}\\\")\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 3. Holm correction within each metric\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"def holm_adjust(p_values):\\n\",\"    p_values = np.asarray(p_values, dtype=float)\\n\",\"    m = len(p_values)\\n\",\"\\n\",\"    order = np.argsort(p_values)\\n\",\"    sorted_p = p_values[order]\\n\",\"\\n\",\"    adjusted_sorted = np.maximum.accumulate(\\n\",\"        (m - np.arange(m)) * sorted_p\\n\",\"    )\\n\",\"\\n\",\"    adjusted_sorted = np.minimum(adjusted_sorted, 1.0)\\n\",\"\\n\",\"    adjusted = np.empty(m)\\n\",\"    adjusted[order] = adjusted_sorted\\n\",\"\\n\",\"    return adjusted\\n\",\"\\n\",\"pairwise_ok = True\\n\",\"holm_ok = True\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 100)\\n\",\"print(\\\"PAIRED WILCOXON TESTS AND WITHIN-METRIC HOLM CORRECTION\\\")\\n\",\"print(\\\"=\\\" * 100)\\n\",\"\\n\",\"for metric, pivot in wide.items():\\n\",\"\\n\",\"    metric_results = []\\n\",\"\\n\",\"    print(f\\\"\\\\nMETRIC FAMILY: {metric}\\\")\\n\",\"    print(\\\"Number of comparisons in this family: 3\\\")\\n\",\"\\n\",\"    for group_a, group_b in pairs:\\n\",\"\\n\",\"        a = pivot[group_a].to_numpy()\\n\",\"        b = pivot[group_b].to_numpy()\\n\",\"\\n\",\"        differences = b - a\\n\",\"\\n\",\"        result = wilcoxon(\\n\",\"            a,\\n\",\"            b,\\n\",\"            alternative=\\\"two-sided\\\",\\n\",\"            zero_method=\\\"wilcox\\\",\\n\",\"            method=\\\"auto\\\"\\n\",\"        )\\n\",\"\\n\",\"        frozen = frozen_pairwise[\\n\",\"            (frozen_pairwise[\\\"metric\\\"] == metric)\\n\",\"            & (frozen_pairwise[\\\"group_a\\\"] == group_a)\\n\",\"            & (frozen_pairwise[\\\"group_b\\\"] == group_b)\\n\",\"        ]\\n\",\"\\n\",\"        if len(frozen) != 1:\\n\",\"            raise ValueError(\\n\",\"                f\\\"Unexpected frozen comparison: {metric}, {group_a}, {group_b}\\\"\\n\",\"            )\\n\",\"\\n\",\"        frozen = frozen.iloc[0]\\n\",\"\\n\",\"        statistic_match = np.isclose(\\n\",\"            result.statistic,\\n\",\"            frozen[\\\"wilcoxon_statistic\\\"]\\n\",\"        )\\n\",\"\\n\",\"        raw_p_match = np.isclose(\\n\",\"            result.pvalue,\\n\",\"            frozen[\\\"raw_p_value\\\"],\\n\",\"            rtol=1e-8,\\n\",\"            atol=1e-15\\n\",\"        )\\n\",\"\\n\",\"        pairwise_ok = pairwise_ok and statistic_match and raw_p_match\\n\",\"\\n\",\"        metric_results.append({\\n\",\"            \\\"group_a\\\": group_a,\\n\",\"            \\\"group_b\\\": group_b,\\n\",\"            \\\"statistic\\\": result.statistic,\\n\",\"            \\\"raw_p\\\": result.pvalue,\\n\",\"            \\\"mean_difference\\\": differences.mean(),\\n\",\"            \\\"positive\\\": int(np.sum(differences > 0)),\\n\",\"            \\\"negative\\\": int(np.sum(differences < 0)),\\n\",\"            \\\"zero\\\": int(np.sum(differences == 0)),\\n\",\"            \\\"frozen_holm\\\": float(frozen[\\\"holm_adjusted_p_value\\\"])\\n\",\"        })\\n\",\"\\n\",\"    # Important: correction is performed separately for this metric.\\n\",\"    adjusted_values = holm_adjust(\\n\",\"        [item[\\\"raw_p\\\"] for item in metric_results]\\n\",\"    )\\n\",\"\\n\",\"    for item, adjusted_p in zip(metric_results, adjusted_values):\\n\",\"\\n\",\"        holm_match = np.isclose(\\n\",\"            adjusted_p,\\n\",\"            item[\\\"frozen_holm\\\"],\\n\",\"            rtol=1e-8,\\n\",\"            atol=1e-15\\n\",\"        )\\n\",\"\\n\",\"        holm_ok = holm_ok and holm_match\\n\",\"\\n\",\"        print(\\n\",\"            f\\\"\\\\n{item['group_a']} vs {item['group_b']}\\\"\\n\",\"        )\\n\",\"        print(f\\\"Wilcoxon statistic: {item['statistic']:.12g}\\\")\\n\",\"        print(f\\\"Raw p-value: {item['raw_p']:.12g}\\\")\\n\",\"        print(f\\\"Recalculated Holm p: {adjusted_p:.12g}\\\")\\n\",\"        print(f\\\"Frozen Holm p: {item['frozen_holm']:.12g}\\\")\\n\",\"        print(\\n\",\"            f\\\"Paired differences: \\\"\\n\",\"            f\\\"+{item['positive']} / \\\"\\n\",\"            f\\\"-{item['negative']} / \\\"\\n\",\"            f\\\"0={item['zero']}\\\"\\n\",\"        )\\n\",\"        print(f\\\"Holm match: {holm_match}\\\")\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 4. Final reproduction status\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 100)\\n\",\"print(\\\"FINAL REPRODUCTION STATUS\\\")\\n\",\"print(\\\"=\\\" * 100)\\n\",\"\\n\",\"print(f\\\"Friedman tests reproduced: {friedman_ok}\\\")\\n\",\"print(f\\\"Wilcoxon tests reproduced: {pairwise_ok}\\\")\\n\",\"print(f\\\"Within-metric Holm correction reproduced: {holm_ok}\\\")\\n\",\"\\n\",\"if friedman_ok and pairwise_ok and holm_ok:\\n\",\"    print(\\\"\\\\nAUDIT STATUS: PASS — ORIGINAL FROZEN RESULTS REPRODUCED\\\")\\n\",\"else:\\n\",\"    print(\\\"\\\\nAUDIT STATUS: REVIEW REQUIRED — DISCREPANCIES REMAIN\\\")\\n\",\"\\n\",\"print(\\\"\\\\nIMPORTANT:\\\")\\n\",\"print(\\\"This reproduces the frozen correction families.\\\")\\n\",\"print(\\\"The manuscript must explicitly justify the correction-family definition.\\\")\\n\",\"print(\\\"No frozen files were modified.\\\")\\n\",\"print(\\\"=\\\" * 100)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"Y56cMpO3slXt\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794385345168,\"user_tz\":360,\"elapsed\":341,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"3ce57b4c-ef19-4b72-f02a-6b402b87d8d9\"},\"execution_count\":5,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"====================================================================================================\\n\",\"CORRECTED INDEPENDENT STATISTICAL REPRODUCTION\\n\",\"====================================================================================================\\n\",\"Identity-level validation: PASSED\\n\",\"Identities: 38\\n\",\"Repeated-measures groups: 3\\n\",\"\\n\",\"====================================================================================================\\n\",\"FRIEDMAN TESTS\\n\",\"====================================================================================================\\n\",\"\\n\",\"euclidean_mean\\n\",\"Statistic: recalculated=76 | frozen=76\\n\",\"P-value: recalculated=3.13913279205e-17 | frozen=3.13913279205e-17\\n\",\"Kendall's W: recalculated=1 | frozen=1\\n\",\"All checks passed: True\\n\",\"\\n\",\"cosine_mean\\n\",\"Statistic: recalculated=76 | frozen=76\\n\",\"P-value: recalculated=3.13913279205e-17 | frozen=3.13913279205e-17\\n\",\"Kendall's W: recalculated=1 | frozen=1\\n\",\"All checks passed: True\\n\",\"\\n\",\"====================================================================================================\\n\",\"PAIRED WILCOXON TESTS AND WITHIN-METRIC HOLM CORRECTION\\n\",\"====================================================================================================\\n\",\"\\n\",\"METRIC FAMILY: euclidean_mean\\n\",\"Number of comparisons in this family: 3\\n\",\"\\n\",\"near_frontal vs oblique\\n\",\"Wilcoxon statistic: 0\\n\",\"Raw p-value: 7.27595761418e-12\\n\",\"Recalculated Holm p: 2.18278728426e-11\\n\",\"Frozen Holm p: 2.18278728426e-11\\n\",\"Paired differences: +38 / -0 / 0=0\\n\",\"Holm match: True\\n\",\"\\n\",\"near_frontal vs large_angular_deviation\\n\",\"Wilcoxon statistic: 0\\n\",\"Raw p-value: 7.27595761418e-12\\n\",\"Recalculated Holm p: 2.18278728426e-11\\n\",\"Frozen Holm p: 2.18278728426e-11\\n\",\"Paired differences: +38 / -0 / 0=0\\n\",\"Holm match: True\\n\",\"\\n\",\"oblique vs large_angular_deviation\\n\",\"Wilcoxon statistic: 0\\n\",\"Raw p-value: 7.27595761418e-12\\n\",\"Recalculated Holm p: 2.18278728426e-11\\n\",\"Frozen Holm p: 2.18278728426e-11\\n\",\"Paired differences: +38 / -0 / 0=0\\n\",\"Holm match: True\\n\",\"\\n\",\"METRIC FAMILY: cosine_mean\\n\",\"Number of comparisons in this family: 3\\n\",\"\\n\",\"near_frontal vs oblique\\n\",\"Wilcoxon statistic: 0\\n\",\"Raw p-value: 7.27595761418e-12\\n\",\"Recalculated Holm p: 2.18278728426e-11\\n\",\"Frozen Holm p: 2.18278728426e-11\\n\",\"Paired differences: +38 / -0 / 0=0\\n\",\"Holm match: True\\n\",\"\\n\",\"near_frontal vs large_angular_deviation\\n\",\"Wilcoxon statistic: 0\\n\",\"Raw p-value: 7.27595761418e-12\\n\",\"Recalculated Holm p: 2.18278728426e-11\\n\",\"Frozen Holm p: 2.18278728426e-11\\n\",\"Paired differences: +38 / -0 / 0=0\\n\",\"Holm match: True\\n\",\"\\n\",\"oblique vs large_angular_deviation\\n\",\"Wilcoxon statistic: 0\\n\",\"Raw p-value: 7.27595761418e-12\\n\",\"Recalculated Holm p: 2.18278728426e-11\\n\",\"Frozen Holm p: 2.18278728426e-11\\n\",\"Paired differences: +38 / -0 / 0=0\\n\",\"Holm match: True\\n\",\"\\n\",\"====================================================================================================\\n\",\"FINAL REPRODUCTION STATUS\\n\",\"====================================================================================================\\n\",\"Friedman tests reproduced: True\\n\",\"Wilcoxon tests reproduced: True\\n\",\"Within-metric Holm correction reproduced: True\\n\",\"\\n\",\"AUDIT STATUS: PASS — ORIGINAL FROZEN RESULTS REPRODUCED\\n\",\"\\n\",\"IMPORTANT:\\n\",\"This reproduces the frozen correction families.\\n\",\"The manuscript must explicitly justify the correction-family definition.\\n\",\"No frozen files were modified.\\n\",\"====================================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.1.4: Original Embedding Metadata and Configuration Audit\\n\",\"\\n\",\"## Objective\\n\",\"Inspect the original JSON metadata, embedding-generation configuration, and preprocessing audits.\\n\",\"\\n\",\"## Evidence sources\\n\",\"1. experiment20_croppedyale_embedding_metadata.json\\n\",\"2. experiment20_embedding_generation_config.json\\n\",\"3. experiment20_facenet_preprocessing_compatibility_audit.json\\n\",\"4. experiment20_preprocessing_consistency_audit.json\\n\",\"5. experiment20_embedding_checkpoint_metadata.json\\n\",\"\\n\",\"## Verification\\n\",\"- Original embedding metadata.\\n\",\"- FaceNet model and checkpoint configuration.\\n\",\"- Image preprocessing operations.\\n\",\"- Input dimensions and tensor conversion.\\n\",\"- Model inference configuration.\\n\",\"- Consistency between metadata and the NPZ archive.\\n\",\"\\n\",\"## Restrictions\\n\",\"- Read-only inspection.\\n\",\"- Do not generate replacement metadata.\\n\",\"- Do not regenerate embeddings.\\n\",\"- Do not modify frozen artifacts.\"],\"metadata\":{\"id\":\"motkIZ8Ztb7C\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"import numpy as np\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"\\n\",\"FILES = {\\n\",\"    \\\"embedding_metadata\\\": BASE / \\\"embeddings/experiment20_croppedyale_embedding_metadata.json\\\",\\n\",\"    \\\"generation_config\\\": BASE / \\\"embeddings/experiment20_embedding_generation_config.json\\\",\\n\",\"    \\\"preprocessing_compatibility\\\": BASE / \\\"dataset_audit/experiment20_facenet_preprocessing_compatibility_audit.json\\\",\\n\",\"    \\\"preprocessing_consistency\\\": BASE / \\\"dataset_audit/experiment20_preprocessing_consistency_audit.json\\\",\\n\",\"    \\\"checkpoint_metadata\\\": BASE / \\\"embeddings/checkpoints/experiment20_embedding_checkpoint_metadata.json\\\"\\n\",\"}\\n\",\"\\n\",\"NPZ_FILE = (\\n\",\"    BASE / \\\"embeddings/experiment20_croppedyale_facenet_embeddings.npz\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"=\\\" * 100)\\n\",\"print(\\\"EXPERIMENT 20 — ORIGINAL METADATA AND CONFIGURATION AUDIT\\\")\\n\",\"print(\\\"=\\\" * 100)\\n\",\"\\n\",\"documents = {}\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 1. Load available JSON documents\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"for name, path in FILES.items():\\n\",\"\\n\",\"    print(\\\"\\\\n\\\" + \\\"-\\\" * 100)\\n\",\"    print(f\\\"DOCUMENT: {name}\\\")\\n\",\"    print(f\\\"PATH: {path}\\\")\\n\",\"\\n\",\"    if not path.exists():\\n\",\"        print(\\\"STATUS: NOT FOUND\\\")\\n\",\"        continue\\n\",\"\\n\",\"    with path.open(\\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"        data = json.load(f)\\n\",\"\\n\",\"    documents[name] = data\\n\",\"\\n\",\"    print(\\\"STATUS: LOADED\\\")\\n\",\"    print(json.dumps(data, indent=2, ensure_ascii=False, default=str)[:18000])\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 2. Inspect NPZ archive metadata\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 100)\\n\",\"print(\\\"NPZ ARCHIVE CONSISTENCY\\\")\\n\",\"print(\\\"=\\\" * 100)\\n\",\"\\n\",\"with np.load(NPZ_FILE, allow_pickle=False) as archive:\\n\",\"\\n\",\"    required_arrays = [\\n\",\"        \\\"embeddings\\\",\\n\",\"        \\\"filenames\\\",\\n\",\"        \\\"subjects\\\",\\n\",\"        \\\"subject_numbers\\\",\\n\",\"        \\\"azimuths\\\",\\n\",\"        \\\"elevations\\\",\\n\",\"        \\\"conditions\\\"\\n\",\"    ]\\n\",\"\\n\",\"    missing_arrays = [\\n\",\"        key for key in required_arrays\\n\",\"        if key not in archive.files\\n\",\"    ]\\n\",\"\\n\",\"    if missing_arrays:\\n\",\"        raise ValueError(f\\\"Missing NPZ arrays: {missing_arrays}\\\")\\n\",\"\\n\",\"    embeddings = archive[\\\"embeddings\\\"]\\n\",\"    filenames = archive[\\\"filenames\\\"]\\n\",\"    subjects = archive[\\\"subjects\\\"]\\n\",\"    conditions = archive[\\\"conditions\\\"]\\n\",\"    azimuths = archive[\\\"azimuths\\\"]\\n\",\"    elevations = archive[\\\"elevations\\\"]\\n\",\"\\n\",\"    print(f\\\"Embedding shape: {embeddings.shape}\\\")\\n\",\"    print(f\\\"Filename count: {len(filenames)}\\\")\\n\",\"    print(f\\\"Subject count: {len(subjects)}\\\")\\n\",\"    print(f\\\"Unique subjects: {len(np.unique(subjects))}\\\")\\n\",\"    print(f\\\"Condition count: {len(conditions)}\\\")\\n\",\"    print(f\\\"Unique conditions: {len(np.unique(conditions))}\\\")\\n\",\"\\n\",\"    aligned = all(\\n\",\"        len(array) == len(embeddings)\\n\",\"        for array in [\\n\",\"            filenames,\\n\",\"            subjects,\\n\",\"            conditions,\\n\",\"            azimuths,\\n\",\"            elevations\\n\",\"        ]\\n\",\"    )\\n\",\"\\n\",\"    print(f\\\"All metadata arrays align with embeddings: {aligned}\\\")\\n\",\"\\n\",\"    print(\\\"\\\\nFirst five records:\\\")\\n\",\"\\n\",\"    for i in range(5):\\n\",\"        print({\\n\",\"            \\\"filename\\\": str(filenames[i]),\\n\",\"            \\\"subject\\\": str(subjects[i]),\\n\",\"            \\\"condition\\\": str(conditions[i]),\\n\",\"            \\\"azimuth\\\": int(azimuths[i]),\\n\",\"            \\\"elevation\\\": int(elevations[i])\\n\",\"        })\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 3. Summarize available evidence\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 100)\\n\",\"print(\\\"EVIDENCE AVAILABILITY\\\")\\n\",\"print(\\\"=\\\" * 100)\\n\",\"\\n\",\"for name in FILES:\\n\",\"    print(\\n\",\"        f\\\"{name}: \\\"\\n\",\"        f\\\"{'AVAILABLE' if name in documents else 'UNAVAILABLE'}\\\"\\n\",\"    )\\n\",\"\\n\",\"print(\\\"\\\\nNo files were created, modified, or overwritten.\\\")\\n\",\"print(\\\"No embeddings were regenerated.\\\")\\n\",\"print(\\\"END OF STEP 3.1.4 METADATA AUDIT\\\")\\n\",\"print(\\\"=\\\" * 100)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"3syRQ87btgOr\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794385693080,\"user_tz\":360,\"elapsed\":1684,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"e58c25db-cbed-40b8-c9d3-c7a8f491c1cb\"},\"execution_count\":8,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"====================================================================================================\\n\",\"EXPERIMENT 20 — ORIGINAL METADATA AND CONFIGURATION AUDIT\\n\",\"====================================================================================================\\n\",\"\\n\",\"----------------------------------------------------------------------------------------------------\\n\",\"DOCUMENT: embedding_metadata\\n\",\"PATH: /content/drive/MyDrive/Experiment_20_Results/embeddings/experiment20_croppedyale_embedding_metadata.json\\n\",\"STATUS: LOADED\\n\",\"{\\n\",\"  \\\"experiment\\\": \\\"Experiment 20\\\",\\n\",\"  \\\"step\\\": \\\"2.6.19\\\",\\n\",\"  \\\"dataset\\\": \\\"Cropped Extended Yale B\\\",\\n\",\"  \\\"archive_sha256\\\": \\\"8bbabf3836d077d60626c9ee3c54c2d2851a8d2c15c8b7e13b9bc162e86ea573\\\",\\n\",\"  \\\"embedding_archive\\\": \\\"/content/drive/MyDrive/Experiment_20_Results/embeddings/experiment20_croppedyale_facenet_embeddings.