      "cell_type": "markdown",
      "source": [
        "# Experiment 20 — Step 3.1.3: Independent Statistical Reproduction (Corrected)\n",
        "\n",
        "## Objective\n",
        "Independently reproduce the frozen repeated-measures results, including the original Holm correction procedure.\n",
        "\n",
        "## Statistical tests\n",
        "- Friedman tests for both displacement metrics.\n",
        "- Kendall's W for each Friedman test.\n",
        "- Three paired Wilcoxon comparisons per metric.\n",
        "- Holm correction applied separately within each metric's three-comparison family.\n",
        "\n",
        "## Correction-family clarification\n",
        "The original frozen results use two separate correction families:\n",
        "1. Three Euclidean pairwise comparisons.\n",
        "2. Three cosine pairwise comparisons.\n",
        "\n",
        "A separate six-comparison correction would be more conservative but would not reproduce the original analysis.\n",
        "\n",
        "## Validation\n",
        "Recalculated statistics, raw p-values, Kendall's W, and Holm-adjusted p-values will be compared with the frozen result tables.\n",
        "\n",
        "## Restrictions\n",
        "- Identity remains the inferential unit (n = 38).\n",
        "- Frozen source files will not be modified.\n",
        "- This step reproduces the original analysis; it does not resolve the protocol's undocumented correction-family choice."
      ],
      "metadata": {
        "id": "kYzcGwRysjer"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from pathlib import Path\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "from scipy.stats import friedmanchisquare, wilcoxon\n",
        "\n",
        "ROOT = Path(\n",
        "    \"/content/drive/MyDrive/Experiment_20_Results/step_2_7/final_freeze\"\n",
        ")\n",
        "\n",
        "identity_df = pd.read_csv(\n",
        "    ROOT / \"experiment20_identity_level_group_means.csv\"\n",
        ")\n",
        "\n",
        "frozen_friedman = pd.read_csv(\n",
        "    ROOT / \"experiment20_repeated_measures_test_results.csv\"\n",
        ")\n",
        "\n",
        "frozen_pairwise = pd.read_csv(\n",
        "    ROOT / \"experiment20_paired_comparison_results.csv\"\n",
        ")\n",
        "\n",
        "groups = [\n",
        "    \"near_frontal\",\n",
        "    \"oblique\",\n",
        "    \"large_angular_deviation\"\n",
        "]\n",
        "\n",
        "metrics = [\"euclidean_mean\", \"cosine_mean\"]\n",
        "\n",
        "pairs = [\n",
        "    (\"near_frontal\", \"oblique\"),\n",
        "    (\"near_frontal\", \"large_angular_deviation\"),\n",
        "    (\"oblique\", \"large_angular_deviation\")\n",
        "]\n",
        "\n",
        "print(\"=\" * 100)\n",
        "print(\"CORRECTED INDEPENDENT STATISTICAL REPRODUCTION\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 1. Validate identity-level data\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "if len(identity_df) != 114:\n",
        "    raise ValueError(\"Expected 114 identity-group records.\")\n",
        "\n",
        "if identity_df[\"subject\"].nunique() != 38:\n",
        "    raise ValueError(\"Expected 38 unique identities.\")\n",
        "\n",
        "if identity_df.duplicated([\"subject\", \"illumination_group\"]).any():\n",
        "    raise ValueError(\"Duplicate identity-group records found.\")\n",
        "\n",
        "wide = {}\n",
        "\n",
        "for metric in metrics:\n",
        "    pivot = identity_df.pivot(\n",
        "        index=\"subject\",\n",
        "        columns=\"illumination_group\",\n",
        "        values=metric\n",
        "    )[groups].sort_index()\n",
        "\n",
        "    if pivot.isna().any().any():\n",
        "        raise ValueError(f\"Missing values in {metric}.\")\n",
        "\n",
        "    if not np.isfinite(pivot.to_numpy()).all():\n",
        "        raise ValueError(f\"Non-finite values in {metric}.\")\n",
        "\n",
        "    wide[metric] = pivot\n",
        "\n",
        "print(\"Identity-level validation: PASSED\")\n",
        "print(\"Identities: 38\")\n",
        "print(\"Repeated-measures groups: 3\")\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 2. Friedman tests and Kendall's W\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "friedman_ok = True\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"FRIEDMAN TESTS\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "for metric, pivot in wide.items():\n",
        "\n",
        "    result = friedmanchisquare(\n",
        "        *[pivot[group].to_numpy() for group in groups]\n",
        "    )\n",
        "\n",
        "    kendalls_w = result.statistic / (len(pivot) * (len(groups) - 1))\n",
        "\n",
        "    frozen = frozen_friedman[\n",
        "        frozen_friedman[\"metric\"] == metric\n",
        "    ]\n",
        "\n",
        "    if len(frozen) != 1:\n",
        "        raise ValueError(f\"Unexpected frozen Friedman rows for {metric}.\")\n",
        "\n",
        "    frozen = frozen.iloc[0]\n",
        "\n",
        "    checks = [\n",
        "        np.isclose(result.statistic, frozen[\"test_statistic\"]),\n",
        "        np.isclose(result.pvalue, frozen[\"p_value\"], rtol=1e-8, atol=1e-15),\n",
        "        np.isclose(kendalls_w, frozen[\"kendalls_w\"])\n",
        "    ]\n",
        "\n",
        "    friedman_ok = friedman_ok and all(checks)\n",
        "\n",
        "    print(f\"\\n{metric}\")\n",
        "    print(f\"Statistic: recalculated={result.statistic:.12g} | frozen={frozen['test_statistic']:.12g}\")\n",
        "    print(f\"P-value: recalculated={result.pvalue:.12g} | frozen={frozen['p_value']:.12g}\")\n",
        "    print(f\"Kendall's W: recalculated={kendalls_w:.12g} | frozen={frozen['kendalls_w']:.12g}\")\n",
        "    print(f\"All checks passed: {all(checks)}\")\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 3. Holm correction within each metric\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "def holm_adjust(p_values):\n",
        "    p_values = np.asarray(p_values, dtype=float)\n",
        "    m = len(p_values)\n",
        "\n",
        "    order = np.argsort(p_values)\n",
        "    sorted_p = p_values[order]\n",
        "\n",
        "    adjusted_sorted = np.maximum.accumulate(\n",
        "        (m - np.arange(m)) * sorted_p\n",
        "    )\n",
        "\n",
        "    adjusted_sorted = np.minimum(adjusted_sorted, 1.0)\n",
        "\n",
        "    adjusted = np.empty(m)\n",
        "    adjusted[order] = adjusted_sorted\n",
        "\n",
        "    return adjusted\n",
        "\n",
        "pairwise_ok = True\n",
        "holm_ok = True\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"PAIRED WILCOXON TESTS AND WITHIN-METRIC HOLM CORRECTION\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "for metric, pivot in wide.items():\n",
        "\n",
        "    metric_results = []\n",
        "\n",
        "    print(f\"\\nMETRIC FAMILY: {metric}\")\n",
        "    print(\"Number of comparisons in this family: 3\")\n",
        "\n",
        "    for group_a, group_b in pairs:\n",
        "\n",
        "        a = pivot[group_a].to_numpy()\n",
        "        b = pivot[group_b].to_numpy()\n",
        "\n",
        "        differences = b - a\n",
        "\n",
        "        result = wilcoxon(\n",
        "            a,\n",
        "            b,\n",
        "            alternative=\"two-sided\",\n",
        "            zero_method=\"wilcox\",\n",
        "            method=\"auto\"\n",
        "        )\n",
        "\n",
        "        frozen = frozen_pairwise[\n",
        "            (frozen_pairwise[\"metric\"] == metric)\n",
        "            & (frozen_pairwise[\"group_a\"] == group_a)\n",
        "            & (frozen_pairwise[\"group_b\"] == group_b)\n",
        "        ]\n",
        "\n",
        "        if len(frozen) != 1:\n",
        "            raise ValueError(\n",
        "                f\"Unexpected frozen comparison: {metric}, {group_a}, {group_b}\"\n",
        "            )\n",
        "\n",
        "        frozen = frozen.iloc[0]\n",
        "\n",
        "        statistic_match = np.isclose(\n",
        "            result.statistic,\n",
        "            frozen[\"wilcoxon_statistic\"]\n",
        "        )\n",
        "\n",
        "        raw_p_match = np.isclose(\n",
        "            result.pvalue,\n",
        "            frozen[\"raw_p_value\"],\n",
        "            rtol=1e-8,\n",
        "            atol=1e-15\n",
        "        )\n",
        "\n",
        "        pairwise_ok = pairwise_ok and statistic_match and raw_p_match\n",
        "\n",
        "        metric_results.append({\n",
        "            \"group_a\": group_a,\n",
        "            \"group_b\": group_b,\n",
        "            \"statistic\": result.statistic,\n",
        "            \"raw_p\": result.pvalue,\n",
        "            \"mean_difference\": differences.mean(),\n",
        "            \"positive\": int(np.sum(differences > 0)),\n",
        "            \"negative\": int(np.sum(differences < 0)),\n",
        "            \"zero\": int(np.sum(differences == 0)),\n",
        "            \"frozen_holm\": float(frozen[\"holm_adjusted_p_value\"])\n",
        "        })\n",
        "\n",
        "    # Important: correction is performed separately for this metric.\n",
        "    adjusted_values = holm_adjust(\n",
        "        [item[\"raw_p\"] for item in metric_results]\n",
        "    )\n",
        "\n",
        "    for item, adjusted_p in zip(metric_results, adjusted_values):\n",
        "\n",
        "        holm_match = np.isclose(\n",
        "            adjusted_p,\n",
        "            item[\"frozen_holm\"],\n",
        "            rtol=1e-8,\n",
        "            atol=1e-15\n",
        "        )\n",
        "\n",
        "        holm_ok = holm_ok and holm_match\n",
        "\n",
        "        print(\n",
        "            f\"\\n{item['group_a']} vs {item['group_b']}\"\n",
        "        )\n",
        "        print(f\"Wilcoxon statistic: {item['statistic']:.12g}\")\n",
        "        print(f\"Raw p-value: {item['raw_p']:.12g}\")\n",
        "        print(f\"Recalculated Holm p: {adjusted_p:.12g}\")\n",
        "        print(f\"Frozen Holm p: {item['frozen_holm']:.12g}\")\n",
        "        print(\n",
        "            f\"Paired differences: \"\n",
        "            f\"+{item['positive']} / \"\n",
        "            f\"-{item['negative']} / \"\n",
        "            f\"0={item['zero']}\"\n",
        "        )\n",
        "        print(f\"Holm match: {holm_match}\")\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 4. Final reproduction status\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"FINAL REPRODUCTION STATUS\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "print(f\"Friedman tests reproduced: {friedman_ok}\")\n",
