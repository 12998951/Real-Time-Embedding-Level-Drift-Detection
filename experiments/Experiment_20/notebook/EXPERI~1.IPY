3.org/2000/svg\\\" height=\\\"24px\\\" viewBox=\\\"0 -960 960 960\\\">\\n\",\"    <path d=\\\"M120-120v-720h720v720H120Zm60-500h600v-160H180v160Zm220 220h160v-160H400v160Zm0 220h160v-160H400v160ZM180-400h160v-160H180v160Zm440 0h160v-160H620v160ZM180-180h160v-160H180v160Zm440 0h160v-160H620v160Z\\\"/>\\n\",\"  </svg>\\n\",\"    </button>\\n\",\"\\n\",\"  <style>\\n\",\"    .colab-df-container {\\n\",\"      display:flex;\\n\",\"      gap: 12px;\\n\",\"    }\\n\",\"\\n\",\"    .colab-df-convert {\\n\",\"      background-color: #E8F0FE;\\n\",\"      border: none;\\n\",\"      border-radius: 50%;\\n\",\"      cursor: pointer;\\n\",\"      display: none;\\n\",\"      fill: #1967D2;\\n\",\"      height: 32px;\\n\",\"      padding: 0 0 0 0;\\n\",\"      width: 32px;\\n\",\"    }\\n\",\"\\n\",\"    .colab-df-convert:hover {\\n\",\"      background-color: #E2EBFA;\\n\",\"      box-shadow: 0px 1px 2px rgba(60, 64, 67, 0.3), 0px 1px 3px 1px rgba(60, 64, 67, 0.15);\\n\",\"      fill: #174EA6;\\n\",\"    }\\n\",\"\\n\",\"    .colab-df-buttons div {\\n\",\"      margin-bottom: 4px;\\n\",\"    }\\n\",\"\\n\",\"    [theme=dark] .colab-df-convert {\\n\",\"      background-color: #3B4455;\\n\",\"      fill: #D2E3FC;\\n\",\"    }\\n\",\"\\n\",\"    [theme=dark] .colab-df-convert:hover {\\n\",\"      background-color: #434B5C;\\n\",\"      box-shadow: 0px 1px 3px 1px rgba(0, 0, 0, 0.15);\\n\",\"      filter: drop-shadow(0px 1px 2px rgba(0, 0, 0, 0.3));\\n\",\"      fill: #FFFFFF;\\n\",\"    }\\n\",\"  </style>\\n\",\"\\n\",\"    <script>\\n\",\"      const buttonEl =\\n\",\"        document.querySelector('#df-2f88ed64-aff0-4510-a499-c562edf8dae5 button.colab-df-convert');\\n\",\"      buttonEl.style.display =\\n\",\"        google.colab.kernel.accessAllowed ? 'block' : 'none';\\n\",\"\\n\",\"      async function convertToInteractive(key) {\\n\",\"        const element = document.querySelector('#df-2f88ed64-aff0-4510-a499-c562edf8dae5');\\n\",\"        const dataTable =\\n\",\"          await google.colab.kernel.invokeFunction('convertToInteractive',\\n\",\"                                                    [key], {});\\n\",\"        if (!dataTable) return;\\n\",\"\\n\",\"        const docLinkHtml = 'Like what you see? Visit the ' +\\n\",\"          '<a target=\\\"_blank\\\" href=https://colab.research.google.com/notebooks/data_table.ipynb>data table notebook</a>'\\n\",\"          + ' to learn more about interactive tables.';\\n\",\"        element.innerHTML = '';\\n\",\"        dataTable['output_type'] = 'display_data';\\n\",\"        await google.colab.output.renderOutput(dataTable, element);\\n\",\"        const docLink = document.createElement('div');\\n\",\"        docLink.innerHTML = docLinkHtml;\\n\",\"        element.appendChild(docLink);\\n\",\"      }\\n\",\"    </script>\\n\",\"  </div>\\n\",\"\\n\",\"\\n\",\"  <div id=\\\"id_2575be15-8653-4d3e-b42e-b4ec013831d2\\\">\\n\",\"    <style>\\n\",\"      .colab-df-generate {\\n\",\"        background-color: #E8F0FE;\\n\",\"        border: none;\\n\",\"        border-radius: 50%;\\n\",\"        cursor: pointer;\\n\",\"        display: none;\\n\",\"        fill: #1967D2;\\n\",\"        height: 32px;\\n\",\"        padding: 0 0 0 0;\\n\",\"        width: 32px;\\n\",\"      }\\n\",\"\\n\",\"      .colab-df-generate:hover {\\n\",\"        background-color: #E2EBFA;\\n\",\"        box-shadow: 0px 1px 2px rgba(60, 64, 67, 0.3), 0px 1px 3px 1px rgba(60, 64, 67, 0.15);\\n\",\"        fill: #174EA6;\\n\",\"      }\\n\",\"\\n\",\"      [theme=dark] .colab-df-generate {\\n\",\"        background-color: #3B4455;\\n\",\"        fill: #D2E3FC;\\n\",\"      }\\n\",\"\\n\",\"      [theme=dark] .colab-df-generate:hover {\\n\",\"        background-color: #434B5C;\\n\",\"        box-shadow: 0px 1px 3px 1px rgba(0, 0, 0, 0.15);\\n\",\"        filter: drop-shadow(0px 1px 2px rgba(0, 0, 0, 0.3));\\n\",\"        fill: #FFFFFF;\\n\",\"      }\\n\",\"    </style>\\n\",\"    <button class=\\\"colab-df-generate\\\" onclick=\\\"generateWithVariable('identity_counts')\\\"\\n\",\"            title=\\\"Generate code using this dataframe.\\\"\\n\",\"            style=\\\"display:none;\\\">\\n\",\"\\n\",\"  <svg xmlns=\\\"http://www.w3.org/2000/svg\\\" height=\\\"24px\\\"viewBox=\\\"0 0 24 24\\\"\\n\",\"       width=\\\"24px\\\">\\n\",\"    <path d=\\\"M7,19H8.4L18.45,9,17,7.55,7,17.6ZM5,21V16.75L18.45,3.32a2,2,0,0,1,2.83,0l1.4,1.43a1.91,1.91,0,0,1,.58,1.4,1.91,1.91,0,0,1-.58,1.4L9.25,21ZM18.45,9,17,7.55Zm-12,3A5.31,5.31,0,0,0,4.9,8.1,5.31,5.31,0,0,0,1,6.5,5.31,5.31,0,0,0,4.9,4.9,5.31,5.31,0,0,0,6.5,1,5.31,5.31,0,0,0,8.1,4.9,5.31,5.31,0,0,0,12,6.5,5.46,5.46,0,0,0,6.5,12Z\\\"/>\\n\",\"  </svg>\\n\",\"    </button>\\n\",\"    <script>\\n\",\"      (() => {\\n\",\"      const buttonEl =\\n\",\"        document.querySelector('#id_2575be15-8653-4d3e-b42e-b4ec013831d2 button.colab-df-generate');\\n\",\"      buttonEl.style.display =\\n\",\"        google.colab.kernel.accessAllowed ? 'block' : 'none';\\n\",\"\\n\",\"      buttonEl.onclick = () => {\\n\",\"        google.colab.notebook.generateWithVariable('identity_counts');\\n\",\"      }\\n\",\"      })();\\n\",\"    </script>\\n\",\"  </div>\\n\",\"\\n\",\"    </div>\\n\",\"  </div>\\n\"],\"application/vnd.google.colaboratory.intrinsic+json\":{\"type\":\"dataframe\",\"variable_name\":\"identity_counts\",\"summary\":\"{\\n  \\\"name\\\": \\\"identity_counts\\\",\\n  \\\"rows\\\": 13,\\n  \\\"fields\\\": [\\n    {\\n      \\\"column\\\": \\\"Identity\\\",\\n      \\\"properties\\\": {\\n        \\\"dtype\\\": \\\"number\\\",\\n        \\\"std\\\": 20,\\n        \\\"min\\\": 1,\\n        \\\"max\\\": 60,\\n        \\\"num_unique_values\\\": 13,\\n        \\\"samples\\\": [\\n          49,\\n          45,\\n          1\\n        ],\\n        \\\"semantic_type\\\": \\\"\\\",\\n        \\\"description\\\": \\\"\\\"\\n      }\\n    },\\n    {\\n      \\\"column\\\": \\\"Image_Count\\\",\\n      \\\"properties\\\": {\\n        \\\"dtype\\\": \\\"number\\\",\\n        \\\"std\\\": 133,\\n        \\\"min\\\": 18,\\n        \\\"max\\\": 504,\\n        \\\"num_unique_values\\\": 10,\\n        \\\"samples\\\": [\\n          29,\\n          21,\\n          22\\n        ],\\n        \\\"semantic_type\\\": \\\"\\\",\\n        \\\"description\\\": \\\"\\\"\\n      }\\n    }\\n  ]\\n}\"}},\"metadata\":{}},{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"Unique identities: 13\\n\",\"Total paired observations: 889\\n\",\"Largest identity share (%): 56.69\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 2.3 — FINAL AUDIT SUMMARY\\n\",\"===========================================================================\\n\",\"Embedding dimensions: PASSED\\n\",\"Finite embedding values: PASSED\\n\",\"Label and position dimensions: PASSED\\n\",\"Common-position reconstruction: PASSED\\n\",\"Extraction-position accounting: PASSED\\n\",\"Low displacement reproducibility: PASSED\\n\",\"High displacement reproducibility: PASSED\\n\",\"Identity coverage: PASSED\\n\",\"\\n\",\"ALL STEP 2.3 VALIDATION CHECKS PASSED\\n\",\"Source archive was not modified.\\n\",\"===========================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"\\n\",\"## Experiment 20 — Step 2.4\\n\",\"### Pairing and Selection-Bias Assessment\\n\",\"\\n\",\"**Objective**\\n\",\"\\n\",\"Quantify the observations excluded from the paired illumination cohort because embedding extraction failed under either the low- or high-illumination condition.\\n\",\"\\n\",\"**Audit requirements**\\n\",\"\\n\",\"1. Calculate low-illumination and high-illumination extraction failure rates.\\n\",\"2. Identify failures shared by both conditions.\\n\",\"3. Separate low-only and high-only failures.\\n\",\"4. Calculate the union of failed positions.\\n\",\"5. Calculate paired-cohort retention and attrition.\\n\",\"6. Verify that the paired cohort contains only positions successful under both conditions.\\n\",\"7. Assess whether identity-specific exclusion rates can be calculated from the available archive.\\n\",\"\\n\",\"**Denominator**\\n\",\"\\n\",\"The audit uses the 956 original evaluation positions that were successfully embedded before illumination transformations.\\n\",\"\\n\",\"**Scientific limitation**\\n\",\"\\n\",\"The saved paired archive contains identity labels only for the 889 retained observations. It does not contain identity labels for all 956 original evaluation positions. Therefore, identity-specific failure rates cannot be calculated from this archive alone.\\n\"],\"metadata\":{\"id\":\"wVC-DENdZ0wj\"}},{\"cell_type\":\"code\",\"source\":[\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 20 — STEP 2.4\\n\",\"# PAIRING AND SELECTION-BIAS ASSESSMENT\\n\",\"# ============================================================\\n\",\"\\n\",\"from pathlib import Path\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Load extraction records\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"archive_path = Path(\\n\",\"    \\\"/content/drive/MyDrive/Experiment_18_Results/\\\"\\n\",\"    \\\"experiment18_illumination_results.npz\\\"\\n\",\")\\n\",\"\\n\",\"assert archive_path.exists(), \\\"Experiment 18 archive not found.\\\"\\n\",\"\\n\",\"with np.load(archive_path, allow_pickle=False) as data:\\n\",\"\\n\",\"    common_positions = data[\\\"common_positions\\\"].copy()\\n\",\"    low_success = data[\\\"low_success\\\"].copy()\\n\",\"    high_success = data[\\\"high_success\\\"].copy()\\n\",\"    low_failures = data[\\\"low_failures\\\"].copy()\\n\",\"    high_failures = data[\\\"high_failures\\\"].copy()\\n\",\"    paired_labels = data[\\\"paired_labels\\\"].copy()\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 2.4\\\")\\n\",\"print(\\\"PAIRING AND SELECTION-BIAS ASSESSMENT\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Define the evaluation-position universe\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"evaluation_positions = set(range(956))\\n\",\"\\n\",\"low_success_set = set(low_success.tolist())\\n\",\"high_success_set = set(high_success.tolist())\\n\",\"\\n\",\"low_failure_set = set(low_failures.tolist())\\n\",\"high_failure_set = set(high_failures.tolist())\\n\",\"\\n\",\"common_position_set = set(common_positions.tolist())\\n\",\"\\n\",\"assert low_success_set.isdisjoint(low_failure_set)\\n\",\"assert high_success_set.isdisjoint(high_failure_set)\\n\",\"\\n\",\"assert low_success_set | low_failure_set == evaluation_positions\\n\",\"assert high_success_set | high_failure_set == evaluation_positions\\n\",\"\\n\",\"print(\\\"\\\\n[1] EVALUATION COHORT\\\")\\n\",\"\\n\",\"print(\\\"Original successful evaluation positions:\\\", len(evaluation_positions))\\n\",\"print(\\\"Low-illumination successes:\\\", len(low_success_set))\\n\",\"print(\\\"High-illumination successes:\\\", len(high_success_set))\\n\",\"print(\\\"Paired observations:\\\", len(common_position_set))\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Condition-specific extraction failure rates\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[2] CONDITION-SPECIFIC FAILURE RATES\\\")\\n\",\"\\n\",\"low_failure_rate = len(low_failure_set) / len(evaluation_positions) * 100\\n\",\"high_failure_rate = len(high_failure_set) / len(evaluation_positions) * 100\\n\",\"\\n\",\"condition_summary = pd.DataFrame([\\n\",\"    {\\n\",\"        \\\"Condition\\\": \\\"Low illumination\\\",\\n\",\"        \\\"Successful\\\": len(low_success_set),\\n\",\"        \\\"Failed\\\": len(low_failure_set),\\n\",\"        \\\"Failure_Rate_Percent\\\": low_failure_rate\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Condition\\\": \\\"High illumination\\\",\\n\",\"        \\\"Successful\\\": len(high_success_set),\\n\",\"        \\\"Failed\\\": len(high_failure_set),\\n\",\"        \\\"Failure_Rate_Percent\\\": high_failure_rate\\n\",\"    }\\n\",\"])\\n\",\"\\n\",\"display(condition_summary)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Analyse failure overlap\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[3] FAILURE OVERLAP\\\")\\n\",\"\\n\",\"shared_failures = low_failure_set & high_failure_set\\n\",\"low_only_failures = low_failure_set - high_failure_set\\n\",\"high_only_failures = high_failure_set - low_failure_set\\n\",\"\\n\",\"all_excluded_positions = low_failure_set | high_failure_set\\n\",\"\\n\",\"print(\\\"Low-only failures:\\\", len(low_only_failures))\\n\",\"print(\\\"High-only failures:\\\", len(high_only_failures))\\n\",\"print(\\\"Failures shared by both conditions:\\\", len(shared_failures))\\n\",\"print(\\\"Total unique excluded positions:\\\", len(all_excluded_positions))\\n\",\"\\n\",\"assert (\\n\",\"    len(low_only_failures)\\n\",\"    + len(high_only_failures)\\n\",\"    + len(shared_failures)\\n\",\"    == len(all_excluded_positions)\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Calculate paired-cohort retention and attrition\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[4] PAIRED-COHORT RETENTION\\\")\\n\",\"\\n\",\"paired_count = len(common_position_set)\\n\",\"excluded_count = len(all_excluded_positions)\\n\",\"\\n\",\"retention_rate = paired_count / len(evaluation_positions) * 100\\n\",\"attrition_rate = excluded_count / len(evaluation_positions) * 100\\n\",\"\\n\",\"print(\\\"Original evaluation positions:\\\", len(evaluation_positions))\\n\",\"print(\\\"Retained paired observations:\\\", paired_count)\\n\",\"print(\\\"Excluded observations:\\\", excluded_count)\\n\",\"print(\\\"Retention rate (%):\\\", round(retention_rate, 4))\\n\",\"print(\\\"Attrition rate (%):\\\", round(attrition_rate, 4))\\n\",\"\\n\",\"assert common_position_set == (\\n\",\"    low_success_set & high_success_set\\n\",\")\\n\",\"\\n\",\"assert common_position_set.isdisjoint(all_excluded_positions)\\n\",\"\\n\",\"assert paired_count + excluded_count == len(evaluation_positions)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. Confirm condition-specific cohort composition\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[5] COHORT COMPOSITION\\\")\\n\",\"\\n\",\"cohort_summary = pd.DataFrame([\\n\",\"    {\\n\",\"        \\\"Cohort\\\": \\\"Successful under both conditions\\\",\\n\",\"        \\\"Count\\\": len(low_success_set & high_success_set)\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Cohort\\\": \\\"Failed under low only\\\",\\n\",\"        \\\"Count\\\": len(low_only_failures)\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Cohort\\\": \\\"Failed under high only\\\",\\n\",\"        \\\"Count\\\": len(high_only_failures)\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Cohort\\\": \\\"Failed under both conditions\\\",\\n\",\"        \\\"Count\\\": len(shared_failures)\\n\",\"    }\\n\",\"])\\n\",\"\\n\",\"display(cohort_summary)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. Assess identity-level selection-bias auditability\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[6] IDENTITY-LEVEL AUDITABILITY\\\")\\n\",\"\\n\",\"print(\\\"Identity labels available for paired observations:\\\",\\n\",\"      len(paired_labels))\\n\",\"\\n\",\"print(\\\"Identity labels available for all original positions:\\\",\\n\",\"      \\\"No\\\")\\n\",\"\\n\",\"print(\\\"Can identity-specific failure rates be calculated:\\\",\\n\",\"      \\\"No — excluded-position identity labels are unavailable.\\\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"Unique identities represented in paired cohort:\\\",\\n\",\"    len(np.unique(paired_labels))\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 8. Final audit summary\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"audit = {\\n\",\"    \\\"Low success/failure partition\\\": (\\n\",\"        low_success_set | low_failure_set == evaluation_positions\\n\",\"    ),\\n\",\"    \\\"High success/failure partition\\\": (\\n\",\"        high_success_set | high_failure_set == evaluation_positions\\n\",\"    ),\\n\",\"    \\\"Common positions equal paired cohort\\\": (\\n\",\"        common_position_set == low_success_set & high_success_set\\n\",\"    ),\\n\",\"    \\\"Paired and excluded positions are disjoint\\\": (\\n\",\"        common_position_set.isdisjoint(all_excluded_positions)\\n\",\"    ),\\n\",\"    \\\"Paired plus excluded equals original cohort\\\": (\\n\",\"        paired_count + excluded_count == len(evaluation_positions)\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 2.4 — FINAL AUDIT SUMMARY\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"for check, passed in audit.items():\\n\",\"    print(f\\\"{check}: {'PASSED' if passed else 'FAILED'}\\\")\\n\",\"\\n\",\"assert all(audit.values()), \\\"One or more selection-bias checks failed.\\\"\\n\",\"\\n\",\"print(\\\"\\\\nALL STEP 2.4 COMPUTATIONAL CHECKS PASSED\\\")\\n\",\"print(\\\"No source archive was modified.\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\",\"height\":1000},\"id\":\"xoSGm4f5Z3mW\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794346811993,\"user_tz\":360,\"elapsed\":137,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"f8d888bc-c447-476d-f0f6-363768dbc7b1\"},\"execution_count\":null,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"===========================================================================\\n\",\"EXPERIMENT 20 — STEP 2.4\\n\",\"PAIRING AND SELECTION-BIAS ASSESSMENT\\n\",\"===========================================================================\\n\",\"\\n\",\"[1] EVALUATION COHORT\\n\",\"Original successful evaluation positions: 956\\n\",\"Low-illumination successes: 943\\n\",\"High-illumination successes: 897\\n\",\"Paired observations: 889\\n\",\"\\n\",\"[2] CONDITION-SPECIFIC FAILURE RATES\\n\"]},{\"output_type\":\"display_data\",\"data\":{\"text/plain\":[\"           Condition  Successful  Failed  Failure_Rate_Percent\\n\",\"0   Low illumination         943      13              1.359833\\n\",\"1  High illumination         897      59              6.171548\"],\"text/html\":[\"\\n\",\"  <div id=\\\"df-6bef6477-a129-40b9-8f03-7ab16ac10926\\\" class=\\\"colab-df-container\\\">\\n\",\"    <div>\\n\",\"<style scoped>\\n\",\"    .dataframe tbody tr th:only-of-type {\\n\",\"        vertical-align: middle;\\n\",\"    }\\n\",\"\\n\",\"    .dataframe tbody tr th {\\n\",\"        vertical-align: top;\\n\",\"    }\\n\",\"\\n\",\"    .dataframe thead th {\\n\",\"        text-align: right;\\n\",\"    }\\n\",\"</style>\\n\",\"<table border=\\\"1\\\" class=\\\"dataframe\\\">\\n\",\"  <thead>\\n\",\"    <tr style=\\\"text-align: right;\\\">\\n\",\"      <th></th>\\n\",\"      <th>Condition</th>\\n\",\"      <th>Successful</th>\\n\",\"      <th>Failed</th>\\n\",\"      <th>Failure_Rate_Percent</th>\\n\",\"    </tr>\\n\",\"  </thead>\\n\",\"  <tbody>\\n\",\"    <tr>\\n\",\"      <th>0</th>\\n\",\"      <td>Low illumination</td>\\n\",\"      <td>943</td>\\n\",\"      <td>13</td>\\n\",\"      <td>1.359833</td>\\n\",\"    </tr>\\n\",\"    <tr>\\n\",\"      <th>1</th>\\n\",\"      <td>High illumination</td>\\n\",\"      <td>897</td>\\n\",\"      <td>59</td>\\n\",\"      <td>6.171548</td>\\n\",\"    </tr>\\n\",\"  </tbody>\\n\",\"</table>\\n\",\"</div>\\n\",\"    <div class=\\\"colab-df-buttons\\\">\\n\",\"\\n\",\"  <div class=\\\"colab-df-container\\\">\\n\",\"    <button class=\\\"colab-df-convert\\\" onclick=\\\"convertToInteractive('df-6bef6477-a129-40b9-8f03-7ab16ac10926')\\\"\\n\",\"            title=\\\"Convert this dataframe to an interactive table.\\\"\\n\",\"            style=\\\"display:none;\\\">\\n\",\"\\n\",\"  <svg xmlns=\\\"http://www.w3.org/2000/svg\\\" height=\\\"24px\\\" viewBox=\\\"0 -960 960 960\\\">\\n\",\"    <path d=\\\"M120-120v-720h720v720H120Zm60-500h600v-160H180v160Zm220 220h160v-160H400v160Zm0 220h160v-160H400v160ZM180-400h160v-160H180v160Zm440 0h160v-160H620v160ZM180-180h160v-160H180v160Zm440 0h160v-160H620v160Z\\\"/>\\n\",\"  </svg>\\n\",\"    </button>\\n\",\"\\n\",\"  <style>\\n\",\"    .colab-df-container {\\n\",\"      display:flex;\\n\",\"      gap: 12px;\\n\",\"    }\\n\",\"\\n\",\"    .colab-df-convert {\\n\",\"      background-color: #E8F0FE;\\n\",\"      border: none;\\n\",\"      border-radius: 50%;\\n\",\"      cursor: pointer;\\n\",\"      display: none;\\n\",\"      fill: #1967D2;\\n\",\"      height: 32px;\\n\",\"      padding: 0 0 0 0;\\n\",\"      width: 32px;\\n\",\"    }\\n\",\"\\n\",\"    .colab-df-convert:hover {\\n\",\"      background-color: #E2EBFA;\\n\",\"      box-shadow: 0px 1px 2px rgba(60, 64, 67, 0.3), 0px 1px 3px 1px rgba(60, 64, 67, 0.15);\\n\",\"      fill: #174EA6;\\n\",\"    }\\n\",\"\\n\",\"    .colab-df-buttons div {\\n\",\"      margin-bottom: 4px;\\n\",\"    }\\n\",\"\\n\",\"    [theme=dark] .colab-df-convert {\\n\",\"      background-color: #3B4455;\\n\",\"      fill: #D2E3FC;\\n\",\"    }\\n\",\"\\n\",\"    [theme=dark] .colab-df-convert:hover {\\n\",\"      background-color: #434B5C;\\n\",\"      box-shadow: 0px 1px 3px 1px rgba(0, 0, 0, 0.15);\\n\",\"      filter: drop-shadow(0px 1px 2px rgba(0, 0, 0, 0.3));\\n\",\"      fill: #FFFFFF;\\n\",\"    }\\n\",\"  </style>\\n\",\"\\n\",\"    <script>\\n\",\"      const buttonEl =\\n\",\"        document.querySelector('#df-6bef6477-a129-40b9-8f03-7ab16ac10926 button.colab-df-convert');\\n\",\"      buttonEl.style.display =\\n\",\"        google.colab.kernel.accessAllowed ? 'block' : 'none';\\n\",\"\\n\",\"      async function convertToInteractive(key) {\\n\",\"        const element = document.querySelector('#df-6bef6477-a129-40b9-8f03-7ab16ac10926');\\n\",\"        const dataTable =\\n\",\"          await google.colab.kernel.invokeFunction('convertToInteractive',\\n\",\"                                                    [key], {});\\n\",\"        if (!dataTable) return;\\n\",\"\\n\",\"        const docLinkHtml = 'Like what you see? Visit the ' +\\n\",\"          '<a target=\\\"_blank\\\" href=https://colab.research.google.com/notebooks/data_table.ipynb>data table notebook</a>'\\n\",\"          + ' to learn more about interactive tables.';\\n\",\"        element.innerHTML = '';\\n\",\"        dataTable['output_type'] = 'display_data';\\n\",\"        await google.colab.output.renderOutput(dataTable, element);\\n\",\"        const docLink = document.createElement('div');\\n\",\"        docLink.innerHTML = docLinkHtml;\\n\",\"        element.appendChild(docLink);\\n\",\"      }\\n\",\"    </script>\\n\",\"  </div>\\n\",\"\\n\",\"\\n\",\"  <div id=\\\"id_95605ece-a979-4dd2-b6ba-7bb1cee4d9a6\\\">\\n\",\"    <style>\\n\",\"      .colab-df-generate {\\n\",\"        background-color: #E8F0FE;\\n\",\"        border: none;\\n\",\"        border-radius: 50%;\\n\",\"        cursor: pointer;\\n\",\"        display: none;\\n\",\"        fill: #1967D2;\\n\",\"        height: 32px;\\n\",\"        padding: 0 0 0 0;\\n\",\"        width: 32px;\\n\",\"      }\\n\",\"\\n\",\"      .colab-df-generate:hover {\\n\",\"        background-color: #E2EBFA;\\n\",\"        box-shadow: 0px 1px 2px rgba(60, 64, 67, 0.3), 0px 1px 3px 1px rgba(60, 64, 67, 0.15);\\n\",\"        fill: #174EA6;\\n\",\"      }\\n\",\"\\n\",\"      [theme=dark] .colab-df-generate {\\n\",\"        background-color: #3B4455;\\n\",\"        fill: #D2E3FC;\\n\",\"      }\\n\",\"\\n\",\"      [theme=dark] .colab-df-generate:hover {\\n\",\"        background-color: #434B5C;\\n\",\"        box-shadow: 0px 1px 3px 1px rgba(0, 0, 0, 0.15);\\n\",\"        filter: drop-shadow(0px 1px 2px rgba(0, 0, 0, 0.3));\\n\",\"        fill: #FFFFFF;\\n\",\"      }\\n\",\"    </style>\\n\",\"    <button class=\\\"colab-df-generate\\\" onclick=\\\"generateWithVariable('condition_summary')\\\"\\n\",\"            title=\\\"Generate code using this dataframe.\\\"\\n\",\"            style=\\\"display:none;\\\">\\n\",\"\\n\",\"  <svg xmlns=\\\"http://www.w3.org/2000/svg\\\" height=\\\"24px\\\"viewBox=\\\"0 0 24 24\\\"\\n\",\"       width=\\\"24px\\\">\\n\",\"    <path d=\\\"M7,19H8.4L18.45,9,17,7.55,7,17.6ZM5,21V16.75L18.45,3.32a2,2,0,0,1,2.83,0l1.4,1.43a1.91,1.91,0,0,1,.58,1.4,1.91,1.91,0,0,1-.58,1.4L9.25,21ZM18.45,9,17,7.55Zm-12,3A5.31,5.31,0,0,0,4.9,8.1,5.31,5.31,0,0,0,1,6.5,5.31,5.31,0,0,0,4.9,4.9,5.31,5.31,0,0,0,6.5,1,5.31,5.31,0,0,0,8.1,4.9,5.31,5.31,0,0,0,12,6.5,5.46,5.46,0,0,0,6.5,12Z\\\"/>\\n\",\"  </svg>\\n\",\"    </button>\\n\",\"    <script>\\n\",\"      (() => {\\n\",\"      const buttonEl =\\n\",\"        document.querySelector('#id_95605ece-a979-4dd2-b6ba-7bb1cee4d9a6 button.colab-df-generate');\\n\",\"      buttonEl.style.display =\\n\",\"        google.colab.kernel.accessAllowed ? 'block' : 'none';\\n\",\"\\n\",\"      buttonEl.onclick = () => {\\n\",\"        google.colab.notebook.generateWithVariable('condition_summary');\\n\",\"      }\\n\",\"      })();\\n\",\"    </script>\\n\",\"  </div>\\n\",\"\\n\",\"    </div>\\n\",\"  </div>\\n\"],\"application/vnd.google.colaboratory.intrinsic+json\":{\"type\":\"dataframe\",\"variable_name\":\"condition_summary\",\"summary\":\"{\\n  \\\"name\\\": \\\"condition_summary\\\",\\n  \\\"rows\\\": 2,\\n  \\\"fields\\\": [\\n    {\\n      \\\"column\\\": \\\"Condition\\\",\\n      \\\"properties\\\": {\\n        \\\"dtype\\\": \\\"string\\\",\\n        \\\"num_unique_values\\\": 2,\\n        \\\"samples\\\": [\\n          \\\"High illumination\\\",\\n          \\\"Low illumination\\\"\\n        ],\\n        \\\"semantic_type\\\": \\\"\\\",\\n        \\\"description\\\": \\\"\\\"\\n      }\\n    },\\n    {\\n      \\\"column\\\": \\\"Successful\\\",\\n      \\\"properties\\\": {\\n        \\\"dtype\\\": \\\"number\\\",\\n        \\\"std\\\": 32,\\n        \\\"min\\\": 897,\\n        \\\"max\\\": 943,\\n        \\\"num_unique_values\\\": 2,\\n        \\\"samples\\\": [\\n          897,\\n          943\\n        ],\\n        \\\"semantic_type\\\": \\\"\\\",\\n        \\\"description\\\": \\\"\\\"\\n      }\\n    },\\n    {\\n      \\\"column\\\": \\\"Failed\\\",\\n      \\\"properties\\\": {\\n        \\\"dtype\\\": \\\"number\\\",\\n        \\\"std\\\": 32,\\n        \\\"min\\\": 13,\\n        \\\"max\\\": 59,\\n        \\\"num_unique_values\\\": 2,\\n        \\\"samples\\\": [\\n          59,\\n          13\\n        ],\\n        \\\"semantic_type\\\": \\\"\\\",\\n        \\\"description\\\": \\\"\\\"\\n      }\\n    },\\n    {\\n      \\\"column\\\": \\\"Failure_Rate_Percent\\\",\\n      \\\"properties\\\": {\\n        \\\"dtype\\\": \\\"number\\\",\\n        \\\"std\\\": 3.402396645876693,\\n        \\\"min\\\": 1.3598326359832638,\\n        \\\"max\\\": 6.171548117154812,\\n        \\\"num_unique_values\\\": 2,\\n        \\\"samples\\\": [\\n          6.171548117154812,\\n          1.3598326359832638\\n        ],\\n        \\\"semantic_type\\\": \\\"\\\",\\n        \\\"description\\\": \\\"\\\"\\n      }\\n    }\\n  ]\\n}\"}},\"metadata\":{}},{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"\\n\",\"[3] FAILURE OVERLAP\\n\",\"Low-only failures: 8\\n\",\"High-only failures: 54\\n\",\"Failures shared by both conditions: 5\\n\",\"Total unique excluded positions: 67\\n\",\"\\n\",\"[4] PAIRED-COHORT RETENTION\\n\",\"Original evaluation positions: 956\\n\",\"Retained paired observations: 889\\n\",\"Excluded observations: 67\\n\",\"Retention rate (%): 92.9916\\n\",\"Attrition rate (%): 7.0084\\n\",\"\\n\",\"[5] COHORT COMPOSITION\\n\"]},{\"output_type\":\"display_data\",\"data\":{\"text/plain\":[\"                             Cohort  Count\\n\",\"0  Successful under both conditions    889\\n\",\"1             Failed under low only      8\\n\",\"2            Failed under high only     54\\n\",\"3      Failed under both conditions      5\"],\"text/html\":[\"\\n\",\"  <div id=\\\"df-995fc66e-436d-4043-9eff-1162dbfd7631\\\" class=\\\"colab-df-container\\\">\\n\",\"    <div>\\n\",\"<style scoped>\\n\",\"    .dataframe tbody tr th:only-of-type {\\n\",\"        vertical-align: middle;\\n\",\"    }\\n\",\"\\n\",\"    .dataframe tbody tr th {\\n\",\"        vertical-align: top;\\n\",\"    }\\n\",\"\\n\",\"    .dataframe thead th {\\n\",\"        text-align: right;\\n\",\"    }\\n\",\"</style>\\n\",\"<table border=\\\"1\\\" class=\\\"dataframe\\\">\\n\",\"  <thead>\\n\",\"    <tr style=\\\"text-align: right;\\\">\\n\",\"      <th></th>\\n\",\"      <th>Cohort</th>\\n\",\"      <th>Count</th>\\n\",\"    </tr>\\n\",\"  </thead>\\n\",\"  <tbody>\\n\",\"    <tr>\\n\",\"      <th>0</th>\\n\",\"      <td>Successful under both conditions</td>\\n\",\"      <td>889</td>\\n\",\"    </tr>\\n\",\"    <tr>\\n\",\"      <th>1</th>\\n\",\"      <td>Failed under low only</td>\\n\",\"      <td>8</td>\\n\",\"    </tr>\\n\",\"    <tr>\\n\",\"      <th>2</th>\\n\",\"      <td>Failed under high only</td>\\n\",\"      <td>54</td>\\n\",\"    </tr>\\n\",\"    <tr>\\n\",\"      <th>3</th>\\n\",\"      <td>Failed under both conditions</td>\\n\",\"      <td>5</td>\\n\",\"    </tr>\\n\",\"  </tbody>\\n\",\"</table>\\n\",\"</div>\\n\",\"    <div class=\\\"colab-df-buttons\\\">\\n\",\"\\n\",\"  <div class=\\\"colab-df-container\\\">\\n\",\"    <button class=\\\"colab-df-convert\\\" onclick=\\\"convertToInteractive('df-995fc66e-436d-4043-9eff-1162dbfd7631')\\\"\\n\",\"            title=\\\"Convert this dataframe to an interactive table.\\\"\\n\",\"            style=\\\"display:none;\\\">\\n\",\"\\n\",\"  <svg xmlns=\\\"http://www.w3.org/2000/svg\\\" height=\\\"24px\\\" viewBox=\\\"0 -960 960 960\\\">\\n\",\"    <path d=\\\"M120-120v-720h720v720H120Zm60-500h600v-160H180v160Zm220 220h160v-160H400v160Zm0 220h160v-160H400v160ZM180-400h160v-160H180v160Zm440 0h160v-160H620v160ZM180-180h160v-160H180v160Zm440 0h160v-160H620v160Z\\\"/>\\n\",\"  </svg>\\n\",\"    </button>\\n\",\"\\n\",\"  <style>\\n\",\"    .colab-df-container {\\n\",\"      display:flex;\\n\",\"      gap: 12px;\\n\",\"    }\\n\",\"\\n\",\"    .colab-df-convert {\\n\",\"      background-color: #E8F0FE;\\n\",\"      border: none;\\n\",\"      border-radius: 50%;\\n\",\"      cursor: pointer;\\n\",\"      display: none;\\n\",\"      fill: #1967D2;\\n\",\"      height: 32px;\\n\",\"      padding: 0 0 0 0;\\n\",\"      width: 32px;\\n\",\"    }\\n\",\"\\n\",\"    .colab-df-convert:hover {\\n\",\"      background-color: #E2EBFA;\\n\",\"      box-shadow: 0px 1px 2px rgba(60, 64, 67, 0.3), 0px 1px 3px 1px rgba(60, 64, 67, 0.15);\\n\",\"      fill: #174EA6;\\n\",\"    }\\n\",\"\\n\",\"    .colab-df-buttons div {\\n\",\"      margin-bottom: 4px;\\n\",\"    }\\n\",\"\\n\",\"    [theme=dark] .colab-df-convert {\\n\",\"      background-color: #3B4455;\\n\",\"      fill: #D2E3FC;\\n\",\"    }\\n\",\"\\n\",\"    [theme=dark] .colab-df-convert:hover {\\n\",\"      background-color: #434B5C;\\n\",\"      box-shadow: 0px 1px 3px 1px rgba(0, 0, 0, 0.15);\\n\",\"      filter: drop-shadow(0px 1px 2px rgba(0, 0, 0, 0.3));\\n\",\"      fill: #FFFFFF;\\n\",\"    }\\n\",\"  </style>\\n\",\"\\n\",\"    <script>\\n\",\"      const buttonEl =\\n\",\"        document.querySelector('#df-995fc66e-436d-4043-9eff-1162dbfd7631 button.colab-df-convert');\\n\",\"      buttonEl.style.display =\\n\",\"        google.colab.kernel.accessAllowed ? 'block' : 'none';\\n\",\"\\n\",\"      async function convertToInteractive(key) {\\n\",\"        const element = document.querySelector('#df-995fc66e-436d-4043-9eff-1162dbfd7631');\\n\",\"        const dataTable =\\n\",\"          await google.colab.kernel.invokeFunction('convertToInteractive',\\n\",\"                                                    [key], {});\\n\",\"        if (!dataTable) return;\\n\",\"\\n\",\"        const docLinkHtml = 'Like what you see? Visit the ' +\\n\",\"          '<a target=\\\"_blank\\\" href=https://colab.research.google.com/notebooks/data_table.ipynb>data table notebook</a>'\\n\",\"          + ' to learn more about interactive tables.';\\n\",\"        element.innerHTML = '';\\n\",\"        dataTable['output_type'] = 'display_data';\\n\",\"        await google.colab.output.renderOutput(dataTable, element);\\n\",\"        const docLink = document.createElement('div');\\n\",\"        docLink.innerHTML = docLinkHtml;\\n\",\"        element.appendChild(docLink);\\n\",\"      }\\n\",\"    </script>\\n\",\"  </div>\\n\",\"\\n\",\"\\n\",\"  <div id=\\\"id_a5551e52-2387-49f5-b11c-f5644c95b45a\\\">\\n\",\"    <style>\\n\",\"      .colab-df-generate {\\n\",\"        background-color: #E8F0FE;\\n\",\"        border: none;\\n\",\"        border-radius: 50%;\\n\",\"        cursor: pointer;\\n\",\"        display: none;\\n\",\"        fill: #1967D2;\\n\",\"        height: 32px;\\n\",\"        padding: 0 0 0 0;\\n\",\"        width: 32px;\\n\",\"      }\\n\",\"\\n\",\"      .colab-df-generate:hover {\\n\",\"        background-color: #E2EBFA;\\n\",\"        box-shadow: 0px 1px 2px rgba(60, 64, 67, 0.3), 0px 1px 3px 1px rgba(60, 64, 67, 0.15);\\n\",\"        fill: #174EA6;\\n\",\"      }\\n\",\"\\n\",\"      [theme=dark] .colab-df-generate {\\n\",\"        background-color: #3B4455;\\n\",\"        fill: #D2E3FC;\\n\",\"      }\\n\",\"\\n\",\"      [theme=dark] .colab-df-generate:hover {\\n\",\"        background-color: #434B5C;\\n\",\"        box-shadow: 0px 1px 3px 1px rgba(0, 0, 0, 0.15);\\n\",\"        filter: drop-shadow(0px 1px 2px rgba(0, 0, 0, 0.3));\\n\",\"        fill: #FFFFFF;\\n\",\"      }\\n\",\"    </style>\\n\",\"    <button class=\\\"colab-df-generate\\\" onclick=\\\"generateWithVariable('cohort_summary')\\\"\\n\",\"            title=\\\"Generate code using this dataframe.\\\"\\n\",\"            style=\\\"display:none;\\\">\\n\",\"\\n\",\"  <svg xmlns=\\\"http://www.w3.org/2000/svg\\\" height=\\\"24px\\\"viewBox=\\\"0 0 24 24\\\"\\n\",\"       width=\\\"24px\\\">\\n\",\"    <path d=\\\"M7,19H8.4L18.45,9,17,7.55,7,17.6ZM5,21V16.75L18.45,3.32a2,2,0,0,1,2.83,0l1.4,1.43a1.91,1.91,0,0,1,.58,1.4,1.91,1.91,0,0,1-.58,1.4L9.25,21ZM18.45,9,17,7.55Zm-12,3A5.31,5.31,0,0,0,4.9,8.1,5.31,5.31,0,0,0,1,6.5,5.31,5.31,0,0,0,4.9,4.9,5.31,5.31,0,0,0,6.5,1,5.31,5.31,0,0,0,8.1,4.9,5.31,5.31,0,0,0,12,6.5,5.46,5.46,0,0,0,6.5,12Z\\\"/>\\n\",\"  </svg>\\n\",\"    </button>\\n\",\"    <script>\\n\",\"      (() => {\\n\",\"      const buttonEl =\\n\",\"        document.querySelector('#id_a5551e52-2387-49f5-b11c-f5644c95b45a button.colab-df-generate');\\n\",\"      buttonEl.style.display =\\n\",\"        google.colab.kernel.accessAllowed ? 'block' : 'none';\\n\",\"\\n\",\"      buttonEl.onclick = () => {\\n\",\"        google.colab.notebook.generateWithVariable('cohort_summary');\\n\",\"      }\\n\",\"      })();\\n\",\"    </script>\\n\",\"  </div>\\n\",\"\\n\",\"    </div>\\n\",\"  </div>\\n\"],\"application/vnd.google.colaboratory.intrinsic+json\":{\"type\":\"dataframe\",\"variable_name\":\"cohort_summary\",\"summary\":\"{\\n  \\\"name\\\": \\\"cohort_summary\\\",\\n  \\\"rows\\\": 4,\\n  \\\"fields\\\": [\\n    {\\n      \\\"column\\\": \\\"Cohort\\\",\\n      \\\"properties\\\": {\\n        \\\"dtype\\\": \\\"string\\\",\\n        \\\"num_unique_values\\\": 4,\\n        \\\"samples\\\": [\\n          \\\"Failed under low only\\\",\\n          \\\"Failed under both conditions\\\",\\n          \\\"Successful under both conditions\\\"\\n        ],\\n        \\\"semantic_type\\\": \\\"\\\",\\n        \\\"description\\\": \\\"\\\"\\n      }\\n    },\\n    {\\n      \\\"column\\\": \\\"Count\\\",\\n      \\\"properties\\\": {\\n        \\\"dtype\\\": \\\"number\\\",\\n        \\\"std\\\": 433,\\n        \\\"min\\\": 5,\\n        \\\"max\\\": 889,\\n        \\\"num_unique_values\\\": 4,\\n        \\\"samples\\\": [\\n          8,\\n          5,\\n          889\\n        ],\\n        \\\"semantic_type\\\": \\\"\\\",\\n        \\\"description\\\": \\\"\\\"\\n      }\\n    }\\n  ]\\n}\"}},\"metadata\":{}},{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"\\n\",\"[6] IDENTITY-LEVEL AUDITABILITY\\n\",\"Identity labels available for paired observations: 889\\n\",\"Identity labels available for all original positions: No\\n\",\"Can identity-specific failure rates be calculated: No — excluded-position identity labels are unavailable.\\n\",\"Unique identities represented in paired cohort: 13\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 2.4 — FINAL AUDIT SUMMARY\\n\",\"===========================================================================\\n\",\"Low success/failure partition: PASSED\\n\",\"High success/failure partition: PASSED\\n\",\"Common positions equal paired cohort: PASSED\\n\",\"Paired and excluded positions are disjoint: PASSED\\n\",\"Paired plus excluded equals original cohort: PASSED\\n\",\"\\n\",\"ALL STEP 2.4 COMPUTATIONAL CHECKS PASSED\\n\",\"No source archive was modified.\\n\",\"===========================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"\\n\",\"## Experiment 20 — Step 2.5\\n\",\"### Dataset Suitability and Experimental Protocol Decision\\n\",\"\\n\",\"**Proposed research title**\\n\",\"\\n\",\"Paired Identity-Level Evaluation of Within-Identity Embedding Drift Detection Under Controlled Biometric Acquisition Changes\\n\",\"\\n\",\"### 1. Dataset strategy\\n\",\"\\n\",\"A two-stage experimental design is adopted.\\n\",\"\\n\",\"**Stage 1 — Development dataset**\\n\",\"\\n\",\"- Dataset: Existing LFW-derived Experiment 18 illumination cohort.\\n\",\"- Paired observations: 889.\\n\",\"- Identities: 13.\\n\",\"- Embedding dimension: 512.\\n\",\"- Embedding model: InceptionResnetV1.\\n\",\"- Pretrained weights: VGGFace2.\\n\",\"- Acquisition conditions: Original, low illumination and high illumination.\\n\",\"- Purpose: Develop and evaluate paired within-identity drift detection methods.\\n\",\"\\n\",\"**Stage 2 — Independent validation dataset**\\n\",\"\\n\",\"- Dataset: Extended Yale Face Database B.\\n\",\"- Purpose: Independently evaluate the frozen Stage 1 methodology.\\n\",\"- Acquisition variable: Illumination.\\n\",\"- Embeddings: Freshly generated using the selected embedding model, subject to compatibility and extraction checks.\\n\",\"- Pairing: Match observations by identity and pose across illumination conditions.\\n\",\"- Purpose: Evaluate whether the Stage 1 findings transfer to a separate dataset.\\n\",\"\\n\",\"CMU Multi-PIE is retained as a possible future external validation dataset, not part of the current primary design.\\n\",\"\\n\",\"### 2. Research scope\\n\",\"\\n\",\"The primary focus is illumination-induced within-identity embedding drift.\\n\",\"\\n\",\"Other acquisition variables, including blur, noise and compression, are excluded from the current experiment.\\n\",\"\\n\",\"### 3. Detector methodology\\n\",\"\\n\",\"The planned detector families are:\\n\",\"\\n\",\"1. Global Euclidean distance.\\n\",\"2. Global Mahalanobis distance.\\n\",\"3. Identity-conditioned standardized Euclidean distance.\\n\",\"\\n\",\"Detector definitions, calibration procedures and thresholds must be developed using Stage 1 only.\\n\",\"\\n\",\"The Stage 2 validation dataset must not be used to tune detector parameters or thresholds.\\n\",\"\\n\",\"### 4. Data separation and leakage prevention\\n\",\"\\n\",\"- Keep matched source-image observations together within their assigned partitions.\\n\",\"- Separate model fitting, calibration and evaluation data.\\n\",\"- Do not use Stage 2 observations for Stage 1 model fitting or threshold selection.\\n\",\"- Freeze the Stage 1 methodology before Stage 2 evaluation.\\n\",\"- Report extraction failures separately from embedding-drift detection results.\\n\",\"\\n\",\"### 5. Important limitations\\n\",\"\\n\",\"- The existing LFW cohort contains only 13 identities.\\n\",\"- One identity accounts for 56.69% of the 889 paired observations.\\n\",\"- The existing cohort excludes 67 of 956 original evaluation positions because of extraction failures under at least one illumination condition.\\n\",\"- Extended Yale B is grayscale, whereas the existing pipeline uses an InceptionResnetV1 model pretrained on VGGFace2.\\n\",\"- Preprocessing compatibility and extraction success must be tested before Stage 2 is accepted.\\n\",\"- Cross-dataset validation does not automatically establish generalisation to unconstrained real-world biometric systems.\\n\",\"\\n\",\"### 6. Decisions and pending items\\n\",\"\\n\",\"**Agreed decisions**\\n\",\"\\n\",\"- Dataset strategy: Existing plus independent dataset.\\n\",\"- Stage 1: Existing LFW paired cohort.\\n\",\"- Stage 2: Extended Yale B.\\n\",\"- Acquisition scope: Illumination only.\\n\",\"- Validation: Frozen Stage 1 methodology on Stage 2.\\n\",\"\\n\",\"**Pending technical verification**\\n\",\"\\n\",\"- Dataset download and usage conditions.\\n\",\"- Source-image and identity metadata.\\n\",\"- Exact image-level pairing strategy.\\n\",\"- Grayscale preprocessing compatibility.\\n\",\"- Embedding extraction success.\\n\",\"- Final partition sizes and random seeds.\\n\",\"- Detector calibration and evaluation configuration.\\n\",\"\\n\",\"**Step 2.5 status**\\n\",\"\\n\",\"Research design agreed. Technical feasibility of the independent dataset remains to be verified in Step 2.6.\\n\"],\"metadata\":{\"id\":\"IEShJYmBa4wQ\"}},{\"cell_type\":\"code\",\"source\":[\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 20 — STEP 2.5\\n\",\"# FORMAL RESEARCH DESIGN DECISION RECORD\\n\",\"# ============================================================\\n\",\"\\n\",\"from pathlib import Path\\n\",\"import json\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Define output location\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"output_dir = Path(\\n\",\"    \\\"/content/drive/MyDrive/Experiment_20_Results/design\\\"\\n\",\")\\n\",\"\\n\",\"output_dir.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"output_file = output_dir / \\\"experiment20_stage_design.json\\\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Record agreed research decisions\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"design_record = {\\n\",\"    \\\"experiment\\\": 20,\\n\",\"    \\\"step\\\": \\\"2.5\\\",\\n\",\"    \\\"title\\\": (\\n\",\"        \\\"Paired Identity-Level Evaluation of Within-Identity \\\"\\n\",\"        \\\"Embedding Drift Detection Under Controlled \\\"\\n\",\"        \\\"Biometric Acquisition Changes\\\"\\n\",\"    ),\\n\",\"    \\\"dataset_strategy\\\": \\\"existing_plus_independent_validation\\\",\\n\",\"    \\\"stage_1\\\": {\\n\",\"        \\\"dataset\\\": \\\"LFW\\\",\\n\",\"        \\\"source\\\": \\\"Existing Experiment 18 illumination cohort\\\",\\n\",\"        \\\"paired_observations\\\": 889,\\n\",\"        \\\"identities\\\": 13,\\n\",\"        \\\"embedding_dimension\\\": 512,\\n\",\"        \\\"model\\\": \\\"InceptionResnetV1\\\",\\n\",\"        \\\"pretrained_weights\\\": \\\"VGGFace2\\\",\\n\",\"        \\\"purpose\\\": \\\"Method development and calibration\\\"\\n\",\"    },\\n\",\"    \\\"stage_2\\\": {\\n\",\"        \\\"dataset\\\": \\\"Extended Yale Face Database B\\\",\\n\",\"        \\\"purpose\\\": \\\"Independent validation\\\",\\n\",\"        \\\"embedding_generation\\\": \\\"Fresh extraction required\\\",\\n\",\"        \\\"pairing_strategy\\\": \\\"Identity and pose matched across illumination conditions\\\",\\n\",\"        \\\"status\\\": \\\"Pending acquisition and technical feasibility audit\\\"\\n\",\"    },\\n\",\"    \\\"acquisition_scope\\\": [\\n\",\"        \\\"illumination\\\"\\n\",\"    ],\\n\",\"    \\\"excluded_acquisition_variables\\\": [\\n\",\"        \\\"blur\\\",\\n\",\"        \\\"noise\\\",\\n\",\"        \\\"compression\\\"\\n\",\"    ],\\n\",\"    \\\"planned_detectors\\\": [\\n\",\"        \\\"global_euclidean\\\",\\n\",\"        \\\"global_mahalanobis\\\",\\n\",\"        \\\"identity_conditioned_standardized_euclidean\\\"\\n\",\"    ],\\n\",\"    \\\"validation_protocol\\\": {\\n\",\"        \\\"stage_1_threshold_calibration\\\": True,\\n\",\"        \\\"freeze_stage_1_methodology_before_stage_2\\\": True,\\n\",\"        \\\"stage_2_threshold_retuning\\\": False,\\n\",\"        \\\"stage_2_used_for_stage_1_tuning\\\": False,\\n\",\"        \\\"report_extraction_failures_separately\\\": True,\\n\",\"        \\\"prevent_source_image_partition_leakage\\\": True\\n\",\"    },\\n\",\"    \\\"known_limitations\\\": [\\n\",\"        \\\"Only 13 identities in the existing LFW paired cohort\\\",\\n\",\"        \\\"One identity represents 56.69 percent of paired observations\\\",\\n\",\"        \\\"67 of 956 original evaluation positions were excluded\\\",\\n\",\"        \\\"Extended Yale B is grayscale\\\",\\n\",\"        \\\"Embedding preprocessing compatibility remains unverified\\\"\\n\",\"    ],\\n\",\"    \\\"pending_verifications\\\": [\\n\",\"        \\\"Dataset access and usage conditions\\\",\\n\",\"        \\\"Source image and identity metadata\\\",\\n\",\"        \\\"Image-level pairing\\\",\\n\",\"        \\\"Grayscale preprocessing compatibility\\\",\\n\",\"        \\\"Embedding extraction success\\\",\\n\",\"        \\\"Partition sizes and random seeds\\\",\\n\",\"        \\\"Detector calibration and evaluation configuration\\\"\\n\",\"    ],\\n\",\"    \\\"decision_status\\\": \\\"DESIGN_AGREED_TECHNICAL_VALIDATION_PENDING\\\",\\n\",\"    \\\"created_utc\\\": datetime.now(timezone.utc).isoformat()\\n\",\"}\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Save the decision record\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"with open(output_file, \\\"w\\\", encoding=\\\"utf-8\\\") as file:\\n\",\"    json.dump(design_record, file, indent=4)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Reopen and verify the saved record\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"with open(output_file, \\\"r\\\", encoding=\\\"utf-8\\\") as file:\\n\",\"    verified_record = json.load(file)\\n\",\"\\n\",\"assert verified_record[\\\"experiment\\\"] == 20\\n\",\"assert verified_record[\\\"step\\\"] == \\\"2.5\\\"\\n\",\"assert verified_record[\\\"stage_1\\\"][\\\"paired_observations\\\"] == 889\\n\",\"assert verified_record[\\\"stage_2\\\"][\\\"dataset\\\"] == \\\"Extended Yale Face Database B\\\"\\n\",\"assert verified_record[\\\"validation_protocol\\\"][\\\"stage_2_threshold_retuning\\\"] is False\\n\",\"\\n\",\"print(\\\"=\\\" * 70)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 2.5\\\")\\n\",\"print(\\\"RESEARCH DESIGN DECISION RECORD\\\")\\n\",\"print(\\\"=\\\" * 70)\\n\",\"\\n\",\"print(\\\"Output file:\\\", output_file)\\n\",\"print(\\\"File exists:\\\", output_file.exists())\\n\",\"print(\\\"File size:\\\", output_file.stat().st_size, \\\"bytes\\\")\\n\",\"print(\\\"JSON reload verification: PASSED\\\")\\n\",\"print(\\\"Stage 1 dataset:\\\", verified_record[\\\"stage_1\\\"][\\\"dataset\\\"])\\n\",\"print(\\\"Stage 2 dataset:\\\", verified_record[\\\"stage_2\\\"][\\\"dataset\\\"])\\n\",\"print(\\\"Acquisition scope:\\\", verified_record[\\\"acquisition_scope\\\"])\\n\",\"print(\\\"Decision status:\\\", verified_record[\\\"decision_status\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nSTEP 2.5 DOCUMENTATION SAVED AND VERIFIED\\\")\\n\",\"print(\\\"No Experiment 18 files were modified.\\\")\\n\",\"print(\\\"=\\\" * 70)\\n\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"ZE6OcakMa65U\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794347087851,\"user_tz\":360,\"elapsed\":42,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"a23b55b5-4687-40ad-f6ff-a0c3f6ffddc6\"},\"execution_count\":null,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"======================================================================\\n\",\"EXPERIMENT 20 — STEP 2.5\\n\",\"RESEARCH DESIGN DECISION RECORD\\n\",\"======================================================================\\n\",\"Output file: /content/drive/MyDrive/Experiment_20_Results/design/experiment20_stage_design.json\\n\",\"File exists: True\\n\",\"File size: 2411 bytes\\n\",\"JSON reload verification: PASSED\\n\",\"Stage 1 dataset: LFW\\n\",\"Stage 2 dataset: Extended Yale Face Database B\\n\",\"Acquisition scope: ['illumination']\\n\",\"Decision status: DESIGN_AGREED_TECHNICAL_VALIDATION_PENDING\\n\",\"\\n\",\"STEP 2.5 DOCUMENTATION SAVED AND VERIFIED\\n\",\"No Experiment 18 files were modified.\\n\",\"======================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"\\n\",\"## Experiment 20 — Step 2.6.1\\n\",\"### Extended Yale B Source and Acquisition Audit\\n\",\"\\n\",\"**Objective**\\n\",\"\\n\",\"Assess the availability, provenance, storage requirements and research-use conditions of the independent validation dataset before acquisition.\\n\",\"\\n\",\"**Expected dataset characteristics**\\n\",\"\\n\",\"- Dataset: Extended Yale Face Database B\\n\",\"- Subjects: 28\\n\",\"- Poses: 9\\n\",\"- Illumination conditions: 64\\n\",\"- Expected images: 16,128\\n\",\"- Image type: Grayscale\\n\",\"\\n\",\"**Audit requirements**\\n\",\"\\n\",\"1. Inspect the existing Google Drive research directories.\\n\",\"2. Check available Google Drive storage visibility.\\n\",\"3. Test accessibility of the original UCSD dataset information page.\\n\",\"4. Record HTTP response and content type without downloading the dataset.\\n\",\"5. Check whether an Extended Yale B archive already exists in the research directories.\\n\",\"6. Record source and provenance limitations.\\n\",\"\\n\",\"**Acquisition policy**\\n\",\"\\n\",\"- Do not download unverified third-party archives.\\n\",\"- Do not extract or modify any dataset during this step.\\n\",\"- Preserve source attribution and dataset usage conditions.\\n\",\"- Do not proceed to embedding generation before archive integrity and image metadata are verified.\\n\",\"\\n\",\"**Expected outcome**\\n\",\"\\n\",\"A source-access and acquisition-readiness report for the Extended Yale B dataset.\\n\"],\"metadata\":{\"id\":\"xumZR588bLDS\"}},{\"cell_type\":\"code\",\"source\":[\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 20 — STEP 2.6.1\\n\",\"# EXTENDED YALE B SOURCE AND ACQUISITION AUDIT\\n\",\"# ============================================================\\n\",\"\\n\",\"from pathlib import Path\\n\",\"import json\\n\",\"import requests\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Define research directories\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"drive_root = Path(\\\"/content/drive/MyDrive\\\")\\n\",\"\\n\",\"experiment18_dir = drive_root / \\\"Experiment_18_Results\\\"\\n\",\"experiment20_dir = drive_root / \\\"Experiment_20_Results\\\"\\n\",\"\\n\",\"audit_dir = experiment20_dir / \\\"dataset_audit\\\"\\n\",\"audit_dir.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 2.6.1\\\")\\n\",\"print(\\\"EXTENDED YALE B SOURCE AND ACQUISITION AUDIT\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Verify existing research directories\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[1] EXISTING RESEARCH DIRECTORIES\\\")\\n\",\"\\n\",\"for name, path in [\\n\",\"    (\\\"Google Drive root\\\", drive_root),\\n\",\"    (\\\"Experiment 18 directory\\\", experiment18_dir),\\n\",\"    (\\\"Experiment 20 directory\\\", experiment20_dir),\\n\",\"    (\\\"Dataset audit directory\\\", audit_dir)\\n\",\"]:\\n\",\"    print(f\\\"{name}: {path}\\\")\\n\",\"    print(\\\"Exists:\\\", path.exists())\\n\",\"\\n\",\"assert drive_root.exists(), (\\n\",\"    \\\"Google Drive is not mounted. Mount Drive before proceeding.\\\"\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Search for existing Yale B archives\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[2] EXISTING YALE B ARCHIVE SEARCH\\\")\\n\",\"\\n\",\"search_roots = [\\n\",\"    drive_root / \\\"Experiment_20_Results\\\",\\n\",\"    drive_root / \\\"Datasets\\\",\\n\",\"    drive_root / \\\"Research_Datasets\\\"\\n\",\"]\\n\",\"\\n\",\"archive_extensions = {\\n\",\"    \\\".zip\\\", \\\".tar\\\", \\\".gz\\\", \\\".bz2\\\", \\\".tgz\\\"\\n\",\"}\\n\",\"\\n\",\"yale_candidates = []\\n\",\"\\n\",\"for root in search_roots:\\n\",\"\\n\",\"    if not root.exists():\\n\",\"        continue\\n\",\"\\n\",\"    for path in root.rglob(\\\"*\\\"):\\n\",\"\\n\",\"        if not path.is_file():\\n\",\"            continue\\n\",\"\\n\",\"        name = path.name.lower()\\n\",\"\\n\",\"        if (\\n\",\"            \\\"yale\\\" in name\\n\",\"            and (\\n\",\"                path.suffix.lower() in archive_extensions\\n\",\"                or \\\".tar.\\\" in name\\n\",\"            )\\n\",\"        ):\\n\",\"            yale_candidates.append({\\n\",\"                \\\"path\\\": str(path),\\n\",\"                \\\"size_bytes\\\": path.stat().st_size\\n\",\"            })\\n\",\"\\n\",\"if yale_candidates:\\n\",\"    for item in yale_candidates:\\n\",\"        print(item)\\n\",\"else:\\n\",\"    print(\\\"No matching Yale B archive found in the searched directories.\\\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Check available local Colab disk space\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[3] COLAB LOCAL STORAGE\\\")\\n\",\"\\n\",\"import shutil\\n\",\"\\n\",\"disk = shutil.disk_usage(\\\"/content\\\")\\n\",\"\\n\",\"print(\\\"Total disk space (GB):\\\", round(disk.total / 1e9, 2))\\n\",\"print(\\\"Used disk space (GB):\\\", round(disk.used / 1e9, 2))\\n\",\"print(\\\"Free disk space (GB):\\\", round(disk.free / 1e9, 2))\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Test original UCSD information page\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[4] ORIGINAL UCSD SOURCE ACCESS TEST\\\")\\n\",\"\\n\",\"source_url = (\\n\",\"    \\\"https://vision.ucsd.edu/~leekc/\\\"\\n\",\"    \\\"ExtYaleDatabase/ExtYaleB.html\\\"\\n\",\")\\n\",\"\\n\",\"source_result = {\\n\",\"    \\\"url\\\": source_url,\\n\",\"    \\\"request_method\\\": \\\"GET\\\",\\n\",\"    \\\"accessible\\\": False,\\n\",\"    \\\"http_status\\\": None,\\n\",\"    \\\"content_type\\\": None,\\n\",\"    \\\"error\\\": None\\n\",\"}\\n\",\"\\n\",\"try:\\n\",\"\\n\",\"    response = requests.get(\\n\",\"        source_url,\\n\",\"        timeout=25,\\n\",\"        stream=True,\\n\",\"        allow_redirects=True,\\n\",\"        headers={\\n\",\"            \\\"User-Agent\\\": \\\"Mozilla/5.0 Experiment20ResearchAudit\\\"\\n\",\"        }\\n\",\"    )\\n\",\"\\n\",\"    source_result[\\\"http_status\\\"] = response.status_code\\n\",\"    source_result[\\\"content_type\\\"] = response.headers.get(\\n\",\"        \\\"Content-Type\\\"\\n\",\"    )\\n\",\"    source_result[\\\"final_url\\\"] = response.url\\n\",\"    source_result[\\\"accessible\\\"] = response.ok\\n\",\"\\n\",\"    print(\\\"HTTP status:\\\", response.status_code)\\n\",\"    print(\\\"Content type:\\\", source_result[\\\"content_type\\\"])\\n\",\"    print(\\\"Final URL:\\\", response.url)\\n\",\"    print(\\\"Accessible:\\\", response.ok)\\n\",\"\\n\",\"    response.close()\\n\",\"\\n\",\"except requests.RequestException as error:\\n\",\"\\n\",\"    source_result[\\\"error\\\"] = str(error)\\n\",\"\\n\",\"    print(\\\"Source access error:\\\", error)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. Record documented dataset characteristics\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[5] DOCUMENTED DATASET CHARACTERISTICS\\\")\\n\",\"\\n\",\"dataset_metadata = {\\n\",\"    \\\"dataset\\\": \\\"Extended Yale Face Database B\\\",\\n\",\"    \\\"subjects\\\": 28,\\n\",\"    \\\"poses\\\": 9,\\n\",\"    \\\"illumination_conditions\\\": 64,\\n\",\"    \\\"expected_images\\\": 16128,\\n\",\"    \\\"image_type\\\": \\\"Grayscale\\\",\\n\",\"    \\\"expected_dimensions\\\": [168, 192],\\n\",\"    \\\"dimensions_note\\\": (\\n\",\"        \\\"Reported for manually aligned, cropped and resized images; \\\"\\n\",\"        \\\"must be confirmed against the acquired archive.\\\"\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"for key, value in dataset_metadata.items():\\n\",\"    print(f\\\"{key}: {value}\\\")\\n\",\"\\n\",\"assert (\\n\",\"    dataset_metadata[\\\"subjects\\\"]\\n\",\"    * dataset_metadata[\\\"poses\\\"]\\n\",\"    * dataset_metadata[\\\"illumination_conditions\\\"]\\n\",\"    == dataset_metadata[\\\"expected_images\\\"]\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. Create provenance audit record\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"audit_record = {\\n\",\"    \\\"experiment\\\": 20,\\n\",\"    \\\"step\\\": \\\"2.6.1\\\",\\n\",\"    \\\"audit_timestamp_utc\\\": datetime.now(\\n\",\"        timezone.utc\\n\",\"    ).isoformat(),\\n\",\"    \\\"dataset_metadata\\\": dataset_metadata,\\n\",\"    \\\"source_test\\\": source_result,\\n\",\"    \\\"existing_yale_archives\\\": yale_candidates,\\n\",\"    \\\"colab_storage\\\": {\\n\",\"        \\\"total_bytes\\\": disk.total,\\n\",\"        \\\"used_bytes\\\": disk.used,\\n\",\"        \\\"free_bytes\\\": disk.free\\n\",\"    },\\n\",\"    \\\"source_policy\\\": {\\n\",\"        \\\"original_source_preferred\\\": True,\\n\",\"        \\\"third_party_archive_requires_provenance_review\\\": True,\\n\",\"        \\\"research_attribution_required\\\": True,\\n\",\"        \\\"formal_open_source_license_confirmed\\\": False\\n\",\"    },\\n\",\"    \\\"download_performed\\\": False,\\n\",\"    \\\"archive_extracted\\\": False,\\n\",\"    \\\"embedding_generation_performed\\\": False\\n\",\"}\\n\",\"\\n\",\"audit_file = audit_dir / \\\"experiment20_yaleb_source_audit.json\\\"\\n\",\"\\n\",\"with open(audit_file, \\\"w\\\", encoding=\\\"utf-8\\\") as file:\\n\",\"    json.dump(audit_record, file, indent=4)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 8. Reload and verify audit record\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"with open(audit_file, \\\"r\\\", encoding=\\\"utf-8\\\") as file:\\n\",\"    verified = json.load(file)\\n\",\"\\n\",\"assert verified[\\\"step\\\"] == \\\"2.6.1\\\"\\n\",\"assert verified[\\\"download_performed\\\"] is False\\n\",\"assert verified[\\\"archive_extracted\\\"] is False\\n\",\"assert verified[\\\"embedding_generation_performed\\\"] is False\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 2.6.1 — FINAL AUDIT SUMMARY\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"print(\\\"Audit record:\\\", audit_file)\\n\",\"print(\\\"Record exists:\\\", audit_file.exists())\\n\",\"print(\\\"JSON reload verification: PASSED\\\")\\n\",\"print(\\\"Dataset download performed: NO\\\")\\n\",\"print(\\\"Archive extraction performed: NO\\\")\\n\",\"print(\\\"Embedding generation performed: NO\\\")\\n\",\"\\n\",\"print(\\\"\\\\nSTEP 2.6.1 AUDIT RECORD SAVED\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"BXYhdwSrbM4o\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794347162551,\"user_tz\":360,\"elapsed\":1258,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"ff19d367-ac60-41d6-a5d8-d62376433825\"},\"execution_count\":null,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"===========================================================================\\n\",\"EXPERIMENT 20 — STEP 2.6.1\\n\",\"EXTENDED YALE B SOURCE AND ACQUISITION AUDIT\\n\",\"===========================================================================\\n\",\"\\n\",\"[1] EXISTING RESEARCH DIRECTORIES\\n\",\"Google Drive root: /content/drive/MyDrive\\n\",\"Exists: True\\n\",\"Experiment 18 directory: /content/drive/MyDrive/Experiment_18_Results\\n\",\"Exists: True\\n\",\"Experiment 20 directory: /content/drive/MyDrive/Experiment_20_Results\\n\",\"Exists: True\\n\",\"Dataset audit directory: /content/drive/MyDrive/Experiment_20_Results/dataset_audit\\n\",\"Exists: True\\n\",\"\\n\",\"[2] EXISTING YALE B ARCHIVE SEARCH\\n\",\"No matching Yale B archive found in the searched directories.\\n\",\"\\n\",\"[3] COLAB LOCAL STORAGE\\n\",\"Total disk space (GB): 115.66\\n\",\"Used disk space (GB): 0.11\\n\",\"Free disk space (GB): 115.53\\n\",\"\\n\",\"[4] ORIGINAL UCSD SOURCE ACCESS TEST\\n\",\"HTTP status: 404\\n\",\"Content type: text/html; charset=UTF-8\\n\",\"Final URL: https://vision.ucsd.edu/~leekc/ExtYaleDatabase/ExtYaleB.html\\n\",\"Accessible: False\\n\",\"\\n\",\"[5] DOCUMENTED DATASET CHARACTERISTICS\\n\",\"dataset: Extended Yale Face Database B\\n\",\"subjects: 28\\n\",\"poses: 9\\n\",\"illumination_conditions: 64\\n\",\"expected_images: 16128\\n\",\"image_type: Grayscale\\n\",\"expected_dimensions: [168, 192]\\n\",\"dimensions_note: Reported for manually aligned, cropped and resized images; must be confirmed against the acquired archive.\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 2.6.1 — FINAL AUDIT SUMMARY\\n\",\"===========================================================================\\n\",\"Audit record: /content/drive/MyDrive/Experiment_20_Results/dataset_audit/experiment20_yaleb_source_audit.json\\n\",\"Record exists: True\\n\",\"JSON reload verification: PASSED\\n\",\"Dataset download performed: NO\\n\",\"Archive extraction performed: NO\\n\",\"Embedding generation performed: NO\\n\",\"\\n\",\"STEP 2.6.1 AUDIT RECORD SAVED\\n\",\"===========================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"\\n\",\"## Experiment 20 — Step 2.6.2\\n\",\"### Alternative Dataset Source Verification\\n\",\"\\n\",\"**Objective**\\n\",\"\\n\",\"Evaluate Academic Torrents as an alternative source following the HTTP 404 response from the original UCSD URL.\\n\",\"\\n\",\"**Candidate source**\\n\",\"\\n\",\"Academic Torrents — Extended Yale Face Database B.\\n\",\"\\n\",\"**Advertised archive**\\n\",\"\\n\",\"- Filename: ExtendedYaleB.tar.bz2\\n\",\"- Advertised size: 2.09 GB\\n\",\"- Expected subjects: 28\\n\",\"- Expected poses: 9\\n\",\"- Expected illumination conditions: 64\\n\",\"- Expected images: 16,128\\n\",\"\\n\",\"**Source limitations**\\n\",\"\\n\",\"- Academic Torrents is community-maintained.\\n\",\"- The archive is hosted through distributed torrent providers.\\n\",\"- The listing reproduces historical dataset documentation.\\n\",\"- Archive authenticity and completeness have not yet been established.\\n\",\"- A formal open-source licence has not been independently confirmed.\\n\",\"\\n\",\"**Decision**\\n\",\"\\n\",\"Treat Academic Torrents as a candidate source, not a verified original distribution.\\n\",\"\\n\",\"**Next verification requirements**\\n\",\"\\n\",\"1. Record the dataset listing and advertised archive details.\\n\",\"2. Confirm the listing is accessible from Colab.\\n\",\"3. Check the advertised archive filename and size.\\n\",\"4. Do not download or extract the archive in this step.\\n\"],\"metadata\":{\"id\":\"bSE02JT3bgRz\"}},{\"cell_type\":\"code\",\"source\":[\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 20 — STEP 2.6.2\\n\",\"# ALTERNATIVE DATASET SOURCE VERIFICATION\\n\",\"# ============================================================\\n\",\"\\n\",\"from pathlib import Path\\n\",\"import requests\\n\",\"import json\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Define candidate source\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"source_url = (\\n\",\"    \\\"https://academictorrents.com/details/\\\"\\n\",\"    \\\"06e479f338b56fa5948c40287b66f68236a14612\\\"\\n\",\")\\n\",\"\\n\",\"expected_filename = \\\"ExtendedYaleB.tar.bz2\\\"\\n\",\"advertised_size_gb = 2.09\\n\",\"\\n\",\"audit_dir = Path(\\n\",\"    \\\"/content/drive/MyDrive/Experiment_20_Results/\\\"\\n\",\"    \\\"dataset_audit\\\"\\n\",\")\\n\",\"\\n\",\"audit_dir.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 2.6.2\\\")\\n\",\"print(\\\"ALTERNATIVE DATASET SOURCE VERIFICATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Test listing accessibility\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[1] ACADEMIC TORRENTS LISTING ACCESS\\\")\\n\",\"\\n\",\"response_data = {\\n\",\"    \\\"url\\\": source_url,\\n\",\"    \\\"accessible\\\": False,\\n\",\"    \\\"http_status\\\": None,\\n\",\"    \\\"final_url\\\": None,\\n\",\"    \\\"content_type\\\": None,\\n\",\"    \\\"title_found\\\": False,\\n\",\"    \\\"archive_found\\\": False\\n\",\"}\\n\",\"\\n\",\"try:\\n\",\"\\n\",\"    response = requests.get(\\n\",\"        source_url,\\n\",\"        timeout=30,\\n\",\"        headers={\\n\",\"            \\\"User-Agent\\\": \\\"Mozilla/5.0 Experiment20ResearchAudit\\\"\\n\",\"        }\\n\",\"    )\\n\",\"\\n\",\"    response_data[\\\"http_status\\\"] = response.status_code\\n\",\"    response_data[\\\"final_url\\\"] = response.url\\n\",\"    response_data[\\\"content_type\\\"] = response.headers.get(\\n\",\"        \\\"Content-Type\\\"\\n\",\"    )\\n\",\"\\n\",\"    response_data[\\\"accessible\\\"] = response.ok\\n\",\"\\n\",\"    page_text = response.text.lower()\\n\",\"\\n\",\"    response_data[\\\"title_found\\\"] = (\\n\",\"        \\\"extended yale face database b\\\" in page_text\\n\",\"    )\\n\",\"\\n\",\"    response_data[\\\"archive_found\\\"] = (\\n\",\"        expected_filename.lower() in page_text\\n\",\"    )\\n\",\"\\n\",\"    print(\\\"HTTP status:\\\", response.status_code)\\n\",\"    print(\\\"Accessible:\\\", response.ok)\\n\",\"    print(\\\"Final URL:\\\", response.url)\\n\",\"    print(\\\"Content type:\\\", response_data[\\\"content_type\\\"])\\n\",\"    print(\\\"Dataset title found:\\\", response_data[\\\"title_found\\\"])\\n\",\"    print(\\\"Archive filename found:\\\", response_data[\\\"archive_found\\\"])\\n\",\"\\n\",\"except requests.RequestException as error:\\n\",\"\\n\",\"    response_data[\\\"error\\\"] = str(error)\\n\",\"    print(\\\"Request error:\\\", error)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Record advertised archive details\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[2] ADVERTISED ARCHIVE DETAILS\\\")\\n\",\"\\n\",\"archive_metadata = {\\n\",\"    \\\"filename\\\": expected_filename,\\n\",\"    \\\"advertised_size_gb\\\": advertised_size_gb,\\n\",\"    \\\"expected_subjects\\\": 28,\\n\",\"    \\\"expected_poses\\\": 9,\\n\",\"    \\\"expected_illumination_conditions\\\": 64,\\n\",\"    \\\"expected_images\\\": 16128\\n\",\"}\\n\",\"\\n\",\"for key, value in archive_metadata.items():\\n\",\"    print(f\\\"{key}: {value}\\\")\\n\",\"\\n\",\"assert (\\n\",\"    archive_metadata[\\\"expected_subjects\\\"]\\n\",\"    * archive_metadata[\\\"expected_poses\\\"]\\n\",\"    * archive_metadata[\\\"expected_illumination_conditions\\\"]\\n\",\"    == archive_metadata[\\\"expected_images\\\"]\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Record source limitations\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"source_limitations = {\\n\",\"    \\\"community_hosted\\\": True,\\n\",\"    \\\"official_ucsd_distribution\\\": False,\\n\",\"    \\\"archive_authenticity_verified\\\": False,\\n\",\"    \\\"archive_checksum_verified\\\": False,\\n\",\"    \\\"formal_open_source_license_confirmed\\\": False,\\n\",\"    \\\"research_attribution_required\\\": True\\n\",\"}\\n\",\"\\n\",\"print(\\\"\\\\n[3] SOURCE LIMITATIONS\\\")\\n\",\"\\n\",\"for key, value in source_limitations.items():\\n\",\"    print(f\\\"{key}: {value}\\\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Save source verification record\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"record = {\\n\",\"    \\\"experiment\\\": 20,\\n\",\"    \\\"step\\\": \\\"2.6.2\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"candidate_source\\\": \\\"Academic Torrents\\\",\\n\",\"    \\\"source_url\\\": source_url,\\n\",\"    \\\"listing_access_test\\\": response_data,\\n\",\"    \\\"advertised_archive\\\": archive_metadata,\\n\",\"    \\\"source_limitations\\\": source_limitations,\\n\",\"    \\\"download_performed\\\": False,\\n\",\"    \\\"extraction_performed\\\": False,\\n\",\"    \\\"source_decision\\\": (\\n\",\"        \\\"CANDIDATE_SOURCE_PENDING_ARCHIVE_INTEGRITY_VERIFICATION\\\"\\n\",\"        if response_data[\\\"accessible\\\"]\\n\",\"        and response_data[\\\"title_found\\\"]\\n\",\"        and response_data[\\\"archive_found\\\"]\\n\",\"        else \\\"SOURCE_ACCESS_REQUIRES_FURTHER_INVESTIGATION\\\"\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"output_file = (\\n\",\"    audit_dir / \\\"experiment20_yaleb_alternative_source_audit.json\\\"\\n\",\")\\n\",\"\\n\",\"with open(output_file, \\\"w\\\", encoding=\\\"utf-8\\\") as file:\\n\",\"    json.dump(record, file, indent=4)\\n\",\"\\n\",\"with open(output_file, \\\"r\\\", encoding=\\\"utf-8\\\") as file:\\n\",\"    verified = json.load(file)\\n\",\"\\n\",\"assert verified[\\\"step\\\"] == \\\"2.6.2\\\"\\n\",\"assert verified[\\\"download_performed\\\"] is False\\n\",\"assert verified[\\\"extraction_performed\\\"] is False\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 2.6.2 — FINAL SUMMARY\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"print(\\\"Audit file:\\\", output_file)\\n\",\"print(\\\"JSON verification: PASSED\\\")\\n\",\"print(\\\"Source decision:\\\", verified[\\\"source_decision\\\"])\\n\",\"print(\\\"Download performed: NO\\\")\\n\",\"print(\\\"Extraction performed: NO\\\")\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"a3oVaqsRbiVU\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794347249404,\"user_tz\":360,\"elapsed\":320,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"70acdc8b-2c5e-48d5-dffd-3277472a0895\"},\"execution_count\":null,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"===========================================================================\\n\",\"EXPERIMENT 20 — STEP 2.6.2\\n\",\"ALTERNATIVE DATASET SOURCE VERIFICATION\\n\",\"===========================================================================\\n\",\"\\n\",\"[1] ACADEMIC TORRENTS LISTING ACCESS\\n\",\"HTTP status: 200\\n\",\"Accessible: True\\n\",\"Final URL: https://academictorrents.com/details/06e479f338b56fa5948c40287b66f68236a14612\\n\",\"Content type: text/html; charset=UTF-8\\n\",\"Dataset title found: True\\n\",\"Archive filename found: True\\n\",\"\\n\",\"[2] ADVERTISED ARCHIVE DETAILS\\n\",\"filename: ExtendedYaleB.tar.bz2\\n\",\"advertised_size_gb: 2.09\\n\",\"expected_subjects: 28\\n\",\"expected_poses: 9\\n\",\"expected_illumination_conditions: 64\\n\",\"expected_images: 16128\\n\",\"\\n\",\"[3] SOURCE LIMITATIONS\\n\",\"community_hosted: True\\n\",\"official_ucsd_distribution: False\\n\",\"archive_authenticity_verified: False\\n\",\"archive_checksum_verified: False\\n\",\"formal_open_source_license_confirmed: False\\n\",\"research_attribution_required: True\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 2.6.2 — FINAL SUMMARY\\n\",\"===========================================================================\\n\",\"Audit file: /content/drive/MyDrive/Experiment_20_Results/dataset_audit/experiment20_yaleb_alternative_source_audit.json\\n\",\"JSON verification: PASSED\\n\",\"Source decision: CANDIDATE_SOURCE_PENDING_ARCHIVE_INTEGRITY_VERIFICATION\\n\",\"Download performed: NO\\n\",\"Extraction performed: NO\\n\",\"===========================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"\\n\",\"## Experiment 20 — Step 2.6.3\\n\",\"### Torrent Metadata and Download-Readiness Audit\\n\",\"\\n\",\"**Objective**\\n\",\"\\n\",\"Inspect the candidate Academic Torrents record before acquiring the Extended Yale Face Database B archive.\\n\",\"\\n\",\"**Audit requirements**\\n\",\"\\n\",\"1. Retrieve the dataset listing HTML.\\n\",\"2. Identify any advertised torrent identifier.\\n\",\"3. Search for a magnet URI and BitTorrent info hash.\\n\",\"4. Identify advertised archive filenames and sizes where available.\\n\",\"5. Record whether the listing exposes sufficient metadata for acquisition.\\n\",\"6. Save the audit results.\\n\",\"\\n\",\"**Integrity constraints**\\n\",\"\\n\",\"- Do not download the dataset.\\n\",\"- Do not extract any archive.\\n\",\"- Do not assume that a listing's advertised size proves archive integrity.\\n\",\"- Do not treat a torrent identifier as a cryptographic verification of dataset contents.\\n\",\"\\n\",\"**Expected outcome**\\n\",\"\\n\",\"A documented decision on whether the candidate source has sufficient metadata to proceed to controlled acquisition.\\n\"],\"metadata\":{\"id\":\"1DWzClptbtDi\"}},{\"cell_type\":\"code\",\"source\":[\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 20 — STEP 2.6.3\\n\",\"# TORRENT METADATA AND DOWNLOAD-READINESS AUDIT\\n\",\"# ============================================================\\n\",\"\\n\",\"from pathlib import Path\\n\",\"import requests\\n\",\"import re\\n\",\"import json\\n\",\"from datetime import datetime, timezone\\n\",\"from urllib.parse import urlparse, parse_qs\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Retrieve candidate listing\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"source_url = (\\n\",\"    \\\"https://academictorrents.com/details/\\\"\\n\",\"    \\\"06e479f338b56fa5948c40287b66f68236a14612\\\"\\n\",\")\\n\",\"\\n\",\"audit_dir = Path(\\n\",\"    \\\"/content/drive/MyDrive/Experiment_20_Results/\\\"\\n\",\"    \\\"dataset_audit\\\"\\n\",\")\\n\",\"\\n\",\"audit_dir.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 2.6.3\\\")\\n\",\"print(\\\"TORRENT METADATA AND DOWNLOAD-READINESS AUDIT\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"response = requests.get(\\n\",\"    source_url,\\n\",\"    timeout=30,\\n\",\"    headers={\\\"User-Agent\\\": \\\"Mozilla/5.0 Experiment20ResearchAudit\\\"}\\n\",\")\\n\",\"\\n\",\"response.raise_for_status()\\n\",\"\\n\",\"html = response.text\\n\",\"\\n\",\"print(\\\"\\\\n[1] LISTING RETRIEVAL\\\")\\n\",\"print(\\\"HTTP status:\\\", response.status_code)\\n\",\"print(\\\"HTML length:\\\", len(html))\\n\",\"print(\\\"Final URL:\\\", response.url)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Extract magnet links\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[2] MAGNET LINK INSPECTION\\\")\\n\",\"\\n\",\"magnet_links = re.findall(\\n\",\"    r'href=[\\\"\\\\'](magnet:\\\\?[^\\\"\\\\']+)[\\\"\\\\']',\\n\",\"    html,\\n\",\"    flags=re.IGNORECASE\\n\",\")\\n\",\"\\n\",\"magnet_links = list(dict.fromkeys(magnet_links))\\n\",\"\\n\",\"info_hashes = []\\n\",\"\\n\",\"for magnet in magnet_links:\\n\",\"\\n\",\"    parsed = urlparse(magnet)\\n\",\"    params = parse_qs(parsed.query)\\n\",\"\\n\",\"    for value in params.get(\\\"xt\\\", []):\\n\",\"\\n\",\"        match = re.search(\\n\",\"            r\\\"urn:btih:([a-fA-F0-9]{40}|[a-zA-Z2-7]{32})\\\",\\n\",\"            value\\n\",\"        )\\n\",\"\\n\",\"        if match:\\n\",\"            info_hashes.append(match.group(1))\\n\",\"\\n\",\"print(\\\"Magnet links found:\\\", len(magnet_links))\\n\",\"print(\\\"Info hashes found:\\\", len(info_hashes))\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Search for torrent identifiers\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[3] TORRENT IDENTIFIER INSPECTION\\\")\\n\",\"\\n\",\"identifier_patterns = [\\n\",\"    r\\\"torrent[_-]?id[\\\\\\\"'\\\\s:=]+([a-zA-Z0-9_-]+)\\\",\\n\",\"    r\\\"info[_-]?hash[\\\\\\\"'\\\\s:=]+([a-fA-F0-9]{40})\\\",\\n\",\"    r\\\"urn:btih:([a-fA-F0-9]{40})\\\"\\n\",\"]\\n\",\"\\n\",\"identifier_matches = {}\\n\",\"\\n\",\"for pattern in identifier_patterns:\\n\",\"\\n\",\"    matches = re.findall(\\n\",\"        pattern,\\n\",\"        html,\\n\",\"        flags=re.IGNORECASE\\n\",\"    )\\n\",\"\\n\",\"    identifier_matches[pattern] = list(dict.fromkeys(matches))\\n\",\"\\n\",\"    print(\\\"Pattern:\\\", pattern)\\n\",\"    print(\\\"Matches:\\\", matches[:10])\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Search for advertised archive metadata\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[4] ARCHIVE METADATA INSPECTION\\\")\\n\",\"\\n\",\"filename_found = \\\"ExtendedYaleB.tar.bz2\\\" in html\\n\",\"\\n\",\"size_mentions = re.findall(\\n\",\"    r\\\".{0,60}(?:2\\\\.09\\\\s*GB|2090\\\\s*MB|ExtendedYaleB\\\\.tar\\\\.bz2).{0,100}\\\",\\n\",\"    html,\\n\",\"    flags=re.IGNORECASE\\n\",\")\\n\",\"\\n\",\"print(\\\"Expected archive filename found:\\\", filename_found)\\n\",\"print(\\\"Related metadata excerpts:\\\")\\n\",\"\\n\",\"for excerpt in size_mentions[:10]:\\n\",\"    print(re.sub(r\\\"\\\\s+\\\", \\\" \\\", excerpt).strip())\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Assess acquisition readiness\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[5] ACQUISITION READINESS\\\")\\n\",\"\\n\",\"metadata_available = (\\n\",\"    len(magnet_links) > 0\\n\",\"    or len(info_hashes) > 0\\n\",\"    or any(identifier_matches.values())\\n\",\")\\n\",\"\\n\",\"print(\\\"Listing retrievable:\\\", response.ok)\\n\",\"print(\\\"Expected filename present:\\\", filename_found)\\n\",\"print(\\\"Torrent metadata discovered:\\\", metadata_available)\\n\",\"\\n\",\"if not filename_found:\\n\",\"    decision = \\\"STOP_FILENAME_NOT_CONFIRMED\\\"\\n\",\"elif not metadata_available:\\n\",\"    decision = \\\"INVESTIGATE_TORRENT_METADATA_MANUALLY\\\"\\n\",\"else:\\n\",\"    decision = \\\"METADATA_FOUND_PENDING_MANUAL_REVIEW\\\"\\n\",\"\\n\",\"print(\\\"Decision:\\\", decision)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. Save audit record\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"record = {\\n\",\"    \\\"experiment\\\": 20,\\n\",\"    \\\"step\\\": \\\"2.6.3\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"source_url\\\": source_url,\\n\",\"    \\\"http_status\\\": response.status_code,\\n\",\"    \\\"listing_html_length\\\": len(html),\\n\",\"    \\\"expected_archive_filename_found\\\": filename_found,\\n\",\"    \\\"magnet_link_count\\\": len(magnet_links),\\n\",\"    \\\"magnet_links\\\": magnet_links,\\n\",\"    \\\"info_hashes\\\": list(dict.fromkeys(info_hashes)),\\n\",\"    \\\"identifier_matches\\\": identifier_matches,\\n\",\"    \\\"metadata_excerpts\\\": size_mentions[:10],\\n\",\"    \\\"acquisition_decision\\\": decision,\\n\",\"    \\\"download_performed\\\": False,\\n\",\"    \\\"extraction_performed\\\": False,\\n\",\"    \\\"archive_integrity_verified\\\": False\\n\",\"}\\n\",\"\\n\",\"output_file = (\\n\",\"    audit_dir / \\\"experiment20_yaleb_torrent_metadata_audit.json\\\"\\n\",\")\\n\",\"\\n\",\"with open(output_file, \\\"w\\\", encoding=\\\"utf-8\\\") as file:\\n\",\"    json.dump(record, file, indent=4)\\n\",\"\\n\",\"with open(output_file, \\\"r\\\", encoding=\\\"utf-8\\\") as file:\\n\",\"    verified = json.load(file)\\n\",\"\\n\",\"assert verified[\\\"step\\\"] == \\\"2.6.3\\\"\\n\",\"assert verified[\\\"download_performed\\\"] is False\\n\",\"assert verified[\\\"extraction_performed\\\"] is False\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 2.6.3 — FINAL SUMMARY\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"print(\\\"Audit file:\\\", output_file)\\n\",\"print(\\\"JSON reload verification: PASSED\\\")\\n\",\"print(\\\"Acquisition decision:\\\", verified[\\\"acquisition_decision\\\"])\\n\",\"print(\\\"Download performed: NO\\\")\\n\",\"print(\\\"Extraction performed: NO\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"tRC0RXohbwSX\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794347306740,\"user_tz\":360,\"elapsed\":397,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"760e19cb-3a16-4e90-815d-eacd8cc37e0d\"},\"execution_count\":null,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"===========================================================================\\n\",\"EXPERIMENT 20 — STEP 2.6.3\\n\",\"TORRENT METADATA AND DOWNLOAD-READINESS AUDIT\\n\",\"===========================================================================\\n\",\"\\n\",\"[1] LISTING RETRIEVAL\\n\",\"HTTP status: 200\\n\",\"HTML length: 24491\\n\",\"Final URL: https://academictorrents.com/details/06e479f338b56fa5948c40287b66f68236a14612\\n\",\"\\n\",\"[2] MAGNET LINK INSPECTION\\n\",\"Magnet links found: 1\\n\",\"Info hashes found: 1\\n\",\"\\n\",\"[3] TORRENT IDENTIFIER INSPECTION\\n\",\"Pattern: torrent[_-]?id[\\\\\\\"'\\\\s:=]+([a-zA-Z0-9_-]+)\\n\",\"Matches: []\\n\",\"Pattern: info[_-]?hash[\\\\\\\"'\\\\s:=]+([a-fA-F0-9]{40})\\n\",\"Matches: []\\n\",\"Pattern: urn:btih:([a-fA-F0-9]{40})\\n\",\"Matches: ['06e479f338b56fa5948c40287b66f68236a14612']\\n\",\"\\n\",\"[4] ARCHIVE METADATA INSPECTION\\n\",\"Expected archive filename found: True\\n\",\"Related metadata excerpts:\\n\",\"</span> Download 2.09GB </a>\\n\",\"><img width=\\\"16px\\\" height=\\\"16px\\\" src='/pic/document.png' /> ExtendedYaleB.tar.bz2 </td>\\n\",\"<td align=\\\"right\\\">2.09GB</td>\\n\",\"\\n\",\"[5] ACQUISITION READINESS\\n\",\"Listing retrievable: True\\n\",\"Expected filename present: True\\n\",\"Torrent metadata discovered: True\\n\",\"Decision: METADATA_FOUND_PENDING_MANUAL_REVIEW\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 2.6.3 — FINAL SUMMARY\\n\",\"===========================================================================\\n\",\"Audit file: /content/drive/MyDrive/Experiment_20_Results/dataset_audit/experiment20_yaleb_torrent_metadata_audit.json\\n\",\"JSON reload verification: PASSED\\n\",\"Acquisition decision: METADATA_FOUND_PENDING_MANUAL_REVIEW\\n\",\"Download performed: NO\\n\",\"Extraction performed: NO\\n\",\"===========================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"\\n\",\"## Experiment 20 — Step 2.6.4\\n\",\"### Controlled Acquisition Environment Readiness\\n\",\"\\n\",\"**Objective**\\n\",\"\\n\",\"Check whether the Colab environment has the tools and storage required to acquire the Extended Yale Face Database B archive through its verified candidate torrent metadata.\\n\",\"\\n\",\"**Requirements**\\n\",\"\\n\",\"1. Check whether aria2 is installed.\\n\",\"2. Check whether bzip2 and tar are available.\\n\",\"3. Verify free disk space.\\n\",\"4. Verify the Experiment 20 dataset storage directory.\\n\",\"5. Record the torrent info hash and expected archive filename.\\n\",\"\\n\",\"**Constraints**\\n\",\"\\n\",\"- Do not start the download in this step.\\n\",\"- Do not extract or modify any existing dataset.\\n\",\"- Do not use an unverified archive URL.\\n\",\"- Keep the downloaded archive separate from extracted images.\\n\",\"\\n\",\"**Expected outcome**\\n\",\"\\n\",\"A documented acquisition-environment readiness report.\\n\"],\"metadata\":{\"id\":\"EdIBeNR7cD8A\"}},{\"cell_type\":\"code\",\"source\":[\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 20 — STEP 2.6.4\\n\",\"# CONTROLLED ACQUISITION ENVIRONMENT READINESS\\n\",\"# ============================================================\\n\",\"\\n\",\"from pathlib import Path\\n\",\"import shutil\\n\",\"import subprocess\\n\",\"import json\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Define acquisition configuration\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"info_hash = \\\"06e479f338b56fa5948c40287b66f68236a14612\\\"\\n\",\"archive_name = \\\"ExtendedYaleB.tar.bz2\\\"\\n\",\"\\n\",\"experiment_dir = Path(\\n\",\"    \\\"/content/drive/MyDrive/Experiment_20_Results\\\"\\n\",\")\\n\",\"\\n\",\"download_dir = experiment_dir / \\\"dataset_downloads\\\"\\n\",\"extraction_dir = experiment_dir / \\\"datasets\\\" / \\\"ExtendedYaleB\\\"\\n\",\"audit_dir = experiment_dir / \\\"dataset_audit\\\"\\n\",\"\\n\",\"download_dir.mkdir(parents=True, exist_ok=True)\\n\",\"extraction_dir.mkdir(parents=True, exist_ok=True)\\n\",\"audit_dir.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 2.6.4\\\")\\n\",\"print(\\\"CONTROLLED ACQUISITION ENVIRONMENT READINESS\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Check required command-line tools\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[1] TOOL AVAILABILITY\\\")\\n\",\"\\n\",\"tool_status = {}\\n\",\"\\n\",\"for tool in [\\\"aria2c\\\", \\\"bzip2\\\", \\\"tar\\\"]:\\n\",\"\\n\",\"    executable = shutil.which(tool)\\n\",\"    tool_status[tool] = executable\\n\",\"\\n\",\"    print(\\n\",\"        f\\\"{tool}:\\\",\\n\",\"        executable if executable else \\\"NOT INSTALLED\\\"\\n\",\"    )\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Check storage capacity\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[2] STORAGE CAPACITY\\\")\\n\",\"\\n\",\"disk = shutil.disk_usage(\\\"/content\\\")\\n\",\"\\n\",\"storage_status = {\\n\",\"    \\\"total_gb\\\": round(disk.total / 1e9, 2),\\n\",\"    \\\"used_gb\\\": round(disk.used / 1e9, 2),\\n\",\"    \\\"free_gb\\\": round(disk.free / 1e9, 2)\\n\",\"}\\n\",\"\\n\",\"for key, value in storage_status.items():\\n\",\"    print(f\\\"{key}: {value}\\\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Check directory availability\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[3] DATASET DIRECTORIES\\\")\\n\",\"\\n\",\"directory_status = {}\\n\",\"\\n\",\"for name, path in [\\n\",\"    (\\\"Download directory\\\", download_dir),\\n\",\"    (\\\"Extraction directory\\\", extraction_dir),\\n\",\"    (\\\"Audit directory\\\", audit_dir)\\n\",\"]:\\n\",\"\\n\",\"    directory_status[name] = {\\n\",\"        \\\"path\\\": str(path),\\n\",\"        \\\"exists\\\": path.exists(),\\n\",\"        \\\"writable\\\": path.exists()\\n\",\"    }\\n\",\"\\n\",\"    print(name, \\\":\\\", path)\\n\",\"    print(\\\"Exists:\\\", path.exists())\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Check whether the archive already exists\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[4] EXISTING ARCHIVE CHECK\\\")\\n\",\"\\n\",\"archive_path = download_dir / archive_name\\n\",\"\\n\",\"archive_exists = archive_path.exists()\\n\",\"\\n\",\"archive_size = (\\n\",\"    archive_path.stat().st_size\\n\",\"    if archive_exists\\n\",\"    else 0\\n\",\")\\n\",\"\\n\",\"print(\\\"Archive exists:\\\", archive_exists)\\n\",\"print(\\\"Archive size (bytes):\\\", archive_size)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. Determine acquisition readiness\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"aria2_available = tool_status[\\\"aria2c\\\"] is not None\\n\",\"\\n\",\"storage_sufficient = disk.free >= 10 * 1e9\\n\",\"\\n\",\"acquisition_ready = (\\n\",\"    aria2_available\\n\",\"    and storage_sufficient\\n\",\"    and all(\\n\",\"        item[\\\"exists\\\"]\\n\",\"        for item in directory_status.values()\\n\",\"    )\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n[5] ACQUISITION READINESS\\\")\\n\",\"\\n\",\"print(\\\"aria2 available:\\\", aria2_available)\\n\",\"print(\\\"Storage sufficient:\\\", storage_sufficient)\\n\",\"print(\\\"Directories available:\\\", all(\\n\",\"    item[\\\"exists\\\"]\\n\",\"    for item in directory_status.values()\\n\",\"))\\n\",\"\\n\",\"print(\\\"Acquisition environment ready:\\\", acquisition_ready)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. Save environment audit\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"record = {\\n\",\"    \\\"experiment\\\": 20,\\n\",\"    \\\"step\\\": \\\"2.6.4\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"torrent_info_hash\\\": info_hash,\\n\",\"    \\\"archive_filename\\\": archive_name,\\n\",\"    \\\"tool_status\\\": tool_status,\\n\",\"    \\\"storage\\\": storage_status,\\n\",\"    \\\"directories\\\": directory_status,\\n\",\"    \\\"existing_archive\\\": {\\n\",\"        \\\"exists\\\": archive_exists,\\n\",\"        \\\"size_bytes\\\": archive_size\\n\",\"    },\\n\",\"    \\\"acquisition_environment_ready\\\": acquisition_ready,\\n\",\"    \\\"download_started\\\": False,\\n\",\"    \\\"extraction_started\\\": False\\n\",\"}\\n\",\"\\n\",\"output_file = (\\n\",\"    audit_dir / \\\"experiment20_acquisition_environment_audit.json\\\"\\n\",\")\\n\",\"\\n\",\"with open(output_file, \\\"w\\\", encoding=\\\"utf-8\\\") as file:\\n\",\"    json.dump(record, file, indent=4)\\n\",\"\\n\",\"with open(output_file, \\\"r\\\", encoding=\\\"utf-8\\\") as file:\\n\",\"    verified = json.load(file)\\n\",\"\\n\",\"assert verified[\\\"step\\\"] == \\\"2.6.4\\\"\\n\",\"assert verified[\\\"download_started\\\"] is False\\n\",\"assert verified[\\\"extraction_started\\\"] is False\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 2.6.4 — FINAL SUMMARY\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"print(\\\"Audit record:\\\", output_file)\\n\",\"print(\\\"JSON verification: PASSED\\\")\\n\",\"print(\\\"Acquisition ready:\\\", acquisition_ready)\\n\",\"print(\\\"Download performed: NO\\\")\\n\",\"print(\\\"Extraction performed: NO\\\")\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"5PbbefyocFxU\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794347394269,\"user_tz\":360,\"elapsed\":89,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"c1ac3cb3-767a-4a96-d2aa-e864e520b02a\"},\"execution_count\":null,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"===========================================================================\\n\",\"EXPERIMENT 20 — STEP 2.6.4\\n\",\"CONTROLLED ACQUISITION ENVIRONMENT READINESS\\n\",\"===========================================================================\\n\",\"\\n\",\"[1] TOOL AVAILABILITY\\n\",\"aria2c: NOT INSTALLED\\n\",\"bzip2: /usr/bin/bzip2\\n\",\"tar: /usr/bin/tar\\n\",\"\\n\",\"[2] STORAGE CAPACITY\\n\",\"total_gb: 115.66\\n\",\"used_gb: 0.11\\n\",\"free_gb: 115.53\\n\",\"\\n\",\"[3] DATASET DIRECTORIES\\n\",\"Download directory : /content/drive/MyDrive/Experiment_20_Results/dataset_downloads\\n\",\"Exists: True\\n\",\"Extraction directory : /content/drive/MyDrive/Experiment_20_Results/datasets/ExtendedYaleB\\n\",\"Exists: True\\n\",\"Audit directory : /content/drive/MyDrive/Experiment_20_Results/dataset_audit\\n\",\"Exists: True\\n\",\"\\n\",\"[4] EXISTING ARCHIVE CHECK\\n\",\"Archive exists: False\\n\",\"Archive size (bytes): 0\\n\",\"\\n\",\"[5] ACQUISITION READINESS\\n\",\"aria2 available: False\\n\",\"Storage sufficient: True\\n\",\"Directories available: True\\n\",\"Acquisition environment ready: False\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 2.6.4 — FINAL SUMMARY\\n\",\"===========================================================================\\n\",\"Audit record: /content/drive/MyDrive/Experiment_20_Results/dataset_audit/experiment20_acquisition_environment_audit.json\\n\",\"JSON verification: PASSED\\n\",\"Acquisition ready: False\\n\",\"Download performed: NO\\n\",\"Extraction performed: NO\\n\",\"===========================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"\\n\",\"## Experiment 20 — Step 2.6.5\\n\",\"### Install and Verify aria2 Acquisition Utility\\n\",\"\\n\",\"**Objective**\\n\",\"\\n\",\"Install aria2 in the Colab environment to enable controlled BitTorrent acquisition of the candidate Extended Yale B archive.\\n\",\"\\n\",\"**Actions**\\n\",\"\\n\",\"1. Update the package index.\\n\",\"2. Install aria2.\\n\",\"3. Verify the aria2 executable.\\n\",\"4. Record the installed version.\\n\",\"5. Save the installation audit.\\n\",\"\\n\",\"**Constraints**\\n\",\"\\n\",\"- Do not start the torrent download.\\n\",\"- Do not extract any archive.\\n\",\"- Do not modify Experiment 18 files.\\n\",\"- Keep the acquisition utility separate from the research dataset.\\n\"],\"metadata\":{\"id\":\"lB1VsYGqcPae\"}},{\"cell_type\":\"code\",\"source\":[\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 20 — STEP 2.6.5\\n\",\"# INSTALL AND VERIFY ARIA2\\n\",\"# ============================================================\\n\",\"\\n\",\"from pathlib import Path\\n\",\"import subprocess\\n\",\"import shutil\\n\",\"import json\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"audit_dir = Path(\\n\",\"    \\\"/content/drive/MyDrive/Experiment_20_Results/\\\"\\n\",\"    \\\"dataset_audit\\\"\\n\",\")\\n\",\"audit_dir.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 2.6.5\\\")\\n\",\"print(\\\"INSTALL AND VERIFY ARIA2\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Update package index\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[1] UPDATING PACKAGE INDEX\\\")\\n\",\"\\n\",\"update_result = subprocess.run(\\n\",\"    [\\\"apt-get\\\", \\\"update\\\", \\\"-qq\\\"],\\n\",\"    capture_output=True,\\n\",\"    text=True\\n\",\")\\n\",\"\\n\",\"print(\\\"Return code:\\\", update_result.returncode)\\n\",\"\\n\",\"if update_result.returncode != 0:\\n\",\"    print(update_result.stderr[-3000:])\\n\",\"    raise RuntimeError(\\\"Package index update failed.\\\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Install aria2\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[2] INSTALLING ARIA2\\\")\\n\",\"\\n\",\"install_result = subprocess.run(\\n\",\"    [\\\"apt-get\\\", \\\"install\\\", \\\"-y\\\", \\\"-qq\\\", \\\"aria2\\\"],\\n\",\"    capture_output=True,\\n\",\"    text=True\\n\",\")\\n\",\"\\n\",\"print(\\\"Return code:\\\", install_result.returncode)\\n\",\"\\n\",\"if install_result.returncode != 0:\\n\",\"    print(install_result.stderr[-3000:])\\n\",\"    raise RuntimeError(\\\"aria2 installation failed.\\\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Verify executable\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[3] VERIFYING ARIA2\\\")\\n\",\"\\n\",\"aria2_path = shutil.which(\\\"aria2c\\\")\\n\",\"\\n\",\"assert aria2_path is not None, \\\"aria2c executable not found.\\\"\\n\",\"\\n\",\"version_result = subprocess.run(\\n\",\"    [\\\"aria2c\\\", \\\"--version\\\"],\\n\",\"    capture_output=True,\\n\",\"    text=True,\\n\",\"    check=True\\n\",\")\\n\",\"\\n\",\"version_line = version_result.stdout.splitlines()[0]\\n\",\"\\n\",\"print(\\\"Executable:\\\", aria2_path)\\n\",\"print(\\\"Version:\\\", version_line)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Save installation audit\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"record = {\\n\",\"    \\\"experiment\\\": 20,\\n\",\"    \\\"step\\\": \\\"2.6.5\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"package\\\": \\\"aria2\\\",\\n\",\"    \\\"executable\\\": aria2_path,\\n\",\"    \\\"version\\\": version_line,\\n\",\"    \\\"installation_successful\\\": True,\\n\",\"    \\\"torrent_download_started\\\": False,\\n\",\"    \\\"archive_extraction_started\\\": False\\n\",\"}\\n\",\"\\n\",\"output_file = audit_dir / \\\"experiment20_aria2_installation_audit.json\\\"\\n\",\"\\n\",\"with open(output_file, \\\"w\\\", encoding=\\\"utf-8\\\") as file:\\n\",\"    json.dump(record, file, indent=4)\\n\",\"\\n\",\"with open(output_file, \\\"r\\\", encoding=\\\"utf-8\\\") as file:\\n\",\"    verified = json.load(file)\\n\",\"\\n\",\"assert verified[\\\"installation_successful\\\"] is True\\n\",\"assert verified[\\\"torrent_download_started\\\"] is False\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 2.6.5 — FINAL SUMMARY\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"print(\\\"aria2 installed:\\\", aria2_path is not None)\\n\",\"print(\\\"Installation audit:\\\", output_file)\\n\",\"print(\\\"JSON verification: PASSED\\\")\\n\",\"print(\\\"Torrent download started: NO\\\")\\n\",\"print(\\\"Archive extraction started: NO\\\")\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"v5p-6vyKcRpx\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794347466229,\"user_tz\":360,\"elapsed\":22784,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"ac60ed64-0cd6-400b-cd6e-ea228c92d4af\"},\"execution_count\":null,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"===========================================================================\\n\",\"EXPERIMENT 20 — STEP 2.6.5\\n\",\"INSTALL AND VERIFY ARIA2\\n\",\"===========================================================================\\n\",\"\\n\",\"[1] UPDATING PACKAGE INDEX\\n\",\"Return code: 0\\n\",\"\\n\",\"[2] INSTALLING ARIA2\\n\",\"Return code: 0\\n\",\"\\n\",\"[3] VERIFYING ARIA2\\n\",\"Executable: /usr/bin/aria2c\\n\",\"Version: aria2 version 1.37.0\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 2.6.5 — FINAL SUMMARY\\n\",\"===========================================================================\\n\",\"aria2 installed: True\\n\",\"Installation audit: /content/drive/MyDrive/Experiment_20_Results/dataset_audit/experiment20_aria2_installation_audit.json\\n\",\"JSON verification: PASSED\\n\",\"Torrent download started: NO\\n\",\"Archive extraction started: NO\\n\",\"===========================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"## EXPERIMENT 20 — STEP 2.6.6: CONTROLLED CROPPED YALE B ACQUISITION\\n\",\"\\n\",\"Acquire the Cropped Extended Yale Face Database B using its verified\\n\",\"Academic Torrents metadata file.\\n\",\"\\n\",\"Controls:\\n\",\"- Expected archive size: approximately 58.49 MB.\\n\",\"- Download the torrent metadata separately.\\n\",\"- Use aria2 with live progress output.\\n\",\"- Maximum transfer time: 10 minutes.\\n\",\"- No automatic retry.\\n\",\"- Preserve partial files if acquisition fails.\\n\",\"- Verify archive size, SHA256, and ZIP integrity.\\n\",\"\\n\",\"Dataset acceptance remains pending content and provenance validation.\"],\"metadata\":{\"id\":\"Gm06L76kcn89\"}},{\"cell_type\":\"code\",\"source\":[\"import os\\n\",\"import time\\n\",\"import json\\n\",\"import hashlib\\n\",\"import zipfile\\n\",\"import subprocess\\n\",\"import requests\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# CONFIGURATION\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"BASE_DIR = \\\"/content/Experiment20_Downloads\\\"\\n\",\"ARCHIVE_NAME = \\\"CroppedYale.zip\\\"\\n\",\"ARCHIVE_PATH = os.path.join(BASE_DIR, ARCHIVE_NAME)\\n\",\"\\n\",\"TORRENT_URL = (\\n\",\"    \\\"https://academictorrents.com/download/\\\"\\n\",\"    \\\"aad8bf8e6ee5d8a3bf46c7ab5adfacdd8ad36247.torrent\\\"\\n\",\")\\n\",\"\\n\",\"TORRENT_PATH = os.path.join(BASE_DIR, \\\"CroppedYale.torrent\\\")\\n\",\"\\n\",\"AUDIT_DIR = (\\n\",\"    \\\"/content/drive/MyDrive/Experiment_20_Results/dataset_audit\\\"\\n\",\")\\n\",\"\\n\",\"TIMEOUT_SECONDS = 600\\n\",\"\\n\",\"os.makedirs(BASE_DIR, exist_ok=True)\\n\",\"os.makedirs(AUDIT_DIR, exist_ok=True)\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 2.6.6: TORRENT-BASED ACQUISITION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 1. PREFLIGHT\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"if not os.path.isfile(\\\"/usr/bin/aria2c\\\"):\\n\",\"    raise RuntimeError(\\\"aria2c is not installed.\\\")\\n\",\"\\n\",\"if os.path.exists(ARCHIVE_PATH):\\n\",\"    raise FileExistsError(\\n\",\"        f\\\"Archive already exists: {ARCHIVE_PATH}. \\\"\\n\",\"        \\\"No overwrite performed.\\\"\\n\",\"    )\\n\",\"\\n\",\"if os.path.exists(TORRENT_PATH):\\n\",\"    raise FileExistsError(\\n\",\"        f\\\"Torrent metadata already exists: {TORRENT_PATH}. \\\"\\n\",\"        \\\"No overwrite performed.\\\"\\n\",\"    )\\n\",\"\\n\",\"print(\\\"\\\\n[1] PREFLIGHT PASSED\\\")\\n\",\"print(\\\"aria2:\\\", \\\"/usr/bin/aria2c\\\")\\n\",\"print(\\\"Destination:\\\", ARCHIVE_PATH)\\n\",\"print(\\\"Timeout:\\\", TIMEOUT_SECONDS, \\\"seconds\\\")\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 2. DOWNLOAD TORRENT METADATA\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[2] DOWNLOADING TORRENT METADATA\\\")\\n\",\"\\n\",\"response = requests.get(\\n\",\"    TORRENT_URL,\\n\",\"    timeout=(20, 60),\\n\",\"    headers={\\\"User-Agent\\\": \\\"Mozilla/5.0\\\"}\\n\",\")\\n\",\"response.raise_for_status()\\n\",\"\\n\",\"torrent_bytes = response.content\\n\",\"\\n\",\"if not torrent_bytes.startswith(b\\\"d\\\"):\\n\",\"    raise RuntimeError(\\n\",\"        \\\"Downloaded response does not appear to be valid \\\"\\n\",\"        \\\"BitTorrent metadata.\\\"\\n\",\"    )\\n\",\"\\n\",\"with open(TORRENT_PATH, \\\"xb\\\") as f:\\n\",\"    f.write(torrent_bytes)\\n\",\"\\n\",\"print(\\\"Torrent metadata saved.\\\")\\n\",\"print(\\\"Metadata size:\\\", len(torrent_bytes), \\\"bytes\\\")\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 3. START ARIA2 WITH LIVE OUTPUT\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[3] STARTING CONTROLLED DOWNLOAD\\\")\\n\",\"\\n\",\"command = [\\n\",\"    \\\"/usr/bin/aria2c\\\",\\n\",\"    \\\"--dir\\\", BASE_DIR,\\n\",\"    \\\"--out\\\", ARCHIVE_NAME,\\n\",\"    \\\"--continue=true\\\",\\n\",\"    \\\"--allow-overwrite=false\\\",\\n\",\"    \\\"--auto-file-renaming=false\\\",\\n\",\"    \\\"--file-allocation=none\\\",\\n\",\"    \\\"--enable-dht=true\\\",\\n\",\"    \\\"--enable-peer-exchange=true\\\",\\n\",\"    \\\"--bt-enable-lpd=true\\\",\\n\",\"    \\\"--bt-max-peers=100\\\",\\n\",\"    \\\"--seed-time=0\\\",\\n\",\"    \\\"--summary-interval=5\\\",\\n\",\"    \\\"--console-log-level=notice\\\",\\n\",\"    \\\"--show-console-readout=true\\\",\\n\",\"    \\\"--download-result=full\\\",\\n\",\"    TORRENT_PATH\\n\",\"]\\n\",\"\\n\",\"start_time = time.time()\\n\",\"\\n\",\"process = subprocess.Popen(\\n\",\"    command,\\n\",\"    stdout=subprocess.PIPE,\\n\",\"    stderr=subprocess.STDOUT,\\n\",\"    text=True,\\n\",\"    bufsize=1\\n\",\")\\n\",\"\\n\",\"try:\\n\",\"    while True:\\n\",\"        if time.time() - start_time > TIMEOUT_SECONDS:\\n\",\"            process.kill()\\n\",\"            process.wait()\\n\",\"            raise TimeoutError(\\n\",\"                \\\"The 10-minute acquisition limit was reached.\\\"\\n\",\"            )\\n\",\"\\n\",\"        line = process.stdout.readline()\\n\",\"\\n\",\"        if line:\\n\",\"            print(line.rstrip())\\n\",\"\\n\",\"        if process.poll() is not None:\\n\",\"            remaining = process.stdout.read()\\n\",\"            if remaining:\\n\",\"                print(remaining.rstrip())\\n\",\"            break\\n\",\"\\n\",\"        time.sleep(0.1)\\n\",\"\\n\",\"    return_code = process.returncode\\n\",\"\\n\",\"    if return_code != 0:\\n\",\"        raise RuntimeError(\\n\",\"            f\\\"aria2 exited with return code {return_code}.\\\"\\n\",\"        )\\n\",\"\\n\",\"except Exception as exc:\\n\",\"    if process.poll() is None:\\n\",\"        process.kill()\\n\",\"        process.wait()\\n\",\"\\n\",\"    print(\\\"\\\\nACQUISITION FAILED:\\\", repr(exc))\\n\",\"    print(\\\"Partial archive preserved if created.\\\")\\n\",\"    raise\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 4. VERIFY ARCHIVE\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[4] VERIFYING DOWNLOADED ARCHIVE\\\")\\n\",\"\\n\",\"if not os.path.isfile(ARCHIVE_PATH):\\n\",\"    raise RuntimeError(\\\"aria2 finished but archive is missing.\\\")\\n\",\"\\n\",\"archive_size = os.path.getsize(ARCHIVE_PATH)\\n\",\"\\n\",\"if archive_size < 1_000_000:\\n\",\"    raise RuntimeError(\\n\",\"        f\\\"Archive is unexpectedly small: {archive_size} bytes.\\\"\\n\",\"    )\\n\",\"\\n\",\"sha256 = hashlib.sha256()\\n\",\"\\n\",\"with open(ARCHIVE_PATH, \\\"rb\\\") as f:\\n\",\"    for block in iter(lambda: f.read(4 * 1024 * 1024), b\\\"\\\"):\\n\",\"        sha256.update(block)\\n\",\"\\n\",\"zip_valid = False\\n\",\"\\n\",\"with zipfile.ZipFile(ARCHIVE_PATH, \\\"r\\\") as archive:\\n\",\"    bad_member = archive.testzip()\\n\",\"    zip_valid = bad_member is None\\n\",\"    member_count = len(archive.namelist())\\n\",\"    sample_members = archive.namelist()[:10]\\n\",\"\\n\",\"print(\\\"Archive size:\\\", round(archive_size / (1024 ** 2), 2), \\\"MB\\\")\\n\",\"print(\\\"SHA256:\\\", sha256.hexdigest())\\n\",\"print(\\\"ZIP integrity:\\\", zip_valid)\\n\",\"print(\\\"ZIP members:\\\", member_count)\\n\",\"print(\\\"Sample contents:\\\", sample_members)\\n\",\"\\n\",\"if not zip_valid:\\n\",\"    raise RuntimeError(\\\"ZIP integrity validation failed.\\\")\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 5. SAVE ACQUISITION RECORD\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"record = {\\n\",\"    \\\"step\\\": \\\"2.6.6\\\",\\n\",\"    \\\"dataset\\\": \\\"Cropped Extended Yale Face Database B\\\",\\n\",\"    \\\"source\\\": TORRENT_URL,\\n\",\"    \\\"archive_path\\\": ARCHIVE_PATH,\\n\",\"    \\\"archive_size_bytes\\\": archive_size,\\n\",\"    \\\"sha256\\\": sha256.hexdigest(),\\n\",\"    \\\"zip_integrity_passed\\\": zip_valid,\\n\",\"    \\\"zip_member_count\\\": member_count,\\n\",\"    \\\"duration_seconds\\\": round(time.time() - start_time, 2),\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"acceptance_status\\\": \\\"PENDING_CONTENT_AND_PROVENANCE_AUDIT\\\"\\n\",\"}\\n\",\"\\n\",\"audit_path = os.path.join(\\n\",\"    AUDIT_DIR,\\n\",\"    \\\"experiment20_croppedyale_acquisition_record.json\\\"\\n\",\")\\n\",\"\\n\",\"with open(audit_path, \\\"w\\\") as f:\\n\",\"    json.dump(record, f, indent=2)\\n\",\"\\n\",\"print(\\\"\\\\n[5] ACQUISITION RECORD SAVED\\\")\\n\",\"print(audit_path)\\n\",\"\\n\",\"print(\\\"\\\\nSTEP 2.6.6 ACQUISITION FINISHED.\\\")\\n\",\"print(\\\"Do not extract or generate embeddings yet.\\\")\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"dgI1SM-Dcqb8\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794351007391,\"user_tz\":360,\"elapsed\":8952,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"8136da93-1afa-4722-8959-d8a02f1936f9\"},\"execution_count\":null,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"===========================================================================\\n\",\"EXPERIMENT 20 — STEP 2.6.6: TORRENT-BASED ACQUISITION\\n\",\"===========================================================================\\n\",\"\\n\",\"[1] PREFLIGHT PASSED\\n\",\"aria2: /usr/bin/aria2c\\n\",\"Destination: /content/Experiment20_Downloads/CroppedYale.zip\\n\",\"Timeout: 600 seconds\\n\",\"\\n\",\"[2] DOWNLOADING TORRENT METADATA\\n\",\"Torrent metadata saved.\\n\",\"Metadata size: 5153 bytes\\n\",\"\\n\",\"[3] STARTING CONTROLLED DOWNLOAD\\n\",\"\\n\",\"11/10 22:55:38 [\\u001b[1;32mNOTICE\\u001b[0m] Downloading 1 item(s)\\n\",\"\\n\",\"11/10 22:55:38 [\\u001b[1;32mNOTICE\\u001b[0m] IPv4 DHT: listening on UDP port 6987\\n\",\"\\n\",\"11/10 22:55:38 [\\u001b[1;32mNOTICE\\u001b[0m] IPv4 BitTorrent: listening on TCP port 6912\\n\",\"\\n\",\"11/10 22:55:38 [\\u001b[1;31mERROR\\u001b[0m] IPv6 BitTorrent: failed to bind TCP port 6912\\n\",\"Exception: [SocketCore.cc:312] errorC