      "source": [
        "# Experiment 20 — Step 3.1.4: Original Embedding Metadata and Configuration Audit\n",
        "\n",
        "## Objective\n",
        "Inspect the original JSON metadata, embedding-generation configuration, and preprocessing audits.\n",
        "\n",
        "## Evidence sources\n",
        "1. experiment20_croppedyale_embedding_metadata.json\n",
        "2. experiment20_embedding_generation_config.json\n",
        "3. experiment20_facenet_preprocessing_compatibility_audit.json\n",
        "4. experiment20_preprocessing_consistency_audit.json\n",
        "5. experiment20_embedding_checkpoint_metadata.json\n",
        "\n",
        "## Verification\n",
        "- Original embedding metadata.\n",
        "- FaceNet model and checkpoint configuration.\n",
        "- Image preprocessing operations.\n",
        "- Input dimensions and tensor conversion.\n",
        "- Model inference configuration.\n",
        "- Consistency between metadata and the NPZ archive.\n",
        "\n",
        "## Restrictions\n",
        "- Read-only inspection.\n",
        "- Do not generate replacement metadata.\n",
        "- Do not regenerate embeddings.\n",
        "- Do not modify frozen artifacts."
      ],
      "metadata": {
        "id": "motkIZ8Ztb7C"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from pathlib import Path\n",
        "import json\n",
        "import numpy as np\n",
        "\n",
        "BASE = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "\n",
        "FILES = {\n",
        "    \"embedding_metadata\": BASE / \"embeddings/experiment20_croppedyale_embedding_metadata.json\",\n",
        "    \"generation_config\": BASE / \"embeddings/experiment20_embedding_generation_config.json\",\n",
        "    \"preprocessing_compatibility\": BASE / \"dataset_audit/experiment20_facenet_preprocessing_compatibility_audit.json\",\n",
        "    \"preprocessing_consistency\": BASE / \"dataset_audit/experiment20_preprocessing_consistency_audit.json\",\n",
        "    \"checkpoint_metadata\": BASE / \"embeddings/checkpoints/experiment20_embedding_checkpoint_metadata.json\"\n",
        "}\n",
        "\n",
        "NPZ_FILE = (\n",
        "    BASE / \"embeddings/experiment20_croppedyale_facenet_embeddings.npz\"\n",
        ")\n",
        "\n",
        "print(\"=\" * 100)\n",
        "print(\"EXPERIMENT 20 — ORIGINAL METADATA AND CONFIGURATION AUDIT\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "documents = {}\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 1. Load available JSON documents\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "for name, path in FILES.items():\n",
        "\n",
        "    print(\"\\n\" + \"-\" * 100)\n",
        "    print(f\"DOCUMENT: {name}\")\n",
        "    print(f\"PATH: {path}\")\n",
        "\n",
        "    if not path.exists():\n",
        "        print(\"STATUS: NOT FOUND\")\n",
        "        continue\n",
        "\n",
        "    with path.open(\"r\", encoding=\"utf-8\") as f:\n",
        "        data = json.load(f)\n",
        "\n",
        "    documents[name] = data\n",
        "\n",
        "    print(\"STATUS: LOADED\")\n",
        "    print(json.dumps(data, indent=2, ensure_ascii=False, default=str)[:18000])\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 2. Inspect NPZ archive metadata\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"NPZ ARCHIVE CONSISTENCY\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "with np.load(NPZ_FILE, allow_pickle=False) as archive:\n",
        "\n",
        "    required_arrays = [\n",
        "        \"embeddings\",\n",
        "        \"filenames\",\n",
        "        \"subjects\",\n",
        "        \"subject_numbers\",\n",
        "        \"azimuths\",\n",
        "        \"elevations\",\n",
        "        \"conditions\"\n",
        "    ]\n",
        "\n",
        "    missing_arrays = [\n",
        "        key for key in required_arrays\n",
        "        if key not in archive.files\n",
        "    ]\n",
        "\n",
        "    if missing_arrays:\n",
        "        raise ValueError(f\"Missing NPZ arrays: {missing_arrays}\")\n",
        "\n",
        "    embeddings = archive[\"embeddings\"]\n",
        "    filenames = archive[\"filenames\"]\n",
        "    subjects = archive[\"subjects\"]\n",
        "    conditions = archive[\"conditions\"]\n",
        "    azimuths = archive[\"azimuths\"]\n",
        "    elevations = archive[\"elevations\"]\n",
        "\n",
        "    print(f\"Embedding shape: {embeddings.shape}\")\n",
        "    print(f\"Filename count: {len(filenames)}\")\n",
        "    print(f\"Subject count: {len(subjects)}\")\n",
        "    print(f\"Unique subjects: {len(np.unique(subjects))}\")\n",
        "    print(f\"Condition count: {len(conditions)}\")\n",
        "    print(f\"Unique conditions: {len(np.unique(conditions))}\")\n",
        "\n",
        "    aligned = all(\n",
        "        len(array) == len(embeddings)\n",
        "        for array in [\n",
        "            filenames,\n",
        "            subjects,\n",
        "            conditions,\n",
        "            azimuths,\n",
        "            elevations\n",
        "        ]\n",
        "    )\n",
        "\n",
        "    print(f\"All metadata arrays align with embeddings: {aligned}\")\n",
        "\n",
        "    print(\"\\nFirst five records:\")\n",
        "\n",
        "    for i in range(5):\n",
        "        print({\n",
        "            \"filename\": str(filenames[i]),\n",
        "            \"subject\": str(subjects[i]),\n",
        "            \"condition\": str(conditions[i]),\n",
        "            \"azimuth\": int(azimuths[i]),\n",
        "            \"elevation\": int(elevations[i])\n",
        "        })\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 3. Summarize available evidence\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"EVIDENCE AVAILABILITY\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "for name in FILES:\n",
        "    print(\n",
        "        f\"{name}: \"\n",
        "        f\"{'AVAILABLE' if name in documents else 'UNAVAILABLE'}\"\n",
        "    )\n",
        "\n",
        "print(\"\\nNo files were created, modified, or overwritten.\")\n",
        "print(\"No embeddings were regenerated.\")\n",
        "print(\"END OF STEP 3.1.4 METADATA AUDIT\")\n",
        "print(\"=\" * 100)"
      ],
