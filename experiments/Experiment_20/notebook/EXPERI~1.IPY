    {
      "cell_type": "code",
      "source": [
        "\n",
        "from pathlib import Path\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import json\n",
        "import hashlib\n",
        "\n",
        "BASE = Path(\n",
        "    \"/content/drive/MyDrive/Experiment_20_Results/step_2_7/final_freeze\"\n",
        ")\n",
        "\n",
        "FILE = BASE / \"experiment20_paired_comparison_results.csv\"\n",
        "\n",
        "if not FILE.exists():\n",
        "    raise FileNotFoundError(FILE)\n",
        "\n",
        "df = pd.read_csv(FILE)\n",
        "\n",
        "required = [\n",
        "    \"metric\",\n",
        "    \"group_a\",\n",
        "    \"group_b\",\n",
        "    \"raw_p_value\",\n",
        "    \"holm_adjusted_p_value\"\n",
        "]\n",
        "\n",
        "missing = [c for c in required if c not in df.columns]\n",
        "if missing:\n",
        "    raise KeyError(f\"Missing required columns: {missing}\")\n",
        "\n",
        "if len(df) != 6:\n",
        "    raise ValueError(f\"Expected 6 pairwise comparisons, found {len(df)}\")\n",
        "\n",
        "def holm_adjust(p_values):\n",
        "    \"\"\"\n",
        "    Calculate Holm-adjusted p-values and return them\n",
        "    in the original input order.\n",
        "    \"\"\"\n",
        "    p = np.asarray(p_values, dtype=float)\n",
        "\n",
        "    if np.any(~np.isfinite(p)):\n",
        "        raise ValueError(\"Non-finite raw p-values detected.\")\n",
        "\n",
        "    if np.any((p < 0) | (p > 1)):\n",
        "        raise ValueError(\"Raw p-values must be between 0 and 1.\")\n",
        "\n",
        "    n = len(p)\n",
        "    order = np.argsort(p, kind=\"mergesort\")\n",
        "    sorted_p = p[order]\n",
        "\n",
        "    multipliers = n - np.arange(n)\n",
        "    adjusted_sorted = sorted_p * multipliers\n",
        "    adjusted_sorted = np.maximum.accumulate(adjusted_sorted)\n",
        "    adjusted_sorted = np.minimum(adjusted_sorted, 1.0)\n",
        "\n",
        "    adjusted = np.empty(n, dtype=float)\n",
        "    adjusted[order] = adjusted_sorted\n",
        "\n",
        "    return adjusted\n",
        "\n",
        "print(\"=\" * 100)\n",
        "print(\"EXPERIMENT 20 — STEP 3.3.16 HOLM CORRECTION FAMILY VERIFICATION\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "print(\"\\n1. RAW P-VALUES\")\n",
        "print(\"-\" * 100)\n",
        "\n",
        "print(df[[\"metric\", \"group_a\", \"group_b\", \"raw_p_value\"]].to_string(index=False))\n",
        "\n",
        "raw = df[\"raw_p_value\"].to_numpy(dtype=float)\n",
        "frozen = df[\"holm_adjusted_p_value\"].to_numpy(dtype=float)\n",
        "\n",
        "# Scenario A: One correction family containing all six comparisons.\n",
        "six_test_adjusted = holm_adjust(raw)\n",
        "\n",
        "# Scenario B: Separate correction families for each metric.\n",
        "three_test_adjusted = np.empty(len(df), dtype=float)\n",
        "\n",
        "for metric in df[\"metric\"].unique():\n",
        "    mask = df[\"metric\"].eq(metric).to_numpy()\n",
        "    three_test_adjusted[mask] = holm_adjust(raw[mask])\n",
        "\n",
        "print(\"\\n2. COMPARISON OF CORRECTION STRATEGIES\")\n",
        "print(\"-\" * 100)\n",
        "\n",
        "comparison = df[\n",
        "    [\"metric\", \"group_a\", \"group_b\", \"raw_p_value\",\n",
        "     \"holm_adjusted_p_value\"]\n",
        "].copy()\n",
        "\n",
        "comparison[\"frozen_adjusted\"] = frozen\n",
        "comparison[\"recalculated_one_family_of_six\"] = six_test_adjusted\n",
        "comparison[\"recalculated_separate_families_of_three\"] = three_test_adjusted\n",
        "\n",
        "comparison[\"matches_six_test_family\"] = np.isclose(\n",
        "    frozen, six_test_adjusted, rtol=1e-8, atol=1e-15\n",
        ")\n",
        "\n",
        "comparison[\"matches_three_test_families\"] = np.isclose(\n",
        "    frozen, three_test_adjusted, rtol=1e-8, atol=1e-15\n",
        ")\n",
        "\n",
        "print(comparison.to_string(index=False))\n",
        "\n",
        "print(\"\\n3. SUMMARY\")\n",
        "print(\"-\" * 100)\n",
        "\n",
        "print(\"Number of comparisons:\", len(df))\n",
        "print(\"Unique metric groups:\", df[\"metric\"].nunique())\n",
        "print(\"Raw p-values identical:\", np.allclose(raw, raw[0]))\n",
        "\n",
        "print(\"\\nFrozen adjusted p-values:\")\n",
        "print(np.array2string(frozen, precision=15))\n",
        "\n",
        "print(\"\\nOne-family-of-six adjusted p-values:\")\n",
        "print(np.array2string(six_test_adjusted, precision=15))\n",
        "\n",
        "print(\"\\nSeparate-three-test-family adjusted p-values:\")\n",
        "print(np.array2string(three_test_adjusted, precision=15))\n",
        "\n",
        "print(\"\\nAll frozen values match one six-test family:\",\n",
        "      bool(np.all(comparison[\"matches_six_test_family\"])))\n",
        "\n",
        "print(\"All frozen values match separate three-test families:\",\n",
        "      bool(np.all(comparison[\"matches_three_test_families\"])))\n",
        "\n",
        "print(\"\\n4. DECISION\")\n",
        "print(\"-\" * 100)\n",
        "\n",
        "if comparison[\"matches_six_test_family\"].all():\n",
        "    decision = \"FROZEN_VALUES_MATCH_ONE_FAMILY_OF_SIX\"\n",
        "    print(\"The frozen adjusted p-values match the documented six-test family.\")\n",
        "\n",
        "elif comparison[\"matches_three_test_families\"].all():\n",
        "    decision = \"FROZEN_VALUES_MATCH_TWO_SEPARATE_FAMILIES_OF_THREE\"\n",
        "    print(\n",
        "        \"The frozen adjusted p-values match separate three-test families, \"\n",
        "        \"not one family of six.\"\n",
        "    )\n",
        "\n",
        "else:\n",
        "    decision = \"FROZEN_VALUES_MATCH_NEITHER_STRATEGY\"\n",
        "    print(\n",
        "        \"The frozen adjusted p-values do not match either correction \"\n",
        "        \"strategy. Further investigation is required.\"\n",
        "    )\n",
        "\n",
        "print(\"\\n5. SOURCE INTEGRITY\")\n",
        "print(\"-\" * 100)\n",
        "\n",
        "source_hash = hashlib.sha256(FILE.read_bytes()).hexdigest()\n",
        "print(\"Source CSV SHA256:\", source_hash)\n",
        "print(\"Frozen source CSV modified: NO\")\n",
        "print(\"Manuscript modified: NO\")\n",
        "print(\"Experimental results overwritten: NO\")\n",
        "\n",
        "# Save a separate verification report.\n",
        "report_path = (\n",
