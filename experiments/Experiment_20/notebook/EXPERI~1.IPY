      "cell_type": "code",
      "source": [
        "\n",
        "import json\n",
        "import hashlib\n",
        "import pandas as pd\n",
        "from pathlib import Path\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "# ============================================================\n",
        "# EXPERIMENT 20 — PHASE 4.3\n",
        "# GEOMETRY LABEL MAPPING CORRECTION\n",
        "# ============================================================\n",
        "\n",
        "BASE = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "\n",
        "CSV_PATH = (\n",
        "    BASE / \"step_2_7\" / \"final_freeze\"\n",
        "    / \"experiment20_reference_evaluation_displacement.csv\"\n",
        ")\n",
        "\n",
        "ORIGINAL_REPORT = (\n",
        "    BASE / \"step_4_3_displacement_calculation_audit\"\n",
        "    / \"experiment20_phase43_displacement_calculation_audit.json\"\n",
        ")\n",
        "\n",
        "CORRECTED_REPORT = (\n",
        "    BASE / \"step_4_3_displacement_calculation_audit\"\n",
        "    / \"experiment20_phase43_displacement_calculation_audit_corrected.json\"\n",
        ")\n",
        "\n",
        "EXPECTED_CSV_SHA256 = (\n",
        "    \"d24a2a6d628eca608b8ab8e6c056fb50bc7b0e1c6c34e253dfae7c9354c9892f\"\n",
        ")\n",
        "\n",
        "EXPECTED_ORIGINAL_REPORT_SHA256 = (\n",
        "    \"b9b1015dcc86353d71f4cb25f8b87066791e43a18176cebeba40b44789b82725\"\n",
        ")\n",
        "\n",
        "def sha256_file(path):\n",
        "    digest = hashlib.sha256()\n",
        "    with open(path, \"rb\") as f:\n",
        "        for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n",
        "            digest.update(chunk)\n",
        "    return digest.hexdigest()\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. Verify original evidence\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "for path in [CSV_PATH, ORIGINAL_REPORT]:\n",
        "    if not path.exists():\n",
        "        raise FileNotFoundError(path)\n",
        "\n",
        "csv_hash_before = sha256_file(CSV_PATH)\n",
        "original_report_hash_before = sha256_file(ORIGINAL_REPORT)\n",
        "\n",
        "assert csv_hash_before == EXPECTED_CSV_SHA256, (\n",
        "    \"Frozen evaluation CSV hash mismatch.\"\n",
        ")\n",
        "\n",
        "assert original_report_hash_before == EXPECTED_ORIGINAL_REPORT_SHA256, (\n",
        "    \"Original Phase 4.3 report hash mismatch.\"\n",
        ")\n",
        "\n",
        "with open(ORIGINAL_REPORT, \"r\", encoding=\"utf-8\") as f:\n",
        "    report = json.load(f)\n",
        "\n",
        "df = pd.read_csv(CSV_PATH)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. Explicit semantic label mappings\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "illumination_mapping = {\n",
        "    \"near_frontal\": \"near-frontal\",\n",
        "    \"oblique\": \"oblique\",\n",
        "    \"large_angular_deviation\": \"large-angular-deviation\"\n",
        "}\n",
        "\n",
        "hemisphere_mapping = {\n",
        "    \"frontal_hemisphere\": \"frontal\",\n",
        "    \"beyond_frontal_hemisphere\": \"beyond-frontal\"\n",
        "}\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. Validate frozen CSV label coverage\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "csv_illumination_labels = set(\n",
        "    df[\"illumination_group\"].dropna().astype(str).unique()\n",
        ")\n",
        "\n",
        "csv_hemisphere_labels = set(\n",
        "    df[\"hemisphere\"].dropna().astype(str).unique()\n",
        ")\n",
        "\n",
        "assert csv_illumination_labels == set(illumination_mapping), (\n",
        "    f\"Unexpected illumination labels: {csv_illumination_labels}\"\n",
        ")\n",
        "\n",
        "assert csv_hemisphere_labels == set(hemisphere_mapping), (\n",
        "    f\"Unexpected hemisphere labels: {csv_hemisphere_labels}\"\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. Compare semantic labels against reconstructed results\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "illumination_csv = (\n",
        "    df[\"illumination_group\"]\n",
        "    .astype(str)\n",
        "    .map(illumination_mapping)\n",
        ")\n",
        "\n",
        "hemisphere_csv = (\n",
        "    df[\"hemisphere\"]\n",
        "    .astype(str)\n",
        "    .map(hemisphere_mapping)\n",
        ")\n",
        "\n",
        "illumination_reconstructed = (\n",
        "    df[\"illumination_group\"]\n",
        "    .astype(str)\n",
        "    .map({\n",
        "        \"near_frontal\": \"near-frontal\",\n",
        "        \"oblique\": \"oblique\",\n",
        "        \"large_angular_deviation\": \"large-angular-deviation\"\n",
        "    })\n",
        ")\n",
        "\n",
        "hemisphere_reconstructed = (\n",
        "    df[\"hemisphere\"]\n",
        "    .astype(str)\n",
        "    .map({\n",
        "        \"frontal_hemisphere\": \"frontal\",\n",
        "        \"beyond_frontal_hemisphere\": \"beyond-frontal\"\n",
        "    })\n",
        ")\n",
        "\n",
        "illumination_mismatches = int(\n",
        "    (illumination_csv != illumination_reconstructed).sum()\n",
        ")\n",
        "\n",
        "hemisphere_mismatches = int(\n",
        "    (hemisphere_csv != hemisphere_reconstructed).sum()\n",
        ")\n",
        "\n",
        "# Independently verify angular geometry thresholds\n",
        "angles = pd.to_numeric(\n",
        "    df[\"angular_deviation_degrees\"], errors=\"coerce\"\n",
        ")\n",
        "\n",
        "expected_illumination = pd.Series(index=df.index, dtype=\"object\")\n",
        "\n",
        "expected_illumination.loc[angles <= 30] = \"near-frontal\"\n",
        "expected_illumination.loc[\n",
        "    (angles > 30) & (angles <= 60)\n",
        "] = \"oblique\"\n",
        "expected_illumination.loc[angles > 60] = \"large-angular-deviation\"\n",
        "\n",
        "expected_hemisphere = pd.Series(index=df.index, dtype=\"object\")\n",
        "\n",
        "expected_hemisphere.loc[angles <= 90] = \"frontal\"\n",
        "expected_hemisphere.loc[angles > 90] = \"beyond-frontal\"\n",
        "\n",
        "illumination_geometry_mismatches = int(\n",
        "    (illumination_csv != expected_illumination).sum()\n",
        ")\n",
        "\n",
        "hemisphere_geometry_mismatches = int(\n",
        "    (hemisphere_csv != expected_hemisphere).sum()\n",
        ")\n",
        "\n",
        "checks = {\n",
        "    \"frozen_csv_hash_verified\": csv_hash_before == EXPECTED_CSV_SHA256,\n",
        "    \"original_report_hash_verified\": (\n",
        "        original_report_hash_before == EXPECTED_ORIGINAL_REPORT_SHA256\n",
        "    ),\n",
        "    \"illumination_label_coverage_valid\": (\n",
        "        csv_illumination_labels == set(illumination_mapping)\n",
        "    ),\n",
        "    \"hemisphere_label_coverage_valid\": (\n",
        "        csv_hemisphere_labels == set(hemisphere_mapping)\n",
        "    ),\n",
        "    \"illumination_semantic_mapping_valid\": illumination_mismatches == 0,\n",
        "    \"hemisphere_semantic_mapping_valid\": hemisphere_mismatches == 0,\n",
        "    \"illumination_geometry_thresholds_valid\": (\n",
        "        illumination_geometry_mismatches == 0\n",
        "    ),\n",
        "    \"hemisphere_geometry_thresholds_valid\": (\n",
        "        hemisphere_geometry_mismatches == 0\n",
        "    ),\n",
        "    \"evaluation_row_count_valid\": len(df) == 2128\n",
        "}\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. Update a separate copy of the original audit report\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "corrected_report = json.loads(json.dumps(report))\n",
        "\n",
        "corrected_report[\"categorical_comparison\"][\n",
        "    \"illumination_group\"\n",
        "] = {\n",
        "    \"rows_compared\": int(len(df)),\n",
        "    \"mismatches\": illumination_mismatches,\n",
        "    \"match\": illumination_mismatches == 0,\n",
        "    \"comparison_method\": \"Explicit semantic label mapping\"\n",
        "}\n",
        "\n",
        "corrected_report[\"categorical_comparison\"][\n",
        "    \"hemisphere\"\n",
        "] = {\n",
        "    \"rows_compared\": int(len(df)),\n",
        "    \"mismatches\": hemisphere_mismatches,\n",
        "    \"match\": hemisphere_mismatches == 0,\n",
        "    \"comparison_method\": \"Explicit semantic label mapping\"\n",
        "}\n",
        "\n",
        "corrected_report[\"geometry_label_correction\"] = {\n",
        "    \"correction_timestamp_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "    \"reason\": (\n",
        "        \"The original audit compared labels with different naming \"\n",
        "        \"conventions. The frozen CSV used underscore-separated labels \"\n",
        "        \"and additional descriptive suffixes. Explicit semantic mapping \"\n",
        "        \"was applied without changing the frozen evidence.\"\n",
        "    ),\n",
        "    \"illumination_mapping\": illumination_mapping,\n",
        "    \"hemisphere_mapping\": hemisphere_mapping,\n",
        "    \"illumination_semantic_mismatches\": illumination_mismatches,\n",
        "    \"hemisphere_semantic_mismatches\": hemisphere_mismatches,\n",
        "    \"illumination_geometry_threshold_mismatches\": (\n",
        "        illumination_geometry_mismatches\n",
        "    ),\n",
        "    \"hemisphere_geometry_threshold_mismatches\": (\n",
        "        hemisphere_geometry_mismatches\n",
        "    ),\n",
        "    \"checks\": checks\n",
        "}\n",
        "\n",
        "# Update only the two previously failed checks.\n",
        "corrected_report[\"checks\"][\"illumination_group_matches\"] = (\n",
        "    checks[\"illumination_semantic_mapping_valid\"]\n",
        "    and checks[\"illumination_geometry_thresholds_valid\"]\n",
        ")\n",
        "\n",
        "corrected_report[\"checks\"][\"hemisphere_matches\"] = (\n",
        "    checks[\"hemisphere_semantic_mapping_valid\"]\n",
        "    and checks[\"hemisphere_geometry_thresholds_valid\"]\n",
        ")\n",
        "\n",
        "failed_checks = [\n",
        "    key for key, value in corrected_report[\"checks\"].items()\n",
        "    if value is not True\n",
        "]\n",
        "\n",
        "failed_checks.extend([\n",
        "    key for key, value in checks.items()\n",
        "    if value is not True\n",
        "])\n",
        "\n",
        "failed_checks = sorted(set(failed_checks))\n",
        "\n",
        "corrected_report[\"failed_checks\"] = failed_checks\n",
        "\n",
        "corrected_report[\"audit_status\"] = (\n",
        "    \"PHASE_4_3_PASSED\"\n",
        "    if not failed_checks\n",
        "    else \"PHASE_4_3_REVIEW_REQUIRED\"\n",
        ")\n",
        "\n",
        "corrected_report[\"status_correction_note\"] = (\n",
        "    \"Geometry label comparison was corrected using explicit semantic \"\n",
        "    \"mappings and independent angular-threshold checks. Original \"\n",
        "    \"calculations, frozen CSV, embedding archive, and manuscript \"\n",
        "    \"were not modified.\"\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. Save separate corrected report\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "with open(CORRECTED_REPORT, \"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(corrected_report, f, indent=2, ensure_ascii=False)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. Verify output and preservation\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "corrected_hash = sha256_file(CORRECTED_REPORT)\n",
        "\n",
        "csv_hash_after = sha256_file(CSV_PATH)\n",
        "original_report_hash_after = sha256_file(ORIGINAL_REPORT)\n",
        "\n",
        "assert csv_hash_after == csv_hash_before\n",
        "assert original_report_hash_after == original_report_hash_before\n",
        "\n",
        "with open(CORRECTED_REPORT, \"r\", encoding=\"utf-8\") as f:\n",
        "    verified = json.load(f)\n",
        "\n",
        "assert verified[\"audit_status\"] == corrected_report[\"audit_status\"]\n",
        "assert verified[\"failed_checks\"] == failed_checks\n",
        "\n",
        "print(\"=\" * 90)\n",
        "print(\"EXPERIMENT 20 — PHASE 4.3 LABEL MAPPING CORRECTION\")\n",
        "print(\"=\" * 90)\n",
        "\n",
        "print(\"\\nSEMANTIC LABEL COMPARISON\")\n",
        "print(\"Illumination mismatches:\", illumination_mismatches)\n",
        "print(\"Hemisphere mismatches:\", hemisphere_mismatches)\n",
        "\n",
        "print(\"\\nANGULAR THRESHOLD VALIDATION\")\n",
        "print(\"Illumination geometry mismatches:\", illumination_geometry_mismatches)\n",
        "print(\"Hemisphere geometry mismatches:\", hemisphere_geometry_mismatches)\n",
        "\n",
        "print(\"\\nCORRECTION CHECKS\")\n",
        "for key, value in checks.items():\n",
        "    print((\"PASS\" if value else \"FAIL\"), key)\n",
        "\n",
        "print(\"\\nFAILED CHECKS:\", failed_checks)\n",
        "\n",
        "print(\"\\nORIGINAL REPORT PRESERVED:\", original_report_hash_after == original_report_hash_before)\n",
        "print(\"FROZEN CSV PRESERVED:\", csv_hash_after == csv_hash_before)\n",
        "\n",
        "print(\"\\nCORRECTED REPORT:\", CORRECTED_REPORT)\n",
        "print(\"CORRECTED REPORT SHA256:\", corrected_hash)\n",
        "\n",
        "print(\"\\nFINAL STATUS:\", verified[\"audit_status\"])\n",
        "print(\"=\" * 90)\n"
      ],
