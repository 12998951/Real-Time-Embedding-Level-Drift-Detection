            "FILE: experiment20_step3393_subject_condition_selection.json\n",
            "SHA256: d890e17fd76312fd50004f8cca17927b179c2d1156a760b5c91af56d8457960c\n",
            "{\n",
            "  \"experiment\": \"Experiment 20\",\n",
            "  \"phase\": \"3.3\",\n",
            "  \"step\": \"3.3.9.3\",\n",
            "  \"subsection\": \"3.3 Subject Selection and Illumination-Condition Coverage\",\n",
            "  \"created_utc\": \"2026-11-11T10:34:52.039353+00:00\",\n",
            "  \"draft_text\": \"The subject cohort comprised 38 identities represented in the Cropped Extended Yale B frontal-pose illumination subset. The standard-illumination image collection contained 64 distinct illumination conditions across the cohort; however, not every condition was available for every identity. Seven identities had incomplete condition coverage. To preserve a consistent identity set across the primary condition-based comparisons, the analysis retained only conditions represented for all 38 identities...[truncated]\",\n",
            "  \"verified_selection_facts\": {\n",
            "    \"identity_count\": 38,\n",
            "    \"standard_illumination_condition_count\": 64,\n",
            "    \"incomplete_identity_count\": 7,\n",
            "    \"common_condition_count\": 57,\n",
            "    \"common_condition_observation_count\": 2166,\n",
            "    \"observations_per_common_condition\": 38,\n",
            "    \"reference_condition\": \"A+000E+00\",\n",
            "    \"reference_observation_count\": 38,\n",
            "    \"evaluation_condition_count\": 56,\n",
            "    \"evaluation_observation_count\": 2128,\n",
            "    \"evaluation_groups\": {\n",
            "      \"near_frontal\": {\n",
            "        \"conditions\": 17,\n",
            "        \"observations\": 646\n",
            "      },\n",
            "      \"oblique\": {\n",
            "        \"conditions\": 11,\n",
            "        \"observations\": 418\n",
            "      },\n",
            "      \"large_angular_deviation\": {\n",
            "        \"conditions\": 28,\n",
            "        \"observations\": 1064\n",
            "      }\n",
            "    },\n",
            "    \"grouping_interpretation\": \"Angular deviation of illumination direction, not measured intensity\"\n",
            "  },\n",
            "  \"word_count\": 296,\n",
            "  \"checks\": {\n",
            "    \"38_identity_cohort_stated\": true,\n",
            "    \"64_total_conditions_stated\": true,\n",
            "    \"seven_incomplete_identities_stated\": true,\n",
            "    \"57_common_conditions_stated\": true,\n",
            "    \"2166_common_observations_stated\": true,\n",
            "    \"complete_case_selection_explained\": true,\n",
            "    \"reference_condition_correct\": true,\n",
            "    \"38_reference_observations_stated\": false,\n",
            "    \"56_evaluation_conditions_stated\": true,\n",
            "    \"2128_evaluation_observations_stated\": true,\n",
            "    \"three_geometry_groups_named\": true,\n",
            "    \"group_condition_and_observation_counts_stated\": true,\n",
            "    \"reference_excluded_from_evaluation_counts\": true,\n",
            "    \"geometry_not_intensity_limitation_stated\": true,\n",
            "    \"same_identities_across_groups_stated\": true,\n",
            "    \"not_exact_image_pairs_limitation_stated\": true\n",
            "  },\n",
            "  \"passed_checks\": 15,\n",
            "  \"total_checks\": 16,\n",
            "  \"failed_checks\": [\n",
            "    \"38_reference_observations_stated\"\n",
            "  ],\n",
            "  \"status\": \"DRAFT_REQUIRES_REVIEW\",\n",
            "  \"selection_notes\": [\n",
            "    \"Common-condition selection maintains complete identity coverage.\",\n",
            "    \"Reference observations are used for distance calculation but excluded from non-reference evaluation counts.\",\n",
            "    \"Geometry groups describe angular deviation, not measured illumination intensity.\"\n",
            "  ]\n",
            "}\n",
            "\n",
