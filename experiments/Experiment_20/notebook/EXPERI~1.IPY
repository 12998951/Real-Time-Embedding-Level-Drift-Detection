        "\n",
        "## Experiment 20 — Step 2.6.5\n",
        "### Install and Verify aria2 Acquisition Utility\n",
        "\n",
        "**Objective**\n",
        "\n",
        "Install aria2 in the Colab environment to enable controlled BitTorrent acquisition of the candidate Extended Yale B archive.\n",
        "\n",
        "**Actions**\n",
        "\n",
        "1. Update the package index.\n",
        "2. Install aria2.\n",
        "3. Verify the aria2 executable.\n",
        "4. Record the installed version.\n",
        "5. Save the installation audit.\n",
        "\n",
        "**Constraints**\n",
        "\n",
        "- Do not start the torrent download.\n",
        "- Do not extract any archive.\n",
        "- Do not modify Experiment 18 files.\n",
        "- Keep the acquisition utility separate from the research dataset.\n"
      ],
      "metadata": {
        "id": "lB1VsYGqcPae"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "# ============================================================\n",
        "# EXPERIMENT 20 — STEP 2.6.5\n",
        "# INSTALL AND VERIFY ARIA2\n",
        "# ============================================================\n",
        "\n",
        "from pathlib import Path\n",
        "import subprocess\n",
        "import shutil\n",
        "import json\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "audit_dir = Path(\n",
        "    \"/content/drive/MyDrive/Experiment_20_Results/\"\n",
        "    \"dataset_audit\"\n",
        ")\n",
        "audit_dir.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "print(\"=\" * 75)\n",
        "print(\"EXPERIMENT 20 — STEP 2.6.5\")\n",
        "print(\"INSTALL AND VERIFY ARIA2\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. Update package index\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n[1] UPDATING PACKAGE INDEX\")\n",
        "\n",
        "update_result = subprocess.run(\n",
        "    [\"apt-get\", \"update\", \"-qq\"],\n",
        "    capture_output=True,\n",
        "    text=True\n",
        ")\n",
        "\n",
        "print(\"Return code:\", update_result.returncode)\n",
        "\n",
        "if update_result.returncode != 0:\n",
        "    print(update_result.stderr[-3000:])\n",
        "    raise RuntimeError(\"Package index update failed.\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. Install aria2\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n[2] INSTALLING ARIA2\")\n",
        "\n",
        "install_result = subprocess.run(\n",
        "    [\"apt-get\", \"install\", \"-y\", \"-qq\", \"aria2\"],\n",
        "    capture_output=True,\n",
        "    text=True\n",
        ")\n",
        "\n",
        "print(\"Return code:\", install_result.returncode)\n",
        "\n",
        "if install_result.returncode != 0:\n",
        "    print(install_result.stderr[-3000:])\n",
        "    raise RuntimeError(\"aria2 installation failed.\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. Verify executable\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n[3] VERIFYING ARIA2\")\n",
        "\n",
        "aria2_path = shutil.which(\"aria2c\")\n",
        "\n",
        "assert aria2_path is not None, \"aria2c executable not found.\"\n",
        "\n",
        "version_result = subprocess.run(\n",
        "    [\"aria2c\", \"--version\"],\n",
        "    capture_output=True,\n",
        "    text=True,\n",
        "    check=True\n",
        ")\n",
        "\n",
        "version_line = version_result.stdout.splitlines()[0]\n",
        "\n",
        "print(\"Executable:\", aria2_path)\n",
        "print(\"Version:\", version_line)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. Save installation audit\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "record = {\n",
        "    \"experiment\": 20,\n",
        "    \"step\": \"2.6.5\",\n",
        "    \"timestamp_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "    \"package\": \"aria2\",\n",
        "    \"executable\": aria2_path,\n",
        "    \"version\": version_line,\n",
        "    \"installation_successful\": True,\n",
        "    \"torrent_download_started\": False,\n",
        "    \"archive_extraction_started\": False\n",
        "}\n",
        "\n",
        "output_file = audit_dir / \"experiment20_aria2_installation_audit.json\"\n",
        "\n",
        "with open(output_file, \"w\", encoding=\"utf-8\") as file:\n",
        "    json.dump(record, file, indent=4)\n",
        "\n",
        "with open(output_file, \"r\", encoding=\"utf-8\") as file:\n",
        "    verified = json.load(file)\n",
        "\n",
        "assert verified[\"installation_successful\"] is True\n",
        "assert verified[\"torrent_download_started\"] is False\n",
        "\n",
        "print(\"\\n\" + \"=\" * 75)\n",
        "print(\"STEP 2.6.5 — FINAL SUMMARY\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "print(\"aria2 installed:\", aria2_path is not None)\n",
        "print(\"Installation audit:\", output_file)\n",
        "print(\"JSON verification: PASSED\")\n",
        "print(\"Torrent download started: NO\")\n",
        "print(\"Archive extraction started: NO\")\n",
        "\n",
        "print(\"=\" * 75)\n"
      ],
