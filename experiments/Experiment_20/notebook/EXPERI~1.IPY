        "# Experiment 20 — Step 3.2.13\n",
        "## MediaPipe Pilot-Test Preparation\n",
        "\n",
        "### Objective\n",
        "Prepare a reproducible pilot sample for assessing MediaPipe\n",
        "Face Landmarker feasibility on the original Yale B images.\n",
        "\n",
        "### Sampling design\n",
        "Select 30 images:\n",
        "- 10 near-frontal illumination observations.\n",
        "- 10 oblique illumination observations.\n",
        "- 10 large-angular illumination observations.\n",
        "\n",
        "Use a deterministic sampling seed.\n",
        "\n",
        "### Requirements\n",
        "- Use the original frozen source images.\n",
        "- Do not modify the source archive.\n",
        "- Do not modify existing FaceNet embeddings.\n",
        "- Preserve subject and illumination-condition identifiers.\n",
        "- Record the exact image paths selected.\n",
        "- Check that all 30 images are unique.\n",
        "- Check that every selected image exists in the source archive.\n",
        "\n",
        "### Important\n",
        "This step only prepares and audits the sample.\n",
        "It does not install MediaPipe, download a model, perform detection,\n",
        "or generate aligned images.\n",
        "\n",
        "### Output\n",
        "A JSON manifest containing the 30 selected image records,\n",
        "their illumination groups, sampling seed, and validation results."
      ],
      "metadata": {
        "id": "zsSwk6sJ6N2e"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from pathlib import Path\n",
        "from zipfile import ZipFile\n",
        "import numpy as np\n",
        "import json\n",
        "import hashlib\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "BASE = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "STEP_DIR = BASE / \"step_3_2\"\n",
        "EMBEDDING_FILE = (\n",
        "    BASE / \"embeddings\" /\n",
        "    \"experiment20_croppedyale_facenet_embeddings.npz\"\n",
        ")\n",
        "FROZEN_ZIP = (\n",
        "    BASE / \"Experiment_20_Stage_2_Frozen_Dataset.zip\"\n",
        ")\n",
        "\n",
        "OUTPUT_FILE = STEP_DIR / (\n",
        "    \"experiment20_step3213_mediapipe_pilot_sample_manifest.json\"\n",
        ")\n",
        "\n",
        "SEED = 203213\n",
        "SAMPLE_PER_GROUP = 10\n",
        "\n",
        "print(\"=\" * 88)\n",
        "print(\"EXPERIMENT 20 — STEP 3.2.13\")\n",
        "print(\"MEDIAPIPE PILOT SAMPLE PREPARATION\")\n",
        "print(\"=\" * 88)\n",
        "\n",
        "assert EMBEDDING_FILE.exists(), \"Embedding NPZ not found.\"\n",
        "assert FROZEN_ZIP.exists(), \"Frozen dataset ZIP not found.\"\n",
        "\n",
        "with np.load(EMBEDDING_FILE, allow_pickle=False) as data:\n",
        "    filenames = data[\"filenames\"].astype(str)\n",
        "    subjects = data[\"subjects\"].astype(str)\n",
        "    conditions = data[\"conditions\"].astype(str)\n",
        "    azimuths = data[\"azimuths\"].astype(int)\n",
        "    elevations = data[\"elevations\"].astype(int)\n",
        "\n",
        "assert len(filenames) == 2414\n",
        "assert len(set(filenames)) == 2414\n",
        "\n",
        "# Reconstruct the geometry groups using the documented definition.\n",
        "theta = np.degrees(\n",
        "    np.arccos(\n",
        "        np.clip(\n",
        "            np.cos(np.radians(elevations)) *\n",
        "            np.cos(np.radians(azimuths)),\n",
        "            -1.0,\n",
        "            1.0\n",
        "        )\n",
        "    )\n",
        ")\n",
        "\n",
        "groups = np.where(\n",
        "    theta <= 30,\n",
        "    \"near_frontal\",\n",
        "    np.where(theta <= 60, \"oblique\", \"large_angular\")\n",
        ")\n",
        "\n",
        "# Exclude the reference condition from pilot evaluation.\n",
        "evaluation_mask = conditions != \"A+000E+00\"\n",
        "\n",
        "rng = np.random.default_rng(SEED)\n",
        "selected_indices = []\n",
        "\n",
        "for group_name in [\n",
        "    \"near_frontal\",\n",
        "    \"oblique\",\n",
        "    \"large_angular\"\n",
        "]:\n",
        "    candidates = np.where(\n",
        "        (groups == group_name) & evaluation_mask\n",
        "    )[0]\n",
        "\n",
        "    assert len(candidates) >= SAMPLE_PER_GROUP, (\n",
        "        f\"Insufficient observations in {group_name}\"\n",
        "    )\n",
        "\n",
        "    chosen = rng.choice(\n",
        "        candidates,\n",
        "        size=SAMPLE_PER_GROUP,\n",
        "        replace=False\n",
        "    )\n",
        "\n",
        "    selected_indices.extend(chosen.tolist())\n",
        "\n",
        "# Verify archive membership using exact source image basenames.\n",
        "with ZipFile(FROZEN_ZIP, \"r\") as zf:\n",
        "    nested_name = (\n",
        "        \"Experiment_20_Stage_2_Frozen_Dataset/source/CroppedYale.zip\"\n",
        "    )\n",
        "\n",
        "    nested_bytes = zf.read(nested_name)\n",
        "    nested_sha256 = hashlib.sha256(nested_bytes).hexdigest()\n",
        "\n",
        "    expected_nested_sha256 = (\n",
        "        \"8bbabf3836d077d60626c9ee3c54c2d2851a8d2c15c8b7e13b9bc162e86ea573\"\n",
        "    )\n",
        "\n",
        "    assert nested_sha256 == expected_nested_sha256, (\n",
        "        \"Nested source archive checksum mismatch.\"\n",
        "    )\n",
        "\n",
        "    import io\n",
        "\n",
        "    with ZipFile(io.BytesIO(nested_bytes), \"r\") as source_zip:\n",
        "        archive_files = {\n",
        "            Path(name).name\n",
        "            for name in source_zip.namelist()\n",
        "            if name.lower().endswith(\".pgm\")\n",
        "        }\n",
        "\n",
        "records = []\n",
        "\n",
        "for idx in selected_indices:\n",
        "    filename = filenames[idx]\n",
        "\n",
        "    assert filename in archive_files, (\n",
        "        f\"Selected image missing from source archive: {filename}\"\n",
        "    )\n",
        "\n",
        "    records.append({\n",
        "        \"filename\": filename,\n",
        "        \"subject\": subjects[idx],\n",
        "        \"condition\": conditions[idx],\n",
        "        \"azimuth\": int(azimuths[idx]),\n",
        "        \"elevation\": int(elevations[idx]),\n",
        "        \"theta_degrees\": float(theta[idx]),\n",
        "        \"illumination_group\": str(groups[idx])\n",
        "    })\n",
        "\n",
        "# Audit sample balance and uniqueness.\n",
        "group_counts = {}\n",
        "\n",
        "for group_name in [\n",
        "    \"near_frontal\",\n",
        "    \"oblique\",\n",
        "    \"large_angular\"\n",
        "]:\n",
        "    group_counts[group_name] = sum(\n",
        "        r[\"illumination_group\"] == group_name\n",
        "        for r in records\n",
        "    )\n",
        "\n",
        "unique_filenames = len({\n",
        "    r[\"filename\"] for r in records\n",
        "})\n",
        "\n",
        "unique_subjects = len({\n",
        "    r[\"subject\"] for r in records\n",
        "})\n",
        "\n",
        "checks = {\n",
        "    \"30_records_selected\": len(records) == 30,\n",
        "    \"30_unique_filenames\": unique_filenames == 30,\n",
        "    \"10_near_frontal\": group_counts[\"near_frontal\"] == 10,\n",
        "    \"10_oblique\": group_counts[\"oblique\"] == 10,\n",
        "    \"10_large_angular\": group_counts[\"large_angular\"] == 10,\n",
        "    \"all_images_in_source_archive\": all(\n",
        "        r[\"filename\"] in archive_files for r in records\n",
        "    ),\n",
        "    \"reference_condition_excluded\": all(\n",
        "        r[\"condition\"] != \"A+000E+00\" for r in records\n",
        "    ),\n",
        "    \"source_archive_checksum_matches\": (\n",
        "        nested_sha256 == expected_nested_sha256\n",
        "    )\n",
        "}\n",
        "\n",
        "manifest = {\n",
        "    \"experiment\": \"Experiment 20\",\n",
        "    \"step\": \"3.2.13\",\n",
        "    \"timestamp_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "    \"sampling_seed\": SEED,\n",
        "    \"sampling_method\": \"Deterministic random sampling without replacement\",\n",
        "    \"sample_size\": len(records),\n",
        "    \"sample_per_group\": SAMPLE_PER_GROUP,\n",
        "    \"group_counts\": group_counts,\n",
        "    \"unique_subject_count\": unique_subjects,\n",
        "    \"source_archive_sha256\": nested_sha256,\n",
        "    \"records\": records,\n",
        "    \"checks\": checks,\n",
        "    \"passed_checks\": sum(checks.values()),\n",
        "    \"total_checks\": len(checks),\n",
        "    \"status\": (\n",
        "        \"PILOT_SAMPLE_READY\"\n",
        "        if all(checks.values())\n",
        "        else \"PILOT_SAMPLE_VALIDATION_FAILED\"\n",
        "    ),\n",
        "    \"restrictions\": {\n",
        "        \"package_installation\": False,\n",
        "        \"model_download\": False,\n",
        "        \"inference\": False,\n",
        "        \"aligned_images_generated\": False,\n",
        "        \"frozen_data_modified\": False\n",
        "    }\n",
        "}\n",
        "\n",
        "with open(OUTPUT_FILE, \"w\") as f:\n",
        "    json.dump(manifest, f, indent=2)\n",
        "\n",
        "with open(OUTPUT_FILE, \"r\") as f:\n",
        "    reloaded = json.load(f)\n",
        "\n",
        "print(\"Selected images:\", len(records))\n",
        "print(\"Unique subjects:\", unique_subjects)\n",
        "print(\"Group counts:\", group_counts)\n",
        "print(\"Source archive SHA256:\", nested_sha256)\n",
        "\n",
        "print(\"\\nVALIDATION\")\n",
        "for name, passed in checks.items():\n",
        "    print(f\"{name}: {'PASS' if passed else 'FAIL'}\")\n",
        "\n",
        "print(\n",
        "    \"\\nPassed:\",\n",
        "    sum(checks.values()),\n",
        "    \"/\",\n",
        "    len(checks)\n",
        ")\n",
        "\n",
        "print(\"JSON reload:\", \"PASS\" if reloaded == manifest else \"FAIL\")\n",
        "print(\"Saved:\", OUTPUT_FILE)\n",
        "print(\"\\nPackage installation: NO\")\n",
        "print(\"Model download: NO\")\n",
        "print(\"Inference: NO\")\n",
        "print(\"Aligned images generated: NO\")\n",
        "print(\"Frozen data modified: NO\")\n",
        "print(\"=\" * 88)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "1UuPquEi6P2n",
        "outputId": "5c0270cd-8140-43b4-cca2-31cf237b43ee"
      },
