      "cell_type": "markdown",
      "source": [
        "# Experiment 20 — Step 3.3.32: Hemisphere Figure Placement Diagnosis\n",
        "\n",
        "## Objective\n",
        "Determine why the hemisphere figure placement validation failed.\n",
        "\n",
        "## Checks\n",
        "1. Print the complete Section 3.5 text from manuscript v2.\n",
        "2. Locate the Euclidean and cosine result paragraphs.\n",
        "3. Locate the Figure 3 and Figure 4 image embeds and captions.\n",
        "4. Locate the exploratory limitation paragraph.\n",
        "5. Verify their actual ordering.\n",
        "6. Inspect whether the previous audit failed because of an overly strict text anchor.\n",
        "\n",
        "## Integrity restrictions\n",
        "- Read-only inspection.\n",
        "- Do not edit manuscript v2.\n",
        "- Do not move or reinsert figures.\n",
        "- Do not modify frozen figures or statistical evidence.\n",
        "\n",
        "## Expected outcome\n",
        "A definitive placement diagnosis based on actual manuscript text and ordering."
      ],
      "metadata": {
        "id": "rPhq9eAQKOxT"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# EXPERIMENT 20 — STEP 3.3.32\n",
        "# HEMISPHERE FIGURE PLACEMENT DIAGNOSIS\n",
        "# READ-ONLY\n",
        "# ============================================================\n",
        "\n",
        "import os\n",
        "import re\n",
        "import json\n",
        "import hashlib\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "BASE = \"/content/drive/MyDrive/Experiment_20_Results\"\n",
        "\n",
        "MANUSCRIPT = os.path.join(\n",
        "    BASE, \"step_3_3\", \"step_3330\",\n",
        "    \"experiment20_integrated_manuscript_v2.md\"\n",
        ")\n",
        "\n",
        "OUTPUT_DIR = os.path.join(\n",
        "    BASE, \"step_3_3\", \"step_3332\"\n",
        ")\n",
        "os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
        "\n",
        "REPORT_PATH = os.path.join(\n",
        "    OUTPUT_DIR,\n",
        "    \"experiment20_step3332_hemisphere_placement_diagnosis.json\"\n",
        ")\n",
        "\n",
        "\n",
        "def sha256_file(path):\n",
        "    h = hashlib.sha256()\n",
        "    with open(path, \"rb\") as f:\n",
        "        for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n",
        "            h.update(chunk)\n",
        "    return h.hexdigest()\n",
        "\n",
        "\n",
        "with open(MANUSCRIPT, \"r\", encoding=\"utf-8\") as f:\n",
        "    text = f.read()\n",
        "\n",
        "lines = text.splitlines()\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. EXTRACT SECTION 3.5\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "start = next(\n",
        "    i for i, line in enumerate(lines)\n",
        "    if line.strip() == \"## 3.5 Exploratory frontal and beyond-frontal comparison\"\n",
        ")\n",
        "\n",
        "end = next(\n",
        "    i for i, line in enumerate(lines[start + 1:], start + 1)\n",
        "    if line.strip().startswith(\"## 3.6\")\n",
        ")\n",
        "\n",
        "section_lines = lines[start:end]\n",
        "\n",
        "print(\"=\" * 100)\n",
        "print(\"STEP 3.3.32 — COMPLETE SECTION 3.5\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "for i, line in enumerate(section_lines, start + 1):\n",
        "    print(f\"{i}: {line}\")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. FIND ACTUAL ELEMENT POSITIONS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "patterns = {\n",
        "    \"euclidean_result\": r\"mean paired difference.*?0\\.581770.*?1\\.455e-11\",\n",
        "    \"cosine_result\": r\"mean paired difference.*?0\\.542807.*?1\\.455e-11\",\n",
        "    \"figure3_embed\": r\"!\\[Paired identity-level Euclidean displacement\\]\\(figures/experiment20_figure3_euclidean_hemisphere_comparison\\.png\\)\",\n",
        "    \"figure4_embed\": r\"!\\[Paired identity-level cosine distance\\]\\(figures/experiment20_figure4_cosine_hemisphere_comparison\\.png\\)\",\n",
        "    \"figure3_caption\": r\"Figure 3\\. Paired identity-level Euclidean displacement\",\n",
        "    \"figure4_caption\": r\"Figure 4\\. Paired identity-level cosine distance\",\n",
        "    \"exploratory_limitation\": r\"This comparison is exploratory\\.\"\n",
        "}\n",
        "\n",
        "positions = {}\n",
        "\n",
        "for name, pattern in patterns.items():\n",
        "\n",
        "    match = re.search(pattern, text, flags=re.IGNORECASE | re.DOTALL)\n",
        "\n",
        "    positions[name] = (\n",
        "        match.start() if match else None\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"{name}:\",\n",
        "        positions[name],\n",
        "        \"| FOUND\" if match else \"| NOT FOUND\"\n",
        "    )\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. CHECK ORDERING\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "required_order = [\n",
        "    \"euclidean_result\",\n",
        "    \"cosine_result\",\n",
        "    \"figure3_embed\",\n",
        "    \"figure3_caption\",\n",
        "    \"figure4_embed\",\n",
        "    \"figure4_caption\",\n",
        "    \"exploratory_limitation\"\n",
        "]\n",
        "\n",
        "values = [positions[name] for name in required_order]\n",
        "\n",
        "all_found = all(value is not None for value in values)\n",
        "\n",
        "correct_order = (\n",
        "    all_found\n",
        "    and values == sorted(values)\n",
        "    and len(set(values)) == len(values)\n",
        ")\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"ORDERING DIAGNOSIS\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "print(\"All elements found:\", all_found)\n",
        "print(\"Required order:\", required_order)\n",
        "print(\"Actual positions:\", values)\n",
        "print(\"Correct order:\", correct_order)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. DIAGNOSE THE PREVIOUS AUDIT'S EXACT ANCHORS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "old_euclidean_anchor = (\n",
        "    \"Holm-adjusted p = 1.455e-11). (Figure 3).\"\n",
