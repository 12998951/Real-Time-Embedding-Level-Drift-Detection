        "\n",
        "        for j in range(start, end):\n",
        "            print(f\"{j + 1}: {lines[j]}\")\n",
        "\n",
        "        printed.update(range(start, end))\n",
        "\n",
        "    print(\"\\nTotal lines mentioning Table 1 or Table 2:\", len(matching))\n",
