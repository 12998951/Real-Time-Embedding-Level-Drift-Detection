        "    \"retained_limitations\": [\n",
        "        \"This audit verifies existing metadata, preprocessing evidence, \"\n",
        "        \"and the embedding archive; it does not independently regenerate \"\n",
        "        \"all embeddings from the original images.\",\n",
        "        \"Face detection and face alignment were disabled.\",\n",
        "        \"Direct resizing to 160 by 160 pixels was used.\",\n",
        "        \"Numerical embedding validity does not establish identity \"\n",
        "        \"recognition accuracy.\",\n",
        "        \"The preprocessing pipeline differs from Experiment 18.\"\n",
        "    ],\n",
        "\n",
        "    \"source_files_modified\": False,\n",
        "    \"embeddings_regenerated\": False,\n",
        "    \"manuscript_modified\": False\n",
        "}\n",
