        "            ),\n",
        "            \"classification\": \"RETROSPECTIVE_EXPLORATORY\",\n",
        "            \"limitations\": [\n",
        "                \"Unequal numbers of illumination conditions\",\n",
        "                \"Confounding with angular geometry\"\n",
        "            ]\n",
        "        }\n",
