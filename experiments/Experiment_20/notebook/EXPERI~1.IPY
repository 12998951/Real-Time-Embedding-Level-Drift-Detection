        "    \"not_misrepresented_as_complete_dataset\":\n",
        "        \"complete multi-pose Extended Yale B dataset\" in section_text\n",
        "}\n",
        "\n",
        "word_count = len(re.findall(r\"\\b[\\w'-]+\\b\", section_text))\n",
