      "cell_type": "markdown",
      "source": [
        "# Experiment 20 — Step 3.2.9\n",
        "## Full Source Image Integrity and Cohort Verification\n",
        "\n",
        "### Objective\n",
        "Perform a complete image-level integrity check against the\n",
        "2,414 embedding records using the verified nested source archive.\n",
        "\n",
        "### Checks\n",
        "1. Source archive SHA256.\n",
        "2. Exactly 38 subject directories.\n",
        "3. Exactly 2,414 expected standard images.\n",
        "4. Exactly 38 ambient images excluded from the standard cohort.\n",
        "5. Every expected image decodes successfully.\n",
        "6. Every expected image has dimensions 168 × 192.\n",
        "7. Every expected image is grayscale.\n",
        "8. All 2,166 common-condition observations are recoverable.\n",
        "9. All 2,128 evaluation observations are recoverable.\n",
        "\n",
        "### Subject parsing correction\n",
        "Subject identifiers are obtained only from directory components,\n",
        "not from image filenames.\n",
        "\n",
        "### Restrictions\n",
        "- Read-only source inspection.\n",
        "- No permanent extraction.\n",
        "- No downloads or installations.\n",
        "- No embedding regeneration.\n",
        "- Existing frozen artifacts remain unchanged.\n",
        "\n",
        "### Output\n",
        "Save a new Step 3.2.9 integrity audit JSON."
      ],
      "metadata": {
        "id": "wvI8G6C23gU8"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from pathlib import Path\n",
        "from zipfile import ZipFile\n",
        "from io import BytesIO\n",
        "from PIL import Image\n",
        "from collections import Counter\n",
        "import numpy as np\n",
        "import hashlib\n",
        "import json\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "BASE = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "\n",
        "OUTER_ZIP = BASE / \"Experiment_20_Stage_2_Frozen_Dataset.zip\"\n",
        "NPZ_FILE = BASE / \"embeddings/experiment20_croppedyale_facenet_embeddings.npz\"\n",
        "\n",
        "AUDIT_DIR = BASE / \"step_3_2\"\n",
        "AUDIT_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "OUTPUT_FILE = AUDIT_DIR / (\n",
        "    \"experiment20_step329_full_image_integrity_audit.json\"\n",
        ")\n",
        "\n",
        "SOURCE_MEMBER = (\n",
        "    \"Experiment_20_Stage_2_Frozen_Dataset/source/CroppedYale.zip\"\n",
        ")\n",
        "\n",
        "EXPECTED_SHA256 = (\n",
        "    \"8bbabf3836d077d60626c9ee3c54c2d2851a8d2c15c8b7e13b9bc162e86ea573\"\n",
        ")\n",
        "\n",
        "EXPECTED_SUBJECTS = 38\n",
        "EXPECTED_IMAGES = 2414\n",
        "EXPECTED_AMBIENT = 38\n",
        "EXPECTED_COMMON = 2166\n",
        "EXPECTED_EVALUATION = 2128\n",
        "\n",
        "print(\"=\" * 90)\n",
        "print(\"EXPERIMENT 20 — STEP 3.2.9\")\n",
        "print(\"FULL SOURCE IMAGE INTEGRITY VERIFICATION\")\n",
        "print(\"=\" * 90)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. Load embeddings and metadata\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "data = np.load(NPZ_FILE, allow_pickle=False)\n",
        "\n",
        "filenames = data[\"filenames\"].astype(str)\n",
        "subjects = data[\"subjects\"].astype(str)\n",
        "conditions = data[\"conditions\"].astype(str)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. Load nested archive\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "with ZipFile(OUTER_ZIP, \"r\") as outer:\n",
        "    nested_bytes = outer.read(SOURCE_MEMBER)\n",
        "\n",
        "actual_sha256 = hashlib.sha256(nested_bytes).hexdigest()\n",
        "\n",
        "nested = ZipFile(BytesIO(nested_bytes), \"r\")\n",
        "nested_entries = nested.namelist()\n",
        "\n",
        "pgm_entries = [\n",
        "    name for name in nested_entries\n",
        "    if name.lower().endswith(\".pgm\")\n",
        "]\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. Correct subject-directory parsing\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "subject_directories = set()\n",
        "\n",
        "for name in pgm_entries:\n",
        "    parts = Path(name).parts\n",
        "\n",
        "    for part in parts[:-1]:\n",
        "        if part.startswith(\"yaleB\") and len(part) == 7:\n",
        "            subject_directories.add(part)\n",
        "\n",
        "metadata_subjects = set(subjects.tolist())\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. Match expected image files\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "archive_by_basename = {\n",
        "    Path(name).name: name\n",
        "    for name in pgm_entries\n",
        "}\n",
        "\n",
        "matched = []\n",
        "unmatched = []\n",
        "\n",
        "for filename in filenames:\n",
        "    basename = Path(filename).name\n",
        "\n",
        "    if basename in archive_by_basename:\n",
        "        matched.append((filename, archive_by_basename[basename]))\n",
        "    else:\n",
        "        unmatched.append(filename)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. Identify ambient images\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "ambient_entries = [\n",
        "    name for name in pgm_entries\n",
        "    if \"Ambient\" in Path(name).name\n",
        "]\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. Decode all expected images\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n[1] FULL IMAGE DECODING\")\n",
        "\n",
        "dimension_counts = Counter()\n",
        "mode_counts = Counter()\n",
        "decode_failures = []\n",
        "invalid_dimensions = []\n",
        "unexpected_modes = []\n",
        "\n",
        "for index, (original_filename, archive_filename) in enumerate(matched, 1):\n",
        "\n",
        "    try:\n",
        "        with nested.open(archive_filename) as image_file:\n",
        "            image = Image.open(image_file)\n",
        "            image.load()\n",
        "\n",
        "            dimension_counts[str(image.size)] += 1\n",
        "            mode_counts[image.mode] += 1\n",
        "\n",
        "            if image.size != (168, 192):\n",
        "                invalid_dimensions.append({\n",
        "                    \"filename\": original_filename,\n",
        "                    \"dimensions\": image.size\n",
        "                })\n",
        "\n",
        "            if image.mode != \"L\":\n",
        "                unexpected_modes.append({\n",
        "                    \"filename\": original_filename,\n",
        "                    \"mode\": image.mode\n",
        "                })\n",
        "\n",
        "    except Exception as exc:\n",
        "        decode_failures.append({\n",
        "            \"filename\": original_filename,\n",
        "            \"error\": repr(exc)\n",
        "        })\n",
        "\n",
        "    if index % 500 == 0:\n",
        "        print(f\"Decoded: {index}/{len(matched)}\")\n",
        "\n",
        "print(\"Decoded images:\", len(matched))\n",
        "print(\"Dimension counts:\", dict(dimension_counts))\n",
        "print(\"Mode counts:\", dict(mode_counts))\n",
        "print(\"Decode failures:\", len(decode_failures))\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. Recheck common-condition cohort\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "unique_subjects = sorted(metadata_subjects)\n",
        "unique_conditions = sorted(set(conditions.tolist()))\n",
        "\n",
        "pair_set = set(zip(subjects.tolist(), conditions.tolist()))\n",
        "\n",
        "common_conditions = [\n",
        "    condition\n",
        "    for condition in unique_conditions\n",
        "    if all(\n",
        "        (subject, condition) in pair_set\n",
        "        for subject in unique_subjects\n",
        "    )\n",
        "]\n",
        "\n",
        "common_rows = [\n",
        "    i for i, condition in enumerate(conditions)\n",
        "    if condition in common_conditions\n",
        "]\n",
        "\n",
        "evaluation_rows = [\n",
        "    i for i in common_rows\n",
        "    if conditions[i] != \"A+000E+00\"\n",
        "]\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 8. Build checks\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "checks = {\n",
        "    \"Source SHA256 matches\": actual_sha256 == EXPECTED_SHA256,\n",
        "    \"Nested ZIP integrity\": nested.testzip() is None,\n",
        "    \"38 subject directories\": len(subject_directories) == EXPECTED_SUBJECTS,\n",
        "    \"Subject directories match metadata\": subject_directories == metadata_subjects,\n",
        "    \"2414 embedding images matched\": len(matched) == EXPECTED_IMAGES,\n",
        "    \"No unmatched embedding images\": len(unmatched) == 0,\n",
        "    \"38 ambient images identified\": len(ambient_entries) == EXPECTED_AMBIENT,\n",
        "    \"All expected images decoded\": len(decode_failures) == 0 and len(matched) == EXPECTED_IMAGES,\n",
        "    \"All images are 168x192\": len(invalid_dimensions) == 0,\n",
        "    \"All images are grayscale\": len(unexpected_modes) == 0,\n",
        "    \"2166 common observations\": len(common_rows) == EXPECTED_COMMON,\n",
        "    \"2128 evaluation observations\": len(evaluation_rows) == EXPECTED_EVALUATION\n",
        "}\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 9. Save audit\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "audit = {\n",
        "    \"experiment\": \"Experiment 20\",\n",
        "    \"step\": \"3.2.9\",\n",
        "    \"timestamp_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "    \"source_archive\": {\n",
        "        \"outer_package\": str(OUTER_ZIP),\n",
        "        \"nested_member\": SOURCE_MEMBER,\n",
        "        \"sha256\": actual_sha256,\n",
        "        \"expected_sha256\": EXPECTED_SHA256,\n",
        "        \"sha256_match\": actual_sha256 == EXPECTED_SHA256,\n",
        "        \"nested_entries\": len(nested_entries),\n",
        "        \"pgm_entries\": len(pgm_entries)\n",
        "    },\n",
        "    \"cohort\": {\n",
        "        \"embedding_records\": len(filenames),\n",
        "        \"matched_images\": len(matched),\n",
        "        \"unmatched_images\": len(unmatched),\n",
        "        \"subject_directories\": sorted(subject_directories),\n",
        "        \"subject_directory_count\": len(subject_directories),\n",
        "        \"ambient_images\": len(ambient_entries),\n",
        "        \"common_conditions\": len(common_conditions),\n",
        "        \"common_observations\": len(common_rows),\n",
        "        \"evaluation_observations\": len(evaluation_rows)\n",
        "    },\n",
        "    \"image_integrity\": {\n",
        "        \"decoded_images\": len(matched) - len(decode_failures),\n",
        "        \"dimension_counts\": dict(dimension_counts),\n",
        "        \"mode_counts\": dict(mode_counts),\n",
        "        \"decode_failures\": decode_failures,\n",
        "        \"invalid_dimensions\": invalid_dimensions,\n",
        "        \"unexpected_modes\": unexpected_modes\n",
        "    },\n",
        "    \"checks\": checks,\n",
        "    \"passed\": sum(checks.values()),\n",
        "    \"total_checks\": len(checks),\n",
        "    \"status\": (\n",
        "        \"FULL_IMAGE_COHORT_VERIFIED\"\n",
        "        if all(checks.values())\n",
        "        else \"REQUIRES_REVIEW\"\n",
        "    )\n",
        "}\n",
        "\n",
        "with open(OUTPUT_FILE, \"w\") as f:\n",
        "    json.dump(audit, f, indent=2)\n",
        "\n",
        "with open(OUTPUT_FILE, \"r\") as f:\n",
        "    reloaded = json.load(f)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 10. Report\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 90)\n",
        "print(\"STEP 3.2.9 FINAL AUDIT\")\n",
        "print(\"=\" * 90)\n",
        "\n",
        "for name, passed in checks.items():\n",
        "    print(f\"{name}: {'PASS' if passed else 'FAIL'}\")\n",
        "\n",
        "print(\"\\nPassed:\", sum(checks.values()), \"/\", len(checks))\n",
        "print(\"Status:\", audit[\"status\"])\n",
        "print(\"JSON reload:\", \"PASS\" if reloaded == audit else \"FAIL\")\n",
        "print(\"Audit file:\", OUTPUT_FILE)\n",
        "\n",
        "print(\"\\nPermanent extraction: NO\")\n",
        "print(\"Downloads: NO\")\n",
        "print(\"Installations: NO\")\n",
        "print(\"Embedding regeneration: NO\")\n",
        "print(\"=\" * 90)\n",
        "\n",
        "nested.close()"
      ],
