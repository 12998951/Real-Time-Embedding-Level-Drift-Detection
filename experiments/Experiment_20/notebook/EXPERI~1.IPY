        "\n",
        "# ============================================================\n",
        "# EXPERIMENT 20 — STEP 3.3.10.8\n",
        "# FINAL RESULTS SECTION GENERATION AND FORMATTING\n",
        "#\n",
        "# Replacement cell:\n",
        "# - Preserves the previously verified numerical results.\n",
        "# - Corrects Markdown table formatting.\n",
        "# - Validates both manuscript tables.\n",
        "# - Updates the existing JSON evidence record.\n",
        "# - Verifies output integrity.\n",
        "# - Does not modify frozen experimental source files.\n",
        "# ============================================================\n",
        "\n",
        "import json\n",
        "import hashlib\n",
        "import re\n",
        "\n",
        "from pathlib import Path\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. PATHS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "ROOT = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "\n",
        "OUT = (\n",
        "    ROOT / \"step_3_3\" / \"step_33108\"\n",
        ")\n",
        "\n",
        "MD_OUT = (\n",
        "    OUT / \"experiment20_results_section_draft_v1.md\"\n",
        ")\n",
        "\n",
        "JSON_OUT = (\n",
        "    OUT / \"experiment20_step33108_results_draft_record.json\"\n",
        ")\n",
        "\n",
        "if not MD_OUT.is_file():\n",
        "    raise FileNotFoundError(\n",
        "        f\"Results Markdown file not found: {MD_OUT}\"\n",
        "    )\n",
        "\n",
        "if not JSON_OUT.is_file():\n",
        "    raise FileNotFoundError(\n",
        "        f\"Results JSON record not found: {JSON_OUT}\"\n",
        "    )\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. LOAD EXISTING RESULTS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "original_markdown = MD_OUT.read_text(\n",
        "    encoding=\"utf-8\"\n",
        ")\n",
        "\n",
        "with open(JSON_OUT, \"r\", encoding=\"utf-8\") as f:\n",
        "    record = json.load(f)\n",
        "\n",
        "if record.get(\"step\") != \"3.3.10.8\":\n",
        "    raise ValueError(\n",
        "        \"The existing JSON record does not belong to Step 3.3.10.8.\"\n",
        "    )\n",
        "\n",
        "if record.get(\"status\") != \"RESULTS_SECTION_DRAFT_GENERATED\":\n",
        "    raise ValueError(\n",
        "        \"The previous Results draft does not have the expected status.\"\n",
        "    )\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. CORRECT MARKDOWN TABLE SPACING\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "lines = original_markdown.splitlines()\n",
        "\n",
        "corrected_lines = []\n",
        "\n",
        "for index, line in enumerate(lines):\n",
        "\n",
        "    if line.strip() == \"\":\n",
        "\n",
        "        previous_nonempty = None\n",
        "        next_nonempty = None\n",
        "\n",
        "        for j in range(len(corrected_lines) - 1, -1, -1):\n",
        "            if corrected_lines[j].strip():\n",
        "                previous_nonempty = corrected_lines[j].strip()\n",
        "                break\n",
        "\n",
        "        for j in range(index + 1, len(lines)):\n",
        "            if lines[j].strip():\n",
        "                next_nonempty = lines[j].strip()\n",
        "                break\n",
        "\n",
        "        # Remove blank lines occurring between Markdown table rows.\n",
        "        if (\n",
        "            previous_nonempty is not None\n",
        "            and next_nonempty is not None\n",
        "            and previous_nonempty.startswith(\"|\")\n",
        "            and next_nonempty.startswith(\"|\")\n",
        "        ):\n",
        "            continue\n",
        "\n",
        "    corrected_lines.append(line)\n",
        "\n",
        "corrected_markdown = \"\\n\".join(corrected_lines).rstrip() + \"\\n\"\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. VALIDATE TABLE STRUCTURE\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "table_blocks = []\n",
        "\n",
        "current_table = []\n",
        "\n",
        "for line in corrected_markdown.splitlines():\n",
        "\n",
        "    if line.strip().startswith(\"|\"):\n",
        "\n",
        "        current_table.append(line)\n",
        "\n",
        "    else:\n",
        "\n",
        "        if current_table:\n",
        "            table_blocks.append(current_table)\n",
        "            current_table = []\n",
        "\n",
        "if current_table:\n",
        "    table_blocks.append(current_table)\n",
        "\n",
        "if len(table_blocks) != 2:\n",
        "    raise ValueError(\n",
        "        f\"Expected exactly two Markdown tables; \"\n",
        "        f\"found {len(table_blocks)}.\"\n",
        "    )\n",
        "\n",
        "expected_table_rows = {\n",
        "    1: 5,  # Header + separator + 3 illumination groups\n",
        "    2: 8   # Header + separator + 6 pairwise comparisons\n",
        "}\n",
        "\n",
        "for table_number, table in enumerate(table_blocks, start=1):\n",
        "\n",
        "    expected = expected_table_rows[table_number]\n",
        "\n",
        "    if len(table) != expected:\n",
        "        raise ValueError(\n",
        "            f\"Table {table_number} contains {len(table)} lines; \"\n",
        "            f\"expected {expected}.\"\n",
        "        )\n",
        "\n",
        "    for row_number, row in enumerate(table, start=1):\n",
        "\n",
        "        if not row.startswith(\"|\") or not row.endswith(\"|\"):\n",
        "            raise ValueError(\n",
        "                f\"Malformed row in Table {table_number}, \"\n",
        "                f\"line {row_number}.\"\n",
        "            )\n",
        "\n",
        "    # Validate equal column counts.\n",
        "    column_counts = [\n",
        "        len(row.strip(\"|\").split(\"|\"))\n",
        "        for row in table\n",
        "    ]\n",
        "\n",
        "    if len(set(column_counts)) != 1:\n",
        "        raise ValueError(\n",
        "            f\"Inconsistent column counts in Table {table_number}.\"\n",
        "        )\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. VERIFY TABLE CONTENT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "if \"Near-frontal\" not in corrected_markdown:\n",
        "    raise ValueError(\"Near-frontal group is missing.\")\n",
        "\n",
        "if \"Oblique\" not in corrected_markdown:\n",
        "    raise ValueError(\"Oblique group is missing.\")\n",
        "\n",
        "if \"Large-angular deviation\" not in corrected_markdown:\n",
        "    raise ValueError(\"Large-angular group is missing.\")\n",
        "\n",
        "if corrected_markdown.count(\"4.366e-11\") != 6:\n",
        "    raise ValueError(\n",
        "        \"The six-test Holm-adjusted p-values do not appear \"\n",
        "        \"six times as expected.\"\n",
        "    )\n",
        "\n",
        "if \"0.820496\" not in corrected_markdown:\n",
        "    raise ValueError(\"Overall Euclidean mean is missing.\")\n",
        "\n",
        "if \"0.402439\" not in corrected_markdown:\n",
        "    raise ValueError(\"Overall cosine mean is missing.\")\n",
        "\n",
        "if \"0.581770\" not in corrected_markdown:\n",
        "    raise ValueError(\"Euclidean hemisphere difference is missing.\")\n",
        "\n",
        "if \"0.542807\" not in corrected_markdown:\n",
        "    raise ValueError(\"Cosine hemisphere difference is missing.\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. SAVE CORRECTED MARKDOWN\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "MD_OUT.write_text(\n",
        "    corrected_markdown,\n",
        "    encoding=\"utf-8\"\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. UPDATE EXISTING JSON RECORD\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "markdown_hash = hashlib.sha256(\n",
        "    MD_OUT.read_bytes()\n",
        ").hexdigest()\n",
        "\n",
        "record[\"draft_word_count\"] = len(\n",
        "    corrected_markdown.split()\n",
        ")\n",
        "\n",
        "record[\"markdown_output\"] = str(MD_OUT)\n",
        "\n",
        "record[\"markdown_sha256\"] = markdown_hash\n",
        "\n",
        "record[\"formatting_audit\"] = {\n",
        "    \"markdown_table_count\": len(table_blocks),\n",
        "    \"table_1_line_count\": len(table_blocks[0]),\n",
        "    \"table_2_line_count\": len(table_blocks[1]),\n",
        "    \"blank_lines_inside_tables\": 0,\n",
        "    \"table_column_consistency\": \"PASSED\",\n",
        "    \"table_row_structure\": \"PASSED\",\n",
        "    \"formatting_correction\": (\n",
        "        \"Removed blank lines between consecutive Markdown table rows.\"\n",
        "    ),\n",
        "    \"numerical_results_changed\": False\n",
        "}\n",
        "\n",
        "record[\"final_formatting_updated_utc\"] = (\n",
        "    datetime.now(timezone.utc).isoformat()\n",
        ")\n",
        "\n",
        "record[\"status\"] = \"RESULTS_SECTION_DRAFT_GENERATED\"\n",
        "\n",
        "record[\"preservation\"] = (\n",
        "    \"Original frozen experimental source files were read only \"\n",
        "    \"and were not modified. Previously verified numerical \"\n",
        "    \"results were preserved during Markdown formatting.\"\n",
        ")\n",
        "\n",
        "with open(JSON_OUT, \"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(\n",
        "        record,\n",
        "        f,\n",
        "        indent=2,\n",
        "        allow_nan=False\n",
        "    )\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 8. RELOAD AND VERIFY JSON\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "with open(JSON_OUT, \"r\", encoding=\"utf-8\") as f:\n",
        "    reloaded = json.load(f)\n",
        "\n",
        "if reloaded[\"status\"] != \"RESULTS_SECTION_DRAFT_GENERATED\":\n",
        "    raise RuntimeError(\"Final JSON status verification failed.\")\n",
        "\n",
        "if reloaded[\"formatting_audit\"][\"markdown_table_count\"] != 2:\n",
        "    raise RuntimeError(\"Markdown table count verification failed.\")\n",
        "\n",
        "if reloaded[\"formatting_audit\"][\"blank_lines_inside_tables\"] != 0:\n",
        "    raise RuntimeError(\"Markdown table spacing verification failed.\")\n",
        "\n",
        "reloaded_hash = hashlib.sha256(\n",
        "    MD_OUT.read_bytes()\n",
        ").hexdigest()\n",
        "\n",
        "if reloaded_hash != reloaded[\"markdown_sha256\"]:\n",
        "    raise RuntimeError(\"Final Markdown SHA256 verification failed.\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 9. FINAL REPORT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"=\" * 80)\n",
        "print(\"EXPERIMENT 20 — STEP 3.3.10.8\")\n",
        "print(\"FINAL RESULTS SECTION VALIDATION\")\n",
        "print(\"=\" * 80)\n",
        "\n",
        "print(\"\\n[1] MANUSCRIPT CONTENT\")\n",
