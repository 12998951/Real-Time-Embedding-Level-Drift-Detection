        "        \"sha256\": sha256_file(path)\n",
        "    })\n",
        "\n",
        "    print(f\"{key}: {len(df)} rows, {len(df.columns)} columns\")\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 6. DISPLACEMENT SCHEMA AND OVERALL STATISTICS\n",
        "# ------------------------------------------------\n",
        "\n",
        "d = data[\"displacement\"]\n",
        "\n",
        "required = [\n",
        "    \"subject\",\n",
        "    \"evaluation_condition\",\n",
        "    \"illumination_group\",\n",
