        ")\n",
        "\n",
        "studies = [\n",
        "    {\n",
        "        \"authors\": \"Zhichao and Er Meng Joo\",\n",
        "        \"year\": 2012,\n",
        "        \"title\": \"Local Relation Map: A Novel Illumination Invariant Face Recognition Approach\",\n",
        "        \"doi\": \"10.5772/51667\",\n",
        "        \"url\": \"https://doi.org/10.5772/51667\",\n",
        "        \"dataset\": \"Yale B, Extended Yale B, CMU-PIE\",\n",
        "        \"method\": \"Handcrafted local relation map and DCT-based illumination handling\",\n",
        "        \"evaluation\": \"Face recognition performance\",\n",
        "        \"overlap\": \"Yale B illumination evaluation and angular lighting subsets\",\n",
        "        \"difference\": \"Does not use the Experiment 20 fixed FaceNet embedding displacement design.\"\n",
        "    },\n",
        "    {\n",
        "        \"authors\": \"Mohammad Reza Faraji and Xiaojun Qi\",\n",
        "        \"year\": 2015,\n",
        "        \"title\": \"Face recognition under varying illumination based on adaptive homomorphic eight local directional patterns\",\n",
        "        \"doi\": \"10.1049/iet-cvi.2014.0200\",\n",
        "        \"url\": \"https://doi.org/10.1049/iet-cvi.2014.0200\",\n",
        "        \"dataset\": \"Yale B, Extended Yale B, CMU-PIE\",\n",
