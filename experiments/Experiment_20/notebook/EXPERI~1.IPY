      "cell_type": "markdown",
      "source": [
        "# Experiment 20 — Step 3.3.34: Scientific Consistency Review\n",
        "\n",
        "## Objective\n",
        "Conduct a read-only scientific consistency audit of manuscript v2.\n",
        "\n",
        "## Review areas\n",
        "\n",
        "1. Overall evaluation cohort and observation counts.\n",
        "2. Illumination geometry group counts and descriptive statistics.\n",
        "3. Identity-level Friedman and Wilcoxon results.\n",
        "4. Combined six-test Holm correction.\n",
        "5. Exploratory hemisphere comparison.\n",
        "6. Figure captions and in-text interpretation.\n",
        "7. Mathematical relationship between Euclidean displacement and cosine distance for L2-normalised embeddings.\n",
        "8. Scientific limitations and claims concerning accuracy, fairness, deployment, and generalisation.\n",
        "\n",
        "## Integrity restrictions\n",
        "- Do not edit the manuscript.\n",
        "- Do not modify frozen figures or statistical CSVs.\n",
        "- Do not recalculate or overwrite experimental results.\n",
        "- Record discrepancies separately.\n",
        "- Distinguish confirmed errors from wording or interpretation concerns.\n",
        "\n",
        "## Expected outcome\n",
        "A prioritised scientific consistency report identifying any remaining issues before final manuscript freeze."
      ],
      "metadata": {
        "id": "bc7uCrFfK6v7"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# EXPERIMENT 20 — STEP 3.3.34\n",
        "# SCIENTIFIC CONSISTENCY REVIEW\n",
        "# READ-ONLY\n",
        "# ============================================================\n",
        "\n",
        "import os\n",
        "import re\n",
        "import json\n",
        "import hashlib\n",
        "import pandas as pd\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "BASE = \"/content/drive/MyDrive/Experiment_20_Results\"\n",
        "\n",
        "MANUSCRIPT = os.path.join(\n",
        "    BASE, \"step_3_3\", \"step_3330\",\n",
        "    \"experiment20_integrated_manuscript_v2.md\"\n",
        ")\n",
        "\n",
        "FREEZE = os.path.join(\n",
        "    BASE, \"step_2_7\", \"final_freeze\"\n",
        ")\n",
        "\n",
        "FILES = {\n",
        "    \"group_descriptive\": os.path.join(\n",
        "        FREEZE, \"experiment20_group_descriptive_statistics.csv\"\n",
        "    ),\n",
        "    \"paired_comparisons\": os.path.join(\n",
        "        FREEZE, \"experiment20_paired_comparison_results.csv\"\n",
        "    ),\n",
        "    \"hemisphere_comparisons\": os.path.join(\n",
        "        FREEZE, \"experiment20_hemisphere_comparison_results.csv\"\n",
        "    ),\n",
        "    \"identity_group_means\": os.path.join(\n",
        "        FREEZE, \"experiment20_identity_level_group_means.csv\"\n",
        "    ),\n",
        "    \"identity_hemisphere_means\": os.path.join(\n",
        "        FREEZE, \"experiment20_identity_level_hemisphere_means.csv\"\n",
        "    )\n",
        "}\n",
        "\n",
        "OUTPUT_DIR = os.path.join(\n",
        "    BASE, \"step_3_3\", \"step_3334\"\n",
        ")\n",
        "os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
        "\n",
        "REPORT_PATH = os.path.join(\n",
        "    OUTPUT_DIR,\n",
        "    \"experiment20_step3334_scientific_consistency_review.json\"\n",
        ")\n",
        "\n",
        "\n",
        "def sha256_file(path):\n",
        "    h = hashlib.sha256()\n",
        "    with open(path, \"rb\") as f:\n",
        "        for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n",
        "            h.update(chunk)\n",
        "    return h.hexdigest()\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. LOAD MANUSCRIPT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "if not os.path.isfile(MANUSCRIPT):\n",
        "    raise FileNotFoundError(MANUSCRIPT)\n",
        "\n",
        "with open(MANUSCRIPT, \"r\", encoding=\"utf-8\") as f:\n",
        "    text = f.read()\n",
        "\n",
        "manuscript_hash = sha256_file(MANUSCRIPT)\n",
        "\n",
        "print(\"=\" * 100)\n",
        "print(\"STEP 3.3.34 — SCIENTIFIC CONSISTENCY REVIEW\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "print(\"Manuscript:\", MANUSCRIPT)\n",
        "print(\"SHA256:\", manuscript_hash)\n",
        "print(\"Word count:\", len(text.split()))\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. INSPECT ACTUAL CSV FILE AVAILABILITY\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "available_files = {}\n",
        "\n",
        "for name, path in FILES.items():\n",
        "\n",
        "    if os.path.isfile(path):\n",
        "        available_files[name] = {\n",
        "            \"path\": path,\n",
        "            \"sha256\": sha256_file(path),\n",
        "            \"available\": True\n",
        "        }\n",
        "        print(\"\\nAVAILABLE:\", name)\n",
        "        print(\"SHA256:\", available_files[name][\"sha256\"])\n",
        "    else:\n",
        "        available_files[name] = {\n",
        "            \"path\": path,\n",
        "            \"available\": False\n",
        "        }\n",
        "        print(\"\\nNOT FOUND:\", name)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. CHECK MANUSCRIPT CLAIMS AND COUNTS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "expected_text_checks = {\n",
        "    \"source_images_2414\": \"2,414 standard-illumination images\",\n",
        "    \"identities_38\": \"38 identities\",\n",
        "    \"common_conditions_57\": \"57 common illumination conditions\",\n",
        "    \"evaluation_observations_2128\": \"2,128 non-reference observations\",\n",
        "    \"evaluation_conditions_56\": \"56 common evaluation conditions\",\n",
        "    \"near_frontal_observations_646\": \"646\",\n",
        "    \"oblique_observations_418\": \"418\",\n",
        "    \"large_angular_observations_1064\": \"1,064\",\n",
        "    \"euclidean_overall_mean\": \"0.820496\",\n",
        "    \"euclidean_overall_median\": \"0.817311\",\n",
        "    \"cosine_overall_mean\": \"0.402439\",\n",
        "    \"cosine_overall_median\": \"0.333999\",\n",
        "    \"near_frontal_euclidean\": \"0.401897\",\n",
        "    \"oblique_euclidean\": \"0.708976\",\n",
        "    \"large_angular_euclidean\": \"1.118457\",\n",
        "    \"near_frontal_cosine\": \"0.086877\",\n",
        "    \"oblique_cosine\": \"0.262274\",\n",
        "    \"large_angular_cosine\": \"0.649095\",\n",
        "    \"friedman_statistic\": \"χ²(2) = 76.0\",\n",
        "    \"kendall_w\": \"Kendall's W = 1.0\",\n",
        "    \"combined_holm_family\": \"one combined family of six comparisons\",\n",
        "    \"hemisphere_euclidean_difference\": \"0.581770\",\n",
        "    \"hemisphere_cosine_difference\": \"0.542807\",\n",
        "    \"hemisphere_exploratory\": \"This comparison is exploratory.\"\n",
        "}\n",
        "\n",
        "text_checks = {}\n",
        "\n",
        "for name, phrase in expected_text_checks.items():\n",
        "    text_checks[name] = phrase in text\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"MANUSCRIPT TEXT CHECKS\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "for name, passed in text_checks.items():\n",
        "    print(name, passed)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. CHECK NUMERICAL DATA AGAINST AVAILABLE CSV SCHEMAS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "csv_inspection = {}\n",
        "\n",
        "for name, info in available_files.items():\n",
        "\n",
        "    if not info[\"available\"]:\n",
        "        continue\n",
        "\n",
        "    df = pd.read_csv(info[\"path\"])\n",
        "\n",
        "    csv_inspection[name] = {\n",
        "        \"rows\": len(df),\n",
        "        \"columns\": list(df.columns),\n",
        "        \"dtypes\": {\n",
        "            col: str(dtype)\n",
        "            for col, dtype in df.dtypes.items()\n",
        "        }\n",
        "    }\n",
        "\n",
        "    print(\"\\n\" + \"-\" * 100)\n",
        "    print(\"CSV:\", name)\n",
        "    print(\"Rows:\", len(df))\n",
        "    print(\"Columns:\", list(df.columns))\n",
        "    print(df.head(3).to_string(index=False))\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. CHECK PAIRED COMPARISON RESULTS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "paired_checks = {\n",
        "    \"available\": False\n",
        "}\n",
        "\n",
        "if available_files[\"paired_comparisons\"][\"available\"]:\n",
        "\n",
        "    df = pd.read_csv(FILES[\"paired_comparisons\"])\n",
        "\n",
        "    paired_checks[\"available\"] = True\n",
        "    paired_checks[\"row_count\"] = len(df)\n",
        "\n",
        "    if \"raw_p_value\" in df.columns:\n",
        "        paired_checks[\"raw_p_values\"] = sorted(\n",
        "            df[\"raw_p_value\"].astype(float).unique().tolist()\n",
        "        )\n",
        "\n",
        "    if \"holm_adjusted_p_value\" in df.columns:\n",
        "        paired_checks[\"frozen_holm_values\"] = sorted(\n",
        "            df[\"holm_adjusted_p_value\"].astype(float).unique().tolist()\n",
        "        )\n",
        "\n",
        "    paired_checks[\"six_rows_present\"] = len(df) == 6\n",
        "\n",
        "print(\"\\nPAIRED COMPARISON CHECKS\")\n",
        "print(json.dumps(paired_checks, indent=2))\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. CHECK HEMISPHERE RESULTS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "hemisphere_checks = {\n",
        "    \"available\": False\n",
        "}\n",
        "\n",
        "if available_files[\"hemisphere_comparisons\"][\"available\"]:\n",
        "\n",
        "    df = pd.read_csv(FILES[\"hemisphere_comparisons\"])\n",
        "\n",
        "    hemisphere_checks[\"available\"] = True\n",
        "    hemisphere_checks[\"row_count\"] = len(df)\n",
        "    hemisphere_checks[\"columns\"] = list(df.columns)\n",
        "\n",
        "    print(\"\\nHEMISPHERE CSV CONTENT\")\n",
        "    print(df.to_string(index=False))\n",
        "\n",
        "print(\"\\nHEMISPHERE CHECKS\")\n",
        "print(json.dumps(hemisphere_checks, indent=2, default=str))\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. MATHEMATICAL RELATIONSHIP CHECK\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "normalisation_statement_present = bool(\n",
        "    re.search(\n",
        "        r\"L2[- ]normal\",\n",
        "        text,\n",
        "        flags=re.IGNORECASE\n",
        "    )\n",
        ")\n",
        "\n",
        "relationship_statement_present = bool(\n",
        "    re.search(\n",
        "        r\"Euclidean.*cosine|cosine.*Euclidean\",\n",
        "        text,\n",
        "        flags=re.IGNORECASE\n",
        "    )\n",
        ")\n",
        "\n",
        "mathematical_review = {\n",
        "    \"l2_normalisation_mentioned\": normalisation_statement_present,\n",
        "    \"euclidean_cosine_relationship_discussed\": relationship_statement_present,\n",
        "    \"review_note\": (\n",
        "        \"For unit-normalised embeddings, squared Euclidean distance \"\n",
        "        \"equals twice cosine distance. The two metrics should not be \"\n",
        "        \"presented as independent evidence.\"\n",
        "    )\n",
        "}\n",
        "\n",
        "print(\"\\nMATHEMATICAL RELATIONSHIP\")\n",
        "print(json.dumps(mathematical_review, indent=2))\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 8. CLAIMS AND LIMITATIONS SCAN\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "claim_patterns = {\n",
        "    \"accuracy_claim\": r\"\\b(accuracy|recognition rate|verification rate)\\b\",\n",
        "    \"fairness_claim\": r\"\\b(fairness|bias mitigation|demographic parity)\\b\",\n",
        "    \"deployment_claim\": r\"\\b(deployment-ready|production-ready|operational readiness)\\b\",\n",
        "    \"generalisation_claim\": r\"\\b(generalises|generalization|generalisation)\\b\",\n",
        "    \"causal_claim\": r\"\\b(causes?|causal effect|causally)\\b\",\n",
        "    \"drift_detection_claim\": r\"\\b(drift detector|drift detection performance)\\b\"\n",
        "}\n",
        "\n",
        "claim_scan = {}\n",
        "\n",
        "for name, pattern in claim_patterns.items():\n",
        "\n",
        "    matches = []\n",
        "\n",
        "    for index, line in enumerate(text.splitlines(), 1):\n",
        "\n",
        "        if re.search(pattern, line, flags=re.IGNORECASE):\n",
        "            matches.append({\n",
        "                \"line\": index,\n",
        "                \"text\": line.strip()\n",
        "            })\n",
        "\n",
        "    claim_scan[name] = matches\n",
        "\n",
        "print(\"\\nCLAIM SCAN\")\n",
        "for name, matches in claim_scan.items():\n",
        "    print(\"\\n\", name, \"| matches:\", len(matches))\n",
        "    for item in matches[:10]:\n",
        "        print(item[\"line\"], item[\"text\"])\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 9. CAPTION AND FIGURE INTERPRETATION CHECKS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "caption_checks = {\n",
        "    \"figure1_identity_level\": (\n",
        "        \"Figure 1. Identity-level Euclidean displacement\" in text\n",
        "    ),\n",
        "    \"figure2_identity_level\": (\n",
        "        \"Figure 2. Identity-level cosine distance\" in text\n",
        "    ),\n",
        "    \"figure3_exploratory\": (\n",
        "        \"Figure 3. Paired identity-level Euclidean displacement\" in text\n",
        "        and \"This comparison is exploratory.\" in text\n",
        "    ),\n",
        "    \"figure4_exploratory\": (\n",
        "        \"Figure 4. Paired identity-level cosine distance\" in text\n",
        "        and \"This comparison is exploratory.\" in text\n",
        "    )\n",
        "}\n",
        "\n",
        "print(\"\\nCAPTION CHECKS\")\n",
        "for name, passed in caption_checks.items():\n",
        "    print(name, passed)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 10. CREATE REVIEW REGISTER\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "review_items = []\n",
        "\n",
        "if not all(text_checks.values()):\n",
        "    review_items.append({\n",
        "        \"severity\": \"MAJOR\",\n",
        "        \"issue\": \"One or more expected numerical or methodological statements are missing.\",\n",
        "        \"status\": \"REVIEW_REQUIRED\"\n",
        "    })\n",
        "\n",
        "if not normalisation_statement_present:\n",
        "    review_items.append({\n",
        "        \"severity\": \"MAJOR\",\n",
        "        \"issue\": \"L2 normalisation statement not detected.\",\n",
        "        \"status\": \"REVIEW_REQUIRED\"\n",
        "    })\n",
        "\n",
        "if not relationship_statement_present:\n",
        "    review_items.append({\n",
        "        \"severity\": \"MODERATE\",\n",
        "        \"issue\": \"Explicit Euclidean-cosine mathematical relationship not detected.\",\n",
        "        \"status\": \"SCIENTIFIC_INTERPRETATION_REVIEW\"\n",
        "    })\n",
        "\n",
        "if not all(caption_checks.values()):\n",
        "    review_items.append({\n",
        "        \"severity\": \"MODERATE\",\n",
        "        \"issue\": \"One or more figure captions require review.\",\n",
        "        \"status\": \"REVIEW_REQUIRED\"\n",
        "    })\n",
        "\n",
        "if not paired_checks.get(\"six_rows_present\", False):\n",
        "    review_items.append({\n",
        "        \"severity\": \"MAJOR\",\n",
        "        \"issue\": \"Six paired comparisons were not confirmed in the frozen CSV.\",\n",
        "        \"status\": \"REVIEW_REQUIRED\"\n",
        "    })\n",
        "\n",
        "if not hemisphere_checks.get(\"available\", False):\n",
        "    review_items.append({\n",
        "        \"severity\": \"MAJOR\",\n",
        "        \"issue\": \"Hemisphere comparison CSV was unavailable.\",\n",
        "        \"status\": \"REVIEW_REQUIRED\"\n",
        "    })\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 11. SAVE REPORT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "report = {\n",
        "    \"step\": \"3.3.34\",\n",
        "    \"title\": \"Scientific Consistency Review\",\n",
        "    \"created_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "\n",
        "    \"manuscript\": {\n",
        "        \"path\": MANUSCRIPT,\n",
        "        \"sha256\": manuscript_hash,\n",
        "        \"word_count\": len(text.split())\n",
        "    },\n",
        "\n",
        "    \"source_files\": available_files,\n",
        "    \"csv_inspection\": csv_inspection,\n",
        "\n",
        "    \"text_checks\": text_checks,\n",
        "    \"paired_comparison_checks\": paired_checks,\n",
        "    \"hemisphere_checks\": hemisphere_checks,\n",
        "    \"mathematical_relationship_review\": mathematical_review,\n",
        "    \"claim_scan\": claim_scan,\n",
        "    \"caption_checks\": caption_checks,\n",
        "\n",
        "    \"review_register\": review_items,\n",
        "\n",
        "    \"status\": (\n",
        "        \"SCIENTIFIC_CONSISTENCY_REVIEW_COMPLETED\"\n",
        "        if not review_items\n",
        "        else \"SCIENTIFIC_REVIEW_ITEMS_REMAIN\"\n",
        "    ),\n",
        "\n",
        "    \"integrity\": {\n",
        "        \"manuscript_modified\": False,\n",
        "        \"statistical_csvs_modified\": False,\n",
        "        \"figures_modified\": False,\n",
        "        \"frozen_evidence_modified\": False\n",
        "    }\n",
        "}\n",
        "\n",
        "with open(REPORT_PATH, \"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(report, f, indent=2, default=str)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"FINAL REVIEW SUMMARY\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "print(\"Text checks passed:\", sum(text_checks.values()), \"/\", len(text_checks))\n",
        "print(\"Caption checks passed:\", sum(caption_checks.values()), \"/\", len(caption_checks))\n",
        "print(\"Review items:\", len(review_items))\n",
        "\n",
        "for item in review_items:\n",
        "    print(\n",
        "        item[\"severity\"],\n",
        "        \"|\",\n",
        "        item[\"issue\"],\n",
        "        \"|\",\n",
        "        item[\"status\"]\n",
        "    )\n",
        "\n",
        "print(\"\\nSTATUS:\", report[\"status\"])\n",
        "print(\"Report:\", REPORT_PATH)\n",
        "print(\"Report SHA256:\", sha256_file(REPORT_PATH))\n",
        "print(\"No existing files were modified.\")\n",
        "print(\"STEP 3.3.34 COMPLETED\")"
      ],
