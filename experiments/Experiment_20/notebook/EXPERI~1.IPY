        "        \"illumination\" in abstract.lower()\n",
        "    ),\n",
        "\n",
        "    \"sample_size_present\": (\n",
        "        \"2,128\" in abstract or \"2128\" in abstract\n",
        "    ),\n",
        "\n",
        "    \"three_geometry_groups_present\": (\n",
        "        \"near-frontal\" in abstract.lower()\n",
        "        and \"oblique\" in abstract.lower()\n",
