) : 2\\n\",\"(3, 238) : 1\\n\",\"(3, 240) : 1\\n\",\"(3, 241) : 1\\n\",\"(3, 243) : 2\\n\",\"(3, 245) : 1\\n\",\"(3, 247) : 2\\n\",\"(3, 248) : 1\\n\",\"(3, 249) : 1\\n\",\"(3, 250) : 1\\n\",\"(3, 251) : 1\\n\",\"(3, 252) : 5\\n\",\"(3, 253) : 4\\n\",\"(3, 254) : 4\\n\",\"(3, 255) : 45\\n\",\"(4, 196) : 1\\n\",\"(4, 213) : 1\\n\",\"(4, 214) : 1\\n\",\"(4, 220) : 1\\n\",\"(4, 221) : 1\\n\",\"(4, 224) : 1\\n\",\"(4, 227) : 1\\n\",\"(4, 228) : 2\\n\",\"(4, 229) : 1\\n\",\"(4, 231) : 1\\n\",\"(4, 242) : 1\\n\",\"(4, 243) : 2\\n\",\"(4, 247) : 2\\n\",\"(4, 248) : 3\\n\",\"(4, 249) : 1\\n\",\"(4, 251) : 1\\n\",\"(4, 252) : 1\\n\",\"(4, 253) : 1\\n\",\"(4, 254) : 3\\n\",\"(4, 255) : 33\\n\",\"(5, 213) : 1\\n\",\"(5, 215) : 1\\n\",\"(5, 216) : 1\\n\",\"(5, 237) : 1\\n\",\"(5, 238) : 1\\n\",\"(5, 243) : 1\\n\",\"(5, 246) : 1\\n\",\"(5, 247) : 1\\n\",\"(5, 248) : 2\\n\",\"(5, 249) : 1\\n\",\"(5, 251) : 1\\n\",\"(5, 252) : 1\\n\",\"(5, 253) : 1\\n\",\"(5, 254) : 4\\n\",\"(5, 255) : 32\\n\",\"(6, 203) : 1\\n\",\"(6, 216) : 1\\n\",\"(6, 220) : 1\\n\",\"(6, 243) : 1\\n\",\"(6, 244) : 1\\n\",\"(6, 245) : 3\\n\",\"(6, 249) : 1\\n\",\"(6, 250) : 1\\n\",\"(6, 251) : 1\\n\",\"(6, 253) : 2\\n\",\"(6, 254) : 1\\n\",\"(6, 255) : 19\\n\",\"(7, 220) : 1\\n\",\"(7, 238) : 1\\n\",\"(7, 246) : 1\\n\",\"(7, 250) : 1\\n\",\"(7, 254) : 1\\n\",\"(7, 255) : 15\\n\",\"(8, 249) : 1\\n\",\"(8, 255) : 10\\n\",\"(9, 221) : 1\\n\",\"(9, 240) : 1\\n\",\"(9, 246) : 1\\n\",\"(9, 250) : 1\\n\",\"(9, 255) : 5\\n\",\"(10, 255) : 8\\n\",\"(11, 221) : 1\\n\",\"(11, 255) : 7\\n\",\"(12, 224) : 1\\n\",\"(12, 251) : 1\\n\",\"(12, 255) : 2\\n\",\"(13, 248) : 1\\n\",\"(14, 249) : 1\\n\",\"(14, 255) : 2\\n\",\"(16, 255) : 1\\n\",\"(17, 255) : 1\\n\",\"(18, 255) : 1\\n\",\"\\n\",\"[5] SUBJECT DIMENSION CONSISTENCY\\n\",\"yaleB01 {'168x192': 65}\\n\",\"yaleB02 {'168x192': 65}\\n\",\"yaleB03 {'168x192': 65}\\n\",\"yaleB04 {'168x192': 65}\\n\",\"yaleB05 {'168x192': 65}\\n\",\"yaleB06 {'168x192': 65}\\n\",\"yaleB07 {'168x192': 65}\\n\",\"yaleB08 {'168x192': 65}\\n\",\"yaleB09 {'168x192': 65}\\n\",\"yaleB10 {'168x192': 65}\\n\",\"yaleB11 {'168x192': 60, '640x480': 1}\\n\",\"yaleB12 {'168x192': 59, '640x480': 1}\\n\",\"yaleB13 {'168x192': 60, '640x480': 1}\\n\",\"yaleB15 {'168x192': 63, '640x480': 1}\\n\",\"yaleB16 {'168x192': 62, '640x480': 1}\\n\",\"yaleB17 {'168x192': 63, '640x480': 1}\\n\",\"yaleB18 {'168x192': 63, '640x480': 1}\\n\",\"yaleB19 {'168x192': 64, '640x480': 1}\\n\",\"yaleB20 {'168x192': 64, '640x480': 1}\\n\",\"yaleB21 {'168x192': 64, '640x480': 1}\\n\",\"yaleB22 {'168x192': 64, '640x480': 1}\\n\",\"yaleB23 {'168x192': 64, '640x480': 1}\\n\",\"yaleB24 {'168x192': 64, '640x480': 1}\\n\",\"yaleB25 {'168x192': 64, '640x480': 1}\\n\",\"yaleB26 {'168x192': 64, '640x480': 1}\\n\",\"yaleB27 {'168x192': 64, '640x480': 1}\\n\",\"yaleB28 {'168x192': 64, '640x480': 1}\\n\",\"yaleB29 {'168x192': 64, '640x480': 1}\\n\",\"yaleB30 {'168x192': 64, '640x480': 1}\\n\",\"yaleB31 {'168x192': 64, '640x480': 1}\\n\",\"yaleB32 {'168x192': 64, '640x480': 1}\\n\",\"yaleB33 {'168x192': 64, '640x480': 1}\\n\",\"yaleB34 {'168x192': 64, '640x480': 1}\\n\",\"yaleB35 {'168x192': 64, '640x480': 1}\\n\",\"yaleB36 {'168x192': 64, '640x480': 1}\\n\",\"yaleB37 {'168x192': 64, '640x480': 1}\\n\",\"yaleB38 {'168x192': 64, '640x480': 1}\\n\",\"yaleB39 {'168x192': 64, '640x480': 1}\\n\",\"\\n\",\"[6] GLOBAL INTENSITY STATISTICS\\n\",\"{'mean_of_image_means': 68.64474812613742, 'median_of_image_means': 68.99517919146825, 'minimum_image_mean': 0.10317460317460317, 'maximum_image_mean': 186.71475074404762}\\n\",\"\\n\",\"[7] AUDIT SAVED\\n\",\"/content/drive/MyDrive/Experiment_20_Results/dataset_audit/experiment20_croppedyale_image_integrity_audit.json\\n\",\"\\n\",\"IMAGE INTEGRITY AUDIT COMPLETE.\\n\",\"No extraction or embedding generation performed.\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"## EXPERIMENT 20 — STEP 2.6.10: COMMON ILLUMINATION-CONDITION INTERSECTION\\n\",\"\\n\",\"Determine the illumination conditions shared by all subjects in the Cropped Extended Yale B dataset.\\n\",\"\\n\",\"Protocol:\\n\",\"1. Include only standard illumination images matching the P00 filename pattern.\\n\",\"2. Exclude all ambient reference images.\\n\",\"3. Verify that included images have dimensions 168 × 192.\\n\",\"4. Calculate the intersection of illumination conditions across all subjects.\\n\",\"5. Report missing conditions and per-subject coverage.\\n\",\"6. Save the common-condition manifest and audit.\\n\",\"\\n\",\"No images will be modified, extracted, or embedded.\"],\"metadata\":{\"id\":\"D_aKuHR6q1z2\"}},{\"cell_type\":\"code\",\"source\":[\"import os\\n\",\"import re\\n\",\"import json\\n\",\"import zipfile\\n\",\"from collections import defaultdict\\n\",\"from datetime import datetime, timezone\\n\",\"from PIL import Image\\n\",\"from io import BytesIO\\n\",\"\\n\",\"ARCHIVE_PATH = \\\"/content/Experiment20_Downloads/CroppedYale.zip\\\"\\n\",\"\\n\",\"AUDIT_DIR = (\\n\",\"    \\\"/content/drive/MyDrive/Experiment_20_Results/dataset_audit\\\"\\n\",\")\\n\",\"\\n\",\"OUTPUT_PATH = os.path.join(\\n\",\"    AUDIT_DIR,\\n\",\"    \\\"experiment20_common_illumination_condition_audit.json\\\"\\n\",\")\\n\",\"\\n\",\"MANIFEST_PATH = os.path.join(\\n\",\"    AUDIT_DIR,\\n\",\"    \\\"experiment20_common_illumination_condition_manifest.json\\\"\\n\",\")\\n\",\"\\n\",\"os.makedirs(AUDIT_DIR, exist_ok=True)\\n\",\"\\n\",\"pattern = re.compile(\\n\",\"    r\\\"^(yaleB\\\\d+)_P00A([+-]\\\\d{3})E([+-]\\\\d{2})\\\\.pgm$\\\",\\n\",\"    re.IGNORECASE\\n\",\")\\n\",\"\\n\",\"subject_conditions = defaultdict(dict)\\n\",\"ambient_dimensions = {}\\n\",\"dimension_errors = []\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 2.6.10: COMMON CONDITION AUDIT\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"with zipfile.ZipFile(ARCHIVE_PATH, \\\"r\\\") as archive:\\n\",\"\\n\",\"    pgm_files = [\\n\",\"        name for name in archive.namelist()\\n\",\"        if name.lower().endswith(\\\".pgm\\\")\\n\",\"    ]\\n\",\"\\n\",\"    for path in pgm_files:\\n\",\"\\n\",\"        filename = os.path.basename(path)\\n\",\"        match = pattern.match(filename)\\n\",\"\\n\",\"        # Ambient images are recorded separately and excluded.\\n\",\"        if filename.lower().endswith(\\\"_ambient.pgm\\\"):\\n\",\"            with Image.open(BytesIO(archive.read(path))) as image:\\n\",\"                ambient_dimensions[path] = list(image.size)\\n\",\"            continue\\n\",\"\\n\",\"        if not match:\\n\",\"            continue\\n\",\"\\n\",\"        subject, azimuth, elevation = match.groups()\\n\",\"        condition = f\\\"A{azimuth}E{elevation}\\\"\\n\",\"\\n\",\"        with Image.open(BytesIO(archive.read(path))) as image:\\n\",\"            image.load()\\n\",\"            dimensions = list(image.size)\\n\",\"\\n\",\"        if dimensions != [168, 192]:\\n\",\"            dimension_errors.append({\\n\",\"                \\\"path\\\": path,\\n\",\"                \\\"dimensions\\\": dimensions\\n\",\"            })\\n\",\"            continue\\n\",\"\\n\",\"        subject_conditions[subject][condition] = path\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 1. SUBJECT INVENTORY\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"subjects = sorted(subject_conditions)\\n\",\"\\n\",\"print(\\\"\\\\n[1] SUBJECT INVENTORY\\\")\\n\",\"print(\\\"Subjects with standard illumination images:\\\", len(subjects))\\n\",\"\\n\",\"if not subjects:\\n\",\"    raise RuntimeError(\\\"No valid subjects found.\\\")\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 2. COMMON CONDITION INTERSECTION\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"condition_sets = [\\n\",\"    set(subject_conditions[subject])\\n\",\"    for subject in subjects\\n\",\"]\\n\",\"\\n\",\"common_conditions = sorted(\\n\",\"    set.intersection(*condition_sets)\\n\",\")\\n\",\"\\n\",\"union_conditions = sorted(\\n\",\"    set.union(*condition_sets)\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n[2] CONDITION INTERSECTION\\\")\\n\",\"print(\\\"Unique conditions across subjects:\\\", len(union_conditions))\\n\",\"print(\\\"Conditions shared by every subject:\\\", len(common_conditions))\\n\",\"print(\\\"Conditions not shared by every subject:\\\",\\n\",\"      len(union_conditions) - len(common_conditions))\\n\",\"\\n\",\"print(\\\"\\\\nCommon conditions:\\\")\\n\",\"for condition in common_conditions:\\n\",\"    print(condition)\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 3. SUBJECT-LEVEL COVERAGE\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[3] SUBJECT COVERAGE\\\")\\n\",\"\\n\",\"coverage = {}\\n\",\"\\n\",\"for subject in subjects:\\n\",\"\\n\",\"    available = set(subject_conditions[subject])\\n\",\"    missing_common = sorted(\\n\",\"        set(common_conditions) - available\\n\",\"    )\\n\",\"\\n\",\"    coverage[subject] = {\\n\",\"        \\\"available_condition_count\\\": len(available),\\n\",\"        \\\"common_condition_count\\\": len(\\n\",\"            available.intersection(common_conditions)\\n\",\"        ),\\n\",\"        \\\"missing_common_conditions\\\": missing_common\\n\",\"    }\\n\",\"\\n\",\"    print(\\n\",\"        subject,\\n\",\"        \\\"| available:\\\", len(available),\\n\",\"        \\\"| common:\\\", len(available.intersection(common_conditions))\\n\",\"    )\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 4. AMBIENT IMAGE DIMENSIONS\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[4] AMBIENT IMAGE DIMENSIONS\\\")\\n\",\"\\n\",\"ambient_dimension_counts = {}\\n\",\"\\n\",\"for dimensions in ambient_dimensions.values():\\n\",\"    key = f\\\"{dimensions[0]}x{dimensions[1]}\\\"\\n\",\"    ambient_dimension_counts[key] = (\\n\",\"        ambient_dimension_counts.get(key, 0) + 1\\n\",\"    )\\n\",\"\\n\",\"print(ambient_dimension_counts)\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 5. VALIDATION\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[5] VALIDATION\\\")\\n\",\"\\n\",\"print(\\\"Unexpected standard-image dimensions:\\\", len(dimension_errors))\\n\",\"\\n\",\"if dimension_errors:\\n\",\"    for item in dimension_errors:\\n\",\"        print(item)\\n\",\"\\n\",\"if len(common_conditions) == 0:\\n\",\"    raise RuntimeError(\\n\",\"        \\\"No illumination conditions are shared by every subject.\\\"\\n\",\"    )\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 6. SAVE MANIFEST AND AUDIT\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"manifest = {\\n\",\"    \\\"dataset\\\": \\\"Cropped Extended Yale B\\\",\\n\",\"    \\\"pose\\\": \\\"P00\\\",\\n\",\"    \\\"ambient_images_included\\\": False,\\n\",\"    \\\"image_dimensions\\\": [168, 192],\\n\",\"    \\\"subjects\\\": subjects,\\n\",\"    \\\"common_illumination_conditions\\\": common_conditions,\\n\",\"    \\\"image_paths_by_subject\\\": {\\n\",\"        subject: {\\n\",\"            condition: subject_conditions[subject][condition]\\n\",\"            for condition in common_conditions\\n\",\"        }\\n\",\"        for subject in subjects\\n\",\"    }\\n\",\"}\\n\",\"\\n\",\"audit = {\\n\",\"    \\\"step\\\": \\\"2.6.10\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"archive_path\\\": ARCHIVE_PATH,\\n\",\"    \\\"subject_count\\\": len(subjects),\\n\",\"    \\\"union_condition_count\\\": len(union_conditions),\\n\",\"    \\\"common_condition_count\\\": len(common_conditions),\\n\",\"    \\\"common_conditions\\\": common_conditions,\\n\",\"    \\\"subject_coverage\\\": coverage,\\n\",\"    \\\"ambient_image_count\\\": len(ambient_dimensions),\\n\",\"    \\\"ambient_dimension_counts\\\": ambient_dimension_counts,\\n\",\"    \\\"unexpected_standard_image_dimensions\\\": dimension_errors,\\n\",\"    \\\"ambient_images_excluded\\\": True,\\n\",\"    \\\"acceptance_status\\\": \\\"PENDING_EXPERIMENTAL_PROTOCOL_REVIEW\\\"\\n\",\"}\\n\",\"\\n\",\"with open(MANIFEST_PATH, \\\"w\\\") as f:\\n\",\"    json.dump(manifest, f, indent=2)\\n\",\"\\n\",\"with open(OUTPUT_PATH, \\\"w\\\") as f:\\n\",\"    json.dump(audit, f, indent=2)\\n\",\"\\n\",\"print(\\\"\\\\n[6] FILES SAVED\\\")\\n\",\"print(\\\"Audit:\\\", OUTPUT_PATH)\\n\",\"print(\\\"Manifest:\\\", MANIFEST_PATH)\\n\",\"\\n\",\"print(\\\"\\\\nSTEP 2.6.10 COMPLETE\\\")\\n\",\"print(\\\"No extraction or embedding generation performed.\\\")\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"cYkJt4k0q3pH\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794351271817,\"user_tz\":360,\"elapsed\":2843,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"a1db19dc-f3cb-400c-e733-263e4b71ae07\"},\"execution_count\":null,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"===========================================================================\\n\",\"EXPERIMENT 20 — STEP 2.6.10: COMMON CONDITION AUDIT\\n\",\"===========================================================================\\n\",\"\\n\",\"[1] SUBJECT INVENTORY\\n\",\"Subjects with standard illumination images: 38\\n\",\"\\n\",\"[2] CONDITION INTERSECTION\\n\",\"Unique conditions across subjects: 64\\n\",\"Conditions shared by every subject: 57\\n\",\"Conditions not shared by every subject: 7\\n\",\"\\n\",\"Common conditions:\\n\",\"A+000E+00\\n\",\"A+000E+20\\n\",\"A+000E+45\\n\",\"A+000E+90\\n\",\"A+000E-20\\n\",\"A+000E-35\\n\",\"A+005E+10\\n\",\"A+005E-10\\n\",\"A+010E+00\\n\",\"A+010E-20\\n\",\"A+015E+20\\n\",\"A+020E+10\\n\",\"A+020E-10\\n\",\"A+020E-40\\n\",\"A+025E+00\\n\",\"A+035E+15\\n\",\"A+035E+40\\n\",\"A+035E+65\\n\",\"A+035E-20\\n\",\"A+050E+00\\n\",\"A+060E+20\\n\",\"A+060E-20\\n\",\"A+070E+00\\n\",\"A+070E+45\\n\",\"A+070E-35\\n\",\"A+085E+20\\n\",\"A+085E-20\\n\",\"A+110E+15\\n\",\"A+110E+40\\n\",\"A+110E+65\\n\",\"A+110E-20\\n\",\"A+120E+00\\n\",\"A+130E+20\\n\",\"A-005E+10\\n\",\"A-005E-10\\n\",\"A-010E-20\\n\",\"A-015E+20\\n\",\"A-020E+10\\n\",\"A-020E-10\\n\",\"A-020E-40\\n\",\"A-025E+00\\n\",\"A-035E+15\\n\",\"A-035E+65\\n\",\"A-035E-20\\n\",\"A-050E+00\\n\",\"A-060E+20\\n\",\"A-060E-20\\n\",\"A-070E+00\\n\",\"A-070E+45\\n\",\"A-070E-35\\n\",\"A-085E+20\\n\",\"A-085E-20\\n\",\"A-095E+00\\n\",\"A-110E+40\\n\",\"A-110E+65\\n\",\"A-120E+00\\n\",\"A-130E+20\\n\",\"\\n\",\"[3] SUBJECT COVERAGE\\n\",\"yaleB01 | available: 64 | common: 57\\n\",\"yaleB02 | available: 64 | common: 57\\n\",\"yaleB03 | available: 64 | common: 57\\n\",\"yaleB04 | available: 64 | common: 57\\n\",\"yaleB05 | available: 64 | common: 57\\n\",\"yaleB06 | available: 64 | common: 57\\n\",\"yaleB07 | available: 64 | common: 57\\n\",\"yaleB08 | available: 64 | common: 57\\n\",\"yaleB09 | available: 64 | common: 57\\n\",\"yaleB10 | available: 64 | common: 57\\n\",\"yaleB11 | available: 60 | common: 57\\n\",\"yaleB12 | available: 59 | common: 57\\n\",\"yaleB13 | available: 60 | common: 57\\n\",\"yaleB15 | available: 63 | common: 57\\n\",\"yaleB16 | available: 62 | common: 57\\n\",\"yaleB17 | available: 63 | common: 57\\n\",\"yaleB18 | available: 63 | common: 57\\n\",\"yaleB19 | available: 64 | common: 57\\n\",\"yaleB20 | available: 64 | common: 57\\n\",\"yaleB21 | available: 64 | common: 57\\n\",\"yaleB22 | available: 64 | common: 57\\n\",\"yaleB23 | available: 64 | common: 57\\n\",\"yaleB24 | available: 64 | common: 57\\n\",\"yaleB25 | available: 64 | common: 57\\n\",\"yaleB26 | available: 64 | common: 57\\n\",\"yaleB27 | available: 64 | common: 57\\n\",\"yaleB28 | available: 64 | common: 57\\n\",\"yaleB29 | available: 64 | common: 57\\n\",\"yaleB30 | available: 64 | common: 57\\n\",\"yaleB31 | available: 64 | common: 57\\n\",\"yaleB32 | available: 64 | common: 57\\n\",\"yaleB33 | available: 64 | common: 57\\n\",\"yaleB34 | available: 64 | common: 57\\n\",\"yaleB35 | available: 64 | common: 57\\n\",\"yaleB36 | available: 64 | common: 57\\n\",\"yaleB37 | available: 64 | common: 57\\n\",\"yaleB38 | available: 64 | common: 57\\n\",\"yaleB39 | available: 64 | common: 57\\n\",\"\\n\",\"[4] AMBIENT IMAGE DIMENSIONS\\n\",\"{'640x480': 28, '168x192': 10}\\n\",\"\\n\",\"[5] VALIDATION\\n\",\"Unexpected standard-image dimensions: 0\\n\",\"\\n\",\"[6] FILES SAVED\\n\",\"Audit: /content/drive/MyDrive/Experiment_20_Results/dataset_audit/experiment20_common_illumination_condition_audit.json\\n\",\"Manifest: /content/drive/MyDrive/Experiment_20_Results/dataset_audit/experiment20_common_illumination_condition_manifest.json\\n\",\"\\n\",\"STEP 2.6.10 COMPLETE\\n\",\"No extraction or embedding generation performed.\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"## EXPERIMENT 20 — STEP 2.6.11: LIGHTING GEOMETRY AND CONDITION GROUPING\\n\",\"\\n\",\"Classify the 57 common illumination configurations using their recorded azimuth\\n\",\"and elevation angles.\\n\",\"\\n\",\"Predefined grouping rule:\\n\",\"- Near-frontal: angular deviation <= 30 degrees.\\n\",\"- Oblique: angular deviation > 30 and <= 60 degrees.\\n\",\"- High-angle: angular deviation > 60 degrees.\\n\",\"\\n\",\"Angular deviation is calculated relative to frontal illumination using:\\n\",\"\\n\",\"theta = arccos(cos(elevation) * cos(azimuth))\\n\",\"\\n\",\"The calculation uses the spherical direction-vector convention, with angles\\n\",\"converted to radians before applying trigonometric functions.\\n\",\"\\n\",\"This groups lighting directions, not illumination intensity.\\n\",\"\\n\",\"Objectives:\\n\",\"1. Load the verified common-condition manifest.\\n\",\"2. Calculate angular deviation for each condition.\\n\",\"3. Assign each condition to one predefined group.\\n\",\"4. Report group sizes and condition membership.\\n\",\"5. Verify that all 57 conditions are assigned exactly once.\\n\",\"6. Save the grouped condition manifest and audit.\\n\",\"\\n\",\"No images will be modified or embeddings generated.\"],\"metadata\":{\"id\":\"yn34SuO5rG-u\"}},{\"cell_type\":\"code\",\"source\":[\"import os\\n\",\"import re\\n\",\"import json\\n\",\"import math\\n\",\"from collections import Counter, defaultdict\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"AUDIT_DIR = (\\n\",\"    \\\"/content/drive/MyDrive/Experiment_20_Results/dataset_audit\\\"\\n\",\")\\n\",\"\\n\",\"SOURCE_MANIFEST = os.path.join(\\n\",\"    AUDIT_DIR,\\n\",\"    \\\"experiment20_common_illumination_condition_manifest.json\\\"\\n\",\")\\n\",\"\\n\",\"OUTPUT_MANIFEST = os.path.join(\\n\",\"    AUDIT_DIR,\\n\",\"    \\\"experiment20_grouped_illumination_condition_manifest.json\\\"\\n\",\")\\n\",\"\\n\",\"OUTPUT_AUDIT = os.path.join(\\n\",\"    AUDIT_DIR,\\n\",\"    \\\"experiment20_lighting_geometry_grouping_audit.json\\\"\\n\",\")\\n\",\"\\n\",\"os.makedirs(AUDIT_DIR, exist_ok=True)\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 2.6.11: LIGHTING GEOMETRY GROUPING\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 1. LOAD VERIFIED COMMON-CONDITION MANIFEST\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"if not os.path.isfile(SOURCE_MANIFEST):\\n\",\"    raise FileNotFoundError(SOURCE_MANIFEST)\\n\",\"\\n\",\"with open(SOURCE_MANIFEST, \\\"r\\\") as f:\\n\",\"    source_manifest = json.load(f)\\n\",\"\\n\",\"subjects = source_manifest[\\\"subjects\\\"]\\n\",\"conditions = source_manifest[\\\"common_illumination_conditions\\\"]\\n\",\"\\n\",\"print(\\\"\\\\n[1] SOURCE MANIFEST\\\")\\n\",\"print(\\\"Subjects:\\\", len(subjects))\\n\",\"print(\\\"Common conditions:\\\", len(conditions))\\n\",\"\\n\",\"if len(subjects) != 38:\\n\",\"    raise RuntimeError(\\n\",\"        f\\\"Expected 38 subjects, found {len(subjects)}.\\\"\\n\",\"    )\\n\",\"\\n\",\"if len(conditions) != 57:\\n\",\"    raise RuntimeError(\\n\",\"        f\\\"Expected 57 common conditions, found {len(conditions)}.\\\"\\n\",\"    )\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 2. DEFINE PRE-REGISTERED GROUP BOUNDARIES\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"GROUP_RULES = {\\n\",\"    \\\"near_frontal\\\": {\\n\",\"        \\\"minimum_exclusive\\\": None,\\n\",\"        \\\"maximum_inclusive\\\": 30.0\\n\",\"    },\\n\",\"    \\\"oblique\\\": {\\n\",\"        \\\"minimum_exclusive\\\": 30.0,\\n\",\"        \\\"maximum_inclusive\\\": 60.0\\n\",\"    },\\n\",\"    \\\"high_angle\\\": {\\n\",\"        \\\"minimum_exclusive\\\": 60.0,\\n\",\"        \\\"maximum_inclusive\\\": None\\n\",\"    }\\n\",\"}\\n\",\"\\n\",\"def classify_angle(angle):\\n\",\"    if angle <= 30.0:\\n\",\"        return \\\"near_frontal\\\"\\n\",\"    elif angle <= 60.0:\\n\",\"        return \\\"oblique\\\"\\n\",\"    else:\\n\",\"        return \\\"high_angle\\\"\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 3. CALCULATE ANGULAR DEVIATION\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"condition_pattern = re.compile(\\n\",\"    r\\\"^A([+-]\\\\d{3})E([+-]\\\\d{2})$\\\"\\n\",\")\\n\",\"\\n\",\"grouped_conditions = {\\n\",\"    \\\"near_frontal\\\": [],\\n\",\"    \\\"oblique\\\": [],\\n\",\"    \\\"high_angle\\\": []\\n\",\"}\\n\",\"\\n\",\"condition_details = {}\\n\",\"\\n\",\"for condition in conditions:\\n\",\"\\n\",\"    match = condition_pattern.match(condition)\\n\",\"\\n\",\"    if not match:\\n\",\"        raise ValueError(\\n\",\"            f\\\"Unexpected condition format: {condition}\\\"\\n\",\"        )\\n\",\"\\n\",\"    azimuth_deg = int(match.group(1))\\n\",\"    elevation_deg = int(match.group(2))\\n\",\"\\n\",\"    azimuth_rad = math.radians(azimuth_deg)\\n\",\"    elevation_rad = math.radians(elevation_deg)\\n\",\"\\n\",\"    cosine_value = (\\n\",\"        math.cos(elevation_rad) *\\n\",\"        math.cos(azimuth_rad)\\n\",\"    )\\n\",\"\\n\",\"    # Protect against floating-point boundary errors.\\n\",\"    cosine_value = max(-1.0, min(1.0, cosine_value))\\n\",\"\\n\",\"    angular_deviation = math.degrees(\\n\",\"        math.acos(cosine_value)\\n\",\"    )\\n\",\"\\n\",\"    group = classify_angle(angular_deviation)\\n\",\"\\n\",\"    detail = {\\n\",\"        \\\"condition\\\": condition,\\n\",\"        \\\"azimuth_degrees\\\": azimuth_deg,\\n\",\"        \\\"elevation_degrees\\\": elevation_deg,\\n\",\"        \\\"angular_deviation_degrees\\\": round(\\n\",\"            angular_deviation, 6\\n\",\"        ),\\n\",\"        \\\"group\\\": group\\n\",\"    }\\n\",\"\\n\",\"    condition_details[condition] = detail\\n\",\"    grouped_conditions[group].append(condition)\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 4. REPORT GROUP MEMBERSHIP\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[2] GROUP MEMBERSHIP\\\")\\n\",\"\\n\",\"group_counts = {}\\n\",\"\\n\",\"for group, group_conditions in grouped_conditions.items():\\n\",\"\\n\",\"    group_counts[group] = len(group_conditions)\\n\",\"\\n\",\"    print(\\\"\\\\n\\\", group.upper())\\n\",\"    print(\\\"Condition count:\\\", len(group_conditions))\\n\",\"\\n\",\"    for condition in sorted(group_conditions):\\n\",\"        angle = condition_details[condition][\\n\",\"            \\\"angular_deviation_degrees\\\"\\n\",\"        ]\\n\",\"        print(f\\\"{condition}: {angle:.3f} degrees\\\")\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 5. VALIDATE COMPLETE CONDITION ASSIGNMENT\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[3] ASSIGNMENT VALIDATION\\\")\\n\",\"\\n\",\"assigned_conditions = [\\n\",\"    condition\\n\",\"    for group_conditions in grouped_conditions.values()\\n\",\"    for condition in group_conditions\\n\",\"]\\n\",\"\\n\",\"unique_assigned = set(assigned_conditions)\\n\",\"original_conditions = set(conditions)\\n\",\"\\n\",\"assert len(assigned_conditions) == len(conditions)\\n\",\"assert len(unique_assigned) == len(conditions)\\n\",\"assert unique_assigned == original_conditions\\n\",\"\\n\",\"print(\\\"All conditions assigned:\\\", len(assigned_conditions))\\n\",\"print(\\\"Duplicate assignments:\\\", (\\n\",\"    len(assigned_conditions) - len(unique_assigned)\\n\",\"))\\n\",\"print(\\\"Unassigned conditions:\\\", len(\\n\",\"    original_conditions - unique_assigned\\n\",\"))\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 6. PER-SUBJECT GROUP COVERAGE\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[4] PER-SUBJECT GROUP COVERAGE\\\")\\n\",\"\\n\",\"subject_group_counts = {}\\n\",\"\\n\",\"for subject in subjects:\\n\",\"\\n\",\"    subject_paths = source_manifest[\\n\",\"        \\\"image_paths_by_subject\\\"\\n\",\"    ][subject]\\n\",\"\\n\",\"    subject_group_counts[subject] = {}\\n\",\"\\n\",\"    for group, group_conditions in grouped_conditions.items():\\n\",\"\\n\",\"        available = [\\n\",\"            condition\\n\",\"            for condition in group_conditions\\n\",\"            if condition in subject_paths\\n\",\"        ]\\n\",\"\\n\",\"        subject_group_counts[subject][group] = len(available)\\n\",\"\\n\",\"    print(subject, subject_group_counts[subject])\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 7. CREATE GROUPED MANIFEST\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"grouped_manifest = {\\n\",\"    \\\"dataset\\\": source_manifest[\\\"dataset\\\"],\\n\",\"    \\\"pose\\\": source_manifest[\\\"pose\\\"],\\n\",\"    \\\"ambient_images_included\\\": False,\\n\",\"    \\\"image_dimensions\\\": source_manifest[\\\"image_dimensions\\\"],\\n\",\"    \\\"subjects\\\": subjects,\\n\",\"    \\\"condition_grouping_method\\\": (\\n\",\"        \\\"Spherical angular deviation from frontal illumination\\\"\\n\",\"    ),\\n\",\"    \\\"angular_deviation_formula\\\": (\\n\",\"        \\\"arccos(cos(elevation) * cos(azimuth))\\\"\\n\",\"    ),\\n\",\"    \\\"angle_units\\\": \\\"degrees\\\",\\n\",\"    \\\"group_thresholds\\\": GROUP_RULES,\\n\",\"    \\\"groups\\\": grouped_conditions,\\n\",\"    \\\"condition_details\\\": condition_details,\\n\",\"    \\\"image_paths_by_subject\\\": source_manifest[\\n\",\"        \\\"image_paths_by_subject\\\"\\n\",\"    ]\\n\",\"}\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 8. SAVE AUDIT\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"audit = {\\n\",\"    \\\"step\\\": \\\"2.6.11\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"subject_count\\\": len(subjects),\\n\",\"    \\\"common_condition_count\\\": len(conditions),\\n\",\"    \\\"group_counts\\\": group_counts,\\n\",\"    \\\"group_thresholds\\\": GROUP_RULES,\\n\",\"    \\\"subject_group_counts\\\": subject_group_counts,\\n\",\"    \\\"all_conditions_assigned_once\\\": True,\\n\",\"    \\\"duplicate_assignments\\\": 0,\\n\",\"    \\\"unassigned_conditions\\\": 0,\\n\",\"    \\\"interpretation\\\": (\\n\",\"        \\\"Groups represent lighting-direction deviation, \\\"\\n\",\"        \\\"not measured illumination intensity.\\\"\\n\",\"    ),\\n\",\"    \\\"status\\\": \\\"GROUPING_VALIDATED\\\"\\n\",\"}\\n\",\"\\n\",\"with open(OUTPUT_MANIFEST, \\\"w\\\") as f:\\n\",\"    json.dump(grouped_manifest, f, indent=2)\\n\",\"\\n\",\"with open(OUTPUT_AUDIT, \\\"w\\\") as f:\\n\",\"    json.dump(audit, f, indent=2)\\n\",\"\\n\",\"print(\\\"\\\\n[5] OUTPUT FILES\\\")\\n\",\"print(\\\"Grouped manifest:\\\", OUTPUT_MANIFEST)\\n\",\"print(\\\"Grouping audit:\\\", OUTPUT_AUDIT)\\n\",\"\\n\",\"print(\\\"\\\\nSTEP 2.6.11 COMPLETE\\\")\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"wVAqYiYhrJQT\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794351341120,\"user_tz\":360,\"elapsed\":204,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"3b68be39-9141-4acd-c728-4237eb02771f\"},\"execution_count\":null,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"===========================================================================\\n\",\"EXPERIMENT 20 — STEP 2.6.11: LIGHTING GEOMETRY GROUPING\\n\",\"===========================================================================\\n\",\"\\n\",\"[1] SOURCE MANIFEST\\n\",\"Subjects: 38\\n\",\"Common conditions: 57\\n\",\"\\n\",\"[2] GROUP MEMBERSHIP\\n\",\"\\n\",\" NEAR_FRONTAL\\n\",\"Condition count: 18\\n\",\"A+000E+00: 0.000 degrees\\n\",\"A+000E+20: 20.000 degrees\\n\",\"A+000E-20: 20.000 degrees\\n\",\"A+005E+10: 11.169 degrees\\n\",\"A+005E-10: 11.169 degrees\\n\",\"A+010E+00: 10.000 degrees\\n\",\"A+010E-20: 22.269 degrees\\n\",\"A+015E+20: 24.814 degrees\\n\",\"A+020E+10: 22.269 degrees\\n\",\"A+020E-10: 22.269 degrees\\n\",\"A+025E+00: 25.000 degrees\\n\",\"A-005E+10: 11.169 degrees\\n\",\"A-005E-10: 11.169 degrees\\n\",\"A-010E-20: 22.269 degrees\\n\",\"A-015E+20: 24.814 degrees\\n\",\"A-020E+10: 22.269 degrees\\n\",\"A-020E-10: 22.269 degrees\\n\",\"A-025E+00: 25.000 degrees\\n\",\"\\n\",\" OBLIQUE\\n\",\"Condition count: 11\\n\",\"A+000E+45: 45.000 degrees\\n\",\"A+000E-35: 35.000 degrees\\n\",\"A+020E-40: 43.958 degrees\\n\",\"A+035E+15: 37.698 degrees\\n\",\"A+035E+40: 51.134 degrees\\n\",\"A+035E-20: 39.668 degrees\\n\",\"A+050E+00: 50.000 degrees\\n\",\"A-020E-40: 43.958 degrees\\n\",\"A-035E+15: 37.698 degrees\\n\",\"A-035E-20: 39.668 degrees\\n\",\"A-050E+00: 50.000 degrees\\n\",\"\\n\",\" HIGH_ANGLE\\n\",\"Condition count: 28\\n\",\"A+000E+90: 90.000 degrees\\n\",\"A+035E+65: 69.746 degrees\\n\",\"A+060E+20: 61.976 degrees\\n\",\"A+060E-20: 61.976 degrees\\n\",\"A+070E+00: 70.000 degrees\\n\",\"A+070E+45: 76.005 degrees\\n\",\"A+070E-35: 73.730 degrees\\n\",\"A+085E+20: 85.302 degrees\\n\",\"A+085E-20: 85.302 degrees\\n\",\"A+110E+15: 109.291 degrees\\n\",\"A+110E+40: 105.189 degrees\\n\",\"A+110E+65: 98.311 degrees\\n\",\"A+110E-20: 108.747 degrees\\n\",\"A+120E+00: 120.000 degrees\\n\",\"A+130E+20: 127.159 degrees\\n\",\"A-035E+65: 69.746 degrees\\n\",\"A-060E+20: 61.976 degrees\\n\",\"A-060E-20: 61.976 degrees\\n\",\"A-070E+00: 70.000 degrees\\n\",\"A-070E+45: 76.005 degrees\\n\",\"A-070E-35: 73.730 degrees\\n\",\"A-085E+20: 85.302 degrees\\n\",\"A-085E-20: 85.302 degrees\\n\",\"A-095E+00: 95.000 degrees\\n\",\"A-110E+40: 105.189 degrees\\n\",\"A-110E+65: 98.311 degrees\\n\",\"A-120E+00: 120.000 degrees\\n\",\"A-130E+20: 127.159 degrees\\n\",\"\\n\",\"[3] ASSIGNMENT VALIDATION\\n\",\"All conditions assigned: 57\\n\",\"Duplicate assignments: 0\\n\",\"Unassigned conditions: 0\\n\",\"\\n\",\"[4] PER-SUBJECT GROUP COVERAGE\\n\",\"yaleB01 {'near_frontal': 18, 'oblique': 11, 'high_angle': 28}\\n\",\"yaleB02 {'near_frontal': 18, 'oblique': 11, 'high_angle': 28}\\n\",\"yaleB03 {'near_frontal': 18, 'oblique': 11, 'high_angle': 28}\\n\",\"yaleB04 {'near_frontal': 18, 'oblique': 11, 'high_angle': 28}\\n\",\"yaleB05 {'near_frontal': 18, 'oblique': 11, 'high_angle': 28}\\n\",\"yaleB06 {'near_frontal': 18, 'oblique': 11, 'high_angle': 28}\\n\",\"yaleB07 {'near_frontal': 18, 'oblique': 11, 'high_angle': 28}\\n\",\"yaleB08 {'near_frontal': 18, 'oblique': 11, 'high_angle': 28}\\n\",\"yaleB09 {'near_frontal': 18, 'oblique': 11, 'high_angle': 28}\\n\",\"yaleB10 {'near_frontal': 18, 'oblique': 11, 'high_angle': 28}\\n\",\"yaleB11 {'near_frontal': 18, 'oblique': 11, 'high_angle': 28}\\n\",\"yaleB12 {'near_frontal': 18, 'oblique': 11, 'high_angle': 28}\\n\",\"yaleB13 {'near_frontal': 18, 'oblique': 11, 'high_angle': 28}\\n\",\"yaleB15 {'near_frontal': 18, 'oblique': 11, 'high_angle': 28}\\n\",\"yaleB16 {'near_frontal': 18, 'oblique': 11, 'high_angle': 28}\\n\",\"yaleB17 {'near_frontal': 18, 'oblique': 11, 'high_angle': 28}\\n\",\"yaleB18 {'near_frontal': 18, 'oblique': 11, 'high_angle': 28}\\n\",\"yaleB19 {'near_frontal': 18, 'oblique': 11, 'high_angle': 28}\\n\",\"yaleB20 {'near_frontal': 18, 'oblique': 11, 'high_angle': 28}\\n\",\"yaleB21 {'near_frontal': 18, 'oblique': 11, 'high_angle': 28}\\n\",\"yaleB22 {'near_frontal': 18, 'oblique': 11, 'high_angle': 28}\\n\",\"yaleB23 {'near_frontal': 18, 'oblique': 11, 'high_angle': 28}\\n\",\"yaleB24 {'near_frontal': 18, 'oblique': 11, 'high_angle': 28}\\n\",\"yaleB25 {'near_frontal': 18, 'oblique': 11, 'high_angle': 28}\\n\",\"yaleB26 {'near_frontal': 18, 'oblique': 11, 'high_angle': 28}\\n\",\"yaleB27 {'near_frontal': 18, 'oblique': 11, 'high_angle': 28}\\n\",\"yaleB28 {'near_frontal': 18, 'oblique': 11, 'high_angle': 28}\\n\",\"yaleB29 {'near_frontal': 18, 'oblique': 11, 'high_angle': 28}\\n\",\"yaleB30 {'near_frontal': 18, 'oblique': 11, 'high_angle': 28}\\n\",\"yaleB31 {'near_frontal': 18, 'oblique': 11, 'high_angle': 28}\\n\",\"yaleB32 {'near_frontal': 18, 'oblique': 11, 'high_angle': 28}\\n\",\"yaleB33 {'near_frontal': 18, 'oblique': 11, 'high_angle': 28}\\n\",\"yaleB34 {'near_frontal': 18, 'oblique': 11, 'high_angle': 28}\\n\",\"yaleB35 {'near_frontal': 18, 'oblique': 11, 'high_angle': 28}\\n\",\"yaleB36 {'near_frontal': 18, 'oblique': 11, 'high_angle': 28}\\n\",\"yaleB37 {'near_frontal': 18, 'oblique': 11, 'high_angle': 28}\\n\",\"yaleB38 {'near_frontal': 18, 'oblique': 11, 'high_angle': 28}\\n\",\"yaleB39 {'near_frontal': 18, 'oblique': 11, 'high_angle': 28}\\n\",\"\\n\",\"[5] OUTPUT FILES\\n\",\"Grouped manifest: /content/drive/MyDrive/Experiment_20_Results/dataset_audit/experiment20_grouped_illumination_condition_manifest.json\\n\",\"Grouping audit: /content/drive/MyDrive/Experiment_20_Results/dataset_audit/experiment20_lighting_geometry_grouping_audit.json\\n\",\"\\n\",\"STEP 2.6.11 COMPLETE\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"## EXPERIMENT 20 — STEP 2.6.12: ANGULAR HEMISPHERE AUDIT\\n\",\"\\n\",\"Review the existing three-group illumination classification.\\n\",\"\\n\",\"The primary groups remain:\\n\",\"- Near-frontal: deviation <= 30 degrees.\\n\",\"- Oblique: deviation > 30 and <= 60 degrees.\\n\",\"- Large angular deviation: deviation > 60 degrees.\\n\",\"\\n\",\"Add a secondary geometric distinction:\\n\",\"- Frontal hemisphere: deviation <= 90 degrees.\\n\",\"- Beyond frontal hemisphere: deviation > 90 degrees.\\n\",\"\\n\",\"Objectives:\\n\",\"1. Load the existing grouped illumination manifest.\\n\",\"2. Rename high_angle to large_angular_deviation.\\n\",\"3. Identify conditions beyond the frontal hemisphere.\\n\",\"4. Report the distribution across primary groups and hemispheres.\\n\",\"5. Verify that all 57 conditions remain assigned exactly once.\\n\",\"6. Save a corrected manifest and audit.\\n\",\"\\n\",\"This is a terminology and geometric audit. It does not change the angular thresholds or image selection.\"],\"metadata\":{\"id\":\"4cDVeosYrQWI\"}},{\"cell_type\":\"code\",\"source\":[\"import os\\n\",\"import json\\n\",\"import math\\n\",\"from collections import Counter\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"AUDIT_DIR = (\\n\",\"    \\\"/content/drive/MyDrive/Experiment_20_Results/dataset_audit\\\"\\n\",\")\\n\",\"\\n\",\"SOURCE_PATH = os.path.join(\\n\",\"    AUDIT_DIR,\\n\",\"    \\\"experiment20_grouped_illumination_condition_manifest.json\\\"\\n\",\")\\n\",\"\\n\",\"OUTPUT_PATH = os.path.join(\\n\",\"    AUDIT_DIR,\\n\",\"    \\\"experiment20_corrected_illumination_condition_manifest.json\\\"\\n\",\")\\n\",\"\\n\",\"AUDIT_PATH = os.path.join(\\n\",\"    AUDIT_DIR,\\n\",\"    \\\"experiment20_angular_hemisphere_audit.json\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 2.6.12: ANGULAR HEMISPHERE AUDIT\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"with open(SOURCE_PATH, \\\"r\\\") as f:\\n\",\"    source = json.load(f)\\n\",\"\\n\",\"old_groups = source[\\\"groups\\\"]\\n\",\"details = source[\\\"condition_details\\\"]\\n\",\"\\n\",\"# Preserve the original group membership while correcting terminology.\\n\",\"corrected_groups = {\\n\",\"    \\\"near_frontal\\\": list(old_groups[\\\"near_frontal\\\"]),\\n\",\"    \\\"oblique\\\": list(old_groups[\\\"oblique\\\"]),\\n\",\"    \\\"large_angular_deviation\\\": list(old_groups[\\\"high_angle\\\"])\\n\",\"}\\n\",\"\\n\",\"hemisphere_groups = {\\n\",\"    \\\"frontal_hemisphere\\\": [],\\n\",\"    \\\"beyond_frontal_hemisphere\\\": []\\n\",\"}\\n\",\"\\n\",\"corrected_details = {}\\n\",\"\\n\",\"for condition, detail in details.items():\\n\",\"\\n\",\"    angle = float(detail[\\\"angular_deviation_degrees\\\"])\\n\",\"\\n\",\"    hemisphere = (\\n\",\"        \\\"frontal_hemisphere\\\"\\n\",\"        if angle <= 90.0\\n\",\"        else \\\"beyond_frontal_hemisphere\\\"\\n\",\"    )\\n\",\"\\n\",\"    primary_group = detail[\\\"group\\\"]\\n\",\"\\n\",\"    if primary_group == \\\"high_angle\\\":\\n\",\"        primary_group = \\\"large_angular_deviation\\\"\\n\",\"\\n\",\"    corrected_detail = dict(detail)\\n\",\"    corrected_detail[\\\"group\\\"] = primary_group\\n\",\"    corrected_detail[\\\"hemisphere\\\"] = hemisphere\\n\",\"\\n\",\"    corrected_details[condition] = corrected_detail\\n\",\"    hemisphere_groups[hemisphere].append(condition)\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 1. GROUP COUNTS\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[1] CORRECTED PRIMARY GROUP COUNTS\\\")\\n\",\"\\n\",\"group_counts = {\\n\",\"    group: len(items)\\n\",\"    for group, items in corrected_groups.items()\\n\",\"}\\n\",\"\\n\",\"for group, count in group_counts.items():\\n\",\"    print(group, \\\":\\\", count)\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 2. HEMISPHERE COUNTS\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[2] HEMISPHERE COUNTS\\\")\\n\",\"\\n\",\"hemisphere_counts = {\\n\",\"    group: len(items)\\n\",\"    for group, items in hemisphere_groups.items()\\n\",\"}\\n\",\"\\n\",\"for group, count in hemisphere_counts.items():\\n\",\"    print(group, \\\":\\\", count)\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 3. CONDITIONS BEYOND 90 DEGREES\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[3] CONDITIONS BEYOND FRONTAL HEMISPHERE\\\")\\n\",\"\\n\",\"beyond_conditions = sorted(\\n\",\"    hemisphere_groups[\\\"beyond_frontal_hemisphere\\\"]\\n\",\")\\n\",\"\\n\",\"for condition in beyond_conditions:\\n\",\"    angle = corrected_details[condition][\\n\",\"        \\\"angular_deviation_degrees\\\"\\n\",\"    ]\\n\",\"    print(condition, \\\"|\\\", angle, \\\"degrees\\\")\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 4. CROSS-TABULATION\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[4] PRIMARY GROUP BY HEMISPHERE\\\")\\n\",\"\\n\",\"cross_tab = {}\\n\",\"\\n\",\"for group, conditions in corrected_groups.items():\\n\",\"\\n\",\"    counts = Counter(\\n\",\"        corrected_details[c][\\\"hemisphere\\\"]\\n\",\"        for c in conditions\\n\",\"    )\\n\",\"\\n\",\"    cross_tab[group] = dict(counts)\\n\",\"\\n\",\"    print(group, cross_tab[group])\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 5. VALIDATION\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"original_conditions = set(details)\\n\",\"\\n\",\"assigned_conditions = [\\n\",\"    condition\\n\",\"    for conditions in corrected_groups.values()\\n\",\"    for condition in conditions\\n\",\"]\\n\",\"\\n\",\"assert len(assigned_conditions) == 57\\n\",\"assert len(set(assigned_conditions)) == 57\\n\",\"assert set(assigned_conditions) == original_conditions\\n\",\"\\n\",\"assert (\\n\",\"    len(hemisphere_groups[\\\"frontal_hemisphere\\\"])\\n\",\"    + len(hemisphere_groups[\\\"beyond_frontal_hemisphere\\\"])\\n\",\"    == 57\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n[5] VALIDATION PASSED\\\")\\n\",\"print(\\\"Unique conditions:\\\", len(set(assigned_conditions)))\\n\",\"print(\\\"Duplicate assignments:\\\", (\\n\",\"    len(assigned_conditions) - len(set(assigned_conditions))\\n\",\"))\\n\",\"print(\\\"All 57 conditions retained:\\\", True)\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 6. SAVE CORRECTED MANIFEST\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"corrected_manifest = dict(source)\\n\",\"\\n\",\"corrected_manifest[\\\"groups\\\"] = corrected_groups\\n\",\"corrected_manifest[\\\"condition_details\\\"] = corrected_details\\n\",\"corrected_manifest[\\\"hemisphere_groups\\\"] = hemisphere_groups\\n\",\"corrected_manifest[\\\"hemisphere_definition\\\"] = {\\n\",\"    \\\"frontal_hemisphere\\\": \\\"<= 90 degrees\\\",\\n\",\"    \\\"beyond_frontal_hemisphere\\\": \\\"> 90 degrees\\\"\\n\",\"}\\n\",\"\\n\",\"corrected_manifest[\\\"group_interpretation\\\"] = (\\n\",\"    \\\"Primary groups describe angular deviation from frontal \\\"\\n\",\"    \\\"illumination. Hemisphere is recorded separately.\\\"\\n\",\")\\n\",\"\\n\",\"audit = {\\n\",\"    \\\"step\\\": \\\"2.6.12\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"primary_group_counts\\\": group_counts,\\n\",\"    \\\"hemisphere_counts\\\": hemisphere_counts,\\n\",\"    \\\"group_hemisphere_cross_tabulation\\\": cross_tab,\\n\",\"    \\\"beyond_frontal_conditions\\\": beyond_conditions,\\n\",\"    \\\"all_57_conditions_retained\\\": True,\\n\",\"    \\\"duplicate_assignments\\\": 0,\\n\",\"    \\\"status\\\": \\\"GEOMETRIC_AUDIT_PASSED\\\"\\n\",\"}\\n\",\"\\n\",\"with open(OUTPUT_PATH, \\\"w\\\") as f:\\n\",\"    json.dump(corrected_manifest, f, indent=2)\\n\",\"\\n\",\"with open(AUDIT_PATH, \\\"w\\\") as f:\\n\",\"    json.dump(audit, f, indent=2)\\n\",\"\\n\",\"print(\\\"\\\\n[6] SAVED\\\")\\n\",\"print(\\\"Corrected manifest:\\\", OUTPUT_PATH)\\n\",\"print(\\\"Audit:\\\", AUDIT_PATH)\\n\",\"\\n\",\"print(\\\"\\\\nSTEP 2.6.12 COMPLETE\\\")\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"K2TiQVL0rScz\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794351378807,\"user_tz\":360,\"elapsed\":261,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"94bd0e99-e9c4-4df5-8444-c7ab2f80b808\"},\"execution_count\":null,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"===========================================================================\\n\",\"EXPERIMENT 20 — STEP 2.6.12: ANGULAR HEMISPHERE AUDIT\\n\",\"===========================================================================\\n\",\"\\n\",\"[1] CORRECTED PRIMARY GROUP COUNTS\\n\",\"near_frontal : 18\\n\",\"oblique : 11\\n\",\"large_angular_deviation : 28\\n\",\"\\n\",\"[2] HEMISPHERE COUNTS\\n\",\"frontal_hemisphere : 46\\n\",\"beyond_frontal_hemisphere : 11\\n\",\"\\n\",\"[3] CONDITIONS BEYOND FRONTAL HEMISPHERE\\n\",\"A+110E+15 | 109.290997 degrees\\n\",\"A+110E+40 | 105.188924 degrees\\n\",\"A+110E+65 | 98.310872 degrees\\n\",\"A+110E-20 | 108.747237 degrees\\n\",\"A+120E+00 | 120.0 degrees\\n\",\"A+130E+20 | 127.158554 degrees\\n\",\"A-095E+00 | 95.0 degrees\\n\",\"A-110E+40 | 105.188924 degrees\\n\",\"A-110E+65 | 98.310872 degrees\\n\",\"A-120E+00 | 120.0 degrees\\n\",\"A-130E+20 | 127.158554 degrees\\n\",\"\\n\",\"[4] PRIMARY GROUP BY HEMISPHERE\\n\",\"near_frontal {'frontal_hemisphere': 18}\\n\",\"oblique {'frontal_hemisphere': 11}\\n\",\"large_angular_deviation {'frontal_hemisphere': 17, 'beyond_frontal_hemisphere': 11}\\n\",\"\\n\",\"[5] VALIDATION PASSED\\n\",\"Unique conditions: 57\\n\",\"Duplicate assignments: 0\\n\",\"All 57 conditions retained: True\\n\",\"\\n\",\"[6] SAVED\\n\",\"Corrected manifest: /content/drive/MyDrive/Experiment_20_Results/dataset_audit/experiment20_corrected_illumination_condition_manifest.json\\n\",\"Audit: /content/drive/MyDrive/Experiment_20_Results/dataset_audit/experiment20_angular_hemisphere_audit.json\\n\",\"\\n\",\"STEP 2.6.12 COMPLETE\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"## EXPERIMENT 20 — STEP 2.6.13: RECOVER FACENET PREPROCESSING CONFIGURATION\\n\",\"\\n\",\"Search the complete mounted Google Drive for the original Experiment 18 notebook and supporting artifacts.\\n\",\"\\n\",\"Identify:\\n\",\"1. Experiment 18 notebooks.\\n\",\"2. InceptionResnetV1 and VGGFace2 references.\\n\",\"3. Face detection and alignment procedures.\\n\",\"4. Image resizing and normalization.\\n\",\"5. Embedding extraction and dimensionality.\\n\",\"\\n\",\"This is a read-only recovery audit. Do not download model weights, extract images, modify existing files, or generate embeddings.\"],\"metadata\":{\"id\":\"jW-bSoj0rbvX\"}},{\"cell_type\":\"code\",\"source\":[\"import os\\n\",\"import json\\n\",\"import re\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"DRIVE_ROOT = \\\"/content/drive/MyDrive\\\"\\n\",\"\\n\",\"OUTPUT_DIR = os.path.join(\\n\",\"    DRIVE_ROOT,\\n\",\"    \\\"Experiment_20_Results\\\",\\n\",\"    \\\"dataset_audit\\\"\\n\",\")\\n\",\"\\n\",\"OUTPUT_PATH = os.path.join(\\n\",\"    OUTPUT_DIR,\\n\",\"    \\\"experiment20_facenet_preprocessing_compatibility_audit.json\\\"\\n\",\")\\n\",\"\\n\",\"os.makedirs(OUTPUT_DIR, exist_ok=True)\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 2.6.13: FACENET PREPROCESSING RECOVERY\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"if not os.path.isdir(DRIVE_ROOT):\\n\",\"    raise FileNotFoundError(\\n\",\"        \\\"Google Drive is not mounted. Mount Drive before running this cell.\\\"\\n\",\"    )\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 1. SEARCH ALL GOOGLE DRIVE NOTEBOOKS\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[1] SEARCHING GOOGLE DRIVE\\\")\\n\",\"\\n\",\"notebook_paths = []\\n\",\"artifact_paths = []\\n\",\"\\n\",\"excluded = {\\n\",\"    \\\".Trash\\\",\\n\",\"    \\\".ipynb_checkpoints\\\",\\n\",\"    \\\"__pycache__\\\"\\n\",\"}\\n\",\"\\n\",\"for current_root, directories, files in os.walk(DRIVE_ROOT):\\n\",\"\\n\",\"    directories[:] = [\\n\",\"        d for d in directories\\n\",\"        if d not in excluded\\n\",\"    ]\\n\",\"\\n\",\"    for filename in files:\\n\",\"\\n\",\"        full_path = os.path.join(current_root, filename)\\n\",\"        lower = filename.lower()\\n\",\"\\n\",\"        if lower.endswith(\\\".ipynb\\\"):\\n\",\"            notebook_paths.append(full_path)\\n\",\"\\n\",\"        elif (\\n\",\"            \\\"experiment18\\\" in lower\\n\",\"            or \\\"experiment_18\\\" in lower\\n\",\"            or \\\"illumination\\\" in lower\\n\",\"        ):\\n\",\"            artifact_paths.append(full_path)\\n\",\"\\n\",\"print(\\\"Total notebooks found:\\\", len(notebook_paths))\\n\",\"print(\\\"Potential supporting artifacts:\\\", len(artifact_paths))\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 2. INSPECT NOTEBOOKS FOR EXPERIMENT 18 EVIDENCE\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[2] NOTEBOOK CONTENT AUDIT\\\")\\n\",\"\\n\",\"search_terms = [\\n\",\"    \\\"InceptionResnetV1\\\",\\n\",\"    \\\"VGGFace2\\\",\\n\",\"    \\\"MTCNN\\\",\\n\",\"    \\\"fixed_image_standardization\\\",\\n\",\"    \\\"prewhiten\\\",\\n\",\"    \\\"Resize\\\",\\n\",\"    \\\"Normalize\\\",\\n\",\"    \\\"interpolate\\\",\\n\",\"    \\\"ToTensor\\\",\\n\",\"    \\\"face_detection\\\",\\n\",\"    \\\"alignment\\\",\\n\",\"    \\\"embedding_dimension\\\",\\n\",\"    \\\"experiment18_illumination_results\\\",\\n\",\"    \\\"experiment18_facenet_lfw_embeddings\\\"\\n\",\"]\\n\",\"\\n\",\"notebook_results = []\\n\",\"\\n\",\"for path in notebook_paths:\\n\",\"\\n\",\"    try:\\n\",\"        with open(path, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"            notebook = json.load(f)\\n\",\"\\n\",\"        evidence = []\\n\",\"        experiment18_reference = False\\n\",\"\\n\",\"        for cell_index, cell in enumerate(\\n\",\"            notebook.get(\\\"cells\\\", [])\\n\",\"        ):\\n\",\"\\n\",\"            source = cell.get(\\\"source\\\", [])\\n\",\"\\n\",\"            if isinstance(source, list):\\n\",\"                source = \\\"\\\".join(source)\\n\",\"\\n\",\"            if not isinstance(source, str):\\n\",\"                continue\\n\",\"\\n\",\"            source_lower = source.lower()\\n\",\"\\n\",\"            if (\\n\",\"                \\\"experiment 18\\\" in source_lower\\n\",\"                or \\\"experiment18\\\" in source_lower\\n\",\"                or \\\"experiment_18\\\" in source_lower\\n\",\"            ):\\n\",\"                experiment18_reference = True\\n\",\"\\n\",\"            matched = [\\n\",\"                term for term in search_terms\\n\",\"                if term.lower() in source_lower\\n\",\"            ]\\n\",\"\\n\",\"            if matched:\\n\",\"\\n\",\"                lines = source.splitlines()\\n\",\"                excerpts = []\\n\",\"\\n\",\"                for i, line in enumerate(lines):\\n\",\"                    if any(\\n\",\"                        term.lower() in line.lower()\\n\",\"                        for term in matched\\n\",\"                    ):\\n\",\"                        start = max(0, i - 2)\\n\",\"                        end = min(len(lines), i + 4)\\n\",\"\\n\",\"                        excerpts.extend(lines[start:end])\\n\",\"\\n\",\"                excerpts = list(dict.fromkeys(excerpts))\\n\",\"\\n\",\"                evidence.append({\\n\",\"                    \\\"cell_index\\\": cell_index,\\n\",\"                    \\\"matched_terms\\\": matched,\\n\",\"                    \\\"excerpt\\\": \\\"\\\\n\\\".join(excerpts)[:5000]\\n\",\"                })\\n\",\"\\n\",\"        if experiment18_reference or evidence:\\n\",\"\\n\",\"            notebook_results.append({\\n\",\"                \\\"path\\\": path,\\n\",\"                \\\"experiment18_reference\\\": experiment18_reference,\\n\",\"                \\\"evidence\\\": evidence\\n\",\"            })\\n\",\"\\n\",\"    except Exception as exc:\\n\",\"        print(\\\"Notebook read error:\\\", path, repr(exc))\\n\",\"\\n\",\"print(\\\"Relevant notebooks identified:\\\", len(notebook_results))\\n\",\"\\n\",\"for index, result in enumerate(notebook_results, 1):\\n\",\"\\n\",\"    print(\\\"\\\\n\\\" + \\\"-\\\" * 75)\\n\",\"    print(f\\\"NOTEBOOK {index}\\\")\\n\",\"    print(\\\"Path:\\\", result[\\\"path\\\"])\\n\",\"    print(\\\"Experiment 18 reference:\\\", result[\\\"experiment18_reference\\\"])\\n\",\"\\n\",\"    for item in result[\\\"evidence\\\"]:\\n\",\"        print(\\\"\\\\nCell:\\\", item[\\\"cell_index\\\"])\\n\",\"        print(\\\"Matched terms:\\\", item[\\\"matched_terms\\\"])\\n\",\"        print(item[\\\"excerpt\\\"])\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 3. LIST SUPPORTING EXPERIMENT 18 ARTIFACTS\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[3] SUPPORTING ARTIFACTS\\\")\\n\",\"\\n\",\"for path in artifact_paths:\\n\",\"    print(path)\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 4. IDENTIFY RELEVANT MODEL CONFIGURATION EVIDENCE\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"all_excerpts = \\\"\\\\n\\\".join(\\n\",\"    item[\\\"excerpt\\\"]\\n\",\"    for result in notebook_results\\n\",\"    for item in result[\\\"evidence\\\"]\\n\",\").lower()\\n\",\"\\n\",\"flags = {\\n\",\"    \\\"inceptionresnetv1\\\": \\\"inceptionresnetv1\\\" in all_excerpts,\\n\",\"    \\\"vggface2\\\": \\\"vggface2\\\" in all_excerpts,\\n\",\"    \\\"mtcnn\\\": \\\"mtcnn\\\" in all_excerpts,\\n\",\"    \\\"fixed_image_standardization\\\": (\\n\",\"        \\\"fixed_image_standardization\\\" in all_excerpts\\n\",\"    ),\\n\",\"    \\\"prewhiten\\\": \\\"prewhiten\\\" in all_excerpts,\\n\",\"    \\\"resize\\\": (\\n\",\"        \\\"resize\\\" in all_excerpts\\n\",\"        or \\\"interpolate\\\" in all_excerpts\\n\",\"    ),\\n\",\"    \\\"normalization\\\": \\\"normalize\\\" in all_excerpts,\\n\",\"    \\\"embedding_512\\\": \\\"512\\\" in all_excerpts\\n\",\"}\\n\",\"\\n\",\"print(\\\"\\\\n[4] CONFIGURATION EVIDENCE FLAGS\\\")\\n\",\"\\n\",\"for key, value in flags.items():\\n\",\"    print(f\\\"{key}: {value}\\\")\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 5. SAVE AUDIT\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"audit = {\\n\",\"    \\\"step\\\": \\\"2.6.13\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"drive_root\\\": DRIVE_ROOT,\\n\",\"    \\\"notebooks_scanned\\\": len(notebook_paths),\\n\",\"    \\\"relevant_notebooks\\\": notebook_results,\\n\",\"    \\\"supporting_artifacts\\\": artifact_paths,\\n\",\"    \\\"configuration_evidence_flags\\\": flags,\\n\",\"    \\\"embedding_generation_performed\\\": False,\\n\",\"    \\\"model_weights_downloaded\\\": False,\\n\",\"    \\\"images_extracted\\\": False,\\n\",\"    \\\"status\\\": (\\n\",\"        \\\"EVIDENCE_FOUND\\\"\\n\",\"        if notebook_results\\n\",\"        else \\\"NOTEBOOK_NOT_FOUND_SUPPORTING_ARTIFACTS_LISTED\\\"\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"with open(OUTPUT_PATH, \\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    json.dump(audit, f, indent=2)\\n\",\"\\n\",\"# Verify saved JSON\\n\",\"with open(OUTPUT_PATH, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    verification = json.load(f)\\n\",\"\\n\",\"print(\\\"\\\\n[5] AUDIT SAVED AND VERIFIED\\\")\\n\",\"print(\\\"Path:\\\", OUTPUT_PATH)\\n\",\"print(\\\"Status:\\\", verification[\\\"status\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nSTEP 2.6.13 COMPLETE\\\")\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"ZrLW_UStrd4j\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794351536771,\"user_tz\":360,\"elapsed\":12867,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"0acf021e-c4cc-4b80-e8f9-5de148f75c8b\"},\"execution_count\":null,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"===========================================================================\\n\",\"EXPERIMENT 20 — STEP 2.6.13: FACENET PREPROCESSING RECOVERY\\n\",\"===========================================================================\\n\",\"\\n\",\"[1] SEARCHING GOOGLE DRIVE\\n\",\"Total notebooks found: 26\\n\",\"Potential supporting artifacts: 11\\n\",\"\\n\",\"[2] NOTEBOOK CONTENT AUDIT\\n\",\"Relevant notebooks identified: 19\\n\",\"\\n\",\"---------------------------------------------------------------------------\\n\",\"NOTEBOOK 1\\n\",\"Path: /content/drive/MyDrive/Colab Notebooks/05_Corrected_Drift_Reproducibility.ipynb\\n\",\"Experiment 18 reference: False\\n\",\"\\n\",\"Cell: 1\\n\",\"Matched terms: ['Normalize']\\n\",\"\\n\",\"def mahalanobis_score(reference_mean, reference_covariance, window):\\n\",\"    \\\"\\\"\\\"Covariance-normalized distance between window and reference means.\\\"\\\"\\\"\\n\",\"    window_mean = np.mean(window, axis=0)\\n\",\"    delta = window_mean - reference_mean\\n\",\"\\n\",\"---------------------------------------------------------------------------\\n\",\"NOTEBOOK 2\\n\",\"Path: /content/drive/MyDrive/Colab Notebooks/06_LFW_Real_Data_Drift_Validation.ipynb\\n\",\"Experiment 18 reference: False\\n\",\"\\n\",\"Cell: 2\\n\",\"Matched terms: ['Resize']\\n\",\"lfw = fetch_lfw_people(\\n\",\"    min_faces_per_person=20,\\n\",\"    resize=0.5,\\n\",\"    color=True\\n\",\")\\n\",\"\\n\",\"\\n\",\"Cell: 10\\n\",\"Matched terms: ['Resize']\\n\",\"except NameError:\\n\",\"    print(\\\"Variables not found. Loading LFW dataset...\\\")\\n\",\"    lfw = fetch_lfw_people(min_faces_per_person=20, resize=0.5, color=True)\\n\",\"    images = lfw.images\\n\",\"    labels = lfw.target\\n\",\"    people = lfw.target_names\\n\",\"\\n\",\"---------------------------------------------------------------------------\\n\",\"NOTEBOOK 3\\n\",\"Path: /content/drive/MyDrive/Colab Notebooks/11_Illumination_Drift_Detection (1).ipynb\\n\",\"Experiment 18 reference: False\\n\",\"\\n\",\"Cell: 4\\n\",\"Matched terms: ['embedding_dimension']\\n\",\"\\n\",\"assert metadata[\\\"num_images\\\"] == 3023\\n\",\"assert metadata[\\\"embedding_dimension\\\"] == 512\\n\",\"print(\\\"PASS: metadata loaded and key values match\\\")\\n\",\"# 4. Verify figures exist\\n\",\"\\n\",\"Cell: 7\\n\",\"Matched terms: ['Resize']\\n\",\"lfw = fetch_lfw_people(\\n\",\"    min_faces_per_person=20,\\n\",\"    resize=0.5,\\n\",\"    color=True,\\n\",\"    download_if_missing=True\\n\",\")\\n\",\"\\n\",\"Cell: 10\\n\",\"Matched terms: ['Resize', 'Normalize', 'ToTensor']\\n\",\"model.eval()\\n\",\"\\n\",\"# LFW images are small; resize consistently to the model's expected input size.\\n\",\"preprocess = transforms.Compose([\\n\",\"    transforms.ToPILImage(),\\n\",\"    transforms.Resize((224, 224)),\\n\",\"    transforms.ToTensor(),\\n\",\"    transforms.Normalize(\\n\",\"        mean=[0.485, 0.456, 0.406],\\n\",\"        std=[0.229, 0.224, 0.225]\\n\",\"    )\\n\",\"\\n\",\"Cell: 11\\n\",\"Matched terms: ['embedding_dimension']\\n\",\"        \\\"condition\\\": condition,