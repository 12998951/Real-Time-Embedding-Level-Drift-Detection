        "print(\"\\n[7] REFERENCES HEADING\")\n",
        "print(\"Duplicate headings removed:\", duplicate_count)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 9. SECTION-SPECIFIC SUBSECTION VALIDATION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "# IMPORTANT:\n",
        "# The same number 4.x is valid in the Discussion section.\n",
        "# Validation must therefore be performed within each section.\n",
        "\n",
        "lines = corrected_text.splitlines()\n",
        "\n",
        "method_start = corrected_text.index(\n",
        "    \"# 2. Methodology\"\n",
        ")\n",
        "\n",
        "results_start = corrected_text.index(\n",
        "    \"# 3. Results\"\n",
        ")\n",
        "\n",
        "discussion_start = corrected_text.index(\n",
        "    \"# 4. Discussion\"\n",
        ")\n",
        "\n",
        "references_start = corrected_text.index(\n",
        "    \"# References\"\n",
        ")\n",
        "\n",
        "method_section = corrected_text[\n",
        "    method_start:results_start\n",
        "]\n",
        "\n",
        "results_section = corrected_text[\n",
        "    results_start:discussion_start\n",
        "]\n",
        "\n",
        "discussion_section = corrected_text[\n",
        "    discussion_start:references_start\n",
        "]\n",
        "\n",
        "method_headings = re.findall(\n",
        "    r\"(?m)^## 2\\.(\\d+)\\s+\",\n",
        "    method_section\n",
        ")\n",
        "\n",
        "results_headings = re.findall(\n",
        "    r\"(?m)^## 3\\.(\\d+)\\s+\",\n",
        "    results_section\n",
        ")\n",
        "\n",
        "discussion_headings = re.findall(\n",
        "    r\"(?m)^## 4\\.(\\d+)\\s+\",\n",
        "    discussion_section\n",
        ")\n",
        "\n",
        "expected_method = [\n",
        "    str(i) for i in range(1, 11)\n",
        "]\n",
        "\n",
        "expected_results = [\n",
        "    str(i) for i in range(1, 7)\n",
        "]\n",
        "\n",
        "expected_discussion = [\n",
        "    str(i) for i in range(1, 9)\n",
        "]\n",
        "\n",
        "if method_headings != expected_method:\n",
        "    raise ValueError(\n",
        "        \"Methodology numbering verification failed: \"\n",
        "        f\"{method_headings}\"\n",
        "    )\n",
        "\n",
        "if results_headings != expected_results:\n",
        "    raise ValueError(\n",
        "        \"Results numbering verification failed: \"\n",
        "        f\"{results_headings}\"\n",
        "    )\n",
        "\n",
        "if discussion_headings != expected_discussion:\n",
        "    raise ValueError(\n",
        "        \"Discussion numbering verification failed: \"\n",
        "        f\"{discussion_headings}\"\n",
        "    )\n",
        "\n",
        "# Ensure obsolete headings are absent from their own sections.\n",
        "if re.search(\n",
        "    r\"(?m)^# 3\\.\\d+\\s+\",\n",
        "    method_section\n",
        "):\n",
        "    raise ValueError(\n",
        "        \"Obsolete Methodology heading remains.\"\n",
        "    )\n",
        "\n",
        "if re.search(\n",
        "    r\"(?m)^## 4\\.\\d+\\s+\",\n",
        "    results_section\n",
        "):\n",
        "    raise ValueError(\n",
        "        \"Obsolete Results heading remains.\"\n",
        "    )\n",
        "\n",
        "if re.search(\n",
        "    r\"(?m)^## 5\\.\\d+\\s+\",\n",
        "    discussion_section\n",
        "):\n",
        "    raise ValueError(\n",
        "        \"Obsolete Discussion heading remains.\"\n",
        "    )\n",
        "\n",
        "print(\"\\n[8] SECTION-SPECIFIC NUMBERING VALIDATION\")\n",
        "print(\"PASS: Methodology 2.1–2.10\")\n",
        "print(\"PASS: Results 3.1–3.6\")\n",
        "print(\"PASS: Discussion 4.1–4.8\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 10. VERIFY APA 7 CITATIONS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "required_citations = [\n",
        "    \"Moses et al. (1994)\",\n",
        "    \"Beveridge et al. (2009)\",\n",
        "    \"Han et al. (2013)\",\n",
        "    \"Ochoa-Villegas et al. (2015)\"\n",
        "]\n",
        "\n",
        "for citation in required_citations:\n",
        "\n",
        "    if citation not in corrected_text:\n",
        "        raise ValueError(\n",
        "            f\"Required citation missing: {citation}\"\n",
        "        )\n",
        "\n",
        "if corrected_text.count(\"# References\") != 1:\n",
        "    raise ValueError(\n",
        "        \"References heading count is not one.\"\n",
        "    )\n",
        "\n",
        "reference_section = corrected_text[\n",
        "    corrected_text.index(\"# References\"):\n",
        "]\n",
        "\n",
        "required_reference_entries = [\n",
        "    \"Beveridge, J. R.\",\n",
        "    \"Han, H.\",\n",
        "    \"Moses, Y.\",\n",
        "    \"Ochoa-Villegas, M. A.\"\n",
        "]\n",
        "\n",
        "for entry in required_reference_entries:\n",
        "\n",
        "    if entry not in reference_section:\n",
        "        raise ValueError(\n",
        "            f\"Reference entry missing: {entry}\"\n",
        "        )\n",
        "\n",
        "print(\"\\n[9] APA 7 REFERENCE VALIDATION\")\n",
        "print(\"PASS: Four required citations\")\n",
        "print(\"PASS: Four reference entries\")\n",
        "print(\"PASS: Single References heading\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 11. VERIFY RESULTS TABLES\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "results_table_lines = re.findall(\n",
        "    r\"(?m)^\\|.*\\|$\",\n",
        "    results_section\n",
        ")\n",
        "\n",
        "if len(results_table_lines) < 13:\n",
        "    raise ValueError(\n",
        "        \"Expected Results tables are incomplete.\"\n",
        "    )\n",
        "\n",
        "if \"Six-test Holm p\" not in results_section:\n",
        "    raise ValueError(\n",
        "        \"Combined six-test Holm correction column missing.\"\n",
        "    )\n",
        "\n",
        "# Check Markdown table formatting.\n",
        "for line in results_table_lines:\n",
        "\n",
        "    if line.count(\"|\") < 3:\n",
        "        raise ValueError(\n",
        "            f\"Malformed Markdown table line: {line}\"\n",
        "        )\n",
        "\n",
        "print(\"\\n[10] RESULTS TABLE VALIDATION\")\n",
        "print(\"PASS: Table lines:\", len(results_table_lines))\n",
        "print(\"PASS: Combined six-test Holm column\")\n",
        "print(\"PASS: Markdown table syntax\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 12. VERIFY SCIENTIFIC CONTENT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "required_scientific_phrases = [\n",
        "    \"2,414\",\n",
        "    \"2,166\",\n",
        "    \"57 common\",\n",
        "    \"2,128\",\n",
        "    \"56 non-reference\",\n",
        "    \"646\",\n",
        "    \"418\",\n",
        "    \"1,064\",\n",
        "    \"38 matched identities\",\n",
        "    \"Kendall's W\",\n",
        "    \"squared Euclidean distance\",\n",
        "    \"Academic Torrents\",\n",
        "    \"operational drift\"\n",
        "]\n",
        "\n",
        "for phrase in required_scientific_phrases:\n",
        "\n",
        "    if phrase.lower() not in corrected_text.lower():\n",
        "\n",
        "        raise ValueError(\n",
        "            \"Scientific content check failed: \"\n",
        "            f\"{phrase}\"\n",
        "        )\n",
        "\n",
        "print(\"\\n[11] SCIENTIFIC CONTENT VALIDATION\")\n",
        "print(\n",
        "    \"PASS:\",\n",
        "    len(required_scientific_phrases),\n",
        "    \"required scientific content checks\"\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 13. VALIDATE THE ABSTRACT AND KEYWORDS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "if \"## Abstract\" not in corrected_text:\n",
        "    raise ValueError(\"Abstract heading missing.\")\n",
        "\n",
        "if \"## Keywords\" not in corrected_text:\n",
        "    raise ValueError(\"Keywords heading missing.\")\n",
        "\n",
        "abstract_start = corrected_text.index(\"## Abstract\")\n",
        "keywords_start = corrected_text.index(\"## Keywords\")\n",
        "\n",
        "abstract_text = corrected_text[\n",
        "    abstract_start:keywords_start\n",
        "]\n",
        "\n",
        "if len(abstract_text.split()) < 80:\n",
        "    raise ValueError(\n",
        "        \"Abstract content appears incomplete.\"\n",
        "    )\n",
        "\n",
        "keyword_text = corrected_text[\n",
        "    keywords_start:corrected_text.index(\n",
        "        \"# 1. Introduction\"\n",
        "    )\n",
        "]\n",
        "\n",
        "expected_keywords = [\n",
        "    \"Face recognition\",\n",
        "    \"Face embeddings\",\n",
        "    \"Illumination variation\",\n",
        "    \"Embedding displacement\",\n",
        "    \"Euclidean distance\",\n",
        "    \"Cosine distance\"\n",
        "]\n",
        "\n",
        "for keyword in expected_keywords:\n",
        "\n",
        "    if keyword not in keyword_text:\n",
        "        raise ValueError(\n",
        "            f\"Keyword missing: {keyword}\"\n",
        "        )\n",
        "\n",
        "print(\"\\n[12] ABSTRACT AND KEYWORDS\")\n",
        "print(\"PASS: Abstract present\")\n",
        "print(\"PASS: Six keywords present\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 14. SAVE ONLY AFTER ALL VALIDATIONS PASS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "MANUSCRIPT.write_text(\n",
        "    corrected_text,\n",
        "    encoding=\"utf-8\"\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 15. UPDATE INTEGRATION RECORD\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "new_hash = hashlib.sha256(\n",
        "    MANUSCRIPT.read_bytes()\n",
        ").hexdigest()\n",
        "\n",
        "integration_record[\"status\"] = (\n",
        "    \"INTEGRATED_MANUSCRIPT_STRUCTURALLY_CORRECTED\"\n",
        ")\n",
        "\n",
        "integration_record[\"last_updated_utc\"] = (\n",
        "    datetime.now(timezone.utc).isoformat()\n",
        ")\n",
        "\n",
        "integration_record[\"word_count\"] = len(\n",
        "    corrected_text.split()\n",
        ")\n",
        "\n",
        "integration_record[\"output_sha256\"] = new_hash\n",
        "\n",
        "integration_record[\"editorial_corrections\"] = {\n",
        "\n",
        "    \"methodology_numbering\": {\n",
        "        \"old\": \"3.1–3.10\",\n",
        "        \"new\": \"2.1–2.10\",\n",
        "        \"count\": methodology_changes\n",
        "    },\n",
        "\n",
        "    \"results_numbering\": {\n",
        "        \"old\": \"4.1–4.6\",\n",
        "        \"new\": \"3.1–3.6\",\n",
        "        \"count\": results_changes\n",
        "    },\n",
        "\n",
        "    \"discussion_numbering\": {\n",
        "        \"old\": \"5.1–5.8\",\n",
        "        \"new\": \"4.1–4.8\",\n",
        "        \"count\": discussion_changes\n",
        "    },\n",
        "\n",
        "    \"moses_apa7_citations\": {\n",
        "        \"narrative_corrections\": narrative_count,\n",
        "        \"parenthetical_corrections\": parenthetical_count,\n",
        "        \"corrected_format\": \"Moses et al. (1994)\"\n",
        "    },\n",
        "\n",
        "    \"duplicate_references_headings_removed\":\n",
        "        duplicate_count\n",
        "}\n",
        "\n",
        "integration_record[\"corrected_integrity_checks\"] = {\n",
        "\n",
        "    \"main_sections\": 5,\n",
        "\n",
        "    \"methodology_subsections\": len(method_headings),\n",
        "\n",
        "    \"results_subsections\": len(results_headings),\n",
        "\n",
        "    \"discussion_subsections\": len(discussion_headings),\n",
        "\n",
        "    \"references_heading_count\":\n",
        "        corrected_text.count(\"# References\"),\n",
        "\n",
        "    \"results_table_lines\":\n",
        "        len(results_table_lines),\n",
        "\n",
        "    \"required_citations_verified\":\n",
        "        len(required_citations),\n",
        "\n",
        "    \"scientific_content_checks\":\n",
        "        len(required_scientific_phrases),\n",
        "\n",
        "    \"abstract_verified\": True,\n",
        "\n",
        "    \"keywords_verified\": True,\n",
        "\n",
        "    \"section_specific_numbering_verified\": True,\n",
        "\n",
        "    \"status\": \"ALL_CORRECTION_CHECKS_PASSED\"\n",
        "}\n",
        "\n",
        "integration_record[\"editorial_status\"] = (\n",
        "    \"INTEGRATED_DRAFT_REQUIRES_FINAL_EDITORIAL_REVIEW\"\n",
        ")\n",
        "\n",
        "with open(\n",
        "    RECORD,\n",
        "    \"w\",\n",
        "    encoding=\"utf-8\"\n",
        ") as f:\n",
        "\n",
        "    json.dump(\n",
        "        integration_record,\n",
        "        f,\n",
        "        indent=2,\n",
        "        allow_nan=False\n",
        "    )\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 16. RELOAD AND VERIFY OUTPUTS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "reloaded_text = MANUSCRIPT.read_text(\n",
        "    encoding=\"utf-8\"\n",
        ")\n",
        "\n",
        "with open(\n",
        "    RECORD,\n",
        "    \"r\",\n",
        "    encoding=\"utf-8\"\n",
        ") as f:\n",
        "\n",
        "    reloaded_record = json.load(f)\n",
        "\n",
        "if reloaded_text != corrected_text:\n",
        "    raise RuntimeError(\n",
        "        \"Manuscript reload verification failed.\"\n",
        "    )\n",
        "\n",
        "reloaded_hash = hashlib.sha256(\n",
        "    MANUSCRIPT.read_bytes()\n",
        ").hexdigest()\n",
        "\n",
        "if reloaded_hash != reloaded_record[\"output_sha256\"]:\n",
        "    raise RuntimeError(\n",
        "        \"Manuscript SHA256 verification failed.\"\n",
        "    )\n",
        "\n",
        "if reloaded_record[\"status\"] != (\n",
        "    \"INTEGRATED_MANUSCRIPT_STRUCTURALLY_CORRECTED\"\n",
        "):\n",
        "    raise RuntimeError(\n",
        "        \"Integration record status verification failed.\"\n",
        "    )\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 17. FINAL REPORT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 80)\n",
        "\n",
        "print(\"STEP 3.3.12 — FINAL CORRECTION REPORT\")\n",
        "\n",
        "print(\"=\" * 80)\n",
        "\n",
        "print(\"\\n[1] SECTION NUMBERING\")\n",
        "\n",
        "print(\"Methodology: 2.1–2.10\")\n",
        "print(\"Corrected:\", methodology_changes)\n",
        "\n",
        "print(\"Results: 3.1–3.6\")\n",
        "print(\"Corrected:\", results_changes)\n",
        "\n",
        "print(\"Discussion: 4.1–4.8\")\n",
        "print(\"Corrected:\", discussion_changes)\n",
        "\n",
        "print(\"\\n[2] APA 7\")\n",
        "\n",
        "print(\"Moses narrative corrections:\", narrative_count)\n",
        "print(\"Moses parenthetical corrections:\", parenthetical_count)\n",
        "print(\"Required citations verified:\", len(required_citations))\n",
        "\n",
        "print(\"\\n[3] REFERENCES\")\n",
        "\n",
        "print(\"Duplicate headings removed:\", duplicate_count)\n",
        "print(\"Final References heading count:\", corrected_text.count(\"# References\"))\n",
        "\n",
        "print(\"\\n[4] RESULTS TABLES\")\n",
        "\n",
        "print(\"Markdown table lines:\", len(results_table_lines))\n",
        "print(\"Combined six-test Holm column: VERIFIED\")\n",
        "\n",
        "print(\"\\n[5] SCIENTIFIC CONTENT\")\n",
        "\n",
        "print(\n",
        "    len(required_scientific_phrases),\n",
        "    \"scientific content checks passed\"\n",
        ")\n",
        "\n",
        "print(\"\\n[6] ABSTRACT AND KEYWORDS\")\n",
        "\n",
        "print(\"Abstract: VERIFIED\")\n",
        "print(\"Keywords: VERIFIED\")\n",
        "\n",
        "print(\"\\n[7] OUTPUT FILES\")\n",
        "\n",
        "print(\"Integrated manuscript:\")\n",
        "print(MANUSCRIPT)\n",
        "\n",
        "print(\"\\nIntegration JSON:\")\n",
        "print(RECORD)\n",
        "\n",
        "print(\"\\n[8] INTEGRITY\")\n",
        "\n",
        "print(\"Word count:\", len(reloaded_text.split()))\n",
        "\n",
        "print(\"SHA256:\", reloaded_hash)\n",
        "\n",
        "print(\"Markdown reload: SUCCESS\")\n",
        "\n",
        "print(\"JSON reload: SUCCESS\")\n",
        "\n",
        "print(\"Original source documents modified: NO\")\n",
        "\n",
        "print(\"\\nFINAL STATUS:\")\n",
        "\n",
        "print(\n",
        "    \"INTEGRATED_MANUSCRIPT_STRUCTURALLY_CORRECTED\"\n",
        ")\n",
        "\n",
        "print(\"=\" * 80)\n"
      ],
