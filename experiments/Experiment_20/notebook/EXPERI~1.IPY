      "cell_type": "markdown",
      "source": [
        "## Experiment 20 — Step 3.3.9.14: Bootstrap Configuration Verification\n",
        "\n",
        "### Objective\n",
        "Verify the bootstrap configuration used to calculate confidence intervals in the repeated-measures statistical analysis.\n",
        "\n",
        "### Verification requirements\n",
        "1. Inspect the primary Step 2.7.4 repeated-measures audit.\n",
        "2. Identify the bootstrap iteration count.\n",
        "3. Identify the random seed.\n",
        "4. Check whether the same configuration was used for all reported confidence intervals.\n",
        "5. Compare the primary audit with the final frozen copy, where available.\n",
        "6. Record any missing or inconsistent configuration information.\n",
        "\n",
        "This is a verification-only step. Do not recalculate statistical tests, modify confidence intervals, or change frozen results."
      ],
      "metadata": {
        "id": "4QIC1paAOTD6"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# EXPERIMENT 20\n",
        "# STEP 3.3.9.14\n",
        "# BOOTSTRAP CONFIGURATION VERIFICATION\n",
        "# ============================================================\n",
        "\n",
        "import json\n",
        "from pathlib import Path\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "ROOT = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "\n",
        "candidate_paths = [\n",
        "    ROOT / \"step_2_7\" /\n",
        "    \"repeated_measures_analysis\" /\n",
        "    \"experiment20_step274_repeated_measures_audit.json\",\n",
        "\n",
        "    ROOT / \"step_2_7\" /\n",
        "    \"final_freeze\" /\n",
        "    \"experiment20_step274_repeated_measures_audit.json\"\n",
        "]\n",
        "\n",
        "print(\"=\" * 75)\n",
        "print(\"EXPERIMENT 20 — STEP 3.3.9.14\")\n",
        "print(\"BOOTSTRAP CONFIGURATION VERIFICATION\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "loaded_audits = []\n",
        "\n",
        "for path in candidate_paths:\n",
        "\n",
        "    print(\"\\n\" + \"-\" * 75)\n",
        "    print(\"FILE:\", path)\n",
        "\n",
        "    if not path.is_file():\n",
        "        print(\"STATUS: NOT FOUND\")\n",
        "        continue\n",
        "\n",
        "    with open(path, \"r\", encoding=\"utf-8\") as f:\n",
        "        data = json.load(f)\n",
        "\n",
        "    loaded_audits.append({\n",
        "        \"path\": str(path),\n",
        "        \"data\": data\n",
        "    })\n",
        "\n",
        "    print(\"STATUS: FOUND\")\n",
        "    print(\"Top-level keys:\", list(data.keys()))\n",
        "\n",
        "    # Display bootstrap-related fields recursively.\n",
        "    def find_bootstrap_fields(obj, location=\"root\"):\n",
        "\n",
        "        matches = []\n",
        "\n",
        "        if isinstance(obj, dict):\n",
        "\n",
        "            for key, value in obj.items():\n",
        "\n",
        "                key_lower = str(key).lower()\n",
        "\n",
        "                if (\n",
        "                    \"bootstrap\" in key_lower\n",
        "                    or \"random_seed\" in key_lower\n",
        "                    or key_lower == \"seed\"\n",
        "                ):\n",
        "                    matches.append({\n",
        "                        \"location\": location,\n",
        "                        \"key\": key,\n",
        "                        \"value\": value\n",
        "                    })\n",
        "\n",
        "                matches.extend(\n",
        "                    find_bootstrap_fields(\n",
        "                        value,\n",
        "                        f\"{location}.{key}\"\n",
        "                    )\n",
        "                )\n",
        "\n",
        "        elif isinstance(obj, list):\n",
        "\n",
        "            for index, value in enumerate(obj):\n",
        "                matches.extend(\n",
        "                    find_bootstrap_fields(\n",
        "                        value,\n",
        "                        f\"{location}[{index}]\"\n",
        "                    )\n",
        "                )\n",
        "\n",
        "        return matches\n",
        "\n",
        "    fields = find_bootstrap_fields(data)\n",
        "\n",
        "    print(\"\\nBootstrap-related fields:\")\n",
        "\n",
        "    if fields:\n",
        "        for item in fields:\n",
        "            print(json.dumps(item, indent=2))\n",
        "    else:\n",
        "        print(\"No bootstrap-related fields found.\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# COMPARE AVAILABLE AUDITS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 75)\n",
        "print(\"AUDIT COMPARISON\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "if len(loaded_audits) >= 2:\n",
        "\n",
        "    primary = loaded_audits[0][\"data\"]\n",
        "    frozen = loaded_audits[1][\"data\"]\n",
        "\n",
        "    print(\n",
        "        \"Primary and frozen top-level structures identical:\",\n",
        "        primary == frozen\n",
        "    )\n",
        "\n",
        "elif len(loaded_audits) == 1:\n",
        "\n",
        "    print(\n",
        "        \"Only one audit copy was found; \"\n",
        "        \"a primary-versus-frozen comparison is unavailable.\"\n",
        "    )\n",
        "\n",
        "else:\n",
        "\n",
        "    print(\n",
        "        \"Neither expected audit file was found. \"\n",
        "        \"No configuration conclusion can be made.\"\n",
        "    )\n",
        "\n",
        "print(\"\\n\" + \"=\" * 75)\n",
        "print(\"STEP 3.3.9.14 INSPECTION COMPLETED\")\n",
        "print(\"=\" * 75)"
      ],
