    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# EXPERIMENT 20 — STEP 3.3.31\n",
        "# INTEGRATED MANUSCRIPT INTEGRITY AUDIT\n",
        "# READ-ONLY\n",
        "# ============================================================\n",
        "\n",
        "import os\n",
        "import re\n",
        "import json\n",
        "import hashlib\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "BASE = \"/content/drive/MyDrive/Experiment_20_Results\"\n",
        "\n",
        "SOURCE = os.path.join(\n",
        "    BASE, \"step_3_3\", \"step_3312\",\n",
        "    \"experiment20_integrated_manuscript_v1.md\"\n",
        ")\n",
        "\n",
        "NEW = os.path.join(\n",
        "    BASE, \"step_3_3\", \"step_3330\",\n",
        "    \"experiment20_integrated_manuscript_v2.md\"\n",
        ")\n",
        "\n",
        "FIGURE_DIR = os.path.join(\n",
        "    BASE, \"step_3_3\", \"step_3330\", \"figures\"\n",
        ")\n",
        "\n",
        "OUTPUT_DIR = os.path.join(\n",
        "    BASE, \"step_3_3\", \"step_3331\"\n",
        ")\n",
        "os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
        "\n",
        "REPORT_PATH = os.path.join(\n",
        "    OUTPUT_DIR,\n",
        "    \"experiment20_step3331_integrated_manuscript_audit.json\"\n",
        ")\n",
        "\n",
        "EXPECTED = {\n",
        "    \"experiment20_figure1_euclidean_illumination_groups.png\":\n",
        "        \"71623f613dc8202cf5cf6ff7bea005b315e4a31de73841d064c896b24e565b16\",\n",
        "    \"experiment20_figure2_cosine_illumination_groups.png\":\n",
        "        \"de22ee98a909ef099199f5b49911633497c2c890d9d903224131f95db54c917c\",\n",
        "    \"experiment20_figure3_euclidean_hemisphere_comparison.png\":\n",
        "        \"5a55b8947698a35dd20a258a4d185b927a64ccdac4a4b18d8aad4bd6d35fc0c6\",\n",
        "    \"experiment20_figure4_cosine_hemisphere_comparison.png\":\n",
        "        \"0a06e0a5458ec2779aee94778f59fd576e585f8fc85fdd3e82afb6c91211851c\"\n",
        "}\n",
        "\n",
        "\n",
        "def sha256_file(path):\n",
        "    h = hashlib.sha256()\n",
        "    with open(path, \"rb\") as f:\n",
        "        for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n",
        "            h.update(chunk)\n",
        "    return h.hexdigest()\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. LOAD MANUSCRIPTS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "for path in [SOURCE, NEW]:\n",
        "    if not os.path.isfile(path):\n",
        "        raise FileNotFoundError(path)\n",
        "\n",
        "with open(SOURCE, \"r\", encoding=\"utf-8\") as f:\n",
        "    original = f.read()\n",
        "\n",
        "with open(NEW, \"r\", encoding=\"utf-8\") as f:\n",
        "    revised = f.read()\n",
        "\n",
        "source_hash = sha256_file(SOURCE)\n",
        "new_hash = sha256_file(NEW)\n",
        "\n",
        "print(\"=\" * 100)\n",
        "print(\"STEP 3.3.31 — INTEGRATED MANUSCRIPT AUDIT\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "print(\"Original SHA256:\", source_hash)\n",
        "print(\"New manuscript SHA256:\", new_hash)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. IMAGE PATH AND HASH VALIDATION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "image_checks = {}\n",
        "\n",
        "for filename, expected_hash in EXPECTED.items():\n",
        "\n",
        "    relative_path = \"figures/\" + filename\n",
        "    actual_path = os.path.join(FIGURE_DIR, filename)\n",
        "\n",
        "    embedded = revised.count(\n",
        "        f\"]({relative_path})\"\n",
        "    ) == 1\n",
        "\n",
        "    exists = os.path.isfile(actual_path)\n",
        "\n",
        "    actual_hash = (\n",
        "        sha256_file(actual_path)\n",
        "        if exists else None\n",
        "    )\n",
        "\n",
        "    hash_match = (\n",
        "        exists and actual_hash == expected_hash\n",
        "    )\n",
        "\n",
        "    image_checks[filename] = {\n",
        "        \"relative_path\": relative_path,\n",
        "        \"embedded_once\": embedded,\n",
        "        \"file_exists\": exists,\n",
        "        \"expected_sha256\": expected_hash,\n",
        "        \"actual_sha256\": actual_hash,\n",
        "        \"hash_matches\": hash_match,\n",
        "        \"passed\": embedded and exists and hash_match\n",
        "    }\n",
        "\n",
        "    print(\"\\n\", filename)\n",
        "    print(\"Embedded once:\", embedded)\n",
        "    print(\"File exists:\", exists)\n",
        "    print(\"Hash matches:\", hash_match)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. CAPTION VALIDATION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "caption_checks = {\n",
        "    \"figure1\": (\n",
        "        \"Figure 1. Identity-level Euclidean displacement\"\n",
        "        in revised\n",
        "    ),\n",
        "    \"figure2\": (\n",
        "        \"Figure 2. Identity-level cosine distance\"\n",
        "        in revised\n",
        "    ),\n",
        "    \"figure3\": (\n",
        "        \"Figure 3. Paired identity-level Euclidean displacement\"\n",
        "        in revised\n",
        "    ),\n",
        "    \"figure4\": (\n",
        "        \"Figure 4. Paired identity-level cosine distance\"\n",
        "        in revised\n",
        "    )\n",
        "}\n",
        "\n",
        "print(\"\\nCAPTION CHECKS\")\n",
        "for name, passed in caption_checks.items():\n",
        "    print(name, passed)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. IN-TEXT REFERENCE VALIDATION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "reference_checks = {}\n",
        "\n",
        "for number in range(1, 5):\n",
        "    reference_checks[f\"Figure {number}\"] = bool(\n",
        "        re.search(rf\"\\bFigure {number}\\b\", revised)\n",
        "    )\n",
        "\n",
        "print(\"\\nIN-TEXT REFERENCES\")\n",
        "for name, passed in reference_checks.items():\n",
        "    print(name, passed)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. PLACEMENT VALIDATION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "table1_end = (\n",
        "    \"| Large-angular deviation | 1064 | 38 | 28 | 1.1185 | \"\n",
        "    \"0.2175 | 0.6491 | 0.2388 |\"\n",
        ")\n",
        "\n",
        "section34 = \"## 3.4 Identity-level repeated-measures analysis\"\n",
        "\n",
        "table1_position = revised.find(table1_end)\n",
        "figure1_position = revised.find(\n",
        "    \"![Identity-level Euclidean displacement\"\n",
        ")\n",
        "figure2_position = revised.find(\n",
        "    \"![Identity-level cosine distance\"\n",
        ")\n",
        "section34_position = revised.find(section34)\n",
        "\n",
        "group_placement_pass = (\n",
        "    table1_position >= 0\n",
        "    and figure1_position > table1_position\n",
        "    and figure2_position > figure1_position\n",
        "    and section34_position > figure2_position\n",
        ")\n",
        "\n",
        "euclidean_result = revised.find(\n",
        "    \"Holm-adjusted p = 1.455e-11). (Figure 3).\"\n",
        ")\n",
        "cosine_result = revised.find(\n",
        "    \"Holm-adjusted p = 1.455e-11). (Figure 4).\"\n",
        ")\n",
        "\n",
        "figure3_position = revised.find(\n",
        "    \"![Paired identity-level Euclidean displacement\"\n",
        ")\n",
        "figure4_position = revised.find(\n",
        "    \"![Paired identity-level cosine distance\"\n",
        ")\n",
        "\n",
        "limitation_position = revised.find(\n",
        "    \"This comparison is exploratory.\"\n",
        ")\n",
        "\n",
        "hemisphere_placement_pass = (\n",
        "    euclidean_result >= 0\n",
        "    and cosine_result > euclidean_result\n",
        "    and figure3_position > cosine_result\n",
        "    and figure4_position > figure3_position\n",
        "    and limitation_position > figure4_position\n",
        ")\n",
        "\n",
        "print(\"\\nPLACEMENT CHECKS\")\n",
        "print(\"Figures 1–2 after Table 1:\", group_placement_pass)\n",
        "print(\"Figures 3–4 after hemisphere results:\", hemisphere_placement_pass)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. TABLE PRESERVATION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def extract_table_block(text, heading):\n",
        "\n",
        "    lines = text.splitlines()\n",
        "\n",
        "    index = next(\n",
        "        (\n",
        "            i for i, line in enumerate(lines)\n",
        "            if heading in line\n",
        "        ),\n",
        "        None\n",
        "    )\n",
        "\n",
        "    if index is None:\n",
        "        raise ValueError(f\"Heading not found: {heading}\")\n",
        "\n",
        "    block = [lines[index]]\n",
        "    i = index + 1\n",
        "\n",
        "    while i < len(lines):\n",
        "\n",
        "        if lines[i].strip().startswith(\"|\"):\n",
        "            block.append(lines[i])\n",
        "        elif block and block[-1].strip().startswith(\"|\"):\n",
        "            break\n",
        "\n",
        "        i += 1\n",
        "\n",
        "    return \"\\n\".join(block)\n",
        "\n",
        "\n",
        "table1_original = extract_table_block(\n",
        "    original, \"Table 1. Descriptive statistics\"\n",
        ")\n",
        "table1_new = extract_table_block(\n",
        "    revised, \"Table 1. Descriptive statistics\"\n",
        ")\n",
        "\n",
        "table2_original = extract_table_block(\n",
        "    original, \"Table 2. Identity-level pairwise comparisons\"\n",
        ")\n",
        "table2_new = extract_table_block(\n",
        "    revised, \"Table 2. Identity-level pairwise comparisons\"\n",
        ")\n",
        "\n",
        "table_checks = {\n",
        "    \"table1_unchanged\": table1_original == table1_new,\n",
        "    \"table2_unchanged\": table2_original == table2_new\n",
        "}\n",
        "\n",
        "print(\"\\nTABLE PRESERVATION\")\n",
        "for name, passed in table_checks.items():\n",
        "    print(name, passed)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. SECTION PRESERVATION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "required_headings = [\n",
        "    \"# 1. Introduction\",\n",
        "    \"# 2. Methodology\",\n",
        "    \"# 3. Results\",\n",
        "    \"## 3.1 Evaluation cohort and analysis coverage\",\n",
        "    \"## 3.2 Overall reference-relative embedding displacement\",\n",
        "    \"## 3.3 Displacement across illumination geometry groups\",\n",
        "    \"## 3.4 Identity-level repeated-measures analysis\",\n",
        "    \"## 3.5 Exploratory frontal and beyond-frontal comparison\",\n",
        "    \"## 3.6 Summary of findings\",\n",
        "    \"# 4. Discussion\",\n",
        "    \"# References\"\n",
        "]\n",
        "\n",
        "heading_checks = {\n",
        "    heading: heading in revised\n",
        "    for heading in required_headings\n",
        "}\n",
        "\n",
        "all_headings_present = all(heading_checks.values())\n",
        "\n",
        "print(\"\\nSECTION PRESERVATION\")\n",
        "for heading, passed in heading_checks.items():\n",
        "    print(passed, heading)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 8. OVERALL STATUS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "all_images_pass = all(\n",
        "    item[\"passed\"]\n",
        "    for item in image_checks.values()\n",
        ")\n",
        "\n",
        "all_captions_pass = all(caption_checks.values())\n",
        "all_references_pass = all(reference_checks.values())\n",
        "all_tables_pass = all(table_checks.values())\n",
        "\n",
        "all_checks_pass = all([\n",
        "    all_images_pass,\n",
        "    all_captions_pass,\n",
        "    all_references_pass,\n",
        "    group_placement_pass,\n",
        "    hemisphere_placement_pass,\n",
        "    all_tables_pass,\n",
        "    all_headings_present,\n",
        "    source_hash == sha256_file(SOURCE)\n",
        "])\n",
        "\n",
        "report = {\n",
        "    \"step\": \"3.3.31\",\n",
        "    \"created_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "    \"source_manuscript_sha256\": source_hash,\n",
        "    \"new_manuscript_sha256\": new_hash,\n",
        "    \"image_checks\": image_checks,\n",
        "    \"caption_checks\": caption_checks,\n",
        "    \"reference_checks\": reference_checks,\n",
        "    \"group_figure_placement_pass\": group_placement_pass,\n",
        "    \"hemisphere_figure_placement_pass\": hemisphere_placement_pass,\n",
        "    \"table_checks\": table_checks,\n",
        "    \"heading_checks\": heading_checks,\n",
        "    \"all_checks_pass\": all_checks_pass,\n",
        "    \"status\": (\n",
        "        \"PASS_INTEGRATED_MANUSCRIPT_VALIDATED\"\n",
        "        if all_checks_pass\n",
        "        else \"MANUAL_REVIEW_REQUIRED\"\n",
        "    ),\n",
        "    \"integrity\": {\n",
        "        \"original_manuscript_modified\": False,\n",
        "        \"new_manuscript_modified_during_audit\": False,\n",
        "        \"frozen_figures_modified\": False\n",
        "    }\n",
        "}\n",
        "\n",
        "with open(REPORT_PATH, \"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(report, f, indent=2)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"FINAL STATUS\")\n",
        "print(\"=\" * 100)\n",
        "print(\"All image checks:\", all_images_pass)\n",
        "print(\"All captions:\", all_captions_pass)\n",
        "print(\"All references:\", all_references_pass)\n",
        "print(\"Group figure placement:\", group_placement_pass)\n",
        "print(\"Hemisphere figure placement:\", hemisphere_placement_pass)\n",
        "print(\"Tables unchanged:\", all_tables_pass)\n",
        "print(\"All original headings present:\", all_headings_present)\n",
        "print(\"STATUS:\", report[\"status\"])\n",
        "print(\"Report:\", REPORT_PATH)\n",
        "print(\"Report SHA256:\", sha256_file(REPORT_PATH))\n",
        "print(\"STEP 3.3.31 COMPLETED\")"
      ],
      "metadata": {
