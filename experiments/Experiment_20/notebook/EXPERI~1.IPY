        "    ),\n",
        "\n",
        "    \"reference_relative_analysis\": (\n",
        "        \"reference-relative\" in discussion.lower()\n",
        "        or \"reference relative\" in discussion.lower()\n",
        "    ),\n",
        "\n",
        "    \"no_unverified_operational_system_claim\": (\n",
        "        \"operational drift-detection\" in discussion.lower()\n",
        "        or \"drift-detection capability\" in discussion.lower()\n",
        "        or \"drift detection\" in discussion.lower()\n",
        "    )\n",
        "}\n",
        "\n",
        "future_work_matches = re.findall(\n",
        "    r\"(?im)^.*(?:future work|future research|further research|\"\n",
        "    r\"future studies|subsequent studies).*$\",\n",
        "    discussion\n",
        ")\n",
        "\n",
        "future_work_checks = {\n",
        "    \"future_research_discussed\": len(future_work_matches) > 0,\n",
        "    \"future_research_statements\": future_work_matches\n",
