      "cell_type": "code",
      "source": [
        "\n",
        "# =============================================================================\n",
        "# EXPERIMENT 20 — PHASE 5.3\n",
        "# FINAL ARTIFACT VERIFICATION\n",
        "# =============================================================================\n",
        "# Purpose:\n",
        "# Verify final research deliverables without modifying existing artifacts.\n",
        "#\n",
        "# Existing research files are read-only.\n",
        "# Two new timestamped reports are created in the Phase 5.3 directory.\n",
        "# =============================================================================\n",
        "\n",
        "import json\n",
        "import hashlib\n",
        "import zipfile\n",
        "import platform\n",
        "import sys\n",
        "from pathlib import Path\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "# -----------------------------------------------------------------------------\n",
        "# 1. PATHS AND CONFIGURATION\n",
        "# -----------------------------------------------------------------------------\n",
        "\n",
        "DRIVE_ROOT = Path(\"/content/drive/MyDrive\")\n",
        "\n",
        "RESULTS_ROOT = DRIVE_ROOT / \"Experiment_20_Results\"\n",
        "\n",
        "NOTEBOOK_PATH = (\n",
        "    DRIVE_ROOT\n",
        "    / \"Colab Notebooks\"\n",
        "    / \"Experiment 20: Paired Identity-Level Evaluation of Within-Identity \"\n",
        "      \"Embedding Drift Detection Under Multiple Controlled Biometric \"\n",
        "      \"Acquisition Changes.ipynb\"\n",
        ")\n",
        "\n",
        "MANUSCRIPT_PATH = (\n",
        "    RESULTS_ROOT\n",
        "    / \"step_3_3\"\n",
        "    / \"step_3330\"\n",
        "    / \"experiment20_integrated_manuscript_v2.md\"\n",
        ")\n",
        "\n",
        "FROZEN_DATASET_PATH = (\n",
        "    RESULTS_ROOT\n",
        "    / \"Experiment_20_Stage_2_Frozen_Dataset.zip\"\n",
        ")\n",
        "\n",
        "EMBEDDING_PATH = (\n",
        "    RESULTS_ROOT\n",
        "    / \"embeddings\"\n",
        "    / \"experiment20_croppedyale_facenet_embeddings.npz\"\n",
        ")\n",
        "\n",
        "CLOSURE_REPORT_NAME = (\n",
        "    \"experiment20_step3336_final_integrity_and_closure_report.json\"\n",
        ")\n",
        "\n",
        "PHASE52_DIR = (\n",
        "    RESULTS_ROOT\n",
        "    / \"step_5_2_reproducibility_integrity_review\"\n",
        ")\n",
        "\n",
        "PHASE53_DIR = (\n",
        "    RESULTS_ROOT\n",
        "    / \"step_5_3_final_artifact_verification\"\n",
        ")\n",
        "\n",
        "PHASE53_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "TIMESTAMP = datetime.now(timezone.utc).strftime(\"%Y%m%dT%H%M%SZ\")\n",
        "TIMESTAMP_ISO = datetime.now(timezone.utc).isoformat()\n",
        "\n",
        "# -----------------------------------------------------------------------------\n",
        "# 2. AUDIT HELPERS\n",
        "# -----------------------------------------------------------------------------\n",
        "\n",
        "results = []\n",
        "artifact_records = []\n",
        "\n",
        "def sha256_file(path, chunk_size=1024 * 1024):\n",
        "    digest = hashlib.sha256()\n",
        "\n",
        "    with open(path, \"rb\") as file:\n",
        "        while True:\n",
        "            chunk = file.read(chunk_size)\n",
        "            if not chunk:\n",
        "                break\n",
        "            digest.update(chunk)\n",
        "\n",
        "    return digest.hexdigest()\n",
        "\n",
        "\n",
        "def record(name, status, path=None, details=\"\"):\n",
        "    results.append({\n",
        "        \"artifact\": name,\n",
        "        \"status\": status,\n",
        "        \"path\": str(path) if path else None,\n",
        "        \"details\": str(details)\n",
        "    })\n",
        "\n",
        "\n",
        "def inspect_file(name, path, required=True):\n",
        "    path = Path(path)\n",
        "\n",
        "    if not path.exists():\n",
        "        status = \"FAIL\" if required else \"REVIEW\"\n",
        "\n",
        "        record(\n",
        "            name,\n",
        "            status,\n",
        "            path,\n",
        "            \"File does not exist.\"\n",
        "        )\n",
        "        return None\n",
        "\n",
        "    if not path.is_file():\n",
        "        record(\n",
        "            name,\n",
        "            \"FAIL\",\n",
        "            path,\n",
        "            \"Path exists but is not a regular file.\"\n",
        "        )\n",
        "        return None\n",
        "\n",
        "    try:\n",
        "        size = path.stat().st_size\n",
        "\n",
        "        if size == 0:\n",
        "            record(\n",
        "                name,\n",
        "                \"FAIL\",\n",
        "                path,\n",
        "                \"File exists but is empty.\"\n",
        "            )\n",
        "            return None\n",
        "\n",
        "        digest = sha256_file(path)\n",
        "\n",
        "        artifact_records.append({\n",
        "            \"name\": name,\n",
        "            \"path\": str(path),\n",
        "            \"size_bytes\": size,\n",
        "            \"sha256\": digest\n",
        "        })\n",
        "\n",
        "        return {\n",
        "            \"path\": path,\n",
        "            \"size_bytes\": size,\n",
        "            \"sha256\": digest\n",
        "        }\n",
        "\n",
        "    except Exception as exc:\n",
        "        record(\n",
        "            name,\n",
        "            \"FAIL\",\n",
        "            path,\n",
        "            f\"Unable to read or hash file: {repr(exc)}\"\n",
        "        )\n",
        "        return None\n",
        "\n",
        "\n",
        "print(\"=\" * 85)\n",
        "print(\"EXPERIMENT 20 — PHASE 5.3 FINAL ARTIFACT VERIFICATION\")\n",
        "print(\"=\" * 85)\n",
        "print(\"Timestamp UTC:\", TIMESTAMP_ISO)\n",
        "print(\"Python:\", sys.version)\n",
        "print(\"Platform:\", platform.platform())\n",
        "print(\"Project directory:\", RESULTS_ROOT)\n",
        "print()\n",
        "\n",
        "# -----------------------------------------------------------------------------\n",
        "# 3. PROJECT DIRECTORY\n",
        "# -----------------------------------------------------------------------------\n",
        "\n",
        "if RESULTS_ROOT.is_dir():\n",
        "    record(\n",
        "        \"Experiment 20 results directory\",\n",
        "        \"PASS\",\n",
        "        RESULTS_ROOT,\n",
        "        \"Project results directory exists.\"\n",
        "    )\n",
        "else:\n",
        "    record(\n",
        "        \"Experiment 20 results directory\",\n",
        "        \"FAIL\",\n",
        "        RESULTS_ROOT,\n",
        "        \"Project results directory is missing.\"\n",
        "    )\n",
        "\n",
        "# -----------------------------------------------------------------------------\n",
        "# 4. FINAL NOTEBOOK\n",
        "# -----------------------------------------------------------------------------\n",
        "\n",
        "notebook_info = inspect_file(\n",
        "    \"Final Experiment 20 notebook\",\n",
        "    NOTEBOOK_PATH,\n",
        "    required=True\n",
        ")\n",
        "\n",
        "if notebook_info:\n",
        "    try:\n",
        "        with open(NOTEBOOK_PATH, \"r\", encoding=\"utf-8\") as file:\n",
        "            notebook = json.load(file)\n",
        "\n",
        "        cells = notebook.get(\"cells\")\n",
        "\n",
        "        if not isinstance(cells, list):\n",
        "            raise ValueError(\"Notebook does not contain a valid cells list.\")\n",
        "\n",
        "        record(\n",
        "            \"Notebook JSON and structure\",\n",
        "            \"PASS\",\n",
        "            NOTEBOOK_PATH,\n",
        "            f\"Valid notebook JSON; total cells={len(cells)}.\"\n",
        "        )\n",
        "\n",
        "    except Exception as exc:\n",
        "        record(\n",
        "            \"Notebook JSON and structure\",\n",
        "            \"FAIL\",\n",
        "            NOTEBOOK_PATH,\n",
        "            repr(exc)\n",
        "        )\n",
        "\n",
        "# -----------------------------------------------------------------------------\n",
        "# 5. FINAL MANUSCRIPT\n",
        "# -----------------------------------------------------------------------------\n",
        "\n",
        "manuscript_info = inspect_file(\n",
        "    \"Integrated manuscript v2\",\n",
        "    MANUSCRIPT_PATH,\n",
        "    required=True\n",
        ")\n",
        "\n",
        "if manuscript_info:\n",
        "    try:\n",
        "        manuscript_text = MANUSCRIPT_PATH.read_text(encoding=\"utf-8\")\n",
        "\n",
        "        if len(manuscript_text.strip()) == 0:\n",
        "            raise ValueError(\"Manuscript contains no readable text.\")\n",
        "\n",
        "        heading_count = sum(\n",
        "            1 for line in manuscript_text.splitlines()\n",
        "            if line.strip().startswith(\"#\")\n",
        "        )\n",
        "\n",
        "        record(\n",
        "            \"Manuscript readability\",\n",
        "            \"PASS\",\n",
        "            MANUSCRIPT_PATH,\n",
        "            f\"Readable Markdown; characters={len(manuscript_text)}; \"\n",
        "            f\"headings={heading_count}.\"\n",
        "        )\n",
        "\n",
        "    except Exception as exc:\n",
        "        record(\n",
        "            \"Manuscript readability\",\n",
        "            \"FAIL\",\n",
        "            MANUSCRIPT_PATH,\n",
        "            repr(exc)\n",
        "        )\n",
        "\n",
        "# -----------------------------------------------------------------------------\n",
        "# 6. FROZEN DATASET ARCHIVE\n",
        "# -----------------------------------------------------------------------------\n",
        "\n",
        "dataset_info = inspect_file(\n",
        "    \"Frozen Stage 2 dataset archive\",\n",
        "    FROZEN_DATASET_PATH,\n",
        "    required=True\n",
        ")\n",
        "\n",
        "if dataset_info:\n",
        "    try:\n",
        "        with zipfile.ZipFile(FROZEN_DATASET_PATH, \"r\") as archive:\n",
        "            bad_member = archive.testzip()\n",
        "            members = archive.namelist()\n",
        "\n",
        "        if bad_member is None:\n",
        "            record(\n",
        "                \"Frozen dataset archive readability\",\n",
        "                \"PASS\",\n",
        "                FROZEN_DATASET_PATH,\n",
        "                f\"ZIP integrity passed; archive members={len(members)}.\"\n",
        "            )\n",
        "        else:\n",
        "            record(\n",
        "                \"Frozen dataset archive readability\",\n",
        "                \"FAIL\",\n",
        "                FROZEN_DATASET_PATH,\n",
        "                f\"Corrupt archive member: {bad_member}\"\n",
        "            )\n",
        "\n",
        "    except Exception as exc:\n",
        "        record(\n",
        "            \"Frozen dataset archive readability\",\n",
        "            \"FAIL\",\n",
        "            FROZEN_DATASET_PATH,\n",
        "            repr(exc)\n",
        "        )\n",
        "\n",
        "# -----------------------------------------------------------------------------\n",
        "# 7. EMBEDDING OUTPUT\n",
        "# -----------------------------------------------------------------------------\n",
        "\n",
        "embedding_info = inspect_file(\n",
        "    \"Final embedding output\",\n",
        "    EMBEDDING_PATH,\n",
        "    required=True\n",
        ")\n",
        "\n",
        "if embedding_info:\n",
        "    try:\n",
        "        import numpy as np\n",
        "\n",
        "        with np.load(EMBEDDING_PATH, allow_pickle=False) as data:\n",
        "            array_details = {}\n",
        "\n",
        "            for key in data.files:\n",
        "                array = data[key]\n",
        "\n",
        "                array_details[key] = {\n",
        "                    \"shape\": list(array.shape),\n",
        "                    \"dtype\": str(array.dtype),\n",
        "                    \"finite\": (\n",
        "                        bool(np.isfinite(array).all())\n",
        "                        if np.issubdtype(array.dtype, np.number)\n",
        "                        else None\n",
        "                    )\n",
        "                }\n",
        "\n",
        "        non_finite_arrays = [\n",
        "            key for key, details in array_details.items()\n",
        "            if details[\"finite\"] is False\n",
        "        ]\n",
        "\n",
        "        if non_finite_arrays:\n",
        "            record(\n",
        "                \"Embedding archive readability and numerical integrity\",\n",
        "                \"FAIL\",\n",
        "                EMBEDDING_PATH,\n",
        "                f\"Non-finite values detected in arrays: {non_finite_arrays}\"\n",
        "            )\n",
        "        else:\n",
        "            record(\n",
        "                \"Embedding archive readability and numerical integrity\",\n",
        "                \"PASS\",\n",
        "                EMBEDDING_PATH,\n",
        "                f\"NPZ archive readable; arrays={array_details}\"\n",
        "            )\n",
        "\n",
        "    except Exception as exc:\n",
        "        record(\n",
        "            \"Embedding archive readability and numerical integrity\",\n",
        "            \"FAIL\",\n",
        "            EMBEDDING_PATH,\n",
        "            repr(exc)\n",
        "        )\n",
        "\n",
        "# -----------------------------------------------------------------------------\n",
        "# 8. FINAL CLOSURE REPORT\n",
        "# -----------------------------------------------------------------------------\n",
        "\n",
        "closure_candidates = list(\n",
        "    RESULTS_ROOT.rglob(CLOSURE_REPORT_NAME)\n",
        ") if RESULTS_ROOT.exists() else []\n",
        "\n",
        "if len(closure_candidates) == 1:\n",
        "    closure_path = closure_candidates[0]\n",
        "\n",
        "    closure_info = inspect_file(\n",
        "        \"Final experiment closure report\",\n",
        "        closure_path,\n",
        "        required=True\n",
        "    )\n",
        "\n",
        "    if closure_info:\n",
        "        try:\n",
        "            with open(closure_path, \"r\", encoding=\"utf-8\") as file:\n",
        "                closure_data = json.load(file)\n",
        "\n",
        "            record(\n",
        "                \"Closure report JSON validity\",\n",
        "                \"PASS\",\n",
        "                closure_path,\n",
        "                \"Closure report is valid JSON.\"\n",
        "            )\n",
        "\n",
        "        except Exception as exc:\n",
        "            record(\n",
        "                \"Closure report JSON validity\",\n",
        "                \"FAIL\",\n",
        "                closure_path,\n",
        "                repr(exc)\n",
        "            )\n",
        "\n",
        "elif len(closure_candidates) == 0:\n",
        "    record(\n",
        "        \"Final experiment closure report\",\n",
        "        \"FAIL\",\n",
        "        RESULTS_ROOT,\n",
        "        f\"Expected file not found: {CLOSURE_REPORT_NAME}\"\n",
        "    )\n",
        "\n",
        "else:\n",
        "    record(\n",
        "        \"Final experiment closure report\",\n",
        "        \"REVIEW\",\n",
        "        RESULTS_ROOT,\n",
        "        f\"Multiple matching closure reports found: \"\n",
        "        f\"{[str(p) for p in closure_candidates]}\"\n",
        "    )\n",
        "\n",
        "# -----------------------------------------------------------------------------\n",
        "# 9. FIGURE VERIFICATION\n",
        "# -----------------------------------------------------------------------------\n",
        "\n",
        "FIGURE_EXTENSIONS = {\n",
        "    \".png\", \".jpg\", \".jpeg\", \".tif\", \".tiff\", \".webp\"\n",
        "}\n",
        "\n",
        "STEP33_ROOT = RESULTS_ROOT / \"step_3_3\"\n",
        "\n",
        "figure_candidates = []\n",
        "\n",
        "if STEP33_ROOT.is_dir():\n",
        "    figure_candidates = sorted(\n",
        "        path for path in STEP33_ROOT.rglob(\"*\")\n",
        "        if path.is_file()\n",
        "        and path.suffix.lower() in FIGURE_EXTENSIONS\n",
        "        and \"figure\" in path.name.lower()\n",
        "    )\n",
        "\n",
        "if len(figure_candidates) >= 4:\n",
        "    valid_figures = 0\n",
        "    invalid_figures = []\n",
        "\n",
        "    for figure_path in figure_candidates:\n",
        "        info = inspect_file(\n",
        "            f\"Figure: {figure_path.name}\",\n",
        "            figure_path,\n",
        "            required=True\n",
        "        )\n",
        "\n",
        "        if not info:\n",
        "            invalid_figures.append(str(figure_path))\n",
        "            continue\n",
        "\n",
        "        try:\n",
        "            with open(figure_path, \"rb\") as file:\n",
        "                header = file.read(16)\n",
        "\n",
        "            # Check common image-file signatures.\n",
        "            suffix = figure_path.suffix.lower()\n",
        "\n",
        "            signature_valid = False\n",
        "\n",
        "            if suffix == \".png\":\n",
        "                signature_valid = header.startswith(\n",
        "                    b\"\\x89PNG\\r\\n\\x1a\\n\"\n",
        "                )\n",
        "            elif suffix in {\".jpg\", \".jpeg\"}:\n",
        "                signature_valid = header.startswith(b\"\\xff\\xd8\")\n",
        "            elif suffix in {\".tif\", \".tiff\"}:\n",
        "                signature_valid = (\n",
        "                    header.startswith(b\"II*\\x00\")\n",
        "                    or header.startswith(b\"MM\\x00*\")\n",
        "                )\n",
        "            elif suffix == \".webp\":\n",
        "                signature_valid = (\n",
        "                    header.startswith(b\"RIFF\")\n",
        "                    and header[8:12] == b\"WEBP\"\n",
        "                )\n",
        "\n",
        "            if signature_valid:\n",
        "                valid_figures += 1\n",
        "            else:\n",
        "                invalid_figures.append(str(figure_path))\n",
        "\n",
        "        except Exception:\n",
        "            invalid_figures.append(str(figure_path))\n",
        "\n",
        "    if invalid_figures:\n",
        "        record(\n",
        "            \"Final figure file integrity\",\n",
        "            \"FAIL\",\n",
        "            STEP33_ROOT,\n",
        "            f\"Invalid or unreadable figure files: {invalid_figures}\"\n",
        "        )\n",
        "    else:\n",
        "        record(\n",
        "            \"Final figure file integrity\",\n",
        "            \"PASS\",\n",
        "            STEP33_ROOT,\n",
        "            f\"Verified {valid_figures} figure image files.\"\n",
        "        )\n",
        "\n",
        "else:\n",
        "    record(\n",
        "        \"Final figure availability\",\n",
        "        \"FAIL\",\n",
        "        STEP33_ROOT,\n",
        "        f\"Expected at least 4 figure files; found {len(figure_candidates)}.\"\n",
        "    )\n",
        "\n",
        "# -----------------------------------------------------------------------------\n",
        "# 10. README AND SUPPORTING DOCUMENTATION\n",
        "# -----------------------------------------------------------------------------\n",
        "\n",
        "readme_candidates = list(\n",
        "    RESULTS_ROOT.rglob(\"README.md\")\n",
        ") if RESULTS_ROOT.exists() else []\n",
        "\n",
        "readme_candidates = [\n",
        "    path for path in readme_candidates\n",
        "    if path.is_file()\n",
        "]\n",
        "\n",
        "if readme_candidates:\n",
        "    readable_readmes = []\n",
        "\n",
        "    for readme in readme_candidates:\n",
        "        info = inspect_file(\n",
        "            f\"README: {readme.relative_to(RESULTS_ROOT)}\",\n",
        "            readme,\n",
        "            required=False\n",
        "        )\n",
        "\n",
        "        if info:\n",
        "            try:\n",
        "                content = readme.read_text(encoding=\"utf-8\")\n",
        "                if content.strip():\n",
        "                    readable_readmes.append(str(readme))\n",
        "            except Exception:\n",
        "                pass\n",
        "\n",
        "    if readable_readmes:\n",
        "        record(\n",
        "            \"Project README documentation\",\n",
        "            \"PASS\",\n",
        "            RESULTS_ROOT,\n",
        "            f\"Readable README files found: {len(readable_readmes)}.\"\n",
        "        )\n",
        "    else:\n",
        "        record(\n",
        "            \"Project README documentation\",\n",
        "            \"REVIEW\",\n",
        "            RESULTS_ROOT,\n",
        "            \"README files were found but none passed readability checks.\"\n",
        "        )\n",
        "\n",
        "else:\n",
        "    record(\n",
        "        \"Project README documentation\",\n",
        "        \"REVIEW\",\n",
        "        RESULTS_ROOT,\n",
        "        \"No README.md file found. Confirm whether documentation is stored \"\n",
        "        \"under another filename.\"\n",
        "    )\n",
        "\n",
        "# -----------------------------------------------------------------------------\n",
        "# 11. PHASE 5.2 AUDIT REPORTS\n",
        "# -----------------------------------------------------------------------------\n",
        "\n",
        "if PHASE52_DIR.is_dir():\n",
        "    phase52_json = sorted(PHASE52_DIR.glob(\"*.json\"))\n",
        "    phase52_markdown = sorted(PHASE52_DIR.glob(\"*.md\"))\n",
        "\n",
        "    if phase52_json and phase52_markdown:\n",
        "        valid_json_count = 0\n",
        "        valid_markdown_count = 0\n",
        "\n",
        "        for path in phase52_json:\n",
        "            info = inspect_file(\n",
        "                f\"Phase 5.2 JSON audit: {path.name}\",\n",
        "                path,\n",
        "                required=True\n",
        "            )\n",
        "\n",
        "            if info:\n",
        "                try:\n",
        "                    with open(path, \"r\", encoding=\"utf-8\") as file:\n",
        "                        json.load(file)\n",
        "                    valid_json_count += 1\n",
        "                except Exception as exc:\n",
        "                    record(\n",
        "                        f\"Phase 5.2 JSON validity: {path.name}\",\n",
        "                        \"FAIL\",\n",
        "                        path,\n",
        "                        repr(exc)\n",
        "                    )\n",
        "\n",
        "        for path in phase52_markdown:\n",
        "            info = inspect_file(\n",
        "                f\"Phase 5.2 Markdown audit: {path.name}\",\n",
        "                path,\n",
        "                required=True\n",
        "            )\n",
        "\n",
        "            if info:\n",
        "                try:\n",
        "                    if path.read_text(encoding=\"utf-8\").strip():\n",
        "                        valid_markdown_count += 1\n",
        "                except Exception as exc:\n",
        "                    record(\n",
        "                        f\"Phase 5.2 Markdown readability: {path.name}\",\n",
        "                        \"FAIL\",\n",
        "                        path,\n",
        "                        repr(exc)\n",
        "                    )\n",
        "\n",
        "        if valid_json_count > 0 and valid_markdown_count > 0:\n",
        "            record(\n",
        "                \"Phase 5.2 audit report availability\",\n",
        "                \"PASS\",\n",
        "                PHASE52_DIR,\n",
        "                f\"Valid JSON reports={valid_json_count}; \"\n",
        "                f\"readable Markdown reports={valid_markdown_count}.\"\n",
        "            )\n",
        "        else:\n",
        "            record(\n",
        "                \"Phase 5.2 audit report availability\",\n",
        "                \"FAIL\",\n",
        "                PHASE52_DIR,\n",
        "                \"No valid JSON and Markdown report pair was verified.\"\n",
        "            )\n",
        "\n",
        "    else:\n",
        "        record(\n",
        "            \"Phase 5.2 audit report availability\",\n",
        "            \"FAIL\",\n",
        "            PHASE52_DIR,\n",
        "            \"Expected both JSON and Markdown audit reports.\"\n",
        "        )\n",
        "\n",
        "else:\n",
        "    record(\n",
        "        \"Phase 5.2 audit report availability\",\n",
        "        \"FAIL\",\n",
        "        PHASE52_DIR,\n",
        "        \"Phase 5.2 audit directory is missing.\"\n",
        "    )\n",
        "\n",
        "# -----------------------------------------------------------------------------\n",
        "# 12. FINAL STATUS\n",
        "# -----------------------------------------------------------------------------\n",
        "\n",
        "status_counts = {\n",
        "    status: sum(\n",
        "        1 for item in results\n",
        "        if item[\"status\"] == status\n",
        "    )\n",
        "    for status in [\"PASS\", \"FAIL\", \"REVIEW\"]\n",
        "}\n",
        "\n",
        "if status_counts[\"FAIL\"] > 0:\n",
        "    overall_status = \"FAIL\"\n",
        "elif status_counts[\"REVIEW\"] > 0:\n",
        "    overall_status = \"REVIEW\"\n",
        "else:\n",
        "    overall_status = \"PASS\"\n",
        "\n",
        "final_report = {\n",
        "    \"experiment\": \"Experiment 20\",\n",
        "    \"phase\": \"5.3\",\n",
        "    \"title\": \"Final Artifact Verification\",\n",
        "    \"timestamp_utc\": TIMESTAMP_ISO,\n",
        "    \"overall_status\": overall_status,\n",
        "    \"environment\": {\n",
        "        \"python_version\": sys.version,\n",
        "        \"platform\": platform.platform(),\n",
        "        \"results_root\": str(RESULTS_ROOT),\n",
        "        \"notebook_path\": str(NOTEBOOK_PATH)\n",
        "    },\n",
        "    \"status_counts\": status_counts,\n",
        "    \"verification_results\": results,\n",
        "    \"verified_artifact_inventory\": artifact_records,\n",
        "    \"limitations\": (\n",
        "        \"This phase verifies deliverable availability, readability, and \"\n",
        "        \"technical integrity. It does not independently validate scientific \"\n",
        "        \"claims or reproduce experimental findings.\"\n",
        "    )\n",
        "}\n",
        "\n",
        "json_report_path = (\n",
        "    PHASE53_DIR\n",
        "    / f\"experiment20_phase53_final_artifact_verification_{TIMESTAMP}.json\"\n",
        ")\n",
        "\n",
        "markdown_report_path = (\n",
        "    PHASE53_DIR\n",
        "    / f\"experiment20_phase53_final_artifact_verification_{TIMESTAMP}.md\"\n",
        ")\n",
        "\n",
        "with open(json_report_path, \"x\", encoding=\"utf-8\") as file:\n",
        "    json.dump(final_report, file, indent=2, ensure_ascii=False)\n",
        "\n",
        "markdown_lines = [\n",
        "    \"# Experiment 20 — Phase 5.3 Final Artifact Verification\",\n",
        "    \"\",\n",
        "    f\"- Timestamp UTC: {TIMESTAMP_ISO}\",\n",
        "    f\"- Overall status: **{overall_status}**\",\n",
        "    f\"- PASS: {status_counts['PASS']}\",\n",
        "    f\"- FAIL: {status_counts['FAIL']}\",\n",
        "    f\"- REVIEW: {status_counts['REVIEW']}\",\n",
        "    \"\",\n",
        "    \"## Verification results\",\n",
        "    \"\",\n",
        "    \"| Artifact | Status | Path | Details |\",\n",
        "    \"|---|---|---|---|\"\n",
        "]\n",
        "\n",
        "for item in results:\n",
        "    artifact = item[\"artifact\"].replace(\"|\", \"\\\\|\")\n",
        "    path = (item[\"path\"] or \"—\").replace(\"|\", \"\\\\|\")\n",
        "    details = item[\"details\"].replace(\"|\", \"\\\\|\").replace(\"\\n\", \" \")\n",
        "\n",
        "    markdown_lines.append(\n",
        "        f\"| {artifact} | {item['status']} | {path} | {details} |\"\n",
        "    )\n",
        "\n",
        "markdown_lines.extend([\n",
        "    \"\",\n",
        "    \"## Verified artifact inventory\",\n",
        "    \"\",\n",
        "    f\"Total inventoried artifacts: {len(artifact_records)}\",\n",
        "    \"\",\n",
        "    \"Complete file sizes and SHA-256 hashes are available in the JSON report.\",\n",
        "    \"\",\n",
        "    \"## Limitations\",\n",
        "    \"\",\n",
        "    final_report[\"limitations\"],\n",
        "    \"\"\n",
        "])\n",
        "\n",
        "with open(markdown_report_path, \"x\", encoding=\"utf-8\") as file:\n",
        "    file.write(\"\\n\".join(markdown_lines))\n",
        "\n",
        "# -----------------------------------------------------------------------------\n",
        "# 13. PRINT FINAL RESULTS\n",
        "# -----------------------------------------------------------------------------\n",
        "\n",
        "print()\n",
        "print(\"=\" * 85)\n",
        "print(\"PHASE 5.3 FINAL SUMMARY\")\n",
        "print(\"=\" * 85)\n",
        "print(\"OVERALL STATUS:\", overall_status)\n",
        "print(\"PASS:\", status_counts[\"PASS\"])\n",
        "print(\"FAIL:\", status_counts[\"FAIL\"])\n",
        "print(\"REVIEW:\", status_counts[\"REVIEW\"])\n",
        "print(\"Verified artifact records:\", len(artifact_records))\n",
        "print()\n",
        "print(\"DETAILED VERIFICATION RESULTS\")\n",
        "print(\"-\" * 85)\n",
        "\n",
        "for item in results:\n",
        "    print(f\"[{item['status']}] {item['artifact']}\")\n",
        "    print(\"   Path:\", item[\"path\"])\n",
        "    print(\"   Details:\", item[\"details\"])\n",
        "\n",
        "print()\n",
        "print(\"JSON REPORT:\", json_report_path)\n",
        "print(\"MARKDOWN REPORT:\", markdown_report_path)\n",
        "print()\n",
        "print(\"No existing research artifact was intentionally modified.\")\n",
        "print(\"=\" * 85)\n"
      ],
