      "cell_type": "code",
      "source": [
        "\n",
        "from pathlib import Path\n",
        "import hashlib\n",
        "import json\n",
        "import re\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "# ============================================================\n",
        "# EXPERIMENT 20 — PHASE 4.6 MANUSCRIPT CORRECTION\n",
        "# Creates a new manuscript copy. Preserves all existing versions.\n",
        "# ============================================================\n",
        "\n",
        "ROOT = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "\n",
        "SOURCE = (\n",
        "    ROOT / \"step_4_5_statistical_methodology_audit\"\n",
        "    / \"experiment20_integrated_manuscript_v2_phase45_final.md\"\n",
        ")\n",
        "\n",
        "OUTPUT_DIR = ROOT / \"step_4_6_manuscript_reporting_audit\"\n",
        "\n",
        "FIGURE_DIR = ROOT / \"step_3_3\" / \"step_3330\" / \"figures\"\n",
        "\n",
        "OUTPUT = (\n",
        "    OUTPUT_DIR / \"experiment20_integrated_manuscript_v2_phase46_final.md\"\n",
        ")\n",
        "\n",
        "REPORT_PATH = (\n",
        "    OUTPUT_DIR / \"experiment20_phase46_manuscript_correction_verification.json\"\n",
        ")\n",
        "\n",
        "EXPECTED_SOURCE_SHA = (\n",
        "    \"eb175d98a9018797a712e90614ace8972d2589bc1ecfd54fb59b76bdebf203e3\"\n",
        ")\n",
        "\n",
        "INDEPENDENCE_PARAGRAPH = (\n",
        "    \"**Independence between identities.** Identity served as the unit of \"\n",
        "    \"inference for the repeated-measures analyses. However, the available \"\n",
        "    \"dataset and acquisition records do not independently establish \"\n",
        "    \"statistical independence between identities. The inferential results \"\n",
        "    \"should therefore be interpreted with this limitation in mind.\"\n",
        ")\n",
        "\n",
        "def sha256(path):\n",
        "    return hashlib.sha256(path.read_bytes()).hexdigest()\n",
        "\n",
        "def extract_table(markdown, number):\n",
        "    lines = markdown.splitlines()\n",
        "    pattern = re.compile(\n",
        "        rf\"^\\s{{0,3}}#{{1,6}}\\s+Table\\s+{number}\\.\",\n",
        "        re.IGNORECASE\n",
        "    )\n",
        "\n",
        "    start = None\n",
        "    for i, line in enumerate(lines):\n",
        "        if pattern.match(line):\n",
        "            start = i\n",
        "            break\n",
        "\n",
        "    if start is None:\n",
        "        return None\n",
        "\n",
        "    table_lines = []\n",
        "    for line in lines[start + 1:]:\n",
        "        if line.strip().startswith(\"|\"):\n",
        "            table_lines.append(line.strip())\n",
        "        elif table_lines:\n",
        "            break\n",
        "\n",
        "    return table_lines or None\n",
        "\n",
        "def find_section_bounds(markdown, section_number):\n",
        "    lines = markdown.splitlines()\n",
        "\n",
        "    pattern = re.compile(\n",
        "        rf\"^\\s{{0,3}}(#+)\\s+{re.escape(section_number)}(?:\\s|[.:—-])\",\n",
        "        re.IGNORECASE\n",
        "    )\n",
        "\n",
        "    start = None\n",
        "    level = None\n",
        "\n",
        "    for i, line in enumerate(lines):\n",
        "        match = pattern.match(line)\n",
        "        if match:\n",
        "            start = i\n",
        "            level = len(match.group(1))\n",
        "            break\n",
        "\n",
        "    if start is None:\n",
        "        raise RuntimeError(\n",
        "            f\"Section {section_number} heading not found.\"\n",
        "        )\n",
        "\n",
        "    end = len(lines)\n",
        "\n",
        "    for i in range(start + 1, len(lines)):\n",
        "        match = re.match(r\"^\\s{0,3}(#+)\\s+\", lines[i])\n",
        "        if match and len(match.group(1)) <= level:\n",
        "            end = i\n",
        "            break\n",
        "\n",
        "    return lines, start, end\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. Preflight checks\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"=\" * 75)\n",
        "print(\"EXPERIMENT 20 — PHASE 4.6 MANUSCRIPT CORRECTION\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "if not SOURCE.is_file():\n",
        "    raise FileNotFoundError(f\"Source manuscript missing: {SOURCE}\")\n",
        "\n",
        "if not FIGURE_DIR.is_dir():\n",
        "    raise FileNotFoundError(f\"Figure directory missing: {FIGURE_DIR}\")\n",
        "\n",
        "if OUTPUT.exists():\n",
        "    raise FileExistsError(\n",
        "        f\"Output already exists. No file overwritten: {OUTPUT}\"\n",
        "    )\n",
        "\n",
        "if REPORT_PATH.exists():\n",
        "    raise FileExistsError(\n",
        "        f\"Report already exists. No file overwritten: {REPORT_PATH}\"\n",
        "    )\n",
        "\n",
        "source_hash_before = sha256(SOURCE)\n",
        "\n",
        "print(\"Source SHA256:\", source_hash_before)\n",
        "\n",
        "if source_hash_before != EXPECTED_SOURCE_SHA:\n",
        "    raise RuntimeError(\n",
        "        \"STOP: Source manuscript hash does not match the verified copy.\"\n",
        "    )\n",
        "\n",
        "original_text = SOURCE.read_text(encoding=\"utf-8\")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. Preserve original tables\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "table1_before = extract_table(original_text, 1)\n",
        "table2_before = extract_table(original_text, 2)\n",
        "\n",
        "if table1_before is None or table2_before is None:\n",
        "    raise RuntimeError(\"Table 1 or Table 2 could not be extracted.\")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. Correct exactly four figure paths\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "figure_pattern = re.compile(\n",
        "    r\"(?<=\\]\\()(?P<path>(?:\\./)?figures/[^)\\s]+)(?=\\))\"\n",
        ")\n",
        "\n",
        "figure_matches = list(figure_pattern.finditer(original_text))\n",
        "\n",
        "if len(figure_matches) != 4:\n",
        "    raise RuntimeError(\n",
        "        f\"Expected exactly four figure references; found {len(figure_matches)}.\"\n",
        "    )\n",
        "\n",
        "corrected_text = figure_pattern.sub(\n",
        "    lambda m: \"../step_3_3/step_3330/figures/\"\n",
        "    + m.group(\"path\").removeprefix(\"./\").removeprefix(\"figures/\"),\n",
        "    original_text\n",
        ")\n",
        "\n",
        "corrected_figure_refs = re.findall(\n",
        "    r\"(?<=\\]\\()(../step_3_3/step_3330/figures/[^)\\s]+)(?=\\))\",\n",
        "    corrected_text\n",
        ")\n",
        "\n",
        "if len(corrected_figure_refs) != 4:\n",
        "    raise RuntimeError(\"Figure reference correction count is not four.\")\n",
        "\n",
        "resolved_figures = []\n",
        "\n",
        "for relative_path in corrected_figure_refs:\n",
        "    figure_path = FIGURE_DIR / Path(relative_path).name\n",
        "\n",
        "    if not figure_path.is_file():\n",
        "        raise FileNotFoundError(\n",
        "            f\"Referenced figure does not exist: {figure_path}\"\n",
        "        )\n",
        "\n",
        "    resolved_figures.append(str(figure_path))\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. Add independence limitation at end of Section 4.6\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "if INDEPENDENCE_PARAGRAPH in corrected_text:\n",
        "    raise RuntimeError(\"Independence paragraph already exists.\")\n",
        "\n",
        "lines, section_start, section_end = find_section_bounds(\n",
        "    corrected_text, \"4.6\"\n",
        ")\n",
        "\n",
        "heading = lines[section_start]\n",
        "\n",
        "if \"limitation\" not in heading.lower():\n",
        "    raise RuntimeError(\n",
        "        f\"Section 4.6 is not identified as Limitations: {heading}\"\n",
        "    )\n",
        "\n",
        "lines[section_end:section_end] = [\n",
        "    \"\",\n",
        "    INDEPENDENCE_PARAGRAPH,\n",
        "    \"\"\n",
        "]\n",
        "\n",
        "corrected_text = \"\\n\".join(lines)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. Verify tables remain unchanged\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "if extract_table(corrected_text, 1) != table1_before:\n",
        "    raise RuntimeError(\"Table 1 changed unexpectedly.\")\n",
        "\n",
        "if extract_table(corrected_text, 2) != table2_before:\n",
        "    raise RuntimeError(\"Table 2 changed unexpectedly.\")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. Verify Section 4.6 and figure paths\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "final_lines, final_start, final_end = find_section_bounds(\n",
        "    corrected_text, \"4.6\"\n",
        ")\n",
        "\n",
        "section_46 = \"\\n\".join(final_lines[final_start:final_end])\n",
        "\n",
        "if INDEPENDENCE_PARAGRAPH not in section_46:\n",
        "    raise RuntimeError(\n",
        "        \"Independence limitation was not inserted inside Section 4.6.\"\n",
        "    )\n",
        "\n",
        "if corrected_text.count(INDEPENDENCE_PARAGRAPH) != 1:\n",
        "    raise RuntimeError(\n",
        "        \"Independence limitation is duplicated or missing.\"\n",
        "    )\n",
        "\n",
        "if figure_pattern.search(corrected_text):\n",
        "    raise RuntimeError(\"Old figure references remain.\")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. Save new manuscript copy\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "OUTPUT.write_text(corrected_text, encoding=\"utf-8\")\n",
        "\n",
        "saved_text = OUTPUT.read_text(encoding=\"utf-8\")\n",
        "output_hash = sha256(OUTPUT)\n",
        "\n",
        "if saved_text != corrected_text:\n",
        "    raise RuntimeError(\"Saved manuscript does not match corrected content.\")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 8. Confirm source remains unchanged\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "source_hash_after = sha256(SOURCE)\n",
        "\n",
        "if source_hash_after != source_hash_before:\n",
        "    raise RuntimeError(\"Original Phase 4.5 manuscript was modified.\")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 9. Verification record\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "checks = {\n",
        "    \"source_hash_matches_verified_phase45_copy\":\n",
        "        source_hash_before == EXPECTED_SOURCE_SHA,\n",
        "\n",
        "    \"original_phase45_manuscript_unchanged\":\n",
        "        source_hash_after == source_hash_before,\n",
        "\n",
        "    \"new_phase46_manuscript_created\":\n",
        "        OUTPUT.is_file(),\n",
        "\n",
        "    \"exactly_four_figure_references_corrected\":\n",
        "        len(corrected_figure_refs) == 4,\n",
        "\n",
        "    \"all_four_figure_files_exist\":\n",
        "        len(resolved_figures) == 4,\n",
        "\n",
        "    \"independence_limitation_inserted_once\":\n",
        "        corrected_text.count(INDEPENDENCE_PARAGRAPH) == 1,\n",
        "\n",
        "    \"independence_limitation_inside_section_46\":\n",
        "        INDEPENDENCE_PARAGRAPH in section_46,\n",
        "\n",
        "    \"table1_unchanged\":\n",
        "        extract_table(saved_text, 1) == table1_before,\n",
        "\n",
        "    \"table2_unchanged\":\n",
        "        extract_table(saved_text, 2) == table2_before,\n",
        "\n",
        "    \"saved_manuscript_matches_corrected_content\":\n",
        "        saved_text == corrected_text\n",
        "}\n",
        "\n",
        "failed_checks = [\n",
        "    key for key, value in checks.items() if not value\n",
        "]\n",
        "\n",
        "record = {\n",
        "    \"experiment\": \"Experiment 20\",\n",
        "    \"phase\": \"4.6\",\n",
        "    \"status\": (\n",
        "        \"PHASE_4_6_CORRECTIONS_VERIFIED\"\n",
        "        if not failed_checks\n",
        "        else \"PHASE_4_6_REVIEW_REQUIRED\"\n",
        "    ),\n",
        "    \"timestamp_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "    \"source_manuscript\": str(SOURCE),\n",
        "    \"source_sha256_before\": source_hash_before,\n",
        "    \"source_sha256_after\": source_hash_after,\n",
        "    \"new_manuscript\": str(OUTPUT),\n",
        "    \"new_manuscript_sha256\": output_hash,\n",
        "    \"corrected_figure_references\": corrected_figure_refs,\n",
        "    \"resolved_figure_files\": resolved_figures,\n",
        "    \"independence_limitation\": INDEPENDENCE_PARAGRAPH,\n",
        "    \"checks\": checks,\n",
        "    \"failed_checks\": failed_checks,\n",
        "    \"scope_note\": (\n",
        "        \"This verifies manuscript corrections and preservation. \"\n",
        "        \"It does not independently establish statistical independence \"\n",
        "        \"between identities or rerun statistical analyses.\"\n",
        "    )\n",
        "}\n",
        "\n",
        "REPORT_PATH.write_text(\n",
        "    json.dumps(record, indent=2, ensure_ascii=False),\n",
        "    encoding=\"utf-8\"\n",
        ")\n",
        "\n",
        "report_hash = sha256(REPORT_PATH)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 10. Final report\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 75)\n",
        "print(\"VERIFICATION RESULTS\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "for name, passed in checks.items():\n",
        "    print((\"PASS\" if passed else \"FAIL\"), name)\n",
        "\n",
        "print(\"\\nFailed checks:\", failed_checks)\n",
        "\n",
        "print(\"\\nNew manuscript:\")\n",
        "print(OUTPUT)\n",
        "\n",
        "print(\"\\nNew manuscript SHA256:\")\n",
        "print(output_hash)\n",
        "\n",
        "print(\"\\nCorrection record:\")\n",
        "print(REPORT_PATH)\n",
        "\n",
        "print(\"\\nCorrection record SHA256:\")\n",
        "print(report_hash)\n",
        "\n",
        "print(\"\\nOriginal manuscript unchanged:\",\n",
        "      source_hash_after == source_hash_before)\n",
        "\n",
        "print(\n",
        "    \"\\nFINAL STATUS:\",\n",
        "    \"PHASE_4_6_CORRECTIONS_VERIFIED\"\n",
        "    if not failed_checks\n",
        "    else \"PHASE_4_6_REVIEW_REQUIRED\"\n",
        ")\n"
      ],
