        "# ============================================================\n",
        "# EXPERIMENT 20 — SECTION 3.3 FINAL VERIFICATION AND CLOSURE\n",
        "# SINGLE FINAL CELL — READ-ONLY FOR ALL EXISTING EVIDENCE\n",
        "# ============================================================\n",
        "\n",
        "import os\n",
        "import re\n",
        "import json\n",
        "import hashlib\n",
        "import pandas as pd\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "BASE = \"/content/drive/MyDrive/Experiment_20_Results\"\n",
        "\n",
        "MANUSCRIPT = os.path.join(\n",
        "    BASE, \"step_3_3\", \"step_3330\",\n",
        "    \"experiment20_integrated_manuscript_v2.md\"\n",
        ")\n",
        "\n",
        "FREEZE = os.path.join(BASE, \"step_2_7\", \"final_freeze\")\n",
        "\n",
        "OUTPUT_DIR = os.path.join(\n",
        "    BASE, \"step_3_3\", \"step_3_3_final_closure\"\n",
        ")\n",
        "os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
        "\n",
        "REPORT_PATH = os.path.join(\n",
        "    OUTPUT_DIR,\n",
        "    \"experiment20_section_3_3_final_closure_record.json\"\n",
        ")\n",
        "\n",
        "EXPECTED_MANUSCRIPT_HASH = (\n",
        "    \"2cc4156af63987fae717c37e997e6478e4253d81f584854fb5fab9f18da5e752\"\n",
        ")\n",
        "\n",
        "EXPECTED_HOLM = 4.366e-11\n",
        "EXPECTED_RAW = 7.276e-12\n",
        "\n",
        "\n",
        "def sha256_file(path):\n",
        "    h = hashlib.sha256()\n",
        "    with open(path, \"rb\") as f:\n",
        "        for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n",
        "            h.update(chunk)\n",
        "    return h.hexdigest()\n",
        "\n",
        "\n",
        "def split_row(line):\n",
        "    return [\n",
        "        x.strip()\n",
        "        for x in line.strip().strip(\"|\").split(\"|\")\n",
        "    ]\n",
        "\n",
        "\n",
        "def numeric_value(value):\n",
        "    match = re.search(\n",
        "        r\"(?<![A-Za-z0-9])\"\n",
        "        r\"([+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)\"\n",
        "        r\"(?:[eE][+-]?\\d+)?)\",\n",
        "        value.replace(\"`\", \"\").strip()\n",
        "    )\n",
        "    return float(match.group(1)) if match else None\n",
        "\n",
        "\n",
        "checks = {}\n",
        "details = {}\n",
        "\n",
        "print(\"=\" * 90)\n",
        "print(\"EXPERIMENT 20 — SECTION 3.3 FINAL CLOSURE\")\n",
        "print(\"=\" * 90)\n",
        "\n",
        "\n",
        "# 1. MANUSCRIPT HASH\n",
        "\n",
        "assert os.path.isfile(MANUSCRIPT), \"Manuscript missing.\"\n",
        "\n",
        "with open(MANUSCRIPT, \"r\", encoding=\"utf-8\") as f:\n",
        "    manuscript = f.read()\n",
        "\n",
        "manuscript_hash = sha256_file(MANUSCRIPT)\n",
        "\n",
        "checks[\"manuscript_unchanged\"] = (\n",
        "    manuscript_hash == EXPECTED_MANUSCRIPT_HASH\n",
        ")\n",
        "\n",
        "details[\"manuscript\"] = {\n",
        "    \"path\": MANUSCRIPT,\n",
        "    \"sha256\": manuscript_hash,\n",
        "    \"word_count\": len(manuscript.split())\n",
        "}\n",
        "\n",
        "\n",
        "# 2. TABLE 1 — FROZEN DESCRIPTIVE STATISTICS\n",
        "\n",
        "stats_path = os.path.join(\n",
        "    FREEZE,\n",
        "    \"experiment20_illumination_group_descriptive_statistics.csv\"\n",
        ")\n",
        "\n",
        "stats = pd.read_csv(stats_path)\n",
        "\n",
        "expected_table1 = {\n",
        "    \"near_frontal\": {\n",
        "        \"observations\": 646, \"identities\": 38, \"conditions\": 17,\n",
        "        \"euclidean_mean\": 0.4019, \"euclidean_sd\": 0.1107,\n",
        "        \"cosine_mean\": 0.0869, \"cosine_sd\": 0.0479\n",
        "    },\n",
        "    \"oblique\": {\n",
        "        \"observations\": 418, \"identities\": 38, \"conditions\": 11,\n",
        "        \"euclidean_mean\": 0.7090, \"euclidean_sd\": 0.1482,\n",
        "        \"cosine_mean\": 0.2623, \"cosine_sd\": 0.1062\n",
        "    },\n",
        "    \"large_angular_deviation\": {\n",
        "        \"observations\": 1064, \"identities\": 38, \"conditions\": 28,\n",
        "        \"euclidean_mean\": 1.1185, \"euclidean_sd\": 0.2175,\n",
        "        \"cosine_mean\": 0.6491, \"cosine_sd\": 0.2388\n",
        "    }\n",
        "}\n",
        "\n",
        "table1_results = {}\n",
        "\n",
        "for group, expected in expected_table1.items():\n",
        "\n",
        "    rows = stats[stats[\"illumination_group\"] == group]\n",
        "    e = rows[rows[\"metric\"] == \"euclidean_displacement\"]\n",
        "    c = rows[rows[\"metric\"] == \"cosine_distance\"]\n",
        "\n",
        "    passed = False\n",
        "\n",
        "    if len(e) == 1 and len(c) == 1:\n",
        "        e, c = e.iloc[0], c.iloc[0]\n",
        "\n",
        "        passed = all([\n",
        "            int(e[\"observations\"]) == expected[\"observations\"],\n",
        "            int(c[\"observations\"]) == expected[\"observations\"],\n",
        "            int(e[\"identities\"]) == expected[\"identities\"],\n",
        "            int(c[\"identities\"]) == expected[\"identities\"],\n",
        "            int(e[\"conditions\"]) == expected[\"conditions\"],\n",
        "            int(c[\"conditions\"]) == expected[\"conditions\"],\n",
        "            round(float(e[\"mean\"]), 4) == expected[\"euclidean_mean\"],\n",
        "            round(float(e[\"standard_deviation\"]), 4) == expected[\"euclidean_sd\"],\n",
        "            round(float(c[\"mean\"]), 4) == expected[\"cosine_mean\"],\n",
        "            round(float(c[\"standard_deviation\"]), 4) == expected[\"cosine_sd\"]\n",
        "        ])\n",
        "\n",
        "    table1_results[group] = passed\n",
        "\n",
        "checks[\"table1_all_values_verified\"] = (\n",
        "    len(stats) == 6 and all(table1_results.values())\n",
        ")\n",
        "\n",
        "details[\"table1\"] = {\n",
        "    \"source\": stats_path,\n",
        "    \"sha256\": sha256_file(stats_path),\n",
        "    \"group_checks\": table1_results\n",
        "}\n",
        "\n",
        "\n",
        "# 3. TABLE 2 — EXTRACT THE HOLM COLUMN ONLY\n",
        "\n",
        "lines = manuscript.splitlines()\n",
        "\n",
        "caption_index = next(\n",
        "    (i for i, line in enumerate(lines) if \"Table 2.\" in line),\n",
        "    None\n",
        ")\n",
        "\n",
        "assert caption_index is not None, \"Table 2 not found.\"\n",
        "\n",
        "table_lines = []\n",
        "\n",
        "for line in lines[caption_index + 1:]:\n",
        "    if line.strip().startswith(\"|\"):\n",
        "        table_lines.append(line)\n",
        "    elif table_lines:\n",
        "        break\n",
        "\n",
        "header = split_row(table_lines[0])\n",
        "\n",
        "normalised_header = [\n",
        "    re.sub(r\"\\s+\", \" \", h.lower()).strip()\n",
        "    for h in header\n",
        "]\n",
        "\n",
        "holm_indices = [\n",
        "    i for i, h in enumerate(normalised_header)\n",
        "    if \"holm\" in h\n",
        "]\n",
        "\n",
        "raw_indices = [\n",
        "    i for i, h in enumerate(normalised_header)\n",
        "    if (\"raw\" in h or \"unadjusted\" in h) and \"p\" in h\n",
        "]\n",
        "\n",
        "assert len(holm_indices) == 1, (\n",
        "    \"Could not uniquely identify Table 2 Holm column. \"\n",
        "    f\"Header: {header}\"\n",
        ")\n",
        "\n",
        "assert len(raw_indices) == 1, (\n",
        "    \"Could not uniquely identify Table 2 raw p-value column. \"\n",
        "    f\"Header: {header}\"\n",
        ")\n",
        "\n",
        "body = []\n",
        "\n",
        "for line in table_lines[1:]:\n",
        "    cells = split_row(line)\n",
        "\n",
        "    if all(re.fullmatch(r\":?-{3,}:?\", x.replace(\" \", \"\")) for x in cells):\n",
        "        continue\n",
        "\n",
        "    if len(cells) == len(header):\n",
        "        body.append(cells)\n",
        "\n",
        "raw_values = [\n",
        "    numeric_value(row[raw_indices[0]])\n",
        "    for row in body\n",
        "]\n",
        "\n",
        "holm_values = [\n",
        "    numeric_value(row[holm_indices[0]])\n",
        "    for row in body\n",
        "]\n",
        "\n",
        "checks[\"table2_six_rows_found\"] = len(body) == 6\n",
        "\n",
        "checks[\"table2_raw_p_values_verified\"] = (\n",
        "    len(raw_values) == 6\n",
        "    and all(\n",
        "        x is not None and round(x, 3) == round(EXPECTED_RAW, 3)\n",
        "        for x in raw_values\n",
        "    )\n",
        ")\n",
        "\n",
        "checks[\"table2_combined_holm_values_verified\"] = (\n",
        "    len(holm_values) == 6\n",
        "    and all(\n",
        "        x is not None and round(x, 3) == round(EXPECTED_HOLM, 3)\n",
        "        for x in holm_values\n",
        "    )\n",
        ")\n",
        "\n",
        "details[\"table2\"] = {\n",
        "    \"header\": header,\n",
        "    \"raw_p_values\": raw_values,\n",
        "    \"holm_adjusted_values\": holm_values,\n",
        "    \"expected_raw_p\": EXPECTED_RAW,\n",
        "    \"expected_combined_six_test_holm\": EXPECTED_HOLM\n",
        "}\n",
        "\n",
        "\n",
        "# 4. HEMISPHERE RESULTS\n",
        "\n",
        "hemisphere_path = os.path.join(\n",
        "    FREEZE,\n",
        "    \"experiment20_hemisphere_comparison_results.csv\"\n",
        ")\n",
        "\n",
        "hemisphere = pd.read_csv(hemisphere_path)\n",
        "\n",
        "expected_hemi = {\n",
        "    \"euclidean_displacement\": (0.706220, 1.287990, 0.581770, 1.455192e-11),\n",
        "    \"cosine_distance\": (0.295816, 0.838624, 0.542807, 1.455192e-11)\n",
        "}\n",
        "\n",
        "hemi_results = {}\n",
        "\n",
        "for metric, expected in expected_hemi.items():\n",
        "\n",
        "    rows = hemisphere[hemisphere[\"metric\"] == metric]\n",
        "\n",
        "    if len(rows) != 1:\n",
        "        hemi_results[metric] = False\n",
        "        continue\n",
        "\n",
        "    row = rows.iloc[0]\n",
        "\n",
        "    actual = [\n",
        "        round(float(row[\"mean_frontal\"]), 6),\n",
        "        round(float(row[\"mean_beyond_frontal\"]), 6),\n",
        "        round(float(row[\"mean_paired_difference_beyond_minus_frontal\"]), 6)\n",
        "    ]\n",
        "\n",
        "    values_match = actual == list(expected[:3])\n",
        "\n",
        "    holm_match = abs(\n",
        "        float(row[\"holm_adjusted_p_value\"]) - expected[3]\n",
        "    ) < 1e-15\n",
        "\n",
        "    hemi_results[metric] = values_match and holm_match\n",
        "\n",
        "checks[\"hemisphere_results_verified\"] = all(hemi_results.values())\n",
        "details[\"hemisphere\"] = hemi_results\n",
        "\n",
        "\n",
        "# 5. FIGURES\n",
        "\n",
        "figure_hashes = {\n",
        "    \"experiment20_figure1_euclidean_illumination_groups.png\":\n",
        "        \"71623f613dc8202cf5cf6ff7bea005b315e4a31de73841d064c896b24e565b16\",\n",
        "\n",
        "    \"experiment20_figure2_cosine_illumination_groups.png\":\n",
        "        \"de22ee98a909ef099199f5b49911633497c2c890d9d903224131f95db54c917c\",\n",
        "\n",
        "    \"experiment20_figure3_euclidean_hemisphere_comparison.png\":\n",
        "        \"5a55b8947698a35dd20a258a4d185b927a64ccdac4a4b18d8aad4bd6d35fc0c6\",\n",
        "\n",
        "    \"experiment20_figure4_cosine_hemisphere_comparison.png\":\n",
        "        \"0a06e0a5458ec2779aee94778f59fd576e585f8fc85fdd3e82afb6c91211851c\"\n",
        "}\n",
        "\n",
        "figure_dir = os.path.join(\n",
        "    os.path.dirname(MANUSCRIPT), \"figures\"\n",
        ")\n",
        "\n",
        "figure_results = {}\n",
        "\n",
        "for filename, expected_hash in figure_hashes.items():\n",
        "\n",
        "    path = os.path.join(figure_dir, filename)\n",
        "\n",
        "    valid = (\n",
        "        os.path.isfile(path)\n",
        "        and sha256_file(path) == expected_hash\n",
        "        and filename in manuscript\n",
        "    )\n",
        "\n",
        "    figure_results[filename] = valid\n",
        "\n",
        "checks[\"all_four_figures_verified\"] = all(figure_results.values())\n",
        "details[\"figures\"] = figure_results\n",
        "\n",
        "\n",
        "# 6. PRIOR AUDIT REPORTS\n",
        "\n",
        "required_reports = [\n",
        "    os.path.join(BASE, \"step_3_3\", \"step_3327\",\n",
        "                 \"experiment20_step3327_holm_audit_closure.json\"),\n",
        "\n",
        "    os.path.join(BASE, \"step_3_3\", \"step_3333\",\n",
        "                 \"experiment20_step3333_corrected_hemisphere_placement_verification.json\"),\n",
        "\n",
        "    os.path.join(BASE, \"step_3_3\", \"step_3334\",\n",
        "                 \"experiment20_step3334_scientific_consistency_review.json\"),\n",
        "\n",
        "    os.path.join(BASE, \"step_3_3\", \"step_3335\",\n",
        "                 \"experiment20_step3335_table1_source_recovery.json\"),\n",
        "\n",
        "    os.path.join(BASE, \"step_3_3\", \"step_3336\",\n",
        "                 \"experiment20_step3336_final_integrity_and_closure_report.json\")\n",
        "]\n",
        "\n",
        "checks[\"prior_audit_reports_present\"] = all(\n",
        "    os.path.isfile(path) for path in required_reports\n",
        ")\n",
        "\n",
        "details[\"prior_audit_reports\"] = {\n",
        "    path: os.path.isfile(path) for path in required_reports\n",
        "}\n",
        "\n",
        "\n",
        "# 7. SCIENTIFIC LIMITATIONS\n",
        "\n",
        "required_limitations = [\n",
        "    \"do not establish recognition accuracy\",\n",
        "    \"This comparison is exploratory\",\n",
        "    \"should not be interpreted as an isolated causal effect\",\n",
        "    \"mathematically\"\n",
        "]\n",
        "\n",
        "limitation_results = {\n",
        "    phrase: phrase.lower() in manuscript.lower()\n",
        "    for phrase in required_limitations\n",
        "}\n",
        "\n",
        "checks[\"scientific_limitations_retained\"] = all(\n",
        "    limitation_results.values()\n",
        ")\n",
        "\n",
        "details[\"scientific_limitations\"] = limitation_results\n",
        "\n",
        "\n",
        "# 8. FINAL CLOSURE DECISION\n",
        "\n",
        "failed = [name for name, value in checks.items() if not value]\n",
        "\n",
        "complete = len(failed) == 0\n",
        "\n",
        "report = {\n",
        "    \"project\": \"Experiment 20\",\n",
        "    \"section\": \"3.3\",\n",
        "    \"created_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "\n",
        "    \"status\": (\n",
        "        \"SECTION_3_3_COMPLETE\"\n",
        "        if complete\n",
        "        else \"SECTION_3_3_REMAINS_OPEN\"\n",
        "    ),\n",
        "\n",
        "    \"checks\": checks,\n",
        "    \"failed_checks\": failed,\n",
        "    \"details\": details,\n",
        "\n",
        "    \"scientific_scope\": (\n",
        "        \"Reference-relative face embedding displacement across \"\n",
        "        \"illumination geometry conditions in the evaluated \"\n",
        "        \"Extended Yale B subset using the specified fixed \"\n",
        "        \"pretrained FaceNet model.\"\n",
        "    ),\n",
        "\n",
        "    \"interpretive_boundaries\": [\n",
        "        \"Euclidean and cosine distances are mathematically related for L2-normalised embeddings.\",\n",
        "        \"The two distance measures are not independent evidence.\",\n",
        "        \"The hemisphere comparison is exploratory.\",\n",
        "        \"The study does not establish recognition accuracy.\",\n",
        "        \"The study does not establish operational drift-detection capability.\",\n",
        "        \"The study does not establish causal illumination effects or cross-architecture generalisation.\"\n",
        "    ],\n",
        "\n",
        "    \"integrity\": {\n",
        "        \"manuscript_modified\": False,\n",
        "        \"frozen_evidence_modified\": False,\n",
        "        \"figures_modified\": False,\n",
        "        \"previous_audit_reports_modified\": False\n",
        "    }\n",
        "}\n",
        "\n",
        "with open(REPORT_PATH, \"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(report, f, indent=2, default=str)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 90)\n",
        "print(\"FINAL SECTION 3.3 VERIFICATION\")\n",
        "print(\"=\" * 90)\n",
        "\n",
        "for name, value in checks.items():\n",
        "    print((\"PASS\" if value else \"FAIL\"), name)\n",
        "\n",
        "print(\"\\nFailed checks:\", failed)\n",
        "print(\"FINAL STATUS:\", report[\"status\"])\n",
        "print(\"Manuscript SHA256:\", manuscript_hash)\n",
        "print(\"Closure record:\", REPORT_PATH)\n",
        "print(\"Closure record SHA256:\", sha256_file(REPORT_PATH))\n",
        "print(\"Existing manuscript and evidence were not modified.\")"
