        ")\n",
        "\n",
        "assert os.path.exists(CSV_PATH), f\"Missing frozen CSV: {CSV_PATH}\"\n",
        "assert os.path.exists(REPORT_PATH), f\"Missing Phase 4.5 report: {REPORT_PATH}\"\n",
        "assert os.path.exists(MANUSCRIPT_PATH), f\"Missing manuscript: {MANUSCRIPT_PATH}\"\n",
        "\n",
        "def sha256(path):\n",
        "    h = hashlib.sha256()\n",
        "    with open(path, \"rb\") as f:\n",
        "        for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n",
        "            h.update(chunk)\n",
        "    return h.hexdigest()\n",
        "\n",
        "csv_hash_before = sha256(CSV_PATH)\n",
        "manuscript_hash_before = sha256(MANUSCRIPT_PATH)\n",
        "report_hash_before = sha256(REPORT_PATH)\n",
        "\n",
        "df = pd.read_csv(CSV_PATH)\n",
        "report = json.load(open(REPORT_PATH, \"r\"))\n",
        "\n",
        "print(\"=\" * 76)\n",
        "print(\"EXPERIMENT 20 — SIGN TEST AND HOLM FAMILY AUDIT\")\n",
        "print(\"=\" * 76)\n",
        "\n",
        "print(\"\\n1. INPUT INTEGRITY\")\n",
        "print(\"CSV SHA256:\", csv_hash_before)\n",
        "print(\"Manuscript SHA256:\", manuscript_hash_before)\n",
        "print(\"Phase 4.5 report SHA256:\", report_hash_before)\n",
        "print(\"Rows:\", len(df))\n",
        "print(\"Columns:\", list(df.columns))\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. Reconstruct identity-level means from frozen observations\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "required = {\n",
        "    \"subject\",\n",
        "    \"illumination_group\",\n",
        "    \"hemisphere\",\n",
        "    \"euclidean_displacement\",\n",
        "    \"cosine_distance\"\n",
        "}\n",
        "\n",
        "missing = required - set(df.columns)\n",
        "assert not missing, f\"Missing required columns: {sorted(missing)}\"\n",
        "\n",
        "group_order = [\n",
        "    \"near_frontal\",\n",
        "    \"oblique\",\n",
        "    \"large_angular_deviation\"\n",
        "]\n",
        "\n",
        "metric_columns = {\n",
        "    \"euclidean\": \"euclidean_displacement\",\n",
        "    \"cosine\": \"cosine_distance\"\n",
        "}\n",
        "\n",
        "# Normalise only known frozen labels if necessary.\n",
        "df[\"illumination_group\"] = df[\"illumination_group\"].replace({\n",
        "    \"near-frontal\": \"near_frontal\",\n",
        "    \"large_angular\": \"large_angular_deviation\",\n",
        "    \"large-angular\": \"large_angular_deviation\"\n",
        "})\n",
        "\n",
        "df[\"hemisphere\"] = df[\"hemisphere\"].replace({\n",
        "    \"frontal hemisphere\": \"frontal_hemisphere\",\n",
        "    \"beyond frontal hemisphere\": \"beyond_frontal_hemisphere\",\n",
        "    \"beyond-frontal hemisphere\": \"beyond_frontal_hemisphere\"\n",
        "})\n",
        "\n",
        "assert set(df[\"illumination_group\"].unique()) == set(group_order), (\n",
        "    \"Unexpected illumination group labels: \"\n",
        "    + str(sorted(df[\"illumination_group\"].unique()))\n",
        ")\n",
        "\n",
        "identity_group = (\n",
        "    df.groupby([\"subject\", \"illumination_group\"])[\n",
        "        list(metric_columns.values())\n",
        "    ]\n",
        "    .mean()\n",
        "    .unstack(\"illumination_group\")\n",
        ")\n",
        "\n",
        "assert identity_group.shape[0] == 38\n",
        "assert identity_group.notna().all().all()\n",
        "assert set(identity_group.columns.get_level_values(1)) == set(group_order)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. Exact paired sign tests for six primary comparisons\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "comparisons = [\n",
        "    (\"near_frontal\", \"oblique\"),\n",
        "    (\"near_frontal\", \"large_angular_deviation\"),\n",
        "    (\"oblique\", \"large_angular_deviation\")\n",
        "]\n",
        "\n",
        "primary_results = []\n",
        "\n",
        "for metric, column in metric_columns.items():\n",
        "    for first, second in comparisons:\n",
        "\n",
        "        a = identity_group[(column, first)].to_numpy()\n",
        "        b = identity_group[(column, second)].to_numpy()\n",
        "\n",
        "        differences = b - a\n",
        "        positive = int(np.sum(differences > 0))\n",
        "        negative = int(np.sum(differences < 0))\n",
        "        ties = int(np.sum(differences == 0))\n",
        "        n_nonzero = positive + negative\n",
        "\n",
        "        assert n_nonzero > 0\n",
        "\n",
        "        test = binomtest(\n",
        "            positive,\n",
        "            n=n_nonzero,\n",
        "            p=0.5,\n",
        "            alternative=\"two-sided\"\n",
        "        )\n",
        "\n",
        "        primary_results.append({\n",
        "            \"metric\": metric,\n",
        "            \"comparison\": f\"{first} vs {second}\",\n",
        "            \"n_identities\": int(len(differences)),\n",
        "            \"positive_differences\": positive,\n",
        "            \"negative_differences\": negative,\n",
        "            \"ties\": ties,\n",
        "            \"sign_test_n\": n_nonzero,\n",
        "            \"sign_test_raw_p\": float(test.pvalue)\n",
        "        })\n",
        "\n",
        "primary = pd.DataFrame(primary_results)\n",
        "\n",
        "# Holm step-down correction across all six primary sign tests.\n",
        "def holm_adjust(p_values):\n",
        "    p = np.asarray(p_values, dtype=float)\n",
        "    m = len(p)\n",
        "    order = np.argsort(p)\n",
        "    adjusted_sorted = np.empty(m, dtype=float)\n",
        "\n",
        "    running_max = 0.0\n",
        "    for rank, idx in enumerate(order):\n",
        "        candidate = (m - rank) * p[idx]\n",
        "        running_max = max(running_max, candidate)\n",
        "        adjusted_sorted[rank] = min(running_max, 1.0)\n",
        "\n",
        "    adjusted = np.empty(m, dtype=float)\n",
        "    adjusted[order] = adjusted_sorted\n",
        "    return adjusted\n",
        "\n",
        "primary[\"sign_test_holm_p\"] = holm_adjust(\n",
        "    primary[\"sign_test_raw_p\"].to_numpy()\n",
        ")\n",
        "\n",
        "print(\"\\n2. PRIMARY SIX-TEST SIGN-TEST SENSITIVITY\")\n",
        "print(primary.to_string(index=False))\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. Verify hemisphere paired sign tests and separate Holm family\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "hemisphere_means = (\n",
        "    df.groupby([\"subject\", \"hemisphere\"])[\n",
        "        list(metric_columns.values())\n",
        "    ]\n",
        "    .mean()\n",
        "    .unstack(\"hemisphere\")\n",
        ")\n",
        "\n",
        "hemisphere_expected = {\n",
        "    \"frontal_hemisphere\",\n",
        "    \"beyond_frontal_hemisphere\"\n",
        "}\n",
        "\n",
        "assert set(hemisphere_means.columns.get_level_values(1)) == hemisphere_expected\n",
        "assert hemisphere_means.shape[0] == 38\n",
        "assert hemisphere_means.notna().all().all()\n",
        "\n",
        "hemisphere_results = []\n",
        "\n",
        "for metric, column in metric_columns.items():\n",
        "\n",
        "    frontal = hemisphere_means[\n",
        "        (column, \"frontal_hemisphere\")\n",
        "    ].to_numpy()\n",
        "\n",
        "    beyond = hemisphere_means[\n",
        "        (column, \"beyond_frontal_hemisphere\")\n",
        "    ].to_numpy()\n",
        "\n",
        "    differences = beyond - frontal\n",
        "\n",
        "    positive = int(np.sum(differences > 0))\n",
        "    negative = int(np.sum(differences < 0))\n",
        "    ties = int(np.sum(differences == 0))\n",
        "    n_nonzero = positive + negative\n",
        "\n",
        "    test = binomtest(\n",
        "        positive,\n",
        "        n=n_nonzero,\n",
        "        p=0.5,\n",
        "        alternative=\"two-sided\"\n",
        "    )\n",
        "\n",
        "    hemisphere_results.append({\n",
        "        \"metric\": metric,\n",
        "        \"comparison\": \"beyond_frontal_minus_frontal\",\n",
        "        \"n_identities\": int(len(differences)),\n",
        "        \"positive_differences\": positive,\n",
        "        \"negative_differences\": negative,\n",
        "        \"ties\": ties,\n",
        "        \"sign_test_n\": n_nonzero,\n",
        "        \"sign_test_raw_p\": float(test.pvalue)\n",
        "    })\n",
        "\n",
        "hemisphere = pd.DataFrame(hemisphere_results)\n",
        "\n",
        "# Separate Holm family: two exploratory hemisphere sign tests.\n",
        "hemisphere[\"sign_test_holm_p_two_test_family\"] = holm_adjust(\n",
        "    hemisphere[\"sign_test_raw_p\"].to_numpy()\n",
        ")\n",
        "\n",
        "print(\"\\n3. EXPLORATORY HEMISPHERE SIGN-TEST SENSITIVITY\")\n",
        "print(hemisphere.to_string(index=False))\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. Verify existing methodology report and correction-family\n",
        "#    documentation without changing the report.\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n4. EXISTING REPORT STATUS\")\n",
        "print(\"Report status:\", report.get(\"status\", \"STATUS_FIELD_NOT_FOUND\"))\n",
        "\n",
        "for key in [\n",
        "    \"M03\",\n",
        "    \"M04\",\n",
        "    \"M07\"\n",
        "]:\n",
        "    if key in report:\n",
        "        print(key, \":\", report[key])\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. Preservation checks\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "csv_hash_after = sha256(CSV_PATH)\n",
        "manuscript_hash_after = sha256(MANUSCRIPT_PATH)\n",
        "report_hash_after = sha256(REPORT_PATH)\n",
        "\n",
        "preservation = {\n",
        "    \"frozen_csv_unchanged\": csv_hash_before == csv_hash_after,\n",
        "    \"manuscript_unchanged\": manuscript_hash_before == manuscript_hash_after,\n",
        "    \"phase45_report_unchanged\": report_hash_before == report_hash_after\n",
        "}\n",
        "\n",
        "print(\"\\n5. PRESERVATION CHECKS\")\n",
        "for key, value in preservation.items():\n",
        "    print((\"PASS\" if value else \"FAIL\"), key)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. Save a separate audit result; preserve all existing files.\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "output_dir = os.path.join(\n",
        "    BASE,\n",
        "    \"step_4_5_statistical_methodology_audit\"\n",
        ")\n",
        "os.makedirs(output_dir, exist_ok=True)\n",
        "\n",
        "output_path = os.path.join(\n",
        "    output_dir,\n",
        "    \"experiment20_phase45_sign_test_sensitivity_audit.json\"\n",
        ")\n",
        "\n",
        "result = {\n",
        "    \"phase\": \"4.5\",\n",
        "    \"audit\": \"paired_sign_test_sensitivity_and_holm_family_verification\",\n",
        "    \"status\": \"COMPUTATION_COMPLETED\",\n",
        "    \"input_hashes\": {\n",
        "        \"frozen_evaluation_csv\": csv_hash_before,\n",
        "        \"manuscript\": manuscript_hash_before,\n",
        "        \"phase45_methodology_report\": report_hash_before\n",
        "    },\n",
        "    \"primary_six_test_family\": primary.to_dict(orient=\"records\"),\n",
        "    \"exploratory_hemisphere_two_test_family\": hemisphere.to_dict(orient=\"records\"),\n",
        "    \"preservation\": preservation,\n",
        "    \"interpretation\": {\n",
        "        \"sign_test\": (\n",
        "            \"The paired sign test evaluates directional consistency \"\n",
        "            \"without requiring symmetry of paired differences. \"\n",
        "            \"It is a sensitivity analysis, not a replacement silently \"\n",
        "            \"substituted for the original Wilcoxon analysis.\"\n",
        "        ),\n",
        "        \"primary_holm_family\": (\n",
        "            \"Six primary pairwise comparisons: three geometry comparisons \"\n",
        "            \"for each of two related distance metrics.\"\n",
        "        ),\n",
        "        \"hemisphere_holm_family\": (\n",
        "            \"Two exploratory metric comparisons, kept separate from \"\n",
        "            \"the primary six-test family. This family definition requires \"\n",
        "            \"explicit methodological justification in the manuscript.\"\n",
        "        ),\n",
        "        \"independence\": (\n",
        "            \"The sign test does not establish independence between identities.\"\n",
        "        )\n",
        "    }\n",
        "}\n",
        "\n",
        "with open(output_path, \"w\") as f:\n",
        "    json.dump(result, f, indent=2)\n",
        "\n",
        "print(\"\\n6. AUDIT OUTPUT\")\n",
        "print(\"Saved:\", output_path)\n",
        "print(\"Output SHA256:\", sha256(output_path))\n",
        "\n",
        "assert all(preservation.values()), \"A protected input changed unexpectedly.\"\n",
        "\n",
        "print(\"\\nFINAL STATUS: SIGN_TEST_SENSITIVITY_AUDIT_COMPLETED\")\n",
        "print(\"No manuscript, frozen CSV, or existing audit report was modified.\")\n"
      ],
