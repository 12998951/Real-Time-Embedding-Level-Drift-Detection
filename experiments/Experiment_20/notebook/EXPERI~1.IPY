      "source": [
        "\n",
        "# ============================================================\n",
        "# EXPERIMENT 20\n",
        "# STEP 2 — SUPPLEMENTARY FILE INSPECTION\n",
        "# ============================================================\n",
        "\n",
        "import json\n",
        "from pathlib import Path\n",
        "import pandas as pd\n",
        "\n",
        "print(\"=\" * 75)\n",
        "print(\"EXPERIMENT 20 — STEP 2\")\n",
        "print(\"SUPPLEMENTARY FILE INSPECTION\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "if experiment20_step2_inventory.empty:\n",
        "\n",
        "    print(\"No files available for inspection.\")\n",
        "\n",
        "else:\n",
        "\n",
        "    for index, row in experiment20_step2_inventory.iterrows():\n",
        "\n",
        "        file_path = Path(row[\"full_path\"])\n",
        "\n",
        "        print(\"\\n\" + \"-\" * 75)\n",
        "        print(f\"FILE {index + 1}: {file_path.name}\")\n",
        "        print(\"Path:\", file_path)\n",
        "        print(\"Extension:\", file_path.suffix)\n",
        "        print(\"Size (bytes):\", row[\"size_bytes\"])\n",
        "\n",
        "        try:\n",
        "\n",
        "            if file_path.suffix.lower() == \".csv\":\n",
        "\n",
        "                df = pd.read_csv(file_path)\n",
        "\n",
        "                print(\"\\nCSV dimensions:\", df.shape)\n",
        "                print(\"Column names:\")\n",
        "                print(df.columns.tolist())\n",
        "\n",
        "                print(\"\\nFirst 5 rows:\")\n",
        "                print(df.head().to_string(index=False))\n",
        "\n",
        "            elif file_path.suffix.lower() == \".json\":\n",
        "\n",
        "                with open(file_path, \"r\") as file:\n",
        "                    data = json.load(file)\n",
        "\n",
        "                print(\"\\nJSON structure:\")\n",
        "\n",
        "                if isinstance(data, dict):\n",
        "                    print(\"Top-level keys:\", list(data.keys()))\n",
        "                elif isinstance(data, list):\n",
        "                    print(\"Top-level list length:\", len(data))\n",
        "                    if data:\n",
        "                        print(\"First item:\", data[0])\n",
        "                else:\n",
        "                    print(\"Data type:\", type(data).__name__)\n",
        "\n",
        "                print(\"\\nJSON preview:\")\n",
        "                print(json.dumps(data, indent=2)[:3000])\n",
        "\n",
        "        except Exception as error:\n",
        "\n",
        "            print(\"Inspection error:\", str(error))\n",
        "\n",
        "print(\"\\n\" + \"=\" * 75)\n",
        "print(\"SUPPLEMENTARY INSPECTION COMPLETED\")\n",
        "print(\"=\" * 75)\n"
      ],
