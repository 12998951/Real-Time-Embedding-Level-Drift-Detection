widgets/base\",\"_model_module_version\":\"1.2.0\",\"_model_name\":\"LayoutModel\",\"_view_count\":null,\"_view_module\":\"@jupyter-widgets/base\",\"_view_module_version\":\"1.2.0\",\"_view_name\":\"LayoutView\",\"align_content\":null,\"align_items\":null,\"align_self\":null,\"border\":null,\"bottom\":null,\"display\":null,\"flex\":null,\"flex_flow\":null,\"grid_area\":null,\"grid_auto_columns\":null,\"grid_auto_flow\":null,\"grid_auto_rows\":null,\"grid_column\":null,\"grid_gap\":null,\"grid_row\":null,\"grid_template_areas\":null,\"grid_template_columns\":null,\"grid_template_rows\":null,\"height\":null,\"justify_content\":null,\"justify_items\":null,\"left\":null,\"margin\":null,\"max_height\":null,\"max_width\":null,\"min_height\":null,\"min_width\":null,\"object_fit\":null,\"object_position\":null,\"order\":null,\"overflow\":null,\"overflow_x\":null,\"overflow_y\":null,\"padding\":null,\"right\":null,\"top\":null,\"visibility\":null,\"width\":null}},\"0fbc906eddde4256a7c0df6a3cb5af43\":{\"model_module\":\"@jupyter-widgets/controls\",\"model_name\":\"ProgressStyleModel\",\"model_module_version\":\"1.5.0\",\"state\":{\"_model_module\":\"@jupyter-widgets/controls\",\"_model_module_version\":\"1.5.0\",\"_model_name\":\"ProgressStyleModel\",\"_view_count\":null,\"_view_module\":\"@jupyter-widgets/base\",\"_view_module_version\":\"1.2.0\",\"_view_name\":\"StyleView\",\"bar_color\":null,\"description_width\":\"\"}},\"c97f50a6ffac43e686298501e55337fd\":{\"model_module\":\"@jupyter-widgets/base\",\"model_name\":\"LayoutModel\",\"model_module_version\":\"1.2.0\",\"state\":{\"_model_module\":\"@jupyter-widgets/base\",\"_model_module_version\":\"1.2.0\",\"_model_name\":\"LayoutModel\",\"_view_count\":null,\"_view_module\":\"@jupyter-widgets/base\",\"_view_module_version\":\"1.2.0\",\"_view_name\":\"LayoutView\",\"align_content\":null,\"align_items\":null,\"align_self\":null,\"border\":null,\"bottom\":null,\"display\":null,\"flex\":null,\"flex_flow\":null,\"grid_area\":null,\"grid_auto_columns\":null,\"grid_auto_flow\":null,\"grid_auto_rows\":null,\"grid_column\":null,\"grid_gap\":null,\"grid_row\":null,\"grid_template_areas\":null,\"grid_template_columns\":null,\"grid_template_rows\":null,\"height\":null,\"justify_content\":null,\"justify_items\":null,\"left\":null,\"margin\":null,\"max_height\":null,\"max_width\":null,\"min_height\":null,\"min_width\":null,\"object_fit\":null,\"object_position\":null,\"order\":null,\"overflow\":null,\"overflow_x\":null,\"overflow_y\":null,\"padding\":null,\"right\":null,\"top\":null,\"visibility\":null,\"width\":null}},\"2ac19493b77a4c0c9ebf742e553cdf6d\":{\"model_module\":\"@jupyter-widgets/controls\",\"model_name\":\"DescriptionStyleModel\",\"model_module_version\":\"1.5.0\",\"state\":{\"_model_module\":\"@jupyter-widgets/controls\",\"_model_module_version\":\"1.5.0\",\"_model_name\":\"DescriptionStyleModel\",\"_view_count\":null,\"_view_module\":\"@jupyter-widgets/base\",\"_view_module_version\":\"1.2.0\",\"_view_name\":\"StyleView\",\"description_width\":\"\"}}}}}},\"cells\":[{\"cell_type\":\"markdown\",\"source\":[\"\\n\",\"# Experiment 20: Paired Identity-Level Evaluation of Within-Identity Embedding Drift Detection Under Multiple Controlled Biometric Acquisition Changes\\n\",\"\\n\",\"## 1. Research Background\\n\",\"\\n\",\"Previous experiments investigated embedding-level drift detection using synthetic distributions, image-derived feature representations and genuine face-recognition embeddings. Experiment 18 examined controlled illumination changes using 512-dimensional FaceNet embeddings extracted from the Labeled Faces in the Wild (LFW) dataset. Experiment 19 investigated the distinction between identity-composition drift and within-identity embedding drift using controlled biometric data-stream conditions.\\n\",\"\\n\",\"However, independently sampling original and transformed observations can introduce image-sampling variation into the evaluation of within-identity embedding changes. Consequently, observed embedding differences may reflect both acquisition-related representation changes and differences in the source images included in the compared samples.\\n\",\"\\n\",\"A paired image-level evaluation provides a more controlled approach by comparing the original and transformed representations of the same source image. This enables the measurement of embedding displacement while preserving source-image correspondence and identity composition.\\n\",\"\\n\",\"Biometric acquisition conditions can vary due to illumination changes, image blur and sensor-related noise. These conditions may alter facial representations even when the underlying identity remains unchanged.\\n\",\"\\n\",\"Investigating these effects through paired embedding comparisons is important for understanding the sensitivity, reliability and identity-level consistency of embedding-level drift detection methods.\\n\",\"\\n\",\"## 2. Problem Statement\\n\",\"\\n\",\"Embedding-level drift detectors may identify changes in biometric representation distributions without establishing how individual source images are affected by controlled acquisition changes.\\n\",\"\\n\",\"Furthermore, independently sampled baseline and transformed observations can introduce sampling variation, making it difficult to isolate representation changes associated with specific acquisition conditions.\\n\",\"\\n\",\"This creates an evaluation problem when assessing the sensitivity and reliability of embedding-level drift detection methods under multiple biometric acquisition changes.\\n\",\"\\n\",\"## 3. Research Objective\\n\",\"\\n\",\"To investigate the sensitivity, reliability and identity-level consistency of global and identity-conditioned embedding-level drift detection approaches under multiple controlled biometric acquisition changes using paired source-image comparisons.\\n\",\"\\n\",\"## 4. Research Questions\\n\",\"\\n\",\"1. How do controlled illumination, blur and image-noise variations affect paired within-identity embedding representations?\\n\",\"2. Does increasing acquisition-change strength produce greater embedding displacement?\\n\",\"3. How effectively can global and identity-conditioned monitoring approaches detect embedding distribution changes under different acquisition conditions?\\n\",\"4. How does detector performance vary across illumination, blur and noise transformations?\\n\",\"5. How consistently do embedding-level drift detectors identify acquisition-related representation changes across different identities?\\n\",\"6. Does paired image-level evaluation provide more controlled and stable estimates of within-identity embedding changes compared with independently sampled observations?\\n\",\"\\n\",\"## 5. Research Hypotheses\\n\",\"\\n\",\"**H1:** Controlled biometric acquisition changes produce measurable embedding displacement between original and transformed versions of the same source image.\\n\",\"\\n\",\"**H2:** Increasing acquisition-change strength produces greater within-identity embedding displacement on average.\\n\",\"\\n\",\"**H3:** Embedding-level drift detection performance varies across illumination, blur and image-noise transformations.\\n\",\"\\n\",\"**H4:** Identity-conditioned monitoring provides additional sensitivity or interpretability for certain within-identity acquisition-related changes compared with global monitoring.\\n\",\"\\n\",\"**H5:** Detection performance and embedding displacement vary across identities under the same acquisition transformation.\\n\",\"\\n\",\"**H6:** Paired image-level evaluation provides more controlled estimates of acquisition-related embedding changes by reducing variation caused by independently sampled source images.\\n\",\"\\n\",\"These hypotheses will be evaluated experimentally and will not be treated as established findings.\\n\",\"\\n\",\"## 6. Dataset and Model\\n\",\"\\n\",\"- Dataset: Existing Labeled Faces in the Wild (LFW)-derived cohort from Experiments 18 and 19.\\n\",\"- Expected source-image cohort: 889 observations, subject to dataset and file audit.\\n\",\"- Expected identity count: 13, subject to identity metadata verification.\\n\",\"- Face detector and alignment: Existing verified MTCNN preprocessing outputs, where suitable.\\n\",\"- Face-recognition model: InceptionResnetV1.\\n\",\"- Pretrained weights: VGGFace2.\\n\",\"- Embedding dimension: 512.\\n\",\"- Framework: PyTorch and facenet-pytorch.\\n\",\"- Identity labels: Used for paired data validation, controlled evaluation and identity-conditioned monitoring.\\n\",\"- Source-image correspondence: Maintained using stable image-level identifiers.\\n\",\"\\n\",\"Existing verified Experiment 18 and Experiment 19 artifacts will be assessed for reuse. Original image files must be available to generate the proposed acquisition transformations. Embedding extraction will not be repeated unless the audit identifies a methodological requirement.\\n\",\"\\n\",\"## 7. Experimental Methodology\\n\",\"\\n\",\"The experiment will investigate multiple controlled biometric acquisition conditions through paired original and transformed source images.\\n\",\"\\n\",\"The primary experimental conditions will include:\\n\",\"\\n\",\"- **C0 — Unchanged control:** Original images are evaluated without additional acquisition transformations.\\n\",\"- **C1 — Mild illumination variation:** Original images undergo a controlled mild illumination transformation.\\n\",\"- **C2 — Moderate illumination variation:** Original images undergo a controlled moderate illumination transformation.\\n\",\"- **C3 — Strong illumination variation:** Original images undergo a controlled strong illumination transformation.\\n\",\"- **C4 — Mild blur variation:** Original images undergo a controlled mild blur transformation.\\n\",\"- **C5 — Moderate blur variation:** Original images undergo a controlled moderate blur transformation.\\n\",\"- **C6 — Strong blur variation:** Original images undergo a controlled strong blur transformation.\\n\",\"- **C7 — Mild image-noise variation:** Original images undergo a controlled mild noise transformation.\\n\",\"- **C8 — Moderate image-noise variation:** Original images undergo a controlled moderate noise transformation.\\n\",\"- **C9 — Strong image-noise variation:** Original images undergo a controlled strong noise transformation.\\n\",\"\\n\",\"Each transformed image will retain the source-image identifier and corresponding identity label of its original image.\\n\",\"\\n\",\"The original and transformed images will be processed using the same verified face-recognition model to obtain corresponding 512-dimensional embeddings.\\n\",\"\\n\",\"The primary evaluation will preserve image-level pairing and use a fixed identity composition across baseline and transformed conditions.\\n\",\"\\n\",\"The experimental evaluation will include:\\n\",\"\\n\",\"1. Source-image and identity correspondence verification.\\n\",\"2. Controlled illumination, blur and noise transformation generation.\\n\",\"3. Paired embedding generation and validation.\\n\",\"4. Reference distribution fitting and independent threshold calibration.\\n\",\"5. Unchanged control evaluation.\\n\",\"6. Paired embedding displacement analysis.\\n\",\"7. Global and identity-conditioned drift detection.\\n\",\"8. Identity-level and transformation-specific statistical evaluation.\\n\",\"\\n\",\"The primary transformation comparisons will use a one-factor-at-a-time design. This will allow the effects of illumination, blur and noise to be examined separately.\\n\",\"\\n\",\"The precise transformation parameters, reference and evaluation partitions, detector configurations, calibration procedures and statistical evaluation methods will be finalised and documented before the main experimental execution.\\n\",\"\\n\",\"## 8. Evaluation Metrics\\n\",\"\\n\",\"- Paired Euclidean embedding distance.\\n\",\"- Paired cosine distance.\\n\",\"- Mean and median embedding displacement.\\n\",\"- Embedding displacement distributions by transformation type and strength.\\n\",\"- False-alarm rate.\\n\",\"- Detection rate.\\n\",\"- Precision and recall where appropriate.\\n\",\"- AUROC where the evaluation design supports it.\\n\",\"- Identity-level detection consistency.\\n\",\"- Confidence intervals.\\n\",\"- Effect sizes.\\n\",\"- Statistical significance with appropriate multiple-comparison correction.\\n\",\"- Computational performance where applicable.\\n\",\"\\n\",\"Detection performance and false-alarm behaviour will be reported separately for each detector and acquisition condition.\\n\",\"\\n\",\"Calibration target false-alarm levels will not be interpreted as proof of equivalent operational false-alarm performance.\\n\",\"\\n\",\"## 9. Reproducibility\\n\",\"\\n\",\"The experiment will record dataset provenance, source-image identifiers, identity mappings, embedding source, transformation parameters, random seeds, image partitions, detector configurations, reference-fitting settings, calibration thresholds, software versions and generated result artifacts.\\n\",\"\\n\",\"All original and transformed image pairs will retain their source-image correspondence throughout the experimental pipeline.\\n\",\"\\n\",\"All variants of a source image will remain within the same data partition to prevent image-level leakage between reference fitting, calibration and evaluation.\\n\",\"\\n\",\"The experiment will preserve the original dataset artifacts and store generated transformations, embeddings, configurations, results and research evidence separately.\\n\",\"\\n\",\"Documented configurations and validation checks will support independent verification and reproducibility.\\n\",\"\\n\",\"## 10. Scientific Scope and Limitations\\n\",\"\\n\",\"This experiment investigates within-identity embedding displacement and drift detection under controlled illumination, blur and image-noise variations using paired source-image comparisons.\\n\",\"\\n\",\"The study reuses the existing LFW-derived cohort from previous experiments. Therefore, it represents a follow-up experimental investigation rather than independent validation on a new biometric dataset.\\n\",\"\\n\",\"The acquisition transformations are simulated and do not fully reproduce real-world camera, sensor, environmental or biometric acquisition conditions.\\n\",\"\\n\",\"The limited number of identities and source images may restrict statistical power and generalisation. Multiple transformed versions of the same source image are dependent observations and will not be treated as independent samples.\\n\",\"\\n\",\"Identity-conditioned monitoring requires known identity labels and must be distinguished from monitoring systems that operate on unlabeled incoming observations.\\n\",\"\\n\",\"The experiment does not independently establish face-recognition accuracy, real-world biometric identification reliability, fairness, security or deployment readiness.\\n\",\"\\n\",\"Experimental findings will be interpreted within the limitations of the selected dataset, embedding model, controlled acquisition transformations, pairing procedure and evaluation protocol.\\n\",\"\\n\",\"---\\n\",\"\\n\",\"# Step 1: Environment and Reproducibility Setup\\n\",\"\\n\",\"## 1.1 Objective\\n\",\"\\n\",\"Establish a reproducible computational environment for Experiment 20.\\n\",\"\\n\",\"## 1.2 Environment Configuration\\n\",\"\\n\",\"This step initialises the required Python libraries, configures random seeds, records software versions and establishes the initial experiment configuration.\\n\",\"\\n\",\"## 1.3 Reproducibility Protocol\\n\",\"\\n\",\"- Configure fixed random seeds.\\n\",\"- Record Python and library versions.\\n\",\"- Record the execution platform and available computational hardware.\\n\",\"- Preserve the original Experiment 18 and Experiment 19 research artifacts.\\n\",\"- Store Experiment 20 outputs separately.\\n\",\"- Maintain a documented experimental configuration.\\n\",\"- Verify the availability of the required scientific computing and image-processing libraries.\\n\",\"\\n\",\"## 1.4 Expected Output\\n\",\"\\n\",\"A verified computational environment, reproducibility configuration, dependency availability report and initial experiment configuration.\\n\",\"\\n\",\"No image transformation, embedding extraction, detector fitting or experimental evaluation will occur in this step.\\n\"],\"metadata\":{\"id\":\"_g4WDwPgXahd\"}},{\"cell_type\":\"markdown\",\"source\":[\"\\n\",\"# Step 1 — Environment and Reproducibility Setup\\n\",\"\\n\",\"## 1.1 Objective\\n\",\"\\n\",\"Establish a reproducible computational environment for Experiment 20.\\n\",\"\\n\",\"## 1.2 Environment Configuration\\n\",\"\\n\",\"This step initialises the required Python libraries, configures random seeds, records software versions and establishes the initial experiment configuration.\\n\",\"\\n\",\"## 1.3 Reproducibility Protocol\\n\",\"\\n\",\"- Configure fixed random seeds.\\n\",\"- Record Python and library versions.\\n\",\"- Record the execution platform and available computational hardware.\\n\",\"- Preserve the original Experiment 18 and Experiment 19 research artifacts.\\n\",\"- Store Experiment 20 outputs separately.\\n\",\"- Maintain a documented experimental configuration.\\n\",\"- Verify the availability of the required scientific computing and image-processing libraries.\\n\",\"\\n\",\"## 1.4 Expected Output\\n\",\"\\n\",\"A verified computational environment, reproducibility configuration, dependency availability report and initial experiment configuration.\\n\",\"\\n\",\"No image transformation, embedding extraction, detector fitting or experimental evaluation will occur in this step.\\n\"],\"metadata\":{\"id\":\"VxPWwy4iX6Px\"}},{\"cell_type\":\"code\",\"execution_count\":null,\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"9lidhwIoVySv\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794346334383,\"user_tz\":360,\"elapsed\":4570,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"8da21f3f-52be-4e7a-87a3-9800bc537bd2\"},\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"===========================================================================\\n\",\"EXPERIMENT 20 — STEP 1\\n\",\"ENVIRONMENT AND REPRODUCIBILITY SETUP\\n\",\"===========================================================================\\n\",\"\\n\",\"[1] RANDOM SEED\\n\",\"Random seed: 202620\\n\",\"\\n\",\"[2] PYTHON ENVIRONMENT\\n\",\"{\\n\",\"    \\\"platform\\\": \\\"Linux-6.6.159+-x86_64-with-glibc2.39\\\",\\n\",\"    \\\"processor\\\": \\\"x86_64\\\",\\n\",\"    \\\"python_version\\\": \\\"3.13.18 (main, Oct 26 2026, 15:28:15) [GCC 13.3.0]\\\",\\n\",\"    \\\"machine\\\": \\\"x86_64\\\",\\n\",\"    \\\"pytorch_cuda_available\\\": false,\\n\",\"    \\\"gpu_name\\\": null\\n\",\"}\\n\",\"\\n\",\"[3] LIBRARY AVAILABILITY\\n\",\"\\n\",\"numpy:\\n\",\"{\\n\",\"    \\\"available\\\": true,\\n\",\"    \\\"version\\\": \\\"2.4.6\\\"\\n\",\"}\\n\",\"\\n\",\"pandas:\\n\",\"{\\n\",\"    \\\"available\\\": true,\\n\",\"    \\\"version\\\": \\\"2.2.3\\\"\\n\",\"}\\n\",\"\\n\",\"scipy:\\n\",\"{\\n\",\"    \\\"available\\\": true,\\n\",\"    \\\"version\\\": \\\"1.16.3\\\"\\n\",\"}\\n\",\"\\n\",\"sklearn:\\n\",\"{\\n\",\"    \\\"available\\\": true,\\n\",\"    \\\"version\\\": \\\"1.6.1\\\"\\n\",\"}\\n\",\"\\n\",\"matplotlib:\\n\",\"{\\n\",\"    \\\"available\\\": true,\\n\",\"    \\\"version\\\": \\\"3.10.0\\\"\\n\",\"}\\n\",\"\\n\",\"PIL:\\n\",\"{\\n\",\"    \\\"available\\\": true,\\n\",\"    \\\"version\\\": \\\"11.3.0\\\"\\n\",\"}\\n\",\"\\n\",\"torch:\\n\",\"{\\n\",\"    \\\"available\\\": true,\\n\",\"    \\\"version\\\": \\\"2.14.1+cpu\\\"\\n\",\"}\\n\",\"\\n\",\"[4] EXPERIMENT CONFIGURATION\\n\",\"{\\n\",\"    \\\"experiment\\\": 20,\\n\",\"    \\\"title\\\": \\\"Paired Identity-Level Evaluation of Within-Identity Embedding Drift Detection Under Multiple Controlled Biometric Acquisition Changes\\\",\\n\",\"    \\\"dataset_strategy\\\": \\\"existing\\\",\\n\",\"    \\\"dataset\\\": \\\"Existing LFW-derived cohort\\\",\\n\",\"    \\\"expected_source_images\\\": 889,\\n\",\"    \\\"expected_identities\\\": 13,\\n\",\"    \\\"embedding_dimension\\\": 512,\\n\",\"    \\\"transformation_families\\\": [\\n\",\"        \\\"illumination\\\",\\n\",\"        \\\"blur\\\",\\n\",\"        \\\"noise\\\"\\n\",\"    ],\\n\",\"    \\\"transformation_strengths\\\": [\\n\",\"        \\\"unchanged\\\",\\n\",\"        \\\"mild\\\",\\n\",\"        \\\"moderate\\\",\\n\",\"        \\\"strong\\\"\\n\",\"    ],\\n\",\"    \\\"random_seed\\\": 202620,\\n\",\"    \\\"window_size\\\": 20,\\n\",\"    \\\"detectors\\\": [\\n\",\"        \\\"global_euclidean\\\",\\n\",\"        \\\"global_mahalanobis\\\",\\n\",\"        \\\"identity_conditioned_standardized_euclidean\\\"\\n\",\"    ]\\n\",\"}\\n\",\"\\n\",\"[5] DEPENDENCY SUMMARY\\n\",\"Available libraries: 7\\n\",\"Missing libraries: 0\\n\",\"\\n\",\"[6] INITIAL VALIDATION\\n\",\"All required libraries available: True\\n\",\"Random seed reproducibility check: True\\n\",\"\\n\",\"===========================================================================\\n\",\"STEP 1 EXECUTION COMPLETED\\n\",\"===========================================================================\\n\"]}],\"source\":[\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 20\\n\",\"# STEP 1 — ENVIRONMENT AND REPRODUCIBILITY SETUP\\n\",\"# ============================================================\\n\",\"\\n\",\"import os\\n\",\"import sys\\n\",\"import json\\n\",\"import random\\n\",\"import platform\\n\",\"import importlib\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Reproducibility configuration\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"RANDOM_SEED = 202620\\n\",\"\\n\",\"os.environ[\\\"PYTHONHASHSEED\\\"] = str(RANDOM_SEED)\\n\",\"\\n\",\"random.seed(RANDOM_SEED)\\n\",\"np.random.seed(RANDOM_SEED)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Required library verification\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"required_libraries = [\\n\",\"    \\\"numpy\\\",\\n\",\"    \\\"pandas\\\",\\n\",\"    \\\"scipy\\\",\\n\",\"    \\\"sklearn\\\",\\n\",\"    \\\"matplotlib\\\",\\n\",\"    \\\"PIL\\\",\\n\",\"    \\\"torch\\\"\\n\",\"]\\n\",\"\\n\",\"library_status = {}\\n\",\"\\n\",\"for library in required_libraries:\\n\",\"    try:\\n\",\"        module = importlib.import_module(library)\\n\",\"\\n\",\"        version = getattr(\\n\",\"            module,\\n\",\"            \\\"__version__\\\",\\n\",\"            \\\"Version not exposed\\\"\\n\",\"        )\\n\",\"\\n\",\"        library_status[library] = {\\n\",\"            \\\"available\\\": True,\\n\",\"            \\\"version\\\": str(version)\\n\",\"        }\\n\",\"\\n\",\"    except Exception as error:\\n\",\"        library_status[library] = {\\n\",\"            \\\"available\\\": False,\\n\",\"            \\\"error\\\": str(error)\\n\",\"        }\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Hardware and platform information\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"hardware_info = {\\n\",\"    \\\"platform\\\": platform.platform(),\\n\",\"    \\\"processor\\\": platform.processor(),\\n\",\"    \\\"python_version\\\": sys.version,\\n\",\"    \\\"machine\\\": platform.machine()\\n\",\"}\\n\",\"\\n\",\"try:\\n\",\"    import torch\\n\",\"\\n\",\"    hardware_info[\\\"pytorch_cuda_available\\\"] = (\\n\",\"        torch.cuda.is_available()\\n\",\"    )\\n\",\"\\n\",\"    if torch.cuda.is_available():\\n\",\"        hardware_info[\\\"gpu_name\\\"] = (\\n\",\"            torch.cuda.get_device_name(0)\\n\",\"        )\\n\",\"    else:\\n\",\"        hardware_info[\\\"gpu_name\\\"] = None\\n\",\"\\n\",\"except Exception:\\n\",\"    hardware_info[\\\"pytorch_cuda_available\\\"] = False\\n\",\"    hardware_info[\\\"gpu_name\\\"] = None\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Experiment configuration\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"experiment_config = {\\n\",\"    \\\"experiment\\\": 20,\\n\",\"\\n\",\"    \\\"title\\\": (\\n\",\"        \\\"Paired Identity-Level Evaluation of Within-Identity \\\"\\n\",\"        \\\"Embedding Drift Detection Under Multiple Controlled \\\"\\n\",\"        \\\"Biometric Acquisition Changes\\\"\\n\",\"    ),\\n\",\"\\n\",\"    \\\"dataset_strategy\\\": \\\"existing\\\",\\n\",\"    \\\"dataset\\\": \\\"Existing LFW-derived cohort\\\",\\n\",\"\\n\",\"    \\\"expected_source_images\\\": 889,\\n\",\"    \\\"expected_identities\\\": 13,\\n\",\"    \\\"embedding_dimension\\\": 512,\\n\",\"\\n\",\"    \\\"transformation_families\\\": [\\n\",\"        \\\"illumination\\\",\\n\",\"        \\\"blur\\\",\\n\",\"        \\\"noise\\\"\\n\",\"    ],\\n\",\"\\n\",\"    \\\"transformation_strengths\\\": [\\n\",\"        \\\"unchanged\\\",\\n\",\"        \\\"mild\\\",\\n\",\"        \\\"moderate\\\",\\n\",\"        \\\"strong\\\"\\n\",\"    ],\\n\",\"\\n\",\"    \\\"random_seed\\\": RANDOM_SEED,\\n\",\"    \\\"window_size\\\": 20,\\n\",\"\\n\",\"    \\\"detectors\\\": [\\n\",\"        \\\"global_euclidean\\\",\\n\",\"        \\\"global_mahalanobis\\\",\\n\",\"        \\\"identity_conditioned_standardized_euclidean\\\"\\n\",\"    ]\\n\",\"}\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Reproducibility record\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"reproducibility_record = {\\n\",\"    \\\"experiment\\\": 20,\\n\",\"    \\\"step\\\": 1,\\n\",\"\\n\",\"    \\\"timestamp_utc\\\": datetime.now(\\n\",\"        timezone.utc\\n\",\"    ).isoformat(),\\n\",\"\\n\",\"    \\\"random_seed\\\": RANDOM_SEED,\\n\",\"    \\\"hardware\\\": hardware_info,\\n\",\"    \\\"libraries\\\": library_status,\\n\",\"    \\\"configuration\\\": experiment_config\\n\",\"}\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. Display results\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 1\\\")\\n\",\"print(\\\"ENVIRONMENT AND REPRODUCIBILITY SETUP\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"print(\\\"\\\\n[1] RANDOM SEED\\\")\\n\",\"print(\\\"Random seed:\\\", RANDOM_SEED)\\n\",\"\\n\",\"print(\\\"\\\\n[2] PYTHON ENVIRONMENT\\\")\\n\",\"print(json.dumps(hardware_info, indent=4))\\n\",\"\\n\",\"print(\\\"\\\\n[3] LIBRARY AVAILABILITY\\\")\\n\",\"\\n\",\"for library, details in library_status.items():\\n\",\"\\n\",\"    print(f\\\"\\\\n{library}:\\\")\\n\",\"    print(json.dumps(details, indent=4))\\n\",\"\\n\",\"print(\\\"\\\\n[4] EXPERIMENT CONFIGURATION\\\")\\n\",\"print(json.dumps(experiment_config, indent=4))\\n\",\"\\n\",\"print(\\\"\\\\n[5] DEPENDENCY SUMMARY\\\")\\n\",\"\\n\",\"available_count = sum(\\n\",\"    details[\\\"available\\\"]\\n\",\"    for details in library_status.values()\\n\",\")\\n\",\"\\n\",\"missing_count = (\\n\",\"    len(library_status) - available_count\\n\",\")\\n\",\"\\n\",\"print(\\\"Available libraries:\\\", available_count)\\n\",\"print(\\\"Missing libraries:\\\", missing_count)\\n\",\"\\n\",\"print(\\\"\\\\n[6] INITIAL VALIDATION\\\")\\n\",\"\\n\",\"seed_check = np.array_equal(\\n\",\"    np.random.RandomState(RANDOM_SEED).rand(5),\\n\",\"    np.random.RandomState(RANDOM_SEED).rand(5)\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"All required libraries available:\\\",\\n\",\"    missing_count == 0\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"Random seed reproducibility check:\\\",\\n\",\"    seed_check\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. Preserve record in notebook memory\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"experiment20_step1_record = reproducibility_record\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 1 EXECUTION COMPLETED\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\"]},{\"cell_type\":\"markdown\",\"source\":[\"\\n\",\"# Step 2 — Existing Dataset and File Audit\\n\",\"\\n\",\"## 2.1 Objective\\n\",\"\\n\",\"Identify and inspect the existing LFW-derived dataset artifacts from Experiments 18 and 19 to establish the availability of original images, embeddings, identity metadata and experimental configuration files.\\n\",\"\\n\",\"## 2.2 Dataset Audit\\n\",\"\\n\",\"The audit will examine the available experiment files and identify:\\n\",\"\\n\",\"- Original LFW image files.\\n\",\"- Existing 512-dimensional FaceNet embeddings.\\n\",\"- Image-level metadata and identity labels.\\n\",\"- Previously generated paired image information.\\n\",\"- Reference, calibration and evaluation partition files.\\n\",\"- Experiment 18 and Experiment 19 configuration and evidence artifacts.\\n\",\"\\n\",\"## 2.3 Data Integrity Requirements\\n\",\"\\n\",\"- Preserve all original dataset files.\\n\",\"- Do not overwrite or modify existing embeddings.\\n\",\"- Identify missing or inaccessible files.\\n\",\"- Record file formats, sizes and directory locations.\\n\",\"- Distinguish original image files from previously generated transformed images.\\n\",\"- Identify whether the existing artifacts provide sufficient information for image-level pairing.\\n\",\"\\n\",\"## 2.4 Expected Output\\n\",\"\\n\",\"A structured inventory of existing dataset files, including file types, sizes, directory locations and preliminary availability checks.\\n\",\"\\n\",\"No image transformations, embedding extraction or detector fitting will occur in this step.\\n\"],\"metadata\":{\"id\":\"tKRNr-IoYQ2L\"}},{\"cell_type\":\"code\",\"source\":[\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 20\\n\",\"# STEP 2 — EXISTING DATASET AND FILE AUDIT\\n\",\"# ============================================================\\n\",\"\\n\",\"import os\\n\",\"import json\\n\",\"from pathlib import Path\\n\",\"from collections import Counter\\n\",\"\\n\",\"import pandas as pd\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Define search locations\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"search_roots = [\\n\",\"    Path(\\\"/content\\\"),\\n\",\"    Path(\\\"/content/drive/MyDrive\\\")\\n\",\"]\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Define relevant file extensions\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"relevant_extensions = {\\n\",\"    \\\".npy\\\",\\n\",\"    \\\".npz\\\",\\n\",\"    \\\".csv\\\",\\n\",\"    \\\".json\\\",\\n\",\"    \\\".parquet\\\",\\n\",\"    \\\".pkl\\\",\\n\",\"    \\\".pickle\\\",\\n\",\"    \\\".ipynb\\\",\\n\",\"    \\\".zip\\\",\\n\",\"    \\\".jpg\\\",\\n\",\"    \\\".jpeg\\\",\\n\",\"    \\\".png\\\",\\n\",\"    \\\".bmp\\\",\\n\",\"    \\\".tif\\\",\\n\",\"    \\\".tiff\\\"\\n\",\"}\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Search for existing dataset and experiment files\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"file_records = []\\n\",\"search_errors = []\\n\",\"\\n\",\"for root in search_roots:\\n\",\"\\n\",\"    if not root.exists():\\n\",\"        print(f\\\"Search location unavailable: {root}\\\")\\n\",\"        continue\\n\",\"\\n\",\"    print(f\\\"Scanning: {root}\\\")\\n\",\"\\n\",\"    for current_root, directories, files in os.walk(root):\\n\",\"\\n\",\"        # Avoid unnecessary traversal of system/runtime folders.\\n\",\"        directories[:] = [\\n\",\"            directory\\n\",\"            for directory in directories\\n\",\"            if directory not in {\\n\",\"                \\\".config\\\",\\n\",\"                \\\".cache\\\",\\n\",\"                \\\"__pycache__\\\"\\n\",\"            }\\n\",\"        ]\\n\",\"\\n\",\"        for filename in files:\\n\",\"\\n\",\"            file_path = Path(current_root) / filename\\n\",\"\\n\",\"            if file_path.suffix.lower() not in relevant_extensions:\\n\",\"                continue\\n\",\"\\n\",\"            try:\\n\",\"                file_size = file_path.stat().st_size\\n\",\"\\n\",\"                file_records.append({\\n\",\"                    \\\"filename\\\": filename,\\n\",\"                    \\\"extension\\\": file_path.suffix.lower(),\\n\",\"                    \\\"size_bytes\\\": file_size,\\n\",\"                    \\\"size_mb\\\": round(\\n\",\"                        file_size / (1024 ** 2), 4\\n\",\"                    ),\\n\",\"                    \\\"directory\\\": str(file_path.parent),\\n\",\"                    \\\"full_path\\\": str(file_path)\\n\",\"                })\\n\",\"\\n\",\"            except Exception as error:\\n\",\"\\n\",\"                search_errors.append({\\n\",\"                    \\\"path\\\": str(file_path),\\n\",\"                    \\\"error\\\": str(error)\\n\",\"                })\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Create inventory DataFrame\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"inventory_df = pd.DataFrame(file_records)\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 2\\\")\\n\",\"print(\\\"EXISTING DATASET AND FILE AUDIT\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"print(\\\"\\\\n[1] SEARCH SUMMARY\\\")\\n\",\"\\n\",\"print(\\\"Total relevant files discovered:\\\", len(inventory_df))\\n\",\"print(\\\"File inspection errors:\\\", len(search_errors))\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. File type summary\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[2] FILE TYPE SUMMARY\\\")\\n\",\"\\n\",\"if not inventory_df.empty:\\n\",\"\\n\",\"    extension_summary = (\\n\",\"        inventory_df[\\\"extension\\\"]\\n\",\"        .value_counts()\\n\",\"        .rename_axis(\\\"extension\\\")\\n\",\"        .reset_index(name=\\\"file_count\\\")\\n\",\"    )\\n\",\"\\n\",\"    print(extension_summary.to_string(index=False))\\n\",\"\\n\",\"else:\\n\",\"    print(\\\"No relevant files discovered.\\\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. Identify potentially relevant research artifacts\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"keywords = [\\n\",\"    \\\"lfw\\\",\\n\",\"    \\\"embedding\\\",\\n\",\"    \\\"metadata\\\",\\n\",\"    \\\"identity\\\",\\n\",\"    \\\"experiment_18\\\",\\n\",\"    \\\"experiment_19\\\",\\n\",\"    \\\"partition\\\",\\n\",\"    \\\"reference\\\",\\n\",\"    \\\"calibration\\\",\\n\",\"    \\\"evaluation\\\",\\n\",\"    \\\"paired\\\",\\n\",\"    \\\"face\\\",\\n\",\"    \\\"facenet\\\",\\n\",\"    \\\"inception\\\",\\n\",\"    \\\"config\\\",\\n\",\"    \\\"split\\\"\\n\",\"]\\n\",\"\\n\",\"if not inventory_df.empty:\\n\",\"\\n\",\"    inventory_df[\\\"search_text\\\"] = (\\n\",\"        inventory_df[\\\"filename\\\"].str.lower()\\n\",\"        + \\\" \\\"\\n\",\"        + inventory_df[\\\"directory\\\"].str.lower()\\n\",\"    )\\n\",\"\\n\",\"    relevant_mask = inventory_df[\\\"search_text\\\"].apply(\\n\",\"        lambda value: any(\\n\",\"            keyword in value\\n\",\"            for keyword in keywords\\n\",\"        )\\n\",\"    )\\n\",\"\\n\",\"    relevant_files_df = (\\n\",\"        inventory_df[relevant_mask]\\n\",\"        .drop(columns=[\\\"search_text\\\"])\\n\",\"        .reset_index(drop=True)\\n\",\"    )\\n\",\"\\n\",\"else:\\n\",\"\\n\",\"    relevant_files_df = pd.DataFrame()\\n\",\"\\n\",\"print(\\\"\\\\n[3] POTENTIALLY RELEVANT RESEARCH FILES\\\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"Relevant files discovered:\\\",\\n\",\"    len(relevant_files_df)\\n\",\")\\n\",\"\\n\",\"if not relevant_files_df.empty:\\n\",\"\\n\",\"    print(\\n\",\"        relevant_files_df[\\n\",\"            [\\n\",\"                \\\"filename\\\",\\n\",\"                \\\"extension\\\",\\n\",\"                \\\"size_mb\\\",\\n\",\"                \\\"full_path\\\"\\n\",\"            ]\\n\",\"        ].to_string(index=False)\\n\",\"    )\\n\",\"\\n\",\"else:\\n\",\"\\n\",\"    print(\\\"No matching research artifacts found.\\\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. Preliminary image and embedding file counts\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[4] DATASET ARTIFACT COUNTS\\\")\\n\",\"\\n\",\"if not inventory_df.empty:\\n\",\"\\n\",\"    image_extensions = {\\n\",\"        \\\".jpg\\\", \\\".jpeg\\\", \\\".png\\\",\\n\",\"        \\\".bmp\\\", \\\".tif\\\", \\\".tiff\\\"\\n\",\"    }\\n\",\"\\n\",\"    embedding_extensions = {\\n\",\"        \\\".npy\\\", \\\".npz\\\"\\n\",\"    }\\n\",\"\\n\",\"    image_count = inventory_df[\\n\",\"        inventory_df[\\\"extension\\\"].isin(image_extensions)\\n\",\"    ].shape[0]\\n\",\"\\n\",\"    embedding_count = inventory_df[\\n\",\"        inventory_df[\\\"extension\\\"].isin(embedding_extensions)\\n\",\"    ].shape[0]\\n\",\"\\n\",\"    metadata_count = inventory_df[\\n\",\"        inventory_df[\\\"extension\\\"].isin({\\\".csv\\\", \\\".json\\\"})\\n\",\"    ].shape[0]\\n\",\"\\n\",\"else:\\n\",\"\\n\",\"    image_count = 0\\n\",\"    embedding_count = 0\\n\",\"    metadata_count = 0\\n\",\"\\n\",\"print(\\\"Image files:\\\", image_count)\\n\",\"print(\\\"Potential embedding files:\\\", embedding_count)\\n\",\"print(\\\"Potential metadata/configuration files:\\\", metadata_count)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 8. Search errors\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[5] SEARCH ERRORS\\\")\\n\",\"\\n\",\"if search_errors:\\n\",\"\\n\",\"    for error in search_errors[:20]:\\n\",\"        print(json.dumps(error, indent=4))\\n\",\"\\n\",\"else:\\n\",\"\\n\",\"    print(\\\"No file inspection errors.\\\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 9. Preserve audit results in notebook memory\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"experiment20_step2_inventory = inventory_df.copy()\\n\",\"\\n\",\"experiment20_step2_relevant_files = (\\n\",\"    relevant_files_df.copy()\\n\",\")\\n\",\"\\n\",\"experiment20_step2_audit_summary = {\\n\",\"    \\\"total_files_discovered\\\": len(inventory_df),\\n\",\"    \\\"relevant_files_discovered\\\": len(relevant_files_df),\\n\",\"    \\\"image_files\\\": image_count,\\n\",\"    \\\"embedding_files\\\": embedding_count,\\n\",\"    \\\"metadata_files\\\": metadata_count,\\n\",\"    \\\"inspection_errors\\\": len(search_errors)\\n\",\"}\\n\",\"\\n\",\"print(\\\"\\\\n[6] AUDIT SUMMARY\\\")\\n\",\"\\n\",\"print(\\n\",\"    json.dumps(\\n\",\"        experiment20_step2_audit_summary,\\n\",\"        indent=4\\n\",\"    )\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 2 FILE DISCOVERY COMPLETED\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"il5UoCfDYUN4\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794346405694,\"user_tz\":360,\"elapsed\":98,\"user\":{\"displayName\":\"shaik moien\",\"