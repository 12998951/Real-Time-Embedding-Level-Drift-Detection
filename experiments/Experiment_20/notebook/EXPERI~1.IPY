      "cell_type": "code",
      "source": [
        "\n",
        "from pathlib import Path\n",
        "import re\n",
        "import json\n",
        "import hashlib\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "ROOT = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "\n",
        "PHASE46 = ROOT / \"step_4_6_manuscript_reporting_audit\"\n",
        "PHASE47 = ROOT / \"step_4_7_final_manuscript_audit\"\n",
        "PHASE51 = ROOT / \"step_5_1_final_consistency_review\"\n",
        "\n",
        "FILES = {\n",
        "    \"phase46\": PHASE46 / \"experiment20_integrated_manuscript_v2_phase46_final.md\",\n",
        "    \"phase47\": PHASE47 / \"experiment20_integrated_manuscript_v2_phase47_final.md\",\n",
        "}\n",
        "\n",
        "CORRECTION_RECORD = PHASE46 / \"experiment20_phase46_manuscript_correction_verification.json\"\n",
        "HISTORICAL_AUDIT = PHASE46 / \"experiment20_phase46_manuscript_reporting_audit.json\"\n",
        "INSERTION_RECORD = PHASE47 / \"experiment20_phase47_conclusion_insertion_record.json\"\n",
        "\n",
        "def sha256(path):\n",
        "    return hashlib.sha256(path.read_bytes()).hexdigest()\n",
        "\n",
        "def inspect_table(text, number):\n",
        "    lines = text.splitlines()\n",
        "\n",
        "    # Avoid f-string interpretation of regex quantifiers.\n",
        "    caption_pattern = re.compile(\n",
        "        r\"^\\s*#{1,6}\\s*Table\\s+\" + str(number) + r\"\\s*[\\.:]\",\n",
        "        re.IGNORECASE\n",
        "    )\n",
        "\n",
        "    captions = [\n",
        "        (i, line.strip())\n",
        "        for i, line in enumerate(lines)\n",
        "        if caption_pattern.search(line)\n",
        "    ]\n",
        "\n",
        "    tables = []\n",
        "    i = 0\n",
        "\n",
        "    while i < len(lines) - 1:\n",
        "        header = lines[i].strip()\n",
        "        separator = lines[i + 1].strip()\n",
        "\n",
        "        if \"|\" in header and \"|\" in separator:\n",
        "            cells = [x.strip() for x in separator.strip(\"|\").split(\"|\")]\n",
        "\n",
        "            if cells and all(\n",
        "                re.fullmatch(r\":?-{3,}:?\", cell)\n",
        "                for cell in cells\n",
        "            ):\n",
        "                body_rows = 0\n",
        "                j = i + 2\n",
        "\n",
        "                while j < len(lines) and \"|\" in lines[j].strip():\n",
        "                    body_rows += 1\n",
        "                    j += 1\n",
        "\n",
        "                tables.append({\n",
        "                    \"start_line\": i + 1,\n",
        "                    \"body_rows\": body_rows,\n",
        "                    \"header\": header\n",
        "                })\n",
        "\n",
        "                i = j\n",
        "                continue\n",
        "\n",
        "        i += 1\n",
        "\n",
        "    associations = []\n",
        "\n",
        "    for caption_line, caption_text in captions:\n",
        "        following = [\n",
        "            table for table in tables\n",
        "            if table[\"start_line\"] > caption_line + 1\n",
        "        ]\n",
        "\n",
        "        associated = following[0] if following else None\n",
        "\n",
        "        associations.append({\n",
        "            \"caption_line\": caption_line + 1,\n",
        "            \"caption_text\": caption_text,\n",
        "            \"table_start_line\": (\n",
        "                associated[\"start_line\"] if associated else None\n",
        "            ),\n",
        "            \"table_body_rows\": (\n",
        "                associated[\"body_rows\"] if associated else None\n",
        "            )\n",
        "        })\n",
        "\n",
        "    valid = (\n",
        "        len(captions) == 1\n",
        "        and len(associations) == 1\n",
        "        and associations[0][\"table_start_line\"] is not None\n",
        "        and associations[0][\"table_body_rows\"] >= 1\n",
        "    )\n",
        "\n",
        "    return {\n",
        "        \"caption_count\": len(captions),\n",
        "        \"table_blocks_found\": len(tables),\n",
        "        \"associations\": associations,\n",
        "        \"valid\": valid\n",
        "    }\n",
        "\n",
        "# ------------------------------------------------\n",
        "# Load source files\n",
        "# ------------------------------------------------\n",
        "\n",
        "for name, path in FILES.items():\n",
        "    if not path.exists():\n",
        "        raise FileNotFoundError(path)\n",
        "\n",
        "for path in [CORRECTION_RECORD, HISTORICAL_AUDIT, INSERTION_RECORD]:\n",
        "    if not path.exists():\n",
        "        raise FileNotFoundError(path)\n",
        "\n",
        "original_hashes = {\n",
        "    name: sha256(path)\n",
        "    for name, path in FILES.items()\n",
        "}\n",
        "\n",
        "texts = {\n",
        "    name: path.read_text(encoding=\"utf-8\")\n",
        "    for name, path in FILES.items()\n",
        "}\n",
        "\n",
        "# ------------------------------------------------\n",
        "# Verify both tables in both manuscripts\n",
        "# ------------------------------------------------\n",
        "\n",
        "results = {}\n",
        "checks = {}\n",
        "\n",
        "for phase, text in texts.items():\n",
        "    results[phase] = {}\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 70)\n",
        "    print(phase.upper())\n",
        "    print(\"=\" * 70)\n",
        "\n",
        "    for number in [1, 2]:\n",
        "        result = inspect_table(text, number)\n",
        "        results[phase][str(number)] = result\n",
        "\n",
        "        key = f\"{phase}_table_{number}_caption_and_body\"\n",
        "        checks[key] = result[\"valid\"]\n",
        "\n",
        "        print(f\"\\nTable {number}:\")\n",
        "        print(json.dumps(result, indent=2))\n",
        "\n",
        "# ------------------------------------------------\n",
        "# Verify supporting correction records\n",
        "# ------------------------------------------------\n",
        "\n",
        "with open(CORRECTION_RECORD, encoding=\"utf-8\") as f:\n",
        "    correction = json.load(f)\n",
        "\n",
        "with open(HISTORICAL_AUDIT, encoding=\"utf-8\") as f:\n",
        "    historical = json.load(f)\n",
        "\n",
        "with open(INSERTION_RECORD, encoding=\"utf-8\") as f:\n",
        "    insertion = json.load(f)\n",
        "\n",
        "correction_checks = correction.get(\"checks\", {})\n",
        "insertion_checks = insertion.get(\"checks\", {})\n",
        "\n",
        "checks[\"phase46_table1_preserved\"] = (\n",
        "    correction_checks.get(\"table1_unchanged\") is True\n",
        ")\n",
        "\n",
        "checks[\"phase46_table2_preserved\"] = (\n",
        "    correction_checks.get(\"table2_unchanged\") is True\n",
        ")\n",
        "\n",
        "checks[\"phase47_table1_caption_retained\"] = (\n",
        "    insertion_checks.get(\"table1_caption_retained\") is True\n",
        ")\n",
        "\n",
        "checks[\"phase47_table2_caption_retained\"] = (\n",
        "    insertion_checks.get(\"table2_caption_retained\") is True\n",
        ")\n",
        "\n",
        "checks[\"phase47_original_content_preserved\"] = (\n",
        "    insertion_checks.get(\"original_content_preserved\") is True\n",
        ")\n",
        "\n",
        "checks[\"phase47_insertion_record_has_no_failures\"] = (\n",
        "    insertion.get(\"failed_checks\") == []\n",
        ")\n",
        "\n",
        "# ------------------------------------------------\n",
        "# Preserve historical failure, assess against evidence\n",
        "# ------------------------------------------------\n",
        "\n",
        "historical_failures = historical.get(\"failed_checks\", [])\n",
        "\n",
        "historical_caption_failure = any(\n",
        "    \"caption\" in str(item).lower()\n",
        "    for item in historical_failures\n",
        ")\n",
        "\n",
        "all_table_checks = all(\n",
        "    results[phase][str(n)][\"valid\"]\n",
        "    for phase in [\"phase46\", \"phase47\"]\n",
        "    for n in [1, 2]\n",
        ")\n",
        "\n",
        "historical_issue_resolved = (\n",
        "    historical_caption_failure\n",
        "    and all_table_checks\n",
        "    and checks[\"phase46_table1_preserved\"]\n",
        "    and checks[\"phase46_table2_preserved\"]\n",
        "    and checks[\"phase47_table1_caption_retained\"]\n",
        "    and checks[\"phase47_table2_caption_retained\"]\n",
        "    and checks[\"phase47_original_content_preserved\"]\n",
        ")\n",
        "\n",
        "# ------------------------------------------------\n",
        "# Confirm source manuscripts were not modified\n",
        "# ------------------------------------------------\n",
        "\n",
        "final_hashes = {\n",
        "    name: sha256(path)\n",
        "    for name, path in FILES.items()\n",
        "}\n",
        "\n",
        "manuscripts_unchanged = original_hashes == final_hashes\n",
        "checks[\"manuscripts_unchanged\"] = manuscripts_unchanged\n",
        "\n",
        "checks[\"historical_caption_issue_resolved_by_direct_evidence\"] = (\n",
        "    historical_issue_resolved\n",
        ")\n",
        "\n",
        "# ------------------------------------------------\n",
        "# Bibliography remains separately unverified\n",
        "# ------------------------------------------------\n",
        "\n",
        "phase47_text = texts[\"phase47\"]\n",
        "\n",
        "reference_match = re.search(\n",
        "    r\"(?im)^#{1,6}\\s*References\\s*$\",\n",
        "    phase47_text\n",
        ")\n",
        "\n",
        "references = []\n",
        "\n",
        "if reference_match:\n",
        "    section = phase47_text[reference_match.end():]\n",
        "    next_heading = re.search(r\"(?m)^#{1,6}\\s+\", section)\n",
        "\n",
        "    if next_heading:\n",
        "        section = section[:next_heading.start()]\n",
        "\n",
        "    references = [\n",
        "        line.strip()\n",
        "        for line in section.splitlines()\n",
        "        if line.strip() and not line.strip().startswith(\"#\")\n",
        "    ]\n",
        "\n",
        "bibliography_status = \"NOT_VERIFIED_EXTERNALLY\"\n",
        "\n",
        "# ------------------------------------------------\n",
        "# Verdict\n",
        "# ------------------------------------------------\n",
        "\n",
        "failed_checks = [\n",
        "    key for key, value in checks.items()\n",
        "    if value is not True\n",
        "]\n",
        "\n",
        "if failed_checks:\n",
        "    verdict = \"REVIEW REQUIRED — TABLE VERIFICATION INCOMPLETE\"\n",
        "else:\n",
        "    verdict = (\n",
        "        \"TABLE/CAPTION ISSUE RESOLVED — \"\n",
        "        \"BIBLIOGRAPHY VERIFICATION STILL OUTSTANDING\"\n",
        "    )\n",
        "\n",
        "# ------------------------------------------------\n",
        "# Save new reports only\n",
        "# ------------------------------------------------\n",
        "\n",
        "PHASE51.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "timestamp = datetime.now(timezone.utc).strftime(\"%Y%m%dT%H%M%SZ\")\n",
        "\n",
        "report = {\n",
        "    \"experiment\": \"Experiment 20\",\n",
        "    \"phase\": \"5.1\",\n",
        "    \"verification\": \"Corrected table-caption verification\",\n",
        "    \"created_utc\": timestamp,\n",
        "    \"verdict\": verdict,\n",
        "    \"checks\": checks,\n",
        "    \"failed_checks\": failed_checks,\n",
        "    \"table_results\": results,\n",
        "    \"historical_phase46_failed_checks\": historical_failures,\n",
        "    \"historical_caption_issue_resolved\": historical_issue_resolved,\n",
        "    \"phase46_correction_status\": correction.get(\"status\"),\n",
        "    \"phase47_insertion_status\": insertion.get(\"status\"),\n",
        "    \"bibliography\": {\n",
        "        \"reference_count\": len(references),\n",
        "        \"authenticity_status\": bibliography_status,\n",
        "        \"entries\": references\n",
        "    },\n",
        "    \"manuscript_hashes_before\": original_hashes,\n",
        "    \"manuscript_hashes_after\": final_hashes,\n",
        "    \"manuscripts_unchanged\": manuscripts_unchanged\n",
        "}\n",
        "\n",
        "json_path = PHASE51 / f\"experiment20_phase51_table_caption_closure_{timestamp}.json\"\n",
        "md_path = PHASE51 / f\"experiment20_phase51_table_caption_closure_{timestamp}.md\"\n",
        "\n",
        "with open(json_path, \"x\", encoding=\"utf-8\") as f:\n",
        "    json.dump(report, f, indent=2, ensure_ascii=False)\n",
        "\n",
        "md = f\"\"\"# Experiment 20 — Phase 5.1 Table Caption Closure\n",
        "\n",
        "**UTC:** {timestamp}\n",
        "\n",
        "## Verdict\n",
        "\n",
        "{verdict}\n",
        "\n",
        "## Checks\n",
        "\n",
        "\"\"\" + \"\\n\".join(\n",
        "    f\"- {'PASS' if value else 'REVIEW'}: {key}\"\n",
        "    for key, value in checks.items()\n",
        ") + f\"\"\"\n",
        "\n",
        "## Historical Phase 4.6 failure\n",
        "\n",
        "Historical caption failure recorded: {historical_caption_failure}\n",
        "\n",
        "Resolved by direct manuscript and correction-record evidence: {historical_issue_resolved}\n",
        "\n",
        "Historical record preserved unchanged.\n",
        "\n",
        "## Bibliography\n",
        "\n",
        "Reference entries detected: {len(references)}\n",
        "\n",
        "External authenticity status: {bibliography_status}\n",
        "\n",
        "## Manuscript preservation\n",
        "\n",
        "Both manuscript hashes unchanged during this verification: {manuscripts_unchanged}\n",
        "\n",
        "No manuscript or historical audit record was modified.\n",
        "\"\"\"\n",
        "\n",
        "with open(md_path, \"x\", encoding=\"utf-8\") as f:\n",
        "    f.write(md)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"CORRECTED PHASE 5.1 TABLE VERIFICATION SUMMARY\")\n",
        "print(\"=\" * 70)\n",
        "print(\"Verdict:\", verdict)\n",
        "print(\"Passed:\", sum(v is True for v in checks.values()), \"/\", len(checks))\n",
        "print(\"Failed:\", failed_checks)\n",
        "print(\"Historical caption issue resolved:\", historical_issue_resolved)\n",
        "print(\"Bibliography:\", bibliography_status)\n",
        "print(\"Manuscripts unchanged:\", manuscripts_unchanged)\n",
        "print(\"\\nJSON:\", json_path)\n",
        "print(\"JSON SHA256:\", sha256(json_path))\n",
        "print(\"Markdown:\", md_path)\n",
        "print(\"Markdown SHA256:\", sha256(md_path))\n",
        "print(\"\\nNo existing research files were modified.\")\n"
      ],
