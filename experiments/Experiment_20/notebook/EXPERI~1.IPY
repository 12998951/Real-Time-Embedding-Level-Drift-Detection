        "\n",
        "## Step 3.3.17 — Audit of the Original Multiple-Comparison Implementation\n",
        "\n",
        "### Objective\n",
        "\n",
        "Locate and inspect the original analysis code responsible for generating the six paired-comparison results.\n",
        "\n",
        "### Investigation Tasks\n",
        "\n",
        "1. Search the Experiment 20 project directory for Python scripts, Jupyter notebooks, and analysis documentation containing Holm correction logic.\n",
        "2. Identify where the Euclidean and cosine comparisons were grouped.\n",
        "3. Determine whether the correction was applied separately by metric or across all six comparisons.\n",
        "4. Locate the code responsible for writing the frozen paired-comparison CSV.\n",
        "5. Preserve the original analysis files and record the relevant code locations.\n",
        "\n",
        "### Data Integrity\n",
        "\n",
        "This step is strictly investigative. It must not execute the original statistical analysis, modify any notebook, change any CSV, or overwrite frozen evidence.\n",
        "\n",
        "### Expected Output\n",
        "\n",
        "A trace of the original Holm correction implementation, including relevant source-file names, code excerpts, and the output-file generation logic.\n",
        "\n",
        "### Completion Criteria\n",
        "\n",
        "The code responsible for the frozen Holm values must be identified before any corrected analysis is generated.\n"
      ],
      "metadata": {
        "id": "RF_h9HYbA4Ub"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "from pathlib import Path\n",
        "import json\n",
        "import re\n",
        "import hashlib\n",
        "\n",
        "ROOT = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "\n",
        "if not ROOT.exists():\n",
        "    raise FileNotFoundError(f\"Experiment directory not found: {ROOT}\")\n",
        "\n",
        "# Search source and documentation files only.\n",
        "EXTENSIONS = {\".py\", \".ipynb\", \".md\", \".txt\"}\n",
        "\n",
        "# Terms that may identify the original statistical implementation.\n",
        "PATTERNS = [\n",
        "    r\"holm\",\n",
        "    r\"multipletests\",\n",
        "    r\"paired_comparison\",\n",
        "    r\"paired comparison\",\n",
        "    r\"wilcoxon\",\n",
        "    r\"holm_adjusted_p_value\",\n",
        "    r\"experiment20_paired_comparison_results\"\n",
        "]\n",
        "\n",
        "compiled_patterns = [\n",
        "    re.compile(pattern, re.IGNORECASE)\n",
        "    for pattern in PATTERNS\n",
        "]\n",
        "\n",
        "MAX_FILE_SIZE = 15 * 1024 * 1024\n",
        "MAX_MATCHES_PER_FILE = 30\n",
        "MAX_CONTEXT_LINES = 5\n",
        "\n",
        "matches = []\n",
        "scanned_files = []\n",
        "skipped_files = []\n",
        "\n",
        "print(\"=\" * 100)\n",
        "print(\"EXPERIMENT 20 — STEP 3.3.17 ORIGINAL HOLM IMPLEMENTATION TRACE\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "for path in ROOT.rglob(\"*\"):\n",
        "    if not path.is_file():\n",
        "        continue\n",
        "\n",
        "    if path.suffix.lower() not in EXTENSIONS:\n",
        "        continue\n",
        "\n",
        "    # Avoid scanning generated environments or dependency folders.\n",
        "    if any(\n",
        "        part.lower() in {\n",
        "            \".ipynb_checkpoints\",\n",
        "            \"__pycache__\",\n",
        "            \"site-packages\",\n",
        "            \"node_modules\"\n",
        "        }\n",
        "        for part in path.parts\n",
        "    ):\n",
        "        continue\n",
        "\n",
        "    try:\n",
        "        size = path.stat().st_size\n",
        "\n",
        "        if size > MAX_FILE_SIZE:\n",
        "            skipped_files.append({\n",
        "                \"file\": str(path),\n",
        "                \"reason\": f\"File exceeds {MAX_FILE_SIZE} bytes\"\n",
        "            })\n",
        "            continue\n",
        "\n",
        "        raw = path.read_bytes()\n",
        "        digest = hashlib.sha256(raw).hexdigest()\n",
        "\n",
        "        scanned_files.append({\n",
        "            \"file\": str(path),\n",
        "            \"size_bytes\": size,\n",
        "            \"sha256\": digest\n",
        "        })\n",
        "\n",
        "        # Extract readable source from notebooks.\n",
        "        if path.suffix.lower() == \".ipynb\":\n",
        "            notebook = json.loads(raw.decode(\"utf-8\"))\n",
        "            lines = []\n",
        "\n",
        "            for cell_index, cell in enumerate(notebook.get(\"cells\", [])):\n",
        "                if cell.get(\"cell_type\") != \"code\":\n",
        "                    continue\n",
        "\n",
        "                source = cell.get(\"source\", [])\n",
        "                if isinstance(source, list):\n",
        "                    source = \"\".join(source)\n",
        "\n",
        "                lines.append(f\"# NOTEBOOK CODE CELL {cell_index}\")\n",
        "                lines.extend(source.splitlines())\n",
        "\n",
        "        else:\n",
        "            text = raw.decode(\"utf-8\", errors=\"replace\")\n",
        "            lines = text.splitlines()\n",
        "\n",
        "        file_matches = []\n",
        "\n",
        "        for index, line in enumerate(lines):\n",
        "            matched_terms = [\n",
        "                pattern.pattern\n",
        "                for pattern in compiled_patterns\n",
        "                if pattern.search(line)\n",
        "            ]\n",
        "\n",
        "            if not matched_terms:\n",
        "                continue\n",
        "\n",
        "            start = max(0, index - MAX_CONTEXT_LINES)\n",
        "            end = min(len(lines), index + MAX_CONTEXT_LINES + 1)\n",
        "\n",
        "            file_matches.append({\n",
        "                \"line_number\": index + 1,\n",
        "                \"matched_terms\": matched_terms,\n",
        "                \"context\": [\n",
        "                    {\n",
        "                        \"line_number\": j + 1,\n",
        "                        \"text\": lines[j]\n",
        "                    }\n",
        "                    for j in range(start, end)\n",
        "                ]\n",
        "            })\n",
        "\n",
        "            if len(file_matches) >= MAX_MATCHES_PER_FILE:\n",
        "                break\n",
        "\n",
        "        if file_matches:\n",
        "            matches.append({\n",
        "                \"file\": str(path),\n",
        "                \"sha256\": digest,\n",
        "                \"matches\": file_matches\n",
        "            })\n",
        "\n",
        "    except Exception as exc:\n",
        "        skipped_files.append({\n",
        "            \"file\": str(path),\n",
        "            \"reason\": repr(exc)\n",
        "        })\n",
        "\n",
        "print(\"\\n1. SEARCH INVENTORY\")\n",
        "print(\"-\" * 100)\n",
        "print(\"Project root:\", ROOT)\n",
        "print(\"Files scanned:\", len(scanned_files))\n",
        "print(\"Files with relevant matches:\", len(matches))\n",
        "print(\"Files skipped or unreadable:\", len(skipped_files))\n",
        "\n",
        "print(\"\\n2. RELEVANT SOURCE LOCATIONS\")\n",
        "print(\"-\" * 100)\n",
        "\n",
        "if not matches:\n",
        "    print(\"No matching implementation references found.\")\n",
        "\n",
        "for item in matches:\n",
        "    print(\"\\nFILE:\", item[\"file\"])\n",
        "    print(\"SHA256:\", item[\"sha256\"])\n",
        "\n",
        "    for match_index, record in enumerate(item[\"matches\"], start=1):\n",
        "        print(\n",
        "            f\"\\nMatch {match_index} | \"\n",
        "            f\"line {record['line_number']} | \"\n",
        "            f\"terms: {', '.join(record['matched_terms'])}\"\n",
        "        )\n",
        "\n",
        "        for context in record[\"context\"]:\n",
        "            print(\n",
        "                f\"{context['line_number']:>6}: \"\n",
        "                f\"{context['text']}\"\n",
        "            )\n",
        "\n",
        "print(\"\\n3. SKIPPED FILES\")\n",
        "print(\"-\" * 100)\n",
        "\n",
        "for item in skipped_files:\n",
        "    print(item[\"file\"], \"|\", item[\"reason\"])\n",
        "\n",
        "# Save the investigation record in a new Step 3.3.17 directory.\n",
        "OUTPUT_DIR = ROOT / \"step_3_3\" / \"step_3317\"\n",
        "OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "report = {\n",
        "    \"step\": \"3.3.17\",\n",
        "    \"purpose\": \"Trace original Holm correction implementation\",\n",
        "    \"project_root\": str(ROOT),\n",
        "    \"files_scanned\": scanned_files,\n",
        "    \"relevant_matches\": matches,\n",
        "    \"skipped_files\": skipped_files,\n",
        "    \"original_source_files_modified\": False,\n",
        "    \"frozen_csv_files_modified\": False,\n",
        "    \"statistical_analysis_executed\": False\n",
        "}\n",
        "\n",
        "report_path = (\n",
        "    OUTPUT_DIR /\n",
        "    \"experiment20_step3317_holm_implementation_trace.json\"\n",
        ")\n",
        "\n",
        "with report_path.open(\"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(report, f, indent=2, ensure_ascii=False)\n",
        "\n",
        "print(\"\\n4. INVESTIGATION REPORT\")\n",
        "print(\"-\" * 100)\n",
        "print(\"Saved:\", report_path)\n",
        "print(\"Original code modified: NO\")\n",
        "print(\"Frozen CSV files modified: NO\")\n",
        "print(\"Statistical analysis executed: NO\")\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"STEP 3.3.17 COMPLETED\")\n",
        "print(\"Send the complete output for review.\")\n",
        "print(\"=\" * 100)\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
