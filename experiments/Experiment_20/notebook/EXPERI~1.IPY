            "print(\"=\" * 70)\n",
            "\n",
            "print(\"\\n[1] Staged file summary\")\n",
            "\n",
            "subprocess.run(\n",
            "    [\"git\", \"diff\", \"--cached\", \"--stat\"],\n",
            "    check=True\n",
            ")\n",
