            "\u001b[1;30;43mStreaming output truncated to the last 5000 lines.\u001b[0m\n",
            "- Euclidean embedding displacement.\n",
            "- Distribution-level distance.\n",
            "- Drift detection rate and false alarm rate in subsequent detector evaluation.\n",
            "\n",
            "### Scientific Scope\n",
            "This experiment evaluates controlled illumination perturbations. It does not represent naturally occurring temporal drift or establish real-world biometric deployment performance.\n",
            "\n",
            "### Status\n",
            "Successfully completed. The evaluation partition was inspected, and five original LFW images were visually reviewed. The partition contains 968 image indices, 956 successfully extracted embeddings and 956 corresponding labels. Sample image integrity checks passed, with finite RGB pixel values within the valid [0, 1] range.\n",
            "\n",
            "---------------------------------------------------------------------------\n",
            "CELL 46 | TYPE: markdown\n",
            "Matched terms: brightness\n",
            "---------------------------------------------------------------------------\n",
            "## Step 15.1 — Controlled Illumination Transformation\n",
            "\n",
            "### Objective\n",
            "Generate controlled illumination variants from successfully processed evaluation images.\n",
            "\n",
            "### Transformation Conditions\n",
            "- Low illumination: brightness factor 0.5\n",
            "- Original illumination: brightness factor 1.0\n",
            "- High illumination: brightness factor 1.5\n",
            "\n",
            "### Methodology\n",
            "Apply multiplicative brightness adjustments to the original RGB images. Clip pixel values to the valid [0, 1] range.\n",
            "\n",
            "Only images with successful original FaceNet embedding extraction will be included, preserving paired comparisons.\n",
            "\n",
            "### Scientific Limitation\n",
            "These are computationally generated illumination perturbations, not naturally captured lighting conditions.\n",
            "\n",
            "### Status\n",
            "Successfully completed. Controlled illumination variants were generated for all 956 successfully processed evaluation images using brightness factors of 0.5, 1.0 and 1.5. All three image collections have the expected shape of (956, 125, 94, 3). Numerical integrity checks confirmed finite pixel values within the valid [0, 1] range. These transformations are computationally generated and do not represent naturally captured lighting conditions.\n",
            "\n",
            "---------------------------------------------------------------------------\n",
            "CELL 48 | TYPE: code\n",
            "Matched terms: brightness\n",
            "---------------------------------------------------------------------------\n",
            "import numpy as np\n",
            "import matplotlib.pyplot as plt\n",
            "\n",
            "# Exclude images where original face detection failed\n",
            "successful_evaluation_indices = np.setdiff1d(\n",
            "    evaluation_indices,\n",
            "    evaluation_failures\n",
            ")\n",
            "\n",
            "# Confirm paired dataset size\n",
            "print(\"Successful evaluation images:\",\n",
            "      len(successful_evaluation_indices))\n",
            "\n",
            "print(\"Original evaluation embeddings:\",\n",
            "      len(evaluation_embeddings))\n",
            "\n",
            "assert len(successful_evaluation_indices) == len(evaluation_embeddings)\n",
            "\n",
            "# Define illumination conditions\n",
            "brightness_factors = {\n",
            "    \"Low illumination\": 0.5,\n",
            "    \"Original illumination\": 1.0,\n",
            "    \"High illumination\": 1.5\n",
            "}\n",
            "\n",
            "# Generate transformed images\n",
            "illumination_images = {}\n",
            "\n",
            "for condition, factor in brightness_factors.items():\n",
            "\n",
            "    transformed = []\n",
            "\n",
            "    for image_index in successful_evaluation_indices:\n",
            "\n",
            "        original_image = lfw_dataset.images[image_index]\n",
            "\n",
            "        adjusted_image = np.clip(\n",
            "            original_image * factor,\n",
            "            0.0,\n",
            "            1.0\n",
            "        )\n",
            "\n",
            "        transformed.append(adjusted_image)\n",
            "\n",
            "    illumination_images[condition] = np.asarray(transformed)\n",
            "\n",
            "    print(\n",
            "        condition,\n",
            "        illumination_images[condition].shape\n",
            "    )\n",
            "\n",
            "# Visualise one image under all three conditions\n",
            "sample_position = 0\n",
            "\n",
            "fig, axes = plt.subplots(1, 3, figsize=(12, 4))\n",
            "\n",
            "for ax, (condition, images) in zip(\n",
            "    axes, illumination_images.items()\n",
            "):\n",
            "\n",
            "    ax.imshow(images[sample_position])\n",
            "    ax.set_title(condition)\n",
            "    ax.axis(\"off\")\n",
            "\n",
            "plt.suptitle(\"Controlled Illumination Variants\")\n",
            "plt.tight_layout()\n",
            "plt.show()\n",
            "\n",
            "# Validate generated images\n",
            "for condition, images in illumination_images.items():\n",
            "\n",
            "    print(\n",
            "        condition,\n",
            "        \"| Finite:\", np.all(np.isfinite(images)),\n",
            "        \"| Minimum:\", images.min(),\n",
            "        \"| Maximum:\", images.max()\n",
            "    )\n",
            "\n",
            "---------------------------------------------------------------------------\n",
            "CELL 49 | TYPE: markdown\n",
            "Matched terms: brightness\n",
            "---------------------------------------------------------------------------\n",
            "## Step 15.2 — FaceNet Embedding Extraction Under Illumination Changes\n",
            "\n",
            "### Objective\n",
            "Extract 512-dimensional FaceNet embeddings from low- and high-illumination evaluation images.\n",
            "\n",
            "### Methodology\n",
            "1. Reuse the original evaluation embeddings as the baseline.\n",
            "2. Process low-illumination images using MTCNN and FaceNet.\n",
            "3. Process high-illumination images using MTCNN and FaceNet.\n",
            "4. Record face detection failures separately.\n",
            "5. Verify embedding dimensions and numerical integrity.\n",
            "\n",
            "### Experimental Conditions\n",
            "- Original: existing baseline embeddings.\n",
            "- Low illumination: brightness factor 0.5.\n",
            "- High illumination: brightness factor 1.5.\n",
            "\n",
            "### Scientific Limitation\n",
            "Face detection may fail on transformed images. The final paired analysis must account for those failures rather than silently discarding them.\n",
            "\n",
            "### Status\n",
            "Successfully completed. FaceNet embeddings were extracted from low- and high-illumination evaluation images using MTCNN and InceptionResnetV1. The original baseline contained 956 embeddings of 512 dimensions. Low illumination produced 943 valid embeddings with 13 detection failures, while high illumination produced 897 valid embeddings with 59 detection failures. Both transformed embedding collections passed numerical integrity checks, with all values finite. Detection failures were recorded separately for subsequent paired-cohort validation.\n",
            "\n",
            "---------------------------------------------------------------------------\n",
            "CELL 50 | TYPE: code\n",
            "Matched terms: low_success, high_success\n",
            "---------------------------------------------------------------------------\n",
            "from PIL import Image\n",
            "from tqdm.auto import tqdm\n",
            "import numpy as np\n",
            "import torch\n",
            "\n",
            "def extract_transformed_embeddings(images, condition_name):\n",
            "\n",
            "    embeddings = []\n",
            "    successful_positions = []\n",
            "    failed_positions = []\n",
            "\n",
            "    for position, image in enumerate(\n",
            "        tqdm(images, desc=condition_name)\n",
            "    ):\n",
            "\n",
            "        try:\n",
            "            image_uint8 = (\n",
            "                np.clip(image, 0, 1) * 255\n",
            "            ).astype(np.uint8)\n",
            "\n",
            "            pil_image = Image.fromarray(image_uint8)\n",
            "\n",
            "            face_tensor = mtcnn(pil_image)\n",
            "\n",
            "            if face_tensor is None:\n",
            "                failed_positions.append(position)\n",
            "                continue\n",
            "\n",
            "            with torch.no_grad():\n",
            "                embedding = facenet(\n",
            "                    face_tensor.unsqueeze(0).to(device)\n",
            "                )\n",
            "\n",
            "            embedding = embedding.cpu().numpy()[0]\n",
            "\n",
            "            if not np.all(np.isfinite(embedding)):\n",
            "                failed_positions.append(position)\n",
            "                continue\n",
            "\n",
            "            embeddings.append(embedding)\n",
            "            successful_positions.append(position)\n",
            "\n",
            "        except Exception:\n",
            "            failed_positions.append(position)\n",
            "\n",
            "    return (\n",
            "        np.asarray(embeddings),\n",
            "        np.asarray(successful_positions),\n",
            "        np.asarray(failed_positions)\n",
            "    )\n",
            "\n",
            "\n",
            "# Extract low-illumination embeddings\n",
            "low_embeddings, low_success, low_failures = (\n",
            "    extract_transformed_embeddings(\n",
            "        illumination_images[\"Low illumination\"],\n",
            "        \"Low illumination\"\n",
            "    )\n",
            ")\n",
            "\n",
            "# Extract high-illumination embeddings\n",
            "high_embeddings, high_success, high_failures = (\n",
            "    extract_transformed_embeddings(\n",
            "        illumination_images[\"High illumination\"],\n",
            "        \"High illumination\"\n",
            "    )\n",
            ")\n",
            "\n",
            "print(\"\\nEMBEDDING EXTRACTION SUMMARY\")\n",
            "\n",
            "print(\"Original embeddings:\", evaluation_embeddings.shape)\n",
            "\n",
            "print(\"Low illumination embeddings:\", low_embeddings.shape)\n",
            "print(\"Low illumination failures:\", len(low_failures))\n",
            "\n",
            "print(\"High illumination embeddings:\", high_embeddings.shape)\n",
            "print(\"High illumination failures:\", len(high_failures))\n",
            "\n",
            "print(\"\\nNUMERICAL VALIDATION\")\n",
            "\n",
            "print(\"Low embeddings finite:\",\n",
            "      np.all(np.isfinite(low_embeddings)))\n",
            "\n",
            "print(\"High embeddings finite:\",\n",
            "      np.all(np.isfinite(high_embeddings)))\n",
            "\n",
            "print(\"Low successful positions:\", len(low_success))\n",
            "print(\"High successful positions:\", len(high_success))\n",
            "\n",
            "---------------------------------------------------------------------------\n",
            "CELL 52 | TYPE: code\n",
            "Matched terms: common_positions, original_embeddings, paired_labels, low_success, high_success\n",
            "---------------------------------------------------------------------------\n",
            "import numpy as np\n",
            "\n",
            "# Preserve the original extraction order\n",
            "evaluation_failure_set = set(evaluation_failures)\n",
            "\n",
            "ordered_original_indices = np.array([\n",
            "    idx for idx in evaluation_indices\n",
            "    if idx not in evaluation_failure_set\n",
            "])\n",
            "\n",
            "# Verify original image-to-embedding alignment\n",
            "assert len(ordered_original_indices) == len(evaluation_embeddings)\n",
            "\n",
            "original_labels_check = lfw_dataset.target[\n",
            "    ordered_original_indices\n",
            "]\n",
            "\n",
            "assert np.array_equal(\n",
            "    original_labels_check,\n",
            "    evaluation_labels\n",
            "), \"Original image and embedding labels are misaligned.\"\n",
            "\n",
            "# Find positions successful under both transformations\n",
            "common_positions = np.intersect1d(\n",
            "    low_success,\n",
            "    high_success\n",
            ")\n",
            "\n",
            "# Match all three conditions\n",
            "paired_original_embeddings = evaluation_embeddings[\n",
            "    common_positions\n",
            "]\n",
            "\n",
            "paired_low_embeddings = low_embeddings[\n",
            "    np.searchsorted(low_success, common_positions)\n",
            "]\n",
            "\n",
            "paired_high_embeddings = high_embeddings[\n",
            "    np.searchsorted(high_success, common_positions)\n",
            "]\n",
            "\n",
            "# Verify identity consistency\n",
            "paired_labels = evaluation_labels[common_positions]\n",
            "\n",
            "print(\"PAIRED COHORT VALIDATION\")\n",
            "print(\"-\" * 50)\n",
            "\n",
            "print(\"Original successful images:\", len(ordered_original_indices))\n",
            "print(\"Low illumination successes:\", len(low_success))\n",
            "print(\"High illumination successes:\", len(high_success))\n",
            "\n",
            "print(\"Images successful in all three conditions:\",\n",
            "      len(common_positions))\n",
            "\n",
            "print(\"\\nEmbedding shapes:\")\n",
            "print(\"Original:\", paired_original_embeddings.shape)\n",
            "print(\"Low:\", paired_low_embeddings.shape)\n",
            "print(\"High:\", paired_high_embeddings.shape)\n",
            "\n",
            "print(\"\\nIdentity labels aligned:\",\n",
            "      np.array_equal(\n",
            "          paired_labels,\n",
            "          lfw_dataset.target[\n",
            "              ordered_original_indices[common_positions]\n",
            "          ]\n",
            "      ))\n",
            "\n",
            "print(\"All paired embeddings finite:\",\n",
            "      all(np.all(np.isfinite(x)) for x in [\n",
            "          paired_original_embeddings,\n",
            "          paired_low_embeddings,\n",
            "          paired_high_embeddings\n",
            "      ]))\n",
            "\n",
            "assert paired_original_embeddings.shape == paired_low_embeddings.shape\n",
            "assert paired_original_embeddings.shape == paired_high_embeddings.shape\n",
            "assert paired_original_embeddings.shape[1] == 512\n",
            "\n",
            "---------------------------------------------------------------------------\n",
            "CELL 53 | TYPE: markdown\n",
            "Matched terms: brightness\n",
            "---------------------------------------------------------------------------\n",
            "## Step 15.4 — Illumination-Induced Embedding Displacement Analysis\n",
            "\n",
            "### Objective\n",
            "Quantify the changes in FaceNet embedding representations caused by controlled illumination transformations.\n",
            "\n",
            "### Methodology\n",
            "Compare paired original embeddings against their corresponding low- and high-illumination embeddings.\n",
            "\n",
            "### Evaluation Metrics\n",
            "1. Cosine similarity between original and transformed embeddings.\n",
            "2. Euclidean distance between original and transformed embeddings.\n",
            "3. Mean, median and standard deviation of embedding displacement.\n",
            "4. 95th percentile of embedding displacement.\n",
            "\n",
            "### Research Purpose\n",
            "Determine whether controlled illumination changes produce measurable shifts in genuine face-recognition embedding representations.\n",
            "\n",
            "### Scientific Limitation\n",
            "This analysis measures representation changes, not identity recognition accuracy or real-world temporal drift.\n",
            "\n",
            "### Status\n",
            "Successfully completed. Illumination-induced embedding displacement was calculated for 889 correctly paired evaluation images. Cosine similarity and Euclidean displacement statistics, including mean, median, standard deviation and 95th percentile distance, were computed for low- and high-illumination conditions. The analysis quantifies changes in embedding representations under controlled brightness transformations; it does not establish identity recognition accuracy or real-world temporal drift.\n",
            "\n",
            "---------------------------------------------------------------------------\n",
            "CELL 54 | TYPE: code\n",
            "Matched terms: common_positions, original_embeddings\n",
            "---------------------------------------------------------------------------\n",
            "import numpy as np\n",
            "import pandas as pd\n",
            "\n",
            "def calculate_embedding_displacement(\n",
            "    original_embeddings,\n",
            "    transformed_embeddings,\n",
            "    condition_name\n",
            "):\n",
            "\n",
            "    # Calculate cosine similarity for paired embeddings\n",
            "    cosine_similarities = np.sum(\n",
            "        original_embeddings * transformed_embeddings,\n",
            "        axis=1\n",
            "    ) / (\n",
            "        np.linalg.norm(original_embeddings, axis=1) *\n",
            "        np.linalg.norm(transformed_embeddings, axis=1)\n",
            "    )\n",
            "\n",
            "    # Calculate Euclidean displacement\n",
            "    euclidean_distances = np.linalg.norm(\n",
            "        original_embeddings - transformed_embeddings,\n",
            "        axis=1\n",
            "    )\n",
            "\n",
            "    return {\n",
            "        \"Condition\": condition_name,\n",
            "        \"Mean Cosine Similarity\": np.mean(cosine_similarities),\n",
            "        \"Median Cosine Similarity\": np.median(cosine_similarities),\n",
            "        \"Mean Euclidean Distance\": np.mean(euclidean_distances),\n",
            "        \"Median Euclidean Distance\": np.median(euclidean_distances),\n",
            "        \"Std Euclidean Distance\": np.std(euclidean_distances),\n",
            "        \"95th Percentile Distance\": np.percentile(\n",
            "            euclidean_distances, 95\n",
            "        )\n",
            "    }\n",
            "\n",
            "\n",
            "# Compare original embeddings with transformed embeddings\n",
            "low_results = calculate_embedding_displacement(\n",
            "    paired_original_embeddings,\n",
            "    paired_low_embeddings,\n",
            "    \"Low illumination\"\n",
            ")\n",
            "\n",
            "high_results = calculate_embedding_displacement(\n",
            "    paired_original_embeddings,\n",
            "    paired_high_embeddings,\n",
            "    \"High illumination\"\n",
            ")\n",
            "\n",
            "illumination_displacement_results = pd.DataFrame([\n",
            "    low_results,\n",
            "    high_results\n",
            "])\n",
            "\n",
            "print(\"ILLUMINATION-INDUCED EMBEDDING DISPLACEMENT\")\n",
            "print(\"Paired evaluation images:\", len(common_positions))\n",
            "\n",
            "display(\n",
            "    illumination_displacement_results.round(6)\n",
            ")\n",
            "\n",
            "---------------------------------------------------------------------------\n",
            "CELL 56 | TYPE: code\n",
            "Matched terms: original_embeddings\n",
            "---------------------------------------------------------------------------\n",
            "import matplotlib.pyplot as plt\n",
            "import numpy as np\n",
            "\n",
            "low_distances = np.linalg.norm(\n",
            "    paired_original_embeddings - paired_low_embeddings,\n",
            "    axis=1\n",
            ")\n",
            "\n",
            "high_distances = np.linalg.norm(\n",
            "    paired_original_embeddings - paired_high_embeddings,\n",
            "    axis=1\n",
            ")\n",
            "\n",
            "plt.figure(figsize=(10, 6))\n",
            "\n",
            "plt.hist(\n",
            "    low_distances,\n",
            "    bins=40,\n",
            "    alpha=0.6,\n",
            "    density=True,\n",
            "    label=\"Low illumination\"\n",
            ")\n",
            "\n",
            "plt.hist(\n",
            "    high_distances,\n",
            "    bins=40,\n",
            "    alpha=0.6,\n",
            "    density=True,\n",
            "    label=\"High illumination\"\n",
            ")\n",
            "\n",
            "plt.xlabel(\"Euclidean Embedding Displacement\")\n",
            "plt.ylabel(\"Density\")\n",
            "plt.title(\"FaceNet Embedding Displacement Under Illumination Changes\")\n",
            "plt.legend()\n",
            "plt.grid(alpha=0.3)\n",
            "plt.tight_layout()\n",
            "plt.show()\n",
            "\n",
            "print(\"LOW ILLUMINATION\")\n",
            "print(\"Mean:\", np.mean(low_distances))\n",
            "print(\"Median:\", np.median(low_distances))\n",
            "\n",
            "print(\"\\nHIGH ILLUMINATION\")\n",
            "print(\"Mean:\", np.mean(high_distances))\n",
            "print(\"Median:\", np.median(high_distances))\n",
            "\n",
            "---------------------------------------------------------------------------\n",
            "CELL 60 | TYPE: code\n",
            "Matched terms: paired_labels\n",
            "---------------------------------------------------------------------------\n",
            "import numpy as np\n",
            "import pandas as pd\n",
            "from scipy.stats import wilcoxon\n",
            "\n",
            "# Build image-level results\n",
            "identity_results = pd.DataFrame({\n",
            "    \"Identity\": paired_labels,\n",
            "    \"Low_Displacement\": low_distances,\n",
            "    \"High_Displacement\": high_distances\n",
            "})\n",
            "\n",
            "# Aggregate displacement within each identity\n",
            "identity_summary = (\n",
            "    identity_results\n",
            "    .groupby(\"Identity\")\n",
            "    .agg(\n",
            "        Image_Count=(\"Low_Displacement\", \"size\"),\n",
            "        Low_Median=(\"Low_Displacement\", \"median\"),\n",
            "        High_Median=(\"High_Displacement\", \"median\")\n",
            "    )\n",
            "    .reset_index()\n",
            ")\n",
            "\n",
            "identity_summary[\"Median_Difference\"] = (\n",
            "    identity_summary[\"High_Median\"] -\n",
            "    identity_summary[\"Low_Median\"]\n",
            ")\n",
            "\n",
            "# Identity-level paired statistical test\n",
            "identity_statistic, identity_p_value = wilcoxon(\n",
            "    identity_summary[\"High_Median\"],\n",
            "    identity_summary[\"Low_Median\"],\n",
            "    alternative=\"two-sided\"\n",
            ")\n",
            "\n",
            "print(\"IDENTITY-LEVEL ILLUMINATION ANALYSIS\")\n",
            "print(\"-\" * 55)\n",
            "\n",
            "display(identity_summary.round(6))\n",
            "\n",
            "print(\"\\nIDENTITY-LEVEL STATISTICAL TEST\")\n",
            "print(\"Number of identities:\", len(identity_summary))\n",
            "print(\"Wilcoxon statistic:\", identity_statistic)\n",
            "print(\"P-value:\", identity_p_value)\n",
            "\n",
            "print(\n",
            "    \"Identities with greater high-illumination displacement:\",\n",
            "    (identity_summary[\"Median_Difference\"] > 0).sum()\n",
            ")\n",
            "\n",
            "print(\n",
            "    \"Identities with lower high-illumination displacement:\",\n",
            "    (identity_summary[\"Median_Difference\"] < 0).sum()\n",
            ")\n",
            "\n",
            "print(\n",
            "    \"Median identity-level difference:\",\n",
            "    identity_summary[\"Median_Difference\"].median()\n",
            ")\n",
            "\n",
            "---------------------------------------------------------------------------\n",
            "CELL 64 | TYPE: code\n",
            "Matched terms: common_positions, original_embeddings, low_illumination_embeddings, high_illumination_embeddings, paired_labels, low_success, high_success, brightness, savez\n",
            "---------------------------------------------------------------------------\n",
            "import os\n",
            "import json\n",
            "import numpy as np\n",
            "import pandas as pd\n",
            "\n",
            "# Create output directory\n",
            "output_dir = \"/content/drive/MyDrive/Experiment_18_Results\"\n",
            "os.makedirs(output_dir, exist_ok=True)\n",
            "\n",
            "# Save numerical experiment results\n",
            "np.savez_compressed(\n",
            "    os.path.join(output_dir, \"experiment18_illumination_results.npz\"),\n",
            "\n",
            "    original_embeddings=paired_original_embeddings,\n",
            "    low_illumination_embeddings=paired_low_embeddings,\n",
            "    high_illumination_embeddings=paired_high_embeddings,\n",
            "\n",
            "    paired_labels=paired_labels,\n",
            "    common_positions=common_positions,\n",
            "\n",
            "    low_displacement=low_distances,\n",
            "    high_displacement=high_distances,\n",
            "\n",
            "    low_success=low_success,\n",
            "    high_success=high_success,\n",
            "\n",
            "    low_failures=low_failures,\n",
            "    high_failures=high_failures\n",
            ")\n",
            "\n",
            "# Save identity-level summary\n",
            "identity_summary.to_csv(\n",
            "    os.path.join(output_dir, \"illumination_identity_summary.csv\"),\n",
            "    index=False\n",
            ")\n",
            "\n",
            "# Save aggregate statistics\n",
            "illumination_metadata = {\n",
            "    \"experiment\": \"Experiment 18 - Controlled Illumination\",\n",
            "    \"dataset\": \"LFW filtered subset\",\n",
            "    \"model\": \"InceptionResnetV1\",\n",
            "    \"pretrained_weights\": \"VGGFace2\",\n",
            "    \"embedding_dimension\": 512,\n",
            "    \"brightness_factors\": {\n",
            "        \"low\": 0.5,\n",
            "        \"original\": 1.0,\n",
            "        \"high\": 1.5\n",
            "    },\n",
            "    \"paired_images\": int(len(common_positions)),\n",
            "    \"evaluation_identities\": int(len(identity_summary)),\n",
            "    \"low_detection_failures\": int(len(low_failures)),\n",
            "    \"high_detection_failures\": int(len(high_failures)),\n",
            "    \"image_level_wilcoxon_p\": float(p_value),\n",
            "    \"identity_level_wilcoxon_p\": float(identity_p_value),\n",
            "    \"mean_low_displacement\": float(np.mean(low_distances)),\n",
            "    \"mean_high_displacement\": float(np.mean(high_distances))\n",
            "}\n",
            "\n",
            "with open(\n",
            "    os.path.join(output_dir, \"illumination_metadata.json\"),\n",
            "    \"w\"\n",
            ") as file:\n",
            "    json.dump(illumination_metadata, file, indent=4)\n",
            "\n",
            "print(\"ILLUMINATION RESULTS SAVED\")\n",
            "\n",
            "for filename in [\n",
            "    \"experiment18_illumination_results.npz\",\n",
            "    \"illumination_identity_summary.csv\",\n",
            "    \"illumination_metadata.json\"\n",
            "]:\n",
            "    path = os.path.join(output_dir, filename)\n",
            "    print(filename, \"| Exists:\", os.path.exists(path))\n",
            "    print(\"Size:\", round(os.path.getsize(path) / 1024, 2), \"KB\")\n",
            "\n",
            "---------------------------------------------------------------------------\n",
            "CELL 65 | TYPE: markdown\n",
            "Matched terms: brightness\n",
            "---------------------------------------------------------------------------\n",
            "## Step 16 — Identity-Aware Embedding-Level Drift Detection\n",
            "\n",
            "### Objective\n",
            "Develop and evaluate embedding-level drift detectors for identifying changes in genuine FaceNet representations under controlled illumination perturbations.\n",
            "\n",
            "### Research Questions\n",
            "1. Can embedding-level detectors identify illumination-induced representation changes?\n",
            "2. How does detector sensitivity differ between low and high illumination?\n",
            "3. Can the detectors maintain controlled false alarm rates under baseline conditions?\n",
            "4. How does covariance regularisation influence Mahalanobis-based detection?\n",
            "\n",
            "### Experimental Design\n",
            "\n",
            "**Reference population**\n",
            "Original embeddings from the matched evaluation cohort.\n",
            "\n",
            "**Calibration population**\n",
            "Baseline-versus-baseline comparisons constructed using separate image samples and identity-aware sampling.\n",
            "\n",
            "**Evaluation population**\n",
            "Paired original and transformed embeddings under low- and high-illumination conditions.\n",
            "\n",
            "### Detection Methods\n",
            "- Euclidean embedding displacement.\n",
            "- Regularised Mahalanobis distance.\n",
            "\n",
            "### Proposed Configuration\n",
            "- Embedding dimension: 512.\n",
            "- Window size: 20.\n",
            "- Random seed: 202618.\n",
            "- Target false alarm rates: 0.01, 0.05 and 0.10.\n",
            "- Illumination factors: 0.5, 1.0 and 1.5.\n",
            "\n",
            "### Evaluation Metrics\n",
            "- Empirical false alarm rate.\n",
            "- Detection rate.\n",
            "- Detection sensitivity by illumination condition.\n",
            "- Detection performance across identities.\n",
            "- Numerical stability.\n",
            "\n",
            "### Scientific Limitations\n",
            "The experiment uses controlled brightness transformations rather than naturally occurring temporal drift. Detector results will be conditional on the matched evaluation cohort and the chosen calibration protocol.\n",
            "\n",
            "### Status\n",
            "Methodology defined; implementation pending.\n",
            "\n",
            "---------------------------------------------------------------------------\n",
            "CELL 66 | TYPE: code\n",
            "Matched terms: original_embeddings, paired_labels\n",
            "---------------------------------------------------------------------------\n",
            "import numpy as np\n",
            "import pandas as pd\n",
            "\n",
            "# Reproducibility\n",
            "RANDOM_SEED = 202618\n",
            "rng = np.random.default_rng(RANDOM_SEED)\n",
            "\n",
            "# Source data: 889 correctly paired images\n",
            "X_original = paired_original_embeddings\n",
            "X_low = paired_low_embeddings\n",
            "X_high = paired_high_embeddings\n",
            "y = paired_labels\n",
            "\n",
            "# Validate input dimensions\n",
            "assert X_original.shape == X_low.shape == X_high.shape\n",
            "assert len(X_original) == len(y)\n",
            "\n",
            "# Define partition proportions\n",
            "REFERENCE_RATIO = 0.50\n",
            "CALIBRATION_RATIO = 0.25\n",
            "EVALUATION_RATIO = 0.25\n",
            "\n",
            "reference_positions = []\n",
            "calibration_positions = []\n",
            "evaluation_positions = []\n",
            "\n",
            "# Split images separately within each identity\n",
            "for identity in np.unique(y):\n",
            "\n",
            "    identity_positions = np.where(y == identity)[0]\n",
            "\n",
            "    shuffled_positions = rng.permutation(identity_positions)\n",
            "\n",
            "    n = len(shuffled_positions)\n",
            "\n",
            "    reference_count = int(n * REFERENCE_RATIO)\n",
            "    calibration_count = int(n * CALIBRATION_RATIO)\n",
            "\n",
            "    reference_positions.extend(\n",
            "        shuffled_positions[:reference_count]\n",
            "    )\n",
            "\n",
            "    calibration_positions.extend(\n",
            "        shuffled_positions[\n",
            "            reference_count:\n",
            "            reference_count + calibration_count\n",
            "        ]\n",
            "    )\n",
            "\n",
            "    evaluation_positions.extend(\n",
            "        shuffled_positions[\n",
            "            reference_count + calibration_count:\n",
            "        ]\n",
            "    )\n",
            "\n",
            "# Convert to arrays\n",
            "reference_positions = np.sort(\n",
            "    np.asarray(reference_positions)\n",
            ")\n",
            "\n",
            "calibration_positions = np.sort(\n",
            "    np.asarray(calibration_positions)\n",
            ")\n",
            "\n",
            "evaluation_positions = np.sort(\n",
            "    np.asarray(evaluation_positions)\n",
            ")\n",
            "\n",
            "# Construct original embedding partitions\n",
            "reference_baseline = X_original[reference_positions]\n",
            "\n",
            "calibration_baseline = X_original[calibration_positions]\n",
            "\n",
            "evaluation_baseline = X_original[evaluation_positions]\n",
            "\n",
            "# Construct corresponding transformed evaluation partitions\n",
            "evaluation_low = X_low[evaluation_positions]\n",
            "\n",
            "evaluation_high = X_high[evaluation_positions]\n",
            "\n",
            "# Identity labels\n",
            "reference_labels = y[reference_positions]\n",
            "\n",
            "calibration_labels = y[calibration_positions]\n",
            "\n",
            "evaluation_labels = y[evaluation_positions]\n",
            "\n",
            "# Validate image-level separation\n",
            "assert len(set(reference_positions) & set(calibration_positions)) == 0\n",
            "assert len(set(reference_positions) & set(evaluation_positions)) == 0\n",
            "assert len(set(calibration_positions) & set(evaluation_positions)) == 0\n",
            "\n",
            "# Validate complete partition coverage\n",
            "all_positions = np.concatenate([\n",
            "    reference_positions,\n",
            "    calibration_positions,\n",
            "    evaluation_positions\n",
            "])\n",
            "\n",
            "assert len(all_positions) == len(X_original)\n",
            "assert len(np.unique(all_positions)) == len(X_original)\n",
            "\n",
            "# Display partition summary\n",
            "partition_summary = pd.DataFrame({\n",
            "    \"Partition\": [\n",
            "        \"Reference\",\n",
            "        \"Calibration\",\n",
            "        \"Evaluation\"\n",
            "    ],\n",
            "    \"Images\": [\n",
            "        len(reference_positions),\n",
            "        len(calibration_positions),\n",
            "        len(evaluation_positions)\n",
            "    ],\n",
            "    \"Identities\": [\n",
            "        len(np.unique(reference_labels)),\n",
            "        len(np.unique(calibration_labels)),\n",
            "        len(np.unique(evaluation_labels))\n",
            "    ]\n",
            "})\n",
            "\n",
            "print(\"IDENTITY-AWARE DATA PARTITIONING\")\n",
            "print(\"-\" * 55)\n",
            "\n",
            "display(partition_summary)\n",
            "\n",
            "print(\"\\nEMBEDDING SHAPES\")\n",
            "\n",
            "print(\"Reference:\", reference_baseline.shape)\n",
            "print(\"Calibration:\", calibration_baseline.shape)\n",
            "print(\"Evaluation baseline:\", evaluation_baseline.shape)\n",
            "print(\"Evaluation low:\", evaluation_low.shape)\n",
            "print(\"Evaluation high:\", evaluation_high.shape)\n",
            "\n",
            "print(\"\\nVALIDATION\")\n",
            "\n",
            "print(\"Reference-calibration overlap:\",\n",
            "      len(set(reference_positions) & set(calibration_positions)))\n",
            "\n",
            "print(\"Reference-evaluation overlap:\",\n",
            "      len(set(reference_positions) & set(evaluation_positions)))\n",
            "\n",
            "print(\"Calibration-evaluation overlap:\",\n",
            "      len(set(calibration_positions) & set(evaluation_positions)))\n",
            "\n",
            "print(\"All identities represented in each partition:\",\n",
            "      all(\n",
            "          len(np.unique(labels)) == len(np.unique(y))\n",
            "          for labels in [\n",
            "              reference_labels,\n",
            "              calibration_labels,\n",
            "              evaluation_labels\n",
            "          ]\n",
            "      ))\n",
            "\n",
            "print(\"All embeddings finite:\",\n",
            "      all(\n",
            "          np.all(np.isfinite(x))\n",
            "          for x in [\n",
            "              reference_baseline,\n",
            "              calibration_baseline,\n",
            "              evaluation_baseline,\n",
            "              evaluation_low,\n",
            "              evaluation_high\n",
            "          ]\n",
            "      ))\n",
            "\n",
            "---------------------------------------------------------------------------\n",
            "CELL 91 | TYPE: markdown\n",
            "Matched terms: brightness\n",
            "---------------------------------------------------------------------------\n",
            "## Step 17.1 — Controlled Illumination Detector Scoring\n",
            "\n",
            "### Objective\n",
            "Evaluate the response of the frozen embedding-level detectors under original, low-illumination, and high-illumination conditions.\n",
            "\n",
            "### Methodology\n",
            "1. Calculate identity-balanced window means for each illumination condition.\n",
            "2. Calculate Euclidean distances from the frozen reference mean.\n",
            "3. Calculate Mahalanobis distances using the frozen identity-balanced covariance.\n",
            "4. Compare detector scores across the three conditions.\n",
            "\n",
            "### Evaluation Conditions\n",
            "- Original illumination\n",
            "- Low illumination (brightness factor 0.5)\n",
            "- High illumination (brightness factor 1.5)\n",
            "\n",
            "### Research Purpose\n",
            "Determine whether controlled illumination changes produce measurable shifts in the embedding-level detector scores.\n",
            "\n",
            "### Scientific Limitation\n",
            "The evaluation contains 13 identities and 229 images. Results represent controlled synthetic illumination changes, not real-world environmental drift or biometric recognition accuracy.\n",
            "\n",
            "### Status\n",
            "Successfully completed. The frozen Euclidean and Mahalanobis detectors were evaluated under original, low-illumination and high-illumination conditions using the identity-balanced reference statistics.\n",
            "\n",
            "The original condition produced a mean Euclidean score of 0.053114 and a mean Mahalanobis score of 0.797920.\n",
            "\n",
            "The low-illumination condition (brightness factor 0.5) produced a mean Euclidean score of 0.094771 and a mean Mahalanobis score of 1.735851.\n",
            "\n",
            "The high-illumination condition (brightness factor 1.5) produced a mean Euclidean score of 0.082996 and a mean Mahalanobis score of 1.871540.\n",
            "\n",
            "Numerical validation confirmed that all detector scores were finite.\n",
            "\n",
            "These results show measurable changes in embedding-level detector scores under the controlled illumination conditions. They do not establish real-world biometric recognition accuracy, environmental robustness or deployment readiness. The evaluation is limited to 13 identities and 229 images.\n",
            "\n",
            "---------------------------------------------------------------------------\n",
            "CELL 99 | TYPE: code\n",
            "Matched terms: original_embeddings, paired_labels\n",
            "---------------------------------------------------------------------------\n",
            "print(\"PAIRED DATASET DIMENSIONS\")\n",
            "print(\"Original:\", paired_original_embeddings.shape)\n",
            "print(\"Low illumination:\", paired_low_embeddings.shape)\n",
            "print(\"High illumination:\", paired_high_embeddings.shape)\n",
            "print(\"Paired labels:\", paired_labels.shape)\n",
            "\n",
            "print(\"\\nIDENTITY DISTRIBUTION\")\n",
            "print(pd.Series(paired_labels).value_counts().sort_index())\n",
            "\n",
            "print(\"\\nEVALUATION BASELINE\")\n",
            "print(\"Evaluation baseline:\", evaluation_baseline.shape)\n",
            "print(\"Evaluation labels:\", evaluation_labels.shape)\n",
            "\n",
            "---------------------------------------------------------------------------\n",
            "CELL 101 | TYPE: code\n",
            "Matched terms: paired_labels\n",
            "---------------------------------------------------------------------------\n",
            "print(\"FULL PAIRED COHORT\")\n",
            "print(\"Unique identities:\", np.unique(paired_labels))\n",
            "print(\"Identity counts:\")\n",
            "print(pd.Series(paired_labels).value_counts().sort_index())\n",
            "\n",
            "print(\"\\nEVALUATION COHORT\")\n",
            "print(\"Unique identities:\", np.unique(evaluation_labels))\n",
            "print(\"Identity counts:\")\n",
            "print(pd.Series(evaluation_labels).value_counts().sort_index())\n",
            "\n",
            "print(\"\\nCOHORT VALIDATION\")\n",
            "print(\"Full paired samples:\", len(paired_labels))\n",
            "print(\"Evaluation samples:\", len(evaluation_labels))\n",
            "print(\"Evaluation identities:\", len(np.unique(evaluation_labels)))\n",
            "print(\"Same identity sets:\",\n",
            "      set(np.unique(paired_labels)) == set(np.unique(evaluation_labels)))\n",
            "\n",
            "---------------------------------------------------------------------------\n",
            "CELL 111 | TYPE: code\n",
            "Matched terms: brightness\n",
            "---------------------------------------------------------------------------\n",
            "\n",
            "import numpy as np\n",
            "import pandas as pd\n",
            "from IPython.display import display\n",
            "\n",
            "# ============================================================\n",
            "# EXPERIMENT 18 — STEP 17.9\n",
            "# RESEARCH FINDINGS AND SCIENTIFIC INTERPRETATION\n",
            "# ============================================================\n",
            "\n",
            "print(\"EXPERIMENT 18 — STEP 17.9\")\n",
            "print(\"Research Findings and Scientific Interpretation\")\n",
            "print(\"=\" * 70)\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 1. Validate existing experimental results\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "required_objects = [\n",
            "    \"evaluation_detector_df\",\n",
            "    \"paired_summary\",\n",
            "    \"statistical_results\",\n",
            "    \"effect_size_df\",\n",
            "    \"identity_detector_df\"\n",
            "]\n",
            "\n",
            "missing_objects = [\n",
            "    name for name in required_objects\n",
            "    if name not in globals()\n",
            "]\n",
            "\n",
            "if missing_objects:\n",
            "    raise NameError(\n",
            "        f\"Missing previously generated results: {missing_objects}\"\n",
            "    )\n",
            "\n",
            "assert len(identity_detector_df[\"Identity\"].unique()) == 13\n",
            "assert len(evaluation_detector_df) == 3\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 2. Aggregate detector response\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "aggregate = evaluation_detector_df.set_index(\"Condition\")\n",
            "\n",
            "original = aggregate.loc[\"Original\"]\n",
            "low = aggregate.loc[\"Low illumination\"]\n",
            "high = aggregate.loc[\"High illumination\"]\n",
            "\n",
            "aggregate_findings = pd.DataFrame({\n",
            "    \"Detector\": [\"Euclidean\", \"Mahalanobis\"],\n",
            "\n",
            "    \"Original\": [\n",
            "        original[\"Euclidean\"],\n",
            "        original[\"Mahalanobis\"]\n",
            "    ],\n",
            "\n",
            "    \"Low Illumination\": [\n",
            "        low[\"Euclidean\"],\n",
            "        low[\"Mahalanobis\"]\n",
            "    ],\n",
            "\n",
            "    \"High Illumination\": [\n",
            "        high[\"Euclidean\"],\n",
            "        high[\"Mahalanobis\"]\n",
            "    ],\n",
            "\n",
            "    \"Low Change (%)\": [\n",
            "        (low[\"Euclidean\"] - original[\"Euclidean\"])\n",
            "        / original[\"Euclidean\"] * 100,\n",
            "\n",
            "        (low[\"Mahalanobis\"] - original[\"Mahalanobis\"])\n",
            "        / original[\"Mahalanobis\"] * 100\n",
            "    ],\n",
            "\n",
            "    \"High Change (%)\": [\n",
            "        (high[\"Euclidean\"] - original[\"Euclidean\"])\n",
            "        / original[\"Euclidean\"] * 100,\n",
            "\n",
            "        (high[\"Mahalanobis\"] - original[\"Mahalanobis\"])\n",
            "        / original[\"Mahalanobis\"] * 100\n",
            "    ]\n",
            "})\n",
            "\n",
            "print(\"\\n1. AGGREGATE DETECTOR RESPONSE\")\n",
            "display(aggregate_findings.round(6))\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 3. Identity-level response direction\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "identity_data = identity_detector_df.copy()\n",
            "\n",
            "identity_data[\"Condition\"] = (\n",
            "    identity_data[\"Condition\"]\n",
            "    .astype(str)\n",
            "    .str.strip()\n",
            "    .str.lower()\n",
            ")\n",
            "\n",
            "print(\"\\nAvailable identity-level conditions:\")\n",
            "print(identity_data[\"Condition\"].unique())\n",
            "\n",
            "low_data = identity_data[\n",
            "    identity_data[\"Condition\"].str.contains(\"low\")\n",
            "].set_index(\"Identity\")\n",
            "\n",
            "high_data = identity_data[\n",
            "    identity_data[\"Condition\"].str.contains(\"high\")\n",
            "].set_index(\"Identity\")\n",
            "\n",
            "common_identities = low_data.index.intersection(\n",
            "    high_data.index\n",
            ")\n",
            "\n",
            "if len(common_identities) != 13:\n",
            "    raise ValueError(\n",
            "        f\"Expected 13 paired identities, found {len(common_identities)}.\"\n",
            "    )\n",
            "\n",
            "low_data = low_data.loc[common_identities]\n",
            "high_data = high_data.loc[common_identities]\n",
            "\n",
            "euclidean_differences = (\n",
            "    high_data[\"Euclidean\"] - low_data[\"Euclidean\"]\n",
            ")\n",
            "\n",
            "mahalanobis_differences = (\n",
            "    high_data[\"Mahalanobis\"] - low_data[\"Mahalanobis\"]\n",
            ")\n",
            "\n",
            "identity_direction = pd.DataFrame({\n",
            "    \"Detector\": [\"Euclidean\", \"Mahalanobis\"],\n",
            "\n",
            "    \"Higher Under High Illumination\": [\n",
            "        int((euclidean_differences > 0).sum()),\n",
            "        int((mahalanobis_differences > 0).sum())\n",
            "    ],\n",
            "\n",
            "    \"Higher Under Low Illumination\": [\n",
            "        int((euclidean_differences < 0).sum()),\n",
            "        int((mahalanobis_differences < 0).sum())\n",
            "    ],\n",
            "\n",
            "    \"Equal\": [\n",
            "        int((euclidean_differences == 0).sum()),\n",
            "        int((mahalanobis_differences == 0).sum())\n",
            "    ]\n",
            "})\n",
            "\n",
            "print(\"\\n2. IDENTITY-LEVEL RESPONSE DIRECTION\")\n",
            "display(identity_direction)\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 4. Paired statistical test results\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n3. PAIRED STATISTICAL TEST RESULTS\")\n",
            "display(statistical_results.round(6))\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 5. Effect size and uncertainty\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n4. EFFECT SIZE AND UNCERTAINTY\")\n",
            "display(effect_size_df.round(6))\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 6. Scientific interpretation\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n5. SCIENTIFIC INTERPRETATION\")\n",
            "\n",
            "print(\n",
            "    f\"\\nEuclidean detector:\"\n",
            "    f\"\\n  Original score: {original['Euclidean']:.6f}\"\n",
            "    f\"\\n  Low illumination: {low['Euclidean']:.6f}\"\n",
            "    f\"\\n  High illumination: {high['Euclidean']:.6f}\"\n",
            "    f\"\\n  Low illumination increase: \"\n",
            "    f\"{aggregate_findings.loc[0, 'Low Change (%)']:.2f}%\"\n",
            "    f\"\\n  High illumination increase: \"\n",
            "    f\"{aggregate_findings.loc[0, 'High Change (%)']:.2f}%\"\n",
            ")\n",
            "\n",
            "print(\n",
            "    f\"\\nMahalanobis detector:\"\n",
            "    f\"\\n  Original score: {original['Mahalanobis']:.6f}\"\n",
            "    f\"\\n  Low illumination: {low['Mahalanobis']:.6f}\"\n",
            "    f\"\\n  High illumination: {high['Mahalanobis']:.6f}\"\n",
            "    f\"\\n  Low illumination increase: \"\n",
            "    f\"{aggregate_findings.loc[1, 'Low Change (%)']:.2f}%\"\n",
            "    f\"\\n  High illumination increase: \"\n",
            "    f\"{aggregate_findings.loc[1, 'High Change (%)']:.2f}%\"\n",
            ")\n",
            "\n",
            "print(\n",
            "    \"\\nIdentity-level comparison:\"\n",
            "    f\"\\n  Euclidean: high illumination produced greater \"\n",
            "    f\"displacement in {(euclidean_differences > 0).sum()} \"\n",
            "    f\"of {len(euclidean_differences)} identities.\"\n",
            "    f\"\\n  Mahalanobis: high illumination produced greater \"\n",
            "    f\"displacement in {(mahalanobis_differences > 0).sum()} \"\n",
            "    f\"of {len(mahalanobis_differences)} identities.\"\n",
            ")\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 7. Corrected statistical interpretation\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n6. STATISTICAL INTERPRETATION\")\n",
            "\n",
            "tests = statistical_results.set_index(\"Detector\")\n",
            "\n",
            "euclidean_p = float(\n",
            "    tests.loc[\"Euclidean\", \"P-value\"]\n",
            ")\n",
            "\n",
            "mahalanobis_p = float(\n",
            "    tests.loc[\"Mahalanobis\", \"P-value\"]\n",
            ")\n",
            "\n",
            "alpha = 0.05\n",
            "\n",
            "print(f\"Euclidean Wilcoxon p-value: {euclidean_p:.6f}\")\n",
            "print(f\"Mahalanobis Wilcoxon p-value: {mahalanobis_p:.6f}\")\n",
            "\n",
            "print(\n",
            "    \"Euclidean result:\",\n",
            "    \"Statistically significant at 5%.\"\n",
            "    if euclidean_p < alpha\n",
            "    else \"Not statistically significant at 5%.\"\n",
            ")\n",
            "\n",
            "print(\n",
            "    \"Mahalanobis result:\",\n",
            "    \"Statistically significant at 5%.\"\n",
            "    if mahalanobis_p < alpha\n",
            "    else \"Not statistically significant at 5%.\"\n",
            ")\n",
            "\n",
            "print(\n",
            "    \"\\nBoth tests are exploratory and based on only \"\n",
            "    \"13 paired identity-level observations.\"\n",
            ")\n",
            "\n",
            "print(\n",
            "    \"No multiple-comparison correction has been applied.\"\n",
            ")\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 8. Comparative research findings\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n7. COMPARATIVE RESEARCH FINDINGS\")\n",
            "\n",
            "print(\n",
            "    \"The Euclidean detector recorded its largest aggregate \"\n",
            "    \"response under low illumination.\"\n",
            ")\n",
            "\n",
            "print(\n",
            "    \"The Mahalanobis detector recorded its largest aggregate \"\n",
            "    \"response under high illumination.\"\n",
            ")\n",
            "\n",
            "print(\n",
            "    \"The identity-level results demonstrate that detector \"\n",
            "    \"responses vary across identities.\"\n",
            ")\n",
            "\n",
            "print(\n",
            "    \"The larger estimated Mahalanobis effect size does not \"\n",
            "    \"establish general detector superiority.\"\n",
            ")\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 9. Scientific limitations\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n8. SCIENTIFIC LIMITATIONS\")\n",
            "\n",
            "limitations = [\n",
            "    \"The evaluation includes only 13 identities.\",\n",
            "    \"Identity-level sample counts are unequal.\",\n",
            "    \"The aggregate comparison covers three illumination conditions.\",\n",
            "    \"Both Wilcoxon tests are exploratory and based on 13 paired identities.\",\n",
            "    \"No multiple-comparison correction has been applied.\",\n",
            "    \"Bootstrap estimates are exploratory.\",\n",
            "    \"Controlled brightness transformations do not represent all natural lighting conditions.\",\n",
            "    \"Embedding displacement does not directly measure recognition accuracy.\",\n",
            "    \"The experiment does not establish demographic fairness.\",\n",
            "    \"The experiment does not establish operational drift-detection accuracy or false-alarm control.\"\n",
            "]\n",
            "\n",
            "for number, limitation in enumerate(limitations, start=1):\n",
            "    print(f\"{number}. {limitation}\")\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 10. Final numerical and consistency validation\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "numeric_values = aggregate_findings.select_dtypes(\n",
            "    include=[np.number]\n",
            ").to_numpy()\n",
            "\n",
            "assert np.isfinite(numeric_values).all()\n",
            "\n",
            "assert len(common_identities) == 13\n",
            "assert len(aggregate_findings) == 2\n",
            "assert len(identity_direction) == 2\n",
            "\n",
            "assert np.isfinite(euclidean_differences).all()\n",
            "assert np.isfinite(mahalanobis_differences).all()\n",
            "\n",
            "assert np.isclose(\n",
            "    euclidean_differences.mean(),\n",
            "    0.030051,\n",
            "    atol=1e-5\n",
            ")\n",
            "\n",
            "assert np.isclose(\n",
            "    mahalanobis_differences.mean(),\n",
            "    0.722682,\n",
            "    atol=1e-5\n",
            ")\n",
            "\n",
            "assert np.isclose(euclidean_p, 0.021484, atol=1e-5)\n",
            "assert np.isclose(mahalanobis_p, 0.002441, atol=1e-5)\n",
            "\n",
            "assert int((euclidean_differences > 0).sum()) == 10\n",
            "assert int((mahalanobis_differences > 0).sum()) == 11\n",
            "\n",
            "print(\"\\n\" + \"=\" * 70)\n",
            "print(\"STEP 17.9 COMPLETED SUCCESSFULLY\")\n",
            "print(\"Aggregate findings validated.\")\n",
