        "review_path = MANUSCRIPT_FILES[\"review_copy\"]\n",
        "\n",
        "if os.path.isfile(integrated_path) and os.path.isfile(review_path):\n",
        "\n",
        "    integrated_hash = sha256_file(integrated_path)\n",
        "    review_hash = sha256_file(review_path)\n",
        "\n",
        "    same_hash = integrated_hash == review_hash\n",
        "\n",
        "    print(\"Integrated manuscript SHA256:\", integrated_hash)\n",
        "    print(\"Review copy SHA256:\", review_hash)\n",
        "    print(\"Identical content:\", same_hash)\n",
        "\n",
        "else:\n",
        "    integrated_hash = None\n",
        "    review_hash = None\n",
        "    same_hash = None\n",
        "\n",
        "    print(\"Could not compare both manuscript files.\")\n",
        "\n",
        "\n",
