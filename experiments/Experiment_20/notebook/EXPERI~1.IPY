    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# EXPERIMENT 20 — STEP 3.3.10.4\n",
        "# CORRECTED AUDIT SAVE AND COMPLETION\n",
        "# ============================================================\n",
        "\n",
        "import json\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import hashlib\n",
        "from pathlib import Path\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "ROOT = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "FREEZE = ROOT / \"step_2_7\" / \"final_freeze\"\n",
        "\n",
        "OUT = ROOT / \"step_3_3\" / \"step_33104\"\n",
        "OUT.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "DISPLACEMENT_FILE = FREEZE / \"experiment20_reference_evaluation_displacement.csv\"\n",
        "GROUP_FILE = FREEZE / \"experiment20_illumination_group_descriptive_statistics.csv\"\n",
        "IDENTITY_FILE = FREEZE / \"experiment20_identity_level_group_means.csv\"\n",
        "DISPLACEMENT_AUDIT_FILE = FREEZE / \"experiment20_step272_displacement_audit.json\"\n",
        "\n",
        "AUDIT_PATH = OUT / \"experiment20_step33104_descriptive_statistics_verification.json\"\n",
        "\n",
        "print(\"=\" * 75)\n",
        "print(\"EXPERIMENT 20 — STEP 3.3.10.4\")\n",
        "print(\"CORRECTED AUDIT SAVE AND COMPLETION\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "# Load original frozen data.\n",
        "displacement = pd.read_csv(DISPLACEMENT_FILE)\n",
        "group_stats = pd.read_csv(GROUP_FILE)\n",
        "identity_means = pd.read_csv(IDENTITY_FILE)\n",
        "\n",
        "with open(DISPLACEMENT_AUDIT_FILE, \"r\", encoding=\"utf-8\") as f:\n",
        "    displacement_audit = json.load(f)\n",
        "\n",
        "# Recalculate overall statistics.\n",
        "overall = {}\n",
        "\n",
        "for column, label in [\n",
        "    (\"euclidean_displacement\", \"euclidean\"),\n",
        "    (\"cosine_distance\", \"cosine_distance\")\n",
        "]:\n",
        "    values = displacement[column].astype(float)\n",
        "\n",
        "    overall[label] = {\n",
        "        \"observations\": int(values.count()),\n",
        "        \"mean\": float(values.mean()),\n",
        "        \"median\": float(values.median()),\n",
        "        \"minimum\": float(values.min()),\n",
        "        \"maximum\": float(values.max()),\n",
        "        \"standard_deviation\": float(values.std(ddof=1))\n",
        "    }\n",
        "\n",
        "frozen = displacement_audit[\"displacement_summary\"]\n",
        "\n",
        "overall_checks = {\n",
        "    \"euclidean_mean_matches\": bool(np.isclose(\n",
        "        overall[\"euclidean\"][\"mean\"],\n",
        "        frozen[\"euclidean_mean\"], atol=1e-10\n",
        "    )),\n",
        "    \"euclidean_median_matches\": bool(np.isclose(\n",
        "        overall[\"euclidean\"][\"median\"],\n",
        "        frozen[\"euclidean_median\"], atol=1e-10\n",
        "    )),\n",
        "    \"cosine_mean_matches\": bool(np.isclose(\n",
        "        overall[\"cosine_distance\"][\"mean\"],\n",
        "        frozen[\"cosine_distance_mean\"], atol=1e-10\n",
        "    )),\n",
        "    \"cosine_median_matches\": bool(np.isclose(\n",
        "        overall[\"cosine_distance\"][\"median\"],\n",
        "        frozen[\"cosine_distance_median\"], atol=1e-10\n",
        "    ))\n",
        "}\n",
        "\n",
        "# Verify group observations and descriptive statistics.\n",
        "expected_groups = {\n",
        "    \"near_frontal\": 646,\n",
        "    \"oblique\": 418,\n",
        "    \"large_angular_deviation\": 1064\n",
        "}\n",
        "\n",
        "group_checks = {}\n",
        "group_means = {}\n",
        "\n",
        "for group, expected_count in expected_groups.items():\n",
        "\n",
        "    subset = displacement[\n",
        "        displacement[\"illumination_group\"] == group\n",
        "    ]\n",
        "\n",
        "    summary = group_stats[\n",
        "        group_stats[\"illumination_group\"] == group\n",
        "    ]\n",
        "\n",
        "    group_checks[f\"{group}_observation_count\"] = bool(\n",
        "        len(subset) == expected_count\n",
        "    )\n",
        "\n",
        "    group_checks[f\"{group}_identity_count\"] = bool(\n",
        "        subset[\"subject\"].nunique() == 38\n",
        "    )\n",
        "\n",
        "    group_checks[f\"{group}_summary_rows\"] = bool(\n",
        "        len(summary) == 2\n",
        "    )\n",
        "\n",
        "    group_means[group] = {\n",
        "        \"euclidean\": float(subset[\"euclidean_displacement\"].mean()),\n",
        "        \"cosine\": float(subset[\"cosine_distance\"].mean())\n",
        "    }\n",
        "\n",
        "    for metric, column in [\n",
        "        (\"euclidean\", \"euclidean_displacement\"),\n",
        "        (\"cosine\", \"cosine_distance\")\n",
        "    ]:\n",
        "\n",
        "        row = summary[summary[\"metric\"] == column]\n",
        "\n",
        "        group_checks[f\"{group}_{metric}_mean_matches\"] = bool(\n",
        "            len(row) == 1 and np.isclose(\n",
        "                subset[column].mean(),\n",
        "                row.iloc[0][\"mean\"],\n",
        "                atol=1e-10\n",
        "            )\n",
        "        )\n",
        "\n",
        "        group_checks[f\"{group}_{metric}_median_matches\"] = bool(\n",
        "            len(row) == 1 and np.isclose(\n",
        "                subset[column].median(),\n",
        "                row.iloc[0][\"median\"],\n",
        "                atol=1e-10\n",
        "            )\n",
        "        )\n",
        "\n",
        "# Verify identity-level means.\n",
        "identity_checks = {\n",
        "    \"114_identity_group_records\": bool(len(identity_means) == 114),\n",
        "    \"38_unique_identities\": bool(identity_means[\"subject\"].nunique() == 38),\n",
        "    \"three_records_per_identity\": bool(\n",
        "        identity_means.groupby(\"subject\").size().eq(3).all()\n",
        "    )\n",
        "}\n",
        "\n",
        "recalculated = (\n",
        "    displacement.groupby(\n",
        "        [\"subject\", \"illumination_group\"], as_index=False\n",
        "    )\n",
        "    .agg(\n",
        "        euclidean_mean=(\"euclidean_displacement\", \"mean\"),\n",
        "        cosine_mean=(\"cosine_distance\", \"mean\")\n",
        "    )\n",
        ")\n",
        "\n",
        "merged = identity_means.merge(\n",
        "    recalculated,\n",
        "    on=[\"subject\", \"illumination_group\"],\n",
        "    suffixes=(\"_frozen\", \"_recalculated\"),\n",
        "    validate=\"one_to_one\"\n",
        ")\n",
        "\n",
        "identity_checks[\"euclidean_identity_means_match\"] = bool(\n",
        "    np.allclose(\n",
        "        merged[\"euclidean_mean_frozen\"],\n",
        "        merged[\"euclidean_mean_recalculated\"],\n",
        "        atol=1e-10\n",
        "    )\n",
        ")\n",
        "\n",
        "identity_checks[\"cosine_identity_means_match\"] = bool(\n",
        "    np.allclose(\n",
        "        merged[\"cosine_mean_frozen\"],\n",
        "        merged[\"cosine_mean_recalculated\"],\n",
        "        atol=1e-10\n",
        "    )\n",
        ")\n",
        "\n",
        "# Verify increasing group ordering.\n",
        "ordering_checks = {\n",
        "    \"euclidean_progressive_ordering\": bool(\n",
        "        group_means[\"near_frontal\"][\"euclidean\"]\n",
        "        < group_means[\"oblique\"][\"euclidean\"]\n",
        "        < group_means[\"large_angular_deviation\"][\"euclidean\"]\n",
        "    ),\n",
        "    \"cosine_progressive_ordering\": bool(\n",
        "        group_means[\"near_frontal\"][\"cosine\"]\n",
        "        < group_means[\"oblique\"][\"cosine\"]\n",
        "        < group_means[\"large_angular_deviation\"][\"cosine\"]\n",
        "    )\n",
        "}\n",
        "\n",
        "# Verify hashes.\n",
        "source_hashes = {}\n",
        "\n",
        "for path in [\n",
        "    DISPLACEMENT_FILE,\n",
        "    GROUP_FILE,\n",
        "    IDENTITY_FILE,\n",
        "    DISPLACEMENT_AUDIT_FILE\n",
        "]:\n",
        "    source_hashes[path.name] = hashlib.sha256(\n",
        "        path.read_bytes()\n",
        "    ).hexdigest()\n",
        "\n",
        "# Assemble audit using standard Python types.\n",
        "checks = {}\n",
        "checks.update(overall_checks)\n",
        "checks.update(group_checks)\n",
        "checks.update(identity_checks)\n",
        "checks.update(ordering_checks)\n",
        "\n",
        "passed = sum(bool(value) for value in checks.values())\n",
        "failed = len(checks) - passed\n",
        "\n",
        "audit = {\n",
        "    \"experiment\": 20,\n",
        "    \"step\": \"3.3.10.4\",\n",
        "    \"timestamp_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "    \"overall_statistics\": overall,\n",
        "    \"group_means\": group_means,\n",
        "    \"group_observation_counts\": expected_groups,\n",
        "    \"checks\": checks,\n",
        "    \"passed_checks\": int(passed),\n",
        "    \"failed_checks\": int(failed),\n",
        "    \"source_sha256\": source_hashes,\n",
        "    \"status\": (\n",
        "        \"DESCRIPTIVE_STATISTICS_VERIFIED\"\n",
        "        if failed == 0 else \"REQUIRES_REVIEW\"\n",
        "    )\n",
        "}\n",
        "\n",
        "# Save audit.\n",
        "with open(AUDIT_PATH, \"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(audit, f, indent=4, allow_nan=False)\n",
        "\n",
        "# Reload saved audit to verify serialization and persistence.\n",
        "with open(AUDIT_PATH, \"r\", encoding=\"utf-8\") as f:\n",
        "    reloaded = json.load(f)\n",
        "\n",
        "print(\"\\n[1] CHECK RESULTS\")\n",
        "for name, result in checks.items():\n",
        "    print(f\"{name}: {'PASS' if result else 'FAIL'}\")\n",
        "\n",
        "print(\"\\n[2] SUMMARY\")\n",
        "print(\"Passed:\", passed)\n",
        "print(\"Failed:\", failed)\n",
        "print(\"Saved audit reload:\", \"PASS\" if reloaded[\"status\"] == audit[\"status\"] else \"FAIL\")\n",
        "print(\"Status:\", audit[\"status\"])\n",
        "print(\"Audit path:\", AUDIT_PATH)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 75)\n",
        "print(\"STEP 3.3.10.4 COMPLETED\")\n",
        "print(\"=\" * 75)"
      ],
