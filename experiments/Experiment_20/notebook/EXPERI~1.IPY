        "\n",
        "os.makedirs(FIGURE_OUTPUT_DIR, exist_ok=True)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. FIGURE DEFINITIONS AND EXPECTED HASHES\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "FIGURES = [\n",
        "    {\n",
        "        \"number\": 1,\n",
        "        \"filename\": \"experiment20_figure1_euclidean_illumination_groups.png\",\n",
        "        \"expected_sha256\": \"71623f613dc8202cf5cf6ff7bea005b315e4a31de73841d064c896b24e565b16\",\n",
        "        \"alt\": \"Identity-level Euclidean displacement across near-frontal, oblique, and large-angular-deviation illumination groups.\",\n",
        "        \"caption\": (\n",
        "            \"*Figure 1. Identity-level Euclidean displacement across illumination \"\n",
        "            \"geometry groups. Thin lines represent the mean displacement for each \"\n",
        "            \"of the 38 identities within each group; the thick olive line represents \"\n",
        "            \"the mean across identities.*\"\n",
        "        )\n",
        "    },\n",
        "    {\n",
        "        \"number\": 2,\n",
        "        \"filename\": \"experiment20_figure2_cosine_illumination_groups.png\",\n",
        "        \"expected_sha256\": \"de22ee98a909ef099199f5b49911633497c2c890d9d903224131f95db54c917c\",\n",
        "        \"alt\": \"Identity-level cosine distance across near-frontal, oblique, and large-angular-deviation illumination groups.\",\n",
        "        \"caption\": (\n",
        "            \"*Figure 2. Identity-level cosine distance across illumination geometry \"\n",
        "            \"groups. Thin lines represent the mean distance for each of the 38 \"\n",
        "            \"identities within each group; the thick olive line represents the mean \"\n",
        "            \"across identities.*\"\n",
        "        )\n",
        "    },\n",
        "    {\n",
        "        \"number\": 3,\n",
        "        \"filename\": \"experiment20_figure3_euclidean_hemisphere_comparison.png\",\n",
        "        \"expected_sha256\": \"5a55b8947698a35dd20a258a4d185b927a64ccdac4a4b18d8aad4bd6d35fc0c6\",\n",
        "        \"alt\": \"Paired identity-level Euclidean displacement for frontal and beyond-frontal illumination hemispheres.\",\n",
        "        \"caption\": (\n",
        "            \"*Figure 3. Paired identity-level Euclidean displacement by illumination \"\n",
        "            \"hemisphere. Each thin line connects the frontal and beyond-frontal \"\n",
        "            \"mean displacement for one identity; the thick olive line represents \"\n",
        "            \"the mean across the 38 identities. This comparison is exploratory.*\"\n",
        "        )\n",
        "    },\n",
        "    {\n",
        "        \"number\": 4,\n",
        "        \"filename\": \"experiment20_figure4_cosine_hemisphere_comparison.png\",\n",
        "        \"expected_sha256\": \"0a06e0a5458ec2779aee94778f59fd576e585f8fc85fdd3e82afb6c91211851c\",\n",
        "        \"alt\": \"Paired identity-level cosine distance for frontal and beyond-frontal illumination hemispheres.\",\n",
        "        \"caption\": (\n",
        "            \"*Figure 4. Paired identity-level cosine distance by illumination \"\n",
        "            \"hemisphere. Each thin line connects the frontal and beyond-frontal \"\n",
        "            \"mean distance for one identity; the thick olive line represents \"\n",
        "            \"the mean across the 38 identities. This comparison is exploratory.*\"\n",
        "        )\n",
        "    }\n",
        "]\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. HASH FUNCTION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def sha256_file(path):\n",
        "    h = hashlib.sha256()\n",
        "\n",
        "    with open(path, \"rb\") as f:\n",
        "        for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n",
        "            h.update(chunk)\n",
        "\n",
        "    return h.hexdigest()\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. VERIFY SOURCE MANUSCRIPT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "if not os.path.isfile(SOURCE_MANUSCRIPT):\n",
        "    raise FileNotFoundError(SOURCE_MANUSCRIPT)\n",
        "\n",
        "source_hash_before = sha256_file(SOURCE_MANUSCRIPT)\n",
        "\n",
        "with open(SOURCE_MANUSCRIPT, \"r\", encoding=\"utf-8\") as f:\n",
        "    manuscript = f.read()\n",
        "\n",
        "original_manuscript = manuscript\n",
        "\n",
        "print(\"=\" * 100)\n",
        "print(\"STEP 3.3.30 — FIGURE INTEGRATION\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "print(\"Source manuscript SHA256:\", source_hash_before)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. COPY AND VERIFY FROZEN FIGURES\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "figure_copy_results = {}\n",
        "\n",
        "for figure in FIGURES:\n",
        "\n",
        "    source_path = os.path.join(\n",
        "        FROZEN_FIGURE_DIR,\n",
        "        figure[\"filename\"]\n",
        "    )\n",
        "\n",
        "    destination_path = os.path.join(\n",
        "        FIGURE_OUTPUT_DIR,\n",
        "        figure[\"filename\"]\n",
        "    )\n",
        "\n",
        "    if not os.path.isfile(source_path):\n",
        "        raise FileNotFoundError(source_path)\n",
        "\n",
        "    source_hash = sha256_file(source_path)\n",
        "\n",
        "    if source_hash != figure[\"expected_sha256\"]:\n",
        "        raise ValueError(\n",
        "            f\"Frozen figure hash mismatch: {figure['filename']}\"\n",
        "        )\n",
        "\n",
        "    shutil.copy2(source_path, destination_path)\n",
        "\n",
        "    copied_hash = sha256_file(destination_path)\n",
        "\n",
        "    if copied_hash != source_hash:\n",
        "        raise ValueError(\n",
        "            f\"Copied figure hash mismatch: {figure['filename']}\"\n",
        "        )\n",
        "\n",
        "    figure_copy_results[figure[\"number\"]] = {\n",
        "        \"filename\": figure[\"filename\"],\n",
        "        \"source_path\": source_path,\n",
        "        \"destination_path\": destination_path,\n",
        "        \"source_sha256\": source_hash,\n",
        "        \"copied_sha256\": copied_hash,\n",
        "        \"hash_verified\": True\n",
        "    }\n",
        "\n",
        "    print(\n",
        "        f\"Figure {figure['number']}: copied and verified | \"\n",
        "        f\"SHA256={copied_hash}\"\n",
        "    )\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. ADD IN-TEXT REFERENCES\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "ANCHORS = {\n",
        "    \"group_results\": (\n",
        "        \"Mean cosine distance followed the same ordering, increasing \"\n",
        "        \"from 0.086877 to 0.262274 and 0.649095, respectively.\"\n",
        "    ),\n",
        "    \"hemisphere_euclidean\": (\n",
        "        \"The mean paired difference (beyond-frontal minus frontal) was \"\n",
        "        \"0.581770 (95% bootstrap CI: [0.561986, 0.601954]; \"\n",
        "        \"Holm-adjusted p = 1.455e-11).\"\n",
        "    ),\n",
        "    \"hemisphere_cosine\": (\n",
        "        \"The mean paired difference was 0.542807 \"\n",
        "        \"(95% bootstrap CI: [0.516419, 0.568516]; \"\n",
        "        \"Holm-adjusted p = 1.455e-11).\"\n",
        "    )\n",
        "}\n",
        "\n",
        "for name, anchor in ANCHORS.items():\n",
        "\n",
        "    count = manuscript.count(anchor)\n",
        "\n",
        "    if count != 1:\n",
        "        raise ValueError(\n",
        "            f\"Expected exactly one occurrence of anchor '{name}', found {count}\"\n",
        "        )\n",
        "\n",
        "manuscript = manuscript.replace(\n",
        "    ANCHORS[\"group_results\"],\n",
        "    ANCHORS[\"group_results\"] + \" The identity-level patterns are shown in Figures 1 and 2.\"\n",
        ")\n",
        "\n",
        "manuscript = manuscript.replace(\n",
        "    ANCHORS[\"hemisphere_euclidean\"],\n",
        "    ANCHORS[\"hemisphere_euclidean\"] + \" (Figure 3).\"\n",
        ")\n",
        "\n",
        "manuscript = manuscript.replace(\n",
        "    ANCHORS[\"hemisphere_cosine\"],\n",
        "    ANCHORS[\"hemisphere_cosine\"] + \" (Figure 4).\"\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. BUILD FIGURE MARKDOWN BLOCKS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def figure_block(figure):\n",
        "\n",
        "    relative_path = \"figures/\" + figure[\"filename\"]\n",
        "\n",
        "    return (\n",
        "        f\"![{figure['alt']}]({relative_path})\\n\\n\"\n",
        "        f\"{figure['caption']}\\n\"\n",
        "    )\n",
        "\n",
        "\n",
        "group_figure_block = (\n",
        "    figure_block(FIGURES[0])\n",
        "    + \"\\n\"\n",
        "    + figure_block(FIGURES[1])\n",
        ")\n",
        "\n",
        "hemisphere_figure_block = (\n",
        "    figure_block(FIGURES[2])\n",
        "    + \"\\n\"\n",
        "    + figure_block(FIGURES[3])\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. INSERT FIGURES AT VERIFIED LOCATIONS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "TABLE1_END = (\n",
        "    \"| Large-angular deviation | 1064 | 38 | 28 | 1.1185 | \"\n",
        "    \"0.2175 | 0.6491 | 0.2388 |\"\n",
        ")\n",
        "\n",
        "SECTION_34 = \"## 3.4 Identity-level repeated-measures analysis\"\n",
        "\n",
        "if manuscript.count(TABLE1_END) != 1:\n",
        "    raise ValueError(\"Table 1 ending anchor not unique.\")\n",
        "\n",
        "if manuscript.count(SECTION_34) != 1:\n",
        "    raise ValueError(\"Section 3.4 heading not unique.\")\n",
        "\n",
        "# Insert group figures after Table 1.\n",
        "manuscript = manuscript.replace(\n",
        "    TABLE1_END + \"\\n\\n\\n\" + SECTION_34,\n",
        "    TABLE1_END\n",
        "    + \"\\n\\n\\n\"\n",
        "    + group_figure_block\n",
        "    + \"\\n\\n\"\n",
        "    + SECTION_34\n",
        ")\n",
        "\n",
        "# Insert hemisphere figures after the two hemisphere result paragraphs,\n",
        "# before the exploratory interpretation limitation.\n",
        "HEMISPHERE_LIMITATION = (\n",
        "    \"This comparison is exploratory. The frontal and beyond-frontal \"\n",
        "    \"categories contained unequal numbers of illumination conditions, \"\n",
        "    \"and hemisphere membership is related to angular illumination \"\n",
        "    \"geometry. Therefore, the observed differences should not be \"\n",
        "    \"interpreted as an isolated causal effect of hemisphere direction.\"\n",
        ")\n",
        "\n",
        "if manuscript.count(HEMISPHERE_LIMITATION) != 1:\n",
        "    raise ValueError(\"Hemisphere limitation anchor not unique.\")\n",
        "\n",
        "manuscript = manuscript.replace(\n",
        "    HEMISPHERE_LIMITATION,\n",
        "    hemisphere_figure_block + \"\\n\\n\" + HEMISPHERE_LIMITATION\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 8. VALIDATE INTEGRATION BEFORE SAVING\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "for figure in FIGURES:\n",
        "\n",
        "    relative_path = \"figures/\" + figure[\"filename\"]\n",
        "\n",
        "    if manuscript.count(relative_path) != 1:\n",
        "        raise ValueError(\n",
        "            f\"Figure reference missing or duplicated: {relative_path}\"\n",
        "        )\n",
        "\n",
        "for number in range(1, 5):\n",
        "\n",
        "    if not re.search(\n",
        "        rf\"\\bFigure {number}\\b\",\n",
        "        manuscript\n",
        "    ):\n",
        "        raise ValueError(\n",
        "            f\"In-text Figure {number} reference missing.\"\n",
        "        )\n",
        "\n",
        "if manuscript == original_manuscript:\n",
        "    raise ValueError(\"Manuscript was not changed by integration process.\")\n",
        "\n",
        "# Ensure all original sections remain present.\n",
        "required_headings = [\n",
        "    \"# 3. Results\",\n",
        "    \"## 3.3 Displacement across illumination geometry groups\",\n",
        "    \"## 3.4 Identity-level repeated-measures analysis\",\n",
        "    \"## 3.5 Exploratory frontal and beyond-frontal comparison\",\n",
        "    \"## 3.6 Summary of findings\",\n",
        "    \"# 4. Discussion\",\n",
        "    \"# References\"\n",
        "]\n",
        "\n",
        "for heading in required_headings:\n",
        "    if heading not in manuscript:\n",
        "        raise ValueError(f\"Original heading missing: {heading}\")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 9. WRITE NEW MANUSCRIPT VERSION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "if os.path.exists(OUTPUT_MANUSCRIPT):\n",
        "    raise FileExistsError(\n",
        "        \"Output manuscript already exists. Refusing to overwrite.\"\n",
        "    )\n",
        "\n",
        "with open(OUTPUT_MANUSCRIPT, \"w\", encoding=\"utf-8\") as f:\n",
        "    f.write(manuscript)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 10. FINAL INTEGRITY CHECKS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "source_hash_after = sha256_file(SOURCE_MANUSCRIPT)\n",
        "new_manuscript_hash = sha256_file(OUTPUT_MANUSCRIPT)\n",
        "\n",
        "if source_hash_before != source_hash_after:\n",
        "    raise RuntimeError(\"Original manuscript hash changed.\")\n",
        "\n",
        "if not all(\n",
        "    item[\"hash_verified\"]\n",
        "    for item in figure_copy_results.values()\n",
        "):\n",
        "    raise RuntimeError(\"One or more copied figure hashes failed.\")\n",
        "\n",
        "with open(OUTPUT_MANUSCRIPT, \"r\", encoding=\"utf-8\") as f:\n",
        "    final_text = f.read()\n",
        "\n",
        "image_embed_count = len(\n",
        "    re.findall(r\"!\\[.*?\\]\\(figures/.*?\\.png\\)\", final_text)\n",
        ")\n",
        "\n",
        "if image_embed_count != 4:\n",
        "    raise RuntimeError(\n",
        "        f\"Expected four image embeds, found {image_embed_count}\"\n",
        "    )\n",
        "\n",
        "report = {\n",
        "    \"step\": \"3.3.30\",\n",
        "    \"title\": \"Figure Integration into New Manuscript Version\",\n",
        "    \"created_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "\n",
        "    \"source_manuscript\": {\n",
        "        \"path\": SOURCE_MANUSCRIPT,\n",
        "        \"sha256_before\": source_hash_before,\n",
        "        \"sha256_after\": source_hash_after,\n",
        "        \"unchanged\": source_hash_before == source_hash_after\n",
        "    },\n",
        "\n",
        "    \"new_manuscript\": {\n",
        "        \"path\": OUTPUT_MANUSCRIPT,\n",
        "        \"sha256\": new_manuscript_hash,\n",
        "        \"size_bytes\": os.path.getsize(OUTPUT_MANUSCRIPT),\n",
        "        \"word_count\": len(final_text.split()),\n",
        "        \"figure_embed_count\": image_embed_count\n",
        "    },\n",
        "\n",
        "    \"figure_copies\": figure_copy_results,\n",
        "\n",
        "    \"integration\": {\n",
        "        \"figures_1_and_2_after_table_1\": True,\n",
        "        \"figures_3_and_4_after_hemisphere_results\": True,\n",
        "        \"in_text_references_added\": True,\n",
        "        \"captions_added\": True,\n",
        "        \"original_sections_preserved\": True\n",
        "    },\n",
        "\n",
        "    \"integrity\": {\n",
        "        \"original_manuscript_modified\": False,\n",
        "        \"frozen_figures_modified\": False,\n",
        "        \"frozen_results_modified\": False,\n",
        "        \"new_manuscript_created\": True,\n",
        "        \"new_figure_copies_created\": True\n",
        "    },\n",
        "\n",
        "    \"status\": \"FIGURES_INTEGRATED_NEW_MANUSCRIPT_VERSION_CREATED\"\n",
        "}\n",
        "\n",
        "with open(REPORT_PATH, \"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(report, f, indent=2)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"FINAL INTEGRATION REPORT\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "print(\"New manuscript:\", OUTPUT_MANUSCRIPT)\n",
        "print(\"New manuscript SHA256:\", new_manuscript_hash)\n",
        "print(\"Word count:\", len(final_text.split()))\n",
        "print(\"Image embeds:\", image_embed_count)\n",
        "\n",
        "print(\"\\nFigure copies:\")\n",
        "for number, item in figure_copy_results.items():\n",
        "    print(\n",
        "        f\"Figure {number}:\",\n",
        "        item[\"filename\"],\n",
        "        \"| Hash verified:\",\n",
        "        item[\"hash_verified\"]\n",
        "    )\n",
        "\n",
        "print(\"\\nOriginal manuscript unchanged:\", source_hash_before == source_hash_after)\n",
        "print(\"Frozen figures unchanged: True\")\n",
        "print(\"Status:\", report[\"status\"])\n",
        "print(\"Report:\", REPORT_PATH)\n",
        "print(\"Report SHA256:\", sha256_file(REPORT_PATH))\n",
        "\n",
        "print(\"\\nNo existing manuscript or frozen evidence was modified.\")\n",
        "print(\"STEP 3.3.30 COMPLETED\")"
      ],
