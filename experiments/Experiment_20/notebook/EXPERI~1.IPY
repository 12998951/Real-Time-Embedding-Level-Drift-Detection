n\",\"24:         \\\"large_angular_deviation\\\": {\\n\",\"25:             \\\"conditions\\\": 28,\\n\",\"26:             \\\"observations\\\": 1064,\\n\",\"\\n\",\"----------------------------------------------------------------------------------------\\n\",\"FILE: /content/drive/MyDrive/Experiment_20_Results/step_2_7/final_freeze/experiment20_final_results_report.md\\n\",\"MATCHES: 2\\n\",\"\\n\",\"19: | Near-frontal | 17 | 646 | 0.401897 | 0.086877 |\\n\",\"20: | Oblique | 11 | 418 | 0.708976 | 0.262274 |\\n\",\"21: | Large angular deviation | 28 | 1,064 | 1.118457 | 0.649095 |\\n\",\"22: \\n\",\"23: ## Repeated-measures analysis\\n\",\"\\n\",\"55: \\n\",\"56: Embedding displacement increased across near-frontal, oblique,\\n\",\"57: and large-angular-deviation illumination groups.\\n\",\"58: \\n\",\"59: These findings establish an association in this dataset. They do not\\n\",\"\\n\",\"----------------------------------------------------------------------------------------\\n\",\"FILE: /content/drive/MyDrive/Experiment_20_Results/step_3_1/experiment20_step316_methodological_risk_register.json\\n\",\"MATCHES: 1\\n\",\"\\n\",\"132:       \\\"id\\\": \\\"M09\\\",\\n\",\"133:       \\\"area\\\": \\\"Lighting geometry\\\",\\n\",\"134:       \\\"finding\\\": \\\"Illumination groups represent angular deviation of light direction.\\\",\\n\",\"135:       \\\"evidence\\\": [\\n\",\"136:         \\\"Lighting geometry grouping audit\\\",\\n\",\"\\n\",\"----------------------------------------------------------------------------------------\\n\",\"FILE: /content/drive/MyDrive/Experiment_20_Results/step_3_2/experiment20_step322_closest_study_comparison.json\\n\",\"MATCHES: 1\\n\",\"\\n\",\"37:       \\\"url\\\": \\\"https://doi.org/10.1109/TPAMI.2008.200\\\",\\n\",\"38:       \\\"dataset\\\": \\\"Yale Face Database B and CMU-PIE\\\",\\n\",\"39:       \\\"method\\\": \\\"Illumination subspaces and principal angles\\\",\\n\",\"40:       \\\"evaluation\\\": \\\"Matching subject image sets\\\",\\n\",\"41:       \\\"overlap\\\": \\\"Identity-specific illumination variation and geometric analysis\\\",\\n\",\"\\n\",\"----------------------------------------------------------------------------------------\\n\",\"FILE: /content/drive/MyDrive/Experiment_20_Results/step_3_2/experiment20_step323_expanded_prior_art_assessment.json\\n\",\"MATCHES: 2\\n\",\"\\n\",\"17:       ],\\n\",\"18:       \\\"embedding_model\\\": \\\"Pretrained FaceNet\\\",\\n\",\"19:       \\\"illumination_grouping\\\": \\\"Five light-angle subsets\\\",\\n\",\"20:       \\\"method\\\": \\\"Probabilistic illumination enhancement, FaceNet feature extraction and SVM classification\\\",\\n\",\"21:       \\\"primary_outcome\\\": \\\"Recognition accuracy\\\",\\n\",\"\\n\",\"32:       \\\"subjects\\\": \\\"10 Yale B subjects in frontal-pose analysis\\\",\\n\",\"33:       \\\"embedding_model\\\": \\\"Handcrafted ELDP representation\\\",\\n\",\"34:       \\\"illumination_grouping\\\": \\\"Six subsets based on light-source angle\\\",\\n\",\"35:       \\\"method\\\": \\\"Pairwise L2 distances and within-subject / between-subject evaluation\\\",\\n\",\"36:       \\\"primary_outcome\\\": \\\"Recognition accuracy and distance-based discrimination criterion\\\",\\n\",\"\\n\",\"----------------------------------------------------------------------------------------\\n\",\"FILE: /content/drive/MyDrive/Experiment_20_Results/step_3_2/experiment20_step3213_mediapipe_pilot_sample_manifest.json\\n\",\"MATCHES: 90\\n\",\"\\n\",\"19:       \\\"subject\\\": \\\"yaleB01\\\",\\n\",\"20:       \\\"condition\\\": \\\"A-005E-10\\\",\\n\",\"21:       \\\"azimuth\\\": -5,\\n\",\"22:       \\\"elevation\\\": -10,\\n\",\"23:       \\\"theta_degrees\\\": 11.168952812354922,\\n\",\"\\n\",\"20:       \\\"condition\\\": \\\"A-005E-10\\\",\\n\",\"21:       \\\"azimuth\\\": -5,\\n\",\"22:       \\\"elevation\\\": -10,\\n\",\"23:       \\\"theta_degrees\\\": 11.168952812354922,\\n\",\"24:       \\\"illumination_group\\\": \\\"near_frontal\\\"\\n\",\"\\n\",\"21:       \\\"azimuth\\\": -5,\\n\",\"22:       \\\"elevation\\\": -10,\\n\",\"23:       \\\"theta_degrees\\\": 11.168952812354922,\\n\",\"24:       \\\"illumination_group\\\": \\\"near_frontal\\\"\\n\",\"25:     },\\n\",\"\\n\",\"28:       \\\"subject\\\": \\\"yaleB16\\\",\\n\",\"29:       \\\"condition\\\": \\\"A+010E-20\\\",\\n\",\"30:       \\\"azimuth\\\": 10,\\n\",\"31:       \\\"elevation\\\": -20,\\n\",\"32:       \\\"theta_degrees\\\": 22.268744495296882,\\n\",\"\\n\",\"29:       \\\"condition\\\": \\\"A+010E-20\\\",\\n\",\"30:       \\\"azimuth\\\": 10,\\n\",\"31:       \\\"elevation\\\": -20,\\n\",\"32:       \\\"theta_degrees\\\": 22.268744495296882,\\n\",\"33:       \\\"illumination_group\\\": \\\"near_frontal\\\"\\n\",\"\\n\",\"30:       \\\"azimuth\\\": 10,\\n\",\"31:       \\\"elevation\\\": -20,\\n\",\"32:       \\\"theta_degrees\\\": 22.268744495296882,\\n\",\"33:       \\\"illumination_group\\\": \\\"near_frontal\\\"\\n\",\"34:     },\\n\",\"\\n\",\"37:       \\\"subject\\\": \\\"yaleB06\\\",\\n\",\"38:       \\\"condition\\\": \\\"A+010E+00\\\",\\n\",\"39:       \\\"azimuth\\\": 10,\\n\",\"40:       \\\"elevation\\\": 0,\\n\",\"41:       \\\"theta_degrees\\\": 10.000000000000012,\\n\",\"\\n\",\"38:       \\\"condition\\\": \\\"A+010E+00\\\",\\n\",\"39:       \\\"azimuth\\\": 10,\\n\",\"40:       \\\"elevation\\\": 0,\\n\",\"41:       \\\"theta_degrees\\\": 10.000000000000012,\\n\",\"42:       \\\"illumination_group\\\": \\\"near_frontal\\\"\\n\",\"\\n\",\"39:       \\\"azimuth\\\": 10,\\n\",\"40:       \\\"elevation\\\": 0,\\n\",\"41:       \\\"theta_degrees\\\": 10.000000000000012,\\n\",\"42:       \\\"illumination_group\\\": \\\"near_frontal\\\"\\n\",\"43:     },\\n\",\"\\n\",\"46:       \\\"subject\\\": \\\"yaleB25\\\",\\n\",\"47:       \\\"condition\\\": \\\"A-005E+10\\\",\\n\",\"48:       \\\"azimuth\\\": -5,\\n\",\"49:       \\\"elevation\\\": 10,\\n\",\"50:       \\\"theta_degrees\\\": 11.168952812354922,\\n\",\"\\n\",\"47:       \\\"condition\\\": \\\"A-005E+10\\\",\\n\",\"48:       \\\"azimuth\\\": -5,\\n\",\"49:       \\\"elevation\\\": 10,\\n\",\"50:       \\\"theta_degrees\\\": 11.168952812354922,\\n\",\"51:       \\\"illumination_group\\\": \\\"near_frontal\\\"\\n\",\"\\n\",\"48:       \\\"azimuth\\\": -5,\\n\",\"49:       \\\"elevation\\\": 10,\\n\",\"50:       \\\"theta_degrees\\\": 11.168952812354922,\\n\",\"51:       \\\"illumination_group\\\": \\\"near_frontal\\\"\\n\",\"52:     },\\n\",\"\\n\",\"Additional matches omitted from display.\\n\",\"\\n\",\"----------------------------------------------------------------------------------------\\n\",\"FILE: /content/drive/MyDrive/Experiment_20_Results/step_3_2/experiment20_step3216_mediapipe_detection_pilot.json\\n\",\"MATCHES: 90\\n\",\"\\n\",\"36:       \\\"subject\\\": \\\"yaleB01\\\",\\n\",\"37:       \\\"condition\\\": \\\"A-005E-10\\\",\\n\",\"38:       \\\"azimuth\\\": -5,\\n\",\"39:       \\\"elevation\\\": -10,\\n\",\"40:       \\\"theta_degrees\\\": 11.168952812354922,\\n\",\"\\n\",\"37:       \\\"condition\\\": \\\"A-005E-10\\\",\\n\",\"38:       \\\"azimuth\\\": -5,\\n\",\"39:       \\\"elevation\\\": -10,\\n\",\"40:       \\\"theta_degrees\\\": 11.168952812354922,\\n\",\"41:       \\\"illumination_group\\\": \\\"near_frontal\\\",\\n\",\"\\n\",\"38:       \\\"azimuth\\\": -5,\\n\",\"39:       \\\"elevation\\\": -10,\\n\",\"40:       \\\"theta_degrees\\\": 11.168952812354922,\\n\",\"41:       \\\"illumination_group\\\": \\\"near_frontal\\\",\\n\",\"42:       \\\"processing_status\\\": \\\"PROCESSED\\\",\\n\",\"\\n\",\"52:       \\\"subject\\\": \\\"yaleB16\\\",\\n\",\"53:       \\\"condition\\\": \\\"A+010E-20\\\",\\n\",\"54:       \\\"azimuth\\\": 10,\\n\",\"55:       \\\"elevation\\\": -20,\\n\",\"56:       \\\"theta_degrees\\\": 22.268744495296882,\\n\",\"\\n\",\"53:       \\\"condition\\\": \\\"A+010E-20\\\",\\n\",\"54:       \\\"azimuth\\\": 10,\\n\",\"55:       \\\"elevation\\\": -20,\\n\",\"56:       \\\"theta_degrees\\\": 22.268744495296882,\\n\",\"57:       \\\"illumination_group\\\": \\\"near_frontal\\\",\\n\",\"\\n\",\"54:       \\\"azimuth\\\": 10,\\n\",\"55:       \\\"elevation\\\": -20,\\n\",\"56:       \\\"theta_degrees\\\": 22.268744495296882,\\n\",\"57:       \\\"illumination_group\\\": \\\"near_frontal\\\",\\n\",\"58:       \\\"processing_status\\\": \\\"PROCESSED\\\",\\n\",\"\\n\",\"68:       \\\"subject\\\": \\\"yaleB06\\\",\\n\",\"69:       \\\"condition\\\": \\\"A+010E+00\\\",\\n\",\"70:       \\\"azimuth\\\": 10,\\n\",\"71:       \\\"elevation\\\": 0,\\n\",\"72:       \\\"theta_degrees\\\": 10.000000000000012,\\n\",\"\\n\",\"69:       \\\"condition\\\": \\\"A+010E+00\\\",\\n\",\"70:       \\\"azimuth\\\": 10,\\n\",\"71:       \\\"elevation\\\": 0,\\n\",\"72:       \\\"theta_degrees\\\": 10.000000000000012,\\n\",\"73:       \\\"illumination_group\\\": \\\"near_frontal\\\",\\n\",\"\\n\",\"70:       \\\"azimuth\\\": 10,\\n\",\"71:       \\\"elevation\\\": 0,\\n\",\"72:       \\\"theta_degrees\\\": 10.000000000000012,\\n\",\"73:       \\\"illumination_group\\\": \\\"near_frontal\\\",\\n\",\"74:       \\\"processing_status\\\": \\\"PROCESSED\\\",\\n\",\"\\n\",\"85:       \\\"subject\\\": \\\"yaleB25\\\",\\n\",\"86:       \\\"condition\\\": \\\"A-005E+10\\\",\\n\",\"87:       \\\"azimuth\\\": -5,\\n\",\"88:       \\\"elevation\\\": 10,\\n\",\"89:       \\\"theta_degrees\\\": 11.168952812354922,\\n\",\"\\n\",\"86:       \\\"condition\\\": \\\"A-005E+10\\\",\\n\",\"87:       \\\"azimuth\\\": -5,\\n\",\"88:       \\\"elevation\\\": 10,\\n\",\"89:       \\\"theta_degrees\\\": 11.168952812354922,\\n\",\"90:       \\\"illumination_group\\\": \\\"near_frontal\\\",\\n\",\"\\n\",\"87:       \\\"azimuth\\\": -5,\\n\",\"88:       \\\"elevation\\\": 10,\\n\",\"89:       \\\"theta_degrees\\\": 11.168952812354922,\\n\",\"90:       \\\"illumination_group\\\": \\\"near_frontal\\\",\\n\",\"91:       \\\"processing_status\\\": \\\"PROCESSED\\\",\\n\",\"\\n\",\"Additional matches omitted from display.\\n\",\"\\n\",\"----------------------------------------------------------------------------------------\\n\",\"FILE: /content/drive/MyDrive/Experiment_20_Results/step_3_2/experiment20_step3219_publication_strategy_decision.json\\n\",\"MATCHES: 1\\n\",\"\\n\",\"18:       \\\"Near-frontal\\\",\\n\",\"19:       \\\"Oblique\\\",\\n\",\"20:       \\\"Large angular deviation\\\"\\n\",\"21:     ],\\n\",\"22:     \\\"statistical_analysis\\\": [\\n\",\"\\n\",\"----------------------------------------------------------------------------------------\\n\",\"FILE: /content/drive/MyDrive/Experiment_20_Results/step_3_3/experiment20_step3362_introduction_illumination_context.json\\n\",\"MATCHES: 1\\n\",\"\\n\",\"4:   \\\"step\\\": \\\"3.3.6.2\\\",\\n\",\"5:   \\\"heading\\\": \\\"Illumination Variation and Its Effect on Facial Representations\\\",\\n\",\"6:   \\\"draft\\\": \\\"Illumination variation is a longstanding challenge in face-recognition research. Changes in the direction of incident light can produce substantial differences in facial appearance, affecting the distribution of shadows, highlights, and visible facial details. These variations can occur even when the images represent the same individual. Earlier research by Moses, Adini, and Ullman (1994) specifically examined the problem of compensating for changes in illumination direction in face recognition.\\\\n\\\\nSubsequent research has investigated the relationship between illumination and facial appearance using different analytical approaches. Beveridge et al. (2009) examined subject illumination spaces and the role of principal angles in distinguishing them. Other studies have explored illumination preprocessing and methods intended to reduce the effects of lighting variation on face recognition (Han et al., 2013; Ochoa-Villegas et al., 2015). Research using Yale B datasets has also considered illumination conditions according to the angular position of light sources, demonstrating the relevance of illumination geometry in controlled face-image analysis.\\\\n\\\\nDeep face-recognition models represent facial images through learned feature embeddings. Changes in facial appearance may therefore be accompanied by changes in embedding-space position. However, the magnitude and consistency of such changes depend on the model, the input images, and the conditions under which the representations are evaluated. An observed embedding displacement should consequently be interpreted as a change in representation rather than direct evidence of incorrect identity recognition.\\\\n\\\\nIn the present study, illumination conditions are grouped according to their angular geometry relative to a common reference condition. Three groups are considered: near-frontal illumination, oblique illumination, and large-angular-deviation illumination. These categories provide a structured basis for comparing reference-relative embedding displacement across different lighting directions. They represent angular geometry rather than illumination intensity.\\\\n\\\\nThis distinction is important because the experiment uses different captures of the same individuals under different illumination conditions. The images are identity-matched observations, not exact transformations of identical source images. Therefore, the resulting differences in embedding space are examined as reference-relative associations with illumination geometry, rather than as effects attributable exclusively to illumination.\\\",\\n\",\"7:   \\\"word_count\\\": 328,\\n\",\"8:   \\\"supporting_references\\\": [\\n\",\"\\n\",\"----------------------------------------------------------------------------------------\\n\",\"FILE: /content/drive/MyDrive/Experiment_20_Results/step_3_3/step_337/experiment20_consolidated_introduction.md\\n\",\"MATCHES: 2\\n\",\"\\n\",\"18: Illumination variation is a longstanding challenge in face-recognition research. Changes in the direction of incident light can produce substantial differences in facial appearance, affecting the distribution of shadows, highlights, and visible facial details. These variations can occur even when the images represent the same individual. Earlier research by Moses, Adini, and Ullman (1994) specifically examined the problem of compensating for changes in illumination direction in face recognition.\\n\",\"19: \\n\",\"20: Subsequent research has investigated the relationship between illumination and facial appearance using different analytical approaches. Beveridge et al. (2009) examined subject illumination spaces and the role of principal angles in distinguishing them. Other studies have explored illumination preprocessing and methods intended to reduce the effects of lighting variation on face recognition (Han et al., 2013; Ochoa-Villegas et al., 2015). Research using Yale B datasets has also considered illumination conditions according to the angular position of light sources, demonstrating the relevance of illumination geometry in controlled face-image analysis.\\n\",\"21: \\n\",\"22: Deep face-recognition models represent facial images through learned feature embeddings. Changes in facial appearance may therefore be accompanied by changes in embedding-space position. However, the magnitude and consistency of such changes depend on the model, the input images, and the conditions under which the representations are evaluated. An observed embedding displacement should consequently be interpreted as a change in representation rather than direct evidence of incorrect identity recognition.\\n\",\"\\n\",\"22: Deep face-recognition models represent facial images through learned feature embeddings. Changes in facial appearance may therefore be accompanied by changes in embedding-space position. However, the magnitude and consistency of such changes depend on the model, the input images, and the conditions under which the representations are evaluated. An observed embedding displacement should consequently be interpreted as a change in representation rather than direct evidence of incorrect identity recognition.\\n\",\"23: \\n\",\"24: In the present study, illumination conditions are grouped according to their angular geometry relative to a common reference condition. Three groups are considered: near-frontal illumination, oblique illumination, and large-angular-deviation illumination. These categories provide a structured basis for comparing reference-relative embedding displacement across different lighting directions. They represent angular geometry rather than illumination intensity.\\n\",\"25: \\n\",\"26: This distinction is important because the experiment uses different captures of the same individuals under different illumination conditions. The images are identity-matched observations, not exact transformations of identical source images. Therefore, the resulting differences in embedding space are examined as reference-relative associations with illumination geometry, rather than as effects attributable exclusively to illumination.\\n\",\"\\n\",\"----------------------------------------------------------------------------------------\\n\",\"FILE: /content/drive/MyDrive/Experiment_20_Results/step_3_3/step_337/experiment20_consolidated_introduction.json\\n\",\"MATCHES: 1\\n\",\"\\n\",\"4:   \\\"step\\\": \\\"3.3.7\\\",\\n\",\"5:   \\\"title\\\": \\\"Reference-Relative Face Embedding Displacement Across Illumination Geometry Conditions: An Identity-Level Empirical Study\\\",\\n\",\"6:   \\\"introduction_markdown\\\": \\\"# 1. Introduction\\\\n\\\\n\\\\n## 1.1 Background: Face Recognition and Deep Face Embeddings\\\\n\\\\nFace recognition systems increasingly use deep learning models to represent facial images as numerical feature vectors, commonly referred to as face embeddings. These representations encode facial characteristics in a high-dimensional feature space, where distances or similarities between embeddings can be used to examine relationships between facial images.\\\\n\\\\nThe geometry of this embedding space is relevant to face-recognition research because changes in an input image may be reflected in the position of its corresponding representation. Consequently, comparing embeddings can provide a way to examine how image variations are associated with changes in learned facial representations.\\\\n\\\\nA particularly important source of image variation is illumination. Changes in lighting direction and intensity can alter the appearance of facial regions, producing differences between images of the same individual. The effects of illumination on face recognition have been investigated in earlier research, including work examining changes in illumination direction (Moses, Adini, and Ullman, 1994).\\\\n\\\\nIn this context, examining reference-relative embedding displacement provides an empirical way to describe how the representations of different captures of an individual vary relative to a selected reference capture. The present study applies this approach to a fixed pretrained InceptionResnetV1 model and examines Euclidean displacement and cosine distance across groups of illumination conditions.\\\\n\\\\nThis investigation focuses on the geometry of the resulting embeddings. It does not, by itself, establish whether a face-recognition system correctly identifies individuals under those conditions.\\\\n\\\\n## 1.2 Illumination Variation and Its Effect on Facial Representations\\\\n\\\\nIllumination variation is a longstanding challenge in face-recognition research. Changes in the direction of incident light can produce substantial differences in facial appearance, affecting the distribution of shadows, highlights, and visible facial details. These variations can occur even when the images represent the same individual. Earlier research by Moses, Adini, and Ullman (1994) specifically examined the problem of compensating for changes in illumination direction in face recognition.\\\\n\\\\nSubsequent research has investigated the relationship between illumination and facial appearance using different analytical approaches. Beveridge et al. (2009) examined subject illumination spaces and the role of principal angles in distinguishing them. Other studies have explored illumination preprocessing and methods intended to reduce the effects of lighting variation on face recognition (Han et al., 2013; Ochoa-Villegas et al., 2015). Research using Yale B datasets has also considered illumination conditions according to the angular position of light sources, demonstrating the relevance of illumination geometry in controlled face-image analysis.\\\\n\\\\nDeep face-recognition models represent facial images through learned feature embeddings. Changes in facial appearance may therefore be accompanied by changes in embedding-space position. However, the magnitude and consistency of such changes depend on the model, the input images, and the conditions under which the representations are evaluated. An observed embedding displacement should consequently be interpreted as a change in representation rather than direct evidence of incorrect identity recognition.\\\\n\\\\nIn the present study, illumination conditions are grouped according to their angular geometry relative to a common reference condition. Three groups are considered: near-frontal illumination, oblique illumination, and large-angular-deviation illumination. These categories provide a structured basis for comparing reference-relative embedding displacement across different lighting directions. They represent angular geometry rather than illumination intensity.\\\\n\\\\nThis distinction is important because the experiment uses different captures of the same individuals under different illumination conditions. The images are identity-matched observations, not exact transformations of identical source images. Therefore, the resulting differences in embedding space are examined as reference-relative associations with illumination geometry, rather than as effects attributable exclusively to illumination.\\\\n\\\\n## 1.3 Research Gap and Motivation\\\\n\\\\nExisting research has examined the effects of illumination variation on face recognition through several approaches, including illumination preprocessing, feature representation, subject-specific illumination spaces, and recognition-performance evaluation. Studies using Yale B and Extended Yale B datasets have also investigated changes in facial representations under different lighting directions. More recent work has explored deep face-recognition architectures and the geometric properties of learned embedding spaces.\\\\n\\\\nDespite this established body of research, there remains a need for focused empirical characterisation of how reference-relative embedding displacement varies across illumination geometry conditions at the individual-identity level within a fixed pretrained face-recognition model. In particular, comparing multiple distance measures relative to a common reference capture provides a structured way to examine whether displacement patterns differ across illumination groups and whether these differences are consistent across identities.\\\\n\\\\nThis study addresses that specific empirical question using a fixed pretrained InceptionResnetV1 model and the Cropped Extended Yale B dataset. Rather than developing an illumination-invariant representation or evaluating identity-classification performance, the investigation examines Euclidean displacement and cosine distance between identity-specific reference embeddings and embeddings from other captures of the same individuals.\\\\n\\\\nThe motivation is to provide a transparent, identity-level description of embedding-space variation across defined illumination geometry conditions. By examining both observation-level distributions and repeated-measures differences across identities, the study seeks to characterise the consistency and magnitude of reference-relative displacement within the evaluated dataset.\\\\n\\\\nThe resulting analysis is deliberately descriptive. Because the evaluation uses different image captures rather than exact transformations of identical source images, observed embedding differences cannot be attributed exclusively to illumination. The findings are also specific to the selected dataset, preprocessing procedure, and pretrained model. Accordingly, the study is intended to contribute a focused empirical characterisation rather than a general claim about all face-recognition systems.\\\\n\\\\n## 1.4 Research Questions and Objectives\\\\n\\\\nBased on the identified research gap, this study investigates how reference-relative face embedding displacement varies across illumination geometry conditions and how consistently these differences are observed across individual identities. The investigation is guided by the following research questions:\\\\n\\\\nRQ1: How do Euclidean embedding displacement and cosine distance vary across near-frontal, oblique, and large-angular illumination conditions?\\\\n\\\\nRQ2: Are the differences between illumination geometry groups consistent across evaluated identities?\\\\n\\\\nRQ3: How do reference-relative embedding displacement patterns differ between frontal and beyond-frontal illumination conditions?\\\\n\\\\nTo address these questions, the study has five objectives:\\\\n\\\\n1. To generate and examine fixed pretrained face embeddings for identity-matched captures under different illumination conditions.\\\\n2. To quantify reference-relative embedding displacement using Euclidean distance and cosine distance.\\\\n3. To classify common illumination conditions into near-frontal, oblique, and large-angular geometry groups.\\\\n4. To compare displacement measurements across illumination groups using identity-level repeated-measures statistical analysis.\\\\n5. To explore differences between frontal and beyond-frontal illumination conditions while accounting for the unequal number of evaluated conditions.\\\\n\\\\nThe first two research questions form the primary analytical focus of the study. The third question provides an additional exploratory examination of illumination geometry. The statistical hypotheses associated with these comparisons were formulated after the experimental analyses and are therefore treated as retrospective analytical expectations rather than preregistered hypotheses.\\\\n\\\\n## 1.5 Study Contributions and Scope\\\\n\\\\nThis study makes four empirical contributions.\\\\n\\\\nFirst, it provides an identity-level characterisation of reference-relative face embedding displacement across three illumination geometry groups: near-frontal, oblique, and large-angular conditions. The analysis examines how the magnitude of displacement varies across individual identities within the evaluated dataset.\\\\n\\\\nSecond, it compares two complementary embedding-space distance measures: Euclidean displacement and cosine distance. Using both measures provides a broader descriptive examination of changes in embedding representations relative to an identity-specific reference capture.\\\\n\\\\nThird, it applies repeated-measures statistical analysis to examine differences between the three illumination geometry groups across the evaluated identities. This analysis considers both the magnitude of group differences and the consistency of their ordering across identities.\\\\n\\\\nFourth, it provides an exploratory comparison of frontal and beyond-frontal illumination conditions, examining whether reference-relative displacement differs between these broader geometric categories.\\\\n\\\\nThe scope of the study is deliberately limited. The evaluation uses the Cropped Extended Yale B dataset, comprising 38 identities and 2,414 standard-illumination images, and a fixed pretrained InceptionResnetV1 model. Of the 2,414 standard-illumination images, 2,166 observations belong to the 57 common illumination conditions. After excluding the reference condition, 2,128 non-reference observations across 56 evaluation conditions are included in the displacement analysis. Each identity is represented by one reference capture, against which embeddings from other captures are compared. The evaluation therefore examines different identity-matched captures rather than exact transformations of identical source images.\\\\n\\\\nThe study does not evaluate face-recognition accuracy, develop an illumination-invariant representation, establish operational drift-detection capability, or validate generalisation across independent recognition architectures. Its findings should be interpreted as an empirical characterisation of reference-relative embedding displacement under the specific dataset, preprocessing procedure, and model used in this investigation.\\\\n\\\",\\n\",\"7:   \\\"section_count\\\": 5,\\n\",\"8:   \\\"word_count\\\": 1368,\\n\",\"\\n\",\"----------------------------------------------------------------------------------------\\n\",\"FILE: /content/drive/MyDrive/Experiment_20_Results/step_3_3/step_338/experiment20_step338_citation_verification_audit.json\\n\",\"MATCHES: 1\\n\",\"\\n\",\"48:       \\\"url\\\": \\\"https://doi.org/10.1109/TPAMI.2008.200\\\",\\n\",\"49:       \\\"bibliographic_status\\\": \\\"VERIFIED\\\",\\n\",\"50:       \\\"claim_support\\\": \\\"SUPPORTED_FOR_ILLUMINATION_SUBSPACES_AND_PRINCIPAL_ANGLES\\\",\\n\",\"51:       \\\"supported_claims\\\": [\\n\",\"52:         \\\"Subject-specific illumination subspaces have been studied.\\\",\\n\",\"\\n\",\"----------------------------------------------------------------------------------------\\n\",\"FILE: /content/drive/MyDrive/Experiment_20_Results/step_3_3/step_338/experiment20_step3381_angular_grouping_literature_audit.json\\n\",\"MATCHES: 14\\n\",\"\\n\",\"20:     \\\"url\\\": \\\"https://doi.org/10.1049/iet-cvi.2014.0086\\\",\\n\",\"21:     \\\"source_type\\\": \\\"Peer-reviewed survey\\\",\\n\",\"22:     \\\"finding\\\": \\\"Yale Face Database B illumination conditions are described as divided into five subsets according to the angle between the light-source direction and camera axis.\\\",\\n\",\"23:     \\\"reported_angular_subsets\\\": [\\n\",\"24:       {\\n\",\"\\n\",\"24:       {\\n\",\"25:         \\\"subset\\\": \\\"S1\\\",\\n\",\"26:         \\\"lower_degrees\\\": 0,\\n\",\"27:         \\\"upper_degrees\\\": 12\\n\",\"28:       },\\n\",\"\\n\",\"25:         \\\"subset\\\": \\\"S1\\\",\\n\",\"26:         \\\"lower_degrees\\\": 0,\\n\",\"27:         \\\"upper_degrees\\\": 12\\n\",\"28:       },\\n\",\"29:       {\\n\",\"\\n\",\"29:       {\\n\",\"30:         \\\"subset\\\": \\\"S2\\\",\\n\",\"31:         \\\"lower_degrees\\\": 13,\\n\",\"32:         \\\"upper_degrees\\\": 25\\n\",\"33:       },\\n\",\"\\n\",\"30:         \\\"subset\\\": \\\"S2\\\",\\n\",\"31:         \\\"lower_degrees\\\": 13,\\n\",\"32:         \\\"upper_degrees\\\": 25\\n\",\"33:       },\\n\",\"34:       {\\n\",\"\\n\",\"34:       {\\n\",\"35:         \\\"subset\\\": \\\"S3\\\",\\n\",\"36:         \\\"lower_degrees\\\": 26,\\n\",\"37:         \\\"upper_degrees\\\": 50\\n\",\"38:       },\\n\",\"\\n\",\"35:         \\\"subset\\\": \\\"S3\\\",\\n\",\"36:         \\\"lower_degrees\\\": 26,\\n\",\"37:         \\\"upper_degrees\\\": 50\\n\",\"38:       },\\n\",\"39:       {\\n\",\"\\n\",\"39:       {\\n\",\"40:         \\\"subset\\\": \\\"S4\\\",\\n\",\"41:         \\\"lower_degrees\\\": 51,\\n\",\"42:         \\\"upper_degrees\\\": 77\\n\",\"43:       },\\n\",\"\\n\",\"40:         \\\"subset\\\": \\\"S4\\\",\\n\",\"41:         \\\"lower_degrees\\\": 51,\\n\",\"42:         \\\"upper_degrees\\\": 77\\n\",\"43:       },\\n\",\"44:       {\\n\",\"\\n\",\"44:       {\\n\",\"45:         \\\"subset\\\": \\\"S5\\\",\\n\",\"46:         \\\"lower_degrees\\\": 78,\\n\",\"47:         \\\"upper_degrees\\\": null\\n\",\"48:       }\\n\",\"\\n\",\"45:         \\\"subset\\\": \\\"S5\\\",\\n\",\"46:         \\\"lower_degrees\\\": 78,\\n\",\"47:         \\\"upper_degrees\\\": null\\n\",\"48:       }\\n\",\"49:     ],\\n\",\"\\n\",\"55:     {\\n\",\"56:       \\\"group\\\": \\\"near_frontal\\\",\\n\",\"57:       \\\"definition\\\": \\\"theta <= 30 degrees\\\"\\n\",\"58:     },\\n\",\"59:     {\\n\",\"\\n\",\"Additional matches omitted from display.\\n\",\"\\n\",\"----------------------------------------------------------------------------------------\\n\",\"FILE: /content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3382/experiment20_consolidated_introduction_v2.md\\n\",\"MATCHES: 2\\n\",\"\\n\",\"18: Illumination variation is a longstanding challenge in face-recognition research. Changes in the direction of incident light can produce substantial differences in facial appearance, affecting the distribution of shadows, highlights, and visible facial details. These variations can occur even when the images represent the same individual. Earlier research by Moses, Adini, and Ullman (1994) specifically examined the problem of compensating for changes in illumination direction in face recognition.\\n\",\"19: \\n\",\"20: Subsequent research has investigated the relationship between illumination and facial appearance using different analytical approaches. Beveridge et al. (2009) examined subject illumination spaces and the role of principal angles in distinguishing them. Other studies have explored illumination preprocessing and methods intended to reduce the effects of lighting variation on face recognition (Han et al., 2013; Ochoa-Villegas et al., 2015). Research using Yale Face Database B has also classified illumination conditions according to the angle between the light-source direction and camera axis. Ochoa-Villegas et al. (2015) describe five angular subsets: 0°–12°, 13°–25°, 26°–50°, 51°–77°, and above 77°. This provides precedent for angular grouping in illumination studies. The present study adopts a different three-group classification, with near-frontal conditions defined as θ ≤ 30°, oblique conditions as 30° < θ ≤ 60°, and large-angular-deviation conditions as θ > 60°. These thresholds represent the analytical grouping adopted in Experiment 20 and are not the same as the five subsets reported in the survey.\\n\",\"21: \\n\",\"22: Deep face-recognition models represent facial images through learned feature embeddings. Changes in facial appearance may therefore be accompanied by changes in embedding-space position. However, the magnitude and consistency of such changes depend on the model, the input images, and the conditions under which the representations are evaluated. An observed embedding displacement should consequently be interpreted as a change in representation rather than direct evidence of incorrect identity recognition.\\n\",\"\\n\",\"22: Deep face-recognition models represent facial images through learned feature embeddings. Changes in facial appearance may therefore be accompanied by changes in embedding-space position. However, the magnitude and consistency of such changes depend on the model, the input images, and the conditions under which the representations are evaluated. An observed embedding displacement should consequently be interpreted as a change in representation rather than direct evidence of incorrect identity recognition.\\n\",\"23: \\n\",\"24: In the present study, illumination conditions are grouped according to their angular geometry relative to a common reference condition. Three groups are considered: near-frontal illumination, oblique illumination, and large-angular-deviation illumination. These categories provide a structured basis for comparing reference-relative embedding displacement across different lighting directions. They represent angular geometry rather than illumination intensity.\\n\",\"25: \\n\",\"26: This distinction is important because the experiment uses different captures of the same individuals under different illumination conditions. The images are identity-matched observations, not exact transformations of identical source images. Therefore, the resulting differences in embedding space are examined as reference-relative associations with illumination geometry, rather than as effects attributable exclusively to illumination.\\n\",\"\\n\",\"----------------------------------------------------------------------------------------\\n\",\"FILE: /content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3382/experiment20_consolidated_introduction_v2.json\\n\",\"MATCHES: 1\\n\",\"\\n\",\"4:   \\\"step\\\": \\\"3.3.7\\\",\\n\",\"5:   \\\"title\\\": \\\"Reference-Relative Face Embedding Displacement Across Illumination Geometry Conditions: An Identity-Level Empirical Study\\\",\\n\",\"6:   \\\"introduction_markdown\\\": \\\"# 1. Introduction\\\\n\\\\n\\\\n## 1.1 Background: Face Recognition and Deep Face Embeddings\\\\n\\\\nFace recognition systems increasingly use deep learning models to represent facial images as numerical feature vectors, commonly referred to as face embeddings. These representations encode facial characteristics in a high-dimensional feature space, where distances or similarities between embeddings can be used to examine relationships between facial images.\\\\n\\\\nThe geometry of this embedding space is relevant to face-recognition research because changes in an input image may be reflected in the position of its corresponding representation. Consequently, comparing embeddings can provide a way to examine how image variations are associated with changes in learned facial representations.\\\\n\\\\nA particularly important source of image variation is illumination. Changes in lighting direction and intensity can alter the appearance of facial regions, producing differences between images of the same individual. The effects of illumination on face recognition have been investigated in earlier research, including work examining changes in illumination direction (Moses, Adini, and Ullman, 1994).\\\\n\\\\nIn this context, examining reference-relative embedding displacement provides an empirical way to describe how the representations of different captures of an individual vary relative to a selected reference capture. The present study applies this approach to a fixed pretrained InceptionResnetV1 model and examines Euclidean displacement and cosine distance across groups of illumination conditions.\\\\n\\\\nThis investigation focuses on the geometry of the resulting embeddings. It does not, by itself, establish whether a face-recognition system correctly identifies individuals under those conditions.\\\\n\\\\n## 1.2 Illumination Variation and Its Effect on Facial Representations\\\\n\\\\nIllumination variation is a longstanding challenge in face-recognition research. Changes in the direction of incident light can produce substantial differences in facial appearance, affecting the distribution of shadows, highlights, and visible facial details. These variations can occur even when the images represent the same individual. Earlier research by Moses, Adini, and Ullman (1994) specifically examined the problem of compensating for changes in illumination direction in face recognition.\\\\n\\\\nSubsequent research has investigated the relationship between illumination and facial appearance using different analytical approaches. Beveridge et al. (2009) examined subject illumination spaces and the role of principal angles in distinguishing them. Other studies have explored illumination preprocessing and methods intended to reduce the effects of lighting variation on face recognition (Han et al., 2013; Ochoa-Villegas et al., 2015). Research using Yale Face Database B has also classified illumination conditions according to the angle between the light-source direction and camera axis. Ochoa-Villegas et al. (2015) describe five angular subsets: 0°–12°, 13°–25°, 26°–50°, 51°–77°, and above 77°. This provides precedent for angular grouping in illumination studies. The present study adopts a different three-group classification, with near-frontal conditions defined as θ ≤ 30°, oblique conditions as 30° < θ ≤ 60°, and large-angular-deviation conditions as θ > 60°. These thresholds represent the analytical grouping adopted in Experiment 20 and are not the same as the five subsets reported in the survey.\\\\n\\\\nDeep face-recognition models represent facial images through learned feature embeddings. Changes in facial appearance may therefore be accompanied by changes in embedding-space position. However, the magnitude and consistency of such changes depend on the model, the input images, and the conditions under which the representations are evaluated. An observed embedding displacement should consequently be interpreted as a change in representation rather than direct evidence of incorrect identity recognition.\\\\n\\\\nIn the present study, illumination conditions are grouped according to their angular geometry relative to a common reference condition. Three groups are considered: near-frontal illumination, oblique illumination, and large-angular-deviation illumination. These categories provide a structured basis for comparing reference-relative embedding displacement across different lighting directions. They represent angular geometry rather than illumination intensity.\\\\n\\\\nThis distinction is important because the experiment uses different captures of the same individuals under different illumination conditions. The images are identity-matched observations, not exact transformations of identical source images. Therefore, the resulting differences in embedding space are examined as reference-relative associations with illumination geometry, rather than as effects attributable exclusively to illumination.\\\\n\\\\n## 1.3 Research Gap and Motivation\\\\n\\\\nExisting research has examined the effects of illumination variation on face recognition through several approaches, including illumination preprocessing, feature representation, subject-specific illumination spaces, and recognition-performance evaluation. Studies using Yale B and Extended Yale B datasets have also investigated changes in facial representations under different lighting directions. More recent work has explored deep face-recognition architectures and the geometric properties of learned embedding spaces.\\\\n\\\\nDespite this established body of research, there remains a need for focused empirical characterisation of how reference-relative embedding displacement varies across illumination geometry conditions at the individual-identity level within a fixed pretrained face-recognition model. In particular, comparing multiple distance measures relative to a common reference capture provides a structured way to examine whether displacement patterns differ across illumination groups and whether these differences are consistent across identities.\\\\n\\\\nThis study addresses that specific empirical question using a fixed pretrained InceptionResnetV1 model and the Cropped Extended Yale B dataset. Rather than developing an illumination-invariant representation or evaluating identity-classification performance, the investigation examines Euclidean displacement and cosine distance between identity-specific reference embeddings and embeddings from other captures of the same individuals.\\\\n\\\\nThe motivation is to provide a transparent, identity-level description of embedding-space variation across defined illumination geometry conditions. By examining both observation-level distributions and repeated-measures differences across identities, the study seeks to characterise the consistency and magnitude of reference-relative displacement within the evaluated dataset.\\\\n\\\\nThe resulting analysis is deliberately descriptive. Because the evaluation uses different image captures rather than exact transformations of identical source images, observed embedding differences cannot be attributed exclusively to illumination. The findings are also specific to the selected dataset, preprocessing procedure, and pretrained model. Accordingly, the study is intended to contribute a focused empirical characterisation rather than a general claim about all face-recognition systems.\\\\n\\\\n## 1.4 Research Questions and Objectives\\\\n\\\\nBased on the identified research gap, this study investigates how reference-relative face embedding displacement varies across illumination geometry conditions and how consistently these differences are observed across individual identities. The investigation is guided by the following research questions:\\\\n\\\\nRQ1: How do Euclidean embedding displacement and cosine distance vary across near-frontal, oblique, and large-angular illumination conditions?\\\\n\\\\nRQ2: Are the differences between illumination geometry groups consistent across evaluated identities?\\\\n\\\\nRQ3: How do reference-relative embedding displacement patterns differ between frontal and beyond-frontal illumination conditions?\\\\n\\\\nTo address these questions, the study has five objectives:\\\\n\\\\n1. To generate and examine fixed pretrained face embeddings for identity-matched captures under different illumination conditions.\\\\n2. To quantify reference-relative embedding displacement using Euclidean distance and cosine distance.\\\\n3. To classify common illumination conditions into near-frontal, oblique, and large-angular geometry groups.\\\\n4. To compare displacement measurements across illumination groups using identity-level repeated-measures statistical analysis.\\\\n5. To explore differences between frontal and beyond-frontal illumination conditions while accounting for the unequal number of evaluated conditions.\\\\n\\\\nThe first two research questions form the primary analytical focus of the study. The third question provides an additional exploratory examination of illumination geometry. The statistical hypotheses associated with these comparisons were formulated after the experimental analyses and are therefore treated as retrospective analytical expectations rather than preregistered hypotheses.\\\\n\\\\n## 1.5 Study Contributions and Scope\\\\n\\\\nThis study makes four empirical contributions.\\\\n\\\\nFirst, it provides an identity-level characterisation of reference-relative face embedding displacement across three illumination geometry groups: near-frontal, oblique, and large-angular conditions. The analysis examines how the magnitude of displacement varies across individual identities within the evaluated dataset.\\\\n\\\\nSecond, it compares two complementary embedding-space distance measures: Euclidean displacement and cosine distance. Using both measures provides a broader descriptive examination of changes in embedding representations relative to an identity-specific reference capture.\\\\n\\\\nThird, it applies repeated-measures statistical analysis to examine differences between the three illumination geometry groups across the evaluated identities. This analysis considers both the magnitude of group differences and the consistency of their ordering across identities.\\\\n\\\\nFourth, it provides an exploratory comparison of frontal and beyond-frontal illumination conditions, examining whether reference-relative displacement differs between these broader geometric categories.\\\\n\\\\nThe scope of the study is deliberately limited. The evaluation uses the Cropped Extended Yale B dataset, comprising 38 identities and 2,414 standard-illumination images, and a fixed pretrained InceptionResnetV1 model. Of the 2,414 standard-illumination images, 2,166 observations belong to the 57 common illumination conditions. After excluding the reference condition, 2,128 non-reference observations across 56 evaluation conditions are included in the displacement analysis. Each identity is represented by one reference capture, against which embeddings from other captures are compared. The evaluation therefore examines different identity-matched captures rather than exact transformations of identical source images.\\\\n\\\\nThe study does not evaluate face-recognition accuracy, develop an illumination-invariant representation, establish operational drift-detection capability, or validate generalisation across independent recognition architectures. Its findings should be interpreted as an empirical characterisation of reference-relative embedding displacement under the specific dataset, preprocessing procedure, and model used in this investigation.\\\\n\\\",\\n\",\"7:   \\\"section_count\\\": 5,\\n\",\"8:   \\\"word_count\\\": 1440,\\n\",\"\\n\",\"----------------------------------------------------------------------------------------\\n\",\"FILE: /content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3384/experiment20_consolidated_introduction_apa7_corrected.md\\n\",\"MATCHES: 2\\n\",\"\\n\",\"18: Illumination variation is a longstanding challenge in face-recognition research. Changes in the direction of incident light can produce substantial differences in facial appearance, affecting the distribution of shadows, highlights, and visible facial details. These variations can occur even when the images represent the same individual. Earlier research by Moses et al. (1994) specifically examined the problem of compensating for changes in illumination direction in face recognition.\\n\",\"19: \\n\",\"20: Subsequent research has investigated the relationship between illumination and facial appearance using different analytical approaches. Beveridge et al. (2009) examined subject illumination spaces and the role of principal angles in distinguishing them. Other studies have explored illumination preprocessing and methods intended to reduce the effects of lighting variation on face recognition (Han et al., 2013; Ochoa-Villegas et al., 2015). Research using Yale Face Database B has also classified illumination conditions according to the angle between the light-source direction and camera axis. Ochoa-Villegas et al. (2015) describe five angular subsets: 0°–12°, 13°–25°, 26°–50°, 51°–77°, and above 77°. This provides precedent for angular grouping in illumination studies. The present study adopts a different three-group classification, with near-frontal conditions defined as θ ≤ 30°, oblique conditions as 30° < θ ≤ 60°, and large-angular-deviation conditions as θ > 60°. These thresholds represent the analytical grouping adopted in Experiment 20 and are not the same as the five subsets reported in the survey.\\n\",\"21: \\n\",\"22: Deep face-recognition models represent facial images through learned feature embeddings. Changes in facial appearance may therefore be accompanied by changes in embedding-space position. However, the magnitude and consistency of such changes depend on the model, the input images, and the conditions under which the representations are evaluated. An observed embedding displacement should consequently be interpreted as a change in representation rather than direct evidence of incorrect identity recognition.\\n\",\"\\n\",\"22: Deep face-recognition models represent facial images through learned feature embeddings. Changes in facial appearance may therefore be accompanied by changes in embedding-space position. However, the magnitude and consistency of such changes depend on the model, the input images, and the conditions under which the representations are evaluated. An observed embedding displacement should consequently be interpreted as a change in representation rather than direct evidence of incorrect identity recognition.\\n\",\"23: \\n\",\"24: In the present study, illumination conditions are grouped according to their angular geometry relative to a common reference condition. Three groups are considered: near-frontal illumination, oblique illumination, and large-angular-deviation illumination. These categories provide a structured basis for comparing reference-relative embedding displacement across different lighting directions. They represent angular geometry rather than illumination intensity.\\n\",\"25: \\n\",\"26: This distinction is important because the experiment uses different captures of the same individuals under different illumination conditions. The images are identity-matched observations, not exact transformations of identical source images. Therefore, the resulting differences in embedding space are examined as reference-relative associations with illumination geometry, rather than as effects attributable exclusively to illumination.\\n\",\"\\n\",\"----------------------------------------------------------------------------------------\\n\",\"FILE: /content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3391/experiment20_methodology_3_1_research_design.md\\n\",\"MATCHES: 1\\n\",\"\\n\",\"5: The evaluation used the Cropped Extended Yale B dataset, comprising 2,414 standard-illumination images from 38 identities. A common-condition selection procedure identified 57 illumination conditions represented across all 38 identities, yielding 2,166 identity-condition observations. One observation per identity corresponded to the designated reference condition, A+000E+00. These 38 reference observations were used to establish the identity-specific reference embeddings. After excluding the reference condition, the primary evaluation comprised 2,128 non-reference observations across 56 illumination conditions.\\n\",\"6: \\n\",\"7: The primary unit of observation was an identity-condition pair, while identity served as the repeated-measures unit for group-level statistical comparisons. This structure allowed displacement measurements from the same 38 identities to be examined across near-frontal, oblique, and large-angular-deviation illumination groups. The observations represent identity-condition-matched captures under different illumination conditions; they are not pairs produced by applying controlled transformations to identical source images.\\n\",\"8: \\n\",\"9: The analysis was conducted using 512-dimensional embeddings generated by a fixed pretrained InceptionResnetV1 model with VGGFace2 weights. Each evaluation embedding was compared with the corresponding identity's reference embedding. Euclidean displacement and cosine distance were then summarised across illumination geometry groups and examined using identity-level repeated-measures statistical procedures.\\n\",\"\\n\",\"----------------------------------------------------------------------------------------\\n\",\"FILE: /content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3391/experiment20_step3391_research_design.json\\n\",\"MATCHES: 1\\n\",\"\\n\",\"6:   \\\"created_utc\\\": \\\"2026-11-11T10:33:04.260935+00:00\\\",\\n\",\"7:   \\\"research_design\\\": \\\"Descriptive empirical analysis\\\",\\n\",\"8:   \\\"draft_text\\\": \\\"Experiment 20 employed a descriptive empirical design to examine reference-relative displacement in deep face-recognition embeddings across illumination geometry conditions. The analysis focused on the extent to which the embedding representation of an identity's facial image differed from that identity's embedding under a designated reference illumination condition. Rather than developing or evaluating an operational drift-detection algorithm, the experiment characterised these differences using two distance measures: Euclidean displacement and cosine distance.\\\\n\\\\nThe evaluation used the Cropped Extended Yale B dataset, comprising 2,414 standard-illumination images from 38 identities. A common-condition selection procedure identified 57 illumination conditions represented across all 38 identities, yielding 2,166 identity-condition observations. One observation per identity corresponded to the designated reference condition, A+000E+00. These 38 reference observations were used to establish the identity-specific reference embeddings. After excluding the reference condition, the primary evaluation comprised 2,128 non-reference observations across 56 illumination conditions.\\\\n\\\\nThe primary unit of observation was an identity-condition pair, while identity served as the repeated-measures unit for group-level statistical comparisons. This structure allowed displacement measurements from the same 38 identities to be examined across near-frontal, oblique, and large-angular-deviation illumination groups. The observations represent identity-condition-matched captures under different illumination conditions; they are not pairs produced by applying controlled transformations to identical source images.\\\\n\\\\nThe analysis was conducted using 512-dimensional embeddings generated by a fixed pretrained InceptionResnetV1 model with VGGFace2 weights. Each evaluation embedding was compared with the corresponding identity's reference embedding. Euclidean displacement and cosine distance were then summarised across illumination geometry groups and examined using identity-level repeated-measures statistical procedures.\\\\n\\\\nThe study was intentionally restricted to descriptive embedding-space analysis. It did not estimate calibrated detection thresholds, operational false-alarm rates, or recognition accuracy. It also did not evaluate an independent face-recognition architecture. Consequently, the results characterise reference-relative embedding displacement within the selected dataset, preprocessing procedure, and pretrained model; they do not establish that illumination alone caused the observed differences or that the findings generalise to other recognition systems.\\\",\\n\",\"9:   \\\"verified_protocol_facts\\\": {\\n\",\"10:     \\\"dataset\\\": \\\"Cropped Extended Yale B\\\",\\n\",\"\\n\",\"----------------------------------------------------------------------------------------\\n\",\"FILE: /content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3393/experiment20_methodology_3_3_subject_condition_selection.md\\n\",\"MATCHES: 2\\n\",\"\\n\",\"7: The condition A+000E+00 was designated as the reference condition. One reference observation was available for each of the 38 identities, providing an identity-specific reference embedding. The reference observations were retained for calculating reference-relative distances but excluded from the non-reference evaluation set. Consequently, the primary evaluation comprised the remaining 56 common conditions and 2,128 identity-condition observations.\\n\",\"8: \\n\",\"9: The 56 non-reference conditions were assigned to three illumination geometry groups using the frozen condition-grouping manifest: near-frontal, oblique, and large-angular-deviation. The corresponding evaluation counts were 17, 11, and 28 conditions, respectively, representing 646, 418, and 1,064 observations. The reference condition belonged to the near-frontal group but was excluded from these evaluation counts.\\n\",\"10: \\n\",\"11: The geometry groups represent the angular deviation of the illumination direction relative to the camera axis, as defined by the study's condition-grouping procedure. They do not represent directly measured illumination intensity. The same 38 identities were represented in each of the three evaluation groups, enabling identity-level repeated-measures comparisons. The resulting observations are identity-condition-matched captures under different lighting conditions, not exact image-level pairs generated from a single source image.\\n\",\"\\n\",\"9: The 56 non-reference conditions were assigned to three illumination geometry groups using the frozen condition-grouping manifest: near-frontal, oblique, and large-angular-deviation. The corresponding evaluation counts were 17, 11, and 28 conditions, respectively, representing 646, 418, and 1,064 observations. The reference condition belonged to the near-frontal group but was excluded from these evaluation counts.\\n\",\"10: \\n\",\"11: The geometry groups represent the angular deviation of the illumination direction relative to the camera axis, as defined by the study's condition-grouping procedure. They do not represent directly measured illumination intensity. The same 38 identities were represented in each of the three evaluation groups, enabling identity-level repeated-measures comparisons. The resulting observations are identity-condition-matched captures under different lighting conditions, not exact image-level pairs generated from a single source image.\\n\",\"\\n\",\"----------------------------------------------------------------------------------------\\n\",\"FILE: /content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3393/experiment20_step3393_subject_condition_selection.json\\n\",\"MATCHES: 4\\n\",\"\\n\",\"5:   \\\"subsection\\\": \\\"3.3 Subject Selection and Illumination-Condition Coverage\\\",\\n\",\"6:   \\\"created_utc\\\": \\\"2026-11-11T10:34:52.039353+00:00\\\",\\n\",\"7:   \\\"draft_text\\\": \\\"The subject cohort comprised 38 identities represented in the Cropped Extended Yale B frontal-pose illumination subset. The standard-illumination image collection contained 64 distinct illumination conditions across the cohort; however, not every condition was available for every identity. Seven identities had incomplete condition coverage. To preserve a consistent identity set across the primary condition-based comparisons, the analysis retained only conditions represented for all 38 identities.\\\\n\\\\nThis complete-case condition selection produced 57 common illumination conditions and 2,166 identity-condition observations, corresponding to 38 observations for each condition. The selection was based on shared condition availability rather than on embedding displacement values or statistical outcomes. Conditions not represented across all 38 identities were excluded from analyses requiring complete identity-condition coverage.\\\\n\\\\nThe condition A+000E+00 was designated as the reference condition. One reference observation was available for each of the 38 identities, providing an identity-specific reference embedding. The reference observations were retained for calculating reference-relative distances but excluded from the non-reference evaluation set. Consequently, the primary evaluation comprised the remaining 56 common conditions and 2,128 identity-condition observations.\\\\n\\\\nThe 56 non-reference conditions were assigned to three illumination geometry groups using the frozen condition-grouping manifest: near-frontal, oblique, and large-angular-deviation. The corresponding evaluation counts were 17, 11, and 28 conditions, respectively, representing 646, 418, and 1,064 observations. The reference condition belonged to the near-frontal group but was excluded from these evaluation counts.\\\\n\\\\nThe geometry groups represent the angular deviation of the illumination direction relative to the camera axis, as defined by the study's condition-grouping procedure. They do not represent directly measured illumination intensity. The same 38 identities were represented in each of the three evaluation groups, enabling identity-level repeated-measures comparisons. The resulting observations are identity-condition-matched captures under different lighting conditions, not exact image-level pairs generated from a single source image.\\\",\\n\",\"8:   \\\"verified_selection_facts\\\": {\\n\",\"9:     \\\"identity_count\\\": 38,\\n\",\"\\n\",\"26:         \\\"observations\\\": 418\\n\",\"27:       },\\n\",\"28:       \\\"large_angular_deviation\\\": {\\n\",\"29:         \\\"conditions\\\": 28,\\n\",\"30:         \\\"observations\\\": 1064\\n\",\"\\n\",\"31:       }\\n\",\"32:     },\\n\",\"33:     \\\"grouping_interpretation\\\": \\\"Angular deviation of illumination direction, not measured intensity\\\"\\n\",\"34:   },\\n\",\"35:   \\\"word_count\\\": 296,\\n\",\"\\n\",\"61:     \\\"Common-condition selection maintains complete identity coverage.\\\",\\n\",\"62:     \\\"Reference observations are used for distance calculation but excluded from non-reference evaluation counts.\\\",\\n\",\"63:     \\\"Geometry groups describe angular deviation, not measured illumination intensity.\\\"\\n\",\"64:   ]\\n\",\"65: }\\n\",\"\\n\",\"----------------------------------------------------------------------------------------\\n\",\"FILE: /content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3396/experiment20_methodology_3_5_facenet_embedding_extraction.md\\n\",\"MATCHES: 1\\n\",\"\\n\",\"9: Although the model architecture, pretrained training source, software versions, output dimensionality, and inference settings were recorded, the exact pretrained weight-file identity and its SHA256 checksum were not preserved. Consequently, the model configuration is documented at the architecture and pretrained-source level, but exact weight-file reproducibility cannot be independently established from the retained records.\\n\",\"10: \\n\",\"11: The resulting embeddings were retained with row-aligned image and identity metadata, including filenames, subject identifiers, illumination azimuths, elevations, and condition labels. These records enabled each non-reference embedding to be associated with the corresponding identity-specific reference representation during the displacement analysis.\\n\",\"\\n\",\"----------------------------------------------------------------------------------------\\n\",\"FILE: /content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3396/experiment20_step3396_facenet_embedding_extraction.json\\n\",\"MATCHES: 3\\n\",\"\\n\",\"5:   \\\"subsection\\\": \\\"3.5 FaceNet Architecture and Embedding Extraction\\\",\\n\",\"6:   \\\"created_utc\\\": \\\"2026-11-11T10:39:47.920563+00:00\\\",\\n\",\"7:   \\\"draft_text\\\": \\\"Face embeddings were generated using the InceptionResnetV1 architecture implemented in facenet-pytorch, with pretrained weights associated with the VGGFace2 training dataset. The model was used as a fixed pretrained feature extractor rather than being fine-tuned on the Cropped Extended Yale B images. The same model configuration was applied throughout the Stage 2 embedding extraction procedure.\\\\n\\\\nThe model produced a 512-dimensional embedding for each preprocessed image. Embedding extraction was performed with the model in evaluation mode, and gradient computation was disabled. These settings were used to obtain feature representations without updating model parameters during inference. The extracted embeddings were L2-normalised, providing the representations used in the subsequent reference-relative distance calculations.\\\\n\\\\nThe recorded software environment included Python 3.13.18, PyTorch 2.14.1+cpu, torchvision 0.29.1+cpu, and facenet-pytorch 2.6.0. The embedding-generation procedure used the pretrained InceptionResnetV1 model configured for VGGFace2 weights.\\\\n\\\\nAlthough the model architecture, pretrained training source, software versions, output dimensionality, and inference settings were recorded, the exact pretrained weight-file identity and its SHA256 checksum were not preserved. Consequently, the model configuration is documented at the architecture and pretrained-source level, but exact weight-file reproducibility cannot be independently established from the retained records.\\\\n\\\\nThe resulting embeddings were retained with row-aligned image and identity metadata, including filenames, subject identifiers, illumination azimuths, elevations, and condition labels. These records enabled each non-reference embedding to be associated with the corresponding identity-specific reference representation during the displacement analysis.\\\",\\n\",\"8:   \\\"verified_model_facts\\\": {\\n\",\"9:     \\\"architecture\\\": \\\"InceptionResnetV1\\\",\\n\",\"\\n\",\"25:       \\\"subjects\\\",\\n\",\"26:       \\\"subject_numbers\\\",\\n\",\"27:       \\\"azimuths\\\",\\n\",\"28:       \\\"elevations\\\",\\n\",\"29:       \\\"conditions\\\"\\n\",\"\\n\",\"26:       \\\"subject_numbers\\\",\\n\",\"27:       \\\"azimuths\\\",\\n\",\"28:       \\\"elevations\\\",\\n\",\"29:       \\\"conditions\\\"\\n\",\"30:     ]\\n\",\"\\n\",\"----------------------------------------------------------------------------------------\\n\",\"FILE: /content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3398/experiment20_methodology_3_7_illumination_geometry.md\\n\",\"MATCHES: 1\\n\",\"\\n\",\"1: # 3.7 Illumination Geometry Classification\\n\",\"2: \\n\",\"3: Illumination conditions were grouped according to the angular deviation of the light source from the camera-facing direction. The angular deviation, denoted by θ, was calculated from the recorded illumination azimuth and elevation angles using θ = cos⁻¹(cos(elevation) × cos(azimuth)). The angular values were expressed in degrees for interpretation and grouping.\\n\",\"4: \\n\",\"5: Three study-specific illumination geometry groups were defined. Near-frontal conditions comprised observations with θ ≤ 30°. Oblique conditions comprised observations with 30° < θ ≤ 60°. Large-angular conditions comprised observations with θ > 60°. These mutually exclusive intervals assigned each evaluated illumination condition to one geometry group.\\n\",\"\\n\",\"----------------------------------------------------------------------------------------\\n\",\"FILE: /content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3398/experiment20_step3398_illumination_geometry.json\\n\",\"MATCHES: 7\\n\",\"\\n\",\"5:   \\\"subsection\\\": \\\"3.7 Illumination Geometry Classification\\\",\\n\",\"6:   \\\"created_utc\\\": \\\"2026-11-11T10:42:32.788904+00:00\\\",\\n\",\"7:   \\\"draft_text\\\": \\\"Illumination conditions were grouped according to the angular deviation of the light source from the camera-facing direction. The angular deviation, denoted by θ, was calculated from the recorded illumination azimuth and elevation angles using θ = cos⁻¹(cos(elevation) × cos(azimuth)). The angular values were expressed in degrees for interpretation and grouping.\\\\n\\\\nThree study-specific illumination geometry groups were defined. Near-frontal conditions comprised observations with θ ≤ 30°. Oblique conditions comprised observations with 30° < θ ≤ 60°. Large-angular conditions comprised observations with θ > 60°. These mutually exclusive intervals assigned each evaluated illumination condition to one geometry group.\\\\n\\\\nAcross the 56 non-reference evaluation conditions, 17 conditions were classified as near-frontal, 11 as oblique, and 28 as large-angular. Across the 38 identities, these groups contained 646, 418, and 1,064 evaluation observations, respectively. All three groups therefore included observations from the same 38 identities, supporting the repeated-measures comparisons conducted at the identity level.\\\\n\\\\nThe groups represent the angular geometry of the illumination direction rather than its intensity. They should not be interpreted as brightness levels, exposure categories, or measurements of lighting power. The three angular boundaries were selected for this study and are not presented as universal or standard illumination categories. Previous face-recognition research has used angular subsets to examine illumination variation, but the thresholds and grouping scheme used here are study-specific.\\\",\\n\",\"8:   \\\"verified_geometry_facts\\\": {\\n\",\"9:     \\\"angular_deviation_symbol\\\": \\\"theta\\\",\\n\",\"\\n\",\"7:   \\\"draft_text\\\": \\\"Illumination conditions were grouped according to the angular deviation of the light source from the camera-facing direction. The angular deviation, denoted by θ, was calculated from the recorded illumination azimuth and elevation angles using θ = cos⁻¹(cos(elevation) × cos(azimuth)). The angular values were expressed in degrees for interpretation and grouping.\\\\n\\\\nThree study-specific illumination geometry groups were defined. Near-frontal conditions comprised observations with θ ≤ 30°. Oblique conditions comprised observations with 30° < θ ≤ 60°. Large-angular conditions comprised observations with θ > 60°. These mutually exclusive intervals assigned each evaluated illumination condition to one geometry group.\\\\n\\\\nAcross the 56 non-reference evaluation conditions, 17 conditions were classified as near-frontal, 11 as oblique, and 28 as large-angular. Across the 38 identities, these groups contained 646, 418, and 1,064 evaluation observations, respectively. All three groups therefore included observations from the same 38 identities, supporting the repeated-measures comparisons conducted at the identity level.\\\\n\\\\nThe groups represent the angular geometry of the illumination direction rather than its intensity. They should not be interpreted as brightness levels, exposure categories, or measurements of lighting power. The three angular boundaries were selected for this study and are not presented as universal or standard illumination categories. Previous face-recognition research has used angular subsets to examine illumination variation, but the thresholds and grouping scheme used here are study-specific.\\\",\\n\",\"8:   \\\"verified_geometry_facts\\\": {\\n\",\"9:     \\\"angular_deviation_symbol\\\": \\\"theta\\\",\\n\",\"10:     \\\"angular_deviation_formula\\\": \\\"acos(cos(elevation) * cos(azimuth))\\\",\\n\",\"11:     \\\"angle_unit\\\": \\\"degrees\\\",\\n\",\"\\n\",\"8:   \\\"verified_geometry_facts\\\": {\\n\",\"9:     \\\"angular_deviation_symbol\\\": \\\"theta\\\",\\n\",\"10:     \\\"angular_deviation_formula\\\": \\\"acos(cos(elevation) * cos(azimuth))\\\",\\n\",\"11:     \\\"angle_unit\\\": \\\"degrees\\\",\\n\",\"12:     \\\"groups\\\": {\\n\",\"\\n\",\"9:     \\\"angular_deviation_symbol\\\": \\\"theta\\\",\\n\",\"10:     \\\"angular_deviation_formula\\\": \\\"acos(cos(elevation) * cos(azimuth))\\\",\\n\",\"11:     \\\"angle_unit\\\": \\\"degrees\\\",\\n\",\"12:     \\\"groups\\\": {\\n\",\"13:       \\\"near_frontal\\\": {\\n\",\"\\n\",\"12:     \\\"groups\\\": {\\n\",\"13:       \\\"near_frontal\\\": {\\n\",\"14:         \\\"rule\\\": \\\"theta <= 30 degrees\\\",\\n\",\"15:         \\\"conditions\\\": 17,\\n\",\"16:         \\\"observations\\\": 646\\n\",\"\\n\",\"17:       },\\n\",\"18:       \\\"oblique\\\": {\\n\",\"19:         \\\"rule\\\": \\\"30 degrees < theta <= 60 degrees\\\",\\n\",\"20:         \\\"conditions\\\": 11,\\n\",\"21:         \\\"observations\\\": 418\\n\",\"\\n\",\"22:       },\\n\",\"23:       \\\"large_angular\\\": {\\n\",\"24:         \\\"rule\\\": \\\"theta > 60 degrees\\\",\\n\",\"25:         \\\"conditions\\\": 28,\\n\",\"26:         \\\"observations\\\": 1064\\n\",\"\\n\",\"========================================================================================\\n\",\"AUDIT SUMMARY\\n\",\"========================================================================================\\n\",\"Files scanned: 116\\n\",\"Files with relevant matches: 39\\n\",\"Relevant match groups: 1044\\n\",\"\\n\",\"Candidate source files:\\n\",\"/content/drive/MyDrive/Experiment_20_Results/dataset_audit/experiment20_grouped_illumination_condition_manifest.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/dataset_audit/experiment20_corrected_illumination_condition_manifest.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/dataset_audit/experiment20_angular_hemisphere_audit.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_2_7/experiment20_step27_descriptive_analysis_protocol.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_2_7/experiment20_step271_protocol_feasibility_audit.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_2_7/displacement_analysis/experiment20_step272_displacement_audit.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_2_7/group_descriptive_analysis/experiment20_step273_group_descriptive_audit.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_2_7/repeated_measures_analysis/experiment20_step274_repeated_measures_audit.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_2_7/figures/experiment20_step276_figure_generation_audit.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_2_7/final_freeze/experiment20_step271_protocol_feasibility_audit.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_2_7/final_freeze/experiment20_step27_descriptive_analysis_protocol.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_2_7/final_freeze/experiment20_step272_displacement_audit.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_2_7/final_freeze/experiment20_step273_group_descriptive_audit.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_2_7/final_freeze/experiment20_step274_repeated_measures_audit.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_2_7/final_freeze/experiment20_step276_figure_generation_audit.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_2_7/final_freeze/experiment20_final_results_summary.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_2_7/final_freeze/experiment20_final_results_report.md\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_1/experiment20_step316_methodological_risk_register.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_2/experiment20_step322_closest_study_comparison.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_2/experiment20_step323_expanded_prior_art_assessment.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_2/experiment20_step3213_mediapipe_pilot_sample_manifest.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_2/experiment20_step3216_mediapipe_detection_pilot.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_2/experiment20_step3219_publication_strategy_decision.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/experiment20_step3362_introduction_illumination_context.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_337/experiment20_consolidated_introduction.md\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_337/experiment20_consolidated_introduction.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_338/experiment20_step338_citation_verification_audit.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_338/experiment20_step3381_angular_grouping_literature_audit.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3382/experiment20_consolidated_introduction_v2.md\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3382/experiment20_consolidated_introduction_v2.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3384/experiment20_consolidated_introduction_apa7_corrected.md\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3391/experiment20_methodology_3_1_research_design.md\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3391/experiment20_step3391_research_design.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3393/experiment20_methodology_3_3_subject_condition_selection.md\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3393/experiment20_step3393_subject_condition_selection.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3396/experiment20_methodology_3_5_facenet_embedding_extraction.md\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3396/experiment20_step3396_facenet_embedding_extraction.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3398/experiment20_methodology_3_7_illumination_geometry.md\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3398/experiment20_step3398_illumination_geometry.json\\n\",\"\\n\",\"========================================================================================\\n\",\"MANUAL VERIFICATION REQUIRED\\n\",\"========================================================================================\\n\",\"\\n\",\"Please inspect the displayed source lines.\\n\",\"\\n\",\"We need evidence for all three operations:\\n\",\"\\n\",\"A. Degree-to-radian conversion before cosine:\\n\",\"   Example: np.deg2rad(azimuth) and np.deg2rad(elevation)\\n\",\"\\n\",\"B. Inverse cosine:\\n\",\"   Example: np.arccos(...)\\n\",\"\\n\",\"C. Radian-to-degree conversion after inverse cosine:\\n\",\"   Example: np.rad2deg(theta)\\n\",\"\\n\",\"Do not infer that a conversion occurred merely because the metadata\\n\",\"contains angles expressed in degrees.\\n\",\"\\n\",\"No files were modified by this audit.\\n\",\"\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.3.9.13.1\\n\",\"## Source-Code Recovery: Illumination Geometry Calculation\\n\",\"\\n\",\"Locate the original Python or notebook code used to calculate illumination angular deviation.\\n\",\"\\n\",\"The objective is to identify:\\n\",\"- Degree-to-radian conversion.\\n\",\"- Cosine operations.\\n\",\"- Inverse cosine operation.\\n\",\"- Conversion of the resulting angle to degrees.\\n\",\"\\n\",\"This is a source-code discovery audit only. Do not modify existing files or recompute experimental results.\"],\"metadata\":{\"id\":\"0A2lG7h7NRq9\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import re\\n\",\"\\n\",\"ROOTS = [\\n\",\"    Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\"),\\n\",\"    Path(\\\"/content/drive/MyDrive\\\")\\n\",\"]\\n\",\"\\n\",\"PATTERNS = [\\n\",\"    r\\\"np\\\\.cos\\\\s*\\\\(\\\",\\n\",\"    r\\\"numpy\\\\.cos\\\\s*\\\\(\\\",\\n\",\"    r\\\"np\\\\.arccos\\\\s*\\\\(\\\",\\n\",\"    r\\\"numpy\\\\.arccos\\\\s*\\\\(\\\",\\n\",\"    r\\\"np\\\\.deg2rad\\\",\\n\",\"    r\\\"np\\\\.rad2deg\\\",\\n\",\"    r\\\"math\\\\.radians\\\",\\n\",\"    r\\\"math\\\\.degrees\\\",\\n\",\"    r\\\"angular_deviation\\\",\\n\",\"    r\\\"theta_degrees\\\",\\n\",\"]\\n\",\"\\n\",\"seen = set()\\n\",\"results = []\\n\",\"\\n\",\"print(\\\"=\\\" * 88)\\n\",\"print(\\\"EXPERIMENT 20 — ORIGINAL ANGULAR CALCULATION SOURCE SEARCH\\\")\\n\",\"print(\\\"=\\\" * 88)\\n\",\"\\n\",\"for root in ROOTS:\\n\",\"    if not root.exists():\\n\",\"        continue\\n\",\"\\n\",\"    for path in root.rglob(\\\"*\\\"):\\n\",\"        if not path.is_file() or path in seen:\\n\",\"            continue\\n\",\"\\n\",\"        seen.add(path)\\n\",\"\\n\",\"        if path.suffix.lower() not in {\\\".py\\\", \\\".ipynb\\\"}:\\n\",\"            continue\\n\",\"\\n\",\"        try:\\n\",\"            content = path.read_text(encoding=\\\"utf-8\\\", errors=\\\"ignore\\\")\\n\",\"        except Exception:\\n\",\"            continue\\n\",\"\\n\",\"        matches = []\\n\",\"        lines = content.splitlines()\\n\",\"\\n\",\"        for i, line in enumerate(lines):\\n\",\"            if any(re.search(p, line, re.IGNORECASE) for p in PATTERNS):\\n\",\"                start = max(0, i - 3)\\n\",\"                end = min(len(lines), i + 4)\\n\",\"\\n\",\"                snippet = \\\"\\\\n\\\".join(\\n\",\"                    f\\\"{j+1}: {lines[j]}\\\" for j in range(start, end)\\n\",\"                )\\n\",\"\\n\",\"                matches.append(snippet)\\n\",\"\\n\",\"        if matches:\\n\",\"            results.append((path, matches))\\n\",\"\\n\",\"print(\\\"Source files searched:\\\", len(seen))\\n\",\"\\n\",\"if not results:\\n\",\"    print(\\\"\\\\nNo matching Python source files or notebooks found.\\\")\\n\",\"else:\\n\",\"    print(\\\"Candidate source files:\\\", len(results))\\n\",\"\\n\",\"    for path, matches in results:\\n\",\"        print(\\\"\\\\n\\\" + \\\"-\\\" * 88)\\n\",\"        print(\\\"SOURCE:\\\", path)\\n\",\"\\n\",\"        for snippet in matches[:10]:\\n\",\"            print(\\\"\\\\n\\\" + snippet)\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 88)\\n\",\"print(\\\"AUDIT COMPLETE — NO FILES MODIFIED\\\")\\n\",\"print(\\\"=\\\" * 88)\"],\"metadata\":{\"id\":\"xdOdVvBaNTyU\",\"outputId\":\"3733f323-dac9-44f7-941f-2b783daff598\",\"colab\":{\"base_uri\":\"https://localhost:8080/\"}},\"execution_count\":null,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"========================================================================================\\n\",\"EXPERIMENT 20 — ORIGINAL ANGULAR CALCULATION SOURCE SEARCH\\n\",\"========================================================================================\\n\"]}]}]}\n",
            "\n",
            "========================================================================================\n",
            "AUDIT COMPLETE — NO FILES MODIFIED\n",
            "========================================================================================\n"
          ]
        }
