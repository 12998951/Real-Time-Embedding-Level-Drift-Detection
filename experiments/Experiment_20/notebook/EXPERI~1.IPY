        "id": "gv4qUvgQPQ2f",
        "outputId": "8fba7faf-1e0b-4c35-fd41-650ce04a5c88"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "===========================================================================\n",
            "EXPERIMENT 20 — STEP 3.3.10.1\n",
            "FROZEN RESULTS INVENTORY AND VERIFICATION\n",
            "===========================================================================\n",
            "\n",
            "[1] DIRECTORY CHECK\n",
            "Final freeze directory: /content/drive/MyDrive/Experiment_20_Results/step_2_7/final_freeze\n",
            "Directory exists: PASS\n",
            "Total files: 22\n",
            "\n",
            "[2] FILE INVENTORY\n",
            "\n",
            "File: experiment20_figure1_euclidean_illumination_groups.png\n",
            "Size: 892771 bytes\n",
            "SHA256: 71623f613dc8202cf5cf6ff7bea005b315e4a31de73841d064c896b24e565b16\n",
            "\n",
            "File: experiment20_figure2_cosine_illumination_groups.png\n",
            "Size: 882531 bytes\n",
            "SHA256: de22ee98a909ef099199f5b49911633497c2c890d9d903224131f95db54c917c\n",
            "\n",
