            "        \"high_illumination_embeddings\"\n",
            "    ].copy()\n",
            "\n",
            "    paired_labels = illumination_data[\n",
            "        \"paired_labels\"\n",
            "    ].copy()\n",
            "\n",
            "    saved_low_displacement = illumination_data[\n",
            "        \"low_displacement\"\n",
            "    ].copy()\n",
            "\n",
            "    saved_high_displacement = illumination_data[\n",
            "        \"high_displacement\"\n",
            "    ].copy()\n",
            "\n",
            "with open(METADATA_FILE, \"r\", encoding=\"utf-8\") as file:\n",
            "    metadata = json.load(file)\n",
            "\n",
            "identity_csv = pd.read_csv(CSV_FILE)\n",
            "\n",
            "print(\"Section 2: Existing archives and metadata loaded.\")\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 3. DATASET COMPOSITION\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "assert original_embeddings.shape == low_embeddings.shape\n",
            "assert original_embeddings.shape == high_embeddings.shape\n",
            "assert original_embeddings.ndim == 2\n",
            "assert original_embeddings.shape[0] == len(paired_labels)\n",
            "assert original_embeddings.shape[1] == 512\n",
            "\n",
            "assert np.isfinite(original_embeddings).all()\n",
            "assert np.isfinite(low_embeddings).all()\n",
            "assert np.isfinite(high_embeddings).all()\n",
            "\n",
            "identity_values, identity_counts = np.unique(\n",
            "    paired_labels,\n",
            "    return_counts=True\n",
            ")\n",
            "\n",
            "identity_distribution = [\n",
            "    {\n",
            "        \"identity\": int(identity),\n",
            "        \"paired_image_count\": int(count)\n",
            "    }\n",
            "    for identity, count in zip(\n",
            "        identity_values,\n",
            "        identity_counts\n",
            "    )\n",
            "]\n",
            "\n",
            "paired_images = int(len(paired_labels))\n",
            "identity_count = int(len(identity_values))\n",
            "embedding_dimension = int(original_embeddings.shape[1])\n",
            "\n",
            "largest_identity_index = int(np.argmax(identity_counts))\n",
            "\n",
            "largest_identity = int(\n",
            "    identity_values[largest_identity_index]\n",
            ")\n",
            "\n",
            "largest_identity_count = int(\n",
            "    identity_counts[largest_identity_index]\n",
            ")\n",
            "\n",
            "largest_identity_share = (\n",
            "    largest_identity_count / paired_images\n",
            ")\n",
            "\n",
            "assert paired_images == 889\n",
            "assert identity_count == 13\n",
            "\n",
            "print(\"\\nSection 3: Dataset composition verified.\")\n",
            "print(\"Paired images:\", paired_images)\n",
            "print(\"Identities:\", identity_count)\n",
            "print(\"Embedding dimension:\", embedding_dimension)\n",
            "print(\"Largest identity:\", largest_identity)\n",
            "print(\"Largest identity share:\", f\"{largest_identity_share:.2%}\")\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 4. REPRODUCE SAVED EMBEDDING DISPLACEMENTS\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "recalculated_low = np.linalg.norm(\n",
            "    low_embeddings - original_embeddings,\n",
            "    axis=1\n",
            ")\n",
            "\n",
            "recalculated_high = np.linalg.norm(\n",
            "    high_embeddings - original_embeddings,\n",
            "    axis=1\n",
            ")\n",
            "\n",
            "low_max_error = float(\n",
            "    np.max(\n",
            "        np.abs(\n",
            "            recalculated_low - saved_low_displacement\n",
            "        )\n",
            "    )\n",
            ")\n",
            "\n",
            "high_max_error = float(\n",
            "    np.max(\n",
            "        np.abs(\n",
            "            recalculated_high - saved_high_displacement\n",
            "        )\n",
            "    )\n",
            ")\n",
            "\n",
            "assert low_max_error == 0.0, (\n",
            "    \"Low-illumination displacement reproduction failed.\"\n",
            ")\n",
            "\n",
            "assert high_max_error == 0.0, (\n",
            "    \"High-illumination displacement reproduction failed.\"\n",
            ")\n",
            "\n",
            "displacement_summary = {\n",
            "    \"low_illumination\": {\n",
            "        \"mean\": float(np.mean(saved_low_displacement)),\n",
            "        \"median\": float(np.median(saved_low_displacement)),\n",
            "        \"standard_deviation\": float(\n",
            "            np.std(saved_low_displacement)\n",
            "        \n",
            "\n",
            "====================================================================================================\n",
            "INSPECTION SUMMARY\n",
            "====================================================================================================\n",
            "Notebooks discovered: 25\n",
            "Matching code cells: 109\n",
            "Notebook files modified: NO\n",
            "Notebook cells executed: NO\n",
            "====================================================================================================\n"
          ]
        }
      ]
    },
