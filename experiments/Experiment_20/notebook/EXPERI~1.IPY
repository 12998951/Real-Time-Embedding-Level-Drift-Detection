        "        \"embedding_archive_sha256\":\n",
        "            \"127ffb6e71b871ebab9ed10fd8ce5f2b78b9f3971db4075cf14b44f7df2d3c4c\",\n",
        "        \"embedding_shape\": [2414, 512],\n",
        "        \"embedding_dtype\": \"float32\",\n",
