            "            \"MTCNN\"\n",
            "          ],\n",
            "          \"excerpt\": \"import torch\\nimport torchvision\\nfrom facenet_pytorch import MTCNN, InceptionResnetV1\\n\\n# Configure execution device\\ndevice = torch.device(\\\"cpu\\\")\\n# Initialise MTCNN face detector\\nmtcnn = MTCNN(\\n    image_size=160,\\n    margin=0,\\n    keep_all=False,\\n# Load pretrained FaceNet model\\nfacenet = InceptionResnetV1(\\n    pretrained=\\\"vggface2\\\"\\n).eval().to(device)\\n# Verify model configuration\\nprint(\\\"MTCNN initialised successfully.\\\")\\nprint(\\\"FaceNet model initialised successfully.\\\")\\nprint(\\\"Pretrained weights: VGGFace2\\\")\\nprint(\\\"Execution device:\\\", device)\\nprint(\\\"Embedding dimension:\\\", facenet.last_linear.out_features)\"\n",
