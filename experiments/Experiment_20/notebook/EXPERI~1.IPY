      "cell_type": "markdown",
      "source": [
        "# Experiment 20 — Step 3.2.14\n",
        "## MediaPipe Installation and Environment Verification\n",
        "\n",
        "### Objective\n",
        "Install MediaPipe in the current Colab runtime and verify that\n",
        "the Face Landmarker API is available.\n",
        "\n",
        "### Requirements\n",
        "- Record Python version.\n",
        "- Record MediaPipe version.\n",
        "- Verify FaceLandmarker API availability.\n",
        "- Verify image-mode support.\n",
        "- Record installation outcome.\n",
        "\n",
        "### Restrictions\n",
        "- Do not download the Face Landmarker model asset yet.\n",
        "- Do not run inference.\n",
        "- Do not generate aligned images.\n",
        "- Do not modify the frozen dataset or existing embeddings.\n",
        "\n",
        "### Important\n",
        "Installing MediaPipe may change runtime dependencies.\n",
        "Record any installation warnings or dependency conflicts."
      ],
      "metadata": {
        "id": "z9EgQXPC6cFN"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import sys\n",
        "import json\n",
        "import subprocess\n",
        "import importlib.util\n",
        "from pathlib import Path\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "BASE = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "STEP_DIR = BASE / \"step_3_2\"\n",
        "STEP_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "OUTPUT_FILE = STEP_DIR / (\n",
        "    \"experiment20_step3214_mediapipe_environment_audit.json\"\n",
        ")\n",
        "\n",
        "print(\"=\" * 88)\n",
        "print(\"EXPERIMENT 20 — STEP 3.2.14\")\n",
        "print(\"MEDIAPIPE INSTALLATION AND ENVIRONMENT VERIFICATION\")\n",
        "print(\"=\" * 88)\n",
        "\n",
        "print(\"Python:\", sys.version)\n",
        "\n",
        "# Install MediaPipe only if it is not already available.\n",
        "if importlib.util.find_spec(\"mediapipe\") is None:\n",
        "    result = subprocess.run(\n",
        "        [sys.executable, \"-m\", \"pip\", \"install\", \"mediapipe\"],\n",
        "        capture_output=True,\n",
        "        text=True\n",
        "    )\n",
        "    install_return_code = result.returncode\n",
        "    install_stdout = result.stdout[-5000:]\n",
        "    install_stderr = result.stderr[-5000:]\n",
        "else:\n",
        "    install_return_code = 0\n",
        "    install_stdout = \"MediaPipe already installed.\"\n",
        "    install_stderr = \"\"\n",
        "\n",
        "import mediapipe as mp\n",
        "\n",
        "api_available = hasattr(mp, \"tasks\")\n",
        "face_landmarker_available = (\n",
        "    hasattr(mp, \"tasks\")\n",
        "    and hasattr(mp.tasks, \"vision\")\n",
        "    and hasattr(mp.tasks.vision, \"FaceLandmarker\")\n",
        ")\n",
        "\n",
        "image_mode_available = (\n",
        "    hasattr(mp.tasks.vision, \"RunningMode\")\n",
        "    and hasattr(mp.tasks.vision.RunningMode, \"IMAGE\")\n",
        ") if face_landmarker_available else False\n",
        "\n",
        "record = {\n",
        "    \"experiment\": \"Experiment 20\",\n",
        "    \"step\": \"3.2.14\",\n",
        "    \"timestamp_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "    \"python_version\": sys.version,\n",
        "    \"mediapipe_version\": mp.__version__,\n",
        "    \"installation_return_code\": install_return_code,\n",
        "    \"mediapipe_tasks_api_available\": api_available,\n",
        "    \"face_landmarker_api_available\": face_landmarker_available,\n",
        "    \"image_mode_available\": image_mode_available,\n",
        "    \"installation_stdout_tail\": install_stdout,\n",
        "    \"installation_stderr_tail\": install_stderr,\n",
        "    \"model_asset_downloaded\": False,\n",
        "    \"inference_performed\": False,\n",
        "    \"aligned_images_generated\": False,\n",
        "    \"frozen_data_modified\": False,\n",
        "    \"status\": (\n",
        "        \"MEDIAPIPE_ENVIRONMENT_READY\"\n",
        "        if install_return_code == 0\n",
        "        and face_landmarker_available\n",
        "        and image_mode_available\n",
        "        else \"MEDIAPIPE_ENVIRONMENT_FAILED\"\n",
        "    )\n",
        "}\n",
        "\n",
        "with open(OUTPUT_FILE, \"w\") as f:\n",
        "    json.dump(record, f, indent=2)\n",
        "\n",
        "with open(OUTPUT_FILE, \"r\") as f:\n",
        "    reloaded = json.load(f)\n",
        "\n",
        "print(\"\\nMediaPipe version:\", mp.__version__)\n",
        "print(\"Tasks API:\", api_available)\n",
        "print(\"FaceLandmarker API:\", face_landmarker_available)\n",
        "print(\"Image mode:\", image_mode_available)\n",
        "\n",
        "print(\"\\nStatus:\", record[\"status\"])\n",
        "print(\"JSON reload:\", \"PASS\" if reloaded == record else \"FAIL\")\n",
        "print(\"Saved:\", OUTPUT_FILE)\n",
        "\n",
        "print(\"\\nModel asset downloaded: NO\")\n",
        "print(\"Inference: NO\")\n",
        "print(\"Aligned images generated: NO\")\n",
        "print(\"Frozen data modified: NO\")\n",
        "print(\"=\" * 88)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "Y0HT6fwk6du-",
