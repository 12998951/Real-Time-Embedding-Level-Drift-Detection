            "        \"DOCUMENTED\",\n",
            "        \"DOCUMENTED\",\n",
            "        \"VERIFIED\",\n",
            "        \"VERIFIED\",\n",
            "        (\n",
            "            \"VERIFIED\"\n",
            "            if not missing_evaluation_variables\n",
            "            else \"NOT VERIFIED\"\n",
            "        ),\n",
            "        (\n",
            "            \"VERIFIED\"\n",
            "            if not missing_evaluation_variables\n",
            "            else \"NOT VERIFIED\"\n",
            "        ),\n",
            "        \"VERIFIED\",\n",
            "        \"INSPECTED\",\n",
