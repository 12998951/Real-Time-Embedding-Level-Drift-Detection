      "cell_type": "code",
      "source": [
        "from pathlib import Path\n",
        "import sys\n",
        "import shutil\n",
        "import importlib.util\n",
        "import platform\n",
        "import json\n",
        "import hashlib\n",
        "\n",
        "print(\"=\" * 90)\n",
        "print(\"EXPERIMENT 20 — STEP 3.2.5\")\n",
        "print(\"ADDITIONAL MODEL FEASIBILITY AND RUNTIME AUDIT\")\n",
        "print(\"=\" * 90)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. Python environment\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n[1] PYTHON ENVIRONMENT\")\n",
        "\n",
        "print(\"Python:\", sys.version)\n",
        "print(\"Platform:\", platform.platform())\n",
        "print(\"Architecture:\", platform.machine())\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. Package availability\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n[2] PACKAGE AVAILABILITY\")\n",
        "\n",
        "packages = [\n",
        "    \"torch\",\n",
        "    \"torchvision\",\n",
        "    \"facenet_pytorch\",\n",
        "    \"insightface\",\n",
        "    \"onnxruntime\",\n",
        "    \"onnxruntime_gpu\",\n",
        "    \"cv2\",\n",
        "    \"PIL\",\n",
        "    \"numpy\",\n",
        "    \"pandas\",\n",
        "    \"tqdm\"\n",
        "]\n",
        "\n",
        "package_status = {}\n",
        "\n",
        "for package in packages:\n",
        "    available = importlib.util.find_spec(package) is not None\n",
        "    package_status[package] = available\n",
        "    print(f\"{package}: {'AVAILABLE' if available else 'NOT INSTALLED'}\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. PyTorch and GPU\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n[3] PYTORCH AND GPU\")\n",
        "\n",
        "gpu_info = {\n",
        "    \"torch_available\": False,\n",
        "    \"torch_version\": None,\n",
        "    \"cuda_available\": False,\n",
        "    \"cuda_version\": None,\n",
        "    \"gpu_devices\": []\n",
        "}\n",
        "\n",
        "try:\n",
        "    import torch\n",
        "\n",
        "    gpu_info[\"torch_available\"] = True\n",
        "    gpu_info[\"torch_version\"] = torch.__version__\n",
        "    gpu_info[\"cuda_available\"] = torch.cuda.is_available()\n",
        "    gpu_info[\"cuda_version\"] = torch.version.cuda\n",
        "\n",
        "    print(\"PyTorch:\", torch.__version__)\n",
        "    print(\"CUDA available:\", torch.cuda.is_available())\n",
        "    print(\"CUDA version:\", torch.version.cuda)\n",
        "\n",
        "    if torch.cuda.is_available():\n",
        "        for i in range(torch.cuda.device_count()):\n",
        "            props = torch.cuda.get_device_properties(i)\n",
        "\n",
        "            device = {\n",
        "                \"index\": i,\n",
        "                \"name\": props.name,\n",
        "                \"total_memory_gb\": round(\n",
        "                    props.total_memory / (1024 ** 3), 2\n",
        "                )\n",
        "            }\n",
        "\n",
        "            gpu_info[\"gpu_devices\"].append(device)\n",
        "            print(\"GPU:\", device)\n",
        "\n",
        "    else:\n",
        "        print(\"No CUDA GPU detected.\")\n",
        "\n",
        "except Exception as exc:\n",
        "    print(\"PyTorch inspection error:\", repr(exc))\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. RAM\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n[4] SYSTEM MEMORY\")\n",
        "\n",
        "try:\n",
        "    import psutil\n",
        "\n",
        "    memory = psutil.virtual_memory()\n",
        "\n",
        "    print(\"Total RAM GB:\", round(memory.total / (1024 ** 3), 2))\n",
        "    print(\"Available RAM GB:\", round(memory.available / (1024 ** 3), 2))\n",
        "    print(\"RAM usage percentage:\", memory.percent)\n",
        "\n",
        "except Exception as exc:\n",
        "    print(\"RAM inspection unavailable:\", repr(exc))\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. Disk capacity\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n[5] DISK CAPACITY\")\n",
        "\n",
        "for location in [\"/content\", \"/content/drive/MyDrive\"]:\n",
        "    path = Path(location)\n",
        "\n",
        "    if path.exists():\n",
        "        usage = shutil.disk_usage(path)\n",
        "\n",
        "        print(location)\n",
        "        print(\"  Total GB:\", round(usage.total / (1024 ** 3), 2))\n",
        "        print(\"  Free GB:\", round(usage.free / (1024 ** 3), 2))\n",
        "\n",
        "    else:\n",
        "        print(location, \"NOT AVAILABLE\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. Existing experiment embedding archive\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n[6] EXISTING EXPERIMENT 20 EMBEDDINGS\")\n",
        "\n",
        "EMBEDDING_FILE = (\n",
        "    Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "    / \"embeddings\"\n",
        "    / \"experiment20_croppedyale_facenet_embeddings.npz\"\n",
        ")\n",
        "\n",
        "if EMBEDDING_FILE.exists():\n",
        "    digest = hashlib.sha256()\n",
        "\n",
        "    with EMBEDDING_FILE.open(\"rb\") as f:\n",
        "        for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n",
        "            digest.update(chunk)\n",
        "\n",
        "    print(\"Embedding archive:\", EMBEDDING_FILE)\n",
        "    print(\"Size MB:\", round(EMBEDDING_FILE.stat().st_size / (1024 ** 2), 2))\n",
        "    print(\"SHA256:\", digest.hexdigest())\n",
        "\n",
        "else:\n",
        "    print(\"Embedding archive not found at expected path.\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. Existing model caches\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n[7] EXISTING MODEL CACHE\")\n",
        "\n",
        "cache_roots = [\n",
        "    Path(\"/root/.cache/torch\"),\n",
        "    Path(\"/root/.cache/torch/hub/checkpoints\"),\n",
        "    Path(\"/root/.insightface\"),\n",
        "    Path(\"/content/.cache\"),\n",
        "    Path(\"/root/.cache/huggingface\")\n",
        "]\n",
        "\n",
        "for root in cache_roots:\n",
        "    if root.exists():\n",
        "        print(\"\\nCache:\", root)\n",
        "\n",
        "        try:\n",
        "            entries = list(root.iterdir())[:20]\n",
        "\n",
        "            for entry in entries:\n",
        "                print(\" \", entry.name)\n",
        "\n",
        "        except Exception as exc:\n",
        "            print(\"  Cannot inspect:\", repr(exc))\n",
        "\n",
        "    else:\n",
        "        print(\"\\nCache not present:\", root)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 8. Feasibility summary\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 90)\n",
        "print(\"STEP 3.2.5 FEASIBILITY SUMMARY\")\n",
        "print(\"=\" * 90)\n",
        "\n",
        "print(\"GPU available:\", gpu_info[\"cuda_available\"])\n",
        "print(\"Installed packages:\")\n",
        "for name, available in package_status.items():\n",
        "    print(f\"  {name}: {available}\")\n",
        "\n",
        "print(\"\\nModel downloads performed: NO\")\n",
        "print(\"Package installations performed: NO\")\n",
        "print(\"Embedding regeneration performed: NO\")\n",
        "print(\"Frozen results modified: NO\")\n",
        "\n",
        "print(\"=\" * 90)\n",
        "print(\"STEP 3.2.5 COMPLETED\")\n",
        "print(\"=\" * 90)"
      ],
