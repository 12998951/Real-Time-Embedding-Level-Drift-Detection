        "id": "z_1pzEzJ7QTo",
        "outputId": "84a7095f-2d99-4bc0-a430-25538f9e0cf4"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "========================================================================================\n",
            "EXPERIMENT 20 — STEP 3.2.17\n",
            "MEDIAPIPE DETECTION FAILURE ANALYSIS\n",
            "========================================================================================\n",
            "\n",
            "Failure classification:\n",
            "successful_478_landmark_detection: 18\n",
            "multiple_faces_detected: 1\n",
            "no_face_detected: 11\n",
            "\n",
            "Group analysis:\n",
            "near_frontal {'successful_478_landmark_detection': 8, 'multiple_faces_detected': 1, 'no_face_detected': 1}\n",
            "oblique {'successful_478_landmark_detection': 8, 'no_face_detected': 2}\n",
            "large_angular {'successful_478_landmark_detection': 2, 'no_face_detected': 8}\n",
            "\n",
            "Failed image filenames:\n",
            "yaleB06_P00A+010E+00.pgm | near_frontal | multiple_faces_detected\n",
            "yaleB30_P00A+010E-20.pgm | near_frontal | no_face_detected\n",
            "yaleB13_P00A+000E-35.pgm | oblique | no_face_detected\n",
            "yaleB10_P00A+000E-35.pgm | oblique | no_face_detected\n",
            "yaleB06_P00A-120E+00.pgm | large_angular | no_face_detected\n",
            "yaleB32_P00A+000E+90.pgm | large_angular | no_face_detected\n",
            "yaleB12_P00A-095E+00.pgm | large_angular | no_face_detected\n",
