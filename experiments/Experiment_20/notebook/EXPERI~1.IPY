            "# ------------------------------------------------------------\n",
            "# 6. Software and environment versions\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n6. SOFTWARE ENVIRONMENT\")\n",
            "\n",
            "packages = [\n",
            "    \"numpy\",\n",
            "    \"pandas\",\n",
            "    \"torch\",\n",
            "    \"torchvision\",\n",
            "    \"facenet-pytorch\",\n",
            "    \"scipy\",\n",
            "    \"matplotlib\",\n",
            "    \"scikit-learn\",\n",
            "    \"Pillow\"\n",
            "]\n",
            "\n",
            "software_versions = []\n",
            "\n",
            "for package in packages:\n",
            "\n",
            "    try:\n",
            "        version = pkg_metadata.version(package)\n",
            "\n",
            "    except pkg_metadata.PackageNotFoundError:\n",
            "        version = \"Not installed\"\n",
            "\n",
            "    software_versions.append({\n",
            "        \"Package\": package,\n",
            "        \"Version\": version\n",
            "    })\n",
            "\n",
            "software_df = pd.DataFrame(software_versions)\n",
            "\n",
            "print(\"Python version:\", sys.version.split()[0])\n",
            "print(\"Platform:\", platform.platform())\n",
            "\n",
            "display(software_df)\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 7. Inspect saved experiment metadata\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n7. SAVED EXPERIMENT METADATA\")\n",
            "\n",
            "results_directory = Path(\n",
            "    \"/content/drive/MyDrive/Experiment_18_Results\"\n",
            ")\n",
            "\n",
            "metadata_files = []\n",
            "\n",
            "if results_directory.exists():\n",
            "\n",
            "    print(\"Results directory found:\", results_directory)\n",
            "\n",
            "    metadata_files = sorted(\n",
            "        results_directory.glob(\"*.json\")\n",
            "    )\n",
            "\n",
            "    if metadata_files:\n",
            "\n",
            "        for metadata_file in metadata_files:\n",
            "\n",
            "            print(\"\\nMetadata file:\", metadata_file.name)\n",
            "\n",
            "            try:\n",
            "\n",
            "                with open(metadata_file, \"r\") as file:\n",
            "                    metadata = json.load(file)\n",
            "\n",
            "                print(json.dumps(metadata, indent=2))\n",
            "\n",
            "                # Identify older detector statistical records.\n",
            "                if \"detector_statistical_tests\" in metadata:\n",
            "\n",
            "                    print(\n",
            "                        \"\\nWARNING: This file contains detector \"\n",
            "                        \"statistical results from an earlier analysis.\"\n",
            "                    )\n",
            "\n",
            "                    print(\n",
            "                        \"These entries must be treated as historical \"\n",
            "                        \"and superseded by the corrected Step 17.10.2 \"\n",
            "                        \"validation results.\"\n",
            "                    )\n",
            "\n",
            "                    historical_tests = pd.DataFrame(\n",
            "                        metadata[\"detector_statistical_tests\"]\n",
            "                    )\n",
            "\n",
            "                    display(historical_tests)\n",
            "\n",
            "                    print(\n",
            "                        \"Metadata interpretation: \"\n",
            "                        \"HISTORICAL / SUPERSEDED DETECTOR RESULTS\"\n",
            "                    )\n",
            "\n",
            "                # Identify older detector effect-size records.\n",
            "                if \"detector_effect_sizes\" in metadata:\n",
            "\n",
            "                    print(\n",
            "                        \"Historical detector effect-size records \"\n",
            "                        \"are present in this metadata file.\"\n",
            "                    )\n",
            "\n",
            "                    print(\n",
            "                        \"They are not treated as the corrected \"\n",
            "                        \"Step 17.10.2 effect-size results.\"\n",
            "                    )\n",
            "\n",
            "            except Exception as error:\n",
            "\n",
            "                print(\n",
            "                    \"Could not read metadata:\",\n",
            "                    str(error)\n",
            "                )\n",
            "\n",
            "    else:\n",
            "\n",
            "        print(\"No JSON metadata files found.\")\n",
            "\n",
            "else:\n",
            "\n",
            "    print(\n",
            "        \"Previously recorded results directory is not acc\n",
            "\n",
            "---------------------------------------------------------------------------\n",
            "CELL 119 | TYPE: code\n",
            "Matched terms: common_positions, original_embeddings, low_illumination_embeddings, high_illumination_embeddings, paired_labels\n",
            "---------------------------------------------------------------------------\n",
            "\n",
            "# ============================================================\n",
            "# EXPERIMENT 18 — STEP 17.10.4\n",
            "# SAVED RESULTS AND OUTPUT VERIFICATION\n",
            "# ============================================================\n",
            "\n",
            "import os\n",
            "import json\n",
            "import numpy as np\n",
            "import pandas as pd\n",
            "from pathlib import Path\n",
            "from IPython.display import display\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 1. Define existing results directory\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "results_dir = Path(\n",
            "    \"/content/drive/MyDrive/Experiment_18_Results\"\n",
            ")\n",
            "\n",
            "print(\"=\" * 75)\n",
            "print(\"EXPERIMENT 18 — STEP 17.10.4\")\n",
            "print(\"SAVED RESULTS AND OUTPUT VERIFICATION\")\n",
            "print(\"=\" * 75)\n",
            "\n",
            "assert results_dir.exists(), (\n",
            "    f\"Results directory not found: {results_dir}. \"\n",
            "    \"Check Google Drive mounting and directory path.\"\n",
            ")\n",
            "\n",
            "print(\"\\n1. RESULTS DIRECTORY\")\n",
            "print(\"Directory:\", results_dir)\n",
            "print(\"Directory exists: YES\")\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 2. Inventory saved files\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n2. SAVED FILE INVENTORY\")\n",
            "\n",
            "saved_files = sorted(\n",
            "    file for file in results_dir.rglob(\"*\")\n",
            "    if file.is_file()\n",
            ")\n",
            "\n",
            "file_inventory = []\n",
            "\n",
            "for file in saved_files:\n",
            "\n",
            "    size_kb = file.stat().st_size / 1024\n",
            "\n",
            "    file_inventory.append({\n",
            "        \"File\": str(file.relative_to(results_dir)),\n",
            "        \"Size (KB)\": round(size_kb, 2),\n",
            "        \"Extension\": file.suffix.lower()\n",
            "    })\n",
            "\n",
            "if file_inventory:\n",
            "    display(pd.DataFrame(file_inventory))\n",
            "else:\n",
            "    print(\"No saved files found.\")\n",
            "\n",
            "print(\"Total saved files:\", len(saved_files))\n",
            "\n",
            "npz_files = [\n",
            "    f for f in saved_files if f.suffix.lower() == \".npz\"\n",
            "]\n",
            "\n",
            "npy_files = [\n",
            "    f for f in saved_files if f.suffix.lower() == \".npy\"\n",
            "]\n",
            "\n",
            "csv_files = [\n",
            "    f for f in saved_files if f.suffix.lower() == \".csv\"\n",
            "]\n",
            "\n",
            "json_files = [\n",
            "    f for f in saved_files if f.suffix.lower() == \".json\"\n",
            "]\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 3. Inspect NumPy archives without modifying them\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n3. NUMPY ARCHIVE INSPECTION\")\n",
            "\n",
            "numpy_archive_records = []\n",
            "\n",
            "for file in npz_files:\n",
            "\n",
            "    print(\"\\nArchive:\", file.name)\n",
            "\n",
            "    try:\n",
            "\n",
            "        with np.load(file, allow_pickle=False) as archive:\n",
            "\n",
            "            for key in archive.files:\n",
            "\n",
            "                array = archive[key]\n",
            "\n",
            "                finite = (\n",
            "                    bool(np.isfinite(array).all())\n",
            "                    if np.issubdtype(array.dtype, np.number)\n",
            "                    else None\n",
            "                )\n",
            "\n",
            "                record = {\n",
            "                    \"Archive\": file.name,\n",
            "                    \"Key\": key,\n",
            "                    \"Shape\": str(array.shape),\n",
            "                    \"Dtype\": str(array.dtype),\n",
            "                    \"Finite\": finite\n",
            "                }\n",
            "\n",
            "                numpy_archive_records.append(record)\n",
            "\n",
            "                print(\n",
            "                    f\"{key}: shape={array.shape}, \"\n",
            "                    f\"dtype={array.dtype}, finite={finite}\"\n",
            "                )\n",
            "\n",
            "    except Exception as error:\n",
            "\n",
            "        print(\"Archive inspection error:\", str(error))\n",
            "\n",
            "if numpy_archive_records:\n",
            "    display(pd.DataFrame(numpy_archive_records))\n",
            "\n",
            "# Inspect standalone NPY files, if present.\n",
            "\n",
            "for file in npy_files:\n",
            "\n",
            "    print(\"\\nNPY file:\", file.name)\n",
            "\n",
            "    try:\n",
            "\n",
            "        array = np.load(file, allow_pickle=False)\n",
            "\n",
            "        print(\"Shape:\", array.shape)\n",
            "        print(\"Dtype:\", array.dtype)\n",
            "\n",
            "        if np.issubdtype(array.dtype, np.number):\n",
            "            print(\"All values finite:\", np.isfinite(array).all())\n",
            "\n",
            "    except Exception as error:\n",
            "\n",
            "        print(\"NPY inspection error:\", str(error))\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 4. Verify illumination archive structure\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n4. ILLUMINATION ARCHIVE VALIDATION\")\n",
            "\n",
            "illumination_archive = (\n",
            "    results_dir / \"experiment18_illumination_results.npz\"\n",
            ")\n",
            "\n",
            "if illumination_archive.exists():\n",
            "\n",
            "    with np.load(\n",
            "        illumination_archive,\n",
            "        allow_pickle=False\n",
            "    ) as archive:\n",
            "\n",
            "        required_keys = [\n",
            "            \"original_embeddings\",\n",
            "            \"low_illumination_embeddings\",\n",
            "            \"high_illumination_embeddings\",\n",
            "            \"paired_labels\",\n",
            "            \"common_positions\",\n",
            "            \"low_displacement\",\n",
            "            \"high_displacement\"\n",
            "        ]\n",
            "\n",
            "        missing_keys = [\n",
            "            key for key in required_keys\n",
            "            if key not in archive.files\n",
            "        ]\n",
            "\n",
            "        assert not missing_keys, (\n",
            "            f\"Missing illumination archive keys: {missing_keys}\"\n",
            "        )\n",
            "\n",
            "        expected_shapes = {\n",
            "            \"original_embeddings\": (889, 512),\n",
            "            \"low_illumination_embeddings\": (889, 512),\n",
            "            \"high_illumination_embeddings\": (889, 512),\n",
            "            \"paired_labels\": (889,),\n",
            "            \"common_positions\": (889,),\n",
            "            \"low_displacement\": (889,),\n",
            "            \"high_displacement\": (889,)\n",
            "        }\n",
            "\n",
            "        archive_checks = []\n",
            "\n",
            "        for key, expected_shape in expected_shapes.items():\n",
            "\n",
            "            actual = archive[key]\n",
            "\n",
            "            shape_passed = actual.shape == expected_shape\n",
            "\n",
            "            finite_passed = (\n",
            "                np.isfinite(actual).all()\n",
            "                if np.issubdtype(actual.dtype, np.number)\n",
            "                else True\n",
            "            )\n",
            "\n",
            "            assert shape_passed, (\n",
            "                f\"{key}: expected {expected_shape}, \"\n",
            "                f\"found {actual.shape}\"\n",
            "            )\n",
            "\n",
            "            assert finite_passed, (\n",
            "                f\"{key}: non-finite numerical values found.\"\n",
            "            )\n",
            "\n",
            "            archive_checks.append({\n",
            "                \"Array\": key,\n",
            "                \"Actual Shape\": str(actual.shape),\n",
            "                \"Expected Shape\": str(expected_shape),\n",
            "                \"Status\": \"PASSED\"\n",
            "            })\n",
            "\n",
            "        display(pd.DataFrame(archive_checks))\n",
            "\n",
            "        print(\n",
            "            \"Full paired illumination archive validation: PASSED\"\n",
            "        )\n",
            "\n",
            "else:\n",
            "\n",
            "    print(\"Illumination archive not found.\")\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 5. Inspect CSV files\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n5. CSV FILE INSPECTION\")\n",
            "\n",
            "csv_inventory = []\n",
            "\n",
            "for file in csv_files:\n",
            "\n",
            "    print(\"\\nCSV file:\", file.name)\n",
            "\n",
            "    try:\n",
            "\n",
            "        dataframe = pd.read_csv(file)\n",
            "\n",
            "        print(\"Rows:\", len(dataframe))\n",
            "        print(\"Columns:\", list(dataframe.columns))\n",
            "        print(\"Empty:\", dataframe.empty)\n",
            "\n",
            "        csv_inventory.append({\n",
            "            \"File\": file.name,\n",
            "            \"Rows\": len(dataframe),\n",
            "            \"Columns\": len(dataframe.columns),\n",
            "            \"Empty\": dataframe.empty\n",
            "        })\n",
            "\n",
            "        display(dataframe.head(3))\n",
            "\n",
            "    except Exception as error:\n",
            "\n",
            "        print(\"CSV inspection error:\", str(error))\n",
            "\n",
            "if csv_inventory:\n",
            "    display(pd.DataFrame(csv_inventory))\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 6. Inspect JSON metadata files\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n6. JSON METADATA INSPECTION\")\n",
            "\n",
            "metadata_records = {}\n",
            "\n",
            "for file in json_files:\n",
            "\n",
            "    print(\"\\nJSON file:\", file.name)\n",
            "\n",
            "    try:\n",
            "\n",
            "        with open(file, \"r\", encoding=\"utf-8\") as handle:\n",
            "            metadata = json.load(handle)\n",
            "\n",
            "        metadata_records[file.name] = metadata\n",
            "\n",
            "        print(\"Top-level metadata keys:\")\n",
            "        print(list(metadata.keys()))\n",
            "\n",
            "    except Exception as error:\n",
            "\n",
            "        print(\"JSON inspection error:\", str(error))\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 7. Validate illumination metadata\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n7. ILLUMINATION METADATA VALIDATION\")\n",
            "\n",
            "illumination_metadata = metadata_records.get(\n",
            "    \"illumination_metadata.json\"\n",
            ")\n",
            "\n",
            "if illumination_metadata is not None:\n",
            "\n",
            "    expected_metadata = {\n",
            "        \"dataset\": \"LFW filtered subset\",\n",
            "        \"model\": \"InceptionResnetV1\",\n",
            "        \"pretrained_weights\": \"VGGFace2\",\n",
            "        \"embedding_dimension\": 512,\n",
            "        \"paired_images\": 889,\n",
            "        \"evaluation_identities\": 13\n",
            "    }\n",
            "\n",
            "    metadata_checks = []\n",
            "\n",
            "    for key, expected_value in expected_metadata.items():\n",
            "\n",
            "        actual_value = illumination_metadata.get(key)\n",
            "\n",
            "        passed = actual_value == expected_value\n",
            "\n",
            "        metadata_checks.append({\n",
            "            \"Field\": key,\n",
            "            \"Recorded Value\": actual_value,\n",
            "            \"Expected Value\": expected_value,\n",
            "            \"Status\": \"PASSED\" if passed else \"REVIEW\"\n",
            "        })\n",
            "\n",
            "    display(pd.DataFrame(metadata_checks))\n",
            "\n",
            "    print(\"\\nSaved illumination displacement statistics:\")\n",
            "\n",
            "    displacement_fields = [\n",
            "        \"image_level_wilcoxon_p\",\n",
            "        \"identity_level_wilcoxon_p\",\n",
            "        \"mean_low_displacement\",\n",
            "        \"mean_high_displacement\"\n",
            "    ]\n",
            "\n",
            "    for key in displacement_fields:\n",
            "        print(f\"{key}: {illumination_metadata.get(key, 'NOT FOUND')}\")\n",
            "\n",
            "    print(\n",
            "        \"\\nThese values belong to the saved illumination-displacement \"\n",
            "        \"analysis. They are not the corrected detector-response \"\n",
            "        \"Wilcoxon results from Step 17.10.2.\"\n",
            "    )\n",
            "\n",
            "else:\n",
            "\n",
            "    print(\"illumination_metadata.json not found or unreadable.\")\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 8. Validate corrected detector statistical results\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n8. CORRECTED STEP 17 DETECTOR STATISTICAL RESULTS\")\n",
            "\n",
            "expected_detector_results = {\n",
            "    \"Euclidean\": {\n",
            "        \"Wilcoxon Statistic\": 13.0,\n",
            "        \"P-value\": 0.021484\n",
            "    },\n",
            "    \"Mahalanobis\": {\n",
            "        \"Wilcoxon Statistic\": 5.0,\n",
            "        \"P-value\": 0.002441\n",
            "    }\n",
            "}\n",
            "\n",
            "# Step 17.10.2 uses statistical_results.\n",
            "# Do not substitute statistical_test_df or historical values.\n",
            "\n",
            "if \"statistical_results\" in globals():\n",
            "\n",
            "    current_statistics = statistical_results.copy()\n",
            "\n",
            "    required_columns = [\n",
            "        \"Detector\",\n",
            "        \"Wilcoxon Statistic\",\n",
            "        \"P-value\"\n",
            "    ]\n",
            "\n",
            "    for column in required_columns:\n",
            "        assert column in current_statistics.columns, (\n",
            "            f\"Missing column in statistical_results: {column}\"\n",
            "        )\n",
            "\n",
            "    current_statistics = current_statistics.set_index(\"Detector\")\n",
            "\n",
            "---------------------------------------------------------------------------\n",
            "CELL 123 | TYPE: code\n",
            "Matched terms: original_embeddings, low_illumination_embeddings, high_illumination_embeddings, paired_labels\n",
            "---------------------------------------------------------------------------\n",
            "# ============================================================\n",
            "# EXPERIMENT 18 — STEP 17.10.5.1\n",
            "# Load and Verify Saved Illumination Data\n",
            "# ============================================================\n",
            "\n",
            "import numpy as np\n",
            "import json\n",
            "from pathlib import Path\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 1. Locate existing saved results\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "results_dir = Path(\"/content/drive/MyDrive/Experiment_18_Results\")\n",
            "\n",
            "npz_path = results_dir / \"experiment18_illumination_results.npz\"\n",
            "metadata_path = results_dir / \"illumination_metadata.json\"\n",
            "\n",
            "print(\"=\" * 75)\n",
            "print(\"STEP 17.10.5.1 — SAVED ILLUMINATION DATA VERIFICATION\")\n",
            "print(\"=\" * 75)\n",
            "\n",
            "assert results_dir.exists(), \"Results directory does not exist.\"\n",
            "assert npz_path.exists(), \"Illumination NPZ file not found.\"\n",
            "assert metadata_path.exists(), \"Illumination metadata file not found.\"\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 2. Load existing arrays (read-only inspection)\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "with np.load(npz_path, allow_pickle=False) as data:\n",
            "\n",
            "    original_embeddings = data[\"original_embeddings\"].copy()\n",
            "    low_illumination_embeddings = data[\"low_illumination_embeddings\"].copy()\n",
            "    high_illumination_embeddings = data[\"high_illumination_embeddings\"].copy()\n",
            "\n",
            "    paired_labels = data[\"paired_labels\"].copy()\n",
            "\n",
            "    saved_low_displacement = data[\"low_displacement\"].copy()\n",
            "    saved_high_displacement = data[\"high_displacement\"].copy()\n",
            "\n",
            "# Load metadata\n",
            "with open(metadata_path, \"r\", encoding=\"utf-8\") as f:\n",
            "    illumination_metadata = json.load(f)\n",
            "\n",
            "print(\"\\n[1] FILE LOADING\")\n",
            "print(\"Illumination NPZ loaded: SUCCESS\")\n",
            "print(\"Metadata JSON loaded: SUCCESS\")\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 3. Inspect array dimensions\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n[2] ARRAY DIMENSIONS\")\n",
            "\n",
            "arrays = {\n",
            "    \"Original embeddings\": original_embeddings,\n",
            "    \"Low illumination embeddings\": low_illumination_embeddings,\n",
            "    \"High illumination embeddings\": high_illumination_embeddings,\n",
            "    \"Paired labels\": paired_labels,\n",
            "    \"Saved low displacement\": saved_low_displacement,\n",
            "    \"Saved high displacement\": saved_high_displacement\n",
            "}\n",
            "\n",
            "for name, array in arrays.items():\n",
            "    print(f\"{name}: {array.shape}\")\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 4. Verify sample alignment\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n[3] SAMPLE ALIGNMENT\")\n",
            "\n",
            "sample_counts = [len(array) for array in arrays.values()]\n",
            "\n",
            "alignment_passed = len(set(sample_counts)) == 1\n",
            "\n",
            "print(\"Sample counts:\", sample_counts)\n",
            "print(\"All sample counts equal:\", alignment_passed)\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 5. Verify embedding dimensions\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n[4] EMBEDDING DIMENSION\")\n",
            "\n",
            "embedding_dimensions = [\n",
            "    original_embeddings.shape[1],\n",
            "    low_illumination_embeddings.shape[1],\n",
            "    high_illumination_embeddings.shape[1]\n",
            "]\n",
            "\n",
            "dimension_passed = (\n",
            "    len(set(embedding_dimensions)) == 1\n",
            "    and embedding_dimensions[0] == 512\n",
            ")\n",
            "\n",
            "print(\"Embedding dimensions:\", embedding_dimensions)\n",
            "print(\"512-dimensional embeddings verified:\", dimension_passed)\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 6. Verify numerical validity\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n[5] NUMERICAL VALIDITY\")\n",
            "\n",
            "finite_checks = {}\n",
            "\n",
            "for name, array in arrays.items():\n",
            "    finite_checks[name] = bool(np.isfinite(array).all())\n",
            "\n",
            "    print(\n",
            "        f\"{name}: \"\n",
            "        f\"{'PASS' if finite_checks[name] else 'FAIL'}\"\n",
            "    )\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 7. Verify identity information\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n[6] IDENTITY VERIFICATION\")\n",
            "\n",
            "unique_identities = np.unique(paired_labels)\n",
            "\n",
            "print(\"Number of identities:\", len(unique_identities))\n",
            "print(\"Identity labels:\", unique_identities.tolist())\n",
            "\n",
            "identity_count_passed = (\n",
            "    len(unique_identities)\n",
            "    == illumination_metadata.get(\"evaluation_identities\")\n",
            ")\n",
            "\n",
            "print(\"Metadata identity count matches:\", identity_count_passed)\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 8. Verify metadata sample count\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n[7] METADATA SAMPLE COUNT\")\n",
            "\n",
            "metadata_sample_count = illumination_metadata.get(\"paired_images\")\n",
            "\n",
            "sample_count_passed = (\n",
            "    metadata_sample_count == len(paired_labels)\n",
            ")\n",
            "\n",
            "print(\"Saved paired images:\", metadata_sample_count)\n",
            "print(\"Actual paired labels:\", len(paired_labels))\n",
            "print(\"Metadata sample count matches:\", sample_count_passed)\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 9. Display saved statistical results\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n[8] EXISTING METADATA STATISTICS\")\n",
            "\n",
            "metadata_statistics = [\n",
            "    \"image_level_wilcoxon_p\",\n",
            "    \"identity_level_wilcoxon_p\",\n",
            "    \"mean_low_displacement\",\n",
            "    \"mean_high_displacement\"\n",
            "]\n",
            "\n",
            "for key in metadata_statistics:\n",
            "    print(f\"{key}: {illumination_metadata.get(key)}\")\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 10. Final validation\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "all_checks_passed = (\n",
            "    alignment_passed\n",
            "    and dimension_passed\n",
            "    and all(finite_checks.values())\n",
            "    and identity_count_passed\n",
            "    and sample_count_passed\n",
            ")\n",
            "\n",
            "print(\"\\n\" + \"=\" * 75)\n",
            "\n",
            "if all_checks_passed:\n",
            "    print(\"STEP 17.10.5.1 STATUS: PASSED\")\n",
            "else:\n",
            "    print(\"STEP 17.10.5.1 STATUS: REVIEW REQUIRED\")\n",
            "\n",
            "print(\"=\" * 75)\n",
            "\n",
            "---------------------------------------------------------------------------\n",
            "CELL 124 | TYPE: code\n",
            "Matched terms: original_embeddings, low_illumination_embeddings, high_illumination_embeddings\n",
            "---------------------------------------------------------------------------\n",
            "# ============================================================\n",
            "# EXPERIMENT 18 — STEP 17.10.5.2\n",
            "# Independent Displacement Recalculation\n",
            "# ============================================================\n",
            "\n",
            "import numpy as np\n",
            "import pandas as pd\n",
            "\n",
            "print(\"=\" * 75)\n",
            "print(\"STEP 17.10.5.2 — INDEPENDENT DISPLACEMENT VERIFICATION\")\n",
            "print(\"=\" * 75)\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 1. Independently recalculate embedding displacement\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "recalculated_low_displacement = np.linalg.norm(\n",
            "    low_illumination_embeddings - original_embeddings,\n",
            "    axis=1\n",
            ")\n",
            "\n",
            "recalculated_high_displacement = np.linalg.norm(\n",
            "    high_illumination_embeddings - original_embeddings,\n",
            "    axis=1\n",
            ")\n",
            "\n",
            "print(\"\\n[1] DISPLACEMENT RECALCULATION\")\n",
            "print(\"Low displacement shape:\", recalculated_low_displacement.shape)\n",
            "print(\"High displacement shape:\", recalculated_high_displacement.shape)\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 2. Compare recalculated values with saved arrays\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "low_absolute_difference = np.abs(\n",
            "    recalculated_low_displacement - saved_low_displacement\n",
            ")\n",
            "\n",
            "high_absolute_difference = np.abs(\n",
            "    recalculated_high_displacement - saved_high_displacement\n",
            ")\n",
            "\n",
            "low_match = np.allclose(\n",
            "    recalculated_low_displacement,\n",
            "    saved_low_displacement,\n",
            "    rtol=1e-5,\n",
            "    atol=1e-6\n",
            ")\n",
            "\n",
            "high_match = np.allclose(\n",
            "    recalculated_high_displacement,\n",
            "    saved_high_displacement,\n",
            "    rtol=1e-5,\n",
            "    atol=1e-6\n",
            ")\n",
            "\n",
            "print(\"\\n[2] SAVED ARRAY COMPARISON\")\n",
            "\n",
            "print(\"Low displacement matches:\", low_match)\n",
            "print(\"High displacement matches:\", high_match)\n",
            "\n",
            "print(\"Low maximum absolute difference:\",\n",
            "      np.max(low_absolute_difference))\n",
            "\n",
            "print(\"High maximum absolute difference:\",\n",
            "      np.max(high_absolute_difference))\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 3. Compare descriptive statistics\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "displacement_summary = pd.DataFrame([\n",
            "    {\n",
            "        \"Condition\": \"Low illumination\",\n",
            "        \"Saved Mean\": np.mean(saved_low_displacement),\n",
            "        \"Recalculated Mean\": np.mean(recalculated_low_displacement),\n",
            "        \"Saved Median\": np.median(saved_low_displacement),\n",
            "        \"Recalculated Median\": np.median(recalculated_low_displacement),\n",
            "        \"Saved Std\": np.std(saved_low_displacement),\n",
            "        \"Recalculated Std\": np.std(recalculated_low_displacement)\n",
            "    },\n",
            "    {\n",
            "        \"Condition\": \"High illumination\",\n",
            "        \"Saved Mean\": np.mean(saved_high_displacement),\n",
            "        \"Recalculated Mean\": np.mean(recalculated_high_displacement),\n",
            "        \"Saved Median\": np.median(saved_high_displacement),\n",
            "        \"Recalculated Median\": np.median(recalculated_high_displacement),\n",
            "        \"Saved Std\": np.std(saved_high_displacement),\n",
            "        \"Recalculated Std\": np.std(recalculated_high_displacement)\n",
            "    }\n",
            "])\n",
            "\n",
            "print(\"\\n[3] DESCRIPTIVE STATISTICS\")\n",
            "display(displacement_summary)\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 4. Compare recalculated means with metadata\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "metadata_low_mean = illumination_metadata[\"mean_low_displacement\"]\n",
            "metadata_high_mean = illumination_metadata[\"mean_high_displacement\"]\n",
            "\n",
            "recalculated_low_mean = np.mean(recalculated_low_displacement)\n",
            "recalculated_high_mean = np.mean(recalculated_high_displacement)\n",
            "\n",
            "low_metadata_match = np.isclose(\n",
            "    recalculated_low_mean,\n",
            "    metadata_low_mean,\n",
            "    rtol=1e-5,\n",
            "    atol=1e-6\n",
            ")\n",
            "\n",
            "high_metadata_match = np.isclose(\n",
            "    recalculated_high_mean,\n",
            "    metadata_high_mean,\n",
            "    rtol=1e-5,\n",
            "    atol=1e-6\n",
            ")\n",
            "\n",
            "print(\"\\n[4] METADATA MEAN COMPARISON\")\n",
            "\n",
            "print(\"Saved low mean:\", metadata_low_mean)\n",
            "print(\"Recalculated low mean:\", recalculated_low_mean)\n",
            "print(\"Low metadata match:\", low_metadata_match)\n",
            "\n",
            "print(\"\\nSaved high mean:\", metadata_high_mean)\n",
            "print(\"Recalculated high mean:\", recalculated_high_mean)\n",
            "print(\"High metadata match:\", high_metadata_match)\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 5. Final verification\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "all_displacement_checks_passed = (\n",
            "    low_match\n",
            "    and high_match\n",
            "    and low_metadata_match\n",
            "    and high_metadata_match\n",
            ")\n",
            "\n",
            "print(\"\\n\" + \"=\" * 75)\n",
            "\n",
            "if all_displacement_checks_passed:\n",
            "    print(\"STEP 17.10.5.2 STATUS: PASSED\")\n",
            "else:\n",
            "    print(\"STEP 17.10.5.2 STATUS: REVIEW REQUIRED\")\n",
            "\n",
            "print(\"=\" * 75)\n",
            "\n",
            "---------------------------------------------------------------------------\n",
            "CELL 126 | TYPE: code\n",
            "Matched terms: paired_labels\n",
            "---------------------------------------------------------------------------\n",
            "# ============================================================\n",
            "# EXPERIMENT 18 — STEP 17.10.5.4\n",
            "# Independent Identity-Level Statistical Verification\n",
            "# ============================================================\n",
            "\n",
            "import numpy as np\n",
            "import pandas as pd\n",
            "from scipy.stats import wilcoxon\n",
            "\n",
            "print(\"=\" * 75)\n",
            "print(\"STEP 17.10.5.4 — IDENTITY-LEVEL STATISTICAL VERIFICATION\")\n",
            "print(\"=\" * 75)\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 1. Construct image-level displacement DataFrame\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "illumination_df = pd.DataFrame({\n",
            "    \"Identity\": paired_labels,\n",
            "    \"Low_Displacement\": saved_low_displacement,\n",
            "    \"High_Displacement\": saved_high_displacement\n",
            "})\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 2. Aggregate displacement by identity\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "identity_displacement_df = (\n",
            "    illumination_df\n",
            "    .groupby(\"Identity\")\n",
            "    .agg(\n",
            "        Image_Count=(\"Low_Displacement\", \"count\"),\n",
            "        Low_Mean=(\"Low_Displacement\", \"mean\"),\n",
            "        High_Mean=(\"High_Displacement\", \"mean\"),\n",
            "        Low_Median=(\"Low_Displacement\", \"median\"),\n",
            "        High_Median=(\"High_Displacement\", \"median\")\n",
            "    )\n",
            "    .reset_index()\n",
            ")\n",
            "\n",
            "identity_displacement_df[\"Mean_Difference\"] = (\n",
            "    identity_displacement_df[\"High_Mean\"]\n",
            "    - identity_displacement_df[\"Low_Mean\"]\n",
            ")\n",
            "\n",
            "identity_displacement_df[\"Median_Difference\"] = (\n",
            "    identity_displacement_df[\"High_Median\"]\n",
            "    - identity_displacement_df[\"Low_Median\"]\n",
            ")\n",
            "\n",
            "print(\"\\n[1] IDENTITY-LEVEL DISPLACEMENT SUMMARY\")\n",
            "display(identity_displacement_df)\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 3. Calculate paired identity-level Wilcoxon test\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "identity_level_test = wilcoxon(\n",
            "    identity_displacement_df[\"High_Mean\"],\n",
            "    identity_displacement_df[\"Low_Mean\"],\n",
            "    alternative=\"two-sided\"\n",
            ")\n",
            "\n",
            "recalculated_identity_p = identity_level_test.pvalue\n",
            "\n",
            "saved_identity_p = illumination_metadata[\n",
            "    \"identity_level_wilcoxon_p\"\n",
            "]\n",
            "\n",
            "print(\"\\n[2] IDENTITY-LEVEL WILCOXON TEST\")\n",
            "\n",
            "print(\"Number of identities:\", len(identity_displacement_df))\n",
            "print(\"Wilcoxon statistic:\", identity_level_test.statistic)\n",
            "print(\"Recalculated p-value:\", recalculated_identity_p)\n",
            "print(\"Saved metadata p-value:\", saved_identity_p)\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 4. Compare metadata p-value\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "identity_p_match = np.isclose(\n",
            "    recalculated_identity_p,\n",
            "    saved_identity_p,\n",
            "    rtol=1e-5,\n",
            "    atol=1e-12\n",
            ")\n",
            "\n",
            "print(\"\\n[3] METADATA CONSISTENCY\")\n",
            "print(\"Identity-level p-value matches:\", identity_p_match)\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 5. Descriptive identity-level statistics\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "identity_differences = identity_displacement_df[\n",
            "    \"Mean_Difference\"\n",
            "].to_numpy()\n",
            "\n",
            "print(\"\\n[4] IDENTITY-LEVEL PAIRED DIFFERENCES\")\n",
            "\n",
            "print(\"Mean difference:\", np.mean(identity_differences))\n",
            "print(\"Median difference:\", np.median(identity_differences))\n",
            "print(\"Positive identities:\", np.sum(identity_differences > 0))\n",
            "print(\"Negative identities:\", np.sum(identity_differences < 0))\n",
            "print(\"Zero identities:\", np.sum(identity_differences == 0))\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 6. Final result summary\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "identity_level_summary = pd.DataFrame([{\n",
            "    \"Identities\": len(identity_displacement_df),\n",
            "    \"Mean Difference\": np.mean(identity_differences),\n",
            "    \"Median Difference\": np.median(identity_differences),\n",
            "    \"Positive\": np.sum(identity_differences > 0),\n",
            "    \"Negative\": np.sum(identity_differences < 0),\n",
            "    \"Zero\": np.sum(identity_differences == 0),\n",
            "    \"Wilcoxon Statistic\": identity_level_test.statistic,\n",
            "    \"Recalculated P-value\": recalculated_identity_p,\n",
            "    \"Saved P-value\": saved_identity_p,\n",
            "    \"P-value Match\": identity_p_match\n",
            "}])\n",
            "\n",
            "print(\"\\n[5] IDENTITY-LEVEL RESULT SUMMARY\")\n",
            "display(identity_level_summary)\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 7. Final status\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n\" + \"=\" * 75)\n",
            "\n",
            "if identity_p_match:\n",
            "    print(\"STEP 17.10.5.4 STATUS: PASSED\")\n",
            "else:\n",
            "    print(\"STEP 17.10.5.4 STATUS: REVIEW REQUIRED\")\n",
            "\n",
            "print(\"=\" * 75)\n",
            "\n",
            "---------------------------------------------------------------------------\n",
            "CELL 129 | TYPE: code\n",
            "Matched terms: original_embeddings, low_illumination_embeddings, high_illumination_embeddings, paired_labels\n",
            "---------------------------------------------------------------------------\n",
            "# ============================================================\n",
            "# EXPERIMENT 18 — STEP 17.10.5.6\n",
            "# FINAL STATISTICAL CONSISTENCY AND REPRODUCIBILITY AUDIT\n",
            "# ============================================================\n",
            "\n",
            "import numpy as np\n",
            "import pandas as pd\n",
            "import json\n",
            "\n",
            "from pathlib import Path\n",
            "from scipy.stats import wilcoxon\n",
            "\n",
            "print(\"=\" * 80)\n",
            "print(\"STEP 17.10.5.6 — FINAL STATISTICAL CONSISTENCY AUDIT\")\n",
            "print(\"=\" * 80)\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 1. Load original saved files\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "results_dir = Path(\n",
            "    \"/content/drive/MyDrive/Experiment_18_Results\"\n",
            ")\n",
            "\n",
            "npz_path = results_dir / \"experiment18_illumination_results.npz\"\n",
            "metadata_path = results_dir / \"illumination_metadata.json\"\n",
            "csv_path = results_dir / \"illumination_identity_summary.csv\"\n",
            "\n",
            "assert npz_path.exists(), \"Illumination NPZ file missing.\"\n",
            "assert metadata_path.exists(), \"Metadata JSON missing.\"\n",
            "assert csv_path.exists(), \"Identity summary CSV missing.\"\n",
            "\n",
            "with np.load(npz_path, allow_pickle=False) as data:\n",
            "    original = data[\"original_embeddings\"].copy()\n",
            "    low = data[\"low_illumination_embeddings\"].copy()\n",
            "    high = data[\"high_illumination_embeddings\"].copy()\n",
            "    labels = data[\"paired_labels\"].copy()\n",
            "    saved_low = data[\"low_displacement\"].copy()\n",
            "    saved_high = data[\"high_displacement\"].copy()\n",
            "\n",
            "with open(metadata_path, \"r\", encoding=\"utf-8\") as f:\n",
            "    metadata = json.load(f)\n",
            "\n",
            "saved_csv = pd.read_csv(csv_path)\n",
            "\n",
            "print(\"\\n[1] SAVED FILES\")\n",
            "print(\"NPZ loaded: SUCCESS\")\n",
            "print(\"Metadata loaded: SUCCESS\")\n",
            "print(\"Identity CSV loaded: SUCCESS\")\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 2. Independently recalculate displacement\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "recalculated_low = np.linalg.norm(\n",
            "    low - original,\n",
            "    axis=1\n",
            ")\n",
            "\n",
            "recalculated_high = np.linalg.norm(\n",
            "    high - original,\n",
            "    axis=1\n",
            ")\n",
            "\n",
            "low_displacement_match = np.allclose(\n",
            "    recalculated_low,\n",
            "    saved_low,\n",
            "    rtol=1e-5,\n",
            "    atol=1e-6\n",
            ")\n",
            "\n",
            "high_displacement_match = np.allclose(\n",
            "    recalculated_high,\n",
            "    saved_high,\n",
            "    rtol=1e-5,\n",
            "    atol=1e-6\n",
            ")\n",
            "\n",
            "print(\"\\n[2] DISPLACEMENT REPRODUCTION\")\n",
            "print(\"Low displacement matches:\", low_displacement_match)\n",
            "print(\"High displacement matches:\", high_displacement_match)\n",
            "\n",
            "low_mean_match = np.isclose(\n",
            "    np.mean(recalculated_low),\n",
            "    metadata[\"mean_low_displacement\"],\n",
            "    rtol=1e-5,\n",
            "    atol=1e-6\n",
            ")\n",
            "\n",
            "high_mean_match = np.isclose(\n",
            "    np.mean(recalculated_high),\n",
            "    metadata[\"mean_high_displacement\"],\n",
            "    rtol=1e-5,\n",
            "    atol=1e-6\n",
            ")\n",
            "\n",
            "print(\"Low displacement mean matches metadata:\", low_mean_match)\n",
            "print(\"High displacement mean matches metadata:\", high_mean_match)\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 3. Recalculate image-level Wilcoxon test\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "image_test = wilcoxon(\n",
            "    recalculated_high,\n",
            "    recalculated_low,\n",
            "    alternative=\"two-sided\"\n",
            ")\n",
            "\n",
            "image_p_match = np.isclose(\n",
            "    image_test.pvalue,\n",
            "    metadata[\"image_level_wilcoxon_p\"],\n",
            "    rtol=1e-5,\n",
            "    atol=1e-12\n",
            ")\n",
            "\n",
            "print(\"\\n[3] IMAGE-LEVEL STATISTICAL REPRODUCTION\")\n",
            "print(\"Observations:\", len(labels))\n",
            "print(\"Wilcoxon statistic:\", image_test.statistic)\n",
            "print(\"Recalculated p-value:\", image_test.pvalue)\n",
            "print(\"Saved p-value:\", metadata[\"image_level_wilcoxon_p\"])\n",
            "print(\"P-value matches metadata:\", image_p_match)\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 4. Reconstruct identity-level mean and median summaries\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "audit_df = pd.DataFrame({\n",
            "    \"Identity\": labels,\n",
            "    \"Low_Displacement\": recalculated_low,\n",
            "    \"High_Displacement\": recalculated_high\n",
            "})\n",
            "\n",
            "identity_audit = (\n",
            "    audit_df\n",
            "    .groupby(\"Identity\")\n",
            "    .agg(\n",
            "        Image_Count=(\"Low_Displacement\", \"count\"),\n",
            "        Low_Mean=(\"Low_Displacement\", \"mean\"),\n",
            "        High_Mean=(\"High_Displacement\", \"mean\"),\n",
            "        Low_Median=(\"Low_Displacement\", \"median\"),\n",
            "        High_Median=(\"High_Displacement\", \"median\")\n",
            "    )\n",
            "    .reset_index()\n",
            ")\n",
            "\n",
            "identity_audit[\"Mean_Difference\"] = (\n",
            "    identity_audit[\"High_Mean\"]\n",
            "    - identity_audit[\"Low_Mean\"]\n",
            ")\n",
            "\n",
            "identity_audit[\"Median_Difference\"] = (\n",
            "    identity_audit[\"High_Median\"]\n",
            "    - identity_audit[\"Low_Median\"]\n",
            ")\n",
            "\n",
            "print(\"\\n[4] IDENTITY-LEVEL SUMMARY\")\n",
            "print(\"Number of identities:\", len(identity_audit))\n",
            "print(\"Positive mean differences:\",\n",
            "      (identity_audit[\"Mean_Difference\"] > 0).sum())\n",
            "print(\"Negative mean differences:\",\n",
            "      (identity_audit[\"Mean_Difference\"] < 0).sum())\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 5. Recalculate mean-based identity Wilcoxon test\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "mean_identity_test = wilcoxon(\n",
            "    identity_audit[\"High_Mean\"],\n",
            "    identity_audit[\"Low_Mean\"],\n",
            "    alternative=\"two-sided\"\n",
            ")\n",
            "\n",
            "mean_identity_p_match = np.isclose(\n",
            "    mean_identity_test.pvalue,\n",
            "    metadata[\"identity_level_wilcoxon_p\"],\n",
            "    rtol=1e-5,\n",
            "    atol=1e-12\n",
            ")\n",
            "\n",
            "print(\"\\n[5] MEAN-BASED IDENTITY TEST\")\n",
            "print(\"Wilcoxon statistic:\", mean_identity_test.statistic)\n",
            "print(\"Recalculated p-value:\", mean_identity_test.pvalue)\n",
            "print(\"Saved metadata p-value:\",\n",
            "      metadata[\"identity_level_wilcoxon_p\"])\n",
            "print(\"P-value matches metadata:\", mean_identity_p_match)\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 6. Recalculate median-based identity Wilcoxon test\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "median_identity_test = wilcoxon(\n",
            "    identity_audit[\"High_Median\"],\n",
            "    identity_audit[\"Low_Median\"],\n",
            "    alternative=\"two-sided\"\n",
            ")\n",
            "\n",
            "print(\"\\n[6] MEDIAN-BASED IDENTITY TEST\")\n",
            "print(\"Wilcoxon statistic:\", median_identity_test.statistic)\n",
            "print(\"Median-based p-value:\", median_identity_test.pvalue)\n",
            "\n",
            "print(\n",
            "    \"Mean-based and median-based p-values numerically equal:\",\n",
            "    np.isclose(\n",
            "        mean_identity_test.pvalue,\n",
            "        median_identity_test.pvalue\n",
            "    )\n",
            ")\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 7. Verify saved identity summary CSV\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "expected_csv = pd.DataFrame({\n",
            "    \"Identity\": identity_audit[\"Identity\"],\n",
            "    \"Image_Count\": identity_audit[\"Image_Count\"],\n",
            "    \"Low_Median\": identity_audit[\"Low_Median\"],\n",
            "    \"High_Median\": identity_audit[\"High_Median\"],\n",
            "    \"Median_Difference\": identity_audit[\"Median_Difference\"]\n",
            "})\n",
            "\n",
            "saved_csv_sorted = saved_csv.sort_values(\n",
            "    \"Identity\"\n",
            ").reset_index(drop=True)\n",
            "\n",
            "expected_csv_sorted = expected_csv.sort_values(\n",
            "    \"Identity\"\n",
            ").reset_index(drop=True)\n",
            "\n",
            "csv_columns = [\n",
            "    \"Identity\",\n",
            "    \"Image_Count\",\n",
            "    \"Low_Median\",\n",
            "    \"High_Median\",\n",
            "    \"Median_Difference\"\n",
            "]\n",
            "\n",
            "csv_checks = {}\n",
            "\n",
            "for column in csv_columns:\n",
            "    csv_checks[column] = np.allclose(\n",
            "        saved_csv_sorted[column].to_numpy(dtype=float),\n",
            "        expected_csv_sorted[column].to_numpy(dtype=float),\n",
            "        rtol=1e-5,\n",
            "        atol=1e-6\n",
            "    )\n",
            "\n",
            "print(\"\\n[7] SAVED CSV CONSISTENCY\")\n",
            "\n",
            "for column, passed in csv_checks.items():\n",
            "    print(f\"{column}: {'PASS' if passed else 'FAIL'}\")\n",
            "\n",
            "csv_passed = all(csv_checks.values())\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 8. Consolidated statistical results\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "consolidated_results = pd.DataFrame([\n",
            "    {\n",
            "        \"Analysis\": \"Image-level displacement\",\n",
            "        \"Observations\": len(labels),\n",
            "        \"Wilcoxon Statistic\": image_test.statistic,\n",
            "        \"P-value\": image_test.pvalue,\n",
            "        \"Metadata Match\": image_p_match\n",
            "    },\n",
            "    {\n",
            "        \"Analysis\": \"Mean-based identity displacement\",\n",
            "        \"Observations\": len(identity_audit),\n",
            "        \"Wilcoxon Statistic\": mean_identity_test.statistic,\n",
            "        \"P-value\": mean_identity_test.pvalue,\n",
            "        \"Metadata Match\": mean_identity_p_match\n",
            "    },\n",
            "    {\n",
            "        \"Analysis\": \"Median-based identity displacement\",\n",
            "        \"Observations\": len(identity_audit),\n",
            "        \"Wilcoxon Statistic\": median_identity_test.statistic,\n",
            "        \"P-value\": median_identity_test.pvalue,\n",
            "        \"Metadata Match\": \"Separate analysis\"\n",
            "    }\n",
            "])\n",
            "\n",
            "print(\"\\n[8] CONSOLIDATED STATISTICAL RESULTS\")\n",
            "display(consolidated_results)\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 9. Methodological validation\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n[9] METHODOLOGICAL INFORMATION\")\n",
            "\n",
            "print(\"Paired image observations:\", len(labels))\n",
            "print(\"Unique identities:\", len(np.unique(labels)))\n",
            "print(\"Image observations per identity:\")\n",
            "display(\n",
            "    identity_audit[[\"Identity\", \"Image_Count\"]]\n",
            ")\n",
            "\n",
            "print(\n",
            "    \"\\nIMPORTANT: Image observations are clustered within identities.\"\n",
            ")\n",
            "print(\n",
            "    \"The 889 image pairs must not be interpreted as 889 independent subjects.\"\n",
            ")\n",
            "print(\n",
            "    \"Identity-level inference is based on only 13 identities.\"\n",
            ")\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 10. Final audit status\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "audit_checks = {\n",
            "    \"Low displacement reproduction\": low_displacement_match,\n",
            "    \"High displacement reproduction\": high_displacement_match,\n",
            "    \"Low mean metadata consistency\": low_mean_match,\n",
            "    \"High mean metadata consistency\": high_mean_match,\n",
            "    \"Image-level Wilcoxon reproduction\": image_p_match,\n",
            "    \"Mean-based identity Wilcoxon reproduction\": mean_identity_p_match,\n",
            "    \"Saved identity CSV consistency\": csv_passed\n",
            "}\n",
            "\n",
            "print(\"\\n\" + \"=\" * 80)\n",
            "print(\"FINAL AUDIT CHECKLIST\")\n",
            "print(\"=\" * 80)\n",
            "\n",
            "for check_name, passed in audit_checks.items():\n",
            "    print(f\"{check_name}: {'PASS' if passed else 'FAIL'}\")\n",
            "\n",
            "all_passed = all(audit_checks.values())\n",
            "\n",
            "print(\"\\n\" + \"=\" * 80)\n",
            "\n",
            "if all_passed:\n",
            "    print(\"STEP 17.10.5.6 STATUS: PASSED\")\n",
            "    print(\"All saved statistical results were independently reproduced.\")\n",
            "else:\n",
            "    print(\"STEP 17.10.5.6 STATUS: REVIEW REQUIRED\")\n",
            "    print(\"At least one consistency check requires investigation.\")\n",
            "\n",
            "print(\"=\" * 80)\n",
            "\n",
            "print(\"\\nOriginal saved files modified: NO\")\n",
            "print(\"New embedding extraction performed: NO\")\n",
            "print(\"\n",
            "\n",
            "---------------------------------------------------------------------------\n",
            "CELL 131 | TYPE: code\n",
            "Matched terms: original_embeddings, low_illumination_embeddings, high_illumination_embeddings, paired_labels, low_success, high_success\n",
            "---------------------------------------------------------------------------\n",
            "\n",
            "# ============================================================\n",
            "# EXPERIMENT 18 — STEP 17.10.6.1\n",
            "# EXPERIMENTAL CONFIGURATION AND EVIDENCE CONSOLIDATION\n",
            "# ============================================================\n",
            "\n",
            "import os\n",
            "import sys\n",
            "import json\n",
            "import platform\n",
            "import numpy as np\n",
            "import pandas as pd\n",
            "import scipy\n",
            "import matplotlib\n",
            "import torch\n",
            "import torchvision\n",
            "\n",
            "from pathlib import Path\n",
            "from importlib.metadata import version, PackageNotFoundError\n",
            "\n",
            "print(\"=\" * 80)\n",
            "print(\"STEP 17.10.6.1 — EXPERIMENTAL CONFIGURATION AND EVIDENCE\")\n",
            "print(\"=\" * 80)\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 1. Locate saved experiment files\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "results_dir = Path(\n",
            "    \"/content/drive/MyDrive/Experiment_18_Results\"\n",
            ")\n",
            "\n",
            "assert results_dir.exists(), \"Experiment results directory not found.\"\n",
            "\n",
            "print(\"\\n[1] EXPERIMENT RESULTS DIRECTORY\")\n",
            "print(\"Directory:\", results_dir)\n",
            "\n",
            "for file in sorted(results_dir.iterdir()):\n",
            "    if file.is_file():\n",
            "        print(\n",
            "            f\"{file.name} | \"\n",
            "            f\"{file.stat().st_size / 1024:.2f} KB\"\n",
            "        )\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 2. Load original embedding extraction evidence\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "embedding_path = (\n",
            "    results_dir / \"experiment18_facenet_lfw_embeddings.npz\"\n",
            ")\n",
            "\n",
            "assert embedding_path.exists(), \"Original embedding NPZ not found.\"\n",
            "\n",
            "with np.load(embedding_path, allow_pickle=False) as data:\n",
            "\n",
            "    extraction_evidence = {}\n",
            "\n",
            "    for key in data.files:\n",
            "        value = data[key]\n",
            "\n",
            "        if value.ndim == 0:\n",
            "            extraction_evidence[key] = value.item()\n",
            "\n",
            "        else:\n",
            "            extraction_evidence[key] = {\n",
            "                \"shape\": value.shape,\n",
            "                \"dtype\": str(value.dtype),\n",
            "                \"finite\": (\n",
            "                    bool(np.isfinite(value).all())\n",
            "                    if np.issubdtype(value.dtype, np.number)\n",
            "                    else \"N/A\"\n",
            "                )\n",
            "            }\n",
            "\n",
            "assert \"evaluation_embeddings\" in extraction_evidence, (\n",
            "    \"Evaluation embeddings evidence is missing.\"\n",
            ")\n",
            "\n",
            "print(\"\\n[2] ORIGINAL EMBEDDING EXTRACTION EVIDENCE\")\n",
            "\n",
            "for key, value in extraction_evidence.items():\n",
            "    print(f\"{key}: {value}\")\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 3. Load controlled illumination metadata\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "metadata_path = results_dir / \"illumination_metadata.json\"\n",
            "\n",
            "assert metadata_path.exists(), \"Illumination metadata not found.\"\n",
            "\n",
            "with open(metadata_path, \"r\", encoding=\"utf-8\") as f:\n",
            "    illumination_metadata = json.load(f)\n",
            "\n",
            "print(\"\\n[3] CONTROLLED ILLUMINATION CONFIGURATION\")\n",
            "\n",
            "for key, value in illumination_metadata.items():\n",
            "    print(f\"{key}: {value}\")\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 4. Consolidate dataset and cohort characteristics\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "illumination_npz_path = (\n",
            "    results_dir / \"experiment18_illumination_results.npz\"\n",
            ")\n",
            "\n",
            "assert illumination_npz_path.exists(), (\n",
            "    \"Illumination results NPZ not found.\"\n",
            ")\n",
            "\n",
            "with np.load(\n",
            "    illumination_npz_path,\n",
            "    allow_pickle=False\n",
            ") as data:\n",
            "\n",
            "    original = data[\"original_embeddings\"].copy()\n",
            "    low = data[\"low_illumination_embeddings\"].copy()\n",
            "    high = data[\"high_illumination_embeddings\"].copy()\n",
            "    labels = data[\"paired_labels\"].copy()\n",
            "\n",
            "    low_success = data[\"low_success\"].copy()\n",
            "    high_success = data[\"high_success\"].copy()\n",
            "\n",
            "    low_failures = data[\"low_failures\"].copy()\n",
            "    high_failures = data[\"high_failures\"].copy()\n",
            "\n",
            "\n",
            "# Basic data integrity checks\n",
            "assert original.shape == low.shape == high.shape, (\n",
            "    \"Original, low and high embedding shapes do not match.\"\n",
            ")\n",
            "\n",
            "assert original.ndim == 2, (\n",
            "    \"Embedding arrays must be two-dimensional.\"\n",
            ")\n",
            "\n",
            "assert len(labels) == original.shape[0], (\n",
            "    \"Paired labels do not match the embedding count.\"\n",
            ")\n",
            "\n",
            "assert np.isfinite(original).all(), (\n",
            "    \"Original embeddings contain non-finite values.\"\n",
            ")\n",
            "\n",
            "assert np.isfinite(low).all(), (\n",
            "    \"Low illumination embeddings contain non-finite values.\"\n",
            ")\n",
            "\n",
            "assert np.isfinite(high).all(), (\n",
            "    \"High illumination embeddings contain non-finite values.\"\n",
            ")\n",
            "\n",
            "identity_counts = (\n",
            "    pd.Series(labels)\n",
            "    .value_counts()\n",
            "    .sort_index()\n",
            ")\n",
            "\n",
            "full_evaluation_count = (\n",
            "    extraction_evidence[\"evaluation_embeddings\"][\"shape\"][0]\n",
            ")\n",
            "\n",
            "paired_image_count = len(labels)\n",
            "identity_count = len(np.unique(labels))\n",
            "embedding_dimension = original.shape[1]\n",
            "\n",
            "cohort_summary = pd.DataFrame([\n",
            "    {\n",
            "        \"Metric\": \"Original evaluation embeddings (full archive)\",\n",
            "        \"Value\": full_evaluation_count\n",
            "    },\n",
            "    {\n",
            "        \"Metric\": \"Paired illumination images (historical cohort)\",\n",
            "        \"Value\": paired_image_count\n",
            "    },\n",
            "    {\n",
            "        \"Metric\": \"Corrected detector evaluation cohort (images)\",\n",
            "        \"Value\": 229\n",
            "    },\n",
            "    {\n",
            "        \"Metric\": \"Embedding dimension\",\n",
            "        \"Value\": embedding_dimension\n",
            "    },\n",
            "    {\n",
            "        \"Metric\": \"Identities in paired illumination cohort\",\n",
            "        \"Value\": identity_count\n",
            "    },\n",
            "    {\n",
            "        \"Metric\": \"Low illumination successful detections (full archive)\",\n",
            "        \"Value\": len(low_success)\n",
            "    },\n",
            "    {\n",
            "        \"Metric\": \"High illumination successful detections (full archive)\",\n",
            "        \"Value\": len(high_success)\n",
            "    },\n",
            "    {\n",
            "        \"Metric\": \"Low illumination failures (full archive)\",\n",
            "        \"Value\": len(low_failures)\n",
            "    },\n",
            "    {\n",
            "        \"Metric\": \"High illumination failures (full archive)\",\n",
            "        \"Value\": len(high_failures)\n",
            "    }\n",
            "])\n",
            "\n",
            "print(\"\\n[4] DATASET AND COHORT SUMMARY\")\n",
            "display(cohort_summary)\n",
            "\n",
            "print(\"\\nIDENTITY DISTRIBUTION\")\n",
            "\n",
            "identity_distribution = (\n",
            "    identity_counts\n",
            "    .rename(\"Image_Count\")\n",
            "    .reset_index()\n",
            ")\n",
            "\n",
            "identity_distribution.columns = [\n",
            "    \"Identity\",\n",
            "    \"Image_Count\"\n",
            "]\n",
            "\n",
            "display(identity_distribution)\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 5. Record software environment\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n[5] SOFTWARE AND EXECUTION ENVIRONMENT\")\n",
            "\n",
            "environment = {\n",
            "    \"Python\": sys.version.split()[0],\n",
            "    \"Platform\": platform.platform(),\n",
            "    \"NumPy\": np.__version__,\n",
            "    \"Pandas\": pd.__version__,\n",
            "    \"SciPy\": scipy.__version__,\n",
            "    \"Matplotlib\": matplotlib.__version__,\n",
            "    \"PyTorch\": torch.__version__,\n",
            "    \"Torchvision\": torchvision.__version__\n",
            "}\n",
            "\n",
            "for package in [\n",
            "    \"facenet-pytorch\",\n",
            "    \"scikit-learn\",\n",
            "    \"Pillow\"\n",
            "]:\n",
            "    try:\n",
            "        environment[package] = version(package)\n",
            "\n",
            "    except PackageNotFoundError:\n",
            "        environment[package] = \"Not installed or unavailable\"\n",
            "\n",
            "for key, value in environment.items():\n",
            "    print(f\"{key}: {value}\")\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 6. Consolidate detector analysis evidence\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n[6] DETECTOR ANALYSIS EVIDENCE\")\n",
            "\n",
            "detector_table_names = [\n",
            "    \"evaluation_detector_df\",\n",
            "    \"identity_detector_df\",\n",
            "    \"statistical_results\",\n",
            "    \"effect_size_df\"\n",
            "]\n",
            "\n",
            "detector_tables_available = {}\n",
            "\n",
            "for table_name in detector_table_names:\n",
            "\n",
            "    if table_name in globals():\n",
            "\n",
            "        table = globals()[table_name]\n",
            "\n",
            "        if isinstance(table, pd.DataFrame):\n",
            "\n",
            "            detector_tables_available[table_name] = True\n",
            "\n",
            "            print(f\"\\n{table_name}\")\n",
            "            print(\"Rows:\", len(table))\n",
            "            print(\"Columns:\", table.columns.tolist())\n",
            "\n",
            "            display(table)\n",
            "\n",
            "        else:\n",
            "            detector_tables_available[table_name] = False\n",
            "            print(f\"{table_name}: AVAILABLE BUT NOT A DATAFRAME\")\n",
            "\n",
            "    else:\n",
            "        detector_tables_available[table_name] = False\n",
            "        print(f\"{table_name}: NOT AVAILABLE IN CURRENT SESSION\")\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 7. Record independently verified illumination statistics\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "verified_illumination_results = pd.DataFrame([\n",
            "    {\n",
            "        \"Analysis\": \"Image-level displacement\",\n",
            "        \"Observations\": 889,\n",
            "        \"Wilcoxon Statistic\": 52705.0,\n",
            "        \"P-value\": 4.708938281282196e-80,\n",
            "        \"Verification\": \"Independently reproduced\"\n",
            "    },\n",
            "    {\n",
            "        \"Analysis\": \"Mean-based identity displacement\",\n",
            "        \"Observations\": 13,\n",
            "        \"Wilcoxon Statistic\": 3.0,\n",
            "        \"P-value\": 0.001220703125,\n",
            "        \"Verification\": \"Independently reproduced\"\n",
            "    },\n",
            "    {\n",
            "        \"Analysis\": \"Median-based identity displacement\",\n",
            "        \"Observations\": 13,\n",
            "        \"Wilcoxon Statistic\": 3.0,\n",
            "        \"P-value\": 0.001220703125,\n",
            "        \"Verification\": \"Separately recalculated\"\n",
            "    }\n",
            "])\n",
            "\n",
            "print(\"\\n[7] VERIFIED ILLUMINATION STATISTICAL RESULTS\")\n",
            "display(verified_illumination_results)\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 8. Record reproducibility audit status\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "reproducibility_audit = pd.DataFrame([\n",
            "    {\n",
            "        \"Audit\": \"Step 17.10.4 — Saved results verification\",\n",
            "        \"Status\": \"Completed\"\n",
            "    },\n",
            "    {\n",
