      "cell_type": "markdown",
      "source": [
        "# Experiment 20 — Step 3.3.23: Existing Holm Correction Artifact and Manuscript Inspection\n",
        "\n",
        "## Objective\n",
        "Determine whether the existing Step 3.3.03 six-test Holm results file is a valid correction artifact and establish exactly what the integrated manuscript currently reports.\n",
        "\n",
        "## Files to inspect\n",
        "1. All files in the Step 3.3.03 directory.\n",
        "2. `experiment20_manuscript_six_test_holm_results.csv`.\n",
        "3. The integrated manuscript from Step 3.3.12.\n",
        "4. The Step 3.3.13 manuscript review copy.\n",
        "\n",
        "## Procedure\n",
        "- Record file paths, sizes, and SHA256 hashes.\n",
        "- Print the complete correction CSV, including all columns.\n",
        "- Inspect its metadata and any accompanying documentation.\n",
        "- Search both manuscript copies for statistical testing, Holm correction, adjusted p-values, and pairwise comparison references.\n",
        "- Record relevant manuscript passages with line numbers.\n",
        "\n",
        "## Integrity restrictions\n",
        "- Read-only inspection.\n",
        "- Do not overwrite or modify any existing file.\n",
        "- Do not apply global replacements.\n",
        "- Do not treat an existing correction artifact as authoritative until its contents and provenance are inspected.\n",
        "\n",
        "## Expected outcome\n",
        "A verified decision on whether the existing correction artifact can be used, and a precise list of manuscript passages requiring revision."
      ],
      "metadata": {
        "id": "sJ-WVBc5DqRR"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# EXPERIMENT 20 — STEP 3.3.23\n",
        "# INSPECT EXISTING HOLM CORRECTION ARTIFACT + MANUSCRIPT\n",
        "# READ-ONLY\n",
        "# ============================================================\n",
        "\n",
        "import os\n",
        "import json\n",
        "import hashlib\n",
        "import pandas as pd\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "BASE = \"/content/drive/MyDrive/Experiment_20_Results\"\n",
        "\n",
        "STEP33103_DIR = os.path.join(\n",
        "    BASE, \"step_3_3\", \"step_33103\"\n",
        ")\n",
        "\n",
        "CANDIDATE_CSV = os.path.join(\n",
        "    STEP33103_DIR,\n",
        "    \"experiment20_manuscript_six_test_holm_results.csv\"\n",
        ")\n",
        "\n",
        "MANUSCRIPT_FILES = {\n",
        "    \"integrated_manuscript\": os.path.join(\n",
        "        BASE,\n",
        "        \"step_3_3\",\n",
        "        \"step_3312\",\n",
        "        \"experiment20_integrated_manuscript_v1.md\"\n",
        "    ),\n",
        "    \"review_copy\": os.path.join(\n",
        "        BASE,\n",
        "        \"step_3_3\",\n",
        "        \"step_3313\",\n",
        "        \"experiment20_step3313_manuscript_review_copy.md\"\n",
        "    )\n",
        "}\n",
        "\n",
        "OUTPUT_DIR = os.path.join(\n",
        "    BASE, \"step_3_3\", \"step_3323\"\n",
        ")\n",
        "\n",
        "os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
        "\n",
        "REPORT_PATH = os.path.join(\n",
        "    OUTPUT_DIR,\n",
        "    \"experiment20_step3323_correction_artifact_manuscript_inspection.json\"\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# HASH FUNCTION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def sha256_file(path):\n",
        "    digest = hashlib.sha256()\n",
        "\n",
        "    with open(path, \"rb\") as f:\n",
        "        for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n",
        "            digest.update(chunk)\n",
        "\n",
        "    return digest.hexdigest()\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. INSPECT STEP 3.3.03 DIRECTORY\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"=\" * 100)\n",
        "print(\"1. STEP 3.3.03 DIRECTORY INVENTORY\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "directory_inventory = []\n",
        "\n",
        "if os.path.isdir(STEP33103_DIR):\n",
        "\n",
        "    for filename in sorted(os.listdir(STEP33103_DIR)):\n",
        "\n",
        "        path = os.path.join(STEP33103_DIR, filename)\n",
        "\n",
        "        if os.path.isfile(path):\n",
        "\n",
        "            item = {\n",
        "                \"filename\": filename,\n",
        "                \"path\": path,\n",
        "                \"bytes\": os.path.getsize(path),\n",
        "                \"sha256\": sha256_file(path)\n",
        "            }\n",
        "\n",
        "            directory_inventory.append(item)\n",
        "\n",
        "            print(\"\\nFile:\", filename)\n",
        "            print(\"Bytes:\", item[\"bytes\"])\n",
        "            print(\"SHA256:\", item[\"sha256\"])\n",
        "\n",
        "else:\n",
        "    print(\"STEP 3.3.03 DIRECTORY NOT FOUND\")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. INSPECT THE CANDIDATE CORRECTION CSV\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "candidate_info = {\n",
        "    \"exists\": os.path.isfile(CANDIDATE_CSV),\n",
        "    \"path\": CANDIDATE_CSV\n",
        "}\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"2. CANDIDATE SIX-TEST HOLM CSV\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "candidate_records = []\n",
        "\n",
        "if candidate_info[\"exists\"]:\n",
        "\n",
        "    candidate_df = pd.read_csv(CANDIDATE_CSV)\n",
        "\n",
        "    candidate_info.update({\n",
        "        \"sha256\": sha256_file(CANDIDATE_CSV),\n",
        "        \"rows\": int(len(candidate_df)),\n",
        "        \"columns\": list(candidate_df.columns),\n",
        "        \"dtypes\": {\n",
        "            str(k): str(v)\n",
        "            for k, v in candidate_df.dtypes.items()\n",
        "        }\n",
        "    })\n",
        "\n",
        "    print(\"SHA256:\", candidate_info[\"sha256\"])\n",
        "    print(\"Shape:\", candidate_df.shape)\n",
        "    print(\"Columns:\", list(candidate_df.columns))\n",
        "    print(\"\\nComplete CSV:\")\n",
        "    print(candidate_df.to_string(index=False))\n",
        "\n",
        "    candidate_records = candidate_df.to_dict(orient=\"records\")\n",
        "\n",
        "else:\n",
        "    print(\"CANDIDATE CSV NOT FOUND\")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. INSPECT MANUSCRIPT FILES\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "search_terms = [\n",
        "    \"holm\",\n",
        "    \"adjusted p\",\n",
        "    \"adjusted p-value\",\n",
        "    \"multiple comparison\",\n",
        "    \"multiple testing\",\n",
        "    \"wilcoxon\",\n",
        "    \"pairwise\",\n",
        "    \"p <\",\n",
        "    \"p=\",\n",
        "    \"p =\"\n",
        "]\n",
        "\n",
        "manuscript_results = {}\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"3. MANUSCRIPT STATISTICAL PASSAGES\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "for label, path in MANUSCRIPT_FILES.items():\n",
        "\n",
        "    print(\"\\n\" + \"-\" * 100)\n",
        "    print(\"MANUSCRIPT:\", label)\n",
        "    print(\"PATH:\", path)\n",
        "\n",
        "    if not os.path.isfile(path):\n",
        "        print(\"FILE NOT FOUND\")\n",
        "        manuscript_results[label] = {\n",
        "            \"exists\": False,\n",
        "            \"path\": path\n",
        "        }\n",
        "        continue\n",
        "\n",
        "    with open(path, \"r\", encoding=\"utf-8\") as f:\n",
        "        lines = f.readlines()\n",
        "\n",
        "    file_matches = []\n",
        "\n",
        "    for index, line in enumerate(lines):\n",
        "\n",
        "        lower_line = line.lower()\n",
        "\n",
        "        if any(term in lower_line for term in search_terms):\n",
        "\n",
        "            record = {\n",
        "                \"line_number\": index + 1,\n",
        "                \"text\": line.rstrip()\n",
        "            }\n",
        "\n",
        "            file_matches.append(record)\n",
        "\n",
        "            print(f\"\\nLine {index + 1}:\")\n",
        "            print(line.rstrip())\n",
        "\n",
        "    manuscript_results[label] = {\n",
        "        \"exists\": True,\n",
        "        \"path\": path,\n",
        "        \"sha256\": sha256_file(path),\n",
        "        \"total_lines\": len(lines),\n",
        "        \"total_characters\": sum(len(x) for x in lines),\n",
        "        \"matching_passages\": file_matches\n",
        "    }\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. CHECK WHETHER THE TWO MANUSCRIPT COPIES ARE IDENTICAL\n",
        "# ------------------------------------------------------------\n",
        "\n",
