            "  \"identity_level_repeated_measures\": {\n",
            "    \"status\": \"SUPPORTED\",\n",
            "    \"reason\": \"The same 38 identities are observed across the 56 evaluation conditions.\"\n",
            "  },\n",
            "  \"identity_conditioned_covariance_detector\": {\n",
            "    \"status\": \"NOT_SUPPORTED_WITH_CURRENT_REFERENCE\",\n",
            "    \"reason\": \"Only one reference embedding per identity is available. An individual within-identity covariance matrix cannot be estimated from one observation.\"\n",
            "  },\n",
            "  \"global_mahalanobis_detector\": {\n",
            "    \"status\": \"REQUIRES_SEPARATE_JUSTIFICATION\",\n",
            "    \"reason\": \"The reference cohort contains 38 observations in 512 dimensions. The empirical covariance matrix cannot be full rank without regularisation or dimension reduction.\"\n",
            "  },\n",
            "  \"operational_false_alarm_rate\": {\n",
            "    \"status\": \"NOT_SUPPORTED\",\n",
            "    \"reason\": \"The current design does not provide an independent unchanged-control sequence for operational false-alarm estimation.\"\n",
            "  },\n",
            "  \"calibrated_detection_thresholds\": {\n",
            "    \"status\": \"NOT_USED\",\n",
            "    \"reason\": \"The selected primary analysis is descriptive.\"\n",
            "  }\n",
            "}\n",
            "\n",
            "preprocessing:\n",
            "{\n",
