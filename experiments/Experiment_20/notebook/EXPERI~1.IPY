      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "==============================================================================\n",
            "EXPERIMENT 20 — METHODOLOGY SECTION EXTRACTION\n",
            "==============================================================================\n",
            "\n",
            "1. MANUSCRIPT INTEGRITY\n",
            "Path: /content/drive/MyDrive/Experiment_20_Results/step_3_3/step_3330/experiment20_integrated_manuscript_v2.md\n",
            "Expected SHA256: 2cc4156af63987fae717c37e997e6478e4253d81f584854fb5fab9f18da5e752\n",
            "Actual SHA256:   2cc4156af63987fae717c37e997e6478e4253d81f584854fb5fab9f18da5e752\n",
            "PASS: Frozen manuscript integrity verified.\n",
            "\n",
            "==============================================================================\n",
            "SECTION 2.8\n",
            "==============================================================================\n",
            "ERROR: Section 2.8 was not found.\n",
            "\n",
            "==============================================================================\n",
            "SECTION 2.9\n",
            "==============================================================================\n",
            "ERROR: Section 2.9 was not found.\n",
            "\n",
            "==============================================================================\n",
            "FINAL PRESERVATION CHECK\n",
            "==============================================================================\n",
            "Initial SHA256: 2cc4156af63987fae717c37e997e6478e4253d81f584854fb5fab9f18da5e752\n",
            "Final SHA256:   2cc4156af63987fae717c37e997e6478e4253d81f584854fb5fab9f18da5e752\n",
