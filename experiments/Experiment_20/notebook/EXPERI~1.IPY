            "FILE: experiment20_step3392_dataset_provenance.json\n",
            "SHA256: 67450e548c16d1cc5880e33a85d114b70f1df76ced3017aa2f6b426bb916838c\n",
            "{\n",
            "  \"experiment\": \"Experiment 20\",\n",
