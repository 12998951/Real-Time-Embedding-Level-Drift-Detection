taset Provenance and Cohort-Selection Audit\\n\",\"\\n\",\"## Objective\\n\",\"Review the provenance of Cropped Extended Yale B and verify the evidence supporting the Stage 2 analysis cohort.\\n\",\"\\n\",\"## Evidence sources\\n\",\"1. Yale B source audit.\\n\",\"2. Alternative source audit.\\n\",\"3. CroppedYale acquisition record.\\n\",\"4. Filename completeness audit.\\n\",\"5. Image integrity audit.\\n\",\"6. Common illumination condition audit.\\n\",\"7. Common illumination condition manifest.\\n\",\"8. Lighting geometry grouping audit.\\n\",\"9. Frozen dataset README and SHA256SUMS.\\n\",\"\\n\",\"## Verification questions\\n\",\"- Is the dataset source and acquisition route documented?\\n\",\"- Is the community-hosted archive provenance disclosed?\\n\",\"- Are the image and identity counts internally consistent?\\n\",\"- Are exclusions and incomplete subjects documented?\\n\",\"- Is the 38-identity, 57-condition common cohort supported?\\n\",\"- Are the illumination geometry groups reproducible from recorded metadata?\\n\",\"\\n\",\"## Restrictions\\n\",\"- Read-only audit.\\n\",\"- No changes to the frozen dataset.\\n\",\"- No changes to the analysis cohort.\\n\",\"- No new statistical claims.\"],\"metadata\":{\"id\":\"oI2VFYsXubJz\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"import zipfile\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"\\n\",\"AUDIT_DIR = BASE / \\\"dataset_audit\\\"\\n\",\"\\n\",\"AUDIT_FILES = {\\n\",\"    \\\"source_audit\\\":\\n\",\"        AUDIT_DIR / \\\"experiment20_yaleb_source_audit.json\\\",\\n\",\"\\n\",\"    \\\"alternative_source_audit\\\":\\n\",\"        AUDIT_DIR / \\\"experiment20_yaleb_alternative_source_audit.json\\\",\\n\",\"\\n\",\"    \\\"acquisition_record\\\":\\n\",\"        AUDIT_DIR / \\\"experiment20_croppedyale_acquisition_record.json\\\",\\n\",\"\\n\",\"    \\\"filename_completeness\\\":\\n\",\"        AUDIT_DIR / \\\"experiment20_croppedyale_filename_completeness_audit.json\\\",\\n\",\"\\n\",\"    \\\"image_integrity\\\":\\n\",\"        AUDIT_DIR / \\\"experiment20_croppedyale_image_integrity_audit.json\\\",\\n\",\"\\n\",\"    \\\"common_condition_audit\\\":\\n\",\"        AUDIT_DIR / \\\"experiment20_common_illumination_condition_audit.json\\\",\\n\",\"\\n\",\"    \\\"common_condition_manifest\\\":\\n\",\"        AUDIT_DIR / \\\"experiment20_common_illumination_condition_manifest.json\\\",\\n\",\"\\n\",\"    \\\"geometry_grouping\\\":\\n\",\"        AUDIT_DIR / \\\"experiment20_lighting_geometry_grouping_audit.json\\\"\\n\",\"}\\n\",\"\\n\",\"FROZEN_DATASET_DIR = (\\n\",\"    BASE /\\n\",\"    \\\"Experiment_20_Stage_2_Frozen_Dataset\\\" /\\n\",\"    \\\"Experiment_20_Stage_2_Frozen_Dataset\\\"\\n\",\")\\n\",\"\\n\",\"README = FROZEN_DATASET_DIR / \\\"README.md\\\"\\n\",\"SHA256SUMS = FROZEN_DATASET_DIR / \\\"SHA256SUMS.txt\\\"\\n\",\"\\n\",\"print(\\\"=\\\" * 100)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.1.5: DATASET PROVENANCE AND COHORT AUDIT\\\")\\n\",\"print(\\\"=\\\" * 100)\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 1. Inspect provenance and audit documents\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"documents = {}\\n\",\"\\n\",\"for name, path in AUDIT_FILES.items():\\n\",\"\\n\",\"    print(\\\"\\\\n\\\" + \\\"=\\\" * 100)\\n\",\"    print(f\\\"DOCUMENT: {name}\\\")\\n\",\"    print(f\\\"PATH: {path}\\\")\\n\",\"    print(\\\"=\\\" * 100)\\n\",\"\\n\",\"    if not path.exists():\\n\",\"        print(\\\"STATUS: MISSING\\\")\\n\",\"        continue\\n\",\"\\n\",\"    with path.open(\\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"        data = json.load(f)\\n\",\"\\n\",\"    documents[name] = data\\n\",\"\\n\",\"    print(\\\"STATUS: LOADED\\\")\\n\",\"    print(json.dumps(\\n\",\"        data,\\n\",\"        indent=2,\\n\",\"        ensure_ascii=False,\\n\",\"        default=str\\n\",\"    )[:14000])\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 2. Inspect frozen dataset documentation\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 100)\\n\",\"print(\\\"FROZEN DATASET DOCUMENTATION\\\")\\n\",\"print(\\\"=\\\" * 100)\\n\",\"\\n\",\"if README.exists():\\n\",\"    print(\\\"\\\\nREADME.md\\\")\\n\",\"    print(README.read_text(encoding=\\\"utf-8\\\")[:12000])\\n\",\"else:\\n\",\"    print(\\\"README.md: MISSING\\\")\\n\",\"\\n\",\"if SHA256SUMS.exists():\\n\",\"    print(\\\"\\\\nSHA256SUMS.txt\\\")\\n\",\"    print(SHA256SUMS.read_text(encoding=\\\"utf-8\\\")[:12000])\\n\",\"else:\\n\",\"    print(\\\"SHA256SUMS.txt: MISSING\\\")\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 3. Inspect dataset ZIP structure\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"ZIP_FILE = BASE / \\\"Experiment_20_Stage_2_Frozen_Dataset.zip\\\"\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 100)\\n\",\"print(\\\"FROZEN DATASET ZIP STRUCTURE\\\")\\n\",\"print(\\\"=\\\" * 100)\\n\",\"\\n\",\"if ZIP_FILE.exists():\\n\",\"\\n\",\"    with zipfile.ZipFile(ZIP_FILE, \\\"r\\\") as archive:\\n\",\"\\n\",\"        members = archive.namelist()\\n\",\"\\n\",\"        print(f\\\"Archive entries: {len(members)}\\\")\\n\",\"        print(f\\\"ZIP integrity: {archive.testzip()}\\\")\\n\",\"\\n\",\"        for name in members[:40]:\\n\",\"            print(name)\\n\",\"\\n\",\"else:\\n\",\"    print(\\\"Frozen dataset ZIP not found.\\\")\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 4. Extract key cohort counts where available\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 100)\\n\",\"print(\\\"COHORT EVIDENCE SUMMARY\\\")\\n\",\"print(\\\"=\\\" * 100)\\n\",\"\\n\",\"for name in [\\n\",\"    \\\"acquisition_record\\\",\\n\",\"    \\\"filename_completeness\\\",\\n\",\"    \\\"image_integrity\\\",\\n\",\"    \\\"common_condition_audit\\\",\\n\",\"    \\\"geometry_grouping\\\"\\n\",\"]:\\n\",\"\\n\",\"    if name not in documents:\\n\",\"        print(f\\\"{name}: NOT AVAILABLE\\\")\\n\",\"        continue\\n\",\"\\n\",\"    data = documents[name]\\n\",\"\\n\",\"    print(f\\\"\\\\n{name.upper()}\\\")\\n\",\"\\n\",\"    for key, value in data.items():\\n\",\"\\n\",\"        if isinstance(value, (str, int, float, bool)):\\n\",\"            print(f\\\"{key}: {value}\\\")\\n\",\"\\n\",\"        elif isinstance(value, list) and len(value) <= 15:\\n\",\"            print(f\\\"{key}: {value}\\\")\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 5. Final evidence inventory\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 100)\\n\",\"print(\\\"FINAL EVIDENCE INVENTORY\\\")\\n\",\"print(\\\"=\\\" * 100)\\n\",\"\\n\",\"for name, path in AUDIT_FILES.items():\\n\",\"    print(\\n\",\"        f\\\"{name}: \\\"\\n\",\"        f\\\"{'AVAILABLE' if path.exists() else 'MISSING'}\\\"\\n\",\"    )\\n\",\"\\n\",\"print(\\\"\\\\nNo dataset files were modified.\\\")\\n\",\"print(\\\"No cohort membership was changed.\\\")\\n\",\"print(\\\"No new statistical results were calculated.\\\")\\n\",\"print(\\\"=\\\" * 100)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"QMBegihzudlP\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794385773338,\"user_tz\":360,\"elapsed\":8164,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"458ad95c-3cb3-4399-d9e5-adc59937868e\"},\"execution_count\":9,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"====================================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.1.5: DATASET PROVENANCE AND COHORT AUDIT\\n\",\"=