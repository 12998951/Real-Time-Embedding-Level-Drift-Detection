      "cell_type": "code",
      "source": [
        "from pathlib import Path\n",
        "import hashlib\n",
        "import re\n",
        "\n",
        "# ============================================================\n",
        "# EXPERIMENT 20 — PHASE 4.5\n",
        "# READ-ONLY EXTRACTION OF SECTIONS 2.8 AND 2.9\n",
        "# ============================================================\n",
        "\n",
        "MANUSCRIPT_PATH = Path(\n",
        "    \"/content/drive/MyDrive/Experiment_20_Results/\"\n",
        "    \"step_3_3/step_3330/experiment20_integrated_manuscript_v2.md\"\n",
        ")\n",
        "\n",
        "EXPECTED_SHA256 = (\n",
        "    \"2cc4156af63987fae717c37e997e6478e4253d81f584854fb5fab9f18da5e752\"\n",
        ")\n",
        "\n",
        "print(\"=\" * 78)\n",
        "print(\"EXPERIMENT 20 — METHODOLOGY SECTION EXTRACTION\")\n",
        "print(\"=\" * 78)\n",
        "\n",
        "if not MANUSCRIPT_PATH.exists():\n",
        "    raise FileNotFoundError(\n",
        "        f\"Frozen manuscript not found: {MANUSCRIPT_PATH}\"\n",
        "    )\n",
        "\n",
        "content_bytes = MANUSCRIPT_PATH.read_bytes()\n",
        "actual_sha256 = hashlib.sha256(content_bytes).hexdigest()\n",
        "content = content_bytes.decode(\"utf-8\")\n",
        "\n",
        "print(\"\\n1. MANUSCRIPT INTEGRITY\")\n",
        "print(\"Path:\", MANUSCRIPT_PATH)\n",
        "print(\"Expected SHA256:\", EXPECTED_SHA256)\n",
        "print(\"Actual SHA256:  \", actual_sha256)\n",
        "\n",
        "if actual_sha256 != EXPECTED_SHA256:\n",
        "    raise RuntimeError(\n",
        "        \"STOP: Manuscript hash does not match the frozen version. \"\n",
        "        \"Do not proceed with amendments.\"\n",
        "    )\n",
        "\n",
        "print(\"PASS: Frozen manuscript integrity verified.\")\n",
        "\n",
        "# Extract numbered Markdown sections using heading boundaries.\n",
        "lines = content.splitlines()\n",
        "\n",
        "def extract_section(section_number):\n",
        "    heading_pattern = re.compile(\n",
        "        rf\"^\\s{{0,3}}#{1,6}\\s+{re.escape(section_number)}(?:\\s|[.:])\",\n",
        "        re.IGNORECASE\n",
        "    )\n",
        "\n",
        "    start_index = None\n",
        "    heading_level = None\n",
        "\n",
        "    for i, line in enumerate(lines):\n",
        "        match = re.match(r\"^\\s{0,3}(#{1,6})\\s+\", line)\n",
        "        if match and heading_pattern.match(line):\n",
        "            start_index = i\n",
        "            heading_level = len(match.group(1))\n",
        "            break\n",
        "\n",
        "    if start_index is None:\n",
        "        return None\n",
        "\n",
        "    end_index = len(lines)\n",
        "\n",
        "    for i in range(start_index + 1, len(lines)):\n",
        "        match = re.match(r\"^\\s{0,3}(#{1,6})\\s+\", lines[i])\n",
        "        if match and len(match.group(1)) <= heading_level:\n",
        "            end_index = i\n",
        "            break\n",
        "\n",
        "    return \"\\n\".join(lines[start_index:end_index]).strip()\n",
        "\n",
        "for section_number in (\"2.8\", \"2.9\"):\n",
        "    section_text = extract_section(section_number)\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 78)\n",
        "    print(f\"SECTION {section_number}\")\n",
        "    print(\"=\" * 78)\n",
        "\n",
        "    if section_text is None:\n",
        "        print(f\"ERROR: Section {section_number} was not found.\")\n",
        "    else:\n",
        "        print(section_text)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 78)\n",
        "print(\"FINAL PRESERVATION CHECK\")\n",
        "print(\"=\" * 78)\n",
        "\n",
        "final_sha256 = hashlib.sha256(\n",
        "    MANUSCRIPT_PATH.read_bytes()\n",
        ").hexdigest()\n",
        "\n",
        "print(\"Initial SHA256:\", actual_sha256)\n",
        "print(\"Final SHA256:  \", final_sha256)\n",
        "print(\"Manuscript unchanged:\", actual_sha256 == final_sha256)\n",
        "\n",
        "if actual_sha256 != final_sha256:\n",
        "    raise RuntimeError(\"Unexpected manuscript modification detected.\")\n",
        "\n",
        "print(\"\\nFINAL STATUS: READ_ONLY_SECTION_EXTRACTION_COMPLETED\")\n",
        "print(\"No manuscript or evidence files were modified.\")"
      ],
