        "    )\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 7. RECOMPUTE GROUP STATISTICS\n",
        "# ------------------------------------------------\n",
        "\n",
        "group_stats = data[\"group_statistics\"]\n",
        "\n",
        "require_columns(\n",
        "    group_stats,\n",
        "    [\n",
        "        \"illumination_group\", \"metric\", \"observations\",\n",
        "        \"identities\", \"conditions\", \"mean\", \"median\",\n",
