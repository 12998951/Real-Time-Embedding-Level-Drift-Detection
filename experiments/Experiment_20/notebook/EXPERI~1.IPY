  \\\"shape\\\": [\\n\",\"      2414,\\n\",\"      512\\n\",\"    ],\\n\",\"    \\\"dtype\\\": \\\"float32\\\",\\n\",\"    \\\"all_finite\\\": true,\\n\",\"    \\\"all_l2_normalized\\\": true,\\n\",\"    \\\"mean_l2_norm\\\": 1.0,\\n\",\"    \\\"minimum_l2_norm\\\": 0.9999998807907104,\\n\",\"    \\\"maximum_l2_norm\\\": 1.0000001192092896\\n\",\"  },\\n\",\"  \\\"failures\\\": [],\\n\",\"  \\\"methodological_limitations\\\": [\\n\",\"    \\\"Direct resizing is not equivalent to MTCNN detection and alignment.\\\",\\n\",\"    \\\"Grayscale images are replicated into three RGB channels.\\\",\\n\",\"    \\\"The model was pretrained on VGGFace2, not CroppedYale.\\\",\\n\",\"    \\\"Embedding generation does not establish biometric recognition accuracy.\\\",\\n\",\"    \\\"This dataset contains repeated identity and illumination captures, not exact source-image pairs.\\\"\\n\",\"  ]\\n\",\"}\\n\",\"\\n\",\"====================================================================================================\\n\",\"CURRENT COLAB RUNTIME VERSIONS\\n\",\"====================================================================================================\\n\",\"Python: 3.13.18 (main, Oct 26 2026, 15:28:15) [GCC 13.3.0]\\n\",\"Platform: Linux-6.6.159+-x86_64-with-glibc2.39\\n\",\"torch: 2.14.1+cpu\\n\",\"torchvision: 0.29.1+cpu\\n\",\"facenet-pytorch: NOT INSTALLED\\n\",\"numpy: 2.4.6\\n\",\"Pillow: 11.3.0\\n\",\"\\n\",\"IMPORTANT:\\n\",\"Current runtime versions are not proof of historical embedding-generation versions.\\n\",\"No experiment files were modified.\\n\",\"====================================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.1.9: Original Notebook Source Inspection\\n\",\"\\n\",\"## Objective\\n\",\"Search the existing Google Drive Colab notebooks for the original\\n\",\"Experiment 20 embedding-generation code.\\n\",\"\\n\",\"Recover, if available:\\n\",\"\\n\",\"1. The exact torchvision Resize invocation.\\n\",\"2. Whether interpolation was explicitly specified.\\n\",\"3. The FaceNet model initialization statement.\\n\",\"4. The pretrained-weight loading configuration.\\n\",\"5. Any model checkpoint saving or loading operation.\\n\",\"6. The software version information recorded during generation.\\n\",\"\\n\",\"## Restrictions\\n\",\"- Read-only inspection.\\n\",\"- Do not execute notebook cells.\\n\",\"- Do not regenerate embeddings.\\n\",\"- Do not modify notebook files.\\n\",\"- Do not assume defaults when source code is incomplete.\\n\",\"\\n\",\"## Output\\n\",\"Print matching notebook paths, cell indices, and relevant source-code excerpts.\"],\"metadata\":{\"id\":\"kDac9R5Xv34H\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"import re\\n\",\"\\n\",\"DRIVE_ROOT = Path(\\\"/content/drive/MyDrive\\\")\\n\",\"\\n\",\"SEARCH_ROOTS = [\\n\",\"    DRIVE_ROOT / \\\"Colab Notebooks\\\",\\n\",\"    DRIVE_ROOT / \\\"Experiment_20_Results\\\"\\n\",\"]\\n\",\"\\n\",\"PATTERNS = {\\n\",\"    \\\"resize\\\": re.compile(\\n\",\"        r\\\"transforms\\\\.Resize|Resize\\\\(|InterpolationMode|interpolation\\\\s*=\\\",\\n\",\"        re.IGNORECASE\\n\",\"    ),\\n\",\"    \\\"model_initialization\\\": re.compile(\\n\",\"        r\\\"InceptionResnetV1|pretrained\\\\s*=\\\\s*['\\\\\\\"]VGGFace2\\\",\\n\",\"        re.IGNORECASE\\n\",\"    ),\\n\",\"    \\\"checkpoint_operations\\\": re.compile(\\n\",\"        r\\\"torch\\\\.save|torch\\\\.load|load_state_dict|state_dict|checkpoint\\\",\\n\",\"        re.IGNORECASE\\n\",\"    ),\\n\",\"    \\\"software_versions\\\": re.compile(\\n\",\"        r\\\"facenet.?pytorch|torchvision|torch\\\\.__version__|\\\"\\n\",\"        r\\\"__version__|version\\\\(\\\",\\n\",\"        re.IGNORECASE\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"print(\\\"=\\\" * 100)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.1.9\\\")\\n\",\"print(\\\"ORIGINAL NOTEBOOK SOURCE INSPECTION\\\")\\n\",\"print(\\\"=\\\" * 100)\\n\",\"\\n\",\"notebooks = []\\n\",\"\\n\",\"for root in SEARCH_ROOTS:\\n\",\"    if root.exists():\\n\",\"        notebooks.extend(root.rglob(\\\"*.ipynb\\\"))\\n\",\"\\n\",\"print(\\\"Notebooks discovered:\\\", len(notebooks))\\n\",\"\\n\",\"matches_found = 0\\n\",\"\\n\",\"for notebook_path in sorted(notebooks):\\n\",\"    try:\\n\",\"        with notebook_path.open(\\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"            notebook = json.load(f)\\n\",\"\\n\",\"        cells = notebook.get(\\\"cells\\\", [])\\n\",\"\\n\",\"        notebook_matches = []\\n\",\"\\n\",\"        for index, cell in enumerate(cells):\\n\",\"            if cell.get(\\\"cell_type\\\") != \\\"code\\\":\\n\",\"                continue\\n\",\"\\n\",\"            source = cell.get(\\\"source\\\", \\\"\\\")\\n\",\"            if isinstance(source, list):\\n\",\"                source = \\\"\\\".join(source)\\n\",\"\\n\",\"            matched_categories = [\\n\",\"                category\\n\",\"                for category, pattern in PATTERNS.items()\\n\",\"                if pattern.search(source)\\n\",\"            ]\\n\",\"\\n\",\"            if matched_categories:\\n\",\"                notebook_matches.append(\\n\",\"                    (index, matched_categories, source)\\n\",\"                )\\n\",\"\\n\",\"        if notebook_matches:\\n\",\"            print(\\\"\\\\n\\\" + \\\"-\\\" * 100)\\n\",\"            print(\\\"NOTEBOOK:\\\", notebook_path)\\n\",\"            print(\\\"MATCHING CODE CELLS:\\\", len(notebook_matches))\\n\",\"\\n\",\"            for index, categories, source in notebook_matches:\\n\",\"                matches_found += 1\\n\",\"\\n\",\"                print(\\\"\\\\nCELL INDEX:\\\", index)\\n\",\"                print(\\\"MATCH CATEGORIES:\\\", \\\", \\\".join(categories))\\n\",\"                print(\\\"SOURCE CODE:\\\")\\n\",\"                print(source[:6000])\\n\",\"\\n\",\"    except Exception as exc:\\n\",\"        print(\\\"\\\\nNOTEBOOK READ ERROR:\\\", notebook_path)\\n\",\"        print(repr(exc))\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 100)\\n\",\"print(\\\"INSPECTION SUMMARY\\\")\\n\",\"print(\\\"=\\\" * 100)\\n\",\"print(\\\"Notebooks discovered:\\\", len(notebooks))\\n\",\"print(\\\"Matching code cells:\\\", matches_found)\\n\",\"print(\\\"Notebook files modified: NO\\\")\\n\",\"print(\\\"Notebook cells executed: NO\\\")\\n\",\"print(\\\"=\\\" * 100)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"E6W7HcDCv6TR\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794386157902,\"user_tz\":360,\"elapsed\":13248,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"a45df0c9-781d-4a6d-e103-ac1b67700cea\"},\"execution_count\":15,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"\\u001b[1;30;43mStreaming output truncated to the last 5000 lines.\\u001b[0m\\n\",\"09. lfw_stage3_fresh_brightness_130_embeddings.npy\\n\",\"10. lfw_stage3_fresh_stream_manifest.csv\\n\",\"\\n\",\"All ten files are listed in:\\n\",\"experiment13_recovery_manifest.csv\\n\",\"\\n\",\"The manifest records file sizes, SHA-256 checksums,\\n\",\"regeneration status, and validation status.\\n\",\"\\n\",\"\\n\",\"4. REGENERATION LOGIC\\n\",\"---------------------\\n\",\"The original experiment notebook was inspected to reconstruct\\n\",\"the relevant selection, sampling, embedding, and transformation logic.\\n\",\"\\n\",\"The regeneration used:\\n\",\"- The checksum-verified LFW source archive.\\n\",\"- The verified FaceNet model weights.\\n\",\"- The original notebook's documented random seeds and selection logic.\\n\",\"- The reconstructed dataset path ordering.\\n\",\"- The original brightness transformation logic.\\n\",\"\\n\",\"Stage 3 brightness transformations:\\n\",\"- Brightness factor 0.70.\\n\",\"- Brightness factor 1.30.\\n\",\"- Transformation begins at window_id 10.\\n\",\"- First 500 embeddings remain unchanged.\\n\",\"- Final 500 embeddings are regenerated from transformed images.\\n\",\"\\n\",\"\\n\",\"5. VALIDATION RESULTS\\n\",\"---------------------\\n\",\"Required artifacts: 10\\n\",\"Present artifacts: 10\\n\",\"Missing artifacts: 0\\n\",\"\\n\",\"Base embeddings: 13,233 x 512\\n\",\"Reference images: 9,083\\n\",\"Evaluation images: 4,150\\n\",\"Matched stream: 600 x 512\\n\",\"Calibration windows: 100\\n\",\"Stage 3 stream: 1,000 images\\n\",\"\\n\",\"Validation checks passed:\\n\",\"- File existence.\\n\",\"- Embedding dimensions.\\n\",\"- Numerical finiteness.\\n\",\"- Metadata consistency.\\n\",\"- Identity split disjointness.\\n\",\"- Matched-stream structure.\\n\",\"- Calibration-window dimensions.\\n\",\"- Stage 3 manifest consistency.\\n\",\"- Unchanged pre-onset embeddings.\\n\",\"- Transformed post-onset embeddings.\\n\",\"\\n\",\"Final audit status: PASSED.\\n\",\"\\n\",\"\\n\",\"6. PROVENANCE LIMITATIONS\\n\",\"-------------------------\\n\",\"The original TFDS filesystem enumeration order was not independently\\n\",\"verified against the original execution environment.\\n\",\"\\n\",\"The regenerated dataset ordering was reconstructed using the\\n\",\"available TFDS path-making logic and checked for identity alignment.\\n\",\"\\n\",\"However, this does not establish that every dataset index maps\\n\",\"to exactly the same original image as in the original execution.\\n\",\"\\n\",\"Consequently:\\n\",\"- These files must be described as regenerated artifacts.\\n\",\"- They must not be described as exact original-file recoveries.\\n\",\"- Byte-for-byte equivalence with the original outputs is not established.\\n\",\"- Exact row-by-row equivalence with the original dataset ordering\\n\",\"  is not established.\\n\",\"\\n\",\"The SHA-256 checksums in the recovery manifest identify the\\n\",\"regenerated files created in this recovery run. They do not prove\\n\",\"equivalence to missing original files.\\n\",\"\\n\",\"\\n\",\"7. REPRODUCIBILITY RECORD\\n\",\"-------------------------\\n\",\"Original notebook:\\n\",\"Experiment_13_Final_Reproducibility_Audit.ipynb\\n\",\"\\n\",\"Regenerated artifact directory:\\n\",\"/content/experiment13_lfw_regenerated\\n\",\"\\n\",\"Recovery manifest:\\n\",\"experiment13_recovery_manifest.csv\\n\",\"\\n\",\"Status:\\n\",\"TEN ARTIFACTS REGENERATED AND VALIDATED.\\n\",\"\\n\",\"This document is a provenance record for the regenerated\\n\",\"working dataset. It does not replace the original experiment\\n\",\"notebook or constitute proof of exact original recovery.\\n\",\"\\\"\\\"\\\"\\n\",\"\\n\",\"notes_path.write_text(notes.strip() + \\\"\\\\n\\\", encoding=\\\"utf-8\\\")\\n\",\"\\n\",\"print(\\\"=\\\" * 65)\\n\",\"print(\\\"EXPERIMENT 13 — RECOVERY NOTES CREATED\\\")\\n\",\"print(\\\"=\\\" * 65)\\n\",\"print(\\\"File:\\\", notes_path)\\n\",\"print(\\\"Size:\\\", notes_path.stat().st_size, \\\"bytes\\\")\\n\",\"print(\\\"Status: CREATED\\\")\\n\",\"\\n\",\"CELL INDEX: 189\\n\",\"MATCH CATEGORIES: software_versions\\n\",\"SOURCE CODE:\\n\",\"import json\\n\",\"from pathlib import Path\\n\",\"\\n\",\"notebook_path = Path(\\n\",\"    \\\"/content/Real-Time-Embedding-Level-Drift-Detection/\\\"\\n\",\"    \\\"experiments/Experiment_13_Final_Reproducibility_Audit.ipynb\\\"\\n\",\")\\n\",\"\\n\",\"with open(notebook_path, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    notebook = json.load(f)\\n\",\"\\n\",\"for i in [40, 41, 52, 59, 63]:\\n\",\"    cell = notebook[\\\"cells\\\"][i]\\n\",\"\\n\",\"    print(\\\"\\\\n\\\" + \\\"=\\\" * 60)\\n\",\"    print(\\\"CELL:\\\", i)\\n\",\"    print(\\\"=\\\" * 60)\\n\",\"\\n\",\"    print(\\\"Execution count:\\\", cell.get(\\\"execution_count\\\"))\\n\",\"\\n\",\"    for output in cell.get(\\\"outputs\\\", []):\\n\",\"        if \\\"text\\\" in output:\\n\",\"            print(\\\"\\\".join(output[\\\"text\\\"]))\\n\",\"\\n\",\"        elif \\\"data\\\" in output:\\n\",\"            text_data = output[\\\"data\\\"].get(\\\"text/plain\\\")\\n\",\"            if text_data:\\n\",\"                print(\\\"\\\".join(text_data))\\n\",\"\\n\",\"print(\\\"\\\\nCURRENT ENVIRONMENT\\\")\\n\",\"import sklearn\\n\",\"print(\\\"scikit-learn:\\\", sklearn.__version__)\\n\",\"print(\\\"NumPy:\\\", np.__version__)\\n\",\"\\n\",\"CELL INDEX: 215\\n\",\"MATCH CATEGORIES: software_versions\\n\",\"SOURCE CODE:\\n\",\"from pathlib import Path\\n\",\"import hashlib\\n\",\"import importlib.metadata\\n\",\"\\n\",\"weights = Path(\\n\",\"    \\\"/root/.keras-facenet/20180402-114759/\\\"\\n\",\"    \\\"20180402-114759-weights.h5\\\"\\n\",\")\\n\",\"\\n\",\"expected_sha256 = (\\n\",\"    \\\"8b71e7045497e841c00ee568f031d1a4d30908fceadf6884aef2dec4d545202b\\\"\\n\",\")\\n\",\"\\n\",\"sha256 = hashlib.sha256()\\n\",\"\\n\",\"with open(weights, \\\"rb\\\") as f:\\n\",\"    for chunk in iter(lambda: f.read(1024 * 1024), b\\\"\\\"):\\n\",\"        sha256.update(chunk)\\n\",\"\\n\",\"actual_sha256 = sha256.hexdigest()\\n\",\"\\n\",\"print(\\\"=== FACENET WEIGHT INTEGRITY ===\\\")\\n\",\"print(\\\"File exists:\\\", weights.exists())\\n\",\"print(\\\"File size:\\\", weights.stat().st_size)\\n\",\"print(\\\"Expected SHA-256:\\\", expected_sha256)\\n\",\"print(\\\"Actual SHA-256:\\\", actual_sha256)\\n\",\"print(\\\"Checksum match:\\\", actual_sha256 == expected_sha256)\\n\",\"\\n\",\"print(\\\"\\\\n=== INSTALLED PACKAGE VERSIONS ===\\\")\\n\",\"\\n\",\"for package in [\\\"keras-facenet\\\", \\\"tensorflow\\\", \\\"tensorflow-datasets\\\",\\n\",\"                \\\"numpy\\\", \\\"scikit-learn\\\", \\\"opencv-python\\\"]:\\n\",\"    try:\\n\",\"        print(package, \\\":\\\", importlib.metadata.version(package))\\n\",\"    except importlib.metadata.PackageNotFoundError:\\n\",\"        print(package, \\\": not installed\\\")\\n\",\"\\n\",\"CELL INDEX: 227\\n\",\"MATCH CATEGORIES: software_versions\\n\",\"SOURCE CODE:\\n\",\"import inspect\\n\",\"import tensorflow_datasets as tfds\\n\",\"\\n\",\"print(\\\"TFDS version:\\\", tfds.__version__)\\n\",\"\\n\",\"builder = tfds.builder(\\\"lfw\\\")\\n\",\"\\n\",\"print(\\\"\\\\n=== LFW BUILDER CLASS ===\\\")\\n\",\"print(type(builder))\\n\",\"\\n\",\"print(\\\"\\\\n=== BUILDER SOURCE FILE ===\\\")\\n\",\"print(inspect.getfile(type(builder)))\\n\",\"\\n\",\"print(\\\"\\\\n=== DATASET INFO / CONFIGURATION ===\\\")\\n\",\"print(\\\"Name:\\\", builder.name)\\n\",\"print(\\\"Version:\\\", builder.version)\\n\",\"print(\\\"Splits:\\\", builder.info.splits)\\n\",\"\\n\",\"print(\\\"\\\\n=== BUILDER METHODS RELATED TO FILE ORDER ===\\\")\\n\",\"for name in dir(builder):\\n\",\"    if any(term in name.lower() for term in [\\n\",\"        \\\"path\\\", \\\"file\\\", \\\"download\\\", \\\"split\\\", \\\"generate\\\"\\n\",\"    ]):\\n\",\"        print(name)\\n\",\"\\n\",\"----------------------------------------------------------------------------------------------------\\n\",\"NOTEBOOK: /content/drive/MyDrive/Colab Notebooks/Experiment 12 — Cross-Condition Generalisation of Embedding-Level Drift Detectors.ipynb\\n\",\"MATCHING CODE CELLS: 1\\n\",\"\\n\",\"CELL INDEX: 0\\n\",\"MATCH CATEGORIES: software_versions\\n\",\"SOURCE CODE:\\n\",\"# Experiment 12 — Step 1: Environment setup\\n\",\"\\n\",\"import sys\\n\",\"import platform\\n\",\"from pathlib import Path\\n\",\"\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"import matplotlib.pyplot as plt\\n\",\"\\n\",\"SEED = 42\\n\",\"rng = np.random.default_rng(SEED)\\n\",\"\\n\",\"print(\\\"Experiment 12: Cross-Condition Generalisation\\\")\\n\",\"print(\\\"-\\\" * 50)\\n\",\"print(\\\"Python:\\\", platform.python_version())\\n\",\"print(\\\"NumPy:\\\", np.__version__)\\n\",\"print(\\\"Pandas:\\\", pd.__version__)\\n\",\"print(\\\"Working directory:\\\", Path.cwd())\\n\",\"print(\\\"Random seed:\\\", SEED)\\n\",\"print(\\\"Environment setup complete.\\\")\\n\",\"\\n\",\"----------------------------------------------------------------------------------------------------\\n\",\"NOTEBOOK: /content/drive/MyDrive/Colab Notebooks/Experiment 19: Disentangling Identity-Composition Drift from Within-Identity Embedding Drift in Biometric Representation Systems.ipynb\\n\",\"MATCHING CODE CELLS: 1\\n\",\"\\n\",\"CELL INDEX: 2\\n\",\"MATCH CATEGORIES: software_versions\\n\",\"SOURCE CODE:\\n\",\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 19 — STEP 1\\n\",\"# ENVIRONMENT AND REPRODUCIBILITY SETUP\\n\",\"# ============================================================\\n\",\"\\n\",\"import os\\n\",\"import sys\\n\",\"import json\\n\",\"import random\\n\",\"import platform\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"import scipy\\n\",\"import matplotlib\\n\",\"import matplotlib.pyplot as plt\\n\",\"\\n\",\"# 1. RANDOM SEED\\n\",\"\\n\",\"RANDOM_SEED = 202619\\n\",\"\\n\",\"random.seed(RANDOM_SEED)\\n\",\"np.random.seed(RANDOM_SEED)\\n\",\"\\n\",\"# 2. DIRECTORY CONFIGURATION\\n\",\"\\n\",\"EXPERIMENT_DIR = \\\"/content/drive/MyDrive/Experiment_19_Results\\\"\\n\",\"\\n\",\"CONFIG_DIR = os.path.join(EXPERIMENT_DIR, \\\"configuration\\\")\\n\",\"DATA_DIR = os.path.join(EXPERIMENT_DIR, \\\"data\\\")\\n\",\"RESULTS_DIR = os.path.join(EXPERIMENT_DIR, \\\"results\\\")\\n\",\"PLOTS_DIR = os.path.join(EXPERIMENT_DIR, \\\"plots\\\")\\n\",\"EVIDENCE_DIR = os.path.join(EXPERIMENT_DIR, \\\"evidence\\\")\\n\",\"\\n\",\"for directory in [\\n\",\"    CONFIG_DIR,\\n\",\"    DATA_DIR,\\n\",\"    RESULTS_DIR,\\n\",\"    PLOTS_DIR,\\n\",\"    EVIDENCE_DIR\\n\",\"]:\\n\",\"    os.makedirs(directory, exist_ok=True)\\n\",\"\\n\",\"# 3. SOFTWARE ENVIRONMENT\\n\",\"\\n\",\"environment = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 19\\\",\\n\",\"    \\\"random_seed\\\": RANDOM_SEED,\\n\",\"    \\\"python_version\\\": sys.version,\\n\",\"    \\\"platform\\\": platform.platform(),\\n\",\"    \\\"numpy_version\\\": np.__version__,\\n\",\"    \\\"pandas_version\\\": pd.__version__,\\n\",\"    \\\"scipy_version\\\": scipy.__version__,\\n\",\"    \\\"matplotlib_version\\\": matplotlib.__version__\\n\",\"}\\n\",\"\\n\",\"print(\\\"=\\\" * 70)\\n\",\"print(\\\"EXPERIMENT 19 — STEP 1\\\")\\n\",\"print(\\\"ENVIRONMENT AND REPRODUCIBILITY SETUP\\\")\\n\",\"print(\\\"=\\\" * 70)\\n\",\"\\n\",\"print(\\\"\\\\n[1] SOFTWARE ENVIRONMENT\\\")\\n\",\"print(json.dumps(environment, indent=4))\\n\",\"\\n\",\"# 4. DIRECTORY VERIFICATION\\n\",\"\\n\",\"assert os.path.isdir(\\\"/content/drive/MyDrive\\\"), (\\n\",\"    \\\"Google Drive is not mounted.\\\"\\n\",\")\\n\",\"\\n\",\"for directory in [\\n\",\"    CONFIG_DIR,\\n\",\"    DATA_DIR,\\n\",\"    RESULTS_DIR,\\n\",\"    PLOTS_DIR,\\n\",\"    EVIDENCE_DIR\\n\",\"]:\\n\",\"    assert os.path.isdir(directory)\\n\",\"\\n\",\"print(\\\"\\\\n[2] DIRECTORY VERIFICATION\\\")\\n\",\"print(\\\"PASS: Google Drive accessible.\\\")\\n\",\"print(\\\"PASS: Five Experiment 19 directories accessible.\\\")\\n\",\"\\n\",\"# 5. SAVE CONFIGURATION\\n\",\"\\n\",\"config_path = os.path.join(\\n\",\"    CONFIG_DIR,\\n\",\"    \\\"experiment19_environment.json\\\"\\n\",\")\\n\",\"\\n\",\"with open(config_path, \\\"w\\\", encoding=\\\"utf-8\\\") as file:\\n\",\"    json.dump(environment, file, indent=4)\\n\",\"\\n\",\"assert os.path.isfile(config_path)\\n\",\"\\n\",\"print(\\\"\\\\n[3] CONFIGURATION FILE\\\")\\n\",\"print(\\\"PASS:\\\", config_path)\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 70)\\n\",\"print(\\\"STEP 1 COMPLETED SUCCESSFULLY\\\")\\n\",\"print(\\\"No dataset extraction or experimental evaluation performed.\\\")\\n\",\"print(\\\"=\\\" * 70)\\n\",\"\\n\",\"\\n\",\"----------------------------------------------------------------------------------------------------\\n\",\"NOTEBOOK: /content/drive/MyDrive/Colab Notebooks/Experiment 20: Paired Identity-Level Evaluation of Within-Identity Embedding Drift Detection Under Multiple Controlled Biometric Acquisition Changes.ipynb\\n\",\"MATCHING CODE CELLS: 14\\n\",\"\\n\",\"CELL INDEX: 2\\n\",\"MATCH CATEGORIES: software_versions\\n\",\"SOURCE CODE:\\n\",\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 20\\n\",\"# STEP 1 — ENVIRONMENT AND REPRODUCIBILITY SETUP\\n\",\"# ============================================================\\n\",\"\\n\",\"import os\\n\",\"import sys\\n\",\"import json\\n\",\"import random\\n\",\"import platform\\n\",\"import importlib\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Reproducibility configuration\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"RANDOM_SEED = 202620\\n\",\"\\n\",\"os.environ[\\\"PYTHONHASHSEED\\\"] = str(RANDOM_SEED)\\n\",\"\\n\",\"random.seed(RANDOM_SEED)\\n\",\"np.random.seed(RANDOM_SEED)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Required library verification\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"required_libraries = [\\n\",\"    \\\"numpy\\\",\\n\",\"    \\\"pandas\\\",\\n\",\"    \\\"scipy\\\",\\n\",\"    \\\"sklearn\\\",\\n\",\"    \\\"matplotlib\\\",\\n\",\"    \\\"PIL\\\",\\n\",\"    \\\"torch\\\"\\n\",\"]\\n\",\"\\n\",\"library_status = {}\\n\",\"\\n\",\"for library in required_libraries:\\n\",\"    try:\\n\",\"        module = importlib.import_module(library)\\n\",\"\\n\",\"        version = getattr(\\n\",\"            module,\\n\",\"            \\\"__version__\\\",\\n\",\"            \\\"Version not exposed\\\"\\n\",\"        )\\n\",\"\\n\",\"        library_status[library] = {\\n\",\"            \\\"available\\\": True,\\n\",\"            \\\"version\\\": str(version)\\n\",\"        }\\n\",\"\\n\",\"    except Exception as error:\\n\",\"        library_status[library] = {\\n\",\"            \\\"available\\\": False,\\n\",\"            \\\"error\\\": str(error)\\n\",\"        }\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Hardware and platform information\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"hardware_info = {\\n\",\"    \\\"platform\\\": platform.platform(),\\n\",\"    \\\"processor\\\": platform.processor(),\\n\",\"    \\\"python_version\\\": sys.version,\\n\",\"    \\\"machine\\\": platform.machine()\\n\",\"}\\n\",\"\\n\",\"try:\\n\",\"    import torch\\n\",\"\\n\",\"    hardware_info[\\\"pytorch_cuda_available\\\"] = (\\n\",\"        torch.cuda.is_available()\\n\",\"    )\\n\",\"\\n\",\"    if torch.cuda.is_available():\\n\",\"        hardware_info[\\\"gpu_name\\\"] = (\\n\",\"            torch.cuda.get_device_name(0)\\n\",\"        )\\n\",\"    else:\\n\",\"        hardware_info[\\\"gpu_name\\\"] = None\\n\",\"\\n\",\"except Exception:\\n\",\"    hardware_info[\\\"pytorch_cuda_available\\\"] = False\\n\",\"    hardware_info[\\\"gpu_name\\\"] = None\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Experiment configuration\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"experiment_config = {\\n\",\"    \\\"experiment\\\": 20,\\n\",\"\\n\",\"    \\\"title\\\": (\\n\",\"        \\\"Paired Identity-Level Evaluation of Within-Identity \\\"\\n\",\"        \\\"Embedding Drift Detection Under Multiple Controlled \\\"\\n\",\"        \\\"Biometric Acquisition Changes\\\"\\n\",\"    ),\\n\",\"\\n\",\"    \\\"dataset_strategy\\\": \\\"existing\\\",\\n\",\"    \\\"dataset\\\": \\\"Existing LFW-derived cohort\\\",\\n\",\"\\n\",\"    \\\"expected_source_images\\\": 889,\\n\",\"    \\\"expected_identities\\\": 13,\\n\",\"    \\\"embedding_dimension\\\": 512,\\n\",\"\\n\",\"    \\\"transformation_families\\\": [\\n\",\"        \\\"illumination\\\",\\n\",\"        \\\"blur\\\",\\n\",\"        \\\"noise\\\"\\n\",\"    ],\\n\",\"\\n\",\"    \\\"transformation_strengths\\\": [\\n\",\"        \\\"unchanged\\\",\\n\",\"        \\\"mild\\\",\\n\",\"        \\\"moderate\\\",\\n\",\"        \\\"strong\\\"\\n\",\"    ],\\n\",\"\\n\",\"    \\\"random_seed\\\": RANDOM_SEED,\\n\",\"    \\\"window_size\\\": 20,\\n\",\"\\n\",\"    \\\"detectors\\\": [\\n\",\"        \\\"global_euclidean\\\",\\n\",\"        \\\"global_mahalanobis\\\",\\n\",\"        \\\"identity_conditioned_standardized_euclidean\\\"\\n\",\"    ]\\n\",\"}\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Reproducibility record\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"reproducibility_record = {\\n\",\"    \\\"experiment\\\": 20,\\n\",\"    \\\"step\\\": 1,\\n\",\"\\n\",\"    \\\"timestamp_utc\\\": datetime.now(\\n\",\"        timezone.utc\\n\",\"    ).isoformat(),\\n\",\"\\n\",\"    \\\"random_seed\\\": RANDOM_SEED,\\n\",\"    \\\"hardware\\\": hardware_info,\\n\",\"    \\\"libraries\\\": library_status,\\n\",\"    \\\"configuration\\\": experiment_config\\n\",\"}\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. Display results\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 1\\\")\\n\",\"print(\\\"ENVIRONMENT AND REPRODUCIBILITY SETUP\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"print(\\\"\\\\n[1] RANDOM SEED\\\")\\n\",\"print(\\\"Random seed:\\\", RANDOM_SEED)\\n\",\"\\n\",\"print(\\\"\\\\n[2] PYTHON ENVIRONMENT\\\")\\n\",\"print(json.dumps(hardware_info, indent=4))\\n\",\"\\n\",\"print(\\\"\\\\n[3] LIBRARY AVAILABILITY\\\")\\n\",\"\\n\",\"for library, details in library_status.items():\\n\",\"\\n\",\"    print(f\\\"\\\\n{library}:\\\")\\n\",\"    print(json.dumps(details, indent=4))\\n\",\"\\n\",\"print(\\\"\\\\n[4] EXPERIMENT CONFIGURATION\\\")\\n\",\"print(json.dumps(experiment_config, indent=4))\\n\",\"\\n\",\"print(\\\"\\\\n[5] DEPENDENCY SUMMARY\\\")\\n\",\"\\n\",\"available_count = sum(\\n\",\"    details[\\\"available\\\"]\\n\",\"    for details in library_status.values()\\n\",\")\\n\",\"\\n\",\"missing_count = (\\n\",\"    len(library_status) - available_count\\n\",\")\\n\",\"\\n\",\"print(\\\"Available libraries:\\\", available_count)\\n\",\"print(\\\"Missing libraries:\\\", missing_count)\\n\",\"\\n\",\"print(\\\"\\\\n[6] INITIAL VALIDATION\\\")\\n\",\"\\n\",\"seed_check = np.array_equal(\\n\",\"    np.random.RandomState(RANDOM_SEED).rand(5),\\n\",\"    np.random.RandomState(RANDOM_SEED).rand(5)\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"All required libraries available:\\\",\\n\",\"    missing_count == 0\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"Random seed reproducibility check:\\\",\\n\",\"    seed_check\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. Preserve record in notebook memory\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"experiment20_step1_record = reproducibility_record\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 1 EXECUTION COMPLETED\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"\\n\",\"CELL INDEX: 6\\n\",\"MATCH CATEGORIES: checkpoint_operations\\n\",\"SOURCE CODE:\\n\",\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 20 — STEP 2\\n\",\"# GOOGLE DRIVE ACCESS AND RESEARCH ARTIFACT DISCOVERY\\n\",\"# ============================================================\\n\",\"\\n\",\"from google.colab import drive\\n\",\"from pathlib import Path\\n\",\"import os\\n\",\"\\n\",\"drive.mount(\\\"/content/drive\\\")\\n\",\"\\n\",\"search_root = Path(\\\"/content/drive/MyDrive\\\")\\n\",\"\\n\",\"keywords = [\\n\",\"    \\\"lfw\\\",\\n\",\"    \\\"experiment_18\\\",\\n\",\"    \\\"experiment_19\\\",\\n\",\"    \\\"embedding\\\",\\n\",\"    \\\"facenet\\\",\\n\",\"    \\\"metadata\\\",\\n\",\"    \\\"research_evidence\\\",\\n\",\"    \\\"final_research_package\\\"\\n\",\"]\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"EXPERIMENT 20 — DRIVE ARTIFACT DISCOVERY\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"matches = []\\n\",\"\\n\",\"for root, directories, files in os.walk(search_root):\\n\",\"\\n\",\"    directories[:] = [\\n\",\"        d for d in directories\\n\",\"        if d not in {\\\".ipynb_checkpoints\\\", \\\"__pycache__\\\"}\\n\",\"    ]\\n\",\"\\n\",\"    for filename in files:\\n\",\"\\n\",\"        path = Path(root) / filename\\n\",\"        searchable = str(path).lower()\\n\",\"\\n\",\"        if any(keyword in searchable for keyword in keywords):\\n\",\"\\n\",\"            matches.append({\\n\",\"                \\\"filename\\\": filename,\\n\",\"                \\\"path\\\": str(path),\\n\",\"                \\\"size_mb\\\": round(\\n\",\"                    path.stat().st_size / (1024 ** 2), 3\\n\",\"                )\\n\",\"            })\\n\",\"\\n\",\"print(\\\"\\\\nMatching research artifacts:\\\", len(matches))\\n\",\"\\n\",\"for item in matches:\\n\",\"    print(\\n\",\"        f\\\"\\\\n{item['filename']}\\\"\\n\",\"        f\\\"\\\\nPath: {item['path']}\\\"\\n\",\"        f\\\"\\\\nSize: {item['size_mb']} MB\\\"\\n\",\"    )\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"DRIVE DISCOVERY COMPLETED\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"\\n\",\"CELL INDEX: 16\\n\",\"MATCH CATEGORIES: model_initialization\\n\",\"SOURCE CODE:\\n\",\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 20 — STEP 2.5\\n\",\"# FORMAL RESEARCH DESIGN DECISION RECORD\\n\",\"# ============================================================\\n\",\"\\n\",\"from pathlib import Path\\n\",\"import json\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Define output location\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"output_dir = Path(\\n\",\"    \\\"/content/drive/MyDrive/Experiment_20_Results/design\\\"\\n\",\")\\n\",\"\\n\",\"output_dir.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"output_file = output_dir / \\\"experiment20_stage_design.json\\\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Record agreed research decisions\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"design_record = {\\n\",\"    \\\"experiment\\\": 20,\\n\",\"    \\\"step\\\": \\\"2.5\\\",\\n\",\"    \\\"title\\\": (\\n\",\"        \\\"Paired Identity-Level Evaluation of Within-Identity \\\"\\n\",\"        \\\"Embedding Drift Detection Under Controlled \\\"\\n\",\"        \\\"Biometric Acquisition Changes\\\"\\n\",\"    ),\\n\",\"    \\\"dataset_strategy\\\": \\\"existing_plus_independent_validation\\\",\\n\",\"    \\\"stage_1\\\": {\\n\",\"        \\\"dataset\\\": \\\"LFW\\\",\\n\",\"        \\\"source\\\": \\\"Existing Experiment 18 illumination cohort\\\",\\n\",\"        \\\"paired_observations\\\": 889,\\n\",\"        \\\"identities\\\": 13,\\n\",\"        \\\"embedding_dimension\\\": 512,\\n\",\"        \\\"model\\\": \\\"InceptionResnetV1\\\",\\n\",\"        \\\"pretrained_weights\\\": \\\"VGGFace2\\\",\\n\",\"        \\\"purpose\\\": \\\"Method development and calibration\\\"\\n\",\"    },\\n\",\"    \\\"stage_2\\\": {\\n\",\"        \\\"dataset\\\": \\\"Extended Yale Face Database B\\\",\\n\",\"        \\\"purpose\\\": \\\"Independent validation\\\",\\n\",\"        \\\"embedding_generation\\\": \\\"Fresh extraction required\\\",\\n\",\"        \\\"pairing_strategy\\\": \\\"Identity and pose matched across illumination conditions\\\",\\n\",\"        \\\"status\\\": \\\"Pending acquisition and technical feasibility audit\\\"\\n\",\"    },\\n\",\"    \\\"acquisition_scope\\\": [\\n\",\"        \\\"illumination\\\"\\n\",\"    ],\\n\",\"    \\\"excluded_acquisition_variables\\\": [\\n\",\"        \\\"blur\\\",\\n\",\"        \\\"noise\\\",\\n\",\"        \\\"compression\\\"\\n\",\"    ],\\n\",\"    \\\"planned_detectors\\\": [\\n\",\"        \\\"global_euclidean\\\",\\n\",\"        \\\"global_mahalanobis\\\",\\n\",\"        \\\"identity_conditioned_standardized_euclidean\\\"\\n\",\"    ],\\n\",\"    \\\"validation_protocol\\\": {\\n\",\"        \\\"stage_1_threshold_calibration\\\": True,\\n\",\"        \\\"freeze_stage_1_methodology_before_stage_2\\\": True,\\n\",\"        \\\"stage_2_threshold_retuning\\\": False,\\n\",\"        \\\"stage_2_used_for_stage_1_tuning\\\": False,\\n\",\"        \\\"report_extraction_failures_separately\\\": True,\\n\",\"        \\\"prevent_source_image_partition_leakage\\\": True\\n\",\"    },\\n\",\"    \\\"known_limitations\\\": [\\n\",\"        \\\"Only 13 identities in the existing LFW paired cohort\\\",\\n\",\"        \\\"One identity represents 56.69 percent of paired observations\\\",\\n\",\"        \\\"67 of 956 original evaluation positions were excluded\\\",\\n\",\"        \\\"Extended Yale B is grayscale\\\",\\n\",\"        \\\"Embedding preprocessing compatibility remains unverified\\\"\\n\",\"    ],\\n\",\"    \\\"pending_verifications\\\": [\\n\",\"        \\\"Dataset access and usage conditions\\\",\\n\",\"        \\\"Source image and identity metadata\\\",\\n\",\"        \\\"Image-level pairing\\\",\\n\",\"        \\\"Grayscale preprocessing compatibility\\\",\\n\",\"        \\\"Embedding extraction success\\\",\\n\",\"        \\\"Partition sizes and random seeds\\\",\\n\",\"        \\\"Detector calibration and evaluation configuration\\\"\\n\",\"    ],\\n\",\"    \\\"decision_status\\\": \\\"DESIGN_AGREED_TECHNICAL_VALIDATION_PENDING\\\",\\n\",\"    \\\"created_utc\\\": datetime.now(timezone.utc).isoformat()\\n\",\"}\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Save the decision record\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"with open(output_file, \\\"w\\\", encoding=\\\"utf-8\\\") as file:\\n\",\"    json.dump(design_record, file, indent=4)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Reopen and verify the saved record\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"with open(output_file, \\\"r\\\", encoding=\\\"utf-8\\\") as file:\\n\",\"    verified_record = json.load(file)\\n\",\"\\n\",\"assert verified_record[\\\"experiment\\\"] == 20\\n\",\"assert verified_record[\\\"step\\\"] == \\\"2.5\\\"\\n\",\"assert verified_record[\\\"stage_1\\\"][\\\"paired_observations\\\"] == 889\\n\",\"assert verified_record[\\\"stage_2\\\"][\\\"dataset\\\"] == \\\"Extended Yale Face Database B\\\"\\n\",\"assert verified_record[\\\"validation_protocol\\\"][\\\"stage_2_threshold_retuning\\\"] is False\\n\",\"\\n\",\"print(\\\"=\\\" * 70)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 2.5\\\")\\n\",\"print(\\\"RESEARCH DESIGN DECISION RECORD\\\")\\n\",\"print(\\\"=\\\" * 70)\\n\",\"\\n\",\"print(\\\"Output file:\\\", output_file)\\n\",\"print(\\\"File exists:\\\", output_file.exists())\\n\",\"print(\\\"File size:\\\", output_file.stat().st_size, \\\"bytes\\\")\\n\",\"print(\\\"JSON reload verification: PASSED\\\")\\n\",\"print(\\\"Stage 1 dataset:\\\", verified_record[\\\"stage_1\\\"][\\\"dataset\\\"])\\n\",\"print(\\\"Stage 2 dataset:\\\", verified_record[\\\"stage_2\\\"][\\\"dataset\\\"])\\n\",\"print(\\\"Acquisition scope:\\\", verified_record[\\\"acquisition_scope\\\"])\\n\",\"print(\\\"Decision status:\\\", verified_record[\\\"decision_status\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nSTEP 2.5 DOCUMENTATION SAVED AND VERIFIED\\\")\\n\",\"print(\\\"No Experiment 18 files were modified.\\\")\\n\",\"print(\\\"=\\\" * 70)\\n\",\"\\n\",\"\\n\",\"CELL INDEX: 42\\n\",\"MATCH CATEGORIES: model_initialization, checkpoint_operations\\n\",\"SOURCE CODE:\\n\",\"import os\\n\",\"import json\\n\",\"import re\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"DRIVE_ROOT = \\\"/content/drive/MyDrive\\\"\\n\",\"\\n\",\"OUTPUT_DIR = os.path.join(\\n\",\"    DRIVE_ROOT,\\n\",\"    \\\"Experiment_20_Results\\\",\\n\",\"    \\\"dataset_audit\\\"\\n\",\")\\n\",\"\\n\",\"OUTPUT_PATH = os.path.join(\\n\",\"    OUTPUT_DIR,\\n\",\"    \\\"experiment20_facenet_preprocessing_compatibility_audit.json\\\"\\n\",\")\\n\",\"\\n\",\"os.makedirs(OUTPUT_DIR, exist_ok=True)\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 2.6.13: FACENET PREPROCESSING RECOVERY\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"if not os.path.isdir(DRIVE_ROOT):\\n\",\"    raise FileNotFoundError(\\n\",\"        \\\"Google Drive is not mounted. Mount Drive before running this cell.\\\"\\n\",\"    )\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 1. SEARCH ALL GOOGLE DRIVE NOTEBOOKS\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[1] SEARCHING GOOGLE DRIVE\\\")\\n\",\"\\n\",\"notebook_paths = []\\n\",\"artifact_paths = []\\n\",\"\\n\",\"excluded = {\\n\",\"    \\\".Trash\\\",\\n\",\"    \\\".ipynb_checkpoints\\\",\\n\",\"    \\\"__pycache__\\\"\\n\",\"}\\n\",\"\\n\",\"for current_root, directories, files in os.walk(DRIVE_ROOT):\\n\",\"\\n\",\"    directories[:] = [\\n\",\"        d for d in directories\\n\",\"        if d not in excluded\\n\",\"    ]\\n\",\"\\n\",\"    for filename in files:\\n\",\"\\n\",\"        full_path = os.path.join(current_root, filename)\\n\",\"        lower = filename.lower()\\n\",\"\\n\",\"        if lower.endswith(\\\".ipynb\\\"):\\n\",\"            notebook_paths.append(full_path)\\n\",\"\\n\",\"        elif (\\n\",\"            \\\"experiment18\\\" in lower\\n\",\"            or \\\"experiment_18\\\" in lower\\n\",\"            or \\\"illumination\\\" in lower\\n\",\"        ):\\n\",\"            artifact_paths.append(full_path)\\n\",\"\\n\",\"print(\\\"Total notebooks found:\\\", len(notebook_paths))\\n\",\"print(\\\"Potential supporting artifacts:\\\", len(artifact_paths))\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 2. INSPECT NOTEBOOKS FOR EXPERIMENT 18 EVIDENCE\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[2] NOTEBOOK CONTENT AUDIT\\\")\\n\",\"\\n\",\"search_terms = [\\n\",\"    \\\"InceptionResnetV1\\\",\\n\",\"    \\\"VGGFace2\\\",\\n\",\"    \\\"MTCNN\\\",\\n\",\"    \\\"fixed_image_standardization\\\",\\n\",\"    \\\"prewhiten\\\",\\n\",\"    \\\"Resize\\\",\\n\",\"    \\\"Normalize\\\",\\n\",\"    \\\"interpolate\\\",\\n\",\"    \\\"ToTensor\\\",\\n\",\"    \\\"face_detection\\\",\\n\",\"    \\\"alignment\\\",\\n\",\"    \\\"embedding_dimension\\\",\\n\",\"    \\\"experiment18_illumination_results\\\",\\n\",\"    \\\"experiment18_facenet_lfw_embeddings\\\"\\n\",\"]\\n\",\"\\n\",\"notebook_results = []\\n\",\"\\n\",\"for path in notebook_paths:\\n\",\"\\n\",\"    try:\\n\",\"        with open(path, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"            notebook = json.load(f)\\n\",\"\\n\",\"        evidence = []\\n\",\"        experiment18_reference = False\\n\",\"\\n\",\"        for cell_index, cell in enumerate(\\n\",\"            notebook.get(\\\"cells\\\", [])\\n\",\"        ):\\n\",\"\\n\",\"            source = cell.get(\\\"source\\\", [])\\n\",\"\\n\",\"            if isinstance(source, list):\\n\",\"                source = \\\"\\\".join(source)\\n\",\"\\n\",\"            if not isinstance(source, str):\\n\",\"                continue\\n\",\"\\n\",\"            source_lower = source.lower()\\n\",\"\\n\",\"            if (\\n\",\"                \\\"experiment 18\\\" in source_lower\\n\",\"                or \\\"experiment18\\\" in source_lower\\n\",\"                or \\\"experiment_18\\\" in source_lower\\n\",\"            ):\\n\",\"                experiment18_reference = True\\n\",\"\\n\",\"            matched = [\\n\",\"                term for term in search_terms\\n\",\"                if term.lower() in source_lower\\n\",\"            ]\\n\",\"\\n\",\"            if matched:\\n\",\"\\n\",\"                lines = source.splitlines()\\n\",\"                excerpts = []\\n\",\"\\n\",\"                for i, line in enumerate(lines):\\n\",\"                    if any(\\n\",\"                        term.lower() in line.lower()\\n\",\"                        for term in matched\\n\",\"                    ):\\n\",\"                        start = max(0, i - 2)\\n\",\"                        end = min(len(lines), i + 4)\\n\",\"\\n\",\"                        excerpts.extend(lines[start:end])\\n\",\"\\n\",\"                excerpts = list(dict.fromkeys(excerpts))\\n\",\"\\n\",\"                evidence.append({\\n\",\"                    \\\"cell_index\\\": cell_index,\\n\",\"                    \\\"matched_terms\\\": matched,\\n\",\"                    \\\"excerpt\\\": \\\"\\\\n\\\".join(excerpts)[:5000]\\n\",\"                })\\n\",\"\\n\",\"        if experiment18_reference or evidence:\\n\",\"\\n\",\"            notebook_results.append({\\n\",\"                \\\"path\\\": path,\\n\",\"                \\\"experiment18_reference\\\": experiment18_reference,\\n\",\"                \\\"evidence\\\": evidence\\n\",\"            })\\n\",\"\\n\",\"    except Exception as exc:\\n\",\"        print(\\\"Notebook read error:\\\", path, repr(exc))\\n\",\"\\n\",\"print(\\\"Relevant notebooks identified:\\\", len(notebook_results))\\n\",\"\\n\",\"for index, result in enumerate(notebook_results, 1):\\n\",\"\\n\",\"    print(\\\"\\\\n\\\" + \\\"-\\\" * 75)\\n\",\"    print(f\\\"NOTEBOOK {index}\\\")\\n\",\"    print(\\\"Path:\\\", result[\\\"path\\\"])\\n\",\"    print(\\\"Experiment 18 reference:\\\", result[\\\"experiment18_reference\\\"])\\n\",\"\\n\",\"    for item in result[\\\"evidence\\\"]:\\n\",\"        print(\\\"\\\\nCell:\\\", item[\\\"cell_index\\\"])\\n\",\"        print(\\\"Matched terms:\\\", item[\\\"matched_terms\\\"])\\n\",\"        print(item[\\\"excerpt\\\"])\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 3. LIST SUPPORTING EXPERIMENT 18 ARTIFACTS\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[3] SUPPORTING ARTIFACTS\\\")\\n\",\"\\n\",\"for path in artifact_paths:\\n\",\"    print(path)\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 4. IDENTIFY RELEVANT MODEL CONFIGURATION EVIDENCE\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"all_excerpts = \\\"\\\\n\\\".join(\\n\",\"    item[\\\"excerpt\\\"]\\n\",\"    for result in notebook_results\\n\",\"    for item in result[\\\"evidence\\\"]\\n\",\").lower()\\n\",\"\\n\",\"flags = {\\n\",\"    \\\"inceptionresnetv1\\\": \\\"inceptionresnetv1\\\" in all_excerpts,\\n\",\"    \\\"vggface2\\\": \\\"vggface2\\\" in all_excerpts,\\n\",\"    \\\"mtcnn\\\": \\\"mtcnn\\\" in all_excerpts,\\n\",\"    \\\"fixed_image_standardization\\\": (\\n\",\"        \\\"fixed_image_standardization\\\" in all_excerpts\\n\",\"    ),\\n\",\"    \\\"prewhiten\\\": \\\"prewhiten\\\" in all_excerpts,\\n\",\"    \\\"resize\\\": (\\n\",\"        \\\"resize\\\" in all_excerpts\\n\",\"        or \\\"interpolate\\\" in all_excerpts\\n\",\"    ),\\n\",\"    \\\"normalization\\\": \\\"normalize\\\" in all_excerpts,\\n\",\"    \\\"embedding_512\\\": \\\"512\\\" in all_excerpts\\n\",\"}\\n\",\"\\n\",\"print(\\\"\\\\n[4] CONFIGURATION EVIDENCE FLAGS\\\")\\n\",\"\\n\",\"for key, value in flags.items():\\n\",\"    print(f\\\"{key}: {value}\\\")\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 5. SAVE AUDIT\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"audit = {\\n\",\"    \\\"step\\\": \\\"2.6.13\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"drive_root\\\": DRIVE_ROOT,\\n\",\"    \\\"notebooks_scanned\\\": len(notebook_paths),\\n\",\"    \\\"relevant_note\\n\",\"\\n\",\"CELL INDEX: 44\\n\",\"MATCH CATEGORIES: model_initialization\\n\",\"SOURCE CODE:\\n\",\"import os\\n\",\"import json\\n\",\"\\n\",\"NOTEBOOK_PATH = (\\n\",\"    \\\"/content/drive/MyDrive/Colab Notebooks/\\\"\\n\",\"    \\\"Experiment_18_Genuine_Face_Recognition_Embedding_Validation.ipynb\\\"\\n\",\")\\n\",\"\\n\",\"assert os.path.isfile(NOTEBOOK_PATH), (\\n\",\"    \\\"Original Experiment 18 notebook not found: \\\" + NOTEBOOK_PATH\\n\",\")\\n\",\"\\n\",\"with open(NOTEBOOK_PATH, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    notebook = json.load(f)\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 2.6.14: EXACT PIPELINE RECOVERY\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"terms = [\\n\",\"    \\\"MTCNN(\\\",\\n\",\"    \\\"InceptionResnetV1(\\\",\\n\",\"    \\\"mtcnn(\\\",\\n\",\"    \\\"facenet(\\\",\\n\",\"    \\\"torch.nn.functional.normalize\\\",\\n\",\"    \\\"torch.no_grad\\\",\\n\",\"    \\\"embedding\\\"\\n\",\"]\\n\",\"\\n\",\"found = 0\\n\",\"\\n\",\"for index, cell in enumerate(notebook.get(\\\"cells\\\", [])):\\n\",\"\\n\",\"    source = cell.get(\\\"source\\\", [])\\n\",\"\\n\",\"    if isinstance(source, list):\\n\",\"        source = \\\"\\\".join(source)\\n\",\"\\n\",\"    if not isinstance(source, str):\\n\",\"        continue\\n\",\"\\n\",\"    matched = [\\n\",\"        term for term in terms\\n\",\"        if term.lower() in source.lower()\\n\",\"    ]\\n\",\"\\n\",\"    if matched:\\n\",\"        found += 1\\n\",\"        print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"        print(\\\"CELL INDEX:\\\", index)\\n\",\"        print(\\\"CELL TYPE:\\\", cell.get(\\\"cell_type\\\"))\\n\",\"        print(\\\"MATCHED TERMS:\\\", matched)\\n\",\"        print(\\\"-\\\" * 75)\\n\",\"        print(source)\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"TOTAL MATCHING CELLS:\\\", found)\\n\",\"print(\\\"NOTEBOOK:\\\", NOTEBOOK_PATH)\\n\",\"print(\\\"READ-ONLY INSPECTION COMPLETE\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"CELL INDEX: 46\\n\",\"MATCH CATEGORIES: model_initialization, software_versions\\n\",\"SOURCE CODE:\\n\",\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 20 — STEP 2.6.15\\n\",\"# CROPPEDYALE AND FACENET COMPATIBILITY TEST\\n\",\"# CORRECTED FILENAME PATTERN\\n\",\"# ============================================================\\n\",\"\\n\",\"import sys\\n\",\"import zipfile\\n\",\"import re\\n\",\"import importlib.metadata\\n\",\"import numpy as np\\n\",\"import torch\\n\",\"import torchvision\\n\",\"import facenet_pytorch\\n\",\"\\n\",\"from pathlib import Path\\n\",\"from PIL import Image\\n\",\"from io import BytesIO\\n\",\"from facenet_pytorch import MTCNN, InceptionResnetV1\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. VERIFY FACENET DEPENDENCIES\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"STEP 1 — FACENET DEPENDENCY VERIFICATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"package_version = importlib.metadata.version(\\\"facenet-pytorch\\\")\\n\",\"\\n\",\"print(\\\"facenet-pytorch:\\\", package_version)\\n\",\"print(\\\"PyTorch:\\\", torch.__version__)\\n\",\"print(\\\"Torchvision:\\\", torchvision.__version__)\\n\",\"\\n\",\"assert package_version == \\\"2.6.0\\\"\\n\",\"\\n\",\"print(\\\"MTCNN import: SUCCESS\\\")\\n\",\"print(\\\"InceptionResnetV1 import: SUCCESS\\\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. LOCATE AND VERIFY CROPPEDYALE ARCHIVE\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 2 — DATASET ARCHIVE VALIDATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"archive_path = Path(\\n\",\"    \\\"/content/Experiment20_Downloads/CroppedYale.zip\\\"\\n\",\")\\n\",\"\\n\",\"assert archive_path.exists(), (\\n\",\"    f\\\"CroppedYale archive not found: {archive_path}\\\"\\n\",\")\\n\",\"\\n\",\"with zipfile.ZipFile(archive_path, \\\"r\\\") as archive:\\n\",\"\\n\",\"    bad_member = archive.testzip()\\n\",\"\\n\",\"    assert bad_member is None, (\\n\",\"        f\\\"Archive integrity failure: {bad_member}\\\"\\n\",\"    )\\n\",\"\\n\",\"    members = archive.namelist()\\n\",\"\\n\",\"    # Corrected pattern:\\n\",\"    # Actual filename: yaleB39_P00A+000E+00.pgm\\n\",\"    standard_pattern = re.compile(\\n\",\"        r\\\"yaleB\\\\d+_P00A[+-]\\\\d+E[+-]\\\\d+\\\\.pgm$\\\",\\n\",\"        re.IGNORECASE\\n\",\"    )\\n\",\"\\n\",\"    ambient_pattern = re.compile(\\n\",\"        r\\\"yaleB\\\\d+_P00_Ambient\\\\.pgm$\\\",\\n\",\"        re.IGNORECASE\\n\",\"    )\\n\",\"\\n\",\"    standard_images = sorted([\\n\",\"        name for name in members\\n\",\"        if standard_pattern.search(Path(name).name)\\n\",\"    ])\\n\",\"\\n\",\"    ambient_images = sorted([\\n\",\"        name for name in members\\n\",\"        if ambient_pattern.search(Path(name).name)\\n\",\"    ])\\n\",\"\\n\",\"print(\\\"Archive integrity: PASSED\\\")\\n\",\"print(\\\"Standard illumination images:\\\", len(standard_images))\\n\",\"print(\\\"Ambient images:\\\", len(ambient_images))\\n\",\"\\n\",\"assert len(standard_images) == 2414, (\\n\",\"    f\\\"Expected 2414 standard images, found {len(standard_images)}\\\"\\n\",\")\\n\",\"\\n\",\"assert len(ambient_images) == 38, (\\n\",\"    f\\\"Expected 38 ambient images, found {len(ambient_images)}\\\"\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. SELECT 12 DETERMINISTIC TEST IMAGES\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 3 — TEST IMAGE SELECTION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"sample_count = min(12, len(standard_images))\\n\",\"\\n\",\"sample_positions = np.linspace(\\n\",\"    0,\\n\",\"    len(standard_images) - 1,\\n\",\"    sample_count,\\n\",\"    dtype=int\\n\",\")\\n\",\"\\n\",\"sample_members = [\\n\",\"    standard_images[position]\\n\",\"    for position in sample_positions\\n\",\"]\\n\",\"\\n\",\"print(\\\"Selected images:\\\", len(sample_members))\\n\",\"\\n\",\"for member in sample_members:\\n\",\"    print(Path(member).name)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. INITIALISE ORIGINAL EXPERIMENT 18 MODEL\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 4 — FACENET MODEL INITIALISATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"device = torch.device(\\\"cpu\\\")\\n\",\"\\n\",\"mtcnn = MTCNN(\\n\",\"    image_size=160,\\n\",\"    margin=0,\\n\",\"    keep_all=False,\\n\",\"    device=device\\n\",\")\\n\",\"\\n\",\"facenet = InceptionResnetV1(\\n\",\"    pretrained=\\\"vggface2\\\"\\n\",\").eval().to(device)\\n\",\"\\n\",\"print(\\\"MTCNN initialised successfully.\\\")\\n\",\"print(\\\"FaceNet initialised successfully.\\\")\\n\",\"print(\\\"Pretrained weights: VGGFace2\\\")\\n\",\"print(\\\"Execution device:\\\", device)\\n\",\"print(\\\"Embedding dimension:\\\", facenet.last_linear.out_features)\\n\",\"\\n\",\"assert facenet.last_linear.out_features == 512\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. GRAYSCALE CONVERSION AND EMBEDDING EXTRACTION\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 5 — CROPPEDYALE COMPATIBILITY TEST\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"results = []\\n\",\"\\n\",\"with zipfile.ZipFile(archive_path, \\\"r\\\") as archive:\\n\",\"\\n\",\"    for member in sample_members:\\n\",\"\\n\",\"        result = {\\n\",\"            \\\"image\\\": Path(member).name,\\n\",\"            \\\"original_mode\\\": None,\\n\",\"            \\\"original_size\\\": None,\\n\",\"            \\\"rgb_size\\\": None,\\n\",\"            \\\"mtcnn_success\\\": False,\\n\",\"            \\\"embedding_success\\\": False,\\n\",\"            \\\"embedding_dimension\\\": None,\\n\",\"            \\\"embedding_finite\\\": False,\\n\",\"            \\\"embedding_l2_norm\\\": None,\\n\",\"            \\\"error\\\": None\\n\",\"        }\\n\",\"\\n\",\"        try:\\n\",\"\\n\",\"            image_bytes = archive.read(member)\\n\",\"\\n\",\"            with Image.open(BytesIO(image_bytes)) as source_image:\\n\",\"\\n\",\"                result[\\\"original_mode\\\"] = source_image.mode\\n\",\"                result[\\\"original_size\\\"] = source_image.size\\n\",\"\\n\",\"                grayscale_image = source_image.convert(\\\"L\\\")\\n\",\"\\n\",\"                # Replicate grayscale into three RGB channels.\\n\",\"                rgb_image = grayscale_image.convert(\\\"RGB\\\")\\n\",\"\\n\",\"            result[\\\"rgb_size\\\"] = rgb_image.size\\n\",\"\\n\",\"            # Original Experiment 18 MTCNN configuration.\\n\",\"            face_tensor = mtcnn(rgb_image)\\n\",\"\\n\",\"            if face_tensor is None:\\n\",\"\\n\",\"                result[\\\"error\\\"] = (\\n\",\"                    \\\"MTCNN did not detect a face.\\\"\\n\",\"                )\\n\",\"\\n\",\"            else:\\n\",\"\\n\",\"                result[\\\"mtcnn_success\\\"] = True\\n\",\"\\n\",\"                with torch.no_grad():\\n\",\"\\n\",\"                    embedding = facenet(\\n\",\"                        face_tensor.unsqueeze(0).to(device)\\n\",\"                    )\\n\",\"\\n\",\"                embedding_np = embedding.cpu().numpy()[0]\\n\",\"\\n\",\"                embedding_norm = np.linalg.norm(embedding_np)\\n\",\"\\n\",\"                result[\\\"embedding_dimension\\\"] = len(embedding_np)\\n\",\"\\n\",\"                result[\\\"embedding_finite\\\"] = bool(\\n\",\"                    np.isfinite(embedding_np).all()\\n\",\"                )\\n\",\"\\n\",\"                result[\\\"embedding_l2_norm\\\"] = float(\\n\",\"                    embedding_norm\\n\",\"   \\n\",\"\\n\",\"CELL INDEX: 48\\n\",\"MATCH CATEGORIES: resize, model_initialization, software_versions\\n\",\"SOURCE CODE:\\n\",\"\\n\",\"import os\\n\",\"import re\\n\",\"import zipfile\\n\",\"import numpy as np\\n\",\"import torch\\n\",\"from PIL import Image\\n\",\"from torchvision import transforms\\n\",\"from facenet_pytorch import InceptionResnetV1\\n\",\"from importlib.metadata import version\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. CONFIGURATION\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"archive_path = \\\"/content/Experiment20_Downloads/CroppedYale.zip\\\"\\n\",\"\\n\",\"assert os.path.exists(archive_path), \\\"CroppedYale archive not found.\\\"\\n\",\"\\n\",\"device = torch.device(\\\"cpu\\\")\\n\",\"\\n\",\"# Reuse the existing FaceNet model if it is still available.\\n\",\"# Otherwise initialise the same VGGFace2 model.\\n\",\"if \\\"facenet\\\" not in globals():\\n\",\"    facenet = InceptionResnetV1(\\n\",\"        pretrained=\\\"vggface2\\\"\\n\",\"    ).eval().to(device)\\n\",\"\\n\",\"facenet.eval()\\n\",\"\\n\",\"# Match the 160 x 160 FaceNet input dimensions.\\n\",\"direct_transform = transforms.Compose([\\n\",\"    transforms.Resize((160, 160)),\\n\",\"    transforms.ToTensor()\\n\",\"])\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. SELECT THE SAME 12 IMAGES\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"test_filenames = [\\n\",\"    \\\"yaleB01_P00A+000E+00.pgm\\\",\\n\",\"    \\\"yaleB04_P00A+085E-20.pgm\\\",\\n\",\"    \\\"yaleB07_P00A-070E-35.pgm\\\",\\n\",\"    \\\"yaleB11_P00A+035E-20.pgm\\\",\\n\",\"    \\\"yaleB15_P00A-110E+40.pgm\\\",\\n\",\"    \\\"yaleB19_P00A+085E+20.pgm\\\",\\n\",\"    \\\"yaleB22_P00A-070E-35.pgm\\\",\\n\",\"    \\\"yaleB26_P00A+035E+65.pgm\\\",\\n\",\"    \\\"yaleB29_P00A-035E+15.pgm\\\",\\n\",\"    \\\"yaleB33_P00A+010E+00.pgm\\\",\\n\",\"    \\\"yaleB36_P00A-005E+10.pgm\\\",\\n\",\"    \\\"yaleB39_P00A-130E+20.pgm\\\"\\n\",\"]\\n\",\"\\n\",\"# Locate exact archive paths.\\n\",\"with zipfile.ZipFile(archive_path, \\\"r\\\") as archive:\\n\",\"\\n\",\"    archive_names = archive.namelist()\\n\",\"\\n\",\"    selected_paths = {}\\n\",\"\\n\",\"    for filename in test_filenames:\\n\",\"\\n\",\"        matches = [\\n\",\"            name for name in archive_names\\n\",\"            if name.endswith(\\\"/\\\" + filename)\\n\",\"        ]\\n\",\"\\n\",\"        assert len(matches) == 1, (\\n\",\"            f\\\"Expected exactly one archive match for {filename}; \\\"\\n\",\"            f\\\"found {len(matches)}\\\"\\n\",\"        )\\n\",\"\\n\",\"        selected_paths[filename] = matches[0]\\n\",\"\\n\",\"    # --------------------------------------------------------\\n\",\"    # 3. DIRECT FACE NET EMBEDDING TEST\\n\",\"    # --------------------------------------------------------\\n\",\"\\n\",\"    results = []\\n\",\"\\n\",\"    print(\\\"=\\\" * 75)\\n\",\"    print(\\\"DIRECT FACENET COMPATIBILITY TEST\\\")\\n\",\"    print(\\\"=\\\" * 75)\\n\",\"\\n\",\"    with torch.no_grad():\\n\",\"\\n\",\"        for filename, archive_path_inside in selected_paths.items():\\n\",\"\\n\",\"            print(\\\"\\\\nImage:\\\", filename)\\n\",\"\\n\",\"            try:\\n\",\"\\n\",\"                image_bytes = archive.read(archive_path_inside)\\n\",\"\\n\",\"                import io\\n\",\"\\n\",\"                image = Image.open(\\n\",\"                    io.BytesIO(image_bytes)\\n\",\"                ).convert(\\\"RGB\\\")\\n\",\"\\n\",\"                original_dimensions = image.size\\n\",\"\\n\",\"                tensor = direct_transform(image).unsqueeze(0).to(device)\\n\",\"\\n\",\"                embedding = facenet(tensor)\\n\",\"\\n\",\"                embedding_np = embedding.cpu().numpy().reshape(-1)\\n\",\"\\n\",\"                valid_dimension = embedding_np.shape[0] == 512\\n\",\"                finite = np.isfinite(embedding_np).all()\\n\",\"\\n\",\"                l2_norm = float(np.linalg.norm(embedding_np))\\n\",\"\\n\",\"                valid = (\\n\",\"                    valid_dimension\\n\",\"                    and finite\\n\",\"                    and np.isclose(l2_norm, 1.0, atol=1e-4)\\n\",\"                )\\n\",\"\\n\",\"                result = {\\n\",\"                    \\\"filename\\\": filename,\\n\",\"                    \\\"original_dimensions\\\": original_dimensions,\\n\",\"                    \\\"embedding_dimension\\\": int(embedding_np.shape[0]),\\n\",\"                    \\\"finite\\\": bool(finite),\\n\",\"                    \\\"l2_norm\\\": l2_norm,\\n\",\"                    \\\"valid\\\": bool(valid),\\n\",\"                    \\\"error\\\": None\\n\",\"                }\\n\",\"\\n\",\"                print(\\\"Original dimensions:\\\", original_dimensions)\\n\",\"                print(\\\"Input tensor shape:\\\", tuple(tensor.shape))\\n\",\"                print(\\\"Embedding dimension:\\\", result[\\\"embedding_dimension\\\"])\\n\",\"                print(\\\"Finite:\\\", finite)\\n\",\"                print(\\\"L2 norm:\\\", l2_norm)\\n\",\"                print(\\\"Valid embedding:\\\", valid)\\n\",\"\\n\",\"            except Exception as exc:\\n\",\"\\n\",\"                result = {\\n\",\"                    \\\"filename\\\": filename,\\n\",\"                    \\\"original_dimensions\\\": None,\\n\",\"                    \\\"embedding_dimension\\\": None,\\n\",\"                    \\\"finite\\\": False,\\n\",\"                    \\\"l2_norm\\\": None,\\n\",\"                    \\\"valid\\\": False,\\n\",\"                    \\\"error\\\": str(exc)\\n\",\"                }\\n\",\"\\n\",\"                print(\\\"ERROR:\\\", str(exc))\\n\",\"\\n\",\"            results.append(result)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. SUMMARY\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"successes = sum(item[\\\"valid\\\"] for item in results)\\n\",\"failures = len(results) - successes\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"DIRECT FACENET COMPATIBILITY SUMMARY\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"print(\\\"Images tested:\\\", len(results))\\n\",\"print(\\\"Valid embeddings:\\\", successes)\\n\",\"print(\\\"Invalid embeddings:\\\", failures)\\n\",\"print(\\\"Success rate:\\\", round(successes / len(results) * 100, 2), \\\"%\\\")\\n\",\"\\n\",\"print(\\\"\\\\nSoftware versions:\\\")\\n\",\"print(\\\"facenet-pytorch:\\\", version(\\\"facenet-pytorch\\\"))\\n\",\"print(\\\"PyTorch:\\\", torch.__version__)\\n\",\"print(\\\"Torchvision:\\\", version(\\\"torchvision\\\"))\\n\",\"\\n\",\"print(\\\"\\\\nNo full-dataset embeddings generated.\\\")\\n\",\"print(\\\"No source archive files modified.\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"\\n\",\"CELL INDEX: 52\\n\",\"MATCH CATEGORIES: resize, software_versions\\n\",\"SOURCE CODE:\\n\",\"\\n\",\"import os\\n\",\"import re\\n\",\"import io\\n\",\"import json\\n\",\"import zipfile\\n\",\"import hashlib\\n\",\"import numpy as np\\n\",\"import torch\\n\",\"\\n\",\"from PIL import Image\\n\",\"from torchvision import transforms\\n\",\"from collections import Counter\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"# ============================================================\\n\",\"# STEP 2.6.18 — PREPROCESSING CONSISTENCY AUDIT\\n\",\"# ============================================================\\n\",\"\\n\",\"archive_path = \\\"/content/Experiment20_Downloads/CroppedYale.zip\\\"\\n\",\"\\n\",\"audit_dir = (\\n\",\"    \\\"/content/drive/MyDrive/Experiment_20_Results/\\\"\\n\",\"    \\\"dataset_audit\\\"\\n\",\")\\n\",\"\\n\",\"os.makedirs(audit_dir, exist_ok=True)\\n\",\"\\n\",\"output_path = os.path.join(\\n\",\"    audit_dir,\\n\",\"    \\\"experiment20_preprocessing_consistency_audit.json\\\"\\n\",\")\\n\",\"\\n\",\"assert os.path.exists(archive_path), (\\n\",\"    f\\\"Archive not found: {archive_path}\\\"\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. FROZEN PREPROCESSING CONFIGURATION\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"standard_pattern = re.compile(\\n\",\"    r\\\"yaleB(\\\\d+)_P00A([+-]\\\\d+)E([+-]\\\\d+)\\\\.pgm$\\\"\\n\",\")\\n\",\"\\n\",\"preprocessing = transforms.Compose([\\n\",\"    transforms.Resize((160, 160)),\\n\",\"    transforms.ToTensor()\\n\",\"])\\n\",\"\\n\",\"expected_shape = (3, 160, 160)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. ARCHIVE AND IMAGE SELECTION\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"STEP 1 — DATASET IMAGE SELECTION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"with zipfile.ZipFile(archive_path, \\\"r\\\") as archive:\\n\",\"\\n\",\"    assert archive.testzip() is None, (\\n\",\"        \\\"Archive integrity check failed.\\\"\\n\",\"    )\\n\",\"\\n\",\"    standard_paths = []\\n\",\"\\n\",\"    for path in archive.namelist():\\n\",\"\\n\",\"        if not path.lower().endswith(\\\".pgm\\\"):\\n\",\"            continue\\n\",\"\\n\",\"        filename = os.path.basename(path)\\n\",\"\\n\",\"        if standard_pattern.fullmatch(filename):\\n\",\"            standard_paths.append(path)\\n\",\"\\n\",\"    standard_paths.sort()\\n\",\"\\n\",\"    print(\\\"Standard illumination images:\\\", len(standard_paths))\\n\",\"\\n\",\"    assert len(standard_paths) == 2414, (\\n\",\"        f\\\"Expected 2414 images, found {len(standard_paths)}\\\"\\n\",\"    )\\n\",\"\\n\",\"    # --------------------------------------------------------\\n\",\"    # 3. PREPROCESSING VALIDATION\\n\",\"    # --------------------------------------------------------\\n\",\"\\n\",\"    print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"    print(\\\"STEP 2 — PREPROCESSING VALIDATION\\\")\\n\",\"    print(\\\"=\\\" * 75)\\n\",\"\\n\",\"    processing_failures = []\\n\",\"    mode_failures = []\\n\",\"    dimension_failures = []\\n\",\"    shape_failures = []\\n\",\"    nonfinite_failures = []\\n\",\"    range_failures = []\\n\",\"    reproducibility_failures = []\\n\",\"\\n\",\"    output_shapes = Counter()\\n\",\"    output_dtypes = Counter()\\n\",\"    subject_counts = Counter()\\n\",\"\\n\",\"    global_min = float(\\\"inf\\\")\\n\",\"    global_max = float(\\\"-inf\\\")\\n\",\"\\n\",\"    sample_records = []\\n\",\"\\n\",\"    for index, path in enumerate(standard_paths, start=1):\\n\",\"\\n\",\"        filename = os.path.basename(path)\\n\",\"\\n\",\"        match = standard_pattern.fullmatch(filename)\\n\",\"\\n\",\"        subject = f\\\"yaleB{int(match.group(1)):02d}\\\"\\n\",\"\\n\",\"        subject_counts[subject] += 1\\n\",\"\\n\",\"        try:\\n\",\"\\n\",\"            image_bytes = archive.read(path)\\n\",\"\\n\",\"            with Image.open(io.BytesIO(image_bytes)) as source:\\n\",\"\\n\",\"                source.load()\\n\",\"\\n\",\"                # The source image must be grayscale.\\n\",\"                if source.mode != \\\"L\\\":\\n\",\"                    mode_failures.append({\\n\",\"                        \\\"path\\\": path,\\n\",\"                        \\\"mode\\\": source.mode\\n\",\"                    })\\n\",\"\\n\",\"                # Convert grayscale to three-channel RGB.\\n\",\"                rgb_image = source.convert(\\\"RGB\\\")\\n\",\"\\n\",\"                if rgb_image.mode != \\\"RGB\\\":\\n\",\"                    mode_failures.append({\\n\",\"                        \\\"path\\\": path,\\n\",\"                        \\\"converted_mode\\\": rgb_image.mode\\n\",\"                    })\\n\",\"\\n\",\"                # Resize and convert to tensor.\\n\",\"                tensor_first = preprocessing(rgb_image)\\n\",\"\\n\",\"                # Repeat preprocessing independently.\\n\",\"                tensor_second = preprocessing(\\n\",\"                    source.convert(\\\"RGB\\\")\\n\",\"                )\\n\",\"\\n\",\"                # Validate dimensions.\\n\",\"                if rgb_image.size != (168, 192):\\n\",\"                    dimension_failures.append({\\n\",\"                        \\\"path\\\": path,\\n\",\"                        \\\"dimensions\\\": list(rgb_image.size)\\n\",\"                    })\\n\",\"\\n\",\"                # Validate tensor shape.\\n\",\"                if tuple(tensor_first.shape) != expected_shape:\\n\",\"                    shape_failures.append({\\n\",\"                        \\\"path\\\": path,\\n\",\"                        \\\"shape\\\": list(tensor_first.shape)\\n\",\"                    })\\n\",\"\\n\",\"                # Validate numerical finiteness.\\n\",\"                if not torch.isfinite(tensor_first).all():\\n\",\"                    nonfinite_failures.append(path)\\n\",\"\\n\",\"                # Validate tensor range.\\n\",\"                tensor_min = float(tensor_first.min())\\n\",\"                tensor_max = float(tensor_first.max())\\n\",\"\\n\",\"                if tensor_min < 0.0 or tensor_max > 1.0:\\n\",\"                    range_failures.append({\\n\",\"                        \\\"path\\\": path,\\n\",\"                        \\\"minimum\\\": tensor_min,\\n\",\"                        \\\"maximum\\\": tensor_max\\n\",\"                    })\\n\",\"\\n\",\"                global_min = min(global_min, tensor_min)\\n\",\"                global_max = max(global_max, tensor_max)\\n\",\"\\n\",\"                # Validate reproducibility.\\n\",\"                if not torch.equal(\\n\",\"                    tensor_first,\\n\",\"                    tensor_second\\n\",\"                ):\\n\",\"                    reproducibility_failures.append(path)\\n\",\"\\n\",\"                output_shapes[str(tuple(tensor_first.shape))] += 1\\n\",\"                output_dtypes[str(tensor_first.dtype)] += 1\\n\",\"\\n\",\"                if index <= 12:\\n\",\"                    sample_records.append({\\n\",\"                        \\\"filename\\\": filename,\\n\",\"                        \\\"subject\\\": subject,\\n\",\"                        \\\"source_mode\\\": source.mode,\\n\",\"                        \\\"rgb_mode\\\": rgb_image.mode,\\n\",\"                        \\\"rgb_dimensions\\\": list(rgb_image.size),\\n\",\"                        \\\"tensor_shape\\\": list(tensor_first.shape),\\n\",\"                        \\\"tensor_dtype\\\": str(tensor_first.dtype),\\n\",\"                        \\\"tensor_min\\\": tensor_min,\\n\",\"                        \\\"tensor_max\\\": tensor_max,\\n\",\"  \\n\",\"\\n\",\"CELL INDEX: 54\\n\",\"MATCH CATEGORIES: resize, model_initialization, checkpoint_operations, software_versions\\n\",\"SOURCE CODE:\\n\",\"\\n\",\"import os\\n\",\"import re\\n\",\"import io\\n\",\"import json\\n\",\"import time\\n\",\"import hashlib\\n\",\"import zipfile\\n\",\"import platform\\n\",\"import numpy as np\\n\",\"import torch\\n\",\"\\n\",\"from PIL import Image\\n\",\"from torchvision import transforms\\n\",\"from facenet_pytorch import InceptionResnetV1\\n\",\"from importlib.metadata import version\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"# ============================================================\\n\",\"# STEP 2.6.19 — FULL-DATASET FACENET EMBEDDING GENERATION\\n\",\"# ============================================================\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. PATHS AND CONFIGURATION\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"archive_path = \\\"/content/Experiment20_Downloads/CroppedYale.zip\\\"\\n\",\"\\n\",\"base_dir = (\\n\",\"    \\\"/content/drive/MyDrive/Experiment_20_Results\\\"\\n\",\")\\n\",\"\\n\",\"embedding_dir = os.path.join(\\n\",\"    base_dir,\\n\",\"    \\\"embeddings\\\"\\n\",\")\\n\",\"\\n\",\"checkpoint_dir = os.path.join(\\n\",\"    embedding_dir,\\n\",\"    \\\"checkpoints\\\"\\n\",\")\\n\",\"\\n\",\"audit_dir = os.path.join(\\n\",\"    base_dir,\\n\",\"    \\\"dataset_audit\\\"\\n\",\")\\n\",\"\\n\",\"os.makedirs(embedding_dir, exist_ok=True)\\n\",\"os.makedirs(checkpoint_dir, exist_ok=True)\\n\",\"os.makedirs(audit_dir, exist_ok=True)\\n\",\"\\n\",\"final_archive_path = os.path.join(\\n\",\"    embedding_dir,\\n\",\"    \\\"experiment20_croppedyale_facenet_embeddings.npz\\\"\\n\",\")\\n\",\"\\n\",\"final_metadata_path = os.path.join(\\n\",\"    embedding_dir,\\n\",\"    \\\"experiment20_croppedyale_embedding_metadata.json\\\"\\n\",\")\\n\",\"\\n\",\"final_config_path = os.path.join(\\n\",\"    embedding_dir,\\n\",\"    \\\"experiment20_embedding_generation_config.json\\\"\\n\",\")\\n\",\"\\n\",\"checkpoint_path = os.path.join(\\n\",\"    checkpoint_dir,\\n\",\"    \\\"experiment20_embedding_checkpoint.npz\\\"\\n\",\")\\n\",\"\\n\",\"checkpoint_metadata_path = os.path.join(\\n\",\"    checkpoint_dir,\\n\",\"    \\\"experiment20_embedding_checkpoint_metadata.json\\\"\\n\",\")\\n\",\"\\n\",\"EXPECTED_IMAGES = 2414\\n\",\"EMBEDDING_DIMENSION = 512\\n\",\"CHECKPOINT_INTERVAL = 100\\n\",\"\\n\",\"device = torch.device(\\\"cpu\\\")\\n\",\"\\n\",\"standard_pattern = re.compile(\\n\",\"    r\\\"yaleB(\\\\d+)_P00A([+-]\\\\d+)E([+-]\\\\d+)\\\\.pgm$\\\"\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. ENVIRONMENT VALIDATION\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"STEP 1 — ENVIRONMENT VALIDATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"assert os.path.exists(archive_path), (\\n\",\"    f\\\"Dataset archive not found: {archive_path}\\\"\\n\",\")\\n\",\"\\n\",\"assert torch.cuda.is_available() is False or device.type == \\\"cpu\\\"\\n\",\"\\n\",\"print(\\\"Python:\\\", platform.python_version())\\n\",\"print(\\\"PyTorch:\\\", torch.__version__)\\n\",\"print(\\\"Torchvision:\\\", version(\\\"torchvision\\\"))\\n\",\"print(\\\"facenet-pytorch:\\\", version(\\\"facenet-pytorch\\\"))\\n\",\"print(\\\"Execution device:\\\", device)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. DATASET ARCHIVE VALIDATION\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 2 — DATASET VALIDATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"archive_sha256 = hashlib.sha256()\\n\",\"\\n\",\"with open(archive_path, \\\"rb\\\") as f:\\n\",\"    for chunk in iter(lambda: f.read(1024 * 1024), b\\\"\\\"):\\n\",\"        archive_sha256.update(chunk)\\n\",\"\\n\",\"archive_hash = archive_sha256.hexdigest()\\n\",\"\\n\",\"with zipfile.ZipFile(archive_path, \\\"r\\\") as archive:\\n\",\"\\n\",\"    assert archive.testzip() is None, (\\n\",\"        \\\"ZIP archive integrity validation failed.\\\"\\n\",\"    )\\n\",\"\\n\",\"    standard_paths = []\\n\",\"\\n\",\"    for path in archive.namelist():\\n\",\"\\n\",\"        if not path.lower().endswith(\\\".pgm\\\"):\\n\",\"            continue\\n\",\"\\n\",\"        filename = os.path.basename(path)\\n\",\"\\n\",\"        if standard_pattern.fullmatch(filename):\\n\",\"            standard_paths.append(path)\\n\",\"\\n\",\"    standard_paths.sort()\\n\",\"\\n\",\"    assert len(standard_paths) == EXPECTED_IMAGES, (\\n\",\"        f\\\"Expected {EXPECTED_IMAGES} standard images; \\\"\\n\",\"        f\\\"found {len(standard_paths)}\\\"\\n\",\"    )\\n\",\"\\n\",\"    print(\\\"Archive integrity: PASSED\\\")\\n\",\"    print(\\\"Standard images:\\\", len(standard_paths))\\n\",\"    print(\\\"Archive SHA256:\\\", archive_hash)\\n\",\"\\n\",\"    # --------------------------------------------------------\\n\",\"    # 4. MODEL INITIALISATION\\n\",\"    # --------------------------------------------------------\\n\",\"\\n\",\"    print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"    print(\\\"STEP 3 — FACENET MODEL INITIALISATION\\\")\\n\",\"    print(\\\"=\\\" * 75)\\n\",\"\\n\",\"    if \\\"facenet\\\" not in globals():\\n\",\"        facenet = InceptionResnetV1(\\n\",\"            pretrained=\\\"vggface2\\\"\\n\",\"        ).eval().to(device)\\n\",\"    else:\\n\",\"        facenet = facenet.eval().to(device)\\n\",\"\\n\",\"    assert isinstance(facenet, InceptionResnetV1)\\n\",\"\\n\",\"    facenet.eval()\\n\",\"\\n\",\"    print(\\\"Model: InceptionResnetV1\\\")\\n\",\"    print(\\\"Pretrained weights: VGGFace2\\\")\\n\",\"    print(\\\"Embedding dimension:\\\", EMBEDDING_DIMENSION)\\n\",\"    print(\\\"Model mode: Evaluation\\\")\\n\",\"\\n\",\"    # --------------------------------------------------------\\n\",\"    # 5. FROZEN PREPROCESSING\\n\",\"    # --------------------------------------------------------\\n\",\"\\n\",\"    preprocessing = transforms.Compose([\\n\",\"        transforms.Resize((160, 160)),\\n\",\"        transforms.ToTensor()\\n\",\"    ])\\n\",\"\\n\",\"    # --------------------------------------------------------\\n\",\"    # 6. CHECKPOINT RECOVERY\\n\",\"    # --------------------------------------------------------\\n\",\"\\n\",\"    embeddings = []\\n\",\"    filenames = []\\n\",\"    subjects = []\\n\",\"    subject_numbers = []\\n\",\"    azimuths = []\\n\",\"    elevations = []\\n\",\"    conditions = []\\n\",\"\\n\",\"    failures = []\\n\",\"    processed_paths = set()\\n\",\"\\n\",\"    start_index = 0\\n\",\"\\n\",\"    if (\\n\",\"        os.path.exists(checkpoint_path)\\n\",\"        and os.path.exists(checkpoint_metadata_path)\\n\",\"    ):\\n\",\"\\n\",\"        print(\\\"\\\\nExisting checkpoint detected.\\\")\\n\",\"\\n\",\"        with open(\\n\",\"            checkpoint_metadata_path,\\n\",\"            \\\"r\\\",\\n\",\"            encoding=\\\"utf-8\\\"\\n\",\"        ) as f:\\n\",\"            checkpoint_metadata = json.load(f)\\n\",\"\\n\",\"        if (\\n\",\"            checkpoint_metadata.get(\\\"archive_sha256\\\") == archive_hash\\n\",\"            and checkpoint_metadata.get(\\\"expected_images\\\") == EXPECTED_IMAGES\\n\",\"            and checkpoint_metadata.get(\\\"embedding_dimension\\\") == EMBEDDING_DIMENSION\\n\",\"        ):\\n\",\"\\n\",\"            checkpoint = np.load(\\n\",\"                checkpoint_path,\\n\",\"                allow_pickle=False\\n\",\"            )\\n\",\"\\n\",\"            embeddings = checkpoint[\\\"embeddings\\\"].tolist()\\n\",\"            filenames = checkpoint[\\\"filenames\\\"].tolist()\\n\",\"            subjects = checkpoint[\\\"subjects\\\"].tolist()\\n\",\"            subject_numbers = checkpoint[\\\"subject_numbers\\\"].tolist()\\n\",\"            azimuths = checkpoint[\\\"azimuths\\\"].tolist()\\n\",\"            elevations = checkpoint[\\\"elevatio\\n\",\"\\n\",\"CELL INDEX: 58\\n\",\"MATCH CATEGORIES: model_initialization, checkpoint_operations, software_versions\\n\",\"SOURCE CODE:\\n\",\"\\n\",\"import os\\n\",\"import json\\n\",\"import shutil\\n\",\"import hashlib\\n\",\"import zipfile\\n\",\"import platform\\n\",\"\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"# ============================================================\\n\",\"# STEP 2.6.21 — DATASET PACKAGING AND FREEZE\\n\",\"# ============================================================\\n\",\"\\n\",\"BASE = \\\"/content/drive/MyDrive/Experiment_20_Results\\\"\\n\",\"\\n\",\"SOURCE_ARCHIVE = (\\n\",\"    \\\"/content/Experiment20_Downloads/CroppedYale.zip\\\"\\n\",\")\\n\",\"\\n\",\"EMBEDDING_DIR = os.path.join(BASE, \\\"embeddings\\\")\\n\",\"AUDIT_DIR = os.path.join(BASE, \\\"dataset_audit\\\")\\n\",\"\\n\",\"EMBEDDING_ARCHIVE = os.path.join(\\n\",\"    EMBEDDING_DIR,\\n\",\"    \\\"experiment20_croppedyale_facenet_embeddings.npz\\\"\\n\",\")\\n\",\"\\n\",\"EMBEDDING_METADATA = os.path.join(\\n\",\"    EMBEDDING_DIR,\\n\",\"    \\\"experiment20_croppedyale_embedding_metadata.json\\\"\\n\",\")\\n\",\"\\n\",\"EMBEDDING_CONFIG = os.path.join(\\n\",\"    EMBEDDING_DIR,\\n\",\"    \\\"experiment20_embedding_generation_config.json\\\"\\n\",\")\\n\",\"\\n\",\"PACKAGE_ROOT = os.path.join(\\n\",\"    BASE,\\n\",\"    \\\"Experiment_20_Stage_2_Frozen_Dataset\\\"\\n\",\")\\n\",\"\\n\",\"PACKAGE_DIR = os.path.join(\\n\",\"    PACKAGE_ROOT,\\n\",\"    \\\"Experiment_20_Stage_2_Frozen_Dataset\\\"\\n\",\")\\n\",\"\\n\",\"PACKAGE_ZIP = os.path.join(\\n\",\"    BASE,\\n\",\"    \\\"Experiment_20_Stage_2_Frozen_Dataset.zip\\\"\\n\",\")\\n\",\"\\n\",\"PACKAGE_SHA_FILE = os.path.join(\\n\",\"    BASE,\\n\",\"    \\\"Experiment_20_Stage_2_Frozen_Dataset_SHA256.txt\\\"\\n\",\")\\n\",\"\\n\",\"FREEZE_MANIFEST = os.path.join(\\n\",\"    BASE,\\n\",\"    \\\"Experiment_20_Stage_2_Freeze_Manifest.json\\\"\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. REQUIRED INPUT VALIDATION\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"STEP 1 — REQUIRED INPUT VALIDATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"required_files = [\\n\",\"    SOURCE_ARCHIVE,\\n\",\"    EMBEDDING_ARCHIVE,\\n\",\"    EMBEDDING_METADATA,\\n\",\"    EMBEDDING_CONFIG,\\n\",\"    os.path.join(\\n\",\"        AUDIT_DIR,\\n\",\"        \\\"experiment20_full_dataset_image_integrity_audit.json\\\"\\n\",\"    ),\\n\",\"    os.path.join(\\n\",\"        AUDIT_DIR,\\n\",\"        \\\"experiment20_preprocessing_consistency_audit.json\\\"\\n\",\"    ),\\n\",\"    os.path.join(\\n\",\"        AUDIT_DIR,\\n\",\"        \\\"experiment20_embedding_quality_completeness_audit.json\\\"\\n\",\"    ),\\n\",\"    os.path.join(\\n\",\"        AUDIT_DIR,\\n\",\"        \\\"experiment20_corrected_illumination_condition_manifest.json\\\"\\n\",\"    ),\\n\",\"    os.path.join(\\n\",\"        AUDIT_DIR,\\n\",\"        \\\"experiment20_angular_hemisphere_audit.json\\\"\\n\",\"    )\\n\",\"]\\n\",\"\\n\",\"missing_required = [\\n\",\"    path for path in required_files\\n\",\"    if not os.path.isfile(path)\\n\",\"]\\n\",\"\\n\",\"for path in required_files:\\n\",\"    print(\\n\",\"        (\\\"FOUND: \\\" if os.path.isfile(path) else \\\"MISSING: \\\")\\n\",\"        + path\\n\",\"    )\\n\",\"\\n\",\"assert not missing_required, (\\n\",\"    \\\"Required package inputs are missing. \\\"\\n\",\"    \\\"Resolve them before freezing.\\\"\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. SHA256 FUNCTION\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"def sha256_file(path):\\n\",\"\\n\",\"    digest = hashlib.sha256()\\n\",\"\\n\",\"    with open(path, \\\"rb\\\") as f:\\n\",\"        for chunk in iter(\\n\",\"            lambda: f.read(1024 * 1024),\\n\",\"            b\\\"\\\"\\n\",\"        ):\\n\",\"            digest.update(chunk)\\n\",\"\\n\",\"    return digest.hexdigest()\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. VERIFY PREVIOUSLY RECORDED HASHES\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 2 — SOURCE AND EMBEDDING HASH VERIFICATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"expected_hashes = {\\n\",\"    SOURCE_ARCHIVE:\\n\",\"        \\\"8bbabf3836d077d60626c9ee3c54c2d2851a8d2c15c8b7e13b9bc162e86ea573\\\",\\n\",\"\\n\",\"    EMBEDDING_ARCHIVE:\\n\",\"        \\\"127ffb6e71b871ebab9ed10fd8ce5f2b78b9f3971db4075cf14b44f7df2d3c4c\\\",\\n\",\"\\n\",\"    EMBEDDING_METADATA:\\n\",\"        \\\"5efe5026210728e333ac5cd1fb0bcba093504e5214c0f72fbef931101a5d0888\\\"\\n\",\"}\\n\",\"\\n\",\"verified_hashes = {}\\n\",\"\\n\",\"for path, expected_hash in expected_hashes.items():\\n\",\"\\n\",\"    actual_hash = sha256_file(path)\\n\",\"\\n\",\"    verified_hashes[os.path.basename(path)] = actual_hash\\n\",\"\\n\",\"    print(os.path.basename(path))\\n\",\"    print(\\\"Expected:\\\", expected_hash)\\n\",\"    print(\\\"Actual:  \\\", actual_hash)\\n\",\"    print(\\\"Match:\\\", actual_hash == expected_hash)\\n\",\"\\n\",\"    assert actual_hash == expected_hash, (\\n\",\"        f\\\"Hash mismatch: {path}\\\"\\n\",\"    )\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. VALIDATE EMBEDDING AND AUDIT METADATA\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 3 — RESEARCH EVIDENCE VALIDATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"with open(\\n\",\"    EMBEDDING_METADATA,\\n\",\"    \\\"r\\\",\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\") as f:\\n\",\"    embedding_metadata = json.load(f)\\n\",\"\\n\",\"with open(\\n\",\"    os.path.join(\\n\",\"        AUDIT_DIR,\\n\",\"        \\\"experiment20_embedding_quality_completeness_audit.json\\\"\\n\",\"    ),\\n\",\"    \\\"r\\\",\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\") as f:\\n\",\"    embedding_audit = json.load(f)\\n\",\"\\n\",\"with open(\\n\",\"    os.path.join(\\n\",\"        AUDIT_DIR,\\n\",\"        \\\"experiment20_full_dataset_image_integrity_audit.json\\\"\\n\",\"    ),\\n\",\"    \\\"r\\\",\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\") as f:\\n\",\"    image_audit = json.load(f)\\n\",\"\\n\",\"with open(\\n\",\"    os.path.join(\\n\",\"        AUDIT_DIR,\\n\",\"        \\\"experiment20_preprocessing_consistency_audit.json\\\"\\n\",\"    ),\\n\",\"    \\\"r\\\",\\n\",\"    encoding=\\\"utf-8\\\"\\n\",\") as f:\\n\",\"    preprocessing_audit = json.load(f)\\n\",\"\\n\",\"assert embedding_audit[\\\"audit_status\\\"] == \\\"PASSED\\\"\\n\",\"assert image_audit[\\\"dataset_counts\\\"][\\\"standard_illumination_images\\\"] == 2414\\n\",\"assert preprocessing_audit[\\\"audit_status\\\"] == \\\"PASSED\\\"\\n\",\"\\n\",\"counts = embedding_metadata[\\\"counts\\\"]\\n\",\"\\n\",\"assert counts[\\\"successful_embeddings\\\"] == 2414\\n\",\"assert counts[\\\"extraction_failures\\\"] == 0\\n\",\"assert counts[\\\"unique_subjects\\\"] == 38\\n\",\"assert counts[\\\"unique_illumination_conditions\\\"] == 64\\n\",\"\\n\",\"print(\\\"Image integrity audit: PASSED\\\")\\n\",\"print(\\\"Preprocessing consistency audit: PASSED\\\")\\n\",\"print(\\\"Embedding completeness audit: PASSED\\\")\\n\",\"print(\\\"Successful embeddings:\\\", counts[\\\"successful_embeddings\\\"])\\n\",\"print(\\\"Extraction failures:\\\", counts[\\\"extraction_failures\\\"])\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. CREATE PACKAGE DIRECTORY\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 4 — PACKAGE ASSEMBLY\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"if os.path.exists(PACKAGE_ROOT):\\n\",\"    shutil.rmtree(PACKAGE_ROOT)\\n\",\"\\n\",\"os.makedirs(PACKAGE_DIR, exist_ok=True)\\n\",\"\\n\",\"folders = [\\n\",\"    \\\"source\\\",\\n\",\"    \\\"embeddings\\\",\\n\",\"    \\\"configuration\\\",\\n\",\"    \\\"audits\\\",\\n\",\"    \\\"provenance\\\"\\n\",\"]\\n\",\"\\n\",\"for folder in folders:\\n\",\"    os.makedirs(\\n\",\"   \\n\",\"\\n\",\"CELL INDEX: 80\\n\",\"MATCH CATEGORIES: checkpoint_operations\\n\",\"SOURCE CODE:\\n\",\"from pathlib import Path\\n\",\"import json\\n\",\"import numpy as np\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"\\n\",\"FILES = {\\n\",\"    \\\"embedding_metadata\\\": BASE / \\\"embeddings/experiment20_croppedyale_embedding_metadata.json\\\",\\n\",\"    \\\"generation_config\\\": BASE / \\\"embeddings/experiment20_embedding_generation_config.json\\\",\\n\",\"    \\\"preprocessing_compatibility\\\": BASE / \\\"dataset_audit/experiment20_facenet_preprocessing_compatibility_audit.json\\\",\\n\",\"    \\\"preprocessing_consistency\\\": BASE / \\\"dataset_audit/experiment20_preprocessing_consistency_audit.json\\\",\\n\",\"    \\\"checkpoint_metadata\\\": BASE / \\\"embeddings/checkpoints/experiment20_embedding_checkpoint_metadata.json\\\"\\n\",\"}\\n\",\"\\n\",\"NPZ_FILE = (\\n\",\"    BASE / \\\"embeddings/experiment20_croppedyale_facenet_embeddings.npz\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"=\\\" * 100)\\n\",\"print(\\\"EXPERIMENT 20 — ORIGINAL METADATA AND CONFIGURATION AUDIT\\\")\\n\",\"print(\\\"=\\\" * 100)\\n\",\"\\n\",\"documents = {}\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 1. Load available JSON documents\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"for name, path in FILES.items():\\n\",\"\\n\",\"    print(\\\"\\\\n\\\" + \\\"-\\\" * 100)\\n\",\"    print(f\\\"DOCUMENT: {name}\\\")\\n\",\"    print(f\\\"PATH: {path}\\\")\\n\",\"\\n\",\"    if not path.exists():\\n\",\"        print(\\\"STATUS: NOT FOUND\\\")\\n\",\"        continue\\n\",\"\\n\",\"    with path.open(\\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"        data = json.load(f)\\n\",\"\\n\",\"    documents[name] = data\\n\",\"\\n\",\"    print(\\\"STATUS: LOADED\\\")\\n\",\"    print(json.dumps(data, indent=2, ensure_ascii=False, default=str)[:18000])\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 2. Inspect NPZ archive metadata\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 100)\\n\",\"print(\\\"NPZ ARCHIVE CONSISTENCY\\\")\\n\",\"print(\\\"=\\\" * 100)\\n\",\"\\n\",\"with np.load(NPZ_FILE, allow_pickle=False) as archive:\\n\",\"\\n\",\"    required_arrays = [\\n\",\"        \\\"embeddings\\\",\\n\",\"        \\\"filenames\\\",\\n\",\"        \\\"subjects\\\",\\n\",\"        \\\"subject_numbers\\\",\\n\",\"        \\\"azimuths\\\",\\n\",\"        \\\"elevations\\\",\\n\",\"        \\\"conditions\\\"\\n\",\"    ]\\n\",\"\\n\",\"    missing_arrays = [\\n\",\"        key for key in required_arrays\\n\",\"        if key not in archive.files\\n\",\"    ]\\n\",\"\\n\",\"    if missing_arrays:\\n\",\"        raise ValueError(f\\\"Missing NPZ arrays: {missing_arrays}\\\")\\n\",\"\\n\",\"    embeddings = archive[\\\"embeddings\\\"]\\n\",\"    filenames = archive[\\\"filenames\\\"]\\n\",\"    subjects = archive[\\\"subjects\\\"]\\n\",\"    conditions = archive[\\\"conditions\\\"]\\n\",\"    azimuths = archive[\\\"azimuths\\\"]\\n\",\"    elevations = archive[\\\"elevations\\\"]\\n\",\"\\n\",\"    print(f\\\"Embedding shape: {embeddings.shape}\\\")\\n\",\"    print(f\\\"Filename count: {len(filenames)}\\\")\\n\",\"    print(f\\\"Subject count: {len(subjects)}\\\")\\n\",\"    print(f\\\"Unique subjects: {len(np.unique(subjects))}\\\")\\n\",\"    print(f\\\"Condition count: {len(conditions)}\\\")\\n\",\"    print(f\\\"Unique conditions: {len(np.unique(conditions))}\\\")\\n\",\"\\n\",\"    aligned = all(\\n\",\"        len(array) == len(embeddings)\\n\",\"        for array in [\\n\",\"            filenames,\\n\",\"            subjects,\\n\",\"            conditions,\\n\",\"            azimuths,\\n\",\"            elevations\\n\",\"        ]\\n\",\"    )\\n\",\"\\n\",\"    print(f\\\"All metadata arrays align with embeddings: {aligned}\\\")\\n\",\"\\n\",\"    print(\\\"\\\\nFirst five records:\\\")\\n\",\"\\n\",\"    for i in range(5):\\n\",\"        print({\\n\",\"            \\\"filename\\\": str(filenames[i]),\\n\",\"            \\\"subject\\\": str(subjects[i]),\\n\",\"            \\\"condition\\\": str(conditions[i]),\\n\",\"            \\\"azimuth\\\": int(azimuths[i]),\\n\",\"            \\\"elevation\\\": int(elevations[i])\\n\",\"        })\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# 3. Summarize available evidence\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 100)\\n\",\"print(\\\"EVIDENCE AVAILABILITY\\\")\\n\",\"print(\\\"=\\\" * 100)\\n\",\"\\n\",\"for name in FILES:\\n\",\"    print(\\n\",\"        f\\\"{name}: \\\"\\n\",\"        f\\\"{'AVAILABLE' if name in documents else 'UNAVAILABLE'}\\\"\\n\",\"    )\\n\",\"\\n\",\"print(\\\"\\\\nNo files were created, modified, or overwritten.\\\")\\n\",\"print(\\\"No embeddings were regenerated.\\\")\\n\",\"print(\\\"END OF STEP 3.1.4 METADATA AUDIT\\\")\\n\",\"print(\\\"=\\\" * 100)\\n\",\"\\n\",\"CELL INDEX: 89\\n\",\"MATCH CATEGORIES: model_initialization\\n\",\"SOURCE CODE:\\n\",\"from pathlib import Path\\n\",\"from datetime import datetime, timezone\\n\",\"import json\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"OUTPUT_DIR = BASE / \\\"step_3_1\\\"\\n\",\"OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"OUTPUT_FILE = (\\n\",\"    OUTPUT_DIR /\\n\",\"    \\\"experiment20_step316_methodological_risk_register.json\\\"\\n\",\")\\n\",\"\\n\",\"risks = [\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"M01\\\",\\n\",\"        \\\"area\\\": \\\"Dataset provenance\\\",\\n\",\"        \\\"finding\\\": \\\"The actual acquisition listing matches the acquired CroppedYale.zip record.\\\",\\n\",\"        \\\"evidence\\\": [\\n\",\"            \\\"Step 3.1.5.2 supplementary acquisition-source reconciliation audit\\\",\\n\",\"            \\\"Matching acquisition info-hash and archive size\\\",\\n\",\"            \\\"Matching source archive SHA256\\\"\\n\",\"        ],\\n\",\"        \\\"classification\\\": \\\"verified_with_limitation\\\",\\n\",\"        \\\"limitation\\\": \\\"Official Yale checksum authentication and independent torrent-piece verification were not performed.\\\",\\n\",\"        \\\"manuscript_action\\\": \\\"Describe the community-hosted Academic Torrents acquisition and disclose the provenance limitation.\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"M02\\\",\\n\",\"        \\\"area\\\": \\\"Dataset scope\\\",\\n\",\"        \\\"finding\\\": \\\"The acquired dataset is the cropped frontal-pose subset, not the complete multi-pose Extended Yale B dataset.\\\",\\n\",\"        \\\"evidence\\\": [\\n\",\"            \\\"Frozen dataset README\\\",\\n\",\"            \\\"Dataset acquisition and cohort audits\\\",\\n\",\"            \\\"38 identities and P00 pose\\\"\\n\",\"        ],\\n\",\"        \\\"classification\\\": \\\"verified_scope_limitation\\\",\\n\",\"        \\\"limitation\\\": \\\"The findings cannot be generalized to all poses or the complete Extended Yale B dataset.\\\",\\n\",\"        \\\"manuscript_action\\\": \\\"Use the precise cropped frontal-pose subset description throughout.\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"M03\\\",\\n\",\"        \\\"area\\\": \\\"Repeated observations\\\",\\n\",\"        \\\"finding\\\": \\\"Evaluation observations are identity-condition matched captures under different illumination conditions.\\\",\\n\",\"        \\\"evidence\\\": [\\n\",\"            \\\"Common illumination condition manifest\\\",\\n\",\"            \\\"38 identities\\\",\\n\",\"            \\\"57 common conditions\\\",\\n\",\"            \\\"2,166 common-condition observations\\\"\\n\",\"        ],\\n\",\"        \\\"classification\\\": \\\"verified_design_limitation\\\",\\n\",\"        \\\"limitation\\\": \\\"Different captures are not exact source-image perturbations.\\\",\\n\",\"        \\\"manuscript_action\\\": \\\"Avoid describing the observations as exact image-level pairs.\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"M04\\\",\\n\",\"        \\\"area\\\": \\\"Preprocessing reproducibility\\\",\\n\",\"        \\\"finding\\\": \\\"Images were converted from grayscale to RGB, resized to 160x160, and converted using ToTensor.\\\",\\n\",\"        \\\"evidence\\\": [\\n\",\"            \\\"Freeze manifest\\\",\\n\",\"            \\\"Embedding generation configuration\\\",\\n\",\"            \\\"Preprocessing consistency audit\\\"\\n\",\"        ],\\n\",\"        \\\"classification\\\": \\\"partially_documented\\\",\\n\",\"        \\\"limitation\\\": \\\"Resize interpolation and some software/model execution details remain insufficiently documented.\\\",\\n\",\"        \\\"manuscript_action\\\": \\\"Recover these details from the original execution environment if possible; otherwise disclose them as unavailable.\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"M05\\\",\\n\",\"        \\\"area\\\": \\\"Model validation\\\",\\n\",\"        \\\"finding\\\": \\\"The same pretrained VGGFace2 InceptionResnetV1 FaceNet backbone was used.\\\",\\n\",\"        \\\"evidence\\\": [\\n\",\"            \\\"Freeze manifest\\\",\\n\",\"            \\\"Embedding metadata\\\",\\n\",\"            \\\"Model configuration\\\"\\n\",\"        ],\\n\",\"        \\\"classification\\\": \\\"verified_design_limitation\\\",\\n\",\"        \\\"limitation\\\": \\\"The external dataset does not constitute independent model validation.\\\",\\n\",\"        \\\"manuscript_action\\\": \\\"Describe this as external dataset evaluation using the same pretrained model.\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"M06\\\",\\n\",\"        \\\"area\\\": \\\"Statistical inference\\\",\\n\",\"        \\\"finding\\\": \\\"Repeated-measures Friedman and Wilcoxon analyses were reproduced.\\\",\\n\",\"        \\\"evidence\\\": [\\n\",\"            \\\"Step 3.1.3 independent statistical reproduction\\\",\\n\",\"            \\\"38 identities\\\",\\n\",\"            \\\"All six pairwise comparisons reproduced\\\"\\n\",\"        ],\\n\",\"        \\\"classification\\\": \\\"reproduced_with_reporting_decision\\\",\\n\",\"        \\\"limitation\\\": \\\"Holm correction was applied separately to the three comparisons for each metric; the protocol does not explicitly define the correction family.\\\",\\n\",\"        \\\"manuscript_action\\\": \\\"Justify the two metric-wise families or recompute using one six-comparison family. Do not silently change the correction.\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"M07\\\",\\n\",\"        \\\"area\\\": \\\"Descriptive analysis\\\",\\n\",\"        \\\"finding\\\": \\\"Euclidean displacement and cosine distance quantify embedding changes relative to the reference condition.\\\",\\n\",\"        \\\"evidence\\\": [\\n\",\"            \\\"Frozen descriptive analysis protocol\\\",\\n\",\"            \\\"Step 2.7.2 displacement analysis\\\",\\n\",\"            \\\"Step 2.7.3 group statistics\\\"\\n\",\"        ],\\n\",\"        \\\"classification\\\": \\\"verified_scope_limitation\\\",\\n\",\"        \\\"limitation\\\": \\\"These metrics do not establish identity recognition accuracy, detector accuracy, or operational robustness.\\\",\\n\",\"        \\\"manuscript_action\\\": \\\"Interpret results as embedding displacement only.\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"M08\\\",\\n\",\"        \\\"area\\\": \\\"Detector calibration\\\",\\n\",\"        \\\"finding\\\": \\\"The selected analysis is descriptive and does not use calibrated detection thresholds.\\\",\\n\",\"        \\\"evidence\\\": [\\n\",\"            \\\"Step 2.7.1 protocol\\\",\\n\",\"            \\\"No threshold calibration\\\",\\n\",\"            \\\"No false-alarm evaluation\\\"\\n\",\"        ],\\n\",\"        \\\"classification\\\": \\\"verified_scope_limitation\\\",\\n\",\"        \\\"limitation\\\": \\\"No operational false-alarm control or real-time detection performance can be claimed.\\\",\\n\",\"        \\\"manuscript_action\\\": \\\"Do not present this experiment as a validated real-time drift detector.\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"M09\\\",\\n\",\"        \\\"area\\\": \\\"Lighting geometry\\\",\\n\",\"        \\\"finding\\\": \\\"Illumination groups represent angular deviation of light direction.\\\",\\n\",\"        \\\"evidence\\\": [\\n\",\"            \\\"Lighting geometry grouping audit\\\",\\n\",\"            \\\"Near-frontal, oblique, and large-angular groups\\\"\\n\",\"        ],\\n\",\"        \\\"classification\\\": \\\"verified_interpretation_constraint\\\",\\n\",\"        \\\"limitation\\\": \\\"The groups do not directly measure illumination intensity.\\\",\\n\",\"        \\\"manuscript_action\\\": \\\"Use light-direct\\n\",\"\\n\",\"CELL INDEX: 91\\n\",\"MATCH CATEGORIES: model_initialization, checkpoint_operations\\n\",\"SOURCE CODE:\\n\",\"from pathlib import Path\\n\",\"from datetime import datetime, timezone\\n\",\"import json\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"OUTPUT_DIR = BASE / \\\"step_3_1\\\"\\n\",\"OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"OUTPUT_FILE = (\\n\",\"    OUTPUT_DIR /\\n\",\"    \\\"experiment20_step317_unresolved_decisions.json\\\"\\n\",\")\\n\",\"\\n\",\"decisions = [\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"D01\\\",\\n\",\"        \\\"decision\\\": \\\"Multiple-comparison correction family\\\",\\n\",\"        \\\"current_status\\\": \\\"UNRESOLVED\\\",\\n\",\"        \\\"current_analysis\\\": \\\"Holm correction applied separately to three pairwise comparisons for each metric.\\\",\\n\",\"        \\\"required_action\\\": \\\"Justify the two metric-wise outcome families or recalculate using one six-comparison family.\\\",\\n\",\"        \\\"blocks_manuscript_submission\\\": True\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"D02\\\",\\n\",\"        \\\"decision\\\": \\\"Resize interpolation method\\\",\\n\",\"        \\\"current_status\\\": \\\"NOT_FULLY_DOCUMENTED\\\",\\n\",\"        \\\"current_analysis\\\": \\\"Images resized to 160x160; interpolation method not established in the reviewed records.\\\",\\n\",\"        \\\"required_action\\\": \\\"Recover the interpolation method from the original execution environment if possible; otherwise disclose it as unavailable.\\\",\\n\",\"        \\\"blocks_manuscript_submission\\\": True\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"D03\\\",\\n\",\"        \\\"decision\\\": \\\"Exact model checkpoint and software versions\\\",\\n\",\"        \\\"current_status\\\": \\\"PARTIALLY_DOCUMENTED\\\",\\n\",\"        \\\"current_analysis\\\": \\\"InceptionResnetV1 pretrained on VGGFace2 is documented; complete checkpoint identity and environment versions remain insufficiently established.\\\",\\n\",\"        \\\"required_action\\\": \\\"Recover checkpoint identity and relevant package versions where possible; disclose unrecoverable details.\\\",\\n\",\"        \\\"blocks_manuscript_submission\\\": True\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"D04\\\",\\n\",\"        \\\"decision\\\": \\\"Official dataset authenticity\\\",\\n\",\"        \\\"current_status\\\": \\\"KNOWN_LIMITATION\\\",\\n\",\"        \\\"current_analysis\\\": \\\"Acquisition listing and archive hash match, but no independent official Yale checksum authentication was performed.\\\",\\n\",\"        \\\"required_action\\\": \\\"Disclose the community-hosted source and absence of official checksum authentication.\\\",\\n\",\"        \\\"blocks_manuscript_submission\\\": False\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"D05\\\",\\n\",\"        \\\"decision\\\": \\\"Dataset scope terminology\\\",\\n\",\"        \\\"current_status\\\": \\\"RESOLVED\\\",\\n\",\"        \\\"current_analysis\\\": \\\"The acquired data represent a cropped frontal-pose subset, not the complete multi-pose Extended Yale B dataset.\\\",\\n\",\"        \\\"required_action\\\": \\\"Use the precise dataset scope consistently throughout the manuscript.\\\",\\n\",\"        \\\"blocks_manuscript_submission\\\": False\\n\",\"    }\\n\",\"]\\n\",\"\\n\",\"register = {\\n\",\"    \\\"experiment\\\": 20,\\n\",\"    \\\"step\\\": \\\"3.1.7\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"decision_count\\\": len(decisions),\\n\",\"    \\\"decisions\\\": decisions,\\n\",\"    \\\"submission_blocking_count\\\": sum(\\n\",\"        d[\\\"blocks_manuscript_submission\\\"] for d in decisions\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"with OUTPUT_FILE.open(\\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    json.dump(register, f, indent=2, ensure_ascii=False)\\n\",\"\\n\",\"with OUTPUT_FILE.open(\\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    verified = json.load(f)\\n\",\"\\n\",\"assert len(verified[\\\"decisions\\\"]) == 5\\n\",\"assert len({d[\\\"id\\\"] for d in verified[\\\"decisions\\\"]}) == 5\\n\",\"assert verified[\\\"submission_blocking_count\\\"] == 3\\n\",\"\\n\",\"print(\\\"=\\\" * 100)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.1.7\\\")\\n\",\"print(\\\"FINAL UNRESOLVED-DECISION REGISTER\\\")\\n\",\"print(\\\"=\\\" * 100)\\n\",\"\\n\",\"for item in verified[\\\"decisions\\\"]:\\n\",\"    print(f\\\"\\\\n{item['id']} — {item['decision']}\\\")\\n\",\"    print(\\\"Status:\\\", item[\\\"current_status\\\"])\\n\",\"    print(\\\"Blocks submission:\\\", item[\\\"blocks_manuscript_submission\\\"])\\n\",\"    print(\\\"Required action:\\\", item[\\\"required_action\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nTotal decisions:\\\", verified[\\\"decision_count\\\"])\\n\",\"print(\\\"Submission-blocking decisions:\\\", verified[\\\"submission_blocking_count\\\"])\\n\",\"print(\\\"JSON reload: PASS\\\")\\n\",\"print(\\\"Saved:\\\", OUTPUT_FILE)\\n\",\"print(\\\"=\\\" * 100)\\n\",\"\\n\",\"CELL INDEX: 93\\n\",\"MATCH CATEGORIES: checkpoint_operations, software_versions\\n\",\"SOURCE CODE:\\n\",\"from pathlib import Path\\n\",\"import json\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"\\n\",\"FILES = {\\n\",\"    \\\"generation_config\\\": (\\n\",\"        BASE / \\\"embeddings\\\" /\\n\",\"        \\\"experiment20_embedding_generation_config.json\\\"\\n\",\"    ),\\n\",\"    \\\"checkpoint_metadata\\\": (\\n\",\"        BASE / \\\"embeddings\\\" / \\\"checkpoints\\\" /\\n\",\"        \\\"experiment20_embedding_checkpoint_metadata.json\\\"\\n\",\"    ),\\n\",\"    \\\"preprocessing_audit\\\": (\\n\",\"        BASE / \\\"dataset_audit\\\" /\\n\",\"        \\\"experiment20_preprocessing_consistency_audit.json\\\"\\n\",\"    ),\\n\",\"    \\\"compatibility_audit\\\": (\\n\",\"        BASE / \\\"dataset_audit\\\" /\\n\",\"        \\\"experiment20_facenet_preprocessing_compatibility_audit.json\\\"\\n\",\"    ),\\n\",\"    \\\"freeze_manifest\\\": (\\n\",\"        BASE / \\\"Experiment_20_Stage_2_Freeze_Manifest.json\\\"\\n\",\"    ),\\n\",\"    \\\"embedding_metadata\\\": (\\n\",\"        BASE / \\\"embeddings\\\" /\\n\",\"        \\\"experiment20_croppedyale_embedding_metadata.json\\\"\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"print(\\\"=\\\" * 100)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.1.8\\\")\\n\",\"print(\\\"PREPROCESSING AND MODEL METADATA RECOVERY\\\")\\n\",\"print(\\\"=\\\" * 100)\\n\",\"\\n\",\"loaded = {}\\n\",\"\\n\",\"for name, path in FILES.items():\\n\",\"    print(f\\\"\\\\n{'=' * 80}\\\")\\n\",\"    print(\\\"SOURCE:\\\", name)\\n\",\"    print(\\\"PATH:\\\", path)\\n\",\"\\n\",\"    if not path.exists():\\n\",\"        print(\\\"STATUS: FILE NOT FOUND\\\")\\n\",\"        continue\\n\",\"\\n\",\"    try:\\n\",\"        with path.open(\\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"            data = json.load(f)\\n\",\"\\n\",\"        loaded[name] = data\\n\",\"\\n\",\"        print(\\\"STATUS: LOADED\\\")\\n\",\"        print(\\\"TOP-LEVEL TYPE:\\\", type(data).__name__)\\n\",\"\\n\",\"        if isinstance(data, dict):\\n\",\"            print(\\\"TOP-LEVEL KEYS:\\\", list(data.keys()))\\n\",\"\\n\",\"            print(\\\"\\\\nFULL JSON CONTENT:\\\")\\n\",\"            print(json.dumps(data, indent=2, ensure_ascii=False))\\n\",\"\\n\",\"        elif isinstance(data, list):\\n\",\"            print(\\\"ITEM COUNT:\\\", len(data))\\n\",\"            print(json.dumps(data[:5], indent=2, ensure_ascii=False))\\n\",\"\\n\",\"    except Exception as exc:\\n\",\"        print(\\\"READ ERROR:\\\", repr(exc))\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# Runtime versions: current environment only.\\n\",\"# These do not establish historical generation versions.\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 100)\\n\",\"print(\\\"CURRENT COLAB RUNTIME VERSIONS\\\")\\n\",\"print(\\\"=\\\" * 100)\\n\",\"\\n\",\"import sys\\n\",\"import platform\\n\",\"import importlib.metadata as metadata\\n\",\"\\n\",\"print(\\\"Python:\\\", sys.version)\\n\",\"print(\\\"Platform:\\\", platform.platform())\\n\",\"\\n\",\"for package in [\\n\",\"    \\\"torch\\\",\\n\",\"    \\\"torchvision\\\",\\n\",\"    \\\"facenet-pytorch\\\",\\n\",\"    \\\"numpy\\\",\\n\",\"    \\\"Pillow\\\"\\n\",\"]:\\n\",\"    try:\\n\",\"        print(f\\\"{package}: {metadata.version(package)}\\\")\\n\",\"    except metadata.PackageNotFoundError:\\n\",\"        print(f\\\"{package}: NOT INSTALLED\\\")\\n\",\"\\n\",\"print(\\\"\\\\nIMPORTANT:\\\")\\n\",\"print(\\\"Current runtime versions are not proof of historical embedding-generation versions.\\\")\\n\",\"print(\\\"No experiment files were modified.\\\")\\n\",\"print(\\\"=\\\" * 100)\\n\",\"\\n\",\"----------------------------------------------------------------------------------------------------\\n\",\"NOTEBOOK: /content/drive/MyDrive/Colab Notebooks/Experiment_13_Final_Reproducibility_Audit.ipynb\\n\",\"MATCHING CODE CELLS: 9\\n\",\"\\n\",\"CELL INDEX: 1\\n\",\"MATCH CATEGORIES: software_versions\\n\",\"SOURCE CODE:\\n\",\"# Experiment 13: Environment setup\\n\",\"\\n\",\"import sys\\n\",\"import platform\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"import matplotlib.pyplot as plt\\n\",\"\\n\",\"SEED = 202613\\n\",\"np.random.seed(SEED)\\n\",\"\\n\",\"print(\\\"Python version:\\\", sys.version)\\n\",\"print(\\\"Platform:\\\", platform.platform())\\n\",\"print(\\\"NumPy version:\\\", np.__version__)\\n\",\"print(\\\"Pandas version:\\\", pd.__version__)\\n\",\"print(\\\"Random seed:\\\", SEED)\\n\",\"\\n\",\"CELL INDEX: 57\\n\",\"MATCH CATEGORIES: software_versions\\n\",\"SOURCE CODE:\\n\",\"!pip install keras-facenet\\n\",\"\\n\",\"import inspect\\n\",\"from keras_facenet import FaceNet\\n\",\"\\n\",\"embedder = FaceNet()\\n\",\"\\n\",\"print(\\\"=\\\" * 85)\\n\",\"print(\\\"EXPERIMENT 13 — FACENET INTERNAL PREPROCESSING AUDIT\\\")\\n\",\"print(\\\"=\\\" * 85)\\n\",\"\\n\",\"methods = [\\\"embeddings\\\", \\\"extract\\\"]\\n\",\"\\n\",\"for method_name in methods:\\n\",\"    print(f\\\"\\\\n{'-' * 85}\\\")\\n\",\"    print(\\\"METHOD:\\\", method_name)\\n\",\"    print(\\\"-\\\" * 85)\\n\",\"\\n\",\"    method = getattr(embedder, method_name, None)\\n\",\"\\n\",\"    if method is None:\\n\",\"        print(\\\"Method not available\\\")\\n\",\"        continue\\n\",\"\\n\",\"    try:\\n\",\"        print(inspect.getsource(method))\\n\",\"    except (OSError, TypeError) as exc:\\n\",\"        print(\\\"Source unavailable:\\\", exc)\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 85)\\n\",\"print(\\\"PACKAGE VERSION\\\")\\n\",\"print(\\\"=\\\" * 85)\\n\",\"\\n\",\"import importlib.metadata\\n\",\"\\n\",\"print(\\\"keras-facenet:\\\", importlib.metadata.version(\\\"keras-facenet\\\"))\\n\",\"\\n\",\"print(\\\"\\\\nAUDIT COMPLETE — NO EXPERIMENT FILES MODIFIED\\\")\\n\",\"\\n\",\"CELL INDEX: 61\\n\",\"MATCH CATEGORIES: resize\\n\",\"SOURCE CODE:\\n\",\"from pathlib import Path\\n\",\"\\n\",\"repo = Path(\\\"/content/Real-Time-Embedding-Level-Drift-Detection\\\")\\n\",\"config_file = repo / \\\"results/Experiment_13_FaceNet_Model_Configuration.txt\\\"\\n\",\"\\n\",\"marker = \\\"## Verified image preprocessing\\\"\\n\",\"\\n\",\"if not config_file.exists():\\n\",\"    raise FileNotFoundError(config_file)\\n\",\"\\n\",\"existing = config_file.read_text(encoding=\\\"utf-8\\\")\\n\",\"\\n\",\"if marker in existing:\\n\",\"    print(\\\"Preprocessing section already exists. No changes made.\\\")\\n\",\"else:\\n\",\"    section = \\\"\\\"\\\"\\n\",\"\\n\",\"## Verified image preprocessing\\n\",\"\\n\",\"Implementation verified from the installed keras-facenet==0.3.2 package.\\n\",\"\\n\",\"- Verification date: 2026-11-04\\n\",\"- Embedding method: FaceNet.embeddings()\\n\",\"- Image resizing: OpenCV cv2.resize()\\n\",\"- Target image dimensions: 160 x 160 pixels\\n\",\"- Input channels: 3\\n\",\"- Normalization mode: fixed_image_standardization=True\\n\",\"- Input conversion: NumPy float32\\n\",\"- Model inference: model.predict()\\n\",\"- Embedding output dimension: 512\\n\",\"\\n\",\"### Exact normalization formula\\n\",\"\\n\",\"The package implements:\\n\",\"\\n\",\"    (np.float32(image) - 127.5) / 127.5\\n\",\"\\n\",\"This maps the original 0-255 pixel intensity range to approximately\\n\",\"-1 to +1.\\n\",\"\\n\",\"### Verified embedding pipeline\\n\",\"\\n\",\"1. Each input image is resized to 160 x 160 using cv2.resize().\\n\",\"2. Fixed image standardization is applied.\\n\",\"3. The normalized image batch is converted to float32.\\n\",\"4. The batch is passed to the FaceNet model using model.predict().\\n\",\"5. The model returns 512-dimensional embeddings.\\n\",\"\\n\",\"### Face detection and alignment scope\\n\",\"\\n\",\"The experiment uses FaceNet.embeddings(), not FaceNet.extract().\\n\",\"The extract() method invokes the package's face extraction pathway,\\n\",\"but that pathway is not used by this experiment's embedding call.\\n\",\"Therefore, MTCNN face detection and cropping are not part of the\\n\",\"verified embedding-generation pathway.\\n\",\"\\n\",\"### Model metadata verification\\n\",\"\\n\",\"- Model metadata image_size: 160\\n\",\"- Model metadata dimensions: 512\\n\",\"- fixed_image_standardization: True\\n\",\"- Model input shape: (None, None, None, 3)\\n\",\"- Model output shape: (None, 512)\\n\",\"- Model parameters: 23,497,424\\n\",\"- Pretrained weights SHA-256:\\n\",\"  8b71e7045497e841c00ee568f031d1a4d30908fceadf6884aef2dec4d545202b\\n\",\"\\n\",\"The model input shape is dynamically declared. The 160 x 160\\n\",\"input dimensions are enforced by the package's embeddings()\\n\",\"preprocessing implementation before model inference.\\n\",\"\\n\",\"This verification documents the installed package implementation\\n\",\"and runtime configuration. It does not, by itself, establish a\\n\",\"fresh-runtime end-to-end reproduction of the complete experiment.\\n\",\"\\\"\\\"\\\"\\n\",\"\\n\",\"    with config_file.open(\\\"a\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"        f.write(section)\\n\",\"\\n\",\"    print(\\\"Preprocessing verification appended successfully.\\\")\\n\",\"\\n\",\"print(\\\"\\\\nUPDATED FILE:\\\")\\n\",\"print(config_file.relative_to(repo))\\n\",\"print(\\\"\\\\nNEW SECTION:\\\")\\n\",\"updated = config_file.read_text(encoding=\\\"utf-8\\\")\\n\",\"print(updated[updated.index(marker):])\\n\",\"\\n\",\"CELL INDEX: 88\\n\",\"MATCH CATEGORIES: software_versions\\n\",\"SOURCE CODE:\\n\",\"import hashlib\\n\",\"import importlib.metadata\\n\",\"from pathlib import Path\\n\",\"\\n\",\"expected_sha256 = (\\n\",\"    \\\"8b71e7045497e841c00ee568f031d1a4\\\"\\n\",\"    \\\"d30908fceadf6884aef2dec4d545202b\\\"\\n\",\")\\n\",\"\\n\",\"weights_path = Path(\\n\",\"    \\\"/root/.keras-facenet/20180402-114759/\\\"\\n\",\"    \\\"20180402-114759-weights.h5\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"FACENET MODEL VERIFICATION\\\")\\n\",\"print(\\\"=\\\" * 70)\\n\",\"\\n\",\"try:\\n\",\"    print(\\\"keras-facenet version:\\\",\\n\",\"          importlib.metadata.version(\\\"keras-facenet\\\"))\\n\",\"except Exception as exc:\\n\",\"    print(\\\"Package version unavailable:\\\", exc)\\n\",\"\\n\",\"print(\\\"\\\\nWeights file exists:\\\", weights_path.is_file())\\n\",\"\\n\",\"if weights_path.is_file():\\n\",\"    print(\\\"Weights size:\\\", weights_path.stat().st_size, \\\"bytes\\\")\\n\",\"\\n\",\"    digest = hashlib.sha256()\\n\",\"    with weights_path.open(\\\"rb\\\") as f:\\n\",\"        for chunk in iter(lambda: f.read(1024 * 1024), b\\\"\\\"):\\n\",\"            digest.update(chunk)\\n\",\"\\n\",\"    actual_sha256 = digest.hexdigest()\\n\",\"\\n\",\"    print(\\\"Actual SHA-256:\\\", actual_sha256)\\n\",\"    print(\\\"Expected SHA-256:\\\", expected_sha256)\\n\",\"    print(\\\"Checksum matches:\\\", actual_sha256 == expected_sha256)\\n\",\"else:\\n\",\"    print(\\\"Original weights file not found.\\\")\\n\",\"\\n\",\"print(\\\"\\\\nMODEL VERIFICATION COMPLETE — NO FILE MODIFICATION\\\")\\n\",\"\\n\",\"CELL INDEX: 92\\n\",\"MATCH CATEGORIES: software_versions\\n\",\"SOURCE CODE:\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"import sklearn\\n\",\"from pathlib import Path\\n\",\"from sklearn.model_selection import train_test_split\\n\",\"\\n\",\"# --------------------------------------------------\\n\",\"# CONFIGURATION\\n\",\"# --------------------------------------------------\\n\",\"\\n\",\"out = Path(\\\"/content/experiment13_lfw_regenerated\\\")\\n\",\"\\n\",\"metadata_path = out / \\\"lfw_embedding_metadata.csv\\\"\\n\",\"split_path = out / \\\"lfw_identity_split_indices.npz\\\"\\n\",\"\\n\",\"if split_path.exists():\\n\",\"    raise FileExistsError(\\n\",\"        f\\\"{split_path} already exists. Nothing overwritten.\\\"\\n\",\"    )\\n\",\"\\n\",\"metadata = pd.read_csv(metadata_path)\\n\",\"\\n\",\"assert len(metadata) == 13233\\n\",\"assert metadata[\\\"identity\\\"].notna().all()\\n\",\"\\n\",\"# --------------------------------------------------\\n\",\"# REPRODUCE ORIGINAL IDENTITY SPLIT\\n\",\"# --------------------------------------------------\\n\",\"\\n\",\"print(\\\"ARTIFACT 3 — IDENTITY-DISJOINT SPLIT\\\")\\n\",\"print(\\\"=\\\" * 65)\\n\",\"\\n\",\"identities = metadata[\\\"identity\\\"].unique()\\n\",\"\\n\",\"reference_ids, evaluation_ids = train_test_split(\\n\",\"    identities,\\n\",\"    test_size=0.30,\\n\",\"    random_state=202613\\n\",\")\\n\",\"\\n\",\"reference_mask = metadata[\\\"identity\\\"].isin(\\n\",\"    reference_ids\\n\",\").to_numpy()\\n\",\"\\n\",\"evaluation_mask = metadata[\\\"identity\\\"].isin(\\n\",\"    evaluation_ids\\n\",\").to_numpy()\\n\",\"\\n\",\"reference_indices = np.flatnonzero(reference_mask)\\n\",\"evaluation_indices = np.flatnonzero(evaluation_mask)\\n\",\"\\n\",\"reference_identity_set = set(reference_ids)\\n\",\"evaluation_identity_set = set(evaluation_ids)\\n\",\"\\n\",\"# --------------------------------------------------\\n\",\"# VALIDATION\\n\",\"# --------------------------------------------------\\n\",\"\\n\",\"assert reference_identity_set.isdisjoint(evaluation_identity_set)\\n\",\"assert len(reference_indices) + len(evaluation_indices) == len(metadata)\\n\",\"assert len(np.intersect1d(reference_indices, evaluation_indices)) == 0\\n\",\"\\n\",\"# --------------------------------------------------\\n\",\"# SAVE\\n\",\"# --------------------------------------------------\\n\",\"\\n\",\"np.savez(\\n\",\"    split_path,\\n\",\"    reference_indices=reference_indices,\\n\",\"    evaluation_indices=evaluation_indices\\n\",\")\\n\",\"\\n\",\"# --------------------------------------------------\\n\",\"# REPORT\\n\",\"# --------------------------------------------------\\n\",\"\\n\",\"print(\\\"scikit-learn version:\\\", sklearn.__version__)\\n\",\"print(\\\"Total images:\\\", len(metadata))\\n\",\"print(\\\"Total identities:\\\", len(identities))\\n\",\"\\n\",\"print(\\\"\\\\nReference identities:\\\", len(reference_identity_set))\\n\",\"print(\\\"Evaluation identities:\\\", len(evaluation_identity_set))\\n\",\"\\n\",\"print(\\\"Reference images:\\\", len(reference_indices))\\n\",\"print(\\\"Evaluation images:\\\", len(evaluation_indices))\\n\",\"\\n\",\"print(\\\"Identity overlap:\\\",\\n\",\"      len(reference_identity_set & evaluation_identity_set))\\n\",\"\\n\",\"print(\\\"Image index overlap:\\\",\\n\",\"      len(np.intersect1d(reference_indices, evaluation_indices)))\\n\",\"\\n\",\"print(\\\"\\\\nSaved:\\\", split_path)\\n\",\"print(\\\"Identity-disjoint check: PASSED\\\")\\n\",\"print(\\\"STATUS: REGENERATED — ORIGINAL SPLIT LOGIC\\\")\\n\",\"\\n\",\"CELL INDEX: 109\\n\",\"MATCH CATEGORIES: model_initialization\\n\",\"SOURCE CODE:\\n\",\"from pathlib import Path\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"out = Path(\\\"/content/experiment13_lfw_regenerated\\\")\\n\",\"notes_path = out / \\\"EXPERIMENT13_RECOVERY_NOTES.txt\\\"\\n\",\"\\n\",\"if notes_path.exists():\\n\",\"    raise FileExistsError(\\n\",\"        f\\\"Will not overwrite existing notes: {notes_path}\\\"\\n\",\"    )\\n\",\"\\n\",\"notes = \\\"\\\"\\\"\\n\",\"EXPERIMENT 13 — ARTIFACT REGENERATION AND PROVENANCE NOTES\\n\",\"==========================================================\\n\",\"\\n\",\"1. PURPOSE\\n\",\"----------\\n\",\"This document records the regeneration of ten missing raw artifacts\\n\",\"from Experiment 13: Final Reproducibility Audit.\\n\",\"\\n\",\"The artifacts were regenerated because the original output files\\n\",\"were unavailable.\\n\",\"\\n\",\"These files are regenerated outputs, not recovered copies of\\n\",\"the original files.\\n\",\"\\n\",\"\\n\",\"2. SOURCE DATA AND MODEL\\n\",\"------------------------\\n\",\"Dataset: Labeled Faces in the Wild (LFW)\\n\",\"Source archive: lfw_original_source.tgz\\n\",\"\\n\",\"Archive SHA-256:\\n\",\"055f7d9c632d7370e6fb4afc7468d40f970c34a80d4c6f50ffec63f5a8d536c0\\n\",\"\\n\",\"Extracted images: 13,233\\n\",\"Identity folders: 5,749\\n\",\"\\n\",\"Embedding model: FaceNet (InceptionResNetV1)\\n\",\"Embedding dimension: 512\\n\",\"\\n\",\"Package: keras-facenet==0.3.2\\n\",\"\\n\",\"FaceNet weights SHA-256:\\n\",\"8b71e7045497e841c00ee568f031d1a4d30908fceadf6884aef2dec4d545202b\\n\",\"\\n\",\"\\n\",\"3. REGENERATED ARTIFACTS\\n\",\"------------------------\\n\",\"01. lfw_facenet_embeddings.npy\\n\",\"02. lfw_embedding_metadata.csv\\n\",\"03. lfw_identity_split_indices.npz\\n\",\"04. lfw_matched_stream_embeddings.npz\\n\",\"05. lfw_matched_stream_manifest_aligned.csv\\n\",\"06. lfw_identity_balanced_calibration_windows.npz\\n\",\"07. lfw_stage3_fresh_original_embeddings.npy\\n\",\"08. lfw_stage3_fresh_brightness_070_embeddings.npy\\n\",\"09. lfw_stage3_fresh_brightness_130_embeddings.npy\\n\",\"10. lfw_stage3_fresh_stream_manifest.csv\\n\",\"\\n\",\"All ten files are listed in:\\n\",\"experiment13_recovery_manifest.csv\\n\",\"\\n\",\"The manifest records file sizes, SHA-256 checksums,\\n\",\"regeneration status, and validation status.\\n\",\"\\n\",\"\\n\",\"4. REGENERATION LOGIC\\n\",\"---------------------\\n\",\"The original experiment notebook was inspected to reconstruct\\n\",\"the relevant selection, sampling, embedding, and transformation logic.\\n\",\"\\n\",\"The regeneration used:\\n\",\"- The checksum-verified LFW source archive.\\n\",\"- The verified FaceNet model weights.\\n\",\"- The original notebook's documented random seeds and selection logic.\\n\",\"- The reconstructed dataset path ordering.\\n\",\"- The original brightness transformation logic.\\n\",\"\\n\",\"Stage 3 brightness transformations:\\n\",\"- Brightness factor 0.70.\\n\",\"- Brightness factor 1.30.\\n\",\"- Transformation begins at window_id 10.\\n\",\"- First 500 embeddings remain unchanged.\\n\",\"- Final 500 embeddings are regenerated from transformed images.\\n\",\"\\n\",\"\\n\",\"5. VALIDATION RESULTS\\n\",\"---------------------\\n\",\"Required artifacts: 10\\n\",\"Present artifacts: 10\\n\",\"Missing artifacts: 0\\n\",\"\\n\",\"Base embeddings: 13,233 x 512\\n\",\"Reference images: 9,083\\n\",\"Evaluation images: 4,150\\n\",\"Matched stream: 600 x 512\\n\",\"Calibration windows: 100\\n\",\"Stage 3 stream: 1,000 images\\n\",\"\\n\",\"Validation checks passed:\\n\",\"- File existence.\\n\",\"- Embedding dimensions.\\n\",\"- Numerical finiteness.\\n\",\"- Metadata consistency.\\n\",\"- Identity split disjointness.\\n\",\"- Matched-stream structure.\\n\",\"- Calibration-window dimensions.\\n\",\"- Stage 3 manifest consistency.\\n\",\"- Unchanged pre-onset embeddings.\\n\",\"- Transformed post-onset embeddings.\\n\",\"\\n\",\"Final audit status: PASSED.\\n\",\"\\n\",\"\\n\",\"6. PROVENANCE LIMITATIONS\\n\",\"-------------------------\\n\",\"The original TFDS filesystem enumeration order was not independently\\n\",\"verified against the original execution environment.\\n\",\"\\n\",\"The regenerated dataset ordering was reconstructed using the\\n\",\"available TFDS path-making logic and checked for identity alignment.\\n\",\"\\n\",\"However, this does not establish that every dataset index maps\\n\",\"to exactly the same original image as in the original execution.\\n\",\"\\n\",\"Consequently:\\n\",\"- These files must be described as regenerated artifacts.\\n\",\"- They must not be described as exact original-file recoveries.\\n\",\"- Byte-for-byte equivalence with the original outputs is not established.\\n\",\"- Exact row-by-row equivalence with the original dataset ordering\\n\",\"  is not established.\\n\",\"\\n\",\"The SHA-256 checksums in the recovery manifest identify the\\n\",\"regenerated files created in this recovery run. They do not prove\\n\",\"equivalence to missing original files.\\n\",\"\\n\",\"\\n\",\"7. REPRODUCIBILITY RECORD\\n\",\"-------------------------\\n\",\"Original notebook:\\n\",\"Experiment_13_Final_Reproducibility_Audit.ipynb\\n\",\"\\n\",\"Regenerated artifact directory:\\n\",\"/content/experiment13_lfw_regenerated\\n\",\"\\n\",\"Recovery manifest:\\n\",\"experiment13_recovery_manifest.csv\\n\",\"\\n\",\"Status:\\n\",\"TEN ARTIFACTS REGENERATED AND VALIDATED.\\n\",\"\\n\",\"This document is a provenance record for the regenerated\\n\",\"working dataset. It does not replace the original experiment\\n\",\"notebook or constitute proof of exact original recovery.\\n\",\"\\\"\\\"\\\"\\n\",\"\\n\",\"notes_path.write_text(notes.strip() + \\\"\\\\n\\\", encoding=\\\"utf-8\\\")\\n\",\"\\n\",\"print(\\\"=\\\" * 65)\\n\",\"print(\\\"EXPERIMENT 13 — RECOVERY NOTES CREATED\\\")\\n\",\"print(\\\"=\\\" * 65)\\n\",\"print(\\\"File:\\\", notes_path)\\n\",\"print(\\\"Size:\\\", notes_path.stat().st_size, \\\"bytes\\\")\\n\",\"print(\\\"Status: CREATED\\\")\\n\",\"\\n\",\"CELL INDEX: 189\\n\",\"MATCH CATEGORIES: software_versions\\n\",\"SOURCE CODE:\\n\",\"import json\\n\",\"from pathlib import Path\\n\",\"\\n\",\"notebook_path = Path(\\n\",\"    \\\"/content/Real-Time-Embedding-Level-Drift-Detection/\\\"\\n\",\"    \\\"experiments/Experiment_13_Final_Reproducibility_Audit.ipynb\\\"\\n\",\")\\n\",\"\\n\",\"with open(notebook_path, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    notebook = json.load(f)\\n\",\"\\n\",\"for i in [40, 41, 52, 59, 63]:\\n\",\"    cell = notebook[\\\"cells\\\"][i]\\n\",\"\\n\",\"    print(\\\"\\\\n\\\" + \\\"=\\\" * 60)\\n\",\"    print(\\\"CELL:\\\", i)\\n\",\"    print(\\\"=\\\" * 60)\\n\",\"\\n\",\"    print(\\\"Execution count:\\\", cell.get(\\\"execution_count\\\"))\\n\",\"\\n\",\"    for output in cell.get(\\\"outputs\\\", []):\\n\",\"        if \\\"text\\\" in output:\\n\",\"            print(\\\"\\\".join(output[\\\"text\\\"]))\\n\",\"\\n\",\"        elif \\\"data\\\" in output:\\n\",\"            text_data = output[\\\"data\\\"].get(\\\"text/plain\\\")\\n\",\"            if text_data:\\n\",\"                print(\\\"\\\".join(text_data))\\n\",\"\\n\",\"print(\\\"\\\\nCURRENT ENVIRONMENT\\\")\\n\",\"import sklearn\\n\",\"print(\\\"scikit-learn:\\\", sklearn.__version__)\\n\",\"print(\\\"NumPy:\\\", np.__version__)\\n\",\"\\n\",\"CELL INDEX: 215\\n\",\"MATCH CATEGORIES: software_versions\\n\",\"SOURCE CODE:\\n\",\"from pathlib import Path\\n\",\"import hashlib\\n\",\"import importlib.metadata\\n\",\"\\n\",\"weights = Path(\\n\",\"    \\\"/root/.keras-facenet/20180402-114759/\\\"\\n\",\"    \\\"20180402-114759-weights.h5\\\"\\n\",\")\\n\",\"\\n\",\"expected_sha256 = (\\n\",\"    \\\"8b71e7045497e841c00ee568f031d1a4d30908fceadf6884aef2dec4d545202b\\\"\\n\",\")\\n\",\"\\n\",\"sha256 = hashlib.sha256()\\n\",\"\\n\",\"with open(weights, \\\"rb\\\") as f:\\n\",\"    for chunk in iter(lambda: f.read(1024 * 1024), b\\\"\\\"):\\n\",\"        sha256.update(chunk)\\n\",\"\\n\",\"actual_sha256 = sha256.hexdigest()\\n\",\"\\n\",\"print(\\\"=== FACENET WEIGHT INTEGRITY ===\\\")\\n\",\"print(\\\"File exists:\\\", weights.exists())\\n\",\"print(\\\"File size:\\\", weights.stat().st_size)\\n\",\"print(\\\"Expected SHA-256:\\\", expected_sha256)\\n\",\"print(\\\"Actual SHA-256:\\\", actual_sha256)\\n\",\"print(\\\"Checksum match:\\\", actual_sha256 == expected_sha256)\\n\",\"\\n\",\"print(\\\"\\\\n=== INSTALLED PACKAGE VERSIONS ===\\\")\\n\",\"\\n\",\"for package in [\\\"keras-facenet\\\", \\\"tensorflow\\\", \\\"tensorflow-datasets\\\",\\n\",\"                \\\"numpy\\\", \\\"scikit-learn\\\", \\\"opencv-python\\\"]:\\n\",\"    try:\\n\",\"        print(package, \\\":\\\", importlib.metadata.version(package))\\n\",\"    except importlib.metadata.PackageNotFoundError:\\n\",\"        print(package, \\\": not installed\\\")\\n\",\"\\n\",\"CELL INDEX: 227\\n\",\"MATCH CATEGORIES: software_versions\\n\",\"SOURCE CODE:\\n\",\"import inspect\\n\",\"import tensorflow_datasets as tfds\\n\",\"\\n\",\"print(\\\"TFDS version:\\\", tfds.__version__)\\n\",\"\\n\",\"builder = tfds.builder(\\\"lfw\\\")\\n\",\"\\n\",\"print(\\\"\\\\n=== LFW BUILDER CLASS ===\\\")\\n\",\"print(type(builder))\\n\",\"\\n\",\"print(\\\"\\\\n=== BUILDER SOURCE FILE ===\\\")\\n\",\"print(inspect.getfile(type(builder)))\\n\",\"\\n\",\"print(\\\"\\\\n=== DATASET INFO / CONFIGURATION ===\\\")\\n\",\"print(\\\"Name:\\\", builder.name)\\n\",\"print(\\\"Version:\\\", builder.version)\\n\",\"print(\\\"Splits:\\\", builder.info.splits)\\n\",\"\\n\",\"print(\\\"\\\\n=== BUILDER METHODS RELATED TO FILE ORDER ===\\\")\\n\",\"for name in dir(builder):\\n\",\"    if any(term in name.lower() for term in [\\n\",\"        \\\"path\\\", \\\"file\\\", \\\"download\\\", \\\"split\\\", \\\"generate\\\"\\n\",\"    ]):\\n\",\"        print(name)\\n\",\"\\n\",\"----------------------------------------------------------------------------------------------------\\n\",\"NOTEBOOK: /content/drive/MyDrive/Colab Notebooks/Experiment_16_Cross_Condition_Calibration_Transfer.ipynb\\n\",\"MATCHING CODE CELLS: 1\\n\",\"\\n\",\"CELL INDEX: 1\\n\",\"MATCH CATEGORIES: software_versions\\n\",\"SOURCE CODE:\\n\",\"\\n\",\"from pathlib import Path\\n\",\"import json\\n\",\"import platform\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"import scipy\\n\",\"import sklearn\\n\",\"\\n\",\"CONFIG = {\\n\",\"    \\\"experiment_id\\\": 16,\\n\",\"    \\\"title\\\": \\\"Cross-Condition Calibration Transfer for Embedding-Level Drift Detection\\\",\\n\",\"    \\\"random_seed\\\": 202616,\\n\",\"    \\\"n_seeds\\\": 20,\\n\",\"    \\\"embedding_dimension\\\": 64,\\n\",\"    \\\"window_size\\\": 20,\\n\",\"    \\\"reference_samples\\\": 1000,\\n\",\"    \\\"calibration_windows\\\": 200,\\n\",\"    \\\"control_windows\\\": 500,\\n\",\"    \\\"evaluation_windows_per_condition\\\": 500,\\n\",\"    \\\"target_false_alarm_rate\\\": 0.05,\\n\",\"    \\\"mean_shift_strength\\\": 0.5,\\n\",\"    \\\"correlation_strength\\\": 0.6,\\n\",\"    \\\"detectors\\\": [\\\"euclidean\\\", \\\"mahalanobis\\\"],\\n\",\"    \\\"conditions\\\": [\\\"isotropic\\\", \\\"anisotropic\\\", \\\"correlated\\\"],\\n\",\"    \\\"calibration_strategy\\\": \\\"source_condition_threshold_frozen\\\"\\n\",\"}\\n\",\"\\n\",\"RESULTS_DIR = Path(\\\"/content/results/experiment_16\\\")\\n\",\"RESULTS_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"with open(RESULTS_DIR / \\\"config.json\\\", \\\"w\\\") as f:\\n\",\"    json.dump(CONFIG, f, indent=2)\\n\",\"\\n\",\"environment = {\\n\",\"    \\\"python\\\": platform.python_version(),\\n\",\"    \\\"numpy\\\": np.__version__,\\n\",\"    \\\"pandas\\\": pd.__version__,\\n\",\"    \\\"scipy\\\": scipy.__version__,\\n\",\"    \\\"scikit_learn\\\": sklearn.__version__,\\n\",\"    \\\"platform\\\": platform.platform()\\n\",\"}\\n\",\"\\n\",\"with open(RESULTS_DIR / \\\"environment.json\\\", \\\"w\\\") as f:\\n\",\"    json.dump(environment, f, indent=2)\\n\",\"\\n\",\"print(\\\"Experiment 16 configuration created.\\\")\\n\",\"print(\\\"Results directory:\\\", RESULTS_DIR)\\n\",\"print(\\\"Seeds:\\\", CONFIG[\\\"n_seeds\\\"])\\n\",\"print(\\\"Embedding dimension:\\\", CONFIG[\\\"embedding_dimension\\\"])\\n\",\"print(\\\"Conditions:\\\", CONFIG[\\\"conditions\\\"])\\n\",\"print(\\\"Detectors:\\\", CONFIG[\\\"detectors\\\"])\\n\",\"print(\\\"Target false-alarm rate:\\\", CONFIG[\\\"target_false_alarm_rate\\\"])\\n\",\"print(\\\"Environment:\\\", environment)\\n\",\"\\n\",\"\\n\",\"----------------------------------------------------------------------------------------------------\\n\",\"NOTEBOOK: /content/drive/MyDrive/Colab Notebooks/Experiment_17_Target_Condition_Recalibration.ipynb\\n\",\"MATCHING CODE CELLS: 2\\n\",\"\\n\",\"CELL INDEX: 1\\n\",\"MATCH CATEGORIES: software_versions\\n\",\"SOURCE CODE:\\n\",\"\\n\",\"# Experiment 17 — Step 2: Configuration\\n\",\"\\n\",\"import json\\n\",\"import platform\\n\",\"from pathlib import Path\\n\",\"\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"from sklearn.covariance import LedoitWolf\\n\",\"\\n\",\"CONFIG = {\\n\",\"    \\\"experiment_id\\\": 17,\\n\",\"    \\\"experiment_name\\\": \\\"Target-Condition Recalibration\\\",\\n\",\"    \\\"random_seed\\\": 202617,\\n\",\"    \\\"n_seeds\\\": 20,\\n\",\"    \\\"embedding_dimension\\\": 64,\\n\",\"    \\\"window_size\\\": 20,\\n\",\"    \\\"reference_samples\\\": 1000,\\n\",\"    \\\"source_calibration_windows\\\": 200,\\n\",\"    \\\"target_calibration_window_sizes\\\": [25, 50, 100, 200, 500],\\n\",\"    \\\"control_windows\\\": 500,\\n\",\"    \\\"evaluation_windows_per_condition\\\": 500,\\n\",\"    \\\"target_false_alarm_rate\\\": 0.05,\\n\",\"    \\\"mean_shift_strength\\\": 0.5,\\n\",\"    \\\"correlation_strength\\\": 0.6,\\n\",\"    \\\"detectors\\\": [\\\"euclidean\\\", \\\"mahalanobis\\\"],\\n\",\"    \\\"conditions\\\": [\\\"isotropic\\\", \\\"anisotropic\\\", \\\"correlated\\\"],\\n\",\"}\\n\",\"\\n\",\"OUTPUT_DIR = Path(\\\"/content/results/experiment_17\\\")\\n\",\"OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"with open(OUTPUT_DIR / \\\"experiment_17_config.json\\\", \\\"w\\\") as f:\\n\",\"    json.dump(CONFIG, f, indent=2)\\n\",\"\\n\",\"print(\\\"Experiment 17 configuration loaded.\\\")\\n\",\"print(json.dumps(CONFIG, indent=2))\\n\",\"print(\\\"\\\\nPython:\\\", platform.python_version())\\n\",\"print(\\\"NumPy:\\\", np.__version__)\\n\",\"print(\\\"Pandas:\\\", pd.__version__)\\n\",\"print(\\\"Output directory:\\\", OUTPUT_DIR)\\n\",\"\\n\",\"\\n\",\"CELL INDEX: 25\\n\",\"MATCH CATEGORIES: software_versions\\n\",\"SOURCE CODE:\\n\",\"\\n\",\"# Experiment 17 — Step 15: Save Reproducibility Manifest\\n\",\"\\n\",\"import sklearn\\n\",\"import sys\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"manifest = {\\n\",\"    \\\"experiment_id\\\": CONFIG[\\\"experiment_id\\\"],\\n\",\"    \\\"experiment_name\\\": CONFIG[\\\"experiment_name\\\"],\\n\",\"    \\\"created_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"configuration\\\": CONFIG,\\n\",\"    \\\"environment\\\": {\\n\",\"        \\\"python\\\": sys.version,\\n\",\"        \\\"numpy\\\": np.__version__,\\n\",\"        \\\"pandas\\\": pd.__version__,\\n\",\"        \\\"scikit_learn\\\": sklearn.__version__,\\n\",\"    },\\n\",\"    \\\"principal_outputs\\\": [\\n\",\"        \\\"experiment_17_config.json\\\",\\n\",\"        \\\"source_calibration_thresholds.csv\\\",\\n\",\"        \\\"target_recalibrated_thresholds.csv\\\",\\n\",\"        \\\"independent_control_fpr_results.csv\\\",\\n\",\"        \\\"independent_drift_detection_results.csv\\\",\\n\",\"        \\\"joint_recalibration_comparison.csv\\\",\\n\",\"        \\\"experiment_17_aggregated_summary.csv\\\",\\n\",\"        \\\"experiment_17_integrity_audit.csv\\\",\\n\",\"    ],\\n\",\"    \\\"integrity_checks_passed\\\": passed_count,\\n\",\"    \\\"integrity_checks_total\\\": total_count,\\n\",\"    \\\"integrity_audit_passed\\\": passed_count == total_count,\\n\",\"    \\\"scientific_validation_status\\\": (\\n\",\"        \\\"Not established by numerical integrity checks alone\\\"\\n\",\"    ),\\n\",\"}\\n\",\"\\n\",\"manifest_path = OUTPUT_DIR / \\\"experiment_17_manifest.json\\\"\\n\",\"\\n\",\"with open(manifest_path, \\\"w\\\") as f:\\n\",\"    json.dump(manifest, f, indent=2)\\n\",\"\\n\",\"print(json.dumps(manifest, indent=2))\\n\",\"print(\\\"\\\\nManifest saved to:\\\", manifest_path)\\n\",\"\\n\",\"\\n\",\"----------------------------------------------------------------------------------------------------\\n\",\"NOTEBOOK: /content/drive/MyDrive/Colab Notebooks/Experiment_17_Target_Condition_Recalibration_FINAL.ipynb\\n\",\"MATCHING CODE CELLS: 2\\n\",\"\\n\",\"CELL INDEX: 1\\n\",\"MATCH CATEGORIES: software_versions\\n\",\"SOURCE CODE:\\n\",\"\\n\",\"# Experiment 17 — Step 2: Configuration\\n\",\"\\n\",\"import json\\n\",\"import platform\\n\",\"from pathlib import Path\\n\",\"\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"from sklearn.covariance import LedoitWolf\\n\",\"\\n\",\"CONFIG = {\\n\",\"    \\\"experiment_id\\\": 17,\\n\",\"    \\\"experiment_name\\\": \\\"Target-Condition Recalibration\\\",\\n\",\"    \\\"random_seed\\\": 202617,\\n\",\"    \\\"n_seeds\\\": 20,\\n\",\"    \\\"embedding_dimension\\\": 64,\\n\",\"    \\\"window_size\\\": 20,\\n\",\"    \\\"reference_samples\\\": 1000,\\n\",\"    \\\"source_calibration_windows\\\": 200,\\n\",\"    \\\"target_calibration_window_sizes\\\": [25, 50, 100, 200, 500],\\n\",\"    \\\"control_windows\\\": 500,\\n\",\"    \\\"evaluation_windows_per_condition\\\": 500,\\n\",\"    \\\"target_false_alarm_rate\\\": 0.05,\\n\",\"    \\\"mean_shift_strength\\\": 0.5,\\n\",\"    \\\"correlation_strength\\\": 0.6,\\n\",\"    \\\"detectors\\\": [\\\"euclidean\\\", \\\"mahalanobis\\\"],\\n\",\"    \\\"conditions\\\": [\\\"isotropic\\\", \\\"anisotropic\\\", \\\"correlated\\\"],\\n\",\"}\\n\",\"\\n\",\"OUTPUT_DIR = Path(\\\"/content/results/experiment_17\\\")\\n\",\"OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"with open(OUTPUT_DIR / \\\"experiment_17_config.json\\\", \\\"w\\\") as f:\\n\",\"    json.dump(CONFIG, f, indent=2)\\n\",\"\\n\",\"print(\\\"Experiment 17 configuration loaded.\\\")\\n\",\"print(json.dumps(CONFIG, indent=2))\\n\",\"print(\\\"\\\\nPython:\\\", platform.python_version())\\n\",\"print(\\\"NumPy:\\\", np.__version__)\\n\",\"print(\\\"Pandas:\\\", pd.__version__)\\n\",\"print(\\\"Output directory:\\\", OUTPUT_DIR)\\n\",\"\\n\",\"\\n\",\"CELL INDEX: 25\\n\",\"MATCH CATEGORIES: software_versions\\n\",\"SOURCE CODE:\\n\",\"\\n\",\"# Experiment 17 — Step 15: Save Reproducibility Manifest\\n\",\"\\n\",\"import sklearn\\n\",\"import sys\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"manifest = {\\n\",\"    \\\"experiment_id\\\": CONFIG[\\\"experiment_id\\\"],\\n\",\"    \\\"experiment_name\\\": CONFIG[\\\"experiment_name\\\"],\\n\",\"    \\\"created_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"configuration\\\": CONFIG,\\n\",\"    \\\"environment\\\": {\\n\",\"        \\\"python\\\": sys.version,\\n\",\"        \\\"numpy\\\": np.__version__,\\n\",\"        \\\"pandas\\\": pd.__version__,\\n\",\"        \\\"scikit_learn\\\": sklearn.__version__,\\n\",\"    },\\n\",\"    \\\"principal_outputs\\\": [\\n\",\"        \\\"experiment_17_config.json\\\",\\n\",\"        \\\"source_calibration_thresholds.csv\\\",\\n\",\"        \\\"target_recalibrated_thresholds.csv\\\",\\n\",\"        \\\"independent_control_fpr_results.csv\\\",\\n\",\"        \\\"independent_drift_detection_results.csv\\\",\\n\",\"        \\\"joint_recalibration_comparison.csv\\\",\\n\",\"        \\\"experiment_17_aggregated_summary.csv\\\",\\n\",\"        \\\"experiment_17_integrity_audit.csv\\\",\\n\",\"    ],\\n\",\"    \\\"integrity_checks_passed\\\": passed_count,\\n\",\"    \\\"integrity_checks_total\\\": total_count,\\n\",\"    \\\"integrity_audit_passed\\\": passed_count == total_count,\\n\",\"    \\\"scientific_validation_status\\\": (\\n\",\"        \\\"Not established by numerical integrity checks alone\\\"\\n\",\"    ),\\n\",\"}\\n\",\"\\n\",\"manifest_path = OUTPUT_DIR / \\\"experiment_17_manifest.json\\\"\\n\",\"\\n\",\"with open(manifest_path, \\\"w\\\") as f:\\n\",\"    json.dump(manifest, f, indent=2)\\n\",\"\\n\",\"print(json.dumps(manifest, indent=2))\\n\",\"print(\\\"\\\\nManifest saved to:\\\", manifest_path)\\n\",\"\\n\",\"\\n\",\"----------------------------------------------------------------------------------------------------\\n\",\"NOTEBOOK: /content/drive/MyDrive/Colab Notebooks/Experiment_18_Genuine_Face_Recognition_Embedding_Validation.ipynb\\n\",\"MATCHING CODE CELLS: 10\\n\",\"\\n\",\"CELL INDEX: 2\\n\",\"MATCH CATEGORIES: software_versions\\n\",\"SOURCE CODE:\\n\",\"import sys\\n\",\"import torch\\n\",\"import torchvision\\n\",\"import numpy as np\\n\",\"import PIL\\n\",\"\\n\",\"print(\\\"Python version:\\\", sys.version)\\n\",\"print(\\\"PyTorch version:\\\", torch.__version__)\\n\",\"print(\\\"Torchvision version:\\\", torchvision.__version__)\\n\",\"print(\\\"NumPy version:\\\", np.__version__)\\n\",\"print(\\\"Pillow version:\\\", PIL.__version__)\\n\",\"\\n\",\"print(\\\"\\\\nInstalling FaceNet library...\\\")\\n\",\"\\n\",\"!pip install facenet-pytorch==2.6.0 --no-deps\\n\",\"\\n\",\"print(\\\"\\\\nEnvironment verification completed.\\\")\\n\",\"\\n\",\"CELL INDEX: 4\\n\",\"MATCH CATEGORIES: model_initialization, software_versions\\n\",\"SOURCE CODE:\\n\",\"import torch\\n\",\"import torchvision\\n\",\"from facenet_pytorch import MTCNN, InceptionResnetV1\\n\",\"\\n\",\"# Configure execution device\\n\",\"device = torch.device(\\\"cpu\\\")\\n\",\"\\n\",\"# Initialise MTCNN face detector\\n\",\"mtcnn = MTCNN(\\n\",\"    image_size=160,\\n\",\"    margin=0,\\n\",\"    keep_all=False,\\n\",\"    device=device\\n\",\")\\n\",\"\\n\",\"# Load pretrained FaceNet model\\n\",\"facenet = InceptionResnetV1(\\n\",\"    pretrained=\\\"vggface2\\\"\\n\",\").eval().to(device)\\n\",\"\\n\",\"# Verify model configuration\\n\",\"print(\\\"MTCNN initialised successfully.\\\")\\n\",\"print(\\\"FaceNet model initialised successfully.\\\")\\n\",\"print(\\\"Pretrained weights: VGGFace2\\\")\\n\",\"print(\\\"Execution device:\\\", device)\\n\",\"print(\\\"Embedding dimension:\\\", facenet.last_linear.out_features)\\n\",\"\\n\",\"CELL INDEX: 22\\n\",\"MATCH CATEGORIES: model_initialization\\n\",\"SOURCE CODE:\\n\",\"import numpy as np\\n\",\"import json\\n\",\"from pathlib import Path\\n\",\"\\n\",\"output_dir = Path(\\\"/content/experiment18_results\\\")\\n\",\"output_dir.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"archive_path = output_dir / \\\"experiment18_facenet_lfw_embeddings.npz\\\"\\n\",\"\\n\",\"np.savez_compressed(\\n\",\"    archive_path,\\n\",\"\\n\",\"    reference_embeddings=reference_embeddings,\\n\",\"    reference_labels=reference_labels,\\n\",\"\\n\",\"    calibration_embeddings=calibration_embeddings,\\n\",\"    calibration_labels=calibration_labels,\\n\",\"\\n\",\"    evaluation_embeddings=evaluation_embeddings,\\n\",\"    evaluation_labels=evaluation_labels,\\n\",\"\\n\",\"    reference_failures=np.array(reference_failures),\\n\",\"    calibration_failures=np.array(calibration_failures),\\n\",\"    evaluation_failures=np.array(evaluation_failures),\\n\",\"\\n\",\"    random_seed=np.array(42),\\n\",\"    model=np.array(\\\"InceptionResnetV1\\\"),\\n\",\"    pretrained_weights=np.array(\\\"VGGFace2\\\"),\\n\",\"    dataset=np.array(\\\"LFW\\\"),\\n\",\"    embedding_dimension=np.array(512)\\n\",\")\\n\",\"\\n\",\"print(\\\"Archive saved:\\\", archive_path)\\n\",\"print(\\\"File size (MB):\\\", round(archive_path.stat().st_size / (1024**2), 2))\\n\",\"\\n\",\"# Verify archive\\n\",\"with np.load(archive_path) as saved:\\n\",\"    print(\\\"\\\\nSaved archive contents:\\\")\\n\",\"    for key in saved.files:\\n\",\"        print(key, saved[key].shape)\\n\",\"\\n\",\"CELL INDEX: 43\\n\",\"MATCH CATEGORIES: model_initialization\\n\",\"SOURCE CODE:\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"\\n\",\"print(\\\"=\\\" * 70)\\n\",\"print(\\\"EXPERIMENT 18 — BASELINE EMBEDDING ANALYSIS SUMMARY\\\")\\n\",\"print(\\\"=\\\" * 70)\\n\",\"\\n\",\"# 1. Dataset and embedding extraction\\n\",\"print(\\\"\\\\n1. DATASET AND EMBEDDING EXTRACTION\\\")\\n\",\"\\n\",\"print(\\\"Dataset: LFW filtered subset\\\")\\n\",\"print(\\\"Number of identities:\\\", 62)\\n\",\"print(\\\"Successful embeddings:\\\",\\n\",\"      len(reference_embeddings) +\\n\",\"      len(calibration_embeddings) +\\n\",\"      len(evaluation_embeddings))\\n\",\"\\n\",\"print(\\\"Embedding dimension:\\\", reference_embeddings.shape[1])\\n\",\"print(\\\"Model: InceptionResnetV1\\\")\\n\",\"print(\\\"Pretrained weights: VGGFace2\\\")\\n\",\"\\n\",\"total_images = 3023\\n\",\"successful_embeddings = (\\n\",\"    len(reference_embeddings) +\\n\",\"    len(calibration_embeddings) +\\n\",\"    len(evaluation_embeddings)\\n\",\")\\n\",\"\\n\",\"print(\\\"Face detection success rate:\\\",\\n\",\"      round(successful_embeddings / total_images * 100, 2), \\\"%\\\")\\n\",\"\\n\",\"# 2. Identity similarity analysis\\n\",\"print(\\\"\\\\n2. IDENTITY SIMILARITY ANALYSIS\\\")\\n\",\"\\n\",\"similarity_summary = pd.DataFrame({\\n\",\"    \\\"Partition\\\": [\\\"Reference\\\", \\\"Calibration\\\", \\\"Evaluation\\\"],\\n\",\"    \\\"Same Identity Mean\\\": [0.743622, 0.752430, 0.759970],\\n\",\"    \\\"Different Identity Mean\\\": [0.056351, 0.050947, 0.056767],\\n\",\"    \\\"Mean Separation\\\": [0.687271, 0.701483, 0.703203]\\n\",\"})\\n\",\"\\n\",\"display(similarity_summary.round(6))\\n\",\"\\n\",\"# 3. Distribution distance analysis\\n\",\"print(\\\"\\\\n3. DISTRIBUTION DISTANCE ANALYSIS\\\")\\n\",\"\\n\",\"display(distance_results.round(6))\\n\",\"\\n\",\"# 4. Regularisation sensitivity\\n\",\"print(\\\"\\\\n4. MAHALANOBIS REGULARISATION SENSITIVITY\\\")\\n\",\"\\n\",\"display(\\n\",\"    sensitivity_df[\\n\",\"        [\\n\",\"            \\\"Comparison\\\",\\n\",\"            \\\"Regularisation Strength\\\",\\n\",\"            \\\"Mahalanobis Distance\\\",\\n\",\"            \\\"Condition Number\\\"\\n\",\"        ]\\n\",\"    ].round(6)\\n\",\")\\n\",\"\\n\",\"# 5. Final integrity checks\\n\",\"print(\\\"\\\\n5. EMBEDDING INTEGRITY\\\")\\n\",\"\\n\",\"for name, embeddings in partitions.items():\\n\",\"\\n\",\"    print(\\n\",\"        f\\\"{name}:\\\",\\n\",\"        \\\"Finite =\\\", np.all(np.isfinite(embeddings)),\\n\",\"        \\\"| Shape =\\\", embeddings.shape,\\n\",\"        \\\"| Mean L2 norm =\\\", round(\\n\",\"            np.mean(np.linalg.norm(embeddings, axis=1)), 6\\n\",\"        )\\n\",\"    )\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 70)\\n\",\"print(\\\"BASELINE ANALYSIS SUMMARY GENERATED\\\")\\n\",\"print(\\\"=\\\" * 70)\\n\",\"\\n\",\"CELL INDEX: 64\\n\",\"MATCH CATEGORIES: model_initialization\\n\",\"SOURCE CODE:\\n\",\"import os\\n\",\"import json\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"\\n\",\"# Create output directory\\n\",\"output_dir = \\\"/content/drive/MyDrive/Experiment_18_Results\\\"\\n\",\"os.makedirs(output_dir, exist_ok=True)\\n\",\"\\n\",\"# Save numerical experiment results\\n\",\"np.savez_compressed(\\n\",\"    os.path.join(output_dir, \\\"experiment18_illumination_results.npz\\\"),\\n\",\"\\n\",\"    original_embeddings=paired_original_embeddings,\\n\",\"    low_illumination_embeddings=paired_low_embeddings,\\n\",\"    high_illumination_embeddings=paired_high_embeddings,\\n\",\"\\n\",\"    paired_labels=paired_labels,\\n\",\"    common_positions=common_positions,\\n\",\"\\n\",\"    low_displacement=low_distances,\\n\",\"    high_displacement=high_distances,\\n\",\"\\n\",\"    low_success=low_success,\\n\",\"    high_success=high_success,\\n\",\"\\n\",\"    low_failures=low_failures,\\n\",\"    high_failures=high_failures\\n\",\")\\n\",\"\\n\",\"# Save identity-level summary\\n\",\"identity_summary.to_csv(\\n\",\"    os.path.join(output_dir, \\\"illumination_identity_summary.csv\\\"),\\n\",\"    index=False\\n\",\")\\n\",\"\\n\",\"# Save aggregate statistics\\n\",\"illumination_metadata = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 18 - Controlled Illumination\\\",\\n\",\"    \\\"dataset\\\": \\\"LFW filtered subset\\\",\\n\",\"    \\\"model\\\": \\\"InceptionResnetV1\\\",\\n\",\"    \\\"pretrained_weights\\\": \\\"VGGFace2\\\",\\n\",\"    \\\"embedding_dimension\\\": 512,\\n\",\"    \\\"brightness_factors\\\": {\\n\",\"        \\\"low\\\": 0.5,\\n\",\"        \\\"original\\\": 1.0,\\n\",\"        \\\"high\\\": 1.5\\n\",\"    },\\n\",\"    \\\"paired_images\\\": int(len(common_positions)),\\n\",\"    \\\"evaluation_identities\\\": int(len(identity_summary)),\\n\",\"    \\\"low_detection_failures\\\": int(len(low_failures)),\\n\",\"    \\\"high_detection_failures\\\": int(len(high_failures)),\\n\",\"    \\\"image_level_wilcoxon_p\\\": float(p_value),\\n\",\"    \\\"identity_level_wilcoxon_p\\\": float(identity_p_value),\\n\",\"    \\\"mean_low_displacement\\\": float(np.mean(low_distances)),\\n\",\"    \\\"mean_high_displacement\\\": float(np.mean(high_distances))\\n\",\"}\\n\",\"\\n\",\"with open(\\n\",\"    os.path.join(output_dir, \\\"illumination_metadata.json\\\"),\\n\",\"    \\\"w\\\"\\n\",\") as file:\\n\",\"    json.dump(illumination_metadata, file, indent=4)\\n\",\"\\n\",\"print(\\\"ILLUMINATION RESULTS SAVED\\\")\\n\",\"\\n\",\"for filename in [\\n\",\"    \\\"experiment18_illumination_results.npz\\\",\\n\",\"    \\\"illumination_identity_summary.csv\\\",\\n\",\"    \\\"illumination_metadata.json\\\"\\n\",\"]:\\n\",\"    path = os.path.join(output_dir, filename)\\n\",\"    print(filename, \\\"| Exists:\\\", os.path.exists(path))\\n\",\"    print(\\\"Size:\\\", round(os.path.getsize(path) / 1024, 2), \\\"KB\\\")\\n\",\"\\n\",\"CELL INDEX: 117\\n\",\"MATCH CATEGORIES: model_initialization, software_versions\\n\",\"SOURCE CODE:\\n\",\"\\n\",\"import os\\n\",\"import sys\\n\",\"import json\\n\",\"import platform\\n\",\"import importlib.metadata as pkg_metadata\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"from pathlib import Path\\n\",\"from IPython.display import display\\n\",\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 18 — STEP 17.10.3\\n\",\"# EXPERIMENTAL CONFIGURATION AND REPRODUCIBILITY AUDIT\\n\",\"# ============================================================\\n\",\"\\n\",\"print(\\\"EXPERIMENT 18 — STEP 17.10.3\\\")\\n\",\"print(\\\"EXPERIMENTAL CONFIGURATION AND REPRODUCIBILITY AUDIT\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Dataset and embedding configuration\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n1. DATASET AND EMBEDDING CONFIGURATION\\\")\\n\",\"\\n\",\"configuration = {\\n\",\"    \\\"Dataset\\\": \\\"Labeled Faces in the Wild (LFW)\\\",\\n\",\"    \\\"Pretrained Model\\\": \\\"InceptionResnetV1\\\",\\n\",\"    \\\"Pretrained Weights\\\": \\\"VGGFace2\\\",\\n\",\"    \\\"Embedding Dimension\\\": 512,\\n\",\"    \\\"Evaluation Identities\\\": 13,\\n\",\"    \\\"Full Paired Illumination Images\\\": 889,\\n\",\"    \\\"Corrected Identity-Level Evaluation Images\\\": 229,\\n\",\"    \\\"Low Brightness Factor\\\": 0.5,\\n\",\"    \\\"Original Brightness Factor\\\": 1.0,\\n\",\"    \\\"High Brightness Factor\\\": 1.5\\n\",\"}\\n\",\"\\n\",\"configuration_df = pd.DataFrame(\\n\",\"    list(configuration.items()),\\n\",\"    columns=[\\\"Configuration\\\", \\\"Value\\\"]\\n\",\")\\n\",\"\\n\",\"display(configuration_df)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Verify full paired illumination arrays\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n2. FULL PAIRED ILLUMINATION DATA VALIDATION\\\")\\n\",\"\\n\",\"paired_arrays = {\\n\",\"    \\\"Original\\\": paired_original_embeddings,\\n\",\"    \\\"Low illumination\\\": paired_low_embeddings,\\n\",\"    \\\"High illumination\\\": paired_high_embeddings\\n\",\"}\\n\",\"\\n\",\"paired_sample_counts = []\\n\",\"\\n\",\"for condition, array in paired_arrays.items():\\n\",\"\\n\",\"    array = np.asarray(array)\\n\",\"\\n\",\"    print(f\\\"\\\\n{condition}\\\")\\n\",\"    print(\\\"Shape:\\\", array.shape)\\n\",\"    print(\\\"All values finite:\\\", np.isfinite(array).all())\\n\",\"\\n\",\"    assert array.ndim == 2\\n\",\"    assert array.shape[1] == 512\\n\",\"    assert np.isfinite(array).all()\\n\",\"\\n\",\"    paired_sample_counts.append(array.shape[0])\\n\",\"\\n\",\"assert paired_sample_counts == [889, 889, 889], (\\n\",\"    \\\"Full paired illumination arrays do not contain \\\"\\n\",\"    \\\"the expected 889 samples each.\\\"\\n\",\")\\n\",\"\\n\",\"paired_labels_array = np.asarray(paired_labels)\\n\",\"\\n\",\"assert len(paired_labels_array) == 889\\n\",\"assert len(np.unique(paired_labels_array)) == 13\\n\",\"\\n\",\"print(\\\"\\\\nFull paired sample count: 889\\\")\\n\",\"print(\\\"Full paired identity count:\\\", len(np.unique(paired_labels_array)))\\n\",\"print(\\\"Full paired dataset validation: PASSED\\\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Verify corrected identity-level evaluation cohort\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n3. CORRECTED IDENTITY-LEVEL EVALUATION COHORT\\\")\\n\",\"\\n\",\"evaluation_variables = [\\n\",\"    \\\"evaluation_baseline\\\",\\n\",\"    \\\"evaluation_low\\\",\\n\",\"    \\\"evaluation_high\\\",\\n\",\"    \\\"evaluation_labels\\\"\\n\",\"]\\n\",\"\\n\",\"missing_evaluation_variables = [\\n\",\"    name for name in evaluation_variables\\n\",\"    if name not in globals()\\n\",\"]\\n\",\"\\n\",\"if not missing_evaluation_variables:\\n\",\"\\n\",\"    evaluation_arrays = {\\n\",\"        \\\"Original evaluation\\\": evaluation_baseline,\\n\",\"        \\\"Low illumination evaluation\\\": evaluation_low,\\n\",\"        \\\"High illumination evaluation\\\": evaluation_high\\n\",\"    }\\n\",\"\\n\",\"    evaluation_sample_counts = []\\n\",\"\\n\",\"    for condition, array in evaluation_arrays.items():\\n\",\"\\n\",\"        array = np.asarray(array)\\n\",\"\\n\",\"        print(f\\\"\\\\n{condition}\\\")\\n\",\"        print(\\\"Shape:\\\", array.shape)\\n\",\"        print(\\\"All values finite:\\\", np.isfinite(array).all())\\n\",\"\\n\",\"        assert array.ndim == 2\\n\",\"        assert array.shape[1] == 512\\n\",\"        assert np.isfinite(array).all()\\n\",\"\\n\",\"        evaluation_sample_counts.append(array.shape[0])\\n\",\"\\n\",\"    evaluation_labels_array = np.asarray(evaluation_labels)\\n\",\"\\n\",\"    assert evaluation_sample_counts == [229, 229, 229], (\\n\",\"        \\\"Corrected evaluation arrays do not contain \\\"\\n\",\"        \\\"229 samples each.\\\"\\n\",\"    )\\n\",\"\\n\",\"    assert len(evaluation_labels_array) == 229\\n\",\"    assert len(np.unique(evaluation_labels_array)) == 13\\n\",\"\\n\",\"    print(\\\"\\\\nCorrected evaluation sample count: 229\\\")\\n\",\"    print(\\n\",\"        \\\"Corrected evaluation identity count:\\\",\\n\",\"        len(np.unique(evaluation_labels_array))\\n\",\"    )\\n\",\"    print(\\\"Corrected evaluation cohort validation: PASSED\\\")\\n\",\"\\n\",\"else:\\n\",\"\\n\",\"    print(\\n\",\"        \\\"Corrected evaluation variables unavailable:\\\",\\n\",\"        missing_evaluation_variables\\n\",\"    )\\n\",\"    print(\\n\",\"        \\\"Corrected 229-image cohort could not be independently \\\"\\n\",\"        \\\"verified in the current session.\\\"\\n\",\"    )\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Inspect existing model object\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n4. MODEL OBJECT INSPECTION\\\")\\n\",\"\\n\",\"model_candidates = [\\n\",\"    name for name in globals()\\n\",\"    if \\\"model\\\" in name.lower()\\n\",\"    and name != \\\"model_candidates\\\"\\n\",\"]\\n\",\"\\n\",\"model_inspection = []\\n\",\"\\n\",\"for name in model_candidates:\\n\",\"\\n\",\"    obj = globals()[name]\\n\",\"\\n\",\"    if callable(getattr(obj, \\\"eval\\\", None)):\\n\",\"\\n\",\"        model_inspection.append({\\n\",\"            \\\"Variable\\\": name,\\n\",\"            \\\"Object Type\\\": type(obj).__name__,\\n\",\"            \\\"Class Module\\\": type(obj).__module__,\\n\",\"            \\\"Evaluation Method\\\": \\\"Available\\\"\\n\",\"        })\\n\",\"\\n\",\"if model_inspection:\\n\",\"\\n\",\"    model_inspection_df = pd.DataFrame(model_inspection)\\n\",\"    display(model_inspection_df)\\n\",\"\\n\",\"    expected_model_found = any(\\n\",\"        row[\\\"Object Type\\\"] == \\\"InceptionResnetV1\\\"\\n\",\"        for row in model_inspection\\n\",\"    )\\n\",\"\\n\",\"    print(\\n\",\"        \\\"InceptionResnetV1 model object found:\\\",\\n\",\"        expected_model_found\\n\",\"    )\\n\",\"\\n\",\"else:\\n\",\"\\n\",\"    print(\\n\",\"        \\\"No existing model object with an evaluation method \\\"\\n\",\"        \\\"was identified.\\\"\\n\",\"    )\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Inspect random seed configuration\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n5. RANDOM SEED CONFIGURATION\\\")\\n\",\"\\n\",\"seed_names = [\\n\",\"    \\\"RANDOM_SEED\\\",\\n\",\"    \\\"BOOTSTRAP_SEED\\\"\\n\",\"]\\n\",\"\\n\",\"seed_records = []\\n\",\"\\n\",\"for name in seed_names:\\n\",\"\\n\",\"    if name in globals():\\n\",\"\\n\",\"        value = globals()[name]\\n\",\"\\n\",\"        if isinstance(value, (int, float, str)):\\n\",\"\\n\",\"            seed_records.append({\\n\",\"              \\n\",\"\\n\",\"CELL INDEX: 119\\n\",\"MATCH CATEGORIES: model_initialization\\n\",\"SOURCE CODE:\\n\",\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 18 — STEP 17.10.4\\n\",\"# SAVED RESULTS AND OUTPUT VERIFICATION\\n\",\"# ============================================================\\n\",\"\\n\",\"import os\\n\",\"import json\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"from pathlib import Path\\n\",\"from IPython.display import display\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Define existing results directory\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"results_dir = Path(\\n\",\"    \\\"/content/drive/MyDrive/Experiment_18_Results\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"EXPERIMENT 18 — STEP 17.10.4\\\")\\n\",\"print(\\\"SAVED RESULTS AND OUTPUT VERIFICATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"assert results_dir.exists(), (\\n\",\"    f\\\"Results directory not found: {results_dir}. \\\"\\n\",\"    \\\"Check Google Drive mounting and directory path.\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n1. RESULTS DIRECTORY\\\")\\n\",\"print(\\\"Directory:\\\", results_dir)\\n\",\"print(\\\"Directory exists: YES\\\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Inventory saved files\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n2. SAVED FILE INVENTORY\\\")\\n\",\"\\n\",\"saved_files = sorted(\\n\",\"    file for file in results_dir.rglob(\\\"*\\\")\\n\",\"    if file.is_file()\\n\",\")\\n\",\"\\n\",\"file_inventory = []\\n\",\"\\n\",\"for file in saved_files:\\n\",\"\\n\",\"    size_kb = file.stat().st_size / 1024\\n\",\"\\n\",\"    file_inventory.append({\\n\",\"        \\\"File\\\": str(file.relative_to(results_dir)),\\n\",\"        \\\"Size (KB)\\\": round(size_kb, 2),\\n\",\"        \\\"Extension\\\": file.suffix.lower()\\n\",\"    })\\n\",\"\\n\",\"if file_inventory:\\n\",\"    display(pd.DataFrame(file_inventory))\\n\",\"else:\\n\",\"    print(\\\"No saved files found.\\\")\\n\",\"\\n\",\"print(\\\"Total saved files:\\\", len(saved_files))\\n\",\"\\n\",\"npz_files = [\\n\",\"    f for f in saved_files if f.suffix.lower() == \\\".npz\\\"\\n\",\"]\\n\",\"\\n\",\"npy_files = [\\n\",\"    f for f in saved_files if f.suffix.lower() == \\\".npy\\\"\\n\",\"]\\n\",\"\\n\",\"csv_files = [\\n\",\"    f for f in saved_files if f.suffix.lower() == \\\".csv\\\"\\n\",\"]\\n\",\"\\n\",\"json_files = [\\n\",\"    f for f in saved_files if f.suffix.lower() == \\\".json\\\"\\n\",\"]\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Inspect NumPy archives without modifying them\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n3. NUMPY ARCHIVE INSPECTION\\\")\\n\",\"\\n\",\"numpy_archive_records = []\\n\",\"\\n\",\"for file in npz_files:\\n\",\"\\n\",\"    print(\\\"\\\\nArchive:\\\", file.name)\\n\",\"\\n\",\"    try:\\n\",\"\\n\",\"        with np.load(file, allow_pickle=False) as archive:\\n\",\"\\n\",\"            for key in archive.files:\\n\",\"\\n\",\"                array = archive[key]\\n\",\"\\n\",\"                finite = (\\n\",\"                    bool(np.isfinite(array).all())\\n\",\"                    if np.issubdtype(array.dtype, np.number)\\n\",\"                    else None\\n\",\"                )\\n\",\"\\n\",\"                record = {\\n\",\"                    \\\"Archive\\\": file.name,\\n\",\"                    \\\"Key\\\": key,\\n\",\"                    \\\"Shape\\\": str(array.shape),\\n\",\"                    \\\"Dtype\\\": str(array.dtype),\\n\",\"                    \\\"Finite\\\": finite\\n\",\"                }\\n\",\"\\n\",\"                numpy_archive_records.append(record)\\n\",\"\\n\",\"                print(\\n\",\"                    f\\\"{key}: shape={array.shape}, \\\"\\n\",\"                    f\\\"dtype={array.dtype}, finite={finite}\\\"\\n\",\"                )\\n\",\"\\n\",\"    except Exception as error:\\n\",\"\\n\",\"        print(\\\"Archive inspection error:\\\", str(error))\\n\",\"\\n\",\"if numpy_archive_records:\\n\",\"    display(pd.DataFrame(numpy_archive_records))\\n\",\"\\n\",\"# Inspect standalone NPY files, if present.\\n\",\"\\n\",\"for file in npy_files:\\n\",\"\\n\",\"    print(\\\"\\\\nNPY file:\\\", file.name)\\n\",\"\\n\",\"    try:\\n\",\"\\n\",\"        array = np.load(file, allow_pickle=False)\\n\",\"\\n\",\"        print(\\\"Shape:\\\", array.shape)\\n\",\"        print(\\\"Dtype:\\\", array.dtype)\\n\",\"\\n\",\"        if np.issubdtype(array.dtype, np.number):\\n\",\"            print(\\\"All values finite:\\\", np.isfinite(array).all())\\n\",\"\\n\",\"    except Exception as error:\\n\",\"\\n\",\"        print(\\\"NPY inspection error:\\\", str(error))\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Verify illumination archive structure\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n4. ILLUMINATION ARCHIVE VALIDATION\\\")\\n\",\"\\n\",\"illumination_archive = (\\n\",\"    results_dir / \\\"experiment18_illumination_results.npz\\\"\\n\",\")\\n\",\"\\n\",\"if illumination_archive.exists():\\n\",\"\\n\",\"    with np.load(\\n\",\"        illumination_archive,\\n\",\"        allow_pickle=False\\n\",\"    ) as archive:\\n\",\"\\n\",\"        required_keys = [\\n\",\"            \\\"original_embeddings\\\",\\n\",\"            \\\"low_illumination_embeddings\\\",\\n\",\"            \\\"high_illumination_embeddings\\\",\\n\",\"            \\\"paired_labels\\\",\\n\",\"            \\\"common_positions\\\",\\n\",\"            \\\"low_displacement\\\",\\n\",\"            \\\"high_displacement\\\"\\n\",\"        ]\\n\",\"\\n\",\"        missing_keys = [\\n\",\"            key for key in required_keys\\n\",\"            if key not in archive.files\\n\",\"        ]\\n\",\"\\n\",\"        assert not missing_keys, (\\n\",\"            f\\\"Missing illumination archive keys: {missing_keys}\\\"\\n\",\"        )\\n\",\"\\n\",\"        expected_shapes = {\\n\",\"            \\\"original_embeddings\\\": (889, 512),\\n\",\"            \\\"low_illumination_embeddings\\\": (889, 512),\\n\",\"            \\\"high_illumination_embeddings\\\": (889, 512),\\n\",\"            \\\"paired_labels\\\": (889,),\\n\",\"            \\\"common_positions\\\": (889,),\\n\",\"            \\\"low_displacement\\\": (889,),\\n\",\"            \\\"high_displacement\\\": (889,)\\n\",\"        }\\n\",\"\\n\",\"        archive_checks = []\\n\",\"\\n\",\"        for key, expected_shape in expected_shapes.items():\\n\",\"\\n\",\"            actual = archive[key]\\n\",\"\\n\",\"            shape_passed = actual.shape == expected_shape\\n\",\"\\n\",\"            finite_passed = (\\n\",\"                np.isfinite(actual).all()\\n\",\"                if np.issubdtype(actual.dtype, np.number)\\n\",\"                else True\\n\",\"            )\\n\",\"\\n\",\"            assert shape_passed, (\\n\",\"                f\\\"{key}: expected {expected_shape}, \\\"\\n\",\"                f\\\"found {actual.shape}\\\"\\n\",\"            )\\n\",\"\\n\",\"            assert finite_passed, (\\n\",\"                f\\\"{key}: non-finite numerical values found.\\\"\\n\",\"            )\\n\",\"\\n\",\"            archive_checks.append({\\n\",\"                \\\"Array\\\": key,\\n\",\"                \\\"Actual Shape\\\": str(actual.shape),\\n\",\"                \\\"Expected Shape\\\": str(expected_shape),\\n\",\"                \\\"Status\\\": \\\"PASSED\\\"\\n\",\"            })\\n\",\"\\n\",\"        display(pd.DataFrame(archive_checks))\\n\",\"\\n\",\"        print(\\n\",\"            \\\"Full paired illumination archive validation: PASSED\\\"\\n\",\"        )\\n\",\"\\n\",\"else:\\n\",\"\\n\",\"    print(\\\"Illumination archive not found.\\\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# \\n\",\"\\n\",\"CELL INDEX: 131\\n\",\"MATCH CATEGORIES: software_versions\\n\",\"SOURCE CODE:\\n\",\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 18 — STEP 17.10.6.1\\n\",\"# EXPERIMENTAL CONFIGURATION AND EVIDENCE CONSOLIDATION\\n\",\"# ============================================================\\n\",\"\\n\",\"import os\\n\",\"import sys\\n\",\"import json\\n\",\"import platform\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"import scipy\\n\",\"import matplotlib\\n\",\"import torch\\n\",\"import torchvision\\n\",\"\\n\",\"from pathlib import Path\\n\",\"from importlib.metadata import version, PackageNotFoundError\\n\",\"\\n\",\"print(\\\"=\\\" * 80)\\n\",\"print(\\\"STEP 17.10.6.1 — EXPERIMENTAL CONFIGURATION AND EVIDENCE\\\")\\n\",\"print(\\\"=\\\" * 80)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Locate saved experiment files\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"results_dir = Path(\\n\",\"    \\\"/content/drive/MyDrive/Experiment_18_Results\\\"\\n\",\")\\n\",\"\\n\",\"assert results_dir.exists(), \\\"Experiment results directory not found.\\\"\\n\",\"\\n\",\"print(\\\"\\\\n[1] EXPERIMENT RESULTS DIRECTORY\\\")\\n\",\"print(\\\"Directory:\\\", results_dir)\\n\",\"\\n\",\"for file in sorted(results_dir.iterdir()):\\n\",\"    if file.is_file():\\n\",\"        print(\\n\",\"            f\\\"{file.name} | \\\"\\n\",\"            f\\\"{file.stat().st_size / 1024:.2f} KB\\\"\\n\",\"        )\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Load original embedding extraction evidence\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"embedding_path = (\\n\",\"    results_dir / \\\"experiment18_facenet_lfw_embeddings.npz\\\"\\n\",\")\\n\",\"\\n\",\"assert embedding_path.exists(), \\\"Original embedding NPZ not found.\\\"\\n\",\"\\n\",\"with np.load(embedding_path, allow_pickle=False) as data:\\n\",\"\\n\",\"    extraction_evidence = {}\\n\",\"\\n\",\"    for key in data.files:\\n\",\"        value = data[key]\\n\",\"\\n\",\"        if value.ndim == 0:\\n\",\"            extraction_evidence[key] = value.item()\\n\",\"\\n\",\"        else:\\n\",\"            extraction_evidence[key] = {\\n\",\"                \\\"shape\\\": value.shape,\\n\",\"                \\\"dtype\\\": str(value.dtype),\\n\",\"                \\\"finite\\\": (\\n\",\"                    bool(np.isfinite(value).all())\\n\",\"                    if np.issubdtype(value.dtype, np.number)\\n\",\"                    else \\\"N/A\\\"\\n\",\"                )\\n\",\"            }\\n\",\"\\n\",\"assert \\\"evaluation_embeddings\\\" in extraction_evidence, (\\n\",\"    \\\"Evaluation embeddings evidence is missing.\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n[2] ORIGINAL EMBEDDING EXTRACTION EVIDENCE\\\")\\n\",\"\\n\",\"for key, value in extraction_evidence.items():\\n\",\"    print(f\\\"{key}: {value}\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Load controlled illumination metadata\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"metadata_path = results_dir / \\\"illumination_metadata.json\\\"\\n\",\"\\n\",\"assert metadata_path.exists(), \\\"Illumination metadata not found.\\\"\\n\",\"\\n\",\"with open(metadata_path, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    illumination_metadata = json.load(f)\\n\",\"\\n\",\"print(\\\"\\\\n[3] CONTROLLED ILLUMINATION CONFIGURATION\\\")\\n\",\"\\n\",\"for key, value in illumination_metadata.items():\\n\",\"    print(f\\\"{key}: {value}\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Consolidate dataset and cohort characteristics\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"illumination_npz_path = (\\n\",\"    results_dir / \\\"experiment18_illumination_results.npz\\\"\\n\",\")\\n\",\"\\n\",\"assert illumination_npz_path.exists(), (\\n\",\"    \\\"Illumination results NPZ not found.\\\"\\n\",\")\\n\",\"\\n\",\"with np.load(\\n\",\"    illumination_npz_path,\\n\",\"    allow_pickle=False\\n\",\") as data:\\n\",\"\\n\",\"    original = data[\\\"original_embeddings\\\"].copy()\\n\",\"    low = data[\\\"low_illumination_embeddings\\\"].copy()\\n\",\"    high = data[\\\"high_illumination_embeddings\\\"].copy()\\n\",\"    labels = data[\\\"paired_labels\\\"].copy()\\n\",\"\\n\",\"    low_success = data[\\\"low_success\\\"].copy()\\n\",\"    high_success = data[\\\"high_success\\\"].copy()\\n\",\"\\n\",\"    low_failures = data[\\\"low_failures\\\"].copy()\\n\",\"    high_failures = data[\\\"high_failures\\\"].copy()\\n\",\"\\n\",\"\\n\",\"# Basic data integrity checks\\n\",\"assert original.shape == low.shape == high.shape, (\\n\",\"    \\\"Original, low and high embedding shapes do not match.\\\"\\n\",\")\\n\",\"\\n\",\"assert original.ndim == 2, (\\n\",\"    \\\"Embedding arrays must be two-dimensional.\\\"\\n\",\")\\n\",\"\\n\",\"assert len(labels) == original.shape[0], (\\n\",\"    \\\"Paired labels do not match the embedding count.\\\"\\n\",\")\\n\",\"\\n\",\"assert np.isfinite(original).all(), (\\n\",\"    \\\"Original embeddings contain non-finite values.\\\"\\n\",\")\\n\",\"\\n\",\"assert np.isfinite(low).all(), (\\n\",\"    \\\"Low illumination embeddings contain non-finite values.\\\"\\n\",\")\\n\",\"\\n\",\"assert np.isfinite(high).all(), (\\n\",\"    \\\"High illumination embeddings contain non-finite values.\\\"\\n\",\")\\n\",\"\\n\",\"identity_counts = (\\n\",\"    pd.Series(labels)\\n\",\"    .value_counts()\\n\",\"    .sort_index()\\n\",\")\\n\",\"\\n\",\"full_evaluation_count = (\\n\",\"    extraction_evidence[\\\"evaluation_embeddings\\\"][\\\"shape\\\"][0]\\n\",\")\\n\",\"\\n\",\"paired_image_count = len(labels)\\n\",\"identity_count = len(np.unique(labels))\\n\",\"embedding_dimension = original.shape[1]\\n\",\"\\n\",\"cohort_summary = pd.DataFrame([\\n\",\"    {\\n\",\"        \\\"Metric\\\": \\\"Original evaluation embeddings (full archive)\\\",\\n\",\"        \\\"Value\\\": full_evaluation_count\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Metric\\\": \\\"Paired illumination images (historical cohort)\\\",\\n\",\"        \\\"Value\\\": paired_image_count\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Metric\\\": \\\"Corrected detector evaluation cohort (images)\\\",\\n\",\"        \\\"Value\\\": 229\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Metric\\\": \\\"Embedding dimension\\\",\\n\",\"        \\\"Value\\\": embedding_dimension\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Metric\\\": \\\"Identities in paired illumination cohort\\\",\\n\",\"        \\\"Value\\\": identity_count\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Metric\\\": \\\"Low illumination successful detections (full archive)\\\",\\n\",\"        \\\"Value\\\": len(low_success)\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Metric\\\": \\\"High illumination successful detections (full archive)\\\",\\n\",\"        \\\"Value\\\": len(high_success)\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Metric\\\": \\\"Low illumination failures (full archive)\\\",\\n\",\"        \\\"Value\\\": len(low_failures)\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Metric\\\": \\\"High illumination failures (full archive)\\\",\\n\",\"        \\\"Value\\\": len(high_failures)\\n\",\"    }\\n\",\"])\\n\",\"\\n\",\"print(\\\"\\\\n[4] DATASET AND COHORT SUMMARY\\\")\\n\",\"display(cohort_summary)\\n\",\"\\n\",\"print(\\\"\\\\nIDENTITY DISTRIBUTION\\\")\\n\",\"\\n\",\"identity_distribution = (\\n\",\"    identity_counts\\n\",\"    .rename(\\\"Image_Count\\\")\\n\",\"    .reset_index()\\n\",\")\\n\",\"\\n\",\"identity_distribution.columns = [\\n\",\"    \\\"Identity\\\",\\n\",\"    \\\"Image_Count\\\"\\n\",\"]\\n\",\"\\n\",\"display(identity_distribution)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Record software environment\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"prin\\n\",\"\\n\",\"CELL INDEX: 138\\n\",\"MATCH CATEGORIES: model_initialization, software_versions\\n\",\"SOURCE CODE:\\n\",\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 18 — STEP 17.10.6.4\\n\",\"# RESEARCH DOCUMENTATION AND REPRODUCIBILITY AUDIT\\n\",\"# ============================================================\\n\",\"\\n\",\"import os\\n\",\"import json\\n\",\"import platform\\n\",\"import importlib.metadata as package_metadata\\n\",\"\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"import scipy\\n\",\"from scipy.stats import wilcoxon\\n\",\"\\n\",\"print(\\\"=\\\" * 85)\\n\",\"print(\\\"STEP 17.10.6.4 — RESEARCH DOCUMENTATION AND REPRODUCIBILITY AUDIT\\\")\\n\",\"print(\\\"=\\\" * 85)\\n\",\"\\n\",\"audit_results = []\\n\",\"\\n\",\"def record_audit(name, passed, details=\\\"\\\"):\\n\",\"    status = \\\"PASSED\\\" if passed else \\\"FAILED\\\"\\n\",\"    audit_results.append({\\n\",\"        \\\"Audit\\\": name,\\n\",\"        \\\"Status\\\": status,\\n\",\"        \\\"Details\\\": details\\n\",\"    })\\n\",\"    print(f\\\"[{status}] {name}\\\")\\n\",\"    if details:\\n\",\"        print(f\\\"         {details}\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Verify saved experiment files\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[1] SAVED FILE VERIFICATION\\\")\\n\",\"\\n\",\"experiment_dir = \\\"/content/drive/MyDrive/Experiment_18_Results\\\"\\n\",\"\\n\",\"expected_files = [\\n\",\"    \\\"experiment18_facenet_lfw_embeddings.npz\\\",\\n\",\"    \\\"experiment18_illumination_results.npz\\\",\\n\",\"    \\\"illumination_identity_summary.csv\\\",\\n\",\"    \\\"illumination_metadata.json\\\"\\n\",\"]\\n\",\"\\n\",\"file_paths = {\\n\",\"    filename: os.path.join(experiment_dir, filename)\\n\",\"    for filename in expected_files\\n\",\"}\\n\",\"\\n\",\"for filename, path in file_paths.items():\\n\",\"    exists = os.path.isfile(path)\\n\",\"    record_audit(\\n\",\"        f\\\"File exists: {filename}\\\",\\n\",\"        exists,\\n\",\"        path if exists else \\\"File not found\\\"\\n\",\"    )\\n\",\"\\n\",\"assert all(os.path.isfile(p) for p in file_paths.values()), (\\n\",\"    \\\"One or more required experiment files are missing. \\\"\\n\",\"    \\\"Check the Google Drive directory before continuing.\\\"\\n\",\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Load saved archives and metadata\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[2] ARCHIVE AND METADATA LOADING\\\")\\n\",\"\\n\",\"original_archive = np.load(\\n\",\"    file_paths[\\\"experiment18_facenet_lfw_embeddings.npz\\\"],\\n\",\"    allow_pickle=False\\n\",\")\\n\",\"\\n\",\"illumination_archive = np.load(\\n\",\"    file_paths[\\\"experiment18_illumination_results.npz\\\"],\\n\",\"    allow_pickle=False\\n\",\")\\n\",\"\\n\",\"identity_csv = pd.read_csv(\\n\",\"    file_paths[\\\"illumination_identity_summary.csv\\\"]\\n\",\")\\n\",\"\\n\",\"with open(\\n\",\"    file_paths[\\\"illumination_metadata.json\\\"],\\n\",\"    \\\"r\\\"\\n\",\") as file:\\n\",\"    saved_metadata = json.load(file)\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"Original embedding archive loaded\\\",\\n\",\"    True,\\n\",\"    f\\\"Keys: {list(original_archive.files)}\\\"\\n\",\")\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"Illumination archive loaded\\\",\\n\",\"    True,\\n\",\"    f\\\"Keys: {list(illumination_archive.files)}\\\"\\n\",\")\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"Identity CSV loaded\\\",\\n\",\"    True,\\n\",\"    f\\\"Rows: {len(identity_csv)}\\\"\\n\",\")\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"Metadata JSON loaded\\\",\\n\",\"    True,\\n\",\"    f\\\"Experiment: {saved_metadata.get('experiment')}\\\"\\n\",\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Verify original embedding archive\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[3] ORIGINAL EMBEDDING ARCHIVE\\\")\\n\",\"\\n\",\"original_expected_shapes = {\\n\",\"    \\\"reference_embeddings\\\": (1460, 512),\\n\",\"    \\\"reference_labels\\\": (1460,),\\n\",\"    \\\"calibration_embeddings\\\": (568, 512),\\n\",\"    \\\"calibration_labels\\\": (568,),\\n\",\"    \\\"evaluation_embeddings\\\": (956, 512),\\n\",\"    \\\"evaluation_labels\\\": (956,)\\n\",\"}\\n\",\"\\n\",\"for key, expected_shape in original_expected_shapes.items():\\n\",\"\\n\",\"    present = key in original_archive.files\\n\",\"\\n\",\"    if present:\\n\",\"        actual_shape = original_archive[key].shape\\n\",\"        shape_ok = actual_shape == expected_shape\\n\",\"    else:\\n\",\"        actual_shape = \\\"MISSING\\\"\\n\",\"        shape_ok = False\\n\",\"\\n\",\"    record_audit(\\n\",\"        f\\\"Original archive: {key}\\\",\\n\",\"        shape_ok,\\n\",\"        f\\\"Expected: {expected_shape}; Actual: {actual_shape}\\\"\\n\",\"    )\\n\",\"\\n\",\"for key in [\\n\",\"    \\\"reference_embeddings\\\",\\n\",\"    \\\"calibration_embeddings\\\",\\n\",\"    \\\"evaluation_embeddings\\\"\\n\",\"]:\\n\",\"    if key in original_archive.files:\\n\",\"        finite = np.isfinite(original_archive[key]).all()\\n\",\"\\n\",\"        record_audit(\\n\",\"            f\\\"Finite values: {key}\\\",\\n\",\"            finite\\n\",\"        )\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Verify illumination archive\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[4] ILLUMINATION ARCHIVE\\\")\\n\",\"\\n\",\"required_illumination_keys = [\\n\",\"    \\\"original_embeddings\\\",\\n\",\"    \\\"low_illumination_embeddings\\\",\\n\",\"    \\\"high_illumination_embeddings\\\",\\n\",\"    \\\"paired_labels\\\",\\n\",\"    \\\"common_positions\\\",\\n\",\"    \\\"low_displacement\\\",\\n\",\"    \\\"high_displacement\\\",\\n\",\"    \\\"low_success\\\",\\n\",\"    \\\"high_success\\\",\\n\",\"    \\\"low_failures\\\",\\n\",\"    \\\"high_failures\\\"\\n\",\"]\\n\",\"\\n\",\"for key in required_illumination_keys:\\n\",\"\\n\",\"    present = key in illumination_archive.files\\n\",\"\\n\",\"    record_audit(\\n\",\"        f\\\"Illumination key: {key}\\\",\\n\",\"        present\\n\",\"    )\\n\",\"\\n\",\"assert all(\\n\",\"    key in illumination_archive.files\\n\",\"    for key in required_illumination_keys\\n\",\"), \\\"Required illumination archive arrays are missing.\\\"\\n\",\"\\n\",\"\\n\",\"original_emb = illumination_archive[\\\"original_embeddings\\\"]\\n\",\"low_emb = illumination_archive[\\\"low_illumination_embeddings\\\"]\\n\",\"high_emb = illumination_archive[\\\"high_illumination_embeddings\\\"]\\n\",\"\\n\",\"paired_labels = illumination_archive[\\\"paired_labels\\\"]\\n\",\"\\n\",\"low_saved_displacement = illumination_archive[\\\"low_displacement\\\"]\\n\",\"high_saved_displacement = illumination_archive[\\\"high_displacement\\\"]\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"Paired embedding shapes\\\",\\n\",\"    (\\n\",\"        original_emb.shape == (889, 512)\\n\",\"        and low_emb.shape == (889, 512)\\n\",\"        and high_emb.shape == (889, 512)\\n\",\"    ),\\n\",\"    f\\\"Original: {original_emb.shape}; \\\"\\n\",\"    f\\\"Low: {low_emb.shape}; High: {high_emb.shape}\\\"\\n\",\")\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"Paired label alignment\\\",\\n\",\"    paired_labels.shape == (889,),\\n\",\"    f\\\"Labels: {paired_labels.shape}\\\"\\n\",\")\\n\",\"\\n\",\"all_finite = all([\\n\",\"    np.isfinite(original_emb).all(),\\n\",\"    np.isfinite(low_emb).all(),\\n\",\"    np.isfinite(high_emb).all(),\\n\",\"    np.isfinite(low_saved_displacement).all(),\\n\",\"    np.isfinite(high_saved_displacement).all()\\n\",\"])\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"Illumination arrays contain finite values\\\",\\n\",\"    all_finite\\n\",\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Independently reproduce embedding displacement\\n\",\"# ---------------\\n\",\"\\n\",\"CELL INDEX: 140\\n\",\"MATCH CATEGORIES: model_initialization, software_versions\\n\",\"SOURCE CODE:\\n\",\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 18 — STEP 17.10.6.5\\n\",\"# FINAL RESEARCH EVIDENCE PACKAGE\\n\",\"# Corrected version — uses validated in-memory results\\n\",\"# ============================================================\\n\",\"\\n\",\"import os\\n\",\"import sys\\n\",\"import json\\n\",\"import platform\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"import scipy\\n\",\"import torch\\n\",\"import torchvision\\n\",\"import sklearn\\n\",\"import PIL\\n\",\"\\n\",\"from datetime import datetime, timezone\\n\",\"from importlib.metadata import version, PackageNotFoundError\\n\",\"\\n\",\"\\n\",\"print(\\\"=\\\" * 80)\\n\",\"print(\\\"STEP 17.10.6.5 — FINAL RESEARCH EVIDENCE PACKAGE\\\")\\n\",\"print(\\\"=\\\" * 80)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. CONFIGURATION AND REQUIRED FILE VERIFICATION\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"RESULTS_DIR = \\\"/content/drive/MyDrive/Experiment_18_Results\\\"\\n\",\"\\n\",\"ORIGINAL_ARCHIVE = os.path.join(\\n\",\"    RESULTS_DIR,\\n\",\"    \\\"experiment18_facenet_lfw_embeddings.npz\\\"\\n\",\")\\n\",\"\\n\",\"ILLUMINATION_ARCHIVE = os.path.join(\\n\",\"    RESULTS_DIR,\\n\",\"    \\\"experiment18_illumination_results.npz\\\"\\n\",\")\\n\",\"\\n\",\"METADATA_FILE = os.path.join(\\n\",\"    RESULTS_DIR,\\n\",\"    \\\"illumination_metadata.json\\\"\\n\",\")\\n\",\"\\n\",\"CSV_FILE = os.path.join(\\n\",\"    RESULTS_DIR,\\n\",\"    \\\"illumination_identity_summary.csv\\\"\\n\",\")\\n\",\"\\n\",\"required_files = [\\n\",\"    ORIGINAL_ARCHIVE,\\n\",\"    ILLUMINATION_ARCHIVE,\\n\",\"    METADATA_FILE,\\n\",\"    CSV_FILE\\n\",\"]\\n\",\"\\n\",\"missing_files = [\\n\",\"    path for path in required_files\\n\",\"    if not os.path.isfile(path)\\n\",\"]\\n\",\"\\n\",\"assert not missing_files, (\\n\",\"    \\\"Required experiment files are missing:\\\\n\\\"\\n\",\"    + \\\"\\\\n\\\".join(missing_files)\\n\",\")\\n\",\"\\n\",\"required_variables = [\\n\",\"    \\\"evaluation_detector_df\\\",\\n\",\"    \\\"identity_detector_df\\\",\\n\",\"    \\\"statistical_results\\\",\\n\",\"    \\\"effect_size_df\\\"\\n\",\"]\\n\",\"\\n\",\"missing_variables = [\\n\",\"    name for name in required_variables\\n\",\"    if name not in globals()\\n\",\"]\\n\",\"\\n\",\"assert not missing_variables, (\\n\",\"    \\\"Required validated DataFrames are unavailable: \\\"\\n\",\"    + \\\", \\\".join(missing_variables)\\n\",\")\\n\",\"\\n\",\"for name in required_variables:\\n\",\"    assert isinstance(globals()[name], pd.DataFrame), (\\n\",\"        f\\\"{name} is not a DataFrame.\\\"\\n\",\"    )\\n\",\"\\n\",\"print(\\\"Section 1: Required files and detector tables verified.\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. LOAD EXISTING EXPERIMENT OUTPUTS\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"with np.load(\\n\",\"    ORIGINAL_ARCHIVE,\\n\",\"    allow_pickle=False\\n\",\") as original_data:\\n\",\"\\n\",\"    original_shapes = {\\n\",\"        key: list(original_data[key].shape)\\n\",\"        for key in original_data.files\\n\",\"    }\\n\",\"\\n\",\"with np.load(\\n\",\"    ILLUMINATION_ARCHIVE,\\n\",\"    allow_pickle=False\\n\",\") as illumination_data:\\n\",\"\\n\",\"    illumination_shapes = {\\n\",\"        key: list(illumination_data[key].shape)\\n\",\"        for key in illumination_data.files\\n\",\"    }\\n\",\"\\n\",\"    original_embeddings = illumination_data[\\n\",\"        \\\"original_embeddings\\\"\\n\",\"    ].copy()\\n\",\"\\n\",\"    low_embeddings = illumination_data[\\n\",\"        \\\"low_illumination_embeddings\\\"\\n\",\"    ].copy()\\n\",\"\\n\",\"    high_embeddings = illumination_data[\\n\",\"        \\\"high_illumination_embeddings\\\"\\n\",\"    ].copy()\\n\",\"\\n\",\"    paired_labels = illumination_data[\\n\",\"        \\\"paired_labels\\\"\\n\",\"    ].copy()\\n\",\"\\n\",\"    saved_low_displacement = illumination_data[\\n\",\"        \\\"low_displacement\\\"\\n\",\"    ].copy()\\n\",\"\\n\",\"    saved_high_displacement = illumination_data[\\n\",\"        \\\"high_displacement\\\"\\n\",\"    ].copy()\\n\",\"\\n\",\"with open(METADATA_FILE, \\\"r\\\", encoding=\\\"utf-8\\\") as file:\\n\",\"    metadata = json.load(file)\\n\",\"\\n\",\"identity_csv = pd.read_csv(CSV_FILE)\\n\",\"\\n\",\"print(\\\"Section 2: Existing archives and metadata loaded.\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. DATASET COMPOSITION\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"assert original_embeddings.shape == low_embeddings.shape\\n\",\"assert original_embeddings.shape == high_embeddings.shape\\n\",\"assert original_embeddings.ndim == 2\\n\",\"assert original_embeddings.shape[0] == len(paired_labels)\\n\",\"assert original_embeddings.shape[1] == 512\\n\",\"\\n\",\"assert np.isfinite(original_embeddings).all()\\n\",\"assert np.isfinite(low_embeddings).all()\\n\",\"assert np.isfinite(high_embeddings).all()\\n\",\"\\n\",\"identity_values, identity_counts = np.unique(\\n\",\"    paired_labels,\\n\",\"    return_counts=True\\n\",\")\\n\",\"\\n\",\"identity_distribution = [\\n\",\"    {\\n\",\"        \\\"identity\\\": int(identity),\\n\",\"        \\\"paired_image_count\\\": int(count)\\n\",\"    }\\n\",\"    for identity, count in zip(\\n\",\"        identity_values,\\n\",\"        identity_counts\\n\",\"    )\\n\",\"]\\n\",\"\\n\",\"paired_images = int(len(paired_labels))\\n\",\"identity_count = int(len(identity_values))\\n\",\"embedding_dimension = int(original_embeddings.shape[1])\\n\",\"\\n\",\"largest_identity_index = int(np.argmax(identity_counts))\\n\",\"\\n\",\"largest_identity = int(\\n\",\"    identity_values[largest_identity_index]\\n\",\")\\n\",\"\\n\",\"largest_identity_count = int(\\n\",\"    identity_counts[largest_identity_index]\\n\",\")\\n\",\"\\n\",\"largest_identity_share = (\\n\",\"    largest_identity_count / paired_images\\n\",\")\\n\",\"\\n\",\"assert paired_images == 889\\n\",\"assert identity_count == 13\\n\",\"\\n\",\"print(\\\"\\\\nSection 3: Dataset composition verified.\\\")\\n\",\"print(\\\"Paired images:\\\", paired_images)\\n\",\"print(\\\"Identities:\\\", identity_count)\\n\",\"print(\\\"Embedding dimension:\\\", embedding_dimension)\\n\",\"print(\\\"Largest identity:\\\", largest_identity)\\n\",\"print(\\\"Largest identity share:\\\", f\\\"{largest_identity_share:.2%}\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. REPRODUCE SAVED EMBEDDING DISPLACEMENTS\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"recalculated_low = np.linalg.norm(\\n\",\"    low_embeddings - original_embeddings,\\n\",\"    axis=1\\n\",\")\\n\",\"\\n\",\"recalculated_high = np.linalg.norm(\\n\",\"    high_embeddings - original_embeddings,\\n\",\"    axis=1\\n\",\")\\n\",\"\\n\",\"low_max_error = float(\\n\",\"    np.max(\\n\",\"        np.abs(\\n\",\"            recalculated_low - saved_low_displacement\\n\",\"        )\\n\",\"    )\\n\",\")\\n\",\"\\n\",\"high_max_error = float(\\n\",\"    np.max(\\n\",\"        np.abs(\\n\",\"            recalculated_high - saved_high_displacement\\n\",\"        )\\n\",\"    )\\n\",\")\\n\",\"\\n\",\"assert low_max_error == 0.0, (\\n\",\"    \\\"Low-illumination displacement reproduction failed.\\\"\\n\",\")\\n\",\"\\n\",\"assert high_max_error == 0.0, (\\n\",\"    \\\"High-illumination displacement reproduction failed.\\\"\\n\",\")\\n\",\"\\n\",\"displacement_summary = {\\n\",\"    \\\"low_illumination\\\": {\\n\",\"        \\\"mean\\\": float(np.mean(saved_low_displacement)),\\n\",\"        \\\"median\\\": float(np.median(saved_low_displacement)),\\n\",\"        \\\"standard_deviation\\\": float(\\n\",\"            np.std(saved_low_displacement)\\n\",\"        \\n\",\"\\n\",\"====================================================================================================\\n\",\"INSPECTION SUMMARY\\n\",\"====================================================================================================\\n\",\"Notebooks discovered: 25\\n\",\"Matching code cells: 109\\n\",\"Notebook files modified: NO\\n\",\"Notebook cells executed: NO\\n\",\"====================================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.1.10\\n\",\"## Resize Interpolation and Model Weight Availability Verification\\n\",\"\\n\",\"### Objectives\\n\",\"\\n\",\"1. Inspect the installed torchvision Resize API.\\n\",\"2. Identify its default interpolation setting.\\n\",\"3. Verify the recorded torchvision version.\\n\",\"4. Inspect common local cache locations for FaceNet model weights.\\n\",\"5. If a candidate weight file exists, calculate its SHA-256 checksum.\\n\",\"\\n\",\"### Restrictions\\n\",\"\\n\",\"- Do not download model weights.\\n\",\"- Do not regenerate embeddings.\\n\",\"- Do not modify existing experiment artifacts.\\n\",\"- Do not install packages.\\n\",\"- Do not assume a cached file belongs to Experiment 20 without supporting evidence.\\n\",\"\\n\",\"### Expected outcome\\n\",\"\\n\",\"Establish whether the implicit Resize interpolation can be documented from the recorded software version and whether the exact model-weight file can be independently identified.\"],\"metadata\":{\"id\":\"5ae5BPtiwRry\"}},{\"cell_type\":\"code\",\"source\":[\"import inspect\\n\",\"import hashlib\\n\",\"import importlib.metadata\\n\",\"from pathlib import Path\\n\",\"\\n\",\"print(\\\"=\\\" * 85)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.1.10\\\")\\n\",\"print(\\\"RESIZE DEFAULT AND MODEL WEIGHT AVAILABILITY\\\")\\n\",\"print(\\\"=\\\" * 85)\\n\",\"\\n\",\"# --------------------------------------------------\\n\",\"# 1. Inspect torchvision\\n\",\"# --------------------------------------------------\\n\",\"\\n\",\"try:\\n\",\"    import torchvision\\n\",\"    from torchvision import transforms\\n\",\"\\n\",\"    print(\\\"\\\\n[1] TORCHVISION VERSION\\\")\\n\",\"    print(\\\"Installed version:\\\", torchvision.__version__)\\n\",\"\\n\",\"    resize_signature = inspect.signature(\\n\",\"        transforms.Resize\\n\",\"    )\\n\",\"\\n\",\"    print(\\\"\\\\nResize API signature:\\\")\\n\",\"    print(resize_signature)\\n\",\"\\n\",\"    resize_default = resize_signature.parameters[\\n\",\"        \\\"interpolation\\\"\\n\",\"    ].default\\n\",\"\\n\",\"    print(\\\"\\\\nDefault interpolation object:\\\")\\n\",\"    print(resize_default)\\n\",\"\\n\",\"    print(\\\"Default interpolation name:\\\")\\n\",\"    print(getattr(resize_default, \\\"name\\\", str(resize_default)))\\n\",\"\\n\",\"except Exception as exc:\\n\",\"    print(\\\"\\\\nTorchvision inspection failed:\\\")\\n\",\"    print(repr(exc))\\n\",\"\\n\",\"# --------------------------------------------------\\n\",\"# 2. Compare recorded version\\n\",\"# --------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[2] RECORDED GENERATION SOFTWARE\\\")\\n\",\"\\n\",\"recorded_versions = {\\n\",\"    \\\"Python\\\": \\\"3.13.18\\\",\\n\",\"    \\\"PyTorch\\\": \\\"2.14.1+cpu\\\",\\n\",\"    \\\"torchvision\\\": \\\"0.29.1+cpu\\\",\\n\",\"    \\\"facenet-pytorch\\\": \\\"2.6.0\\\"\\n\",\"}\\n\",\"\\n\",\"for package, version in recorded_versions.items():\\n\",\"    print(f\\\"{package}: {version}\\\")\\n\",\"\\n\",\"# --------------------------------------------------\\n\",\"# 3. Inspect possible cached model weights\\n\",\"# --------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[3] LOCAL MODEL WEIGHT CACHE INSPECTION\\\")\\n\",\"\\n\",\"candidate_roots = [\\n\",\"    Path(\\\"/root/.cache/torch\\\"),\\n\",\"    Path(\\\"/root/.cache/torch/checkpoints\\\"),\\n\",\"    Path(\\\"/root/.cache\\\"),\\n\",\"    Path(\\\"/root/.keras-facenet\\\"),\\n\",\"    Path(\\\"/content\\\")\\n\",\"]\\n\",\"\\n\",\"extensions = {\\\".pth\\\", \\\".pt\\\", \\\".ckpt\\\", \\\".h5\\\"}\\n\",\"\\n\",\"candidates = set()\\n\",\"\\n\",\"for root in candidate_roots:\\n\",\"    if not root.exists():\\n\",\"        continue\\n\",\"\\n\",\"    try:\\n\",\"        for path in root.rglob(\\\"*\\\"):\\n\",\"            if (\\n\",\"                path.is_file()\\n\",\"                and path.suffix.lower() in extensions\\n\",\"                and any(\\n\",\"                    term in path.name.lower()\\n\",\"                    for term in [\\\"facenet\\\", \\\"inception\\\", \\\"vggface\\\"]\\n\",\"                )\\n\",\"            ):\\n\",\"                candidates.add(path)\\n\",\"\\n\",\"    except (PermissionError, OSError):\\n\",\"        continue\\n\",\"\\n\",\"if not candidates:\\n\",\"    print(\\\"No matching local FaceNet weight files found.\\\")\\n\",\"\\n\",\"else:\\n\",\"    for path in sorted(candidates):\\n\",\"        print(\\\"\\\\nCandidate:\\\", path)\\n\",\"        print(\\\"Size:\\\", path.stat().st_size, \\\"bytes\\\")\\n\",\"\\n\",\"        digest = hashlib.sha256()\\n\",\"\\n\",\"        with path.open(\\\"rb\\\") as file:\\n\",\"            for chunk in iter(\\n\",\"                lambda: file.read(1024 * 1024),\\n\",\"                b\\\"\\\"\\n\",\"            ):\\n\",\"                digest.update(chunk)\\n\",\"\\n\",\"        print(\\\"SHA-256:\\\", digest.hexdigest())\\n\",\"\\n\",\"# --------------------------------------------------\\n\",\"# 4. Final status\\n\",\"# --------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 85)\\n\",\"print(\\\"STEP 3.1.10 INSPECTION SUMMARY\\\")\\n\",\"print(\\\"=\\\" * 85)\\n\",\"\\n\",\"print(\\\"Resize invocation in original notebook:\\\")\\n\",\"print(\\\"transforms.Resize((160, 160))\\\")\\n\",\"\\n\",\"print(\\\"Interpolation explicitly specified: NO\\\")\\n\",\"print(\\\"Model initialization: InceptionResnetV1(pretrained='vggface2')\\\")\\n\",\"print(\\\"Embedding regeneration: NO\\\")\\n\",\"print(\\\"Existing experiment artifacts modified: NO\\\")\\n\",\"\\n\",\"print(\\\"=\\\" * 85)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"6Q0AZ5FNwUGZ\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794386267564,\"user_tz\":360,\"elapsed\":16997,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"a5d84e14-0f93-4125-b36a-e043314e31e6\"},\"execution_count\":16,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"=====================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.1.10\\n\",\"RESIZE DEFAULT AND MODEL WEIGHT AVAILABILITY\\n\",\"=====================================================================================\\n\",\"\\n\",\"[1] TORCHVISION VERSION\\n\",\"Installed version: 0.29.1+cpu\\n\",\"\\n\",\"Resize API signature:\\n\",\"(size, interpolation=<InterpolationMode.BILINEAR: 'bilinear'>, max_size=None, antialias=True)\\n\",\"\\n\",\"Default interpolation object:\\n\",\"InterpolationMode.BILINEAR\\n\",\"Default interpolation name:\\n\",\"BILINEAR\\n\",\"\\n\",\"[2] RECORDED GENERATION SOFTWARE\\n\",\"Python: 3.13.18\\n\",\"PyTorch: 2.14.1+cpu\\n\",\"torchvision: 0.29.1+cpu\\n\",\"facenet-pytorch: 2.6.0\\n\",\"\\n\",\"[3] LOCAL MODEL WEIGHT CACHE INSPECTION\\n\",\"No matching local FaceNet weight files found.\\n\",\"\\n\",\"=====================================================================================\\n\",\"STEP 3.1.10 INSPECTION SUMMARY\\n\",\"=====================================================================================\\n\",\"Resize invocation in original notebook:\\n\",\"transforms.Resize((160, 160))\\n\",\"Interpolation explicitly specified: NO\\n\",\"Model initialization: InceptionResnetV1(pretrained='vggface2')\\n\",\"Embedding regeneration: NO\\n\",\"Existing experiment artifacts modified: NO\\n\",\"=====================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.1.11\\n\",\"## Holm Multiple-Comparison Family Sensitivity Analysis\\n\",\"\\n\",\"### Objective\\n\",\"Compare two Holm correction strategies using the frozen\\n\",\"paired comparison results:\\n\",\"\\n\",\"1. Separate three-comparison families for Euclidean and cosine distance.\\n\",\"2. One family containing all six comparisons.\\n\",\"\\n\",\"### Source\\n\",\"step_2_7/final_freeze/experiment20_paired_comparison_results.csv\\n\",\"\\n\",\"### Restrictions\\n\",\"- Use the frozen raw p-values.\\n\",\"- Do not recompute Wilcoxon tests.\\n\",\"- Do not modify frozen results.\\n\",\"- Do not overwrite original statistical outputs.\\n\",\"- Save the sensitivity analysis separately.\\n\",\"\\n\",\"### Decision\\n\",\"The analysis compares both correction strategies.\\n\",\"The final correction family requires methodological justification.\"],\"metadata\":{\"id\":\"8VzAQrhkwjNC\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import pandas as pd\\n\",\"import json\\n\",\"from datetime import datetime, timezone\\n\",\"from statsmodels.stats.multitest import multipletests\\n\",\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 20 — STEP 3.1.11\\n\",\"# HOLM CORRECTION FAMILY SENSITIVITY ANALYSIS\\n\",\"# ============================================================\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"\\n\",\"INPUT_FILE = (\\n\",\"    BASE / \\\"step_2_7\\\" / \\\"final_freeze\\\" /\\n\",\"    \\\"experiment20_paired_comparison_results.csv\\\"\\n\",\")\\n\",\"\\n\",\"OUTPUT_DIR = BASE / \\\"step_3_1\\\"\\n\",\"OUTPUT_FILE = (\\n\",\"    OUTPUT_DIR /\\n\",\"    \\\"experiment20_step311_holm_family_sensitivity.json\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"=\\\" * 90)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.1.11\\\")\\n\",\"print(\\\"HOLM MULTIPLE-COMPARISON FAMILY SENSITIVITY ANALYSIS\\\")\\n\",\"print(\\\"=\\\" * 90)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Verify frozen input\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"if not INPUT_FILE.exists():\\n\",\"    raise FileNotFoundError(\\n\",\"        f\\\"Frozen paired comparison file not found: {INPUT_FILE}\\\"\\n\",\"    )\\n\",\"\\n\",\"df = pd.read_csv(INPUT_FILE)\\n\",\"\\n\",\"print(\\\"\\\\n[1] INPUT FILE\\\")\\n\",\"print(INPUT_FILE)\\n\",\"\\n\",\"print(\\\"\\\\n[2] SOURCE COLUMNS\\\")\\n\",\"print(df.columns.tolist())\\n\",\"\\n\",\"print(\\\"\\\\n[3] SOURCE DATA\\\")\\n\",\"print(df.to_string(index=False))\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Identify columns without assuming exact naming\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"def identify_column(columns, candidates, description):\\n\",\"    matches = [\\n\",\"        col for col in columns\\n\",\"        if col.strip().lower() in candidates\\n\",\"    ]\\n\",\"\\n\",\"    if len(matches) != 1:\\n\",\"        raise ValueError(\\n\",\"            f\\\"Cannot uniquely identify {description}.\\\\n\\\"\\n\",\"            f\\\"Candidates found: {matches}\\\\n\\\"\\n\",\"            f\\\"Available columns: {list(columns)}\\\"\\n\",\"        )\\n\",\"\\n\",\"    return matches[0]\\n\",\"\\n\",\"\\n\",\"metric_col = identify_column(\\n\",\"    df.columns,\\n\",\"    {\\\"metric\\\", \\\"outcome\\\"},\\n\",\"    \\\"metric column\\\"\\n\",\")\\n\",\"\\n\",\"p_col = identify_column(\\n\",\"    df.columns,\\n\",\"    {\\n\",\"        \\\"raw_p\\\",\\n\",\"        \\\"raw_p_value\\\",\\n\",\"        \\\"p_value\\\",\\n\",\"        \\\"pvalue\\\",\\n\",\"        \\\"p\\\"\\n\",\"    },\\n\",\"    \\\"raw p-value column\\\"\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Validate input\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"df[p_col] = pd.to_numeric(df[p_col], errors=\\\"raise\\\")\\n\",\"\\n\",\"if len(df) != 6:\\n\",\"    raise ValueError(\\n\",\"        f\\\"Expected 6 pairwise comparisons; found {len(df)}.\\\"\\n\",\"    )\\n\",\"\\n\",\"if df[p_col].isna().any():\\n\",\"    raise ValueError(\\\"Missing p-values detected.\\\")\\n\",\"\\n\",\"if ((df[p_col] < 0) | (df[p_col] > 1)).any():\\n\",\"    raise ValueError(\\\"Invalid p-values detected.\\\")\\n\",\"\\n\",\"if df[metric_col].nunique() != 2:\\n\",\"    raise ValueError(\\\"Expected exactly two metrics.\\\")\\n\",\"\\n\",\"if not df.groupby(metric_col).size().eq(3).all():\\n\",\"    raise ValueError(\\n\",\"        \\\"Expected three comparisons for each metric.\\\"\\n\",\"    )\\n\",\"\\n\",\"print(\\\"\\\\n[4] INPUT VALIDATION\\\")\\n\",\"print(\\\"Six comparisons: PASS\\\")\\n\",\"print(\\\"Two metrics: PASS\\\")\\n\",\"print(\\\"Three comparisons per metric: PASS\\\")\\n\",\"print(\\\"P-values valid: PASS\\\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Existing metric-wise Holm correction\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"df[\\\"holm_metric_wise\\\"] = float(\\\"nan\\\")\\n\",\"\\n\",\"for metric, group in df.groupby(metric_col, sort=False):\\n\",\"    indices = group.index.tolist()\\n\",\"\\n\",\"    adjusted = multipletests(\\n\",\"        group[p_col].to_numpy(),\\n\",\"        method=\\\"holm\\\"\\n\",\"    )[1]\\n\",\"\\n\",\"    df.loc[indices, \\\"holm_metric_wise\\\"] = adjusted\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Single six-comparison Holm correction\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"df[\\\"holm_six_comparisons\\\"] = multipletests(\\n\",\"    df[p_col].to_numpy(),\\n\",\"    method=\\\"holm\\\"\\n\",\")[1]\\n\",\"\\n\",\"df[\\\"significant_metric_wise\\\"] = (\\n\",\"    df[\\\"holm_metric_wise\\\"] < 0.05\\n\",\")\\n\",\"\\n\",\"df[\\\"significant_six_family\\\"] = (\\n\",\"    df[\\\"holm_six_comparisons\\\"] < 0.05\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. Display comparison\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"display_columns = [\\n\",\"    metric_col,\\n\",\"    p_col,\\n\",\"    \\\"holm_metric_wise\\\",\\n\",\"    \\\"holm_six_comparisons\\\",\\n\",\"    \\\"significant_metric_wise\\\",\\n\",\"    \\\"significant_six_family\\\"\\n\",\"]\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 90)\\n\",\"print(\\\"[5] HOLM CORRECTION COMPARISON\\\")\\n\",\"print(\\\"=\\\" * 90)\\n\",\"\\n\",\"print(df[display_columns].to_string(index=False))\\n\",\"\\n\",\"print(\\\"\\\\nSIGNIFICANCE COUNTS\\\")\\n\",\"print(\\n\",\"    \\\"Metric-wise families:\\\",\\n\",\"    int(df[\\\"significant_metric_wise\\\"].sum()),\\n\",\"    \\\"/ 6\\\"\\n\",\")\\n\",\"print(\\n\",\"    \\\"Single six-comparison family:\\\",\\n\",\"    int(df[\\\"significant_six_family\\\"].sum()),\\n\",\"    \\\"/ 6\\\"\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. Save separate sensitivity report\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"report = {\\n\",\"    \\\"experiment\\\": 20,\\n\",\"    \\\"step\\\": \\\"3.1.11\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"input_file\\\": str(INPUT_FILE),\\n\",\"    \\\"metric_column\\\": metric_col,\\n\",\"    \\\"raw_p_value_column\\\": p_col,\\n\",\"    \\\"comparison_count\\\": int(len(df)),\\n\",\"    \\\"alpha\\\": 0.05,\\n\",\"    \\\"metric_wise_family_sizes\\\": {\\n\",\"        str(metric): int(count)\\n\",\"        for metric, count in\\n\",\"        df.groupby(metric_col).size().items()\\n\",\"    },\\n\",\"    \\\"six_comparison_family_size\\\": 6,\\n\",\"    \\\"results\\\": df[display_columns].to_dict(orient=\\\"records\\\"),\\n\",\"    \\\"significant_count_metric_wise\\\": int(\\n\",\"        df[\\\"significant_metric_wise\\\"].sum()\\n\",\"    ),\\n\",\"    \\\"significant_count_six_family\\\": int(\\n\",\"        df[\\\"significant_six_family\\\"].sum()\\n\",\"    ),\\n\",\"    \\\"decision\\\": \\\"NOT_SELECTED\\\",\\n\",\"    \\\"interpretation\\\": (\\n\",\"        \\\"Both correction strategies were calculated from \\\"\\n\",\"        \\\"the six frozen raw p-values. The final correction \\\"\\n\",\"        \\\"family requires methodological justification.\\\"\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"with OUTPUT_FILE.open(\\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    json.dump(report, f, indent=2, default=str)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 8. Reload and verify\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"with OUTPUT_FILE.open(\\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    verified = json.load(f)\\n\",\"\\n\",\"assert verified[\\\"comparison_count\\\"] == 6\\n\",\"assert len(verified[\\\"results\\\"]) == 6\\n\",\"assert verified[\\\"decision\\\"] == \\\"NOT_SELECTED\\\"\\n\",\"\\n\",\"print(\\\"\\\\n[6] OUTPUT VALIDATION\\\")\\n\",\"print(\\\"JSON reload: PASS\\\")\\n\",\"print(\\\"Six comparisons preserved: PASS\\\")\\n\",\"print(\\\"Original frozen CSV modified: NO\\\")\\n\",\"print(\\\"Saved report:\\\", OUTPUT_FILE)\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 90)\\n\",\"print(\\\"STEP 3.1.11 COMPLETED\\\")\\n\",\"print(\\\"=\\\" * 90)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"SP-v8mqlwlRl\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794386458349,\"user_tz\":360,\"elapsed\":1526,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"e46b79b1-f463-4867-b475-48cd4e2c49bd\"},\"execution_count\":19,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"==========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.1.11\\n\",\"HOLM MULTIPLE-COMPARISON FAMILY SENSITIVITY ANALYSIS\\n\",\"==========================================================================================\\n\",\"\\n\",\"[1] INPUT FILE\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_2_7/final_freeze/experiment20_paired_comparison_results.csv\\n\",\"\\n\",\"[2] SOURCE COLUMNS\\n\",\"['metric', 'metric_label', 'group_a', 'group_b', 'identities', 'mean_group_a', 'mean_group_b', 'mean_paired_difference_b_minus_a', 'median_paired_difference_b_minus_a', 'wilcoxon_statistic', 'raw_p_value', 'holm_adjusted_p_value', 'significant_after_holm_0_05', 'ci_95_lower', 'ci_95_upper', 'bootstrap_iterations', 'random_seed']\\n\",\"\\n\",\"[3] SOURCE DATA\\n\",\"        metric           metric_label      group_a                 group_b  identities  mean_group_a  mean_group_b  mean_paired_difference_b_minus_a  median_paired_difference_b_minus_a  wilcoxon_statistic  raw_p_value  holm_adjusted_p_value  significant_after_holm_0_05  ci_95_lower  ci_95_upper  bootstrap_iterations  random_seed\\n\",\"euclidean_mean Euclidean displacement near_frontal                 oblique          38      0.401897      0.708976                          0.307079                            0.297842                   0 7.275958e-12           2.182787e-11                         True     0.285544     0.328413                 20000      2026274\\n\",\"euclidean_mean Euclidean displacement near_frontal large_angular_deviation          38      0.401897      1.118457                          0.716560                            0.727658                   0 7.275958e-12           2.182787e-11                         True     0.691110     0.741689                 20000      2026274\\n\",\"euclidean_mean Euclidean displacement      oblique large_angular_deviation          38      0.708976      1.118457                          0.409481                            0.399250                   0 7.275958e-12           2.182787e-11                         True     0.387346     0.431761                 20000      2026274\\n\",\"   cosine_mean        Cosine distance near_frontal                 oblique          38      0.086877      0.262274                          0.175397                            0.176328                   0 7.275958e-12           2.182787e-11                         True     0.159082     0.191703                 20000      2026274\\n\",\"   cosine_mean        Cosine distance near_frontal large_angular_deviation          38      0.086877      0.649095                          0.562219                            0.556245                   0 7.275958e-12           2.182787e-11                         True     0.536391     0.588301                 20000      2026274\\n\",\"   cosine_mean        Cosine distance      oblique large_angular_deviation          38      0.262274      0.649095                          0.386821                            0.379792                   0 7.275958e-12           2.182787e-11                         True     0.364906     0.408321                 20000      2026274\\n\",\"\\n\",\"[4] INPUT VALIDATION\\n\",\"Six comparisons: PASS\\n\",\"Two metrics: PASS\\n\",\"Three comparisons per metric: PASS\\n\",\"P-values valid: PASS\\n\",\"\\n\",\"==========================================================================================\\n\",\"[5] HOLM CORRECTION COMPARISON\\n\",\"==========================================================================================\\n\",\"        metric  raw_p_value  holm_metric_wise  holm_six_comparisons  significant_metric_wise  significant_six_family\\n\",\"euclidean_mean 7.275958e-12      2.182787e-11          4.365575e-11                     True                    True\\n\",\"euclidean_mean 7.275958e-12      2.182787e-11          4.365575e-11                     True                    True\\n\",\"euclidean_mean 7.275958e-12      2.182787e-11          4.365575e-11                     True                    True\\n\",\"   cosine_mean 7.275958e-12      2.182787e-11          4.365575e-11                     True                    True\\n\",\"   cosine_mean 7.275958e-12      2.182787e-11          4.365575e-11                     True                    True\\n\",\"   cosine_mean 7.275958e-12      2.182787e-11          4.365575e-11                     True                    True\\n\",\"\\n\",\"SIGNIFICANCE COUNTS\\n\",\"Metric-wise families: 6 / 6\\n\",\"Single six-comparison family: 6 / 6\\n\",\"\\n\",\"[6] OUTPUT VALIDATION\\n\",\"JSON reload: PASS\\n\",\"Six comparisons preserved: PASS\\n\",\"Original frozen CSV modified: NO\\n\",\"Saved report: /content/drive/MyDrive/Experiment_20_Results/step_3_1/experiment20_step311_holm_family_sensitivity.json\\n\",\"\\n\",\"==========================================================================================\\n\",\"STEP 3.1.11 COMPLETED\\n\",\"==========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.1.12\\n\",\"## Decision Register Review and Statistical Correction Decision\\n\",\"\\n\",\"### Objective\\n\",\"Inspect the existing unresolved-decision register and determine\\n\",\"the exact fields required to record the final Holm correction decision.\\n\",\"\\n\",\"### Decision to record\\n\",\"Use one six-comparison Holm correction family for the six\\n\",\"pairwise comparisons across Euclidean displacement and\\n\",\"cosine distance.\\n\",\"\\n\",\"### Supporting evidence\\n\",\"- Frozen pairwise comparison CSV.\\n\",\"- Step 3.1.11 Holm family sensitivity analysis.\\n\",\"- Six comparisons remain significant under both correction strategies.\\n\",\"\\n\",\"### Restrictions\\n\",\"- Read-only inspection.\\n\",\"- Do not modify the existing decision register yet.\\n\",\"- Preserve all other unresolved decisions.\"],\"metadata\":{\"id\":\"VdWmjUOSxRaL\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"\\n\",\"REGISTER_FILE = (\\n\",\"    BASE / \\\"step_3_1\\\" /\\n\",\"    \\\"experiment20_step317_unresolved_decisions.json\\\"\\n\",\")\\n\",\"\\n\",\"SENSITIVITY_FILE = (\\n\",\"    BASE / \\\"step_3_1\\\" /\\n\",\"    \\\"experiment20_step311_holm_family_sensitivity.json\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"=\\\" * 90)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.1.12\\\")\\n\",\"print(\\\"DECISION REGISTER READ-ONLY INSPECTION\\\")\\n\",\"print(\\\"=\\\" * 90)\\n\",\"\\n\",\"for path in [REGISTER_FILE, SENSITIVITY_FILE]:\\n\",\"    print(\\\"\\\\nFile:\\\", path)\\n\",\"    print(\\\"Exists:\\\", path.exists())\\n\",\"\\n\",\"    if not path.exists():\\n\",\"        raise FileNotFoundError(path)\\n\",\"\\n\",\"with REGISTER_FILE.open(\\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    register = json.load(f)\\n\",\"\\n\",\"with SENSITIVITY_FILE.open(\\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    sensitivity = json.load(f)\\n\",\"\\n\",\"print(\\\"\\\\n[1] CURRENT DECISION REGISTER\\\")\\n\",\"print(json.dumps(register, indent=2))\\n\",\"\\n\",\"print(\\\"\\\\n[2] STEP 3.1.11 STATISTICAL DECISION EVIDENCE\\\")\\n\",\"\\n\",\"print(\\\"Comparisons:\\\", sensitivity[\\\"comparison_count\\\"])\\n\",\"print(\\\"Metric-wise significant:\\\",\\n\",\"      sensitivity[\\\"significant_count_metric_wise\\\"])\\n\",\"print(\\\"Six-family significant:\\\",\\n\",\"      sensitivity[\\\"significant_count_six_family\\\"])\\n\",\"\\n\",\"print(\\\"\\\\n[3] SIX-FAMILY ADJUSTED P-VALUES\\\")\\n\",\"\\n\",\"for result in sensitivity[\\\"results\\\"]:\\n\",\"    print({\\n\",\"        \\\"metric\\\": result[sensitivity[\\\"metric_column\\\"]],\\n\",\"        \\\"raw_p\\\": result[sensitivity[\\\"raw_p_value_column\\\"]],\\n\",\"        \\\"holm_six_comparisons\\\": result[\\\"holm_six_comparisons\\\"],\\n\",\"        \\\"significant\\\": result[\\\"significant_six_family\\\"]\\n\",\"    })\\n\",\"\\n\",\"print(\\\"\\\\n[4] REGISTER STRUCTURE\\\")\\n\",\"print(\\\"Top-level type:\\\", type(register).__name__)\\n\",\"\\n\",\"if isinstance(register, dict):\\n\",\"    print(\\\"Top-level keys:\\\", list(register.keys()))\\n\",\"\\n\",\"print(\\\"\\\\nNo files modified.\\\")\\n\",\"print(\\\"=\\\" * 90)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"NV_hAuPwxUGt\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794386512424,\"user_tz\":360,\"elapsed\":82,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"0501679b-2994-4ceb-c1ae-aac961c11942\"},\"execution_count\":20,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"==========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.1.12\\n\",\"DECISION REGISTER READ-ONLY INSPECTION\\n\",\"==========================================================================================\\n\",\"\\n\",\"File: /content/drive/MyDrive/Experiment_20_Results/step_3_1/experiment20_step317_unresolved_decisions.json\\n\",\"Exists: True\\n\",\"\\n\",\"File: /content/drive/MyDrive/Experiment_20_Results/step_3_1/experiment20_step311_holm_family_sensitivity.json\\n\",\"Exists: True\\n\",\"\\n\",\"[1] CURRENT DECISION REGISTER\\n\",\"{\\n\",\"  \\\"experiment\\\": 20,\\n\",\"  \\\"step\\\": \\\"3.1.7\\\",\\n\",\"  \\\"timestamp_utc\\\": \\\"2026-11-11T08:39:09.530795+00:00\\\",\\n\",\"  \\\"decision_count\\\": 5,\\n\",\"  \\\"decisions\\\": [\\n\",\"    {\\n\",\"      \\\"id\\\": \\\"D01\\\",\\n\",\"      \\\"decision\\\": \\\"Multiple-comparison correction family\\\",\\n\",\"      \\\"current_status\\\": \\\"UNRESOLVED\\\",\\n\",\"      \\\"current_analysis\\\": \\\"Holm correction applied separately to three pairwise comparisons for each metric.\\\",\\n\",\"      \\\"required_action\\\": \\\"Justify the two metric-wise outcome families or recalculate using one six-comparison family.\\\",\\n\",\"      \\\"blocks_manuscript_submission\\\": true\\n\",\"    },\\n\",\"    {\\n\",\"      \\\"id\\\": \\\"D02\\\",\\n\",\"      \\\"decision\\\": \\\"Resize interpolation method\\\",\\n\",\"      \\\"current_status\\\": \\\"NOT_FULLY_DOCUMENTED\\\",\\n\",\"      \\\"current_analysis\\\": \\\"Images resized to 160x160; interpolation method not established in the reviewed records.\\\",\\n\",\"      \\\"required_action\\\": \\\"Recover the interpolation method from the original execution environment if possible; otherwise disclose it as unavailable.\\\",\\n\",\"      \\\"blocks_manuscript_submission\\\": true\\n\",\"    },\\n\",\"    {\\n\",\"      \\\"id\\\": \\\"D03\\\",\\n\",\"      \\\"decision\\\": \\\"Exact model checkpoint and software versions\\\",\\n\",\"      \\\"current_status\\\": \\\"PARTIALLY_DOCUMENTED\\\",\\n\",\"      \\\"current_analysis\\\": \\\"InceptionResnetV1 pretrained on VGGFace2 is documented; complete checkpoint identity and environment versions remain insufficiently established.\\\",\\n\",\"      \\\"required_action\\\": \\\"Recover checkpoint identity and relevant package versions where possible; disclose unrecoverable details.\\\",\\n\",\"      \\\"blocks_manuscript_submission\\\": true\\n\",\"    },\\n\",\"    {\\n\",\"      \\\"id\\\": \\\"D04\\\",\\n\",\"      \\\"decision\\\": \\\"Official dataset authenticity\\\",\\n\",\"      \\\"current_status\\\": \\\"KNOWN_LIMITATION\\\",\\n\",\"      \\\"current_analysis\\\": \\\"Acquisition listing and archive hash match, but no independent official Yale checksum authentication was performed.\\\",\\n\",\"      \\\"required_action\\\": \\\"Disclose the community-hosted source and absence of official checksum authentication.\\\",\\n\",\"      \\\"blocks_manuscript_submission\\\": false\\n\",\"    },\\n\",\"    {\\n\",\"      \\\"id\\\": \\\"D05\\\",\\n\",\"      \\\"decision\\\": \\\"Dataset scope terminology\\\",\\n\",\"      \\\"current_status\\\": \\\"RESOLVED\\\",\\n\",\"      \\\"current_analysis\\\": \\\"The acquired data represent a cropped frontal-pose subset, not the complete multi-pose Extended Yale B dataset.\\\",\\n\",\"      \\\"required_action\\\": \\\"Use the precise dataset scope consistently throughout the manuscript.\\\",\\n\",\"      \\\"blocks_manuscript_submission\\\": false\\n\",\"    }\\n\",\"  ],\\n\",\"  \\\"submission_blocking_count\\\": 3\\n\",\"}\\n\",\"\\n\",\"[2] STEP 3.1.11 STATISTICAL DECISION EVIDENCE\\n\",\"Comparisons: 6\\n\",\"Metric-wise significant: 6\\n\",\"Six-family significant: 6\\n\",\"\\n\",\"[3] SIX-FAMILY ADJUSTED P-VALUES\\n\",\"{'metric': 'euclidean_mean', 'raw_p': 7.275957614180001e-12, 'holm_six_comparisons': 4.3655745685080005e-11, 'significant': True}\\n\",\"{'metric': 'euclidean_mean', 'raw_p': 7.275957614180001e-12, 'holm_six_comparisons': 4.3655745685080005e-11, 'significant': True}\\n\",\"{'metric': 'euclidean_mean', 'raw_p': 7.275957614180001e-12, 'holm_six_comparisons': 4.3655745685080005e-11, 'significant': True}\\n\",\"{'metric': 'cosine_mean', 'raw_p': 7.275957614180001e-12, 'holm_six_comparisons': 4.3655745685080005e-11, 'significant': True}\\n\",\"{'metric': 'cosine_mean', 'raw_p': 7.275957614180001e-12, 'holm_six_comparisons': 4.3655745685080005e-11, 'significant': True}\\n\",\"{'metric': 'cosine_mean', 'raw_p': 7.275957614180001e-12, 'holm_six_comparisons': 4.3655745685080005e-11, 'significant': True}\\n\",\"\\n\",\"[4] REGISTER STRUCTURE\\n\",\"Top-level type: dict\\n\",\"Top-level keys: ['experiment', 'step', 'timestamp_utc', 'decision_count', 'decisions', 'submission_blocking_count']\\n\",\"\\n\",\"No files modified.\\n\",\"==========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.1.13\\n\",\"## Finalise Multiple-Comparison Correction Decision\\n\",\"\\n\",\"### Objective\\n\",\"Update D01 in the unresolved-decision register using the\\n\",\"completed Step 3.1.11 sensitivity analysis.\\n\",\"\\n\",\"### Final decision\\n\",\"Adopt one Holm correction family containing all six\\n\",\"pairwise comparisons across Euclidean displacement\\n\",\"and cosine distance.\\n\",\"\\n\",\"### Supporting evidence\\n\",\"- Six frozen pairwise comparisons.\\n\",\"- Six-family Holm-adjusted p-value: 4.3655745685080005e-11.\\n\",\"- All six comparisons remain significant at alpha = 0.05.\\n\",\"- Original frozen statistical CSV remains unchanged.\\n\",\"\\n\",\"### Restrictions\\n\",\"- Update D01 only.\\n\",\"- Preserve D02, D03, D04 and D05 without modification.\\n\",\"- Recalculate the submission-blocking count.\\n\",\"- Preserve a backup of the original register.\\n\",\"- Validate the saved JSON after updating.\"],\"metadata\":{\"id\":\"9QCE5kmCxbrd\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"import shutil\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"\\n\",\"REGISTER_FILE = (\\n\",\"    BASE / \\\"step_3_1\\\" /\\n\",\"    \\\"experiment20_step317_unresolved_decisions.json\\\"\\n\",\")\\n\",\"\\n\",\"SENSITIVITY_FILE = (\\n\",\"    BASE / \\\"step_3_1\\\" /\\n\",\"    \\\"experiment20_step311_holm_family_sensitivity.json\\\"\\n\",\")\\n\",\"\\n\",\"BACKUP_FILE = (\\n\",\"    BASE / \\\"step_3_1\\\" /\\n\",\"    \\\"experiment20_step317_unresolved_decisions_pre_D01_update.json\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"=\\\" * 90)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.1.13\\\")\\n\",\"print(\\\"UPDATE D01: HOLM CORRECTION FAMILY\\\")\\n\",\"print(\\\"=\\\" * 90)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Verify source files\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"for path in [REGISTER_FILE, SENSITIVITY_FILE]:\\n\",\"    if not path.exists():\\n\",\"        raise FileNotFoundError(path)\\n\",\"\\n\",\"with REGISTER_FILE.open(\\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    register = json.load(f)\\n\",\"\\n\",\"with SENSITIVITY_FILE.open(\\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    sensitivity = json.load(f)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Validate statistical evidence\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"assert sensitivity[\\\"comparison_count\\\"] == 6\\n\",\"assert sensitivity[\\\"significant_count_six_family\\\"] == 6\\n\",\"\\n\",\"six_family_p_values = [\\n\",\"    result[\\\"holm_six_comparisons\\\"]\\n\",\"    for result in sensitivity[\\\"results\\\"]\\n\",\"]\\n\",\"\\n\",\"assert len(six_family_p_values) == 6\\n\",\"assert all(p < 0.05 for p in six_family_p_values)\\n\",\"\\n\",\"print(\\\"\\\\n[1] STATISTICAL EVIDENCE\\\")\\n\",\"print(\\\"Comparisons:\\\", len(six_family_p_values))\\n\",\"print(\\\"All six significant:\\\", all(p < 0.05 for p in six_family_p_values))\\n\",\"print(\\\"Six-family adjusted p-value:\\\", six_family_p_values[0])\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Preserve original register\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"if BACKUP_FILE.exists():\\n\",\"    raise FileExistsError(\\n\",\"        f\\\"Backup already exists; refusing to overwrite: {BACKUP_FILE}\\\"\\n\",\"    )\\n\",\"\\n\",\"shutil.copy2(REGISTER_FILE, BACKUP_FILE)\\n\",\"\\n\",\"print(\\\"\\\\n[2] BACKUP\\\")\\n\",\"print(\\\"Created:\\\", BACKUP_FILE)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Update D01 only\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"decisions = register[\\\"decisions\\\"]\\n\",\"\\n\",\"d01_entries = [\\n\",\"    item for item in decisions\\n\",\"    if item[\\\"id\\\"] == \\\"D01\\\"\\n\",\"]\\n\",\"\\n\",\"assert len(d01_entries) == 1\\n\",\"\\n\",\"d01 = d01_entries[0]\\n\",\"\\n\",\"d01[\\\"current_status\\\"] = \\\"RESOLVED\\\"\\n\",\"\\n\",\"d01[\\\"current_analysis\\\"] = (\\n\",\"    \\\"A single six-comparison Holm correction family was evaluated \\\"\\n\",\"    \\\"against the two separate three-comparison metric-wise families. \\\"\\n\",\"    \\\"The six-comparison family produced an adjusted p-value of \\\"\\n\",\"    \\\"4.3655745685080005e-11 for each comparison. All six comparisons \\\"\\n\",\"    \\\"remain significant at alpha = 0.05. The single six-comparison \\\"\\n\",\"    \\\"family is adopted for manuscript reporting.\\\"\\n\",\")\\n\",\"\\n\",\"d01[\\\"required_action\\\"] = (\\n\",\"    \\\"Report the six-comparison Holm-adjusted p-values in the manuscript \\\"\\n\",\"    \\\"and describe the correction family as covering all six pairwise \\\"\\n\",\"    \\\"comparisons across Euclidean displacement and cosine distance.\\\"\\n\",\")\\n\",\"\\n\",\"d01[\\\"blocks_manuscript_submission\\\"] = False\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Recalculate blocking count\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"register[\\\"submission_blocking_count\\\"] = sum(\\n\",\"    1 for item in decisions\\n\",\"    if item[\\\"blocks_manuscript_submission\\\"]\\n\",\")\\n\",\"\\n\",\"register[\\\"last_updated_step\\\"] = \\\"3.1.13\\\"\\n\",\"register[\\\"last_updated_utc\\\"] = datetime.now(\\n\",\"    timezone.utc\\n\",\").isoformat()\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. Save updated register\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"with REGISTER_FILE.open(\\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    json.dump(register, f, indent=2)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. Reload and validate\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"with REGISTER_FILE.open(\\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    updated = json.load(f)\\n\",\"\\n\",\"updated_d01 = [\\n\",\"    item for item in updated[\\\"decisions\\\"]\\n\",\"    if item[\\\"id\\\"] == \\\"D01\\\"\\n\",\"]\\n\",\"\\n\",\"assert len(updated_d01) == 1\\n\",\"assert updated_d01[0][\\\"current_status\\\"] == \\\"RESOLVED\\\"\\n\",\"assert updated_d01[0][\\\"blocks_manuscript_submission\\\"] is False\\n\",\"\\n\",\"assert updated[\\\"decision_count\\\"] == 5\\n\",\"assert updated[\\\"submission_blocking_count\\\"] == 2\\n\",\"\\n\",\"# Confirm D02-D05 were not changed.\\n\",\"original_backup = json.loads(BACKUP_FILE.read_text(encoding=\\\"utf-8\\\"))\\n\",\"\\n\",\"for decision_id in [\\\"D02\\\", \\\"D03\\\", \\\"D04\\\", \\\"D05\\\"]:\\n\",\"    before = next(\\n\",\"        item for item in original_backup[\\\"decisions\\\"]\\n\",\"        if item[\\\"id\\\"] == decision_id\\n\",\"    )\\n\",\"    after = next(\\n\",\"        item for item in updated[\\\"decisions\\\"]\\n\",\"        if item[\\\"id\\\"] == decision_id\\n\",\"    )\\n\",\"    assert before == after, f\\\"{decision_id} unexpectedly changed.\\\"\\n\",\"\\n\",\"print(\\\"\\\\n[3] UPDATED DECISION REGISTER\\\")\\n\",\"for item in updated[\\\"decisions\\\"]:\\n\",\"    print(\\n\",\"        item[\\\"id\\\"],\\n\",\"        \\\"|\\\",\\n\",\"        item[\\\"current_status\\\"],\\n\",\"        \\\"| blocks submission:\\\",\\n\",\"        item[\\\"blocks_manuscript_submission\\\"]\\n\",\"    )\\n\",\"\\n\",\"print(\\\"\\\\n[4] VALIDATION\\\")\\n\",\"print(\\\"D01 resolved: PASS\\\")\\n\",\"print(\\\"D02-D05 unchanged: PASS\\\")\\n\",\"print(\\\"Decision count preserved: PASS\\\")\\n\",\"print(\\\"Submission-blocking count = 2: PASS\\\")\\n\",\"print(\\\"JSON reload: PASS\\\")\\n\",\"print(\\\"Backup preserved: PASS\\\")\\n\",\"\\n\",\"print(\\\"\\\\nUpdated register:\\\", REGISTER_FILE)\\n\",\"\\n\",\"print(\\\"=\\\" * 90)\\n\",\"print(\\\"STEP 3.1.13 COMPLETED\\\")\\n\",\"print(\\\"=\\\" * 90)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"DVJJrkpuxd_B\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794386553234,\"user_tz\":360,\"elapsed\":89,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"9737d80b-24b7-4058-fd43-1832df1ef506\"},\"execution_count\":21,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"==========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.1.13\\n\",\"UPDATE D01: HOLM CORRECTION FAMILY\\n\",\"==========================================================================================\\n\",\"\\n\",\"[1] STATISTICAL EVIDENCE\\n\",\"Comparisons: 6\\n\",\"All six significant: True\\n\",\"Six-family adjusted p-value: 4.3655745685080005e-11\\n\",\"\\n\",\"[2] BACKUP\\n\",\"Created: /content/drive/MyDrive/Experiment_20_Results/step_3_1/experiment20_step317_unresolved_decisions_pre_D01_update.json\\n\",\"\\n\",\"[3] UPDATED DECISION REGISTER\\n\",\"D01 | RESOLVED | blocks submission: False\\n\",\"D02 | NOT_FULLY_DOCUMENTED | blocks submission: True\\n\",\"D03 | PARTIALLY_DOCUMENTED | blocks submission: True\\n\",\"D04 | KNOWN_LIMITATION | blocks submission: False\\n\",\"D05 | RESOLVED | blocks submission: False\\n\",\"\\n\",\"[4] VALIDATION\\n\",\"D01 resolved: PASS\\n\",\"D02-D05 unchanged: PASS\\n\",\"Decision count preserved: PASS\\n\",\"Submission-blocking count = 2: PASS\\n\",\"JSON reload: PASS\\n\",\"Backup preserved: PASS\\n\",\"\\n\",\"Updated register: /content/drive/MyDrive/Experiment_20_Results/step_3_1/experiment20_step317_unresolved_decisions.json\\n\",\"==========================================================================================\\n\",\"STEP 3.1.13 COMPLETED\\n\",\"==========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.1.14\\n\",\"## Resolve Resize Interpolation Documentation\\n\",\"\\n\",\"### Objective\\n\",\"Update D02 using the original notebook source and\\n\",\"Step 3.1.10 API inspection.\\n\",\"\\n\",\"### Recovered evidence\\n\",\"Original invocation:\\n\",\"transforms.Resize((160, 160))\\n\",\"\\n\",\"Recorded torchvision version:\\n\",\"0.29.1+cpu\\n\",\"\\n\",\"Inspected API defaults:\\n\",\"- Interpolation: BILINEAR\\n\",\"- Antialias: True\\n\",\"\\n\",\"### Documentation decision\\n\",\"Record bilinear interpolation and antialiasing as the\\n\",\"effective torchvision defaults for the original Resize call.\\n\",\"\\n\",\"Explicitly disclose that these parameters were not\\n\",\"specified in the original notebook invocation.\\n\",\"\\n\",\"### Restrictions\\n\",\"- Update D02 only.\\n\",\"- Preserve D01, D03, D04 and D05.\\n\",\"- Preserve a backup of the current register.\\n\",\"- Recalculate the submission-blocking count.\\n\",\"- Validate the saved JSON.\"],\"metadata\":{\"id\":\"wC6Gvnvfxnai\"}},{\"cell_type\":\"code\",\"source\":[],\"metadata\":{\"id\":\"zHZr0EDVxpWA\"},\"execution_count\":null,\"outputs\":[]},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"import shutil\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"\\n\",\"REGISTER_FILE = (\\n\",\"    BASE / \\\"step_3_1\\\" /\\n\",\"    \\\"experiment20_step317_unresolved_decisions.json\\\"\\n\",\")\\n\",\"\\n\",\"BACKUP_FILE = (\\n\",\"    BASE / \\\"step_3_1\\\" /\\n\",\"    \\\"experiment20_step317_unresolved_decisions_pre_D02_update.json\\\"\\n\",\")\\n\",\"\\n\",\"SENSITIVITY_FILE = (\\n\",\"    BASE / \\\"step_3_1\\\" /\\n\",\"    \\\"experiment20_step311_holm_family_sensitivity.json\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"=\\\" * 90)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.1.14\\\")\\n\",\"print(\\\"RESOLVE D02: RESIZE INTERPOLATION\\\")\\n\",\"print(\\\"=\\\" * 90)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Verify supporting evidence files\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"for path in [REGISTER_FILE, SENSITIVITY_FILE]:\\n\",\"    if not path.exists():\\n\",\"        raise FileNotFoundError(path)\\n\",\"\\n\",\"with REGISTER_FILE.open(\\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    register = json.load(f)\\n\",\"\\n\",\"with SENSITIVITY_FILE.open(\\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    sensitivity = json.load(f)\\n\",\"\\n\",\"assert sensitivity[\\\"comparison_count\\\"] == 6\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Verify recorded software evidence\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"recorded_torchvision = \\\"0.29.1+cpu\\\"\\n\",\"resize_invocation = \\\"transforms.Resize((160, 160))\\\"\\n\",\"interpolation = \\\"BILINEAR\\\"\\n\",\"antialias = True\\n\",\"\\n\",\"print(\\\"\\\\n[1] PREPROCESSING EVIDENCE\\\")\\n\",\"print(\\\"Original invocation:\\\", resize_invocation)\\n\",\"print(\\\"Recorded torchvision:\\\", recorded_torchvision)\\n\",\"print(\\\"Default interpolation:\\\", interpolation)\\n\",\"print(\\\"Default antialias:\\\", antialias)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Preserve the existing register\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"if BACKUP_FILE.exists():\\n\",\"    raise FileExistsError(\\n\",\"        f\\\"Backup already exists: {BACKUP_FILE}\\\"\\n\",\"    )\\n\",\"\\n\",\"shutil.copy2(REGISTER_FILE, BACKUP_FILE)\\n\",\"\\n\",\"print(\\\"\\\\n[2] BACKUP CREATED\\\")\\n\",\"print(BACKUP_FILE)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Update D02 only\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"decisions = register[\\\"decisions\\\"]\\n\",\"\\n\",\"d02_entries = [\\n\",\"    item for item in decisions\\n\",\"    if item[\\\"id\\\"] == \\\"D02\\\"\\n\",\"]\\n\",\"\\n\",\"assert len(d02_entries) == 1\\n\",\"\\n\",\"d02 = d02_entries[0]\\n\",\"\\n\",\"d02[\\\"current_status\\\"] = \\\"RESOLVED_WITH_QUALIFICATION\\\"\\n\",\"\\n\",\"d02[\\\"current_analysis\\\"] = (\\n\",\"    \\\"The original notebook used transforms.Resize((160, 160)) \\\"\\n\",\"    \\\"without explicitly specifying interpolation or antialiasing. \\\"\\n\",\"    \\\"The recorded torchvision version is 0.29.1+cpu. Inspection \\\"\\n\",\"    \\\"of that version's Resize API established the defaults as \\\"\\n\",\"    \\\"InterpolationMode.BILINEAR and antialias=True. These are \\\"\\n\",\"    \\\"documented as the effective defaults, not as explicitly \\\"\\n\",\"    \\\"specified arguments in the original notebook.\\\"\\n\",\")\\n\",\"\\n\",\"d02[\\\"required_action\\\"] = (\\n\",\"    \\\"Report resizing to 160x160 using the recorded torchvision \\\"\\n\",\"    \\\"defaults of bilinear interpolation and antialiasing enabled. \\\"\\n\",\"    \\\"Disclose that both settings were implicit defaults in the \\\"\\n\",\"    \\\"original Resize invocation.\\\"\\n\",\")\\n\",\"\\n\",\"d02[\\\"blocks_manuscript_submission\\\"] = False\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Recalculate submission-blocking count\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"register[\\\"submission_blocking_count\\\"] = sum(\\n\",\"    1 for item in decisions\\n\",\"    if item[\\\"blocks_manuscript_submission\\\"]\\n\",\")\\n\",\"\\n\",\"register[\\\"last_updated_step\\\"] = \\\"3.1.14\\\"\\n\",\"register[\\\"last_updated_utc\\\"] = datetime.now(\\n\",\"    timezone.utc\\n\",\").isoformat()\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. Save updated register\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"with REGISTER_FILE.open(\\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    json.dump(register, f, indent=2)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. Reload and validate\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"with REGISTER_FILE.open(\\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    updated = json.load(f)\\n\",\"\\n\",\"with BACKUP_FILE.open(\\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    original = json.load(f)\\n\",\"\\n\",\"updated_d02 = [\\n\",\"    item for item in updated[\\\"decisions\\\"]\\n\",\"    if item[\\\"id\\\"] == \\\"D02\\\"\\n\",\"]\\n\",\"\\n\",\"assert len(updated_d02) == 1\\n\",\"assert updated_d02[0][\\\"current_status\\\"] == \\\"RESOLVED_WITH_QUALIFICATION\\\"\\n\",\"assert updated_d02[0][\\\"blocks_manuscript_submission\\\"] is False\\n\",\"\\n\",\"# Confirm all other decisions are unchanged.\\n\",\"for decision_id in [\\\"D01\\\", \\\"D03\\\", \\\"D04\\\", \\\"D05\\\"]:\\n\",\"    before = next(\\n\",\"        item for item in original[\\\"decisions\\\"]\\n\",\"        if item[\\\"id\\\"] == decision_id\\n\",\"    )\\n\",\"    after = next(\\n\",\"        item for item in updated[\\\"decisions\\\"]\\n\",\"        if item[\\\"id\\\"] == decision_id\\n\",\"    )\\n\",\"    assert before == after, (\\n\",\"        f\\\"Unexpected modification to {decision_id}\\\"\\n\",\"    )\\n\",\"\\n\",\"assert updated[\\\"submission_blocking_count\\\"] == 1\\n\",\"\\n\",\"print(\\\"\\\\n[3] UPDATED DECISION REGISTER\\\")\\n\",\"\\n\",\"for item in updated[\\\"decisions\\\"]:\\n\",\"    print(\\n\",\"        item[\\\"id\\\"],\\n\",\"        \\\"|\\\",\\n\",\"        item[\\\"current_status\\\"],\\n\",\"        \\\"| blocks submission:\\\",\\n\",\"        item[\\\"blocks_manuscript_submission\\\"]\\n\",\"    )\\n\",\"\\n\",\"print(\\\"\\\\n[4] VALIDATION\\\")\\n\",\"print(\\\"D02 updated: PASS\\\")\\n\",\"print(\\\"D01 and D03-D05 unchanged: PASS\\\")\\n\",\"print(\\\"Backup preserved: PASS\\\")\\n\",\"print(\\\"Submission-blocking count = 1: PASS\\\")\\n\",\"print(\\\"JSON reload: PASS\\\")\\n\",\"\\n\",\"print(\\\"\\\\nUpdated register:\\\", REGISTER_FILE)\\n\",\"\\n\",\"print(\\\"=\\\" * 90)\\n\",\"print(\\\"STEP 3.1.14 COMPLETED\\\")\\n\",\"print(\\\"=\\\" * 90)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"Yq7lS-zQxpmF\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794386599672,\"user_tz\":360,\"elapsed\":54,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"ee2c7c7d-610d-4385-e6ce-7dcfd588dd7b\"},\"execution_count\":22,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"==========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.1.14\\n\",\"RESOLVE D02: RESIZE INTERPOLATION\\n\",\"==========================================================================================\\n\",\"\\n\",\"[1] PREPROCESSING EVIDENCE\\n\",\"Original invocation: transforms.Resize((160, 160))\\n\",\"Recorded torchvision: 0.29.1+cpu\\n\",\"Default interpolation: BILINEAR\\n\",\"Default antialias: True\\n\",\"\\n\",\"[2] BACKUP CREATED\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_1/experiment20_step317_unresolved_decisions_pre_D02_update.json\\n\",\"\\n\",\"[3] UPDATED DECISION REGISTER\\n\",\"D01 | RESOLVED | blocks submission: False\\n\",\"D02 | RESOLVED_WITH_QUALIFICATION | blocks submission: False\\n\",\"D03 | PARTIALLY_DOCUMENTED | blocks submission: True\\n\",\"D04 | KNOWN_LIMITATION | blocks submission: False\\n\",\"D05 | RESOLVED | blocks submission: False\\n\",\"\\n\",\"[4] VALIDATION\\n\",\"D02 updated: PASS\\n\",\"D01 and D03-D05 unchanged: PASS\\n\",\"Backup preserved: PASS\\n\",\"Submission-blocking count = 1: PASS\\n\",\"JSON reload: PASS\\n\",\"\\n\",\"Updated register: /content/drive/MyDrive/Experiment_20_Results/step_3_1/experiment20_step317_unresolved_decisions.json\\n\",\"==========================================================================================\\n\",\"STEP 3.1.14 COMPLETED\\n\",\"==========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.1.15\\n\",\"## Finalise Model Checkpoint and Software Reproducibility Record\\n\",\"\\n\",\"### Objective\\n\",\"Review the recovered original notebook and software evidence\\n\",\"and update D03.\\n\",\"\\n\",\"### Established evidence\\n\",\"- Model: InceptionResnetV1\\n\",\"- Pretrained identifier: VGGFace2\\n\",\"- facenet-pytorch: 2.6.0\\n\",\"- PyTorch: 2.14.1+cpu\\n\",\"- torchvision: 0.29.1+cpu\\n\",\"- Python: 3.13.18\\n\",\"- Model evaluation mode enabled.\\n\",\"- Gradient computation disabled during embedding extraction.\\n\",\"- Embedding dimension: 512.\\n\",\"\\n\",\"### Unresolved limitation\\n\",\"The exact pretrained weight-file identity and SHA256 checksum\\n\",\"were not preserved or recovered.\\n\",\"\\n\",\"The embedding-progress checkpoint is not the FaceNet\\n\",\"model-weight checkpoint.\\n\",\"\\n\",\"### Decision\\n\",\"Record D03 as a known reproducibility limitation.\\n\",\"Do not invent or infer a model-weight checksum.\\n\",\"Disclose the missing checkpoint identity in the manuscript.\\n\",\"\\n\",\"### Restrictions\\n\",\"- Update D03 only.\\n\",\"- Preserve D01, D02, D04 and D05.\\n\",\"- Preserve a backup of the current decision register.\\n\",\"- Recalculate the submission-blocking count.\\n\",\"- Validate the saved JSON.\"],\"metadata\":{\"id\":\"shfGHyR7xwsv\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"import shutil\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"\\n\",\"REGISTER_FILE = (\\n\",\"    BASE / \\\"step_3_1\\\" /\\n\",\"    \\\"experiment20_step317_unresolved_decisions.json\\\"\\n\",\")\\n\",\"\\n\",\"BACKUP_FILE = (\\n\",\"    BASE / \\\"step_3_1\\\" /\\n\",\"    \\\"experiment20_step317_unresolved_decisions_pre_D03_update.json\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"=\\\" * 90)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.1.15\\\")\\n\",\"print(\\\"RESOLVE D03 AS A DOCUMENTED REPRODUCIBILITY LIMITATION\\\")\\n\",\"print(\\\"=\\\" * 90)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Load and inspect current register\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"if not REGISTER_FILE.exists():\\n\",\"    raise FileNotFoundError(REGISTER_FILE)\\n\",\"\\n\",\"with REGISTER_FILE.open(\\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    register = json.load(f)\\n\",\"\\n\",\"decisions = register[\\\"decisions\\\"]\\n\",\"\\n\",\"d03_entries = [\\n\",\"    item for item in decisions\\n\",\"    if item[\\\"id\\\"] == \\\"D03\\\"\\n\",\"]\\n\",\"\\n\",\"assert len(d03_entries) == 1\\n\",\"\\n\",\"print(\\\"\\\\n[1] CURRENT D03\\\")\\n\",\"print(json.dumps(d03_entries[0], indent=2))\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Record established software/model evidence\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"evidence = {\\n\",\"    \\\"architecture\\\": \\\"InceptionResnetV1\\\",\\n\",\"    \\\"pretrained_identifier\\\": \\\"VGGFace2\\\",\\n\",\"    \\\"embedding_dimension\\\": 512,\\n\",\"    \\\"facenet_pytorch\\\": \\\"2.6.0\\\",\\n\",\"    \\\"pytorch\\\": \\\"2.14.1+cpu\\\",\\n\",\"    \\\"torchvision\\\": \\\"0.29.1+cpu\\\",\\n\",\"    \\\"python\\\": \\\"3.13.18\\\",\\n\",\"    \\\"evaluation_mode\\\": True,\\n\",\"    \\\"gradient_computation_disabled\\\": True,\\n\",\"    \\\"exact_weight_file_identity\\\": None,\\n\",\"    \\\"exact_weight_file_sha256\\\": None\\n\",\"}\\n\",\"\\n\",\"print(\\\"\\\\n[2] ESTABLISHED EVIDENCE\\\")\\n\",\"print(json.dumps(evidence, indent=2))\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Preserve original register\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"if BACKUP_FILE.exists():\\n\",\"    raise FileExistsError(\\n\",\"        f\\\"Backup already exists: {BACKUP_FILE}\\\"\\n\",\"    )\\n\",\"\\n\",\"shutil.copy2(REGISTER_FILE, BACKUP_FILE)\\n\",\"\\n\",\"print(\\\"\\\\n[3] BACKUP CREATED\\\")\\n\",\"print(BACKUP_FILE)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Update D03 only\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"d03 = d03_entries[0]\\n\",\"\\n\",\"d03[\\\"current_status\\\"] = \\\"KNOWN_LIMITATION\\\"\\n\",\"\\n\",\"d03[\\\"current_analysis\\\"] = (\\n\",\"    \\\"The original notebook establishes InceptionResnetV1 \\\"\\n\",\"    \\\"pretrained on VGGFace2 using facenet-pytorch 2.6.0. \\\"\\n\",\"    \\\"The recorded environment includes Python 3.13.18, \\\"\\n\",\"    \\\"PyTorch 2.14.1+cpu and torchvision 0.29.1+cpu. \\\"\\n\",\"    \\\"The model was used in evaluation mode, with gradient \\\"\\n\",\"    \\\"computation disabled during embedding extraction. \\\"\\n\",\"    \\\"The embedding dimension was 512. However, the exact \\\"\\n\",\"    \\\"pretrained model-weight file identity and SHA256 checksum \\\"\\n\",\"    \\\"were not preserved in the available records and no matching \\\"\\n\",\"    \\\"local weight file was recovered. The separate embedding \\\"\\n\",\"    \\\"progress checkpoint does not establish model-weight identity.\\\"\\n\",\")\\n\",\"\\n\",\"d03[\\\"required_action\\\"] = (\\n\",\"    \\\"Disclose the model architecture, VGGFace2 pretrained \\\"\\n\",\"    \\\"identifier and recorded software versions. Explicitly state \\\"\\n\",\"    \\\"that the exact pretrained weight-file identity and checksum \\\"\\n\",\"    \\\"were unavailable. Do not claim exact checkpoint-level \\\"\\n\",\"    \\\"reproducibility.\\\"\\n\",\")\\n\",\"\\n\",\"d03[\\\"blocks_manuscript_submission\\\"] = False\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Recalculate blocking count\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"register[\\\"submission_blocking_count\\\"] = sum(\\n\",\"    1 for item in decisions\\n\",\"    if item[\\\"blocks_manuscript_submission\\\"]\\n\",\")\\n\",\"\\n\",\"register[\\\"last_updated_step\\\"] = \\\"3.1.15\\\"\\n\",\"register[\\\"last_updated_utc\\\"] = datetime.now(\\n\",\"    timezone.utc\\n\",\").isoformat()\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. Save updated register\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"with REGISTER_FILE.open(\\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    json.dump(register, f, indent=2)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. Reload and validate\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"with REGISTER_FILE.open(\\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    updated = json.load(f)\\n\",\"\\n\",\"with BACKUP_FILE.open(\\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    original = json.load(f)\\n\",\"\\n\",\"updated_d03 = [\\n\",\"    item for item in updated[\\\"decisions\\\"]\\n\",\"    if item[\\\"id\\\"] == \\\"D03\\\"\\n\",\"]\\n\",\"\\n\",\"assert len(updated_d03) == 1\\n\",\"assert updated_d03[0][\\\"current_status\\\"] == \\\"KNOWN_LIMITATION\\\"\\n\",\"assert updated_d03[0][\\\"blocks_manuscript_submission\\\"] is False\\n\",\"\\n\",\"for decision_id in [\\\"D01\\\", \\\"D02\\\", \\\"D04\\\", \\\"D05\\\"]:\\n\",\"    before = next(\\n\",\"        item for item in original[\\\"decisions\\\"]\\n\",\"        if item[\\\"id\\\"] == decision_id\\n\",\"    )\\n\",\"    after = next(\\n\",\"        item for item in updated[\\\"decisions\\\"]\\n\",\"        if item[\\\"id\\\"] == decision_id\\n\",\"    )\\n\",\"    assert before == after, (\\n\",\"        f\\\"Unexpected modification to {decision_id}\\\"\\n\",\"    )\\n\",\"\\n\",\"assert updated[\\\"submission_blocking_count\\\"] == 0\\n\",\"\\n\",\"print(\\\"\\\\n[4] UPDATED DECISION REGISTER\\\")\\n\",\"\\n\",\"for item in updated[\\\"decisions\\\"]:\\n\",\"    print(\\n\",\"        item[\\\"id\\\"],\\n\",\"        \\\"|\\\",\\n\",\"        item[\\\"current_status\\\"],\\n\",\"        \\\"| blocks submission:\\\",\\n\",\"        item[\\\"blocks_manuscript_submission\\\"]\\n\",\"    )\\n\",\"\\n\",\"print(\\\"\\\\n[5] VALIDATION\\\")\\n\",\"print(\\\"D03 updated: PASS\\\")\\n\",\"print(\\\"D01, D02, D04 and D05 unchanged: PASS\\\")\\n\",\"print(\\\"Backup preserved: PASS\\\")\\n\",\"print(\\\"Submission-blocking count = 0: PASS\\\")\\n\",\"print(\\\"JSON reload: PASS\\\")\\n\",\"\\n\",\"print(\\\"\\\\nUpdated register:\\\", REGISTER_FILE)\\n\",\"\\n\",\"print(\\\"=\\\" * 90)\\n\",\"print(\\\"STEP 3.1.15 COMPLETED\\\")\\n\",\"print(\\\"=\\\" * 90)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"pvh9PecGxymL\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794386637346,\"user_tz\":360,\"elapsed\":42,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"0ab7a46d-4a28-43da-b3ba-47bd0eb525dd\"},\"execution_count\":23,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"==========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.1.15\\n\",\"RESOLVE D03 AS A DOCUMENTED REPRODUCIBILITY LIMITATION\\n\",\"==========================================================================================\\n\",\"\\n\",\"[1] CURRENT D03\\n\",\"{\\n\",\"  \\\"id\\\": \\\"D03\\\",\\n\",\"  \\\"decision\\\": \\\"Exact model checkpoint and software versions\\\",\\n\",\"  \\\"current_status\\\": \\\"PARTIALLY_DOCUMENTED\\\",\\n\",\"  \\\"current_analysis\\\": \\\"InceptionResnetV1 pretrained on VGGFace2 is documented; complete checkpoint identity and environment versions remain insufficiently established.\\\",\\n\",\"  \\\"required_action\\\": \\\"Recover checkpoint identity and relevant package versions where possible; disclose unrecoverable details.\\\",\\n\",\"  \\\"blocks_manuscript_submission\\\": true\\n\",\"}\\n\",\"\\n\",\"[2] ESTABLISHED EVIDENCE\\n\",\"{\\n\",\"  \\\"architecture\\\": \\\"InceptionResnetV1\\\",\\n\",\"  \\\"pretrained_identifier\\\": \\\"VGGFace2\\\",\\n\",\"  \\\"embedding_dimension\\\": 512,\\n\",\"  \\\"facenet_pytorch\\\": \\\"2.6.0\\\",\\n\",\"  \\\"pytorch\\\": \\\"2.14.1+cpu\\\",\\n\",\"  \\\"torchvision\\\": \\\"0.29.1+cpu\\\",\\n\",\"  \\\"python\\\": \\\"3.13.18\\\",\\n\",\"  \\\"evaluation_mode\\\": true,\\n\",\"  \\\"gradient_computation_disabled\\\": true,\\n\",\"  \\\"exact_weight_file_identity\\\": null,\\n\",\"  \\\"exact_weight_file_sha256\\\": null\\n\",\"}\\n\",\"\\n\",\"[3] BACKUP CREATED\\n\",\"/content/drive/MyDrive/Experiment_20_Results/step_3_1/experiment20_step317_unresolved_decisions_pre_D03_update.json\\n\",\"\\n\",\"[4] UPDATED DECISION REGISTER\\n\",\"D01 | RESOLVED | blocks submission: False\\n\",\"D02 | RESOLVED_WITH_QUALIFICATION | blocks submission: False\\n\",\"D03 | KNOWN_LIMITATION | blocks submission: False\\n\",\"D04 | KNOWN_LIMITATION | blocks submission: False\\n\",\"D05 | RESOLVED | blocks submission: False\\n\",\"\\n\",\"[5] VALIDATION\\n\",\"D03 updated: PASS\\n\",\"D01, D02, D04 and D05 unchanged: PASS\\n\",\"Backup preserved: PASS\\n\",\"Submission-blocking count = 0: PASS\\n\",\"JSON reload: PASS\\n\",\"\\n\",\"Updated register: /content/drive/MyDrive/Experiment_20_Results/step_3_1/experiment20_step317_unresolved_decisions.json\\n\",\"==========================================================================================\\n\",\"STEP 3.1.15 COMPLETED\\n\",\"==========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.1.16\\n\",\"## Final Methodological Review Closure Audit\\n\",\"\\n\",\"### Objective\\n\",\"Perform a final consistency audit of the methodological\\n\",\"decisions and supporting evidence before closing Phase 3.1.\\n\",\"\\n\",\"### Audit areas\\n\",\"1. Decision register completeness and status.\\n\",\"2. Statistical correction decision and supporting report.\\n\",\"3. Preprocessing documentation and implicit defaults.\\n\",\"4. Model identity and checkpoint limitation.\\n\",\"5. Dataset provenance and scope limitations.\\n\",\"6. Submission-blocking count.\\n\",\"7. Supporting artifact availability and integrity.\\n\",\"\\n\",\"### Restrictions\\n\",\"- Read-only inspection.\\n\",\"- Do not modify frozen Experiment 20 results.\\n\",\"- Do not silently resolve known limitations.\\n\",\"- Do not claim independent model validation.\\n\",\"- Do not claim operational drift detection or deployment readiness.\\n\",\"\\n\",\"### Expected outcome\\n\",\"A final methodological review audit identifying:\\n\",\"- Resolved decisions.\\n\",\"- Documented limitations.\\n\",\"- Remaining manuscript disclosure requirements.\\n\",\"- Whether Phase 3.1 can be closed.\"],\"metadata\":{\"id\":\"y7Yo6XWfx69C\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"STEP31 = BASE / \\\"step_3_1\\\"\\n\",\"\\n\",\"REGISTER_FILE = (\\n\",\"    STEP31 / \\\"experiment20_step317_unresolved_decisions.json\\\"\\n\",\")\\n\",\"\\n\",\"AUDIT_FILE = (\\n\",\"    STEP31 / \\\"experiment20_step316_final_methodological_review_audit.json\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"=\\\" * 90)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.1.16\\\")\\n\",\"print(\\\"CORRECTED AUDIT CONDITION AND REVALIDATION\\\")\\n\",\"print(\\\"=\\\" * 90)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Load existing records\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"with REGISTER_FILE.open(\\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    register = json.load(f)\\n\",\"\\n\",\"with AUDIT_FILE.open(\\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    audit = json.load(f)\\n\",\"\\n\",\"d02 = next(\\n\",\"    item for item in register[\\\"decisions\\\"]\\n\",\"    if item[\\\"id\\\"] == \\\"D02\\\"\\n\",\")\\n\",\"\\n\",\"d02_text = d02[\\\"current_analysis\\\"].lower()\\n\",\"\\n\",\"print(\\\"\\\\n[1] ACTUAL D02 DISCLOSURE\\\")\\n\",\"print(d02[\\\"current_analysis\\\"])\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Test the actual disclosure meaning\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"has_implicit_disclosure = (\\n\",\"    \\\"without explicitly specifying\\\" in d02_text\\n\",\"    or \\\"not explicitly specified\\\" in d02_text\\n\",\"    or \\\"implicit defaults\\\" in d02_text\\n\",\")\\n\",\"\\n\",\"has_interpolation = \\\"interpolation\\\" in d02_text\\n\",\"has_antialias = \\\"antialias\\\" in d02_text\\n\",\"\\n\",\"corrected_condition = (\\n\",\"    has_implicit_disclosure\\n\",\"    and has_interpolation\\n\",\"    and has_antialias\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n[2] CORRECTED SEMANTIC CHECK\\\")\\n\",\"print(\\\"Implicit-setting disclosure:\\\", has_implicit_disclosure)\\n\",\"print(\\\"Interpolation mentioned:\\\", has_interpolation)\\n\",\"print(\\\"Antialiasing mentioned:\\\", has_antialias)\\n\",\"print(\\\"Corrected condition:\\\", corrected_condition)\\n\",\"\\n\",\"if not corrected_condition:\\n\",\"    raise ValueError(\\n\",\"        \\\"D02 does not contain the required disclosure. \\\"\\n\",\"        \\\"Do not mark the audit as passed.\\\"\\n\",\"    )\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Correct only the failed audit check\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"matching_checks = [\\n\",\"    item for item in audit[\\\"failed_checks\\\"]\\n\",\"    if item[\\\"check\\\"] == \\\"D02 discloses implicit arguments\\\"\\n\",\"]\\n\",\"\\n\",\"all_checks = audit.get(\\\"checks\\\", [])\\n\",\"\\n\",\"if matching_checks:\\n\",\"    matching_checks[0][\\\"passed\\\"] = True\\n\",\"    matching_checks[0][\\\"detail\\\"] = (\\n\",\"        \\\"Verified: original Resize invocation did not explicitly \\\"\\n\",\"        \\\"specify interpolation or antialiasing; both are documented \\\"\\n\",\"        \\\"as implicit torchvision defaults.\\\"\\n\",\"    )\\n\",\"\\n\",\"# The earlier audit report may not retain the full checks array.\\n\",\"# Update its counts using the recorded result and this verified check.\\n\",\"previous_failures = audit[\\\"checks_failed\\\"]\\n\",\"\\n\",\"if previous_failures != 1:\\n\",\"    raise ValueError(\\n\",\"        f\\\"Expected exactly one previous failure, found {previous_failures}.\\\"\\n\",\"    )\\n\",\"\\n\",\"audit[\\\"checks_passed\\\"] = audit[\\\"checks_passed\\\"] + 1\\n\",\"audit[\\\"checks_failed\\\"] = 0\\n\",\"audit[\\\"failed_checks\\\"] = []\\n\",\"audit[\\\"audit_passed\\\"] = True\\n\",\"\\n\",\"audit[\\\"closure_recommendation\\\"] = (\\n\",\"    \\\"PHASE_3_1_READY_TO_CLOSE_WITH_DOCUMENTED_LIMITATIONS\\\"\\n\",\")\\n\",\"\\n\",\"audit[\\\"timestamp_utc\\\"] = datetime.now(\\n\",\"    timezone.utc\\n\",\").isoformat()\\n\",\"\\n\",\"audit[\\\"audit_correction_note\\\"] = (\\n\",\"    \\\"The previous failure was caused by an overly restrictive \\\"\\n\",\"    \\\"string-matching condition. The D02 record contained the \\\"\\n\",\"    \\\"equivalent wording 'without explicitly specifying'. The \\\"\\n\",\"    \\\"actual decision-register text was verified before correcting \\\"\\n\",\"    \\\"the audit result. No scientific record or experiment result \\\"\\n\",\"    \\\"was modified.\\\"\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Save corrected audit report\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"with AUDIT_FILE.open(\\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    json.dump(audit, f, indent=2)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Reload and validate\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"with AUDIT_FILE.open(\\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    verified = json.load(f)\\n\",\"\\n\",\"assert verified[\\\"audit_passed\\\"] is True\\n\",\"assert verified[\\\"checks_failed\\\"] == 0\\n\",\"assert verified[\\\"closure_recommendation\\\"] == (\\n\",\"    \\\"PHASE_3_1_READY_TO_CLOSE_WITH_DOCUMENTED_LIMITATIONS\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n[3] FINAL AUDIT RESULT\\\")\\n\",\"print(\\\"Checks passed:\\\", verified[\\\"checks_passed\\\"])\\n\",\"print(\\\"Checks failed:\\\", verified[\\\"checks_failed\\\"])\\n\",\"print(\\\"Submission blockers:\\\", verified[\\\"submission_blocking_count\\\"])\\n\",\"print(\\\"Audit passed:\\\", verified[\\\"audit_passed\\\"])\\n\",\"print(\\\"Closure recommendation:\\\", verified[\\\"closure_recommendation\\\"])\\n\",\"\\n\",\"print(\\\"\\\\n[4] INTEGRITY\\\")\\n\",\"print(\\\"Decision register modified: NO\\\")\\n\",\"print(\\\"Frozen experiment results modified: NO\\\")\\n\",\"print(\\\"Only audit report corrected: YES\\\")\\n\",\"print(\\\"JSON reload: PASS\\\")\\n\",\"\\n\",\"print(\\\"\\\\nSaved:\\\", AUDIT_FILE)\\n\",\"\\n\",\"print(\\\"=\\\" * 90)\\n\",\"print(\\\"CORRECTED AUDIT COMPLETED\\\")\\n\",\"print(\\\"=\\\" * 90)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"k78Sq0nkx-Ar\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794386767868,\"user_tz\":360,\"elapsed\":90,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"9ee6cdf3-beff-40e7-e5a9-4171558adb07\"},\"execution_count\":25,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"==========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.1.16\\n\",\"CORRECTED AUDIT CONDITION AND REVALIDATION\\n\",\"==========================================================================================\\n\",\"\\n\",\"[1] ACTUAL D02 DISCLOSURE\\n\",\"The original notebook used transforms.Resize((160, 160)) without explicitly specifying interpolation or antialiasing. The recorded torchvision version is 0.29.1+cpu. Inspection of that version's Resize API established the defaults as InterpolationMode.BILINEAR and antialias=True. These are documented as the effective defaults, not as explicitly specified arguments in the original notebook.\\n\",\"\\n\",\"[2] CORRECTED SEMANTIC CHECK\\n\",\"Implicit-setting disclosure: True\\n\",\"Interpolation mentioned: True\\n\",\"Antialiasing mentioned: True\\n\",\"Corrected condition: True\\n\",\"\\n\",\"[3] FINAL AUDIT RESULT\\n\",\"Checks passed: 23\\n\",\"Checks failed: 0\\n\",\"Submission blockers: 0\\n\",\"Audit passed: True\\n\",\"Closure recommendation: PHASE_3_1_READY_TO_CLOSE_WITH_DOCUMENTED_LIMITATIONS\\n\",\"\\n\",\"[4] INTEGRITY\\n\",\"Decision register modified: NO\\n\",\"Frozen experiment results modified: NO\\n\",\"Only audit report corrected: YES\\n\",\"JSON reload: PASS\\n\",\"\\n\",\"Saved: /content/drive/MyDrive/Experiment_20_Results/step_3_1/experiment20_step316_final_methodological_review_audit.json\\n\",\"==========================================================================================\\n\",\"CORRECTED AUDIT COMPLETED\\n\",\"==========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.2.1\\n\",\"## Preliminary Literature and Novelty Baseline\\n\",\"\\n\",\"### Research area\\n\",\"Illumination-associated displacement in deep face-recognition embeddings.\\n\",\"\\n\",\"### Literature themes\\n\",\"1. Illumination-induced within-identity variation.\\n\",\"2. Illumination subspaces and geometric lighting variation.\\n\",\"3. Deep face embeddings and representation quality.\\n\",\"4. Illumination robustness and preprocessing.\\n\",\"5. Modern low-light face-verification evaluation.\\n\",\"\\n\",\"### Preliminary research position\\n\",\"Illumination sensitivity and within-identity variation are\\n\",\"established research topics.\\n\",\"\\n\",\"The potential contribution of Experiment 20 is its specific\\n\",\"identity-level descriptive evaluation of embedding displacement\\n\",\"across geometrically grouped illumination directions.\\n\",\"\\n\",\"### Novelty status\\n\",\"NOT ESTABLISHED.\\n\",\"\\n\",\"### Important limitations\\n\",\"- Literature search is preliminary, not systematic or exhaustive.\\n\",\"- No claim of a new detector or mitigation method.\\n\",\"- No claim of independent model validation.\\n\",\"- No claim of recognition accuracy or deployment readiness.\\n\",\"\\n\",\"### Next stage\\n\",\"Compare the closest prior studies against the exact methodology\\n\",\"and contribution of Experiment 20.\"],\"metadata\":{\"id\":\"TCjEWGf5yyK1\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"OUTPUT_DIR = BASE / \\\"step_3_2\\\"\\n\",\"OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"OUTPUT_FILE = (\\n\",\"    OUTPUT_DIR /\\n\",\"    \\\"experiment20_step321_preliminary_literature_baseline.json\\\"\\n\",\")\\n\",\"\\n\",\"literature = [\\n\",\"    {\\n\",\"        \\\"authors\\\": \\\"Moses, Adini and Ullman\\\",\\n\",\"        \\\"year\\\": 1994,\\n\",\"        \\\"title\\\": \\\"Face Recognition: The Problem of Compensating for Changes in Illumination Direction\\\",\\n\",\"        \\\"venue\\\": \\\"ECCV\\\",\\n\",\"        \\\"doi\\\": \\\"10.1007/3-540-57956-7_33\\\",\\n\",\"        \\\"url\\\": \\\"https://mlanthology.org/eccv/1994/moses1994eccv-face/\\\",\\n\",\"        \\\"theme\\\": \\\"Illumination direction and within-identity variation\\\",\\n\",\"        \\\"relevance\\\": \\\"Foundational evidence that illumination direction can produce substantial within-person appearance variation.\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"authors\\\": \\\"Beveridge et al.\\\",\\n\",\"        \\\"year\\\": 2009,\\n\",\"        \\\"title\\\": \\\"Principal angles separate subject illumination spaces in YDB and CMU-PIE\\\",\\n\",\"        \\\"venue\\\": \\\"IEEE Transactions on Pattern Analysis and Machine Intelligence\\\",\\n\",\"        \\\"doi\\\": \\\"10.1109/TPAMI.2008.200\\\",\\n\",\"        \\\"url\\\": \\\"https://pubmed.ncbi.nlm.nih.gov/19110498/\\\",\\n\",\"        \\\"theme\\\": \\\"Illumination subspaces and identity\\\",\\n\",\"        \\\"relevance\\\": \\\"Directly relevant to identity-specific illumination variation and geometric comparison of illumination subspaces.\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"authors\\\": \\\"Beveridge et al.\\\",\\n\",\"        \\\"year\\\": 2010,\\n\",\"        \\\"title\\\": \\\"Quantifying How Lighting and Focus Affect Face Recognition Performance\\\",\\n\",\"        \\\"venue\\\": \\\"CVPR / NISTIR 7674\\\",\\n\",\"        \\\"doi\\\": None,\\n\",\"        \\\"url\\\": \\\"https://www.nist.gov/publications/quantifying-how-lighting-and-focus-affect-face-recognition-performance\\\",\\n\",\"        \\\"theme\\\": \\\"Lighting effects on recognition performance\\\",\\n\",\"        \\\"relevance\\\": \\\"Shows that lighting sensitivity remains relevant in face-recognition systems.\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"authors\\\": \\\"Han, Shan, Chen and Gao\\\",\\n\",\"        \\\"year\\\": 2013,\\n\",\"        \\\"title\\\": \\\"A comparative study on illumination preprocessing in face recognition\\\",\\n\",\"        \\\"venue\\\": \\\"Pattern Recognition\\\",\\n\",\"        \\\"doi\\\": \\\"10.1016/j.patcog.2012.11.022\\\",\\n\",\"        \\\"url\\\": \\\"https://doi.org/10.1016/j.patcog.2012.11.022\\\",\\n\",\"        \\\"theme\\\": \\\"Illumination preprocessing and recognition\\\",\\n\",\"        \\\"relevance\\\": \\\"Compares twelve preprocessing methods across four face datasets.\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"authors\\\": \\\"Ochoa-Villegas et al.\\\",\\n\",\"        \\\"year\\\": 2015,\\n\",\"        \\\"title\\\": \\\"Addressing the illumination challenge in two-dimensional face recognition: a survey\\\",\\n\",\"        \\\"venue\\\": \\\"IET Computer Vision\\\",\\n\",\"        \\\"doi\\\": \\\"10.1049/iet-cvi.2014.0086\\\",\\n\",\"        \\\"url\\\": \\\"https://doi.org/10.1049/iet-cvi.2014.0086\\\",\\n\",\"        \\\"theme\\\": \\\"Illumination compensation survey\\\",\\n\",\"        \\\"relevance\\\": \\\"Provides a taxonomy of relighting and unlighting approaches.\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"authors\\\": \\\"Meng et al.\\\",\\n\",\"        \\\"year\\\": 2021,\\n\",\"        \\\"title\\\": \\\"MagFace: A Universal Representation for Face Recognition and Quality Assessment\\\",\\n\",\"        \\\"venue\\\": \\\"CVPR\\\",\\n\",\"        \\\"doi\\\": None,\\n\",\"        \\\"url\\\": \\\"https://openaccess.thecvf.com/content/CVPR2021/html/Meng_MagFace_A_Universal_Representation_for_Face_Recognition_and_Quality_Assessment_CVPR_2021_paper.html\\\",\\n\",\"        \\\"theme\\\": \\\"Deep embedding quality\\\",\\n\",\"        \\\"relevance\\\": \\\"Demonstrates that deep face embeddings can encode quality-related information.\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"authors\\\": \\\"Authors to verify\\\",\\n\",\"        \\\"year\\\": 2025,\\n\",\"        \\\"title\\\": \\\"Local Sliced Wasserstein Feature Sets for Illumination Invariant Face Recognition\\\",\\n\",\"        \\\"venue\\\": \\\"Verify full bibliographic details\\\",\\n\",\"        \\\"doi\\\": None,\\n\",\"        \\\"url\\\": \\\"https://pmc.ncbi.nlm.nih.gov/articles/PMC11884647/\\\",\\n\",\"        \\\"theme\\\": \\\"Illumination-invariant representations\\\",\\n\",\"        \\\"relevance\\\": \\\"Uses local gradient distributions and sliced Wasserstein features for illumination-invariant recognition.\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"authors\\\": \\\"Wahyudi, Sunaryono, Subakti and Siswantoro\\\",\\n\",\"        \\\"year\\\": 2026,\\n\",\"        \\\"title\\\": \\\"A low-light robustness framework for face verification with enhancement-based recovery\\\",\\n\",\"        \\\"venue\\\": \\\"Array, Volume 30, Article 100968\\\",\\n\",\"        \\\"doi\\\": \\\"10.1016/j.array.2026.100968\\\",\\n\",\"        \\\"url\\\": \\\"https://doi.org/10.1016/j.array.2026.100968\\\",\\n\",\"        \\\"theme\\\": \\\"Modern deep face verification under low light\\\",\\n\",\"        \\\"relevance\\\": \\\"Evaluates AdaFace, MagFace and Dlib under multiple low-light degradation conditions.\\\"\\n\",\"    }\\n\",\"]\\n\",\"\\n\",\"report = {\\n\",\"    \\\"experiment\\\": 20,\\n\",\"    \\\"step\\\": \\\"3.2.1\\\",\\n\",\"    \\\"created_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"research_area\\\": (\\n\",\"        \\\"Illumination-associated displacement in deep face-recognition embeddings\\\"\\n\",\"    ),\\n\",\"    \\\"literature_search_status\\\": \\\"PRELIMINARY_NOT_SYSTEMATIC\\\",\\n\",\"    \\\"novelty_status\\\": \\\"NOT_ESTABLISHED\\\",\\n\",\"    \\\"literature_count\\\": len(literature),\\n\",\"    \\\"literature\\\": literature,\\n\",\"    \\\"provisional_contribution\\\": (\\n\",\"        \\\"An identity-level descriptive evaluation of illumination-associated \\\"\\n\",\"        \\\"displacement in pretrained face embeddings across geometrically \\\"\\n\",\"        \\\"defined illumination-direction groups.\\\"\\n\",\"    ),\\n\",\"    \\\"unverified_novelty_questions\\\": [\\n\",\"        \\\"Has this exact identity-level paired design been used previously?\\\",\\n\",\"        \\\"Have prior studies compared Euclidean and cosine displacement across the same geometric lighting groups?\\\",\\n\",\"        \\\"Have comparable studies reported identity-level consistency using repeated illumination captures?\\\",\\n\",\"        \\\"Does the specific combination of dataset, model, grouping and statistical analysis provide a distinct empirical contribution?\\\"\\n\",\"    ],\\n\",\"    \\\"limitations\\\": [\\n\",\"        \\\"This is not an exhaustive systematic literature review.\\\",\\n\",\"        \\\"Full bibliographic details for the 2025 Local Sliced Wasserstein study require verification.\\\",\\n\",\"        \\\"No new detector or mitigation method is demonstrated.\\\",\\n\",\"        \\\"The experiment does not establish recognition accuracy, fairness or deployment readiness.\\\"\\n\",\"    ]\\n\",\"}\\n\",\"\\n\",\"with OUTPUT_FILE.open(\\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    json.dump(report, f, indent=2)\\n\",\"\\n\",\"with OUTPUT_FILE.open(\\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    verified = json.load(f)\\n\",\"\\n\",\"assert verified[\\\"literature_count\\\"] == 8\\n\",\"assert verified[\\\"novelty_status\\\"] == \\\"NOT_ESTABLISHED\\\"\\n\",\"\\n\",\"print(\\\"=\\\" * 85)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.2.1\\\")\\n\",\"print(\\\"PRELIMINARY LITERATURE BASELINE\\\")\\n\",\"print(\\\"=\\\" * 85)\\n\",\"print(\\\"Literature records:\\\", verified[\\\"literature_count\\\"])\\n\",\"print(\\\"Search status:\\\", verified[\\\"literature_search_status\\\"])\\n\",\"print(\\\"Novelty status:\\\", verified[\\\"novelty_status\\\"])\\n\",\"print(\\\"Output:\\\", OUTPUT_FILE)\\n\",\"print(\\\"JSON reload: PASS\\\")\\n\",\"print(\\\"=\\\" * 85)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"gjIy0oRIzXEV\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794387049011,\"user_tz\":360,\"elapsed\":122,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"2cdb42fd-8515-4dfa-ec0e-efdd4f3658bc\"},\"execution_count\":26,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"=====================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.2.1\\n\",\"PRELIMINARY LITERATURE BASELINE\\n\",\"=====================================================================================\\n\",\"Literature records: 8\\n\",\"Search status: PRELIMINARY_NOT_SYSTEMATIC\\n\",\"Novelty status: NOT_ESTABLISHED\\n\",\"Output: /content/drive/MyDrive/Experiment_20_Results/step_3_2/experiment20_step321_preliminary_literature_baseline.json\\n\",\"JSON reload: PASS\\n\",\"=====================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.2.2\\n\",\"## Closest Prior Studies and Methodological Comparison\\n\",\"\\n\",\"### Objective\\n\",\"Compare the closest identified studies with the actual\\n\",\"methodology of Experiment 20.\\n\",\"\\n\",\"### Main findings\\n\",\"- Yale B illumination evaluation is well established.\\n\",\"- Angular illumination grouping is established.\\n\",\"- Identity-specific illumination subspaces have been studied.\\n\",\"- Illumination-invariant handcrafted and transport-based\\n\",\"  representations already exist.\\n\",\"- Modern deep face-verification robustness under low light\\n\",\"  has also been investigated.\\n\",\"\\n\",\"### Potential distinction\\n\",\"Experiment 20 uses a fixed pretrained InceptionResnetV1\\n\",\"FaceNet representation and evaluates paired identity-level\\n\",\"embedding displacement from a common reference capture\\n\",\"across three illumination-direction groups.\\n\",\"\\n\",\"### Novelty status\\n\",\"POTENTIALLY_DISTINCT_EMPIRICAL_DESIGN_NOT_ESTABLISHED.\\n\",\"\\n\",\"### Main limitations\\n\",\"- One reference embedding per identity.\\n\",\"- No identity-conditioned covariance estimation.\\n\",\"- No independent model validation.\\n\",\"- No recognition accuracy or verification-performance evaluation.\\n\",\"- No calibrated drift detector.\"],\"metadata\":{\"id\":\"F9S8TTLbzplI\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"OUTPUT_DIR = BASE / \\\"step_3_2\\\"\\n\",\"OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"OUTPUT_FILE = (\\n\",\"    OUTPUT_DIR /\\n\",\"    \\\"experiment20_step322_closest_study_comparison.json\\\"\\n\",\")\\n\",\"\\n\",\"studies = [\\n\",\"    {\\n\",\"        \\\"authors\\\": \\\"Zhichao and Er Meng Joo\\\",\\n\",\"        \\\"year\\\": 2012,\\n\",\"        \\\"title\\\": \\\"Local Relation Map: A Novel Illumination Invariant Face Recognition Approach\\\",\\n\",\"        \\\"doi\\\": \\\"10.5772/51667\\\",\\n\",\"        \\\"url\\\": \\\"https://doi.org/10.5772/51667\\\",\\n\",\"        \\\"dataset\\\": \\\"Yale B, Extended Yale B, CMU-PIE\\\",\\n\",\"        \\\"method\\\": \\\"Handcrafted local relation map and DCT-based illumination handling\\\",\\n\",\"        \\\"evaluation\\\": \\\"Face recognition performance\\\",\\n\",\"        \\\"overlap\\\": \\\"Yale B illumination evaluation and angular lighting subsets\\\",\\n\",\"        \\\"difference\\\": \\\"Does not use the Experiment 20 fixed FaceNet embedding displacement design.\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"authors\\\": \\\"Mohammad Reza Faraji and Xiaojun Qi\\\",\\n\",\"        \\\"year\\\": 2015,\\n\",\"        \\\"title\\\": \\\"Face recognition under varying illumination based on adaptive homomorphic eight local directional patterns\\\",\\n\",\"        \\\"doi\\\": \\\"10.1049/iet-cvi.2014.0200\\\",\\n\",\"        \\\"url\\\": \\\"https://doi.org/10.1049/iet-cvi.2014.0200\\\",\\n\",\"        \\\"dataset\\\": \\\"Yale B, Extended Yale B, CMU-PIE\\\",\\n\",\"        \\\"method\\\": \\\"Adaptive homomorphic filtering and directional local patterns\\\",\\n\",\"        \\\"evaluation\\\": \\\"Recognition accuracy across angular illumination subsets\\\",\\n\",\"        \\\"overlap\\\": \\\"Light-source angular grouping and Yale B evaluation\\\",\\n\",\"        \\\"difference\\\": \\\"Focuses on illumination compensation and handcrafted descriptors, not paired deep-embedding displacement.\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"authors\\\": \\\"J. Ross Beveridge et al.\\\",\\n\",\"        \\\"year\\\": 2009,\\n\",\"        \\\"title\\\": \\\"Principal angles separate subject illumination spaces in YDB and CMU-PIE\\\",\\n\",\"        \\\"doi\\\": \\\"10.1109/TPAMI.2008.200\\\",\\n\",\"        \\\"url\\\": \\\"https://doi.org/10.1109/TPAMI.2008.200\\\",\\n\",\"        \\\"dataset\\\": \\\"Yale Face Database B and CMU-PIE\\\",\\n\",\"        \\\"method\\\": \\\"Illumination subspaces and principal angles\\\",\\n\",\"        \\\"evaluation\\\": \\\"Matching subject image sets\\\",\\n\",\"        \\\"overlap\\\": \\\"Identity-specific illumination variation and geometric analysis\\\",\\n\",\"        \\\"difference\\\": \\\"Uses subspace geometry rather than displacement from a single reference embedding.\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"authors\\\": \\\"Yan Zhuang et al.\\\",\\n\",\"        \\\"year\\\": 2025,\\n\",\"        \\\"title\\\": \\\"Local Sliced Wasserstein Feature Sets for Illumination Invariant Face Recognition\\\",\\n\",\"        \\\"doi\\\": \\\"10.1016/j.patcog.2025.111381\\\",\\n\",\"        \\\"url\\\": \\\"https://doi.org/10.1016/j.patcog.2025.111381\\\",\\n\",\"        \\\"dataset\\\": \\\"Extended Yale Face Database B, AR, CAS-PEAL\\\",\\n\",\"        \\\"method\\\": \\\"Local gradient distributions and Radon Cumulative Distribution Transform\\\",\\n\",\"        \\\"evaluation\\\": \\\"Illumination-invariant face recognition\\\",\\n\",\"        \\\"overlap\\\": \\\"Deep interest in representation behaviour under illumination\\\",\\n\",\"        \\\"difference\\\": \\\"Develops a new invariant representation rather than evaluating a fixed pretrained FaceNet representation.\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"authors\\\": \\\"Wahyudi, Sunaryono, Subakti and Siswantoro\\\",\\n\",\"        \\\"year\\\": 2026,\\n\",\"        \\\"title\\\": \\\"A low-light robustness framework for face verification with enhancement-based recovery\\\",\\n\",\"        \\\"doi\\\": \\\"10.1016/j.array.2026.100968\\\",\\n\",\"        \\\"url\\\": \\\"https://doi.org/10.1016/j.array.2026.100968\\\",\\n\",\"        \\\"dataset\\\": \\\"LFW, AgeDB-30, CALFW and CPLFW\\\",\\n\",\"        \\\"method\\\": \\\"Low-light degradation, face-verification backbones and enhancement\\\",\\n\",\"        \\\"evaluation\\\": \\\"Verification performance under multiple low-light conditions\\\",\\n\",\"        \\\"overlap\\\": \\\"Modern deep face representations under illumination changes\\\",\\n\",\"        \\\"difference\\\": \\\"Evaluates verification and enhancement, not Yale B identity-level displacement across lighting geometry groups.\\\"\\n\",\"    }\\n\",\"]\\n\",\"\\n\",\"report = {\\n\",\"    \\\"experiment\\\": 20,\\n\",\"    \\\"step\\\": \\\"3.2.2\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"review_type\\\": \\\"closest_study_methodological_comparison\\\",\\n\",\"    \\\"literature_count\\\": len(studies),\\n\",\"    \\\"studies\\\": studies,\\n\",\"    \\\"established_prior_art\\\": [\\n\",\"        \\\"Yale B illumination evaluation\\\",\\n\",\"        \\\"Angular illumination grouping\\\",\\n\",\"        \\\"Identity-specific illumination subspace analysis\\\",\\n\",\"        \\\"Illumination-invariant handcrafted representations\\\",\\n\",\"        \\\"Transport-based illumination-invariant representations\\\",\\n\",\"        \\\"Modern deep face-verification evaluation under low light\\\"\\n\",\"    ],\\n\",\"    \\\"potential_experiment20_distinction\\\": (\\n\",\"        \\\"Paired identity-level descriptive analysis of Euclidean \\\"\\n\",\"        \\\"and cosine displacement in a fixed pretrained FaceNet \\\"\\n\",\"        \\\"embedding space, using a common reference capture and \\\"\\n\",\"        \\\"three geometrically defined illumination-direction groups.\\\"\\n\",\"    ),\\n\",\"    \\\"novelty_status\\\": \\\"POTENTIALLY_DISTINCT_EMPIRICAL_DESIGN_NOT_ESTABLISHED\\\",\\n\",\"    \\\"limitations\\\": [\\n\",\"        \\\"One reference embedding per identity.\\\",\\n\",\"        \\\"No identity-conditioned covariance estimation.\\\",\\n\",\"        \\\"No independent model validation.\\\",\\n\",\"        \\\"No recognition accuracy or verification-performance evaluation.\\\",\\n\",\"        \\\"No calibrated drift detector.\\\",\\n\",\"        \\\"The exact pretrained model-weight checksum is unavailable.\\\"\\n\",\"    ],\\n\",\"    \\\"next_action\\\": (\\n\",\"        \\\"Determine whether the paired identity-level deep-embedding \\\"\\n\",\"        \\\"displacement design has already been evaluated in prior work.\\\"\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"with OUTPUT_FILE.open(\\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    json.dump(report, f, indent=2)\\n\",\"\\n\",\"with OUTPUT_FILE.open(\\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    verified = json.load(f)\\n\",\"\\n\",\"assert verified[\\\"literature_count\\\"] == 5\\n\",\"assert verified[\\\"novelty_status\\\"] == (\\n\",\"    \\\"POTENTIALLY_DISTINCT_EMPIRICAL_DESIGN_NOT_ESTABLISHED\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"=\\\" * 85)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.2.2\\\")\\n\",\"print(\\\"CLOSEST-STUDY COMPARISON\\\")\\n\",\"print(\\\"=\\\" * 85)\\n\",\"print(\\\"Studies compared:\\\", verified[\\\"literature_count\\\"])\\n\",\"print(\\\"Prior-art themes:\\\", len(verified[\\\"established_prior_art\\\"]))\\n\",\"print(\\\"Novelty status:\\\", verified[\\\"novelty_status\\\"])\\n\",\"print(\\\"Output:\\\", OUTPUT_FILE)\\n\",\"print(\\\"JSON reload: PASS\\\")\\n\",\"print(\\\"=\\\" * 85)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"DMMPnQf_zynK\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794387162441,\"user_tz\":360,\"elapsed\":223,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"30748849-7675-4868-d182-f3c93e196ecd\"},\"execution_count\":27,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"=====================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.2.2\\n\",\"CLOSEST-STUDY COMPARISON\\n\",\"=====================================================================================\\n\",\"Studies compared: 5\\n\",\"Prior-art themes: 6\\n\",\"Novelty status: POTENTIALLY_DISTINCT_EMPIRICAL_DESIGN_NOT_ESTABLISHED\\n\",\"Output: /content/drive/MyDrive/Experiment_20_Results/step_3_2/experiment20_step322_closest_study_comparison.json\\n\",\"JSON reload: PASS\\n\",\"=====================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.2.3\\n\",\"## Deep Face Embedding and Illumination Prior-Art Assessment\\n\",\"\\n\",\"### Objective\\n\",\"Evaluate the closest prior work involving:\\n\",\"1. FaceNet and Extended Yale B.\\n\",\"2. Illumination-direction grouping.\\n\",\"3. Within-identity pairwise distances.\\n\",\"4. Embedding-space attribute geometry.\\n\",\"\\n\",\"### Newly verified prior work\\n\",\"\\n\",\"1. Siddique et al. (2025):\\n\",\"   FaceNet features, Extended Yale B, illumination subsets,\\n\",\"   probabilistic illumination enhancement and SVM recognition.\\n\",\"\\n\",\"2. Eight Local Directional Patterns (2014):\\n\",\"   Yale B illumination subsets and within-subject /\\n\",\"   between-subject pairwise L2 distance analysis.\\n\",\"\\n\",\"3. Leroy et al. (2025):\\n\",\"   Geometric analysis of face-recognition embedding spaces\\n\",\"   and image attributes, including illumination.\\n\",\"\\n\",\"### Experiment 20 distinction\\n\",\"A fixed pretrained InceptionResnetV1 representation is used\\n\",\"to calculate displacement from a common reference capture\\n\",\"for each identity across three illumination-direction groups.\\n\",\"\\n\",\"### Novelty conclusion\\n\",\"The broad research problem and several methodological\\n\",\"components are established prior art.\\n\",\"\\n\",\"The precise combination of the Experiment 20 protocol\\n\",\"remains potentially distinctive but has not been established\\n\",\"as novel.\\n\",\"\\n\",\"### Research limitations\\n\",\"- One reference capture per identity.\\n\",\"- Distinct captures rather than exact source-image perturbations.\\n\",\"- One pretrained embedding architecture.\\n\",\"- No recognition-performance evaluation.\\n\",\"- No calibrated drift detector.\\n\",\"\\n\",\"### Next action\\n\",\"Assess whether the present experimental design supports\\n\",\"a standalone empirical paper and identify the minimum\\n\",\"additional experiments needed to strengthen it.\"],\"metadata\":{\"id\":\"h-SSqxMX0c8r\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"OUTPUT_DIR = BASE / \\\"step_3_2\\\"\\n\",\"OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"OUTPUT_FILE = (\\n\",\"    OUTPUT_DIR /\\n\",\"    \\\"experiment20_step323_expanded_prior_art_assessment.json\\\"\\n\",\")\\n\",\"\\n\",\"studies = [\\n\",\"    {\\n\",\"        \\\"authors\\\": \\\"Siddique, Venkat, Newaz and Tajuddin\\\",\\n\",\"        \\\"year\\\": 2025,\\n\",\"        \\\"title\\\": \\\"Robust Single Sample Per Person Face Recognition with Probabilistic Illumination Enhancement\\\",\\n\",\"        \\\"doi\\\": \\\"10.32890/jict2025.24.3.5\\\",\\n\",\"        \\\"url\\\": \\\"https://doi.org/10.32890/jict2025.24.3.5\\\",\\n\",\"        \\\"dataset\\\": \\\"Extended Yale B\\\",\\n\",\"        \\\"subjects\\\": [20, 30],\\n\",\"        \\\"embedding_model\\\": \\\"Pretrained FaceNet\\\",\\n\",\"        \\\"illumination_grouping\\\": \\\"Five light-angle subsets\\\",\\n\",\"        \\\"method\\\": \\\"Probabilistic illumination enhancement, FaceNet feature extraction and SVM classification\\\",\\n\",\"        \\\"primary_outcome\\\": \\\"Recognition accuracy\\\",\\n\",\"        \\\"overlap\\\": \\\"FaceNet, Extended Yale B, illumination grouping and reference/probe evaluation\\\",\\n\",\"        \\\"difference\\\": \\\"Primary contribution is illumination enhancement and recognition performance, not descriptive paired displacement across three groups.\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"authors\\\": \\\"Authors to verify from publisher record\\\",\\n\",\"        \\\"year\\\": 2014,\\n\",\"        \\\"title\\\": \\\"Face recognition under illumination variations based on eight local directional patterns\\\",\\n\",\"        \\\"doi\\\": \\\"10.1049/iet-bmt.2014.0033\\\",\\n\",\"        \\\"url\\\": \\\"https://doi.org/10.1049/iet-bmt.2014.0033\\\",\\n\",\"        \\\"dataset\\\": \\\"Yale B and CMU-PIE\\\",\\n\",\"        \\\"subjects\\\": \\\"10 Yale B subjects in frontal-pose analysis\\\",\\n\",\"        \\\"embedding_model\\\": \\\"Handcrafted ELDP representation\\\",\\n\",\"        \\\"illumination_grouping\\\": \\\"Six subsets based on light-source angle\\\",\\n\",\"        \\\"method\\\": \\\"Pairwise L2 distances and within-subject / between-subject evaluation\\\",\\n\",\"        \\\"primary_outcome\\\": \\\"Recognition accuracy and distance-based discrimination criterion\\\",\\n\",\"        \\\"overlap\\\": \\\"Yale B angular illumination groups and within-identity pairwise distance analysis\\\",\\n\",\"        \\\"difference\\\": \\\"Uses handcrafted transformed images rather than a fixed pretrained FaceNet embedding.\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"authors\\\": \\\"Leroy, Mastropietro, Nurisso and Vaccarino\\\",\\n\",\"        \\\"year\\\": 2025,\\n\",\"        \\\"title\\\": \\\"Attributes Shape the Embedding Space of Face Recognition Models\\\",\\n\",\"        \\\"doi\\\": None,\\n\",\"        \\\"url\\\": \\\"https://proceedings.mlr.press/v267/leroy25a.html\\\",\\n\",\"        \\\"dataset\\\": \\\"Controlled attribute/model evaluation; verify detailed datasets in full paper\\\",\\n\",\"        \\\"subjects\\\": \\\"Not recorded in this summary\\\",\\n\",\"        \\\"embedding_model\\\": \\\"Multiple face-recognition models, including FaceNet\\\",\\n\",\"        \\\"illumination_grouping\\\": \\\"Image-attribute geometric analysis\\\",\\n\",\"        \\\"method\\\": \\\"Embedding-space geometry and invariance-energy analysis\\\",\\n\",\"        \\\"primary_outcome\\\": \\\"Attribute dependence and representation invariance\\\",\\n\",\"        \\\"overlap\\\": \\\"Direct study of illumination effects in face-recognition embedding geometry\\\",\\n\",\"        \\\"difference\\\": \\\"Does not use the exact Experiment 20 Yale B reference-capture and three-group paired protocol.\\\"\\n\",\"    }\\n\",\"]\\n\",\"\\n\",\"report = {\\n\",\"    \\\"experiment\\\": 20,\\n\",\"    \\\"step\\\": \\\"3.2.3\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"review_type\\\": \\\"expanded_deep_embedding_illumination_prior_art\\\",\\n\",\"    \\\"studies\\\": studies,\\n\",\"    \\\"prior_art_conclusions\\\": [\\n\",\"        \\\"FaceNet has already been applied to Extended Yale B illumination evaluation.\\\",\\n\",\"        \\\"Yale B illumination-direction grouping is established.\\\",\\n\",\"        \\\"Within-subject and between-subject pairwise L2 distance analysis is established.\\\",\\n\",\"        \\\"Illumination-related geometric structure in face-recognition embedding spaces has been studied.\\\"\\n\",\"    ],\\n\",\"    \\\"potential_distinction\\\": (\\n\",\"        \\\"The exact combination of a common reference capture per identity, \\\"\\n\",\"        \\\"distinct illumination-condition captures, three geometric groups, \\\"\\n\",\"        \\\"and paired identity-level Euclidean and cosine displacement analysis.\\\"\\n\",\"    ),\\n\",\"    \\\"novelty_status\\\": \\\"NOT_ESTABLISHED\\\",\\n\",\"    \\\"recommended_positioning\\\": (\\n\",\"        \\\"A focused empirical study of identity-level embedding displacement \\\"\\n\",\"        \\\"under illumination-direction variation, without claiming a new \\\"\\n\",\"        \\\"recognition algorithm or drift detector.\\\"\\n\",\"    ),\\n\",\"    \\\"critical_limitation\\\": (\\n\",\"        \\\"Distinct captures mean that observed embedding displacement cannot \\\"\\n\",\"        \\\"be attributed exclusively to illumination.\\\"\\n\",\"    ),\\n\",\"    \\\"next_step\\\": (\\n\",\"        \\\"Assess standalone paper viability and identify the minimum additional \\\"\\n\",\"        \\\"experiments required to strengthen the empirical contribution.\\\"\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"with OUTPUT_FILE.open(\\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    json.dump(report, f, indent=2)\\n\",\"\\n\",\"with OUTPUT_FILE.open(\\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    verified = json.load(f)\\n\",\"\\n\",\"assert len(verified[\\\"studies\\\"]) == 3\\n\",\"assert verified[\\\"novelty_status\\\"] == \\\"NOT_ESTABLISHED\\\"\\n\",\"\\n\",\"print(\\\"=\\\" * 85)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.2.3\\\")\\n\",\"print(\\\"EXPANDED PRIOR-ART ASSESSMENT\\\")\\n\",\"print(\\\"=\\\" * 85)\\n\",\"print(\\\"Studies assessed:\\\", len(verified[\\\"studies\\\"]))\\n\",\"print(\\\"Novelty status:\\\", verified[\\\"novelty_status\\\"])\\n\",\"print(\\\"Prior-art conclusions:\\\", len(verified[\\\"prior_art_conclusions\\\"]))\\n\",\"print(\\\"Output:\\\", OUTPUT_FILE)\\n\",\"print(\\\"JSON reload: PASS\\\")\\n\",\"print(\\\"=\\\" * 85)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"bt-Nu0rW0fQ0\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794387345054,\"user_tz\":360,\"elapsed\":86,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"379a376b-03ce-4cac-9e97-0ead830c8ede\"},\"execution_count\":28,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"=====================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.2.3\\n\",\"EXPANDED PRIOR-ART ASSESSMENT\\n\",\"=====================================================================================\\n\",\"Studies assessed: 3\\n\",\"Novelty status: NOT_ESTABLISHED\\n\",\"Prior-art conclusions: 4\\n\",\"Output: /content/drive/MyDrive/Experiment_20_Results/step_3_2/experiment20_step323_expanded_prior_art_assessment.json\\n\",\"JSON reload: PASS\\n\",\"=====================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.2.4\\n\",\"## Publication Viability and Additional Experiment Requirements\\n\",\"\\n\",\"### Current assessment\\n\",\"The current experiment provides a coherent descriptive analysis,\\n\",\"but its standalone novelty and publication strength are limited.\\n\",\"\\n\",\"### Strategy A — Descriptive empirical study\\n\",\"- Retain current results.\\n\",\"- Write a carefully scoped empirical manuscript.\\n\",\"- No additional model evaluation.\\n\",\"\\n\",\"Assessment: Limited contribution.\\n\",\"\\n\",\"### Strategy B — Multi-model robustness evaluation\\n\",\"- Retain the existing FaceNet analysis.\\n\",\"- Evaluate at least two additional pretrained face-recognition models.\\n\",\"- Use the same frozen image cohort and identity-condition structure.\\n\",\"- Compare Euclidean and cosine embedding displacement.\\n\",\"- Add a properly designed recognition or verification evaluation.\\n\",\"- Examine cross-model consistency of illumination-group effects.\\n\",\"\\n\",\"Assessment: Recommended immediate publication direction.\\n\",\"\\n\",\"### Strategy C — Biometric drift methodology\\n\",\"- Multiple reference captures per identity.\\n\",\"- Controlled temporal or sequential drift conditions.\\n\",\"- Drift detector implementation.\\n\",\"- Calibration and false-alarm evaluation.\\n\",\"- Detection delay and sensitivity analysis.\\n\",\"- Cross-model and cross-dataset evaluation.\\n\",\"\\n\",\"Assessment: Higher research potential, but requires substantial new experiments.\\n\",\"\\n\",\"### Selected provisional direction\\n\",\"STRATEGY_B_MULTI_MODEL_ROBUSTNESS_EVALUATION\\n\",\"\\n\",\"### Important restrictions\\n\",\"- No novelty claim until additional literature review is complete.\\n\",\"- Do not claim that the current experiment implements a drift detector.\\n\",\"- Do not claim recognition robustness from displacement statistics alone.\\n\",\"- Preserve the existing Experiment 20 results as a frozen baseline.\"],\"metadata\":{\"id\":\"YciC_9Kv09zb\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"from datetime import datetime, timezone\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"OUTPUT_DIR = BASE / \\\"step_3_2\\\"\\n\",\"OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"OUTPUT_FILE = (\\n\",\"    OUTPUT_DIR /\\n\",\"    \\\"experiment20_step324_publication_viability_assessment.json\\\"\\n\",\")\\n\",\"\\n\",\"strategies = [\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"A\\\",\\n\",\"        \\\"name\\\": \\\"Descriptive empirical study\\\",\\n\",\"        \\\"additional_work\\\": [\\n\",\"            \\\"Manuscript preparation\\\",\\n\",\"            \\\"Careful literature positioning\\\",\\n\",\"            \\\"Transparent limitations\\\"\\n\",\"        ],\\n\",\"        \\\"assessment\\\": \\\"LIMITED_CONTRIBUTION\\\",\\n\",\"        \\\"selected\\\": False\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"B\\\",\\n\",\"        \\\"name\\\": \\\"Multi-model robustness evaluation\\\",\\n\",\"        \\\"additional_work\\\": [\\n\",\"            \\\"Evaluate at least two additional pretrained face-recognition architectures\\\",\\n\",\"            \\\"Preserve the same frozen image cohort and identity-condition structure\\\",\\n\",\"            \\\"Compare Euclidean and cosine embedding displacement\\\",\\n\",\"            \\\"Add a properly designed recognition or verification evaluation\\\",\\n\",\"            \\\"Compare illumination-group ordering across architectures\\\",\\n\",\"            \\\"Document model-specific preprocessing and checkpoint provenance\\\"\\n\",\"        ],\\n\",\"        \\\"assessment\\\": \\\"RECOMMENDED_IMMEDIATE_DIRECTION\\\",\\n\",\"        \\\"selected\\\": True\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"C\\\",\\n\",\"        \\\"name\\\": \\\"Biometric drift methodology\\\",\\n\",\"        \\\"additional_work\\\": [\\n\",\"            \\\"Multiple reference captures per identity\\\",\\n\",\"            \\\"Controlled temporal or sequential drift conditions\\\",\\n\",\"            \\\"Implement a drift detector\\\",\\n\",\"            \\\"Calibrate thresholds\\\",\\n\",\"            \\\"Evaluate false-alarm rates\\\",\\n\",\"            \\\"Evaluate detection delay and sensitivity\\\",\\n\",\"            \\\"Cross-model and cross-dataset evaluation\\\"\\n\",\"        ],\\n\",\"        \\\"assessment\\\": \\\"HIGHER_POTENTIAL_SUBSTANTIAL_ADDITIONAL_WORK\\\",\\n\",\"        \\\"selected\\\": False\\n\",\"    }\\n\",\"]\\n\",\"\\n\",\"report = {\\n\",\"    \\\"experiment\\\": 20,\\n\",\"    \\\"step\\\": \\\"3.2.4\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"current_publication_assessment\\\": (\\n\",\"        \\\"The existing experiment is a coherent descriptive evaluation, \\\"\\n\",\"        \\\"but standalone novelty and publication strength remain limited.\\\"\\n\",\"    ),\\n\",\"    \\\"strategies\\\": strategies,\\n\",\"    \\\"provisional_selected_strategy\\\": (\\n\",\"        \\\"B_MULTI_MODEL_ROBUSTNESS_EVALUATION\\\"\\n\",\"    ),\\n\",\"    \\\"selection_status\\\": \\\"PROVISIONAL\\\",\\n\",\"    \\\"selection_rationale\\\": (\\n\",\"        \\\"Multi-model evaluation addresses the current single-backbone \\\"\\n\",\"        \\\"limitation and can strengthen the empirical contribution \\\"\\n\",\"        \\\"without requiring a complete drift-detection methodology.\\\"\\n\",\"    ),\\n\",\"    \\\"required_scientific_safeguards\\\": [\\n\",\"        \\\"Do not infer recognition robustness from embedding displacement alone.\\\",\\n\",\"        \\\"Define identity-disjoint or image-disjoint evaluation procedures.\\\",\\n\",\"        \\\"Document preprocessing separately for every model.\\\",\\n\",\"        \\\"Preserve the existing Experiment 20 results as a frozen baseline.\\\",\\n\",\"        \\\"Do not claim a new drift detector.\\\",\\n\",\"        \\\"Reassess novelty after a more complete literature comparison.\\\"\\n\",\"    ],\\n\",\"    \\\"publication_target\\\": \\\"NOT_SELECTED\\\"\\n\",\"}\\n\",\"\\n\",\"with OUTPUT_FILE.open(\\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    json.dump(report, f, indent=2)\\n\",\"\\n\",\"with OUTPUT_FILE.open(\\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    verified = json.load(f)\\n\",\"\\n\",\"assert len(verified[\\\"strategies\\\"]) == 3\\n\",\"assert sum(s[\\\"selected\\\"] for s in verified[\\\"strategies\\\"]) == 1\\n\",\"assert verified[\\\"selection_status\\\"] == \\\"PROVISIONAL\\\"\\n\",\"\\n\",\"print(\\\"=\\\" * 85)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.2.4\\\")\\n\",\"print(\\\"PUBLICATION VIABILITY ASSESSMENT\\\")\\n\",\"print(\\\"=\\\" * 85)\\n\",\"\\n\",\"for strategy in verified[\\\"strategies\\\"]:\\n\",\"    print(\\n\",\"        strategy[\\\"id\\\"],\\n\",\"        \\\"|\\\",\\n\",\"        strategy[\\\"name\\\"],\\n\",\"        \\\"| selected:\\\",\\n\",\"        strategy[\\\"selected\\\"]\\n\",\"    )\\n\",\"\\n\",\"print(\\\"\\\\nProvisional direction:\\\", verified[\\\"provisional_selected_strategy\\\"])\\n\",\"print(\\\"Selection status:\\\", verified[\\\"selection_status\\\"])\\n\",\"print(\\\"Output:\\\", OUTPUT_FILE)\\n\",\"print(\\\"JSON reload: PASS\\\")\\n\",\"print(\\\"=\\\" * 85)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"GEiEPbu41BlP\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794387485523,\"user_tz\":360,\"elapsed\":80,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"61362a72-f039-43d2-95c5-a5b9d88a888f\"},\"execution_count\":29,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"=====================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.2.4\\n\",\"PUBLICATION VIABILITY ASSESSMENT\\n\",\"=====================================================================================\\n\",\"A | Descriptive empirical study | selected: False\\n\",\"B | Multi-model robustness evaluation | selected: True\\n\",\"C | Biometric drift methodology | selected: False\\n\",\"\\n\",\"Provisional direction: B_MULTI_MODEL_ROBUSTNESS_EVALUATION\\n\",\"Selection status: PROVISIONAL\\n\",\"Output: /content/drive/MyDrive/Experiment_20_Results/step_3_2/experiment20_step324_publication_viability_assessment.json\\n\",\"JSON reload: PASS\\n\",\"=====================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.2.5\\n\",\"## Additional Model Feasibility and Runtime Audit\\n\",\"\\n\",\"### Objective\\n\",\"Inspect the current Google Colab environment before selecting\\n\",\"and implementing additional pretrained face-recognition models.\\n\",\"\\n\",\"### Candidate models\\n\",\"1. AdaFace IR-50.\\n\",\"2. InsightFace ArcFace ResNet50 (buffalo_l).\\n\",\"\\n\",\"### Inspection\\n\",\"- GPU availability and type.\\n\",\"- Available RAM and disk space.\\n\",\"- Python and PyTorch versions.\\n\",\"- Relevant installed packages.\\n\",\"- Existing local model-weight caches.\\n\",\"- Existing Experiment 20 embedding archive availability.\\n\",\"\\n\",\"### Restrictions\\n\",\"- Read-only inspection.\\n\",\"- No package installation.\\n\",\"- No model downloads.\\n\",\"- No embedding regeneration.\\n\",\"- No modification of frozen Experiment 20 results.\\n\",\"\\n\",\"### Decision\\n\",\"Model implementation begins only after hardware, package\\n\",\"compatibility, storage and preprocessing feasibility are reviewed.\"],\"metadata\":{\"id\":\"-tyjEhsY1zJw\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import sys\\n\",\"import shutil\\n\",\"import importlib.util\\n\",\"import platform\\n\",\"import json\\n\",\"import hashlib\\n\",\"\\n\",\"print(\\\"=\\\" * 90)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.2.5\\\")\\n\",\"print(\\\"ADDITIONAL MODEL FEASIBILITY AND RUNTIME AUDIT\\\")\\n\",\"print(\\\"=\\\" * 90)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Python environment\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[1] PYTHON ENVIRONMENT\\\")\\n\",\"\\n\",\"print(\\\"Python:\\\", sys.version)\\n\",\"print(\\\"Platform:\\\", platform.platform())\\n\",\"print(\\\"Architecture:\\\", platform.machine())\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Package availability\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[2] PACKAGE AVAILABILITY\\\")\\n\",\"\\n\",\"packages = [\\n\",\"    \\\"torch\\\",\\n\",\"    \\\"torchvision\\\",\\n\",\"    \\\"facenet_pytorch\\\",\\n\",\"    \\\"insightface\\\",\\n\",\"    \\\"onnxruntime\\\",\\n\",\"    \\\"onnxruntime_gpu\\\",\\n\",\"    \\\"cv2\\\",\\n\",\"    \\\"PIL\\\",\\n\",\"    \\\"numpy\\\",\\n\",\"    \\\"pandas\\\",\\n\",\"    \\\"tqdm\\\"\\n\",\"]\\n\",\"\\n\",\"package_status = {}\\n\",\"\\n\",\"for package in packages:\\n\",\"    available = importlib.util.find_spec(package) is not None\\n\",\"    package_status[package] = available\\n\",\"    print(f\\\"{package}: {'AVAILABLE' if available else 'NOT INSTALLED'}\\\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. PyTorch and GPU\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[3] PYTORCH AND GPU\\\")\\n\",\"\\n\",\"gpu_info = {\\n\",\"    \\\"torch_available\\\": False,\\n\",\"    \\\"torch_version\\\": None,\\n\",\"    \\\"cuda_available\\\": False,\\n\",\"    \\\"cuda_version\\\": None,\\n\",\"    \\\"gpu_devices\\\": []\\n\",\"}\\n\",\"\\n\",\"try:\\n\",\"    import torch\\n\",\"\\n\",\"    gpu_info[\\\"torch_available\\\"] = True\\n\",\"    gpu_info[\\\"torch_version\\\"] = torch.__version__\\n\",\"    gpu_info[\\\"cuda_available\\\"] = torch.cuda.is_available()\\n\",\"    gpu_info[\\\"cuda_version\\\"] = torch.version.cuda\\n\",\"\\n\",\"    print(\\\"PyTorch:\\\", torch.__version__)\\n\",\"    print(\\\"CUDA available:\\\", torch.cuda.is_available())\\n\",\"    print(\\\"CUDA version:\\\", torch.version.cuda)\\n\",\"\\n\",\"    if torch.cuda.is_available():\\n\",\"        for i in range(torch.cuda.device_count()):\\n\",\"            props = torch.cuda.get_device_properties(i)\\n\",\"\\n\",\"            device = {\\n\",\"                \\\"index\\\": i,\\n\",\"                \\\"name\\\": props.name,\\n\",\"                \\\"total_memory_gb\\\": round(\\n\",\"                    props.total_memory / (1024 ** 3), 2\\n\",\"                )\\n\",\"            }\\n\",\"\\n\",\"            gpu_info[\\\"gpu_devices\\\"].append(device)\\n\",\"            print(\\\"GPU:\\\", device)\\n\",\"\\n\",\"    else:\\n\",\"        print(\\\"No CUDA GPU detected.\\\")\\n\",\"\\n\",\"except Exception as exc:\\n\",\"    print(\\\"PyTorch inspection error:\\\", repr(exc))\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. RAM\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[4] SYSTEM MEMORY\\\")\\n\",\"\\n\",\"try:\\n\",\"    import psutil\\n\",\"\\n\",\"    memory = psutil.virtual_memory()\\n\",\"\\n\",\"    print(\\\"Total RAM GB:\\\", round(memory.total / (1024 ** 3), 2))\\n\",\"    print(\\\"Available RAM GB:\\\", round(memory.available / (1024 ** 3), 2))\\n\",\"    print(\\\"RAM usage percentage:\\\", memory.percent)\\n\",\"\\n\",\"except Exception as exc:\\n\",\"    print(\\\"RAM inspection unavailable:\\\", repr(exc))\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Disk capacity\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[5] DISK CAPACITY\\\")\\n\",\"\\n\",\"for location in [\\\"/content\\\", \\\"/content/drive/MyDrive\\\"]:\\n\",\"    path = Path(location)\\n\",\"\\n\",\"    if path.exists():\\n\",\"        usage = shutil.disk_usage(path)\\n\",\"\\n\",\"        print(location)\\n\",\"        print(\\\"  Total GB:\\\", round(usage.total / (1024 ** 3), 2))\\n\",\"        print(\\\"  Free GB:\\\", round(usage.free / (1024 ** 3), 2))\\n\",\"\\n\",\"    else:\\n\",\"        print(location, \\\"NOT AVAILABLE\\\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. Existing experiment embedding archive\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[6] EXISTING EXPERIMENT 20 EMBEDDINGS\\\")\\n\",\"\\n\",\"EMBEDDING_FILE = (\\n\",\"    Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"    / \\\"embeddings\\\"\\n\",\"    / \\\"experiment20_croppedyale_facenet_embeddings.npz\\\"\\n\",\")\\n\",\"\\n\",\"if EMBEDDING_FILE.exists():\\n\",\"    digest = hashlib.sha256()\\n\",\"\\n\",\"    with EMBEDDING_FILE.open(\\\"rb\\\") as f:\\n\",\"        for chunk in iter(lambda: f.read(1024 * 1024), b\\\"\\\"):\\n\",\"            digest.update(chunk)\\n\",\"\\n\",\"    print(\\\"Embedding archive:\\\", EMBEDDING_FILE)\\n\",\"    print(\\\"Size MB:\\\", round(EMBEDDING_FILE.stat().st_size / (1024 ** 2), 2))\\n\",\"    print(\\\"SHA256:\\\", digest.hexdigest())\\n\",\"\\n\",\"else:\\n\",\"    print(\\\"Embedding archive not found at expected path.\\\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. Existing model caches\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[7] EXISTING MODEL CACHE\\\")\\n\",\"\\n\",\"cache_roots = [\\n\",\"    Path(\\\"/root/.cache/torch\\\"),\\n\",\"    Path(\\\"/root/.cache/torch/hub/checkpoints\\\"),\\n\",\"    Path(\\\"/root/.insightface\\\"),\\n\",\"    Path(\\\"/content/.cache\\\"),\\n\",\"    Path(\\\"/root/.cache/huggingface\\\")\\n\",\"]\\n\",\"\\n\",\"for root in cache_roots:\\n\",\"    if root.exists():\\n\",\"        print(\\\"\\\\nCache:\\\", root)\\n\",\"\\n\",\"        try:\\n\",\"            entries = list(root.iterdir())[:20]\\n\",\"\\n\",\"            for entry in entries:\\n\",\"                print(\\\" \\\", entry.name)\\n\",\"\\n\",\"        except Exception as exc:\\n\",\"            print(\\\"  Cannot inspect:\\\", repr(exc))\\n\",\"\\n\",\"    else:\\n\",\"        print(\\\"\\\\nCache not present:\\\", root)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 8. Feasibility summary\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 90)\\n\",\"print(\\\"STEP 3.2.5 FEASIBILITY SUMMARY\\\")\\n\",\"print(\\\"=\\\" * 90)\\n\",\"\\n\",\"print(\\\"GPU available:\\\", gpu_info[\\\"cuda_available\\\"])\\n\",\"print(\\\"Installed packages:\\\")\\n\",\"for name, available in package_status.items():\\n\",\"    print(f\\\"  {name}: {available}\\\")\\n\",\"\\n\",\"print(\\\"\\\\nModel downloads performed: NO\\\")\\n\",\"print(\\\"Package installations performed: NO\\\")\\n\",\"print(\\\"Embedding regeneration performed: NO\\\")\\n\",\"print(\\\"Frozen results modified: NO\\\")\\n\",\"\\n\",\"print(\\\"=\\\" * 90)\\n\",\"print(\\\"STEP 3.2.5 COMPLETED\\\")\\n\",\"print(\\\"=\\\" * 90)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"gVYb_8lM18ph\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794387731281,\"user_tz\":360,\"elapsed\":146,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"11dd313d-5974-421b-ca51-548490332479\"},\"execution_count\":30,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"==========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.2.5\\n\",\"ADDITIONAL MODEL FEASIBILITY AND RUNTIME AUDIT\\n\",\"==========================================================================================\\n\",\"\\n\",\"[1] PYTHON ENVIRONMENT\\n\",\"Python: 3.13.18 (main, Oct 26 2026, 15:28:15) [GCC 13.3.0]\\n\",\"Platform: Linux-6.6.159+-x86_64-with-glibc2.39\\n\",\"Architecture: x86_64\\n\",\"\\n\",\"[2] PACKAGE AVAILABILITY\\n\",\"torch: AVAILABLE\\n\",\"torchvision: AVAILABLE\\n\",\"facenet_pytorch: NOT INSTALLED\\n\",\"insightface: NOT INSTALLED\\n\",\"onnxruntime: NOT INSTALLED\\n\",\"onnxruntime_gpu: NOT INSTALLED\\n\",\"cv2: AVAILABLE\\n\",\"PIL: AVAILABLE\\n\",\"numpy: AVAILABLE\\n\",\"pandas: AVAILABLE\\n\",\"tqdm: AVAILABLE\\n\",\"\\n\",\"[3] PYTORCH AND GPU\\n\",\"PyTorch: 2.14.1+cpu\\n\",\"CUDA available: False\\n\",\"CUDA version: None\\n\",\"No CUDA GPU detected.\\n\",\"\\n\",\"[4] SYSTEM MEMORY\\n\",\"Total RAM GB: 12.67\\n\",\"Available RAM GB: 10.21\\n\",\"RAM usage percentage: 19.4\\n\",\"\\n\",\"[5] DISK CAPACITY\\n\",\"/content\\n\",\"  Total GB: 107.72\\n\",\"  Free GB: 107.46\\n\",\"/content/drive/MyDrive\\n\",\"  Total GB: 15.0\\n\",\"  Free GB: 4.59\\n\",\"\\n\",\"[6] EXISTING EXPERIMENT 20 EMBEDDINGS\\n\",\"Embedding archive: /content/drive/MyDrive/Experiment_20_Results/embeddings/experiment20_croppedyale_facenet_embeddings.npz\\n\",\"Size MB: 4.38\\n\",\"SHA256: 127ffb6e71b871ebab9ed10fd8ce5f2b78b9f3971db4075cf14b44f7df2d3c4c\\n\",\"\\n\",\"[7] EXISTING MODEL CACHE\\n\",\"\\n\",\"Cache not present: /root/.cache/torch\\n\",\"\\n\",\"Cache not present: /root/.cache/torch/hub/checkpoints\\n\",\"\\n\",\"Cache not present: /root/.insightface\\n\",\"\\n\",\"Cache not present: /content/.cache\\n\",\"\\n\",\"Cache not present: /root/.cache/huggingface\\n\",\"\\n\",\"==========================================================================================\\n\",\"STEP 3.2.5 FEASIBILITY SUMMARY\\n\",\"==========================================================================================\\n\",\"GPU available: False\\n\",\"Installed packages:\\n\",\"  torch: True\\n\",\"  torchvision: True\\n\",\"  facenet_pytorch: False\\n\",\"  insightface: False\\n\",\"  onnxruntime: False\\n\",\"  onnxruntime_gpu: False\\n\",\"  cv2: True\\n\",\"  PIL: True\\n\",\"  numpy: True\\n\",\"  pandas: True\\n\",\"  tqdm: True\\n\",\"\\n\",\"Model downloads performed: NO\\n\",\"Package installations performed: NO\\n\",\"Embedding regeneration performed: NO\\n\",\"Frozen results modified: NO\\n\",\"==========================================================================================\\n\",\"STEP 3.2.5 COMPLETED\\n\",\"==========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.2.6\\n\",\"## Frozen Image-Cohort and Preprocessing Audit\\n\",\"\\n\",\"### Objective\\n\",\"Inspect the frozen Cropped Extended Yale B dataset and verify\\n\",\"the image cohort available for additional model evaluation.\\n\",\"\\n\",\"### Checks\\n\",\"1. Frozen ZIP integrity and contents.\\n\",\"2. Image count and subject coverage.\\n\",\"3. Availability of the 2,166 common-condition observations.\\n\",\"4. Image dimensions, channels and decoding integrity.\\n\",\"5. Agreement between image metadata and the existing embedding archive.\\n\",\"6. Presence of the reference condition and evaluation conditions.\\n\",\"\\n\",\"### Restrictions\\n\",\"- Read-only inspection.\\n\",\"- No package installation.\\n\",\"- No model downloads.\\n\",\"- No face detection or alignment.\\n\",\"- No embedding regeneration.\\n\",\"- No modification of frozen results.\\n\",\"\\n\",\"### Decision\\n\",\"Use the audit to determine whether additional models can be\\n\",\"evaluated on a consistent image cohort.\"],\"metadata\":{\"id\":\"TGofB9yb2WKD\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"from zipfile import ZipFile\\n\",\"from collections import Counter\\n\",\"from PIL import Image\\n\",\"import numpy as np\\n\",\"import json\\n\",\"import hashlib\\n\",\"\\n\",\"print(\\\"=\\\" * 90)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.2.6\\\")\\n\",\"print(\\\"FROZEN IMAGE-COHORT AND PREPROCESSING AUDIT\\\")\\n\",\"print(\\\"=\\\" * 90)\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"\\n\",\"ZIP_FILE = BASE / \\\"Experiment_20_Stage_2_Frozen_Dataset.zip\\\"\\n\",\"NPZ_FILE = BASE / \\\"embeddings/experiment20_croppedyale_facenet_embeddings.npz\\\"\\n\",\"METADATA_FILE = BASE / \\\"embeddings/experiment20_croppedyale_embedding_metadata.json\\\"\\n\",\"MANIFEST_FILE = BASE / \\\"Experiment_20_Stage_2_Freeze_Manifest.json\\\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Verify files exist\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[1] REQUIRED FILES\\\")\\n\",\"\\n\",\"for path in [ZIP_FILE, NPZ_FILE, METADATA_FILE, MANIFEST_FILE]:\\n\",\"    print(f\\\"{path.name}: {'FOUND' if path.exists() else 'MISSING'}\\\")\\n\",\"\\n\",\"if not all(p.exists() for p in [ZIP_FILE, NPZ_FILE, METADATA_FILE]):\\n\",\"    raise FileNotFoundError(\\\"One or more required frozen files are missing.\\\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. ZIP integrity and contents\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[2] FROZEN ZIP INTEGRITY\\\")\\n\",\"\\n\",\"with ZipFile(ZIP_FILE, \\\"r\\\") as archive:\\n\",\"    bad_member = archive.testzip()\\n\",\"    members = archive.namelist()\\n\",\"\\n\",\"    print(\\\"ZIP test:\\\", \\\"PASS\\\" if bad_member is None else f\\\"FAIL: {bad_member}\\\")\\n\",\"    print(\\\"Total ZIP entries:\\\", len(members))\\n\",\"\\n\",\"    image_members = [\\n\",\"        name for name in members\\n\",\"        if name.lower().endswith((\\\".pgm\\\", \\\".png\\\", \\\".jpg\\\", \\\".jpeg\\\", \\\".bmp\\\"))\\n\",\"    ]\\n\",\"\\n\",\"    print(\\\"Image entries:\\\", len(image_members))\\n\",\"\\n\",\"    print(\\\"\\\\nFirst 15 image paths:\\\")\\n\",\"    for name in image_members[:15]:\\n\",\"        print(\\\" \\\", name)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Load existing embeddings and aligned metadata\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[3] EXISTING EMBEDDING ARCHIVE\\\")\\n\",\"\\n\",\"data = np.load(NPZ_FILE, allow_pickle=False)\\n\",\"\\n\",\"required_arrays = [\\n\",\"    \\\"embeddings\\\",\\n\",\"    \\\"filenames\\\",\\n\",\"    \\\"subjects\\\",\\n\",\"    \\\"subject_numbers\\\",\\n\",\"    \\\"azimuths\\\",\\n\",\"    \\\"elevations\\\",\\n\",\"    \\\"conditions\\\"\\n\",\"]\\n\",\"\\n\",\"missing_arrays = [key for key in required_arrays if key not in data.files]\\n\",\"\\n\",\"print(\\\"Available arrays:\\\", data.files)\\n\",\"print(\\\"Missing required arrays:\\\", missing_arrays)\\n\",\"\\n\",\"if missing_arrays:\\n\",\"    raise ValueError(\\\"Embedding archive does not contain all expected arrays.\\\")\\n\",\"\\n\",\"embeddings = data[\\\"embeddings\\\"]\\n\",\"filenames = data[\\\"filenames\\\"].astype(str)\\n\",\"subjects = data[\\\"subjects\\\"].astype(str)\\n\",\"conditions = data[\\\"conditions\\\"].astype(str)\\n\",\"azimuths = data[\\\"azimuths\\\"]\\n\",\"elevations = data[\\\"elevations\\\"]\\n\",\"\\n\",\"n = len(filenames)\\n\",\"\\n\",\"print(\\\"Embedding shape:\\\", embeddings.shape)\\n\",\"print(\\\"Metadata rows:\\\", n)\\n\",\"print(\\\"Unique subjects:\\\", len(set(subjects)))\\n\",\"print(\\\"Unique conditions:\\\", len(set(conditions)))\\n\",\"print(\\\"Reference condition rows:\\\", int(np.sum(conditions == \\\"A+000E+00\\\")))\\n\",\"\\n\",\"assert all(len(data[key]) == n for key in required_arrays)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Common-condition cohort\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[4] COMMON-CONDITION COHORT\\\")\\n\",\"\\n\",\"subject_condition_counts = Counter(\\n\",\"    zip(subjects.tolist(), conditions.tolist())\\n\",\")\\n\",\"\\n\",\"common_conditions = sorted(\\n\",\"    condition\\n\",\"    for condition in set(conditions)\\n\",\"    if all((subject, condition) in subject_condition_counts\\n\",\"           for subject in set(subjects))\\n\",\")\\n\",\"\\n\",\"common_observations = [\\n\",\"    i for i, condition in enumerate(conditions)\\n\",\"    if condition in common_conditions\\n\",\"]\\n\",\"\\n\",\"evaluation_observations = [\\n\",\"    i for i in common_observations\\n\",\"    if conditions[i] != \\\"A+000E+00\\\"\\n\",\"]\\n\",\"\\n\",\"print(\\\"Subjects:\\\", len(set(subjects)))\\n\",\"print(\\\"Common conditions including reference:\\\", len(common_conditions))\\n\",\"print(\\\"Common-condition observations:\\\", len(common_observations))\\n\",\"print(\\\"Common evaluation observations excluding reference:\\\",\\n\",\"      len(evaluation_observations))\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Match metadata image paths to ZIP entries\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[5] IMAGE PATH MATCHING\\\")\\n\",\"\\n\",\"zip_lookup = {\\n\",\"    Path(name).name: name\\n\",\"    for name in image_members\\n\",\"}\\n\",\"\\n\",\"matched = []\\n\",\"unmatched = []\\n\",\"\\n\",\"for filename in filenames:\\n\",\"    basename = Path(filename).name\\n\",\"\\n\",\"    if basename in zip_lookup:\\n\",\"        matched.append((filename, zip_lookup[basename]))\\n\",\"    else:\\n\",\"        unmatched.append(filename)\\n\",\"\\n\",\"print(\\\"Embedding metadata filenames:\\\", len(filenames))\\n\",\"print(\\\"Matched ZIP images:\\\", len(matched))\\n\",\"print(\\\"Unmatched filenames:\\\", len(unmatched))\\n\",\"\\n\",\"if unmatched:\\n\",\"    print(\\\"First 10 unmatched filenames:\\\")\\n\",\"    for name in unmatched[:10]:\\n\",\"        print(\\\" \\\", name)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. Decode and inspect image properties\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[6] IMAGE DECODING AND DIMENSIONS\\\")\\n\",\"\\n\",\"sample_size = min(100, len(matched))\\n\",\"sample = matched[:sample_size]\\n\",\"\\n\",\"dimension_counts = Counter()\\n\",\"mode_counts = Counter()\\n\",\"decode_failures = []\\n\",\"\\n\",\"with ZipFile(ZIP_FILE, \\\"r\\\") as archive:\\n\",\"    for original_name, zip_name in sample:\\n\",\"        try:\\n\",\"            with archive.open(zip_name) as file:\\n\",\"                image = Image.open(file)\\n\",\"                image.load()\\n\",\"\\n\",\"                dimension_counts[str(image.size)] += 1\\n\",\"                mode_counts[image.mode] += 1\\n\",\"\\n\",\"        except Exception as exc:\\n\",\"            decode_failures.append({\\n\",\"                \\\"filename\\\": original_name,\\n\",\"                \\\"error\\\": repr(exc)\\n\",\"            })\\n\",\"\\n\",\"print(\\\"Sample size:\\\", sample_size)\\n\",\"print(\\\"Dimension counts:\\\", dict(dimension_counts))\\n\",\"print(\\\"Image mode counts:\\\", dict(mode_counts))\\n\",\"print(\\\"Decode failures:\\\", len(decode_failures))\\n\",\"\\n\",\"if decode_failures:\\n\",\"    print(\\\"First decode failures:\\\")\\n\",\"    for item in decode_failures[:5]:\\n\",\"        print(item)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. Metadata JSON inspection\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[7] EMBEDDING METADATA JSON\\\")\\n\",\"\\n\",\"with open(METADATA_FILE, \\\"r\\\") as f:\\n\",\"    metadata = json.load(f)\\n\",\"\\n\",\"print(\\\"Top-level metadata keys:\\\",\\n\",\"      list(metadata.keys()) if isinstance(metadata, dict) else type(metadata))\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 8. Final checks\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 90)\\n\",\"print(\\\"STEP 3.2.6 AUDIT SUMMARY\\\")\\n\",\"print(\\\"=\\\" * 90)\\n\",\"\\n\",\"checks = {\\n\",\"    \\\"ZIP integrity\\\": bad_member is None,\\n\",\"    \\\"Expected embedding dimension\\\": embeddings.ndim == 2 and embeddings.shape[1] == 512,\\n\",\"    \\\"Embedding metadata alignment\\\": all(len(data[key]) == n for key in required_arrays),\\n\",\"    \\\"38 subjects present\\\": len(set(subjects)) == 38,\\n\",\"    \\\"57 common conditions\\\": len(common_conditions) == 57,\\n\",\"    \\\"2166 common observations\\\": len(common_observations) == 2166,\\n\",\"    \\\"2128 common evaluation observations\\\": len(evaluation_observations) == 2128,\\n\",\"    \\\"All metadata filenames matched\\\": len(unmatched) == 0,\\n\",\"    \\\"Sample images decoded\\\": len(decode_failures) == 0\\n\",\"}\\n\",\"\\n\",\"for name, passed in checks.items():\\n\",\"    print(f\\\"{name}: {'PASS' if passed else 'FAIL'}\\\")\\n\",\"\\n\",\"print(\\\"\\\\nPassed:\\\", sum(checks.values()), \\\"/\\\", len(checks))\\n\",\"print(\\\"No installations or downloads performed.\\\")\\n\",\"print(\\\"No existing embeddings modified.\\\")\\n\",\"print(\\\"=\\\" * 90)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"Xt83DJfz2hTi\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794387879697,\"user_tz\":360,\"elapsed\":2269,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"151acf9b-1743-47c1-83aa-9e714b42ffdb\"},\"execution_count\":31,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"==========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.2.6\\n\",\"FROZEN IMAGE-COHORT AND PREPROCESSING AUDIT\\n\",\"==========================================================================================\\n\",\"\\n\",\"[1] REQUIRED FILES\\n\",\"Experiment_20_Stage_2_Frozen_Dataset.zip: FOUND\\n\",\"experiment20_croppedyale_facenet_embeddings.npz: FOUND\\n\",\"experiment20_croppedyale_embedding_metadata.json: FOUND\\n\",\"Experiment_20_Stage_2_Freeze_Manifest.json: FOUND\\n\",\"\\n\",\"[2] FROZEN ZIP INTEGRITY\\n\",\"ZIP test: PASS\\n\",\"Total ZIP entries: 25\\n\",\"Image entries: 0\\n\",\"\\n\",\"First 15 image paths:\\n\",\"\\n\",\"[3] EXISTING EMBEDDING ARCHIVE\\n\",\"Available arrays: ['embeddings', 'filenames', 'subjects', 'subject_numbers', 'azimuths', 'elevations', 'conditions']\\n\",\"Missing required arrays: []\\n\",\"Embedding shape: (2414, 512)\\n\",\"Metadata rows: 2414\\n\",\"Unique subjects: 38\\n\",\"Unique conditions: 64\\n\",\"Reference condition rows: 38\\n\",\"\\n\",\"[4] COMMON-CONDITION COHORT\\n\",\"Subjects: 38\\n\",\"Common conditions including reference: 57\\n\",\"Common-condition observations: 2166\\n\",\"Common evaluation observations excluding reference: 2128\\n\",\"\\n\",\"[5] IMAGE PATH MATCHING\\n\",\"Embedding metadata filenames: 2414\\n\",\"Matched ZIP images: 0\\n\",\"Unmatched filenames: 2414\\n\",\"First 10 unmatched filenames:\\n\",\"  yaleB01_P00A+000E+00.pgm\\n\",\"  yaleB01_P00A+000E+20.pgm\\n\",\"  yaleB01_P00A+000E+45.pgm\\n\",\"  yaleB01_P00A+000E+90.pgm\\n\",\"  yaleB01_P00A+000E-20.pgm\\n\",\"  yaleB01_P00A+000E-35.pgm\\n\",\"  yaleB01_P00A+005E+10.pgm\\n\",\"  yaleB01_P00A+005E-10.pgm\\n\",\"  yaleB01_P00A+010E+00.pgm\\n\",\"  yaleB01_P00A+010E-20.pgm\\n\",\"\\n\",\"[6] IMAGE DECODING AND DIMENSIONS\\n\",\"Sample size: 0\\n\",\"Dimension counts: {}\\n\",\"Image mode counts: {}\\n\",\"Decode failures: 0\\n\",\"\\n\",\"[7] EMBEDDING METADATA JSON\\n\",\"Top-level metadata keys: ['experiment', 'step', 'dataset', 'archive_sha256', 'embedding_archive', 'generation_timestamp_utc', 'software', 'configuration', 'configuration_sha256', 'counts', 'subject_counts', 'condition_counts', 'embedding_validation', 'failures', 'methodological_limitations']\\n\",\"\\n\",\"==========================================================================================\\n\",\"STEP 3.2.6 AUDIT SUMMARY\\n\",\"==========================================================================================\\n\",\"ZIP integrity: PASS\\n\",\"Expected embedding dimension: PASS\\n\",\"Embedding metadata alignment: PASS\\n\",\"38 subjects present: PASS\\n\",\"57 common conditions: PASS\\n\",\"2166 common observations: PASS\\n\",\"2128 common evaluation observations: PASS\\n\",\"All metadata filenames matched: FAIL\\n\",\"Sample images decoded: PASS\\n\",\"\\n\",\"Passed: 8 / 9\\n\",\"No installations or downloads performed.\\n\",\"No existing embeddings modified.\\n\",\"==========================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.2.7\\n\",\"## Frozen ZIP Content and Source-Image Recovery Audit\\n\",\"\\n\",\"### Objective\\n\",\"Determine why the frozen dataset ZIP contains no image files\\n\",\"and whether the original Cropped Yale B images remain available.\\n\",\"\\n\",\"### Inspection\\n\",\"1. List every ZIP entry and its file size.\\n\",\"2. Inspect the freeze manifest and dataset README.\\n\",\"3. Search the Experiment 20 results directory for image archives\\n\",\"   and extracted image directories.\\n\",\"4. Identify whether the original source archive remains available.\\n\",\"5. Compare the discovered files with the 2,414 embedding filenames.\\n\",\"\\n\",\"### Restrictions\\n\",\"- Read-only inspection.\\n\",\"- No extraction or modification.\\n\",\"- No downloads.\\n\",\"- No package installations.\\n\",\"- No embedding regeneration.\\n\",\"\\n\",\"### Decision\\n\",\"Do not begin additional model evaluation until the original\\n\",\"image cohort is recoverable and its provenance is established.\"],\"metadata\":{\"id\":\"5s6nUgBm2wAp\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"from zipfile import ZipFile\\n\",\"import json\\n\",\"import os\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"\\n\",\"ZIP_FILE = BASE / \\\"Experiment_20_Stage_2_Frozen_Dataset.zip\\\"\\n\",\"MANIFEST_FILE = BASE / \\\"Experiment_20_Stage_2_Freeze_Manifest.json\\\"\\n\",\"NPZ_FILE = BASE / \\\"embeddings/experiment20_croppedyale_facenet_embeddings.npz\\\"\\n\",\"\\n\",\"print(\\\"=\\\" * 90)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.2.7\\\")\\n\",\"print(\\\"FROZEN ZIP CONTENT AND SOURCE-IMAGE RECOVERY AUDIT\\\")\\n\",\"print(\\\"=\\\" * 90)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Complete ZIP inventory\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[1] COMPLETE FROZEN ZIP INVENTORY\\\")\\n\",\"\\n\",\"with ZipFile(ZIP_FILE, \\\"r\\\") as archive:\\n\",\"    entries = archive.infolist()\\n\",\"\\n\",\"    for entry in entries:\\n\",\"        print(\\n\",\"            f\\\"{entry.file_size:>12,} bytes | \\\"\\n\",\"            f\\\"{entry.filename}\\\"\\n\",\"        )\\n\",\"\\n\",\"    print(\\\"\\\\nTotal entries:\\\", len(entries))\\n\",\"    print(\\\"Total uncompressed MB:\\\",\\n\",\"          round(sum(e.file_size for e in entries) / (1024 ** 2), 2))\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Inspect freeze manifest\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[2] FREEZE MANIFEST\\\")\\n\",\"\\n\",\"with open(MANIFEST_FILE, \\\"r\\\") as f:\\n\",\"    manifest = json.load(f)\\n\",\"\\n\",\"print(json.dumps(manifest, indent=2)[:15000])\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Inspect ZIP documentation files\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[3] ZIP DOCUMENTATION\\\")\\n\",\"\\n\",\"with ZipFile(ZIP_FILE, \\\"r\\\") as archive:\\n\",\"    text_files = [\\n\",\"        name for name in archive.namelist()\\n\",\"        if name.lower().endswith((\\\".md\\\", \\\".txt\\\", \\\".json\\\"))\\n\",\"    ]\\n\",\"\\n\",\"    for name in text_files:\\n\",\"        print(f\\\"\\\\n--- {name} ---\\\")\\n\",\"\\n\",\"        try:\\n\",\"            content = archive.read(name).decode(\\\"utf-8\\\", errors=\\\"replace\\\")\\n\",\"            print(content[:5000])\\n\",\"        except Exception as exc:\\n\",\"            print(\\\"Could not read:\\\", repr(exc))\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Search Experiment 20 directory\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[4] EXPERIMENT 20 IMAGE AND ARCHIVE INVENTORY\\\")\\n\",\"\\n\",\"image_extensions = {\\n\",\"    \\\".pgm\\\", \\\".png\\\", \\\".jpg\\\", \\\".jpeg\\\", \\\".bmp\\\", \\\".tif\\\", \\\".tiff\\\"\\n\",\"}\\n\",\"\\n\",\"archive_extensions = {\\n\",\"    \\\".zip\\\", \\\".tar\\\", \\\".gz\\\", \\\".7z\\\", \\\".rar\\\"\\n\",\"}\\n\",\"\\n\",\"image_files = []\\n\",\"archive_files = []\\n\",\"candidate_directories = []\\n\",\"\\n\",\"for root, dirs, files in os.walk(BASE):\\n\",\"    current = Path(root)\\n\",\"\\n\",\"    # Avoid excessively large traversal into unrelated folders.\\n\",\"    dirs[:] = [\\n\",\"        d for d in dirs\\n\",\"        if d not in {\\\".git\\\", \\\"__pycache__\\\"}\\n\",\"    ]\\n\",\"\\n\",\"    for filename in files:\\n\",\"        path = current / filename\\n\",\"\\n\",\"        if path.suffix.lower() in image_extensions:\\n\",\"            image_files.append(path)\\n\",\"\\n\",\"        if path.suffix.lower() in archive_extensions:\\n\",\"            archive_files.append(path)\\n\",\"\\n\",\"    for dirname in dirs:\\n\",\"        lower = dirname.lower()\\n\",\"\\n\",\"        if any(term in lower for term in [\\\"yale\\\", \\\"image\\\", \\\"dataset\\\", \\\"crop\\\"]):\\n\",\"            candidate_directories.append(current / dirname)\\n\",\"\\n\",\"print(\\\"Image files found:\\\", len(image_files))\\n\",\"print(\\\"Archive files found:\\\", len(archive_files))\\n\",\"\\n\",\"print(\\\"\\\\nImage file examples:\\\")\\n\",\"for path in image_files[:30]:\\n\",\"    print(path)\\n\",\"\\n\",\"print(\\\"\\\\nArchive files:\\\")\\n\",\"for path in archive_files:\\n\",\"    print(path, \\\"size MB:\\\",\\n\",\"          round(path.stat().st_size / (1024 ** 2), 2))\\n\",\"\\n\",\"print(\\\"\\\\nCandidate directories:\\\")\\n\",\"for path in candidate_directories[:50]:\\n\",\"    print(path)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Inspect likely source archive names and sizes\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[5] SOURCE ARCHIVE CANDIDATES\\\")\\n\",\"\\n\",\"for path in archive_files:\\n\",\"    if path.name != ZIP_FILE.name:\\n\",\"        print({\\n\",\"            \\\"path\\\": str(path),\\n\",\"            \\\"size_bytes\\\": path.stat().st_size,\\n\",\"            \\\"size_mb\\\": round(path.stat().st_size / (1024 ** 2), 2)\\n\",\"        })\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. Inspect embedding filenames\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[6] EXPECTED IMAGE FILENAMES\\\")\\n\",\"\\n\",\"import numpy as np\\n\",\"\\n\",\"data = np.load(NPZ_FILE, allow_pickle=False)\\n\",\"filenames = data[\\\"filenames\\\"].astype(str)\\n\",\"\\n\",\"print(\\\"Expected filenames:\\\", len(filenames))\\n\",\"\\n\",\"for filename in filenames[:20]:\\n\",\"    print(filename)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. Final assessment\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 90)\\n\",\"print(\\\"STEP 3.2.7 SUMMARY\\\")\\n\",\"print(\\\"=\\\" * 90)\\n\",\"\\n\",\"print(\\\"Frozen ZIP:\\\", ZIP_FILE.exists())\\n\",\"print(\\\"ZIP entries:\\\", len(entries))\\n\",\"print(\\\"Image files in Experiment 20 directory:\\\", len(image_files))\\n\",\"print(\\\"Other archives:\\\", len(archive_files))\\n\",\"print(\\\"Source-image recovery status: REQUIRES REVIEW\\\")\\n\",\"\\n\",\"print(\\\"\\\\nNo files extracted.\\\")\\n\",\"print(\\\"No files modified.\\\")\\n\",\"print(\\\"No downloads performed.\\\")\\n\",\"print(\\\"=\\\" * 90)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"S9xRiZPH22EK\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794387962893,\"user_tz\":360,\"elapsed\":265,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"0136f5bb-1253-49a3-8ee4-18538b160c3a\"},\"execution_count\":32,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"==========================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.2.7\\n\",\"FROZEN ZIP CONTENT AND SOURCE-IMAGE RECOVERY AUDIT\\n\",\"==========================================================================================\\n\",\"\\n\",\"[1] COMPLETE FROZEN ZIP INVENTORY\\n\",\"       2,126 bytes | Experiment_20_Stage_2_Frozen_Dataset/README.md\\n\",\"       2,887 bytes | Experiment_20_Stage_2_Frozen_Dataset/SHA256SUMS.txt\\n\",\"  58,493,820 bytes | Experiment_20_Stage_2_Frozen_Dataset/source/CroppedYale.zip\\n\",\"       4,250 bytes | Experiment_20_Stage_2_Frozen_Dataset/embeddings/experiment20_croppedyale_embedding_metadata.json\\n\",\"   4,597,741 bytes | Experiment_20_Stage_2_Frozen_Dataset/embeddings/experiment20_croppedyale_facenet_embeddings.npz\\n\",\"   4,597,741 bytes | Experiment_20_Stage_2_Frozen_Dataset/embeddings/experiment20_embedding_checkpoint.npz\\n\",\"     125,908 bytes | Experiment_20_Stage_2_Frozen_Dataset/embeddings/experiment20_embedding_checkpoint_metadata.json\\n\",\"         527 bytes | Experiment_20_Stage_2_Frozen_Dataset/configuration/experiment20_embedding_generation_config.json\\n\",\"       1,215 bytes | Experiment_20_Stage_2_Frozen_Dataset/audits/experiment20_acquisition_environment_audit.json\\n\",\"         883 bytes | Experiment_20_Stage_2_Frozen_Dataset/audits/experiment20_angular_hemisphere_audit.json\\n\",\"         319 bytes | Experiment_20_Stage_2_Frozen_Dataset/audits/experiment20_aria2_installation_audit.json\\n\",\"       6,711 bytes | Experiment_20_Stage_2_Frozen_Dataset/audits/experiment20_common_illumination_condition_audit.json\\n\",\"     147,772 bytes | Experiment_20_Stage_2_Frozen_Dataset/audits/experiment20_common_illumination_condition_manifest.json\\n\",\"     163,656 bytes | Experiment_20_Stage_2_Frozen_Dataset/audits/experiment20_corrected_illumination_condition_manifest.json\\n\",\"         566 bytes | Expe