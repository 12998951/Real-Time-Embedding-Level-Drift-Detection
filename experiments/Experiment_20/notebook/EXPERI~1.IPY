        "        \"experiment20_step33104_descriptive_statistics_verification.json\",\n",
        "\n",
        "    \"repeated_measures_audit\": STEP3 / \"step_33105\" /\n",
        "        \"experiment20_step33105_repeated_measures_verification.json\",\n",
        "\n",
        "    \"hemisphere_audit\": STEP3 / \"step_33106\" /\n",
        "        \"experiment20_step33106_hemisphere_results_verification.json\"\n",
        "}\n",
        "\n",
        "missing = [\n",
        "    f\"{key}: {path}\"\n",
        "    for key, path in FILES.items()\n",
        "    if not path.is_file()\n",
        "]\n",
        "\n",
        "if missing:\n",
        "    raise FileNotFoundError(\n",
        "        \"Required source files are missing:\\n\"\n",
        "        + \"\\n\".join(missing)\n",
