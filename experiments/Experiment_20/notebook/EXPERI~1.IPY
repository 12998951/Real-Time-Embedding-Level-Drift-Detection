    {
      "cell_type": "code",
      "source": [
        "\n",
        "import os\n",
        "import re\n",
        "import json\n",
        "import hashlib\n",
        "from collections import Counter\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "# ============================================================\n",
        "# PHASE 3.7 — REFERENCES AND CITATION INTEGRITY AUDIT\n",
        "# READ-ONLY AUDIT: DOES NOT MODIFY THE MANUSCRIPT\n",
        "# ============================================================\n",
        "\n",
        "MANUSCRIPT_PATH = (\n",
        "    \"/content/drive/MyDrive/Experiment_20_Results/\"\n",
        "    \"step_3_3/step_3330/\"\n",
        "    \"experiment20_integrated_manuscript_v2.md\"\n",
        ")\n",
        "\n",
        "OUTPUT_DIR = (\n",
        "    \"/content/drive/MyDrive/Experiment_20_Results/\"\n",
        "    \"step_3_7_references_audit\"\n",
        ")\n",
        "\n",
        "REPORT_PATH = os.path.join(\n",
        "    OUTPUT_DIR,\n",
        "    \"experiment20_phase37_reference_citation_audit.json\"\n",
        ")\n",
        "\n",
        "EXPECTED_MANUSCRIPT_SHA256 = (\n",
        "    \"2cc4156af63987fae717c37e997e6478e4253d81f584854fb5fab9f18da5e752\"\n",
        ")\n",
        "\n",
        "os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. Load manuscript and verify integrity\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "if not os.path.isfile(MANUSCRIPT_PATH):\n",
        "    raise FileNotFoundError(\n",
        "        f\"Manuscript not found: {MANUSCRIPT_PATH}\"\n",
        "    )\n",
        "\n",
        "with open(MANUSCRIPT_PATH, \"r\", encoding=\"utf-8\") as f:\n",
        "    manuscript = f.read()\n",
        "\n",
        "manuscript_hash = hashlib.sha256(\n",
        "    manuscript.encode(\"utf-8\")\n",
        ").hexdigest()\n",
        "\n",
        "print(\"=\" * 90)\n",
        "print(\"EXPERIMENT 20 — PHASE 3.7\")\n",
        "print(\"REFERENCES AND CITATION INTEGRITY AUDIT\")\n",
        "print(\"=\" * 90)\n",
        "\n",
        "print(\"\\nManuscript SHA256:\", manuscript_hash)\n",
        "\n",
        "if manuscript_hash == EXPECTED_MANUSCRIPT_SHA256:\n",
        "    print(\"PASS: Manuscript matches the frozen V2 hash.\")\n",
        "else:\n",
        "    print(\"WARNING: Manuscript hash differs from the frozen V2 hash.\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. Locate references / bibliography section\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "heading_pattern = re.compile(\n",
        "    r\"(?im)^#{1,4}\\s*\"\n",
        "    r\"(?:references|bibliography|works cited|literature cited)\"\n",
        "    r\"\\s*$\"\n",
        ")\n",
        "\n",
        "heading_match = heading_pattern.search(manuscript)\n",
        "\n",
        "reference_text = \"\"\n",
        "reference_heading = None\n",
        "reference_start = None\n",
        "\n",
        "if heading_match:\n",
        "    reference_heading = heading_match.group(0).strip()\n",
        "    reference_start = heading_match.start()\n",
        "\n",
        "    next_heading = re.search(\n",
        "        r\"(?m)^#{1,4}\\s+\\S.*$\",\n",
        "        manuscript[heading_match.end():]\n",
        "    )\n",
        "\n",
        "    end_position = (\n",
        "        heading_match.end() + next_heading.start()\n",
        "        if next_heading else len(manuscript)\n",
        "    )\n",
        "\n",
        "    reference_text = manuscript[\n",
        "        heading_match.end():end_position\n",
        "    ].strip()\n",
        "\n",
        "    print(\"\\nPASS: Reference section located.\")\n",
        "    print(\"Heading:\", reference_heading)\n",
        "else:\n",
        "    print(\"\\nREVIEW: No standard References/Bibliography heading found.\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. Extract reference entries\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "reference_entries = []\n",
        "\n",
        "if reference_text:\n",
        "    lines = reference_text.splitlines()\n",
        "    current_entry = []\n",
        "\n",
        "    for line in lines:\n",
        "        stripped = line.strip()\n",
        "\n",
        "        if not stripped:\n",
        "            continue\n",
        "\n",
        "        starts_entry = bool(\n",
        "            re.match(\n",
        "                r\"^(?:\\[\\d+\\]|\\d+[.)]\\s+|[-*]\\s+)\",\n",
        "                stripped\n",
        "            )\n",
        "        )\n",
        "\n",
        "        if starts_entry and current_entry:\n",
        "            reference_entries.append(\n",
        "                \" \".join(current_entry).strip()\n",
        "            )\n",
        "            current_entry = [stripped]\n",
        "        elif starts_entry:\n",
        "            current_entry = [stripped]\n",
        "        elif current_entry:\n",
        "            current_entry.append(stripped)\n",
        "        else:\n",
        "            current_entry = [stripped]\n",
        "\n",
        "    if current_entry:\n",
        "        reference_entries.append(\n",
        "            \" \".join(current_entry).strip()\n",
        "        )\n",
        "\n",
        "print(\"\\nREFERENCE INVENTORY\")\n",
        "print(\"-\" * 90)\n",
        "print(\"Extracted reference entries:\", len(reference_entries))\n",
        "\n",
        "for i, entry in enumerate(reference_entries, 1):\n",
        "    print(f\"\\n[{i}] {entry}\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. Inspect citation patterns in the manuscript body\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "body = (\n",
        "    manuscript[:reference_start]\n",
        "    if reference_start is not None\n",
        "    else manuscript\n",
        ")\n",
        "\n",
        "# Remove headings and keywords from broad citation screening.\n",
        "body_without_headings = re.sub(\n",
        "    r\"(?m)^#{1,6}\\s+.*$\",\n",
        "    \"\",\n",
        "    body\n",
        ")\n",
        "\n",
        "author_year_pattern = re.compile(\n",
        "    r\"\\b[A-Z][A-Za-z'-]+\"\n",
        "    r\"(?:\\s+et\\s+al\\.)?\"\n",
        "    r\"\\s*\\(\\s*(?:19|20)\\d{2}[a-z]?\\s*\\)\"\n",
        ")\n",
        "\n",
        "parenthetical_year_pattern = re.compile(\n",
        "    r\"\\([^()\\n]{0,100}\"\n",
        "    r\"(?:19|20)\\d{2}[a-z]?\"\n",
        "    r\"[^()\\n]{0,100}\\)\"\n",
        ")\n",
        "\n",
        "numeric_citation_pattern = re.compile(\n",
        "    r\"\\[(?:\\d+(?:\\s*[,;–-]\\s*\\d+)*)\\]\"\n",
        ")\n",
        "\n",
        "author_year_citations = sorted(set(\n",
        "    author_year_pattern.findall(body_without_headings)\n",
        "))\n",
        "\n",
        "parenthetical_citations = sorted(set(\n",
        "    parenthetical_year_pattern.findall(body_without_headings)\n",
        "))\n",
        "\n",
        "numeric_citations = sorted(set(\n",
        "    numeric_citation_pattern.findall(body_without_headings)\n",
        "))\n",
        "\n",
        "print(\"\\nIN-TEXT CITATION INVENTORY\")\n",
        "print(\"-\" * 90)\n",
        "print(\"Author-year citations:\", len(author_year_citations))\n",
        "print(\"Parenthetical year patterns:\", len(parenthetical_citations))\n",
        "print(\"Numeric citation patterns:\", len(numeric_citations))\n",
        "\n",
        "if author_year_citations:\n",
        "    print(\"\\nAuthor-year examples:\")\n",
        "    for item in author_year_citations:\n",
        "        print(\"-\", item)\n",
        "\n",
        "if parenthetical_citations:\n",
        "    print(\"\\nParenthetical citation patterns:\")\n",
        "    for item in parenthetical_citations:\n",
        "        print(\"-\", item)\n",
        "\n",
        "if numeric_citations:\n",
        "    print(\"\\nNumeric citation patterns:\")\n",
        "    for item in numeric_citations:\n",
        "        print(\"-\", item)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. Detect potential duplicate reference entries\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "normalised_entries = [\n",
        "    re.sub(r\"[^a-z0-9]\", \"\", entry.lower())\n",
        "    for entry in reference_entries\n",
        "]\n",
        "\n",
        "entry_counts = Counter(normalised_entries)\n",
        "\n",
        "duplicate_entries = [\n",
        "    reference_entries[i]\n",
        "    for i, normalised in enumerate(normalised_entries)\n",
        "    if entry_counts[normalised] > 1\n",
        "]\n",
        "\n",
        "print(\"\\nDUPLICATE CHECK\")\n",
        "print(\"-\" * 90)\n",
        "\n",
        "if duplicate_entries:\n",
        "    print(\"REVIEW: Potential duplicate reference entries found.\")\n",
        "    for entry in duplicate_entries:\n",
        "        print(\"-\", entry)\n",
        "else:\n",
        "    print(\"PASS: No exact normalised duplicate entries detected.\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. Screen entries for potentially missing information\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "incomplete_entries = []\n",
        "\n",
        "for index, entry in enumerate(reference_entries, 1):\n",
        "    issues = []\n",
        "\n",
        "    if not re.search(r\"\\b(?:19|20)\\d{2}\\b\", entry):\n",
        "        issues.append(\"No identifiable publication year\")\n",
        "\n",
        "    if len(entry.split()) < 5:\n",
        "        issues.append(\"Unusually short reference entry\")\n",
        "\n",
        "    if not re.search(\n",
        "        r\"https?://|doi\\s*:|10\\.\\d{4,9}/\",\n",
        "        entry,\n",
        "        flags=re.IGNORECASE\n",
        "    ):\n",
        "        issues.append(\n",
        "            \"No DOI or URL detected; manual review required\"\n",
        "        )\n",
        "\n",
        "    if issues:\n",
        "        incomplete_entries.append({\n",
        "            \"reference_number\": index,\n",
        "            \"entry\": entry,\n",
        "            \"issues\": issues\n",
        "        })\n",
        "\n",
        "print(\"\\nBIBLIOGRAPHIC COMPLETENESS SCREEN\")\n",
        "print(\"-\" * 90)\n",
        "print(\n",
        "    \"Entries requiring manual review:\",\n",
        "    len(incomplete_entries)\n",
        ")\n",
        "\n",
        "for item in incomplete_entries:\n",
        "    print(\n",
        "        f\"\\nReference {item['reference_number']}: \"\n",
        "        f\"{item['entry']}\"\n",
        "    )\n",
        "    for issue in item[\"issues\"]:\n",
        "        print(\"  -\", issue)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. Check common citation-style signals\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "style_signals = {\n",
        "    \"author_year\": bool(author_year_citations or parenthetical_citations),\n",
        "    \"numeric\": bool(numeric_citations),\n",
        "    \"numbered_reference_entries\": any(\n",
        "        re.match(r\"^(?:\\[\\d+\\]|\\d+[.)]\\s+)\", entry)\n",
        "        for entry in reference_entries\n",
        "    )\n",
        "}\n",
        "\n",
        "if style_signals[\"author_year\"] and style_signals[\"numeric\"]:\n",
        "    detected_style = \"Mixed or ambiguous citation signals\"\n",
        "elif style_signals[\"author_year\"]:\n",
        "    detected_style = \"Author-year signals detected\"\n",
        "elif style_signals[\"numeric\"]:\n",
        "    detected_style = \"Numeric citation signals detected\"\n",
        "else:\n",
        "    detected_style = \"Citation style not automatically identifiable\"\n",
        "\n",
        "print(\"\\nCITATION STYLE SCREEN\")\n",
        "print(\"-\" * 90)\n",
        "print(\"Detected signals:\", style_signals)\n",
        "print(\"Screening result:\", detected_style)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 8. Create audit report\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "report = {\n",
        "    \"experiment\": \"Experiment 20\",\n",
        "    \"phase\": \"3.7\",\n",
        "    \"audit\": \"References and Citation Integrity\",\n",
        "    \"timestamp_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "    \"manuscript_path\": MANUSCRIPT_PATH,\n",
        "    \"manuscript_sha256\": manuscript_hash,\n",
        "    \"expected_manuscript_sha256\": EXPECTED_MANUSCRIPT_SHA256,\n",
        "    \"manuscript_hash_matches_frozen_version\": (\n",
        "        manuscript_hash == EXPECTED_MANUSCRIPT_SHA256\n",
        "    ),\n",
        "    \"reference_heading_found\": bool(heading_match),\n",
        "    \"reference_heading\": reference_heading,\n",
        "    \"reference_entry_count\": len(reference_entries),\n",
        "    \"reference_entries\": reference_entries,\n",
        "    \"author_year_citations\": author_year_citations,\n",
        "    \"parenthetical_citation_patterns\": parenthetical_citations,\n",
        "    \"numeric_citation_patterns\": numeric_citations,\n",
        "    \"citation_style_signals\": style_signals,\n",
        "    \"detected_style_screening\": detected_style,\n",
        "    \"potential_duplicate_entries\": duplicate_entries,\n",
        "    \"entries_requiring_manual_review\": incomplete_entries,\n",
        "    \"automated_audit_limitations\": [\n",
        "        \"Citation extraction is pattern-based and may miss valid formats.\",\n",
        "        \"A DOI or URL is not mandatory for every legitimate reference.\",\n",
        "        \"Automated extraction does not verify publication authenticity.\",\n",
        "        \"Automated matching does not establish that a source supports a claim.\",\n",
        "        \"Manual reference-by-reference verification remains necessary.\"\n",
        "    ],\n",
        "    \"manuscript_modified\": False\n",
        "}\n",
        "\n",
        "with open(REPORT_PATH, \"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(report, f, indent=2, ensure_ascii=False)\n",
        "\n",
        "with open(REPORT_PATH, \"rb\") as f:\n",
        "    report_hash = hashlib.sha256(f.read()).hexdigest()\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 9. Final status\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 90)\n",
        "print(\"PHASE 3.7 AUDIT SUMMARY\")\n",
        "print(\"=\" * 90)\n",
        "\n",
        "print(\"Reference section found:\", bool(heading_match))\n",
        "print(\"Reference entries:\", len(reference_entries))\n",
        "print(\"Author-year citation patterns:\", len(author_year_citations))\n",
        "print(\"Numeric citation patterns:\", len(numeric_citations))\n",
        "print(\"Potential duplicates:\", len(duplicate_entries))\n",
        "print(\"Entries requiring manual review:\", len(incomplete_entries))\n",
        "print(\"Manuscript hash matches frozen version:\",\n",
        "      manuscript_hash == EXPECTED_MANUSCRIPT_SHA256)\n",
        "\n",
        "print(\"\\nAudit report:\")\n",
        "print(REPORT_PATH)\n",
        "\n",
        "print(\"\\nAudit report SHA256:\")\n",
        "print(report_hash)\n",
        "\n",
        "print(\"\\nNo manuscript or frozen evidence files were modified.\")\n",
        "print(\"\\nSTATUS: PHASE_3_7_AUTOMATED_AUDIT_COMPLETED\")\n",
        "print(\"MANUAL REFERENCE VERIFICATION STILL REQUIRED\")\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "KIcb4V9xOcdS",
        "outputId": "4aead1fb-da6a-4d40-8c53-ad85be0d818e"
