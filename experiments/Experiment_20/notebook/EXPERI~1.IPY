      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "==========================================================================================\n",
            "EXPERIMENT 20 — PHASE 3.7\n",
            "REFERENCES AND CITATION INTEGRITY AUDIT\n",
