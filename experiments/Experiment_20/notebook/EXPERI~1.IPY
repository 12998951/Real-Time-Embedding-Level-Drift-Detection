        "## EXPERIMENT 20 — STEP 2.6.7: CROPPED YALE B CONTENT AND COVERAGE AUDIT\n",
        "\n",
        "Inspect the downloaded ZIP archive without extracting or modifying it.\n",
        "\n",
        "Audit objectives:\n",
        "1. Count usable PGM face images.\n",
        "2. Identify unique subject directories.\n",
        "3. Count images per subject.\n",
        "4. Identify pose and illumination-condition coverage from filenames.\n",
        "5. Identify missing or malformed image filenames.\n",
        "6. Record archive integrity and SHA256.\n",
        "7. Save a reproducible dataset-content audit.\n",
        "\n",
        "Dataset acceptance remains pending this audit."
      ],
      "metadata": {
        "id": "nlU-UvLLqOo6"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import os\n",
        "import re\n",
        "import json\n",
        "import zipfile\n",
        "import hashlib\n",
        "from collections import Counter, defaultdict\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "ARCHIVE_PATH = \"/content/Experiment20_Downloads/CroppedYale.zip\"\n",
        "\n",
        "AUDIT_DIR = (\n",
        "    \"/content/drive/MyDrive/Experiment_20_Results/dataset_audit\"\n",
        ")\n",
        "\n",
        "AUDIT_PATH = os.path.join(\n",
        "    AUDIT_DIR,\n",
        "    \"experiment20_croppedyale_content_audit.json\"\n",
        ")\n",
        "\n",
        "os.makedirs(AUDIT_DIR, exist_ok=True)\n",
        "\n",
        "print(\"=\" * 75)\n",
        "print(\"EXPERIMENT 20 — STEP 2.6.7: DATASET CONTENT AUDIT\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "if not os.path.isfile(ARCHIVE_PATH):\n",
        "    raise FileNotFoundError(ARCHIVE_PATH)\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 1. ARCHIVE HASH AND INTEGRITY\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"\\n[1] ARCHIVE VALIDATION\")\n",
        "\n",
        "sha256 = hashlib.sha256()\n",
        "\n",
        "with open(ARCHIVE_PATH, \"rb\") as f:\n",
        "    for block in iter(lambda: f.read(4 * 1024 * 1024), b\"\"):\n",
        "        sha256.update(block)\n",
        "\n",
        "archive_hash = sha256.hexdigest()\n",
        "archive_size = os.path.getsize(ARCHIVE_PATH)\n",
        "\n",
        "with zipfile.ZipFile(ARCHIVE_PATH, \"r\") as archive:\n",
        "    bad_member = archive.testzip()\n",
        "    zip_valid = bad_member is None\n",
        "    members = archive.namelist()\n",
        "\n",
        "print(\"Archive size (MB):\", round(archive_size / (1024 ** 2), 2))\n",
        "print(\"SHA256:\", archive_hash)\n",
        "print(\"ZIP integrity:\", zip_valid)\n",
        "print(\"ZIP entries:\", len(members))\n",
        "\n",
        "if not zip_valid:\n",
        "    raise RuntimeError(f\"Corrupt ZIP member: {bad_member}\")\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 2. IDENTIFY IMAGE FILES AND SUBJECTS\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"\\n[2] IMAGE AND SUBJECT INVENTORY\")\n",
        "\n",
        "pgm_files = [\n",
        "    name for name in members\n",
        "    if name.lower().endswith(\".pgm\")\n",
        "]\n",
        "\n",
        "subject_pattern = re.compile(r\"(yaleB\\d+)\", re.IGNORECASE)\n",
        "\n",
        "subject_dirs = set()\n",
        "images_per_subject = Counter()\n",
        "poses_per_subject = defaultdict(set)\n",
        "illuminations_per_subject = defaultdict(set)\n",
        "\n",
        "valid_filename_pattern = re.compile(\n",
        "    r\"^(yaleB\\d+)_P(\\d{2})A([+-]\\d{3})E([+-]\\d{2})\\.pgm$\",\n",
        "    re.IGNORECASE\n",
        ")\n",
        "\n",
        "valid_images = []\n",
        "malformed_images = []\n",
        "\n",
        "for path in pgm_files:\n",
        "    filename = os.path.basename(path)\n",
        "    match = valid_filename_pattern.match(filename)\n",
        "\n",
        "    directory_match = subject_pattern.search(path)\n",
        "\n",
        "    if directory_match:\n",
        "        subject_dirs.add(directory_match.group(1))\n",
        "\n",
        "    if match:\n",
        "        subject, pose, azimuth, elevation = match.groups()\n",
        "\n",
        "        valid_images.append(path)\n",
        "        images_per_subject[subject] += 1\n",
        "        poses_per_subject[subject].add(pose)\n",
        "        illuminations_per_subject[subject].add(\n",
        "            (azimuth, elevation)\n",
        "        )\n",
        "    else:\n",
        "        malformed_images.append(path)\n",
        "\n",
        "subjects = sorted(subject_dirs)\n",
        "\n",
        "print(\"PGM image files:\", len(pgm_files))\n",
        "print(\"Unique subject directories:\", len(subjects))\n",
        "print(\"Filename-valid images:\", len(valid_images))\n",
        "print(\"Malformed/unmatched PGM filenames:\", len(malformed_images))\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 3. PER-SUBJECT COVERAGE\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"\\n[3] PER-SUBJECT IMAGE COUNTS\")\n",
        "\n",
        "for subject in subjects:\n",
        "    print(\n",
        "        subject,\n",
        "        \"| images:\", images_per_subject[subject],\n",
        "        \"| poses:\", len(poses_per_subject[subject]),\n",
        "        \"| illumination combinations:\",\n",
        "        len(illuminations_per_subject[subject])\n",
        "    )\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 4. GLOBAL CONDITION COVERAGE\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"\\n[4] GLOBAL POSE AND ILLUMINATION COVERAGE\")\n",
        "\n",
        "all_poses = set()\n",
        "all_illuminations = set()\n",
        "\n",
        "for subject in subjects:\n",
        "    all_poses.update(poses_per_subject[subject])\n",
        "    all_illuminations.update(illuminations_per_subject[subject])\n",
        "\n",
        "print(\"Unique pose codes:\", sorted(all_poses))\n",
        "print(\"Unique illumination combinations:\", len(all_illuminations))\n",
        "print(\"Illumination combinations:\", sorted(all_illuminations))\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 5. OTHER ARCHIVE CONTENT\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "print(\"\\n[5] OTHER FILE TYPES\")\n",
        "\n",
        "extensions = Counter(\n",
        "    os.path.splitext(name)[1].lower()\n",
        "    for name in members\n",
        "    if not name.endswith(\"/\")\n",
        ")\n",
        "\n",
        "for extension, count in sorted(extensions.items()):\n",
        "    print(repr(extension), count)\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 6. DATASET COVERAGE SUMMARY\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "subject_counts = {\n",
        "    subject: images_per_subject[subject]\n",
        "    for subject in subjects\n",
        "}\n",
        "\n",
        "summary = {\n",
        "    \"step\": \"2.6.7\",\n",
        "    \"timestamp_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "    \"archive_path\": ARCHIVE_PATH,\n",
        "    \"archive_size_bytes\": archive_size,\n",
        "    \"archive_sha256\": archive_hash,\n",
        "    \"zip_integrity_passed\": zip_valid,\n",
        "    \"zip_entry_count\": len(members),\n",
        "    \"pgm_image_count\": len(pgm_files),\n",
        "    \"unique_subject_directory_count\": len(subjects),\n",
        "    \"subject_directories\": subjects,\n",
        "    \"filename_valid_image_count\": len(valid_images),\n",
        "    \"malformed_pgm_count\": len(malformed_images),\n",
        "    \"images_per_subject\": subject_counts,\n",
        "    \"pose_codes\": sorted(all_poses),\n",
        "    \"illumination_condition_count\": len(all_illuminations),\n",
        "    \"illumination_conditions\": [\n",
        "        list(condition) for condition in sorted(all_illuminations)\n",
        "    ],\n",
        "    \"file_extension_counts\": dict(extensions),\n",
        "    \"acceptance_status\": \"PENDING_RESEARCH_DESIGN_COMPATIBILITY_REVIEW\"\n",
        "}\n",
        "\n",
        "with open(AUDIT_PATH, \"w\") as f:\n",
        "    json.dump(summary, f, indent=2)\n",
        "\n",
        "print(\"\\n[6] AUDIT RECORD SAVED\")\n",
        "print(AUDIT_PATH)\n",
        "\n",
        "print(\"\\nCONTENT AUDIT COMPLETE\")\n",
        "print(\"No extraction or source-file modification performed.\")"
      ],
