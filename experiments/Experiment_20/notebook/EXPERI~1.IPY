        "            ),\n",
        "            expected[\"difference\"],\n",
        "            1e-10\n",
        "        ),\n",
        "        \"two_test_holm\": close(\n",
        "            float(row[\"holm_adjusted_p_value\"]),\n",
        "            expected[\"holm\"],\n",
        "            1e-15\n",
        "        )\n",
        "    }\n",
        "\n",
        "    hemisphere_results[metric] = {\n",
        "        \"checks\": comparisons,\n",
        "        \"status\": \"PASS\" if all(comparisons.values()) else \"FAIL\"\n",
        "    }\n",
        "\n",
        "checks[\"hemisphere_comparisons_verified\"] = (\n",
