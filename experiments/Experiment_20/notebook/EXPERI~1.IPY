        "\n",
        "# =====================================================================\n",
        "# EXPERIMENT 20 — PHASE 5.1\n",
        "# CORRECTED FINAL MANUSCRIPT CONSISTENCY REVIEW\n",
        "# VERSION 2 — COMPLETE SINGLE-CELL EXECUTION\n",
        "#\n",
        "# READ-ONLY AUDIT\n",
        "#\n",
        "# No existing manuscript, dataset, figure, statistical result\n",
        "# or historical audit record will be modified.\n",
        "#\n",
        "# Only new timestamped Phase 5.1 reports will be created.\n",
        "# =====================================================================\n",
        "\n",
        "from pathlib import Path\n",
        "from datetime import datetime, timezone\n",
        "from difflib import SequenceMatcher\n",
        "from collections import Counter\n",
        "import hashlib\n",
        "import json\n",
        "import re\n",
        "import os\n",
        "import traceback\n",
        "\n",
        "# =====================================================================\n",
        "# 1. CONFIGURATION\n",
        "# =====================================================================\n",
        "\n",
        "BASE = Path(\n",
        "    \"/content/drive/MyDrive/Experiment_20_Results\"\n",
        ")\n",
        "\n",
        "PHASE45 = BASE / \"step_4_5_statistical_methodology_audit\"\n",
        "PHASE46 = BASE / \"step_4_6_manuscript_reporting_audit\"\n",
        "PHASE47 = BASE / \"step_4_7_final_manuscript_audit\"\n",
        "\n",
        "MANUSCRIPT45 = (\n",
        "    PHASE45 /\n",
        "    \"experiment20_integrated_manuscript_v2_phase45_final.md\"\n",
        ")\n",
        "\n",
        "MANUSCRIPT46 = (\n",
        "    PHASE46 /\n",
        "    \"experiment20_integrated_manuscript_v2_phase46_final.md\"\n",
        ")\n",
        "\n",
        "MANUSCRIPT47 = (\n",
        "    PHASE47 /\n",
        "    \"experiment20_integrated_manuscript_v2_phase47_final.md\"\n",
        ")\n",
        "\n",
        "CONCLUSION_RECORD = (\n",
        "    PHASE47 /\n",
        "    \"experiment20_phase47_conclusion_insertion_record.json\"\n",
        ")\n",
        "\n",
        "PHASE47_AUDIT = (\n",
        "    PHASE47 /\n",
        "    \"experiment20_phase47_final_manuscript_audit.json\"\n",
        ")\n",
        "\n",
        "PHASE46_AUDIT = (\n",
        "    PHASE46 /\n",
        "    \"experiment20_phase46_manuscript_reporting_audit.json\"\n",
        ")\n",
        "\n",
        "PHASE46_CORRECTION = (\n",
        "    PHASE46 /\n",
        "    \"experiment20_phase46_manuscript_correction_verification.json\"\n",
        ")\n",
        "\n",
        "PHASE45_AUDIT = (\n",
        "    PHASE45 /\n",
        "    \"experiment20_phase45_statistical_methodology_audit.json\"\n",
        ")\n",
        "\n",
        "EXPECTED_HASHES = {\n",
        "    \"phase45\": (\n",
        "        \"eb175d98a9018797a712e90614ace8972d2589bc1ecfd54fb59b76bdebf203e3\"\n",
        "    ),\n",
        "    \"phase46\": (\n",
        "        \"35e6943f8dc79ac4f646c93b809430419e2064d7c2dbabd7af4b56159f6a2ac1\"\n",
        "    ),\n",
        "    \"phase47\": (\n",
        "        \"90fc0f20040b11ca3d1f7b22218964015a6a0f707814c8dfcf482c26cdcd620d\"\n",
        "    ),\n",
        "}\n",
        "\n",
        "PROJECT_TITLE = (\n",
        "    \"Experiment 20: Paired Identity-Level Evaluation of \"\n",
        "    \"Within-Identity Embedding Drift Detection Under Multiple \"\n",
        "    \"Controlled Biometric Acquisition Changes\"\n",
        ")\n",
        "\n",
        "EXPECTED_TABLE2_VALUES = [\n",
        "    \"0.307079\",\n",
        "    \"0.716560\",\n",
        "    \"0.409481\",\n",
        "    \"0.175397\",\n",
        "    \"0.562219\",\n",
        "    \"0.386821\",\n",
        "]\n",
        "\n",
        "CORRECTED_AUDITS = {\n",
        "    \"Phase 4.2\": (\n",
        "        BASE / \"step_4_2_pipeline_reproducibility\" /\n",
        "        \"experiment20_phase42_pipeline_reproducibility_audit_corrected.json\"\n",
        "    ),\n",
        "    \"Phase 4.3\": (\n",
        "        BASE / \"step_4_3_displacement_calculation_audit\" /\n",
        "        \"experiment20_phase43_displacement_calculation_audit_corrected.json\"\n",
        "    ),\n",
        "    \"Phase 4.4\": (\n",
        "        BASE / \"step_4_4_statistical_reproducibility\" /\n",
        "        \"experiment20_phase44_statistical_reproducibility_audit_corrected.json\"\n",
        "    ),\n",
        "}\n",
        "\n",
        "REPORT_DIR = BASE / \"step_5_1_final_consistency_review\"\n",
        "\n",
        "# =====================================================================\n",
        "# 2. INITIALISATION\n",
        "# =====================================================================\n",
        "\n",
        "print(\"=\" * 85)\n",
        "print(\"EXPERIMENT 20 — PHASE 5.1\")\n",
        "print(\"CORRECTED FINAL MANUSCRIPT CONSISTENCY REVIEW\")\n",
        "print(\"=\" * 85)\n",
        "\n",
        "if not BASE.exists():\n",
        "    raise FileNotFoundError(\n",
        "        f\"Experiment directory not found: {BASE}. \"\n",
        "        \"Mount Google Drive before running this cell.\"\n",
        "    )\n",
        "\n",
        "if not MANUSCRIPT47.exists():\n",
        "    raise FileNotFoundError(\n",
        "        f\"Phase 4.7 manuscript not found: {MANUSCRIPT47}\"\n",
        "    )\n",
        "\n",
        "REPORT_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "NOW = datetime.now(timezone.utc)\n",
        "STAMP = NOW.strftime(\"%Y%m%dT%H%M%SZ\")\n",
        "\n",
        "JSON_REPORT = REPORT_DIR / (\n",
        "    f\"experiment20_phase51_corrected_audit_{STAMP}.json\"\n",
        ")\n",
        "\n",
        "MD_REPORT = REPORT_DIR / (\n",
        "    f\"experiment20_phase51_corrected_audit_{STAMP}.md\"\n",
        ")\n",
        "\n",
        "if JSON_REPORT.exists() or MD_REPORT.exists():\n",
        "    raise FileExistsError(\n",
        "        \"Report filename already exists. No existing report will be overwritten.\"\n",
        "    )\n",
        "\n",
        "RESULTS = {\n",
        "    \"PASS\": [],\n",
        "    \"REVIEW\": [],\n",
        "    \"FAIL\": [],\n",
        "    \"NOT_VERIFIABLE\": [],\n",
        "}\n",
        "\n",
        "def add(status, name, detail):\n",
        "    RESULTS[status].append({\n",
        "        \"check\": name,\n",
        "        \"detail\": str(detail)\n",
        "    })\n",
        "\n",
        "def sha256(path):\n",
        "    digest = hashlib.sha256()\n",
        "    with open(path, \"rb\") as f:\n",
        "        for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n",
        "            digest.update(chunk)\n",
        "    return digest.hexdigest()\n",
        "\n",
        "def read_text(path):\n",
        "    if not path.exists():\n",
        "        return None\n",
        "    return path.read_text(encoding=\"utf-8\")\n",
        "\n",
        "def read_json(path):\n",
        "    if not path.exists():\n",
        "        return None, \"File not found\"\n",
        "    try:\n",
        "        with open(path, \"r\", encoding=\"utf-8\") as f:\n",
        "            return json.load(f), None\n",
        "    except Exception as e:\n",
        "        return None, str(e)\n",
        "\n",
        "def normalise_markdown(text):\n",
        "    text = text.replace(\"\\r\\n\", \"\\n\").replace(\"\\r\", \"\\n\")\n",
        "    text = re.sub(r\"[ \\t]+$\", \"\", text, flags=re.MULTILINE)\n",
        "    text = re.sub(r\"\\n{3,}\", \"\\n\\n\", text)\n",
        "    return text.strip()\n",
        "\n",
        "def extract_section(text, heading_pattern):\n",
        "    match = re.search(\n",
        "        heading_pattern,\n",
        "        text,\n",
        "        flags=re.IGNORECASE | re.MULTILINE\n",
        "    )\n",
        "\n",
        "    if not match:\n",
        "        return None\n",
        "\n",
        "    start = match.end()\n",
        "\n",
        "    next_heading = re.search(\n",
        "        r\"^#{1,6}\\s+\",\n",
        "        text[start:],\n",
        "        flags=re.MULTILINE\n",
        "    )\n",
        "\n",
        "    end = (\n",
        "        start + next_heading.start()\n",
        "        if next_heading\n",
        "        else len(text)\n",
        "    )\n",
        "\n",
        "    return text[start:end].strip()\n",
        "\n",
        "# =====================================================================\n",
        "# 3. LOAD MANUSCRIPTS\n",
        "# =====================================================================\n",
        "\n",
        "print(\"\\n[1] LOADING MANUSCRIPT VERSIONS\")\n",
        "print(\"-\" * 85)\n",
        "\n",
        "manuscripts = {\n",
        "    \"Phase 4.5\": MANUSCRIPT45,\n",
        "    \"Phase 4.6\": MANUSCRIPT46,\n",
        "    \"Phase 4.7\": MANUSCRIPT47,\n",
        "}\n",
        "\n",
        "TEXTS = {}\n",
        "HASHES = {}\n",
        "\n",
        "for label, path in manuscripts.items():\n",
        "\n",
        "    if not path.exists():\n",
        "\n",
        "        print(\"[UNAVAILABLE]\", label, path)\n",
        "\n",
        "        add(\n",
        "            \"NOT_VERIFIABLE\",\n",
        "            f\"{label} manuscript availability\",\n",
        "            str(path)\n",
        "        )\n",
        "        continue\n",
        "\n",
        "    TEXTS[label] = read_text(path)\n",
        "    HASHES[label] = sha256(path)\n",
        "\n",
        "    print(\"[LOADED]\", label)\n",
        "    print(\"Path:\", path)\n",
        "    print(\"Size:\", path.stat().st_size)\n",
        "    print(\"SHA256:\", HASHES[label])\n",
        "\n",
        "    expected_key = label.lower().replace(\" \", \"\")\n",
        "\n",
        "    if expected_key in EXPECTED_HASHES:\n",
        "\n",
        "        if HASHES[label] == EXPECTED_HASHES[expected_key]:\n",
        "\n",
        "            add(\n",
        "                \"PASS\",\n",
        "                f\"{label} manuscript hash\",\n",
        "                HASHES[label]\n",
        "            )\n",
        "\n",
        "        else:\n",
        "\n",
        "            add(\n",
        "                \"FAIL\",\n",
        "                f\"{label} manuscript hash\",\n",
        "                \"Actual hash differs from the recorded frozen hash.\"\n",
        "            )\n",
        "\n",
        "# =====================================================================\n",
        "# 4. PHASE 4.7 MANUSCRIPT INTEGRITY\n",
        "# =====================================================================\n",
        "\n",
        "print(\"\\n[2] PHASE 4.7 MANUSCRIPT INTEGRITY\")\n",
        "print(\"-\" * 85)\n",
        "\n",
        "TEXT47 = TEXTS[\"Phase 4.7\"]\n",
        "HASH47_BEFORE = HASHES[\"Phase 4.7\"]\n",
        "\n",
        "print(\"Expected SHA256:\", EXPECTED_HASHES[\"phase47\"])\n",
        "print(\"Actual SHA256:  \", HASH47_BEFORE)\n",
        "\n",
        "if HASH47_BEFORE == EXPECTED_HASHES[\"phase47\"]:\n",
        "    add(\"PASS\", \"Phase 4.7 frozen manuscript\", \"SHA256 verified.\")\n",
        "else:\n",
        "    add(\"FAIL\", \"Phase 4.7 frozen manuscript\", \"SHA256 mismatch.\")\n",
        "\n",
        "# =====================================================================\n",
        "# 5. TITLE RECONCILIATION\n",
        "# =====================================================================\n",
        "\n",
        "print(\"\\n[3] PROJECT TITLE AND MANUSCRIPT TITLE\")\n",
        "print(\"-\" * 85)\n",
        "\n",
        "first_h1 = re.search(\n",
        "    r\"(?m)^#\\s+(.+?)\\s*$\",\n",
        "    TEXT47\n",
        ")\n",
        "\n",
        "manuscript_title = (\n",
        "    first_h1.group(1).strip()\n",
        "    if first_h1\n",
        "    else None\n",
        ")\n",
        "\n",
        "print(\"Project title:\")\n",
        "print(PROJECT_TITLE)\n",
        "\n",
        "print(\"\\nManuscript publication title:\")\n",
        "print(manuscript_title)\n",
        "\n",
        "if manuscript_title:\n",
        "\n",
        "    title_lower = manuscript_title.lower()\n",
        "\n",
        "    # The manuscript title is allowed to be narrower than\n",
        "    # the overall experiment/project title.\n",
        "    illumination_scoped = (\n",
        "        \"illumination\" in title_lower\n",
        "        and \"identity-level\" in title_lower\n",
        "    )\n",
        "\n",
        "    if illumination_scoped:\n",
        "\n",
        "        add(\n",
        "            \"PASS\",\n",
        "            \"Manuscript title scope\",\n",
        "            \"The manuscript uses a narrower illumination-focused title consistent with the documented experimental scope.\"\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"\\n[PASS] The manuscript title is treated as the \"\n",
        "            \"publication title, not as a failed match against \"\n",
        "            \"the overall project title.\"\n",
        "        )\n",
        "\n",
        "    else:\n",
        "\n",
        "        add(\n",
        "            \"REVIEW\",\n",
        "            \"Manuscript title scope\",\n",
        "            \"The publication title requires a manual comparison with the actual experimental scope.\"\n",
        "        )\n",
        "\n",
        "else:\n",
        "\n",
        "    add(\n",
        "        \"FAIL\",\n",
        "        \"Manuscript title\",\n",
        "        \"No top-level manuscript title detected.\"\n",
        "    )\n",
        "\n",
        "# Explicitly record that the project title and manuscript title\n",
        "# are separate metadata fields.\n",
        "add(\n",
        "    \"PASS\",\n",
        "    \"Project/publication title distinction\",\n",
        "    \"No manuscript title was changed or overwritten.\"\n",
        ")\n",
        "\n",
        "# =====================================================================\n",
        "# 6. ABSTRACT AND STRUCTURE\n",
        "# =====================================================================\n",
        "\n",
        "print(\"\\n[4] ABSTRACT AND MANUSCRIPT STRUCTURE\")\n",
        "print(\"-\" * 85)\n",
        "\n",
        "abstract = extract_section(\n",
        "    TEXT47,\n",
        "    r\"^#{1,6}\\s*Abstract\\s*$\"\n",
        ")\n",
        "\n",
        "if abstract:\n",
        "\n",
        "    abstract_words = len(abstract.split())\n",
        "\n",
        "    print(\"Abstract word count:\", abstract_words)\n",
        "\n",
        "    if abstract_words >= 50:\n",
        "\n",
        "        add(\n",
        "            \"PASS\",\n",
        "            \"Abstract section\",\n",
        "            f\"{abstract_words} words detected.\"\n",
        "        )\n",
        "\n",
        "    else:\n",
        "\n",
        "        add(\n",
        "            \"REVIEW\",\n",
        "            \"Abstract section\",\n",
        "            f\"Only {abstract_words} words detected.\"\n",
        "        )\n",
        "\n",
        "else:\n",
        "\n",
        "    add(\n",
        "        \"REVIEW\",\n",
        "        \"Abstract section\",\n",
        "        \"Standalone Abstract heading not found.\"\n",
        "    )\n",
        "\n",
        "headings = re.findall(\n",
        "    r\"(?m)^(#{1,6})\\s+(.+?)\\s*$\",\n",
        "    TEXT47\n",
        ")\n",
        "\n",
        "heading_names = [h[1].strip() for h in headings]\n",
        "\n",
        "for heading in heading_names:\n",
        "    print(\"  \", heading)\n",
        "\n",
        "required_sections = {\n",
        "    \"Introduction\": r\"^#\\s+1\\.\\s*Introduction\",\n",
        "    \"Methodology\": r\"^#\\s+2\\.\\s*Methodology\",\n",
        "    \"Results\": r\"^#\\s+3\\.\\s*Results\",\n",
        "    \"Discussion\": r\"^#\\s+4\\.\\s*Discussion\",\n",
        "    \"Conclusion\": r\"^#\\s+5\\.\\s*Conclusion\",\n",
        "    \"References\": r\"^#\\s*References\\s*$\",\n",
        "}\n",
        "\n",
        "for label, pattern in required_sections.items():\n",
        "\n",
        "    found = re.search(\n",
        "        pattern,\n",
        "        TEXT47,\n",
        "        flags=re.IGNORECASE | re.MULTILINE\n",
        "    )\n",
        "\n",
        "    if found:\n",
        "\n",
        "        add(\n",
        "            \"PASS\",\n",
        "            f\"{label} section\",\n",
        "            \"Required top-level section detected.\"\n",
        "        )\n",
        "\n",
        "    else:\n",
        "\n",
        "        add(\n",
        "            \"REVIEW\",\n",
        "            f\"{label} section\",\n",
        "            \"Required top-level section not detected.\"\n",
        "        )\n",
        "\n",
        "# Conclusion must precede References\n",
        "conclusion_position = re.search(\n",
        "    r\"(?m)^#\\s+5\\.\\s*Conclusion\\s*$\",\n",
        "    TEXT47,\n",
        "    flags=re.IGNORECASE\n",
        ")\n",
        "\n",
        "references_position = re.search(\n",
        "    r\"(?m)^#\\s*References\\s*$\",\n",
        "    TEXT47,\n",
        "    flags=re.IGNORECASE\n",
        ")\n",
        "\n",
        "if (\n",
        "    conclusion_position\n",
        "    and references_position\n",
        "    and conclusion_position.start() < references_position.start()\n",
        "):\n",
        "\n",
        "    add(\n",
        "        \"PASS\",\n",
        "        \"Conclusion placement\",\n",
        "        \"Conclusion precedes References.\"\n",
        "    )\n",
        "\n",
        "else:\n",
        "\n",
        "    add(\n",
        "        \"FAIL\",\n",
        "        \"Conclusion placement\",\n",
        "        \"Conclusion and References ordering is incorrect or unavailable.\"\n",
        "    )\n",
        "\n",
        "# =====================================================================\n",
        "# 7. LIMITATIONS SECTION — CONTENT-AWARE CHECK\n",
        "# =====================================================================\n",
        "\n",
        "print(\"\\n[5] DATASET AND METHODOLOGICAL LIMITATIONS\")\n",
        "print(\"-\" * 85)\n",
        "\n",
        "limitations_2_10 = extract_section(\n",
        "    TEXT47,\n",
        "    r\"^##\\s+2\\.10\\s+.*$\"\n",
        ")\n",
        "\n",
        "limitations_4_6 = extract_section(\n",
        "    TEXT47,\n",
        "    r\"^##\\s+4\\.6\\s+.*Limitations.*$\"\n",
        ")\n",
        "\n",
        "limitation_sections = {\n",
        "    \"Methodological limitations (Section 2.10)\": limitations_2_10,\n",
        "    \"Discussion limitations (Section 4.6)\": limitations_4_6,\n",
        "}\n",
        "\n",
        "combined_limitations = \"\\n\".join(\n",
        "    text for text in limitation_sections.values()\n",
        "    if text\n",
        ")\n",
        "\n",
        "for label, section_text in limitation_sections.items():\n",
        "\n",
        "    if section_text:\n",
        "\n",
        "        print(f\"\\n[FOUND] {label}\")\n",
        "        print(\"Words:\", len(section_text.split()))\n",
        "\n",
        "        add(\n",
        "            \"PASS\",\n",
        "            label,\n",
        "            f\"Section exists with {len(section_text.split())} words.\"\n",
        "        )\n",
        "\n",
        "    else:\n",
        "\n",
        "        print(f\"\\n[NOT FOUND] {label}\")\n",
        "\n",
        "        add(\n",
        "            \"REVIEW\",\n",
        "            label,\n",
        "            \"Section not identified using the expected heading.\"\n",
        "        )\n",
        "\n",
        "# Search for substantive limitation themes in the actual sections.\n",
        "limitation_themes = {\n",
        "    \"Dataset provenance\": [\n",
        "        \"provenance\",\n",
        "        \"source\",\n",
        "        \"community-hosted\",\n",
        "        \"torrent\",\n",
        "        \"archive\"\n",
        "    ],\n",
        "    \"Dataset acquisition constraints\": [\n",
        "        \"acquisition\",\n",
        "        \"dataset\",\n",
        "        \"illumination condition\",\n",
        "        \"capture\"\n",
        "    ],\n",
        "    \"Reference capture limitation\": [\n",
        "        \"reference capture\",\n",
        "        \"single reference\",\n",
        "        \"one reference\",\n",
        "        \"reference image\"\n",
        "    ],\n",
        "    \"Architecture limitation\": [\n",
        "        \"single architecture\",\n",
        "        \"one architecture\",\n",
        "        \"single pretrained\",\n",
        "        \"one pretrained\"\n",
        "    ],\n",
        "    \"Preprocessing limitation\": [\n",
        "        \"alignment\",\n",
        "        \"aligned\",\n",
        "        \"mtcnn\",\n",
        "        \"face detection\",\n",
        "        \"preprocessing\"\n",
        "    ],\n",
        "    \"Model-weight provenance\": [\n",
        "        \"model weights\",\n",
        "        \"weight file\",\n",
        "        \"sha256\",\n",
        "        \"checkpoint\"\n",
        "    ],\n",
        "    \"Generalisation limitation\": [\n",
        "        \"generalisation\",\n",
        "        \"generalization\",\n",
        "        \"other architecture\",\n",
        "        \"other datasets\"\n",
        "    ],\n",
        "}\n",
        "\n",
        "combined_lower = combined_limitations.lower()\n",
        "\n",
        "limitation_theme_results = {}\n",
        "\n",
        "for theme, terms in limitation_themes.items():\n",
        "\n",
        "    matched = [\n",
        "        term for term in terms\n",
        "        if term in combined_lower\n",
        "    ]\n",
        "\n",
        "    limitation_theme_results[theme] = {\n",
        "        \"matched\": bool(matched),\n",
        "        \"terms\": matched\n",
        "    }\n",
        "\n",
        "    print(\n",
        "        f\"[{'FOUND' if matched else 'NOT DETECTED'}] {theme}\"\n",
        "    )\n",
        "\n",
        "    if matched:\n",
        "\n",
        "        add(\n",
        "            \"PASS\",\n",
        "            f\"Limitation theme: {theme}\",\n",
        "            matched\n",
        "        )\n",
        "\n",
        "    else:\n",
        "\n",
        "        add(\n",
        "            \"NOT_VERIFIABLE\",\n",
        "            f\"Limitation theme: {theme}\",\n",
        "            \"The automated phrase search did not establish whether this limitation is disclosed.\"\n",
        "        )\n",
        "\n",
        "if not combined_limitations:\n",
        "\n",
        "    add(\n",
        "        \"REVIEW\",\n",
        "        \"Dataset limitations content\",\n",
        "        \"Neither expected limitations section could be extracted.\"\n",
        "    )\n",
        "\n",
        "else:\n",
        "\n",
        "    # Print a limited excerpt so the audit is inspectable.\n",
        "    print(\"\\nLIMITATIONS EXCERPT:\")\n",
        "    print(combined_limitations[:3500])\n",
        "\n",
        "# =====================================================================\n",
        "# 8. PHASE 4.6 / 4.7 CONTENT PRESERVATION\n",
        "# =====================================================================\n",
        "\n",
        "print(\"\\n[6] PHASE 4.6 TO PHASE 4.7 PRESERVATION\")\n",
        "print(\"-\" * 85)\n",
        "\n",
        "if \"Phase 4.6\" in TEXTS:\n",
        "\n",
        "    TEXT46 = TEXTS[\"Phase 4.6\"]\n",
        "\n",
        "    # Remove only the newly inserted Phase 4.7 conclusion\n",
        "    # from a temporary in-memory copy.\n",
        "    #\n",
        "    # No source file is edited.\n",
        "\n",
        "    stripped47, removed_count = re.subn(\n",
        "        r\"(?ms)^#\\s+5\\.\\s*Conclusion\\s*\\n.*?(?=^#\\s*References\\s*$)\",\n",
        "        \"\",\n",
        "        TEXT47,\n",
        "        count=1,\n",
        "        flags=re.IGNORECASE\n",
        "    )\n",
        "\n",
        "    print(\"Conclusion sections removed from temporary copy:\", removed_count)\n",
        "\n",
        "    if removed_count == 1:\n",
        "\n",
        "        normalised46 = normalise_markdown(TEXT46)\n",
        "        normalised47 = normalise_markdown(stripped47)\n",
        "\n",
        "        exact_match = normalised46 == normalised47\n",
        "\n",
        "        similarity = SequenceMatcher(\n",
        "            None,\n",
        "            normalised46,\n",
        "            normalised47\n",
        "        ).ratio()\n",
        "\n",
        "        print(\"Exact normalized content match:\", exact_match)\n",
        "        print(\"Similarity ratio:\", round(similarity, 6))\n",
        "\n",
        "        if exact_match:\n",
        "\n",
        "            add(\n",
        "                \"PASS\",\n",
        "                \"Phase 4.6 content preservation\",\n",
        "                \"After excluding the Phase 4.7 inserted conclusion, the remaining manuscript matches Phase 4.6.\"\n",
        "            )\n",
        "\n",
        "        else:\n",
        "\n",
        "            add(\n",
        "                \"REVIEW\",\n",
        "                \"Phase 4.6 content preservation\",\n",
        "                f\"Content similarity is {similarity:.6f}; inspect remaining differences.\"\n",
        "            )\n",
        "\n",
        "    else:\n",
        "\n",
        "        add(\n",
        "            \"REVIEW\",\n",
        "            \"Phase 4.6 content preservation\",\n",
        "            \"The expected Phase 4.7 conclusion section could not be isolated.\"\n",
        "        )\n",
        "\n",
        "else:\n",
        "\n",
        "    add(\n",
        "        \"NOT_VERIFIABLE\",\n",
        "        \"Phase 4.6 content preservation\",\n",
        "        \"Phase 4.6 manuscript is unavailable.\"\n",
        "    )\n",
        "\n",
        "# =====================================================================\n",
        "# 9. HISTORICAL PHASE 4.7 FAILURE RECONCILIATION\n",
        "# =====================================================================\n",
        "\n",
        "print(\"\\n[7] HISTORICAL PHASE 4.7 AUDIT RECONCILIATION\")\n",
        "print(\"-\" * 85)\n",
        "\n",
        "record_data, record_error = read_json(CONCLUSION_RECORD)\n",
        "old_audit_data, old_audit_error = read_json(PHASE47_AUDIT)\n",
        "\n",
        "if record_data is not None:\n",
        "\n",
        "    print(\"Conclusion insertion status:\", record_data.get(\"status\"))\n",
        "    print(\"Failed checks:\", record_data.get(\"failed_checks\"))\n",
        "    print(\"Source modified:\", record_data.get(\"source_modified\"))\n",
        "    print(\n",
        "        \"Previous phase records modified:\",\n",
        "        record_data.get(\"previous_phase_records_modified\")\n",
        "    )\n",
        "\n",
        "    output_hash_matches = (\n",
        "        record_data.get(\"output_sha256\")\n",
        "        == EXPECTED_HASHES[\"phase47\"]\n",
        "    )\n",
        "\n",
        "    insertion_verified = (\n",
        "        record_data.get(\"status\")\n",
        "        == \"PHASE_4_7_CONCLUSION_INSERTION_VERIFIED\"\n",
        "        and not record_data.get(\"failed_checks\")\n",
        "        and record_data.get(\"source_modified\") is False\n",
        "        and record_data.get(\"previous_phase_records_modified\") is False\n",
        "        and output_hash_matches\n",
        "    )\n",
        "\n",
        "    if insertion_verified:\n",
        "\n",
        "        add(\n",
        "            \"PASS\",\n",
        "            \"Phase 4.7 conclusion insertion reconciliation\",\n",
        "            \"The later verified insertion record confirms the final conclusion and preserves source artifacts.\"\n",
        "        )\n",
        "\n",
        "    else:\n",
        "\n",
        "        add(\n",
        "            \"REVIEW\",\n",
        "            \"Phase 4.7 conclusion insertion reconciliation\",\n",
        "            \"The insertion record requires further inspection.\"\n",
        "        )\n",
        "\n",
        "else:\n",
        "\n",
        "    add(\n",
        "        \"REVIEW\",\n",
        "        \"Phase 4.7 conclusion insertion record\",\n",
        "        record_error\n",
        "    )\n",
        "\n",
        "if old_audit_data is not None:\n",
        "\n",
        "    old_failed = old_audit_data.get(\"failed_checks\", [])\n",
        "\n",
        "    print(\"Historical audit failed checks:\", old_failed)\n",
        "\n",
        "    # A historical failed check is retained as historical evidence.\n",
        "    # It is not treated as a current failure when a later verified\n",
        "    # correction/insertion record resolves that specific issue.\n",
        "\n",
        "    old_conclusion_failure = any(\n",
        "        isinstance(item, dict)\n",
        "        and item.get(\"check\") == \"structure_conclusion_identified\"\n",
        "        and item.get(\"status\") == \"FAIL\"\n",
        "        for item in old_failed\n",
        "    )\n",
        "\n",
        "    if old_conclusion_failure and record_data is not None and insertion_verified:\n",
        "\n",
        "        add(\n",
        "            \"PASS\",\n",
        "            \"Historical conclusion failure reconciliation\",\n",
        "            \"The earlier audit failure predates the verified conclusion insertion. Historical record preserved; current structure verified separately.\"\n",
        "        )\n",
        "\n",
        "    elif old_conclusion_failure:\n",
        "\n",
        "        add(\n",
        "            \"REVIEW\",\n",
        "            \"Historical conclusion failure reconciliation\",\n",
        "            \"Historical failure exists but no verified later correction was established.\"\n",
        "        )\n",
        "\n",
        "    else:\n",
        "\n",
        "        add(\n",
        "            \"PASS\",\n",
        "            \"Historical Phase 4.7 audit inspection\",\n",
        "            \"No unresolved conclusion-identification failure detected in the historical audit.\"\n",
        "        )\n",
        "\n",
        "else:\n",
        "\n",
        "    add(\n",
        "        \"NOT_VERIFIABLE\",\n",
        "        \"Historical Phase 4.7 audit\",\n",
        "        old_audit_error\n",
        "    )\n",
        "\n",
        "# =====================================================================\n",
        "# 10. CORRECTED PHASE 4.2–4.4 AUDIT RECORDS\n",
        "# =====================================================================\n",
        "\n",
        "print(\"\\n[8] CORRECTED PHASE 4.2–4.4 AUDIT RECORDS\")\n",
        "print(\"-\" * 85)\n",
        "\n",
        "corrected_audit_results = {}\n",
        "\n",
        "for phase, path in CORRECTED_AUDITS.items():\n",
        "\n",
        "    data, error = read_json(path)\n",
        "\n",
        "    print(f\"\\n{phase}: {path}\")\n",
        "\n",
        "    if data is None:\n",
        "\n",
        "        print(\"[UNAVAILABLE]\", error)\n",
        "\n",
        "        corrected_audit_results[phase] = {\n",
        "            \"available\": False,\n",
        "            \"error\": error\n",
        "        }\n",
        "\n",
        "        add(\n",
        "            \"NOT_VERIFIABLE\",\n",
        "            f\"{phase} corrected audit\",\n",
        "            error\n",
        "        )\n",
        "\n",
        "        continue\n",
        "\n",
        "    print(\"Top-level keys:\", list(data.keys()))\n",
        "\n",
        "    failed_values = []\n",
        "\n",
        "    for key in [\n",
        "        \"failed_checks\",\n",
        "        \"failed_core_checks\",\n",
        "        \"failed_check_count\",\n",
        "    ]:\n",
        "\n",
        "        value = data.get(key)\n",
        "\n",
        "        if isinstance(value, list):\n",
        "            failed_values.extend(value)\n",
        "\n",
        "        elif isinstance(value, int) and value > 0:\n",
        "            failed_values.append(f\"{key}={value}\")\n",
        "\n",
        "    status_text = str(\n",
        "        data.get(\n",
        "            \"status\",\n",
        "            data.get(\n",
        "                \"audit_status\",\n",
        "                data.get(\"corrected_final_status\", \"STATUS_NOT_EXPLICIT\")\n",
        "            )\n",
        "        )\n",
        "    )\n",
        "\n",
        "    print(\"Recorded status:\", status_text)\n",
        "    print(\"Recorded failures:\", failed_values)\n",
        "\n",
        "    corrected_audit_results[phase] = {\n",
        "        \"available\": True,\n",
        "        \"status\": status_text,\n",
        "        \"failed_values\": failed_values,\n",
        "        \"keys\": list(data.keys())\n",
        "    }\n",
        "\n",
        "    if failed_values:\n",
        "\n",
        "        add(\n",
        "            \"REVIEW\",\n",
        "            f\"{phase} corrected audit findings\",\n",
        "            failed_values\n",
        "        )\n",
        "\n",
        "    else:\n",
        "\n",
        "        add(\n",
        "            \"PASS\",\n",
        "            f\"{phase} corrected audit readability\",\n",
        "            \"Corrected audit record is readable and has no explicit failed checks.\"\n",
        "        )\n",
        "\n",
        "# =====================================================================\n",
        "# 11. PHASE 4.5–4.7 AUDIT RECORDS\n",
        "# =====================================================================\n",
        "\n",
        "print(\"\\n[9] PHASE 4.5–4.7 AUDIT RECORD RECONCILIATION\")\n",
        "print(\"-\" * 85)\n",
        "\n",
        "for label, path in [\n",
        "    (\"Phase 4.5\", PHASE45_AUDIT),\n",
        "    (\"Phase 4.6\", PHASE46_AUDIT),\n",
        "    (\"Phase 4.6 correction\", PHASE46_CORRECTION),\n",
        "]:\n",
        "\n",
        "    data, error = read_json(path)\n",
        "\n",
        "    if data is None:\n",
        "\n",
        "        print(\"[UNAVAILABLE]\", label, error)\n",
        "\n",
        "        add(\n",
        "            \"NOT_VERIFIABLE\",\n",
        "            f\"{label} audit record\",\n",
        "            error\n",
        "        )\n",
        "\n",
        "        continue\n",
        "\n",
        "    print(\"\\n\", label)\n",
        "    print(\"Keys:\", list(data.keys()))\n",
        "\n",
        "    failed = (\n",
        "        data.get(\"failed_checks\")\n",
        "        or data.get(\"failed_core_checks\")\n",
        "        or []\n",
        "    )\n",
        "\n",
        "    print(\"Historical failed checks:\", failed)\n",
        "\n",
        "    # Historical flags remain recorded. They are not erased.\n",
        "    # A later correction record is considered separately.\n",
        "\n",
        "    if label == \"Phase 4.5\" and not failed:\n",
        "\n",
        "        add(\n",
        "            \"PASS\",\n",
        "            \"Phase 4.5 methodology audit\",\n",
        "            \"The methodology audit record contains no failed checks.\"\n",
        "        )\n",
        "\n",
        "    elif label == \"Phase 4.6 correction\" and not failed:\n",
        "\n",
        "        add(\n",
        "            \"PASS\",\n",
        "            \"Phase 4.6 correction verification\",\n",
        "            \"The later correction verification record contains no failed checks.\"\n",
        "        )\n",
        "\n",
        "    elif label == \"Phase 4.6\":\n",
        "\n",
        "        add(\n",
        "            \"REVIEW\",\n",
        "            \"Phase 4.6 historical reporting audit\",\n",
        "            \"Historical reporting audit contains review flags; later correction record must be considered alongside it.\"\n",
        "        )\n",
        "\n",
        "# =====================================================================\n",
        "# 12. EXPERIMENTAL SCOPE AND METHODS\n",
        "# =====================================================================\n",
        "\n",
        "print(\"\\n[10] EXPERIMENTAL SCOPE AND METHODS\")\n",
        "print(\"-\" * 85)\n",
        "\n",
        "text_lower = TEXT47.lower()\n",
        "\n",
        "scope_terms = {\n",
        "    \"Extended Yale B\": [\"extended yale b\"],\n",
        "    \"38 identities\": [\"38 identities\", \"38 identity\"],\n",
        "    \"2,414 images\": [\"2,414\", \"2414\"],\n",
        "    \"2,128 evaluation observations\": [\"2,128\", \"2128\"],\n",
        "    \"56 illumination conditions\": [\"56 conditions\", \"56 illumination\"],\n",
        "    \"FaceNet\": [\"facenet\", \"inceptionresnetv1\"],\n",
        "    \"512-dimensional embeddings\": [\"512-dimensional\", \"512-d\"],\n",
        "    \"Reference condition\": [\"a+000e+00\", \"reference condition\"],\n",
        "    \"Euclidean distance\": [\"euclidean\"],\n",
        "    \"Cosine distance\": [\"cosine\"],\n",
