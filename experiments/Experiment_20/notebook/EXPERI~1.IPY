        "    ),\n",
        "\n",
        "    \"principal_findings_present\": (\n",
        "        \"displacement\" in abstract.lower()\n",
        "        and (\n",
        "            \"increased\" in abstract.lower()\n",
        "            or \"increase\" in abstract.lower()\n",
