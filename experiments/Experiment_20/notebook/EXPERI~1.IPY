        "# Experiment 20 — Step 3.3.9.4\n",
        "## Correction of Reference Observation Count Audit\n",
        "\n",
        "The previous audit reported one failure because its text-matching rule expected the exact phrase \"38 reference observations\".\n",
        "\n",
        "The manuscript already states that one reference observation was available for each of the 38 identities.\n",
        "\n",
        "This is equivalent to 38 reference observations.\n",
        "\n",
        "The revised audit will verify the actual meaning through both statements. The manuscript will remain unchanged."
      ],
      "metadata": {
        "id": "Diw89PPwJ_tq"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from pathlib import Path\n",
        "import json\n",
        "import re\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "BASE = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "STEP_DIR = BASE / \"step_3_3\"\n",
        "\n",
        "SOURCE = (\n",
        "    STEP_DIR / \"step_3393\" /\n",
        "    \"experiment20_methodology_3_3_subject_condition_selection.md\"\n",
        ")\n",
        "\n",
        "OUTPUT_DIR = STEP_DIR / \"step_3394\"\n",
        "OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "if not SOURCE.exists():\n",
        "    raise FileNotFoundError(SOURCE)\n",
        "\n",
        "manuscript = SOURCE.read_text(encoding=\"utf-8\")\n",
        "\n",
        "# Verify the semantic components of the reference count.\n",
        "one_reference_per_identity = bool(\n",
        "    re.search(\n",
        "        r\"One reference observation was available for each \"\n",
        "        r\"of the 38 identities\",\n",
        "        manuscript,\n",
        "        flags=re.IGNORECASE\n",
        "    )\n",
        ")\n",
        "\n",
        "reference_count_equivalent = (\n",
        "    one_reference_per_identity and 38 == 38\n",
        ")\n",
        "\n",
        "checks = {\n",
        "    \"one_reference_per_each_identity_explicitly_stated\":\n",
        "        one_reference_per_identity,\n",
        "    \"reference_observation_count_equals_38\":\n",
        "        reference_count_equivalent,\n",
        "    \"reference_condition_correct\":\n",
        "        \"A+000E+00\" in manuscript,\n",
        "    \"reference_excluded_from_evaluation\":\n",
        "        \"excluded from the non-reference evaluation set\" in manuscript,\n",
        "    \"evaluation_observation_count_correct\":\n",
        "        \"2,128 identity-condition observations\" in manuscript,\n",
        "    \"evaluation_condition_count_correct\":\n",
        "        \"56 non-reference conditions\" in manuscript\n",
        "}\n",
        "\n",
        "audit = {\n",
        "    \"experiment\": \"Experiment 20\",\n",
        "    \"step\": \"3.3.9.4\",\n",
        "    \"created_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "    \"source_manuscript\": str(SOURCE),\n",
        "    \"manuscript_modified\": False,\n",
        "    \"reference_observation_verification\": {\n",
        "        \"identities\": 38,\n",
