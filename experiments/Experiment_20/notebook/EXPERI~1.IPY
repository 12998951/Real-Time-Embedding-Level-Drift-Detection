    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# EXPERIMENT 20 — STEP 3.3.33\n",
        "# CORRECTED HEMISPHERE FIGURE PLACEMENT VERIFICATION\n",
        "# READ-ONLY\n",
        "# ============================================================\n",
        "\n",
        "import os\n",
        "import re\n",
        "import json\n",
        "import hashlib\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "BASE = \"/content/drive/MyDrive/Experiment_20_Results\"\n",
        "\n",
        "MANUSCRIPT = os.path.join(\n",
        "    BASE, \"step_3_3\", \"step_3330\",\n",
        "    \"experiment20_integrated_manuscript_v2.md\"\n",
        ")\n",
        "\n",
        "FIGURE_DIR = os.path.join(\n",
        "    BASE, \"step_3_3\", \"step_3330\", \"figures\"\n",
        ")\n",
        "\n",
        "OUTPUT_DIR = os.path.join(\n",
        "    BASE, \"step_3_3\", \"step_3333\"\n",
        ")\n",
        "os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
        "\n",
        "REPORT_PATH = os.path.join(\n",
        "    OUTPUT_DIR,\n",
        "    \"experiment20_step3333_corrected_hemisphere_placement_verification.json\"\n",
        ")\n",
        "\n",
        "EXPECTED_HASHES = {\n",
        "    \"experiment20_figure3_euclidean_hemisphere_comparison.png\":\n",
        "        \"5a55b8947698a35dd20a258a4d185b927a64ccdac4a4b18d8aad4bd6d35fc0c6\",\n",
        "\n",
        "    \"experiment20_figure4_cosine_hemisphere_comparison.png\":\n",
        "        \"0a06e0a5458ec2779aee94778f59fd576e585f8fc85fdd3e82afb6c91211851c\"\n",
        "}\n",
        "\n",
        "\n",
        "def sha256_file(path):\n",
        "    h = hashlib.sha256()\n",
        "\n",
        "    with open(path, \"rb\") as f:\n",
        "        for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n",
        "            h.update(chunk)\n",
        "\n",
        "    return h.hexdigest()\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. LOAD MANUSCRIPT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "if not os.path.isfile(MANUSCRIPT):\n",
        "    raise FileNotFoundError(MANUSCRIPT)\n",
        "\n",
        "initial_hash = sha256_file(MANUSCRIPT)\n",
        "\n",
        "with open(MANUSCRIPT, \"r\", encoding=\"utf-8\") as f:\n",
        "    lines = f.read().splitlines()\n",
        "\n",
        "print(\"=\" * 100)\n",
        "print(\"STEP 3.3.33 — CORRECTED HEMISPHERE PLACEMENT VERIFICATION\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "print(\"Manuscript SHA256:\", initial_hash)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. EXTRACT SECTION 3.5\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "start = next(\n",
        "    i for i, line in enumerate(lines)\n",
        "    if line.strip() == \"## 3.5 Exploratory frontal and beyond-frontal comparison\"\n",
        ")\n",
        "\n",
        "end = next(\n",
        "    i for i, line in enumerate(lines[start + 1:], start + 1)\n",
        "    if line.strip().startswith(\"## 3.6\")\n",
        ")\n",
        "\n",
        "section = lines[start:end]\n",
        "\n",
        "print(\"\\nCOMPLETE SECTION 3.5\")\n",
        "for index, line in enumerate(section, start + 1):\n",
        "    print(f\"{index}: {line}\")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. LOCATE ELEMENTS BY EXACT LINE CONTENT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def locate_unique(description, predicate):\n",
        "\n",
        "    matches = [\n",
        "        (index, line)\n",
        "        for index, line in enumerate(lines)\n",
        "        if predicate(line)\n",
        "    ]\n",
        "\n",
        "    if len(matches) != 1:\n",
        "        raise ValueError(\n",
        "            f\"{description}: expected one match, found {len(matches)}\"\n",
        "        )\n",
        "\n",
        "    return matches[0]\n",
        "\n",
        "\n",
        "elements = {}\n",
        "\n",
        "elements[\"euclidean_result\"] = locate_unique(\n",
        "    \"Euclidean result paragraph\",\n",
        "    lambda line: (\n",
        "        \"mean paired difference (beyond-frontal minus frontal) \"\n",
        "        \"was 0.581770\" in line\n",
        "        and \"Figure 3\" in line\n",
        "    )\n",
        ")\n",
        "\n",
        "elements[\"cosine_result\"] = locate_unique(\n",
        "    \"Cosine result paragraph\",\n",
        "    lambda line: (\n",
        "        \"mean paired difference was 0.542807\" in line\n",
        "        and \"Figure 4\" in line\n",
        "    )\n",
        ")\n",
        "\n",
        "elements[\"figure3_embed\"] = locate_unique(\n",
        "    \"Figure 3 image embed\",\n",
        "    lambda line: (\n",
        "        line.startswith(\"![\")\n",
        "        and \"experiment20_figure3_euclidean_hemisphere_comparison.png\" in line\n",
        "    )\n",
        ")\n",
        "\n",
        "elements[\"figure3_caption\"] = locate_unique(\n",
        "    \"Figure 3 caption\",\n",
        "    lambda line: (\n",
        "        line.startswith(\"*Figure 3.\")\n",
        "        and \"Paired identity-level Euclidean displacement\" in line\n",
        "    )\n",
        ")\n",
        "\n",
        "elements[\"figure4_embed\"] = locate_unique(\n",
        "    \"Figure 4 image embed\",\n",
        "    lambda line: (\n",
        "        line.startswith(\"![\")\n",
        "        and \"experiment20_figure4_cosine_hemisphere_comparison.png\" in line\n",
        "    )\n",
        ")\n",
        "\n",
        "elements[\"figure4_caption\"] = locate_unique(\n",
        "    \"Figure 4 caption\",\n",
        "    lambda line: (\n",
        "        line.startswith(\"*Figure 4.\")\n",
        "        and \"Paired identity-level cosine distance\" in line\n",
        "    )\n",
        ")\n",
        "\n",
        "elements[\"exploratory_limitation\"] = locate_unique(\n",
        "    \"Exploratory limitation paragraph\",\n",
        "    lambda line: (\n",
        "        line.startswith(\"This comparison is exploratory.\")\n",
        "    )\n",
        ")\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"ELEMENT LOCATIONS\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "for name, (index, line) in elements.items():\n",
        "    print(f\"{name}: line {index + 1}\")\n",
        "    print(line)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. VERIFY REQUIRED ORDER\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "required_order = [\n",
        "    \"euclidean_result\",\n",
        "    \"cosine_result\",\n",
        "    \"figure3_embed\",\n",
        "    \"figure3_caption\",\n",
        "    \"figure4_embed\",\n",
        "    \"figure4_caption\",\n",
        "    \"exploratory_limitation\"\n",
        "]\n",
        "\n",
        "line_positions = [\n",
        "    elements[name][0]\n",
        "    for name in required_order\n",
        "]\n",
        "\n",
        "ordering_pass = (\n",
        "    line_positions == sorted(line_positions)\n",
        "    and len(set(line_positions)) == len(line_positions)\n",
        ")\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"ORDER VALIDATION\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "print(\"Required sequence:\", required_order)\n",
        "print(\"Actual line positions:\", [x + 1 for x in line_positions])\n",
        "print(\"Correct order:\", ordering_pass)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. VERIFY IMAGE PATHS AND HASHES\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "figure_checks = {}\n",
        "\n",
        "for filename, expected_hash in EXPECTED_HASHES.items():\n",
        "\n",
        "    path = os.path.join(FIGURE_DIR, filename)\n",
        "\n",
        "    exists = os.path.isfile(path)\n",
        "\n",
        "    actual_hash = (\n",
        "        sha256_file(path)\n",
        "        if exists else None\n",
        "    )\n",
        "\n",
        "    hash_matches = (\n",
        "        exists and actual_hash == expected_hash\n",
        "    )\n",
        "\n",
        "    figure_checks[filename] = {\n",
        "        \"exists\": exists,\n",
        "        \"expected_sha256\": expected_hash,\n",
        "        \"actual_sha256\": actual_hash,\n",
        "        \"hash_matches\": hash_matches,\n",
        "        \"passed\": exists and hash_matches\n",
        "    }\n",
        "\n",
        "    print(\"\\n\", filename)\n",
        "    print(\"Exists:\", exists)\n",
        "    print(\"Hash matches:\", hash_matches)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. VERIFY IMAGE REFERENCES\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "figure3_reference = (\n",
        "    \"Figure 3\" in elements[\"euclidean_result\"][1]\n",
        ")\n",
        "\n",
        "figure4_reference = (\n",
        "    \"Figure 4\" in elements[\"cosine_result\"][1]\n",
        ")\n",
        "\n",
        "references_pass = figure3_reference and figure4_reference\n",
        "\n",
        "print(\"\\nRESULT REFERENCES\")\n",
        "print(\"Euclidean result references Figure 3:\", figure3_reference)\n",
        "print(\"Cosine result references Figure 4:\", figure4_reference)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. VERIFY MANUSCRIPT UNCHANGED\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "final_hash = sha256_file(MANUSCRIPT)\n",
        "\n",
        "manuscript_unchanged = initial_hash == final_hash\n",
        "\n",
        "all_figures_pass = all(\n",
        "    item[\"passed\"]\n",
        "    for item in figure_checks.values()\n",
        ")\n",
        "\n",
        "all_pass = all([\n",
        "    ordering_pass,\n",
        "    references_pass,\n",
        "    all_figures_pass,\n",
        "    manuscript_unchanged\n",
        "])\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 8. SAVE REPORT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "report = {\n",
        "    \"step\": \"3.3.33\",\n",
        "    \"title\": \"Corrected Hemisphere Figure Placement Verification\",\n",
        "    \"created_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "\n",
        "    \"manuscript\": {\n",
        "        \"path\": MANUSCRIPT,\n",
        "        \"sha256_before\": initial_hash,\n",
        "        \"sha256_after\": final_hash,\n",
        "        \"unchanged\": manuscript_unchanged\n",
        "    },\n",
        "\n",
        "    \"element_lines\": {\n",
        "        name: index + 1\n",
        "        for name, (index, _) in elements.items()\n",
        "    },\n",
        "\n",
        "    \"required_order\": required_order,\n",
        "    \"ordering_pass\": ordering_pass,\n",
        "    \"references_pass\": references_pass,\n",
        "    \"figure_checks\": figure_checks,\n",
        "    \"all_figures_pass\": all_figures_pass,\n",
        "\n",
        "    \"previous_audit_failure_diagnosis\": {\n",
        "        \"alt_text_mismatch\": True,\n",
        "        \"dotall_regex_cross_paragraph_matching\": True,\n",
        "        \"manuscript_reordering_required\": False\n",
        "    },\n",
        "\n",
        "    \"status\": (\n",
        "        \"PASS_HEMISPHERE_FIGURE_PLACEMENT_CONFIRMED\"\n",
        "        if all_pass\n",
        "        else \"MANUAL_REVIEW_REQUIRED\"\n",
        "    ),\n",
        "\n",
        "    \"integrity\": {\n",
        "        \"manuscript_modified\": False,\n",
        "        \"figures_modified\": False,\n",
        "        \"frozen_evidence_modified\": False\n",
        "    }\n",
        "}\n",
        "\n",
        "with open(REPORT_PATH, \"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(report, f, indent=2)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"FINAL STATUS\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "print(\"Ordering pass:\", ordering_pass)\n",
        "print(\"Figure references pass:\", references_pass)\n",
        "print(\"Figure hashes pass:\", all_figures_pass)\n",
        "print(\"Manuscript unchanged:\", manuscript_unchanged)\n",
        "print(\"Overall:\", report[\"status\"])\n",
        "\n",
        "print(\"\\nReport saved:\", REPORT_PATH)\n",
        "print(\"Report SHA256:\", sha256_file(REPORT_PATH))\n",
        "print(\"No existing files were modified.\")\n",
        "print(\"STEP 3.3.33 COMPLETED\")"
