        "    \"phase\": \"3.3\",\n",
        "    \"step\": \"3.3.1\",\n",
        "    \"timestamp_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "\n",
        "    \"working_title\": (\n",
        "        \"Reference-Relative Face Embedding Displacement Across \"\n",
        "        \"Illumination Geometry Conditions: An Identity-Level \"\n",
        "        \"Empirical Study\"\n",
        "    ),\n",
        "\n",
        "    \"central_research_question\": (\n",
        "        \"How does reference-relative FaceNet embedding displacement \"\n",
        "        \"vary across illumination geometry conditions, and how \"\n",
        "        \"consistently are these differences observed across \"\n",
        "        \"individual identities?\"\n",
        "    ),\n",
        "\n",
        "    \"supporting_research_questions\": {\n",
        "        \"RQ1\": (\n",
        "            \"How do Euclidean embedding displacement and cosine \"\n",
        "            \"distance vary across near-frontal, oblique, and \"\n",
        "            \"large-angular illumination conditions?\"\n",
        "        ),\n",
        "        \"RQ2\": (\n",
        "            \"Are the differences between illumination geometry \"\n",
        "            \"groups consistent across the evaluated identities?\"\n",
        "        ),\n",
        "        \"RQ3\": (\n",
        "            \"How do reference-relative embedding displacement \"\n",
        "            \"patterns differ between frontal and beyond-frontal \"\n",
        "            \"illumination conditions?\"\n",
        "        )\n",
        "    },\n",
        "\n",
        "    \"research_objectives\": {\n",
        "        \"O1\": (\n",
        "            \"Construct identity-level reference-relative embedding \"\n",
        "            \"displacement measurements using a fixed pretrained \"\n",
        "            \"FaceNet model.\"\n",
        "        ),\n",
        "        \"O2\": (\n",
        "            \"Characterise Euclidean and cosine displacement across \"\n",
        "            \"three illumination geometry groups.\"\n",
        "        ),\n",
        "        \"O3\": (\n",
        "            \"Evaluate differences between illumination groups using \"\n",
        "            \"repeated-measures statistical analysis.\"\n",
        "        ),\n",
        "        \"O4\": (\n",
        "            \"Examine the consistency of illumination-related \"\n",
        "            \"displacement patterns across identities.\"\n",
        "        ),\n",
        "        \"O5\": (\n",
        "            \"Explore differences between frontal and beyond-frontal \"\n",
        "            \"illumination conditions.\"\n",
        "        )\n",
        "    },\n",
        "\n",
        "    \"proposed_contributions\": {\n",
        "        \"C1\": (\n",
        "            \"An identity-level descriptive evaluation of \"\n",
        "            \"reference-relative FaceNet embedding displacement \"\n",
        "            \"across illumination geometry conditions using \"\n",
        "            \"the Cropped Extended Yale B dataset.\"\n",
        "        ),\n",
        "        \"C2\": (\n",
        "            \"A comparative analysis of Euclidean displacement \"\n",
        "            \"and cosine distance across three illumination \"\n",
        "            \"geometry groups.\"\n",
        "        ),\n",
        "        \"C3\": (\n",
        "            \"A repeated-measures statistical assessment of \"\n",
        "            \"differences across illumination groups, including \"\n",
        "            \"identity-level uncertainty estimates.\"\n",
        "        ),\n",
        "        \"C4\": (\n",
        "            \"An exploratory analysis of frontal and beyond-frontal \"\n",
        "            \"illumination conditions, with explicit acknowledgement \"\n",
        "            \"of unequal condition counts and geometric confounding.\"\n",
        "        )\n",
        "    },\n",
        "\n",
        "    \"scope_restrictions\": [\n",
        "        \"No new face-recognition architecture is claimed.\",\n",
        "        \"No biometric recognition accuracy improvement is claimed.\",\n",
