      "cell_type": "markdown",
      "source": [
        "# Experiment 20 — Step 3.1.5.2: Correct Acquisition Listing Verification\n",
        "\n",
        "## Objective\n",
        "Verify the Academic Torrents listing corresponding to the actual\n",
        "CroppedYale.zip acquisition record and document the corrected provenance.\n",
        "\n",
        "## Expected listing details\n",
        "- Dataset: The Extended Yale Face Database B (Cropped)\n",
        "- Info-hash: aad8bf8e6ee5d8a3bf46c7ab5adfacdd8ad36247\n",
        "- Filename: CroppedYale.zip\n",
        "- Size: 58,493,820 bytes\n",
        "\n",
        "## Restrictions\n",
        "- Read-only inspection of the source listing.\n",
        "- Do not download or replace the dataset.\n",
        "- Do not modify the frozen package.\n",
        "- Save a separate supplementary audit record.\n",
        "- Do not claim official Yale checksum authentication."
      ],
      "metadata": {
        "id": "MjE4lYOFu9qD"
      }
    },
    {
      "cell_type": "markdown",
      "source": [],
      "metadata": {
        "id": "LZ3yxMzEu99r"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from pathlib import Path\n",
        "from datetime import datetime, timezone\n",
        "import requests\n",
        "import re\n",
        "import json\n",
        "\n",
        "BASE = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "AUDIT_DIR = BASE / \"dataset_audit\"\n",
        "\n",
        "ACQUISITION_FILE = (\n",
        "    AUDIT_DIR / \"experiment20_croppedyale_acquisition_record.json\"\n",
        ")\n",
        "\n",
        "OUTPUT_FILE = (\n",
        "    AUDIT_DIR / \"experiment20_acquisition_source_reconciliation_audit.json\"\n",
        ")\n",
        "\n",
        "EXPECTED_INFO_HASH = (\n",
        "    \"aad8bf8e6ee5d8a3bf46c7ab5adfacdd8ad36247\"\n",
        ")\n",
        "\n",
        "EXPECTED_FILENAME = \"CroppedYale.zip\"\n",
        "EXPECTED_SIZE = 58493820\n",
        "\n",
        "SOURCE_URL = (\n",
        "    \"https://academictorrents.com/details/\"\n",
        "    + EXPECTED_INFO_HASH\n",
        "    + \"/tech\"\n",
        ")\n",
        "\n",
        "print(\"=\" * 100)\n",
        "print(\"EXPERIMENT 20 — STEP 3.1.5.2\")\n",
        "print(\"CORRECT ACQUISITION LISTING VERIFICATION\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "if not ACQUISITION_FILE.exists():\n",
        "    raise FileNotFoundError(ACQUISITION_FILE)\n",
        "\n",
        "with ACQUISITION_FILE.open(\"r\", encoding=\"utf-8\") as f:\n",
        "    acquisition = json.load(f)\n",
        "\n",
        "recorded_url = acquisition.get(\"source\")\n",
        "recorded_hash = acquisition.get(\"sha256\")\n",
        "recorded_size = acquisition.get(\"archive_size_bytes\")\n",
        "\n",
        "print(\"\\nACQUISITION RECORD\")\n",
        "print(\"Source URL:\", recorded_url)\n",
        "print(\"Archive SHA256:\", recorded_hash)\n",
        "print(\"Archive size:\", recorded_size)\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# Fetch the exact Academic Torrents listing\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "response = requests.get(\n",
        "    SOURCE_URL,\n",
        "    timeout=30,\n",
        "    headers={\"User-Agent\": \"Mozilla/5.0\"}\n",
        ")\n",
        "\n",
        "response.raise_for_status()\n",
        "\n",
        "html = response.text\n",
        "html_lower = html.lower()\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# Extract and verify listing evidence\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "hash_match = (\n",
        "    EXPECTED_INFO_HASH.lower() in html_lower\n",
        ")\n",
        "\n",
        "filename_match = (\n",
        "    EXPECTED_FILENAME.lower() in html_lower\n",
        ")\n",
        "\n",
        "size_match = (\n",
        "    \"58.49mb\" in html_lower\n",
        "    or \"58,493,820\" in html\n",
        "    or \"58493820\" in html\n",
        ")\n",
        "\n",
        "title_match = (\n",
        "    \"extended yale face database b\" in html_lower\n",
        "    and \"cropped\" in html_lower\n",
        ")\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# Compare actual acquisition URL with correct listing\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "url_hash_match = (\n",
        "    EXPECTED_INFO_HASH.lower() in (recorded_url or \"\").lower()\n",
        ")\n",
        "\n",
        "archive_size_match = (\n",
        "    recorded_size == EXPECTED_SIZE\n",
        ")\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# Build supplementary audit record\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "checks = {\n",
        "    \"listing_http_success\": response.status_code == 200,\n",
        "    \"listing_info_hash_matches\": hash_match,\n",
        "    \"listing_filename_matches\": filename_match,\n",
        "    \"listing_size_matches\": size_match,\n",
        "    \"listing_title_matches\": title_match,\n",
        "    \"acquisition_url_contains_correct_info_hash\": url_hash_match,\n",
        "    \"acquisition_size_matches_listing\": archive_size_match,\n",
        "}\n",
        "\n",
        "listing_match = all(checks.values())\n",
        "\n",
        "audit = {\n",
        "    \"experiment\": 20,\n",
        "    \"step\": \"3.1.5.2\",\n",
        "    \"timestamp_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "    \"source_listing\": SOURCE_URL,\n",
        "    \"expected_dataset_title\": \"The Extended Yale Face Database B (Cropped)\",\n",
        "    \"expected_info_hash\": EXPECTED_INFO_HASH,\n",
        "    \"expected_filename\": EXPECTED_FILENAME,\n",
        "    \"expected_size_bytes\": EXPECTED_SIZE,\n",
        "    \"acquisition_record\": {\n",
        "        \"source_url\": recorded_url,\n",
        "        \"archive_sha256\": recorded_hash,\n",
        "        \"archive_size_bytes\": recorded_size,\n",
        "    },\n",
        "    \"listing_http_status\": response.status_code,\n",
        "    \"listing_checks\": checks,\n",
        "    \"listing_matches_acquisition_record\": listing_match,\n",
        "    \"limitations\": [\n",
        "        \"Listing metadata does not independently verify torrent piece hashes.\",\n",
        "        \"Archive SHA256 establishes file identity, not official Yale authenticity.\",\n",
        "        \"No official Yale checksum authentication was performed.\",\n",
        "    ],\n",
        "    \"status\": (\n",
        "        \"CORRECT_ACQUISITION_LISTING_MATCHED\"\n",
        "        if listing_match\n",
        "        else \"LISTING_RECONCILIATION_FAILED\"\n",
        "    ),\n",
        "}\n",
        "\n",
        "AUDIT_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "with OUTPUT_FILE.open(\"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(audit, f, indent=2, ensure_ascii=False)\n",
        "\n",
        "# Reload to verify valid JSON\n",
        "with OUTPUT_FILE.open(\"r\", encoding=\"utf-8\") as f:\n",
        "    reloaded = json.load(f)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"LISTING VERIFICATION CHECKS\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "for name, passed in checks.items():\n",
        "    print(f\"{name}: {'PASS' if passed else 'FAIL'}\")\n",
        "\n",
        "print(\"\\nFINAL STATUS:\", reloaded[\"status\"])\n",
        "print(\"Audit saved:\", OUTPUT_FILE)\n",
        "print(\"Audit JSON reload:\", \"PASS\")\n",
        "\n",
        "print(\"\\nIMPORTANT LIMITATION\")\n",
        "for item in reloaded[\"limitations\"]:\n",
        "    print(\"-\", item)\n",
        "\n",
        "print(\"=\" * 100)"
      ],
      "metadata": {
