        "# ============================================================\n",
        "# EXPERIMENT 20\n",
        "# STEP 3.3.9.15\n",
        "# UPDATE STATISTICAL METHODOLOGY BOOTSTRAP DETAILS\n",
        "# ============================================================\n",
        "\n",
        "import json\n",
        "import re\n",
        "from pathlib import Path\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "ROOT = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "\n",
        "METHOD_PATH = (\n",
        "    ROOT / \"step_3_3\" / \"step_3399\" /\n",
        "    \"experiment20_methodology_3_8_statistical_analysis.md\"\n",
        ")\n",
        "\n",
        "JSON_PATH = (\n",
        "    ROOT / \"step_3_3\" / \"step_3399\" /\n",
        "    \"experiment20_step3399_statistical_analysis.json\"\n",
        ")\n",
        "\n",
        "AUDIT_PATH = (\n",
        "    ROOT / \"step_3_3\" / \"step_3399\" /\n",
        "    \"experiment20_step3399_statistical_analysis_audit.json\"\n",
        ")\n",
        "\n",
        "OUTPUT_DIR = (\n",
        "    ROOT / \"step_3_3\" / \"step_33915\"\n",
        ")\n",
        "OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "if not METHOD_PATH.is_file():\n",
        "    raise FileNotFoundError(METHOD_PATH)\n",
        "\n",
        "if not JSON_PATH.is_file():\n",
        "    raise FileNotFoundError(JSON_PATH)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. READ EXISTING METHODOLOGY\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "original_text = METHOD_PATH.read_text(encoding=\"utf-8\")\n",
        "\n",
        "print(\"=\" * 75)\n",
        "print(\"EXISTING STATISTICAL METHODOLOGY\")\n",
        "print(\"=\" * 75)\n",
        "print(original_text)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. VERIFY BOOTSTRAP SETTINGS FROM PRIMARY AUDIT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "PRIMARY_AUDIT = (\n",
        "    ROOT / \"step_2_7\" /\n",
        "    \"repeated_measures_analysis\" /\n",
        "    \"experiment20_step274_repeated_measures_audit.json\"\n",
        ")\n",
        "\n",
        "with open(PRIMARY_AUDIT, \"r\", encoding=\"utf-8\") as f:\n",
        "    primary_data = json.load(f)\n",
        "\n",
        "bootstrap_records = primary_data[\"bootstrap_results\"]\n",
        "\n",
        "iterations = {\n",
        "    record[\"bootstrap_iterations\"]\n",
        "    for record in bootstrap_records\n",
        "}\n",
        "\n",
        "seeds = {\n",
        "    record[\"random_seed\"]\n",
        "    for record in bootstrap_records\n",
        "}\n",
        "\n",
        "if len(bootstrap_records) != 6:\n",
        "    raise ValueError(\n",
        "        \"Expected six bootstrap records.\"\n",
        "    )\n",
        "\n",
        "if iterations != {20000}:\n",
        "    raise ValueError(\n",
        "        f\"Unexpected bootstrap iteration values: {iterations}\"\n",
        "    )\n",
        "\n",
        "if seeds != {2026274}:\n",
        "    raise ValueError(\n",
        "        f\"Unexpected bootstrap seeds: {seeds}\"\n",
        "    )\n",
        "\n",
        "if primary_data.get(\"bootstrap_iterations\") != 20000:\n",
        "    raise ValueError(\n",
        "        \"Top-level bootstrap iteration count does not match.\"\n",
        "    )\n",
        "\n",
        "if primary_data.get(\"random_seed\") != 2026274:\n",
        "    raise ValueError(\n",
        "        \"Top-level random seed does not match.\"\n",
        "    )\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. INSERT VERIFIED DETAILS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "updated_text = original_text\n",
        "\n",
        "bootstrap_sentence = (\n",
        "    \"Confidence intervals for the pairwise identity-level \"\n",
        "    \"mean differences were estimated using 20,000 bootstrap \"\n",
        "    \"iterations with random seed 2026274. Resampling was \"\n",
        "    \"performed at the identity level, preserving the identity \"\n",
        "    \"as the unit of resampling. The reported intervals are \"\n",
        "    \"95% bootstrap confidence intervals.\"\n",
        ")\n",
        "\n",
        "if \"20,000 bootstrap iterations\" not in updated_text:\n",
        "\n",
        "    if \"Bootstrap\" in updated_text:\n",
        "        updated_text = re.sub(\n",
        "            r\"(Bootstrap[^.]*\\.)\",\n",
        "            r\"\\1 \" + bootstrap_sentence,\n",
        "            updated_text,\n",
        "            count=1,\n",
        "            flags=re.IGNORECASE\n",
        "        )\n",
        "\n",
        "    else:\n",
        "        updated_text = (\n",
        "            updated_text.rstrip()\n",
        "            + \"\\n\\n\"\n",
        "            + bootstrap_sentence\n",
        "            + \"\\n\"\n",
        "        )\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. VALIDATE UPDATED TEXT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "checks = {\n",
        "    \"bootstrap_iterations_reported\":\n",
        "        \"20,000 bootstrap iterations\" in updated_text,\n",
        "\n",
        "    \"bootstrap_seed_reported\":\n",
        "        \"2026274\" in updated_text,\n",
        "\n",
        "    \"confidence_level_reported\":\n",
        "        \"95% bootstrap confidence intervals\" in updated_text,\n",
        "\n",
        "    \"identity_level_resampling_reported\":\n",
        "        \"identity level\" in updated_text.lower(),\n",
        "\n",
        "    \"holm_six_comparison_family_retained\":\n",
        "        \"six\" in updated_text.lower()\n",
        "        and \"holm\" in updated_text.lower()\n",
        "}\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. SAVE UPDATED METHODOLOGY AND AUDIT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "OUTPUT_MD = (\n",
        "    OUTPUT_DIR /\n",
        "    \"experiment20_methodology_3_8_statistical_analysis_v2.md\"\n",
        ")\n",
        "\n",
        "OUTPUT_JSON = (\n",
        "    OUTPUT_DIR /\n",
        "    \"experiment20_step33915_statistical_analysis.json\"\n",
        ")\n",
        "\n",
        "OUTPUT_AUDIT = (\n",
        "    OUTPUT_DIR /\n",
        "    \"experiment20_step33915_bootstrap_methodology_audit.json\"\n",
        ")\n",
        "\n",
        "OUTPUT_MD.write_text(\n",
        "    updated_text,\n",
        "    encoding=\"utf-8\"\n",
        ")\n",
        "\n",
        "with open(JSON_PATH, \"r\", encoding=\"utf-8\") as f:\n",
        "    methodology_json = json.load(f)\n",
        "\n",
        "methodology_json[\"bootstrap_iterations\"] = 20000\n",
        "methodology_json[\"bootstrap_random_seed\"] = 2026274\n",
        "methodology_json[\"confidence_level\"] = 0.95\n",
        "methodology_json[\"bootstrap_resampling_unit\"] = \"identity\"\n",
        "\n",
        "with open(OUTPUT_JSON, \"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(methodology_json, f, indent=4)\n",
        "\n",
        "audit = {\n",
        "    \"experiment\": 20,\n",
        "    \"step\": \"3.3.9.15\",\n",
        "    \"timestamp_utc\": datetime.now(\n",
        "        timezone.utc\n",
        "    ).isoformat(),\n",
        "    \"verified_bootstrap_iterations\": 20000,\n",
        "    \"verified_random_seed\": 2026274,\n",
        "    \"confidence_level\": 0.95,\n",
        "    \"resampling_unit\": \"identity\",\n",
        "    \"checks\": checks,\n",
        "    \"passed_checks\": sum(checks.values()),\n",
        "    \"failed_checks\": len(checks) - sum(checks.values()),\n",
        "    \"status\": (\n",
        "        \"BOOTSTRAP_METHODOLOGY_UPDATE_PASSED\"\n",
        "        if all(checks.values())\n",
        "        else \"REVIEW_REQUIRED\"\n",
        "    )\n",
        "}\n",
        "\n",
        "with open(OUTPUT_AUDIT, \"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(audit, f, indent=4)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. DISPLAY RESULTS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 75)\n",
        "print(\"UPDATED STATISTICAL METHODOLOGY\")\n",
        "print(\"=\" * 75)\n",
        "print(updated_text)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 75)\n",
        "print(\"VALIDATION\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "for name, result in checks.items():\n",
        "    print(f\"{name}: {'PASS' if result else 'FAIL'}\")\n",
        "\n",
        "print(\"\\nPassed:\", audit[\"passed_checks\"])\n",
        "print(\"Failed:\", audit[\"failed_checks\"])\n",
        "print(\"Status:\", audit[\"status\"])\n",
        "\n",
        "print(\"\\nSaved files:\")\n",
        "print(OUTPUT_MD)\n",
        "print(OUTPUT_JSON)\n",
        "print(OUTPUT_AUDIT)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 75)\n",
        "print(\"STEP 3.3.9.15 COMPLETED\")\n",
        "print(\"=\" * 75)"
      ],
