.dumps(data, indent=2)[:3000])\\n\",\"\\n\",\"        except Exception as error:\\n\",\"\\n\",\"            print(\\\"Inspection error:\\\", str(error))\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"SUPPLEMENTARY INSPECTION COMPLETED\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"q40hliHnYiJL\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794346465932,\"user_tz\":360,\"elapsed\":3421,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"fa02dfc6-2def-44cd-ae67-8fc41291fa58\"},\"execution_count\":null,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"===========================================================================\\n\",\"EXPERIMENT 20 — STEP 2\\n\",\"SUPPLEMENTARY FILE INSPECTION\\n\",\"===========================================================================\\n\",\"\\n\",\"---------------------------------------------------------------------------\\n\",\"FILE 1: anscombe.json\\n\",\"Path: /content/sample_data/anscombe.json\\n\",\"Extension: .json\\n\",\"Size (bytes): 1697\\n\",\"\\n\",\"JSON structure:\\n\",\"Top-level list length: 44\\n\",\"First item: {'Series': 'I', 'X': 10.0, 'Y': 8.04}\\n\",\"\\n\",\"JSON preview:\\n\",\"[\\n\",\"  {\\n\",\"    \\\"Series\\\": \\\"I\\\",\\n\",\"    \\\"X\\\": 10.0,\\n\",\"    \\\"Y\\\": 8.04\\n\",\"  },\\n\",\"  {\\n\",\"    \\\"Series\\\": \\\"I\\\",\\n\",\"    \\\"X\\\": 8.0,\\n\",\"    \\\"Y\\\": 6.95\\n\",\"  },\\n\",\"  {\\n\",\"    \\\"Series\\\": \\\"I\\\",\\n\",\"    \\\"X\\\": 13.0,\\n\",\"    \\\"Y\\\": 7.58\\n\",\"  },\\n\",\"  {\\n\",\"    \\\"Series\\\": \\\"I\\\",\\n\",\"    \\\"X\\\": 9.0,\\n\",\"    \\\"Y\\\": 8.81\\n\",\"  },\\n\",\"  {\\n\",\"    \\\"Series\\\": \\\"I\\\",\\n\",\"    \\\"X\\\": 11.0,\\n\",\"    \\\"Y\\\": 8.33\\n\",\"  },\\n\",\"  {\\n\",\"    \\\"Series\\\": \\\"I\\\",\\n\",\"    \\\"X\\\": 14.0,\\n\",\"    \\\"Y\\\": 