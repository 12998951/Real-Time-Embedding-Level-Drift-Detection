\\\": \\\"RGB\\\",\\n\",\"    \\\"resize\\\": [\\n\",\"      160,\\n\",\"      160\\n\",\"    ],\\n\",\"    \\\"tensor_conversion\\\": \\\"ToTensor\\\",\\n\",\"    \\\"face_detection\\\": false,\\n\",\"    \\\"face_alignment\\\": false\\n\",\"  },\\n\",\"  \\\"model\\\": {\\n\",\"    \\\"architecture\\\": \\\"InceptionResnetV1\\\",\\n\",\"    \\\"pretrained_weights\\\": \\\"VGGFace2\\\",\\n\",\"    \\\"embedding_dimension\\\": 512,\\n\",\"    \\\"dtype\\\": \\\"float32\\\",\\n\",\"    \\\"device\\\": \\\"cpu\\\"\\n\",\"  },\\n\",\"  \\\"verified_hashes\\\": {\\n\",\"    \\\"CroppedYale.zip\\\": \\\"8bbabf3836d077d60626c9ee3c54c2d2851a8d2c15c8b7e13b9bc162e86ea573\\\",\\n\",\"    \\\"experiment20_croppedyale_facenet_embeddings.npz\\\": \\\"127ffb6e71b871ebab9ed10fd8ce5f2b78b9f3971db4075cf14b44f7df2d3c4c\\\",\\n\",\"    \\\"experiment20_croppedyale_embedding_metadata.json\\\": \\\"5efe5026210728e333ac5cd1fb0bcba093504e5214c0f72fbef931101a5d0888\\\"\\n\",\"  },\\n\",\"  \\\"package\\\": {\\n\",\"    \\\"filename\\\": \\\"Experiment_20_Stage_2_Frozen_Dataset.zip\\\",\\n\",\"    \\\"size_bytes\\\": 67496777,\\n\",\"    \\\"sha256\\\": \\\"d65c657861e093c50f54666deb63185e5ac72af65ef450610f2ea98502b26339\\\",\\n\",\"    \\\"zip_entries\\\": 25\\n\",\"  },\\n\",\"  \\\"included_audits\\\": [\\n\",\"    \\\"experiment20_full_dataset_image_integrity_audit.json\\\",\\n\",\"    \\\"experiment20_preprocessing_consistency_audit.json\\\",\\n\",\"    \\\"experiment20_embedding_quality_completeness_audit.json\\\",\\n\",\"    \\\"experiment20_corrected_illumination_condition_manifest.json\\\",\\n\",\"    \\\"experiment20_angular_hemisphere_audit.json\\\",\\n\",\"    \\\"experiment20_croppedyale_acquisition_record.json\\\",\\n\",\"    \\\"experiment20_croppedyale_filename_completeness_audit.json\\\",\\n\",\"    \\\"experiment20_croppedyale_image_integrity_audit.json\\\",\\n\",\"    \\\"experiment20_common_illumination_condition_audit.json\\\",\\n\",\"    \\\"experiment20_common_illumination_condition_manifest.json\\\",\\n\",\"    \\\"experiment20_grouped_illumination_condition_manifest.json\\\",\\n\",\"    \\\"experiment20_lighting_geometry_grouping_audit.json\\\",\\n\",\"    \\\"experiment20_yaleb_source_audit.json\\\",\\n\",\"    \\\"experiment20_yaleb_alternative_source_audit.json\\\",\\n\",\"    \\\"experiment20_yaleb_torrent_metadata_audit.json\\\",\\n\",\"    \\\"experiment20_acquisition_environment_audit.json\\\",\\n\",\"    \\\"experiment20_aria2_installation_audit.json\\\"\\n\",\"  ],\\n\",\"  \\\"optional_audits_not_found\\\": [],\\n\",\"  \\\"package_file_count\\\": 25,\\n\",\"  \\\"limitations\\\": [\\n\",\"    \\\"Community-hosted Academic Torrents provenance.\\\",\\n\",\"    \\\"No independent official checksum authentication.\\\",\\n\",\"    \\\"Cropped frontal-pose subset rather than full Extended Yale B.\\\",\\n\",\"    \\\"Direct resizing differs from Experiment 18 MTCNN preprocessing.\\\",\\n\",\"    \\\"External dataset validation is not independent model validation.\\\",\\n\",\"    \\\"Repeated identity-condition captures are not exact image-level pairs.\\\",\\n\",\"    \\\"Embedding extraction success does not establish recognition accuracy.\\\"\\n\",\"  ]\\n\",\"}\\n\",\"\\n\",\"====================================================================================================\\n\",\"RECONCILIATION SUMMARY\\n\",\"====================================================================================================\\n\",\"Acquisition record available: True\\n\",\"Alternative-source audit available: True\\n\",\"Torrent metadata audit available: True\\n\",\"Freeze manifest available: True\\n\",\"Candidate and acquisition URLs match: False\\n\",\"Frozen source SHA256 matches acquisition hash: True\\n\",\"\\n\",\"IMPORTANT:\\n\",\"A matching SHA256 establishes file identity, not official source authenticity.\\n\",\"No source authenticity claim is made by this audit.\\n\",\"====================================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.1.5.2: Correct Acquisition Listing Verification\\n\",\"\\n\",\"## Objective\\n\",\"Verify the Academic Torrents listing corresponding to the actual\\n\",\"CroppedYale.zip acquisition record and document the corrected provenance.\\n\",\"\\n\",\"## Expected listing details\\n\",\"- Dataset: The Extended Yale Face Database B (Cropped)\\n\",\"- Info-hash: aad8bf8e6ee5d8a3bf46c7ab5adfacdd8ad36247\\n\",\"- Filename: CroppedYale.zip\\n\",\"- Size: 58,493,820 bytes\\n\",\"\\n\",\"## Restrictions\\n\",\"- Read-only inspection of the source listing.\\n\",\"- Do not download or replace the dataset.\\n\",\"- Do not modify the frozen package.\\n\",\"- Save a separate supplementary audit record.\\n\",\"- Do not claim official Yale checksum authentication.\"],\"metadata\":{\"id\":\"MjE4lYOFu9qD\"}},{\"cell_type\":\"markdown\",\"source\":[],\"metadata\":{\"id\":\"LZ3yxMzEu99r\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"from datetime import datetime, timezone\\n\",\"import requests\\n\",\"import re\\n\",\"import json\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"AUDIT_DIR = BASE / \\\"dataset_audit\\\"\\n\",\"\\n\",\"ACQUISITION_FILE = (\\n\",\"    AUDIT_DIR / \\\"experiment20_croppedyale_acquisition_record.json\\\"\\n\",\")\\n\",\"\\n\",\"OUTPUT_FILE = (\\n\",\"    AUDIT_DIR / \\\"experiment20_acquisition_source_reconciliation_audit.json\\\"\\n\",\")\\n\",\"\\n\",\"EXPECTED_INFO_HASH = (\\n\",\"    \\\"aad8bf8e6ee5d8a3bf46c7ab5adfacdd8ad36247\\\"\\n\",\")\\n\",\"\\n\",\"EXPECTED_FILENAME = \\\"CroppedYale.zip\\\"\\n\",\"EXPECTED_SIZE = 58493820\\n\",\"\\n\",\"SOURCE_URL = (\\n\",\"    \\\"https://academictorrents.com/details/\\\"\\n\",\"    + EXPECTED_INFO_HASH\\n\",\"    + \\\"/tech\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"=\\\" * 100)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.1.5.2\\\")\\n\",\"print(\\\"CORRECT ACQUISITION LISTING VERIFICATION\\\")\\n\",\"print(\\\"=\\\" * 100)\\n\",\"\\n\",\"if not ACQUISITION_FILE.exists():\\n\",\"    raise FileNotFoundError(ACQUISITION_FILE)\\n\",\"\\n\",\"with ACQUISITION_FILE.open(\\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    acquisition = json.load(f)\\n\",\"\\n\",\"recorded_url = acquisition.get(\\\"source\\\")\\n\",\"recorded_hash = acquisition.get(\\\"sha256\\\")\\n\",\"recorded_size = acquisition.get(\\\"archive_size_bytes\\\")\\n\",\"\\n\",\"print(\\\"\\\\nACQUISITION RECORD\\\")\\n\",\"print(\\\"Source URL:\\\", recorded_url)\\n\",\"print(\\\"Archive SHA256:\\\", recorded_hash)\\n\",\"print(\\\"Archive size:\\\", recorded_size)\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# Fetch the exact Academic Torrents listing\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"response = requests.get(\\n\",\"    SOURCE_URL,\\n\",\"    timeout=30,\\n\",\"    headers={\\\"User-Agent\\\": \\\"Mozilla/5.0\\\"}\\n\",\")\\n\",\"\\n\",\"response.raise_for_status()\\n\",\"\\n\",\"html = response.text\\n\",\"html_lower = html.lower()\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# Extract and verify listing evidence\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"hash_match = (\\n\",\"    EXPECTED_INFO_HASH.lower() in html_lower\\n\",\")\\n\",\"\\n\",\"filename_match = (\\n\",\"    EXPECTED_FILENAME.lower() in html_lower\\n\",\")\\n\",\"\\n\",\"size_match = (\\n\",\"    \\\"58.49mb\\\" in html_lower\\n\",\"    or \\\"58,493,820\\\" in html\\n\",\"    or \\\"58493820\\\" in html\\n\",\")\\n\",\"\\n\",\"title_match = (\\n\",\"    \\\"extended yale face database b\\\" in html_lower\\n\",\"    and \\\"cropped\\\" in html_lower\\n\",\")\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# Compare actual acquisition URL with correct listing\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"url_hash_match = (\\n\",\"    EXPECTED_INFO_HASH.lower() in (recorded_url or \\\"\\\").lower()\\n\",\")\\n\",\"\\n\",\"archive_size_match = (\\n\",\"    recorded_size == EXPECTED_SIZE\\n\",\")\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# Build supplementary audit record\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"checks = {\\n\",\"    \\\"listing_http_success\\\": response.status_code == 200,\\n\",\"    \\\"listing_info_hash_matches\\\": hash_match,\\n\",\"    \\\"listing_filename_matches\\\": filename_match,\\n\",\"    \\\"listing_size_matches\\\": size_match,\\n\",\"    \\\"listing_title_matches\\\": title_match,\\n\",\"    \\\"acquisition_url_contains_correct_info_hash\\\": url_hash_match,\\n\",\"    \\\"acquisition_size_matches_listing\\\": archive_size_match,\\n\",\"}\\n\",\"\\n\",\"listing_match = all(checks.values())\\n\",\"\\n\",\"audit = {\\n\",\"    \\\"experiment\\\": 20,\\n\",\"    \\\"step\\\": \\\"3.1.5.2\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"source_listing\\\": SOURCE_URL,\\n\",\"    \\\"expected_dataset_title\\\": \\\"The Extended Yale Face Database B (Cropped)\\\",\\n\",\"    \\\"expected_info_hash\\\": EXPECTED_INFO_HASH,\\n\",\"    \\\"expected_filename\\\": EXPECTED_FILENAME,\\n\",\"    \\\"expected_size_bytes\\\": EXPECTED_SIZE,\\n\",\"    \\\"acquisition_record\\\": {\\n\",\"        \\\"source_url\\\": recorded_url,\\n\",\"        \\\"archive_sha256\\\": recorded_hash,\\n\",\"        \\\"archive_size_bytes\\\": recorded_size,\\n\",\"    },\\n\",\"    \\\"listing_http_status\\\": response.status_code,\\n\",\"    \\\"listing_checks\\\": checks,\\n\",\"    \\\"listing_matches_acquisition_record\\\": listing_match,\\n\",\"    \\\"limitations\\\": [\\n\",\"        \\\"Listing metadata does not independently verify torrent piece hashes.\\\",\\n\",\"        \\\"Archive SHA256 establishes file identity, not official Yale authenticity.\\\",\\n\",\"        \\\"No official Yale checksum authentication was performed.\\\",\\n\",\"    ],\\n\",\"    \\\"status\\\": (\\n\",\"        \\\"CORRECT_ACQUISITION_LISTING_MATCHED\\\"\\n\",\"        if listing_match\\n\",\"        else \\\"LISTING_RECONCILIATION_FAILED\\\"\\n\",\"    ),\\n\",\"}\\n\",\"\\n\",\"AUDIT_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"with OUTPUT_FILE.open(\\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    json.dump(audit, f, indent=2, ensure_ascii=False)\\n\",\"\\n\",\"# Reload to verify valid JSON\\n\",\"with OUTPUT_FILE.open(\\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    reloaded = json.load(f)\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 100)\\n\",\"print(\\\"LISTING VERIFICATION CHECKS\\\")\\n\",\"print(\\\"=\\\" * 100)\\n\",\"\\n\",\"for name, passed in checks.items():\\n\",\"    print(f\\\"{name}: {'PASS' if passed else 'FAIL'}\\\")\\n\",\"\\n\",\"print(\\\"\\\\nFINAL STATUS:\\\", reloaded[\\\"status\\\"])\\n\",\"print(\\\"Audit saved:\\\", OUTPUT_FILE)\\n\",\"print(\\\"Audit JSON reload:\\\", \\\"PASS\\\")\\n\",\"\\n\",\"print(\\\"\\\\nIMPORTANT LIMITATION\\\")\\n\",\"for item in reloaded[\\\"limitations\\\"]:\\n\",\"    print(\\\"-\\\", item)\\n\",\"\\n\",\"print(\\\"=\\\" * 100)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"Ydw0lJLmvAP3\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794385909625,\"user_tz\":360,\"elapsed\":684,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"661f8852-1829-425a-b9e7-04f5d14e3a5d\"},\"execution_count\":11,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"====================================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.1.5.2\\n\",\"CORRECT ACQUISITION LISTING VERIFICATION\\n\",\"====================================================================================================\\n\",\"\\n\",\"ACQUISITION RECORD\\n\",\"Source URL: https://academictorrents.com/download/aad8bf8e6ee5d8a3bf46c7ab5adfacdd8ad36247.torrent\\n\",\"Archive SHA256: 8bbabf3836d077d60626c9ee3c54c2d2851a8d2c15c8b7e13b9bc162e86ea573\\n\",\"Archive size: 58493820\\n\",\"\\n\",\"====================================================================================================\\n\",\"LISTING VERIFICATION CHECKS\\n\",\"====================================================================================================\\n\",\"listing_http_success: PASS\\n\",\"listing_info_hash_matches: PASS\\n\",\"listing_filename_matches: PASS\\n\",\"listing_size_matches: PASS\\n\",\"listing_title_matches: PASS\\n\",\"acquisition_url_contains_correct_info_hash: PASS\\n\",\"acquisition_size_matches_listing: PASS\\n\",\"\\n\",\"FINAL STATUS: CORRECT_ACQUISITION_LISTING_MATCHED\\n\",\"Audit saved: /content/drive/MyDrive/Experiment_20_Results/dataset_audit/experiment20_acquisition_source_reconciliation_audit.json\\n\",\"Audit JSON reload: PASS\\n\",\"\\n\",\"IMPORTANT LIMITATION\\n\",\"- Listing metadata does not independently verify torrent piece hashes.\\n\",\"- Archive SHA256 establishes file identity, not official Yale authenticity.\\n\",\"- No official Yale checksum authentication was performed.\\n\",\"====================================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.1.6: Consolidated Methodological Risk Register\\n\",\"\\n\",\"## Objective\\n\",\"Consolidate the methodological findings from the completed Step 3.1 review.\\n\",\"\\n\",\"The register must distinguish:\\n\",\"1. Verified methodological properties.\\n\",\"2. Known limitations that must be disclosed.\\n\",\"3. Unresolved decisions requiring attention before manuscript submission.\\n\",\"\\n\",\"## Scope\\n\",\"This is a documentation and review step.\\n\",\"\\n\",\"It must not:\\n\",\"- Modify experimental data.\\n\",\"- Recalculate or replace statistical results.\\n\",\"- Change the frozen protocol.\\n\",\"- Introduce unsupported scientific claims.\\n\",\"- Treat embedding displacement as recognition accuracy.\\n\",\"- Treat descriptive analysis as a calibrated real-time detector.\\n\",\"\\n\",\"## Output\\n\",\"Save a structured JSON risk register and verify that it can be reloaded.\"],\"metadata\":{\"id\":\"Kx1-baI4vMVQ\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"from datetime import datetime, timezone\\n\",\"import json\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"OUTPUT_DIR = BASE / \\\"step_3_1\\\"\\n\",\"OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"OUTPUT_FILE = (\\n\",\"    OUTPUT_DIR /\\n\",\"    \\\"experiment20_step316_methodological_risk_register.json\\\"\\n\",\")\\n\",\"\\n\",\"risks = [\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"M01\\\",\\n\",\"        \\\"area\\\": \\\"Dataset provenance\\\",\\n\",\"        \\\"finding\\\": \\\"The actual acquisition listing matches the acquired CroppedYale.zip record.\\\",\\n\",\"        \\\"evidence\\\": [\\n\",\"            \\\"Step 3.1.5.2 supplementary acquisition-source reconciliation audit\\\",\\n\",\"            \\\"Matching acquisition info-hash and archive size\\\",\\n\",\"            \\\"Matching source archive SHA256\\\"\\n\",\"        ],\\n\",\"        \\\"classification\\\": \\\"verified_with_limitation\\\",\\n\",\"        \\\"limitation\\\": \\\"Official Yale checksum authentication and independent torrent-piece verification were not performed.\\\",\\n\",\"        \\\"manuscript_action\\\": \\\"Describe the community-hosted Academic Torrents acquisition and disclose the provenance limitation.\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"M02\\\",\\n\",\"        \\\"area\\\": \\\"Dataset scope\\\",\\n\",\"        \\\"finding\\\": \\\"The acquired dataset is the cropped frontal-pose subset, not the complete multi-pose Extended Yale B dataset.\\\",\\n\",\"        \\\"evidence\\\": [\\n\",\"            \\\"Frozen dataset README\\\",\\n\",\"            \\\"Dataset acquisition and cohort audits\\\",\\n\",\"            \\\"38 identities and P00 pose\\\"\\n\",\"        ],\\n\",\"        \\\"classification\\\": \\\"verified_scope_limitation\\\",\\n\",\"        \\\"limitation\\\": \\\"The findings cannot be generalized to all poses or the complete Extended Yale B dataset.\\\",\\n\",\"        \\\"manuscript_action\\\": \\\"Use the precise cropped frontal-pose subset description throughout.\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"M03\\\",\\n\",\"        \\\"area\\\": \\\"Repeated observations\\\",\\n\",\"        \\\"finding\\\": \\\"Evaluation observations are identity-condition matched captures under different illumination conditions.\\\",\\n\",\"        \\\"evidence\\\": [\\n\",\"            \\\"Common illumination condition manifest\\\",\\n\",\"            \\\"38 identities\\\",\\n\",\"            \\\"57 common conditions\\\",\\n\",\"            \\\"2,166 common-condition observations\\\"\\n\",\"        ],\\n\",\"        \\\"classification\\\": \\\"verified_design_limitation\\\",\\n\",\"        \\\"limitation\\\": \\\"Different captures are not exact source-image perturbations.\\\",\\n\",\"        \\\"manuscript_action\\\": \\\"Avoid describing the observations as exact image-level pairs.\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"M04\\\",\\n\",\"        \\\"area\\\": \\\"Preprocessing reproducibility\\\",\\n\",\"        \\\"finding\\\": \\\"Images were converted from grayscale to RGB, resized to 160x160, and converted using ToTensor.\\\",\\n\",\"        \\\"evidence\\\": [\\n\",\"            \\\"Freeze manifest\\\",\\n\",\"            \\\"Embedding generation configuration\\\",\\n\",\"            \\\"Preprocessing consistency audit\\\"\\n\",\"        ],\\n\",\"        \\\"classification\\\": \\\"partially_documented\\\",\\n\",\"        \\\"limitation\\\": \\\"Resize interpolation and some software/model execution details remain insufficiently documented.\\\",\\n\",\"        \\\"manuscript_action\\\": \\\"Recover these details from the original execution environment if possible; otherwise disclose them as unavailable.\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"M05\\\",\\n\",\"        \\\"area\\\": \\\"Model validation\\\",\\n\",\"        \\\"finding\\\": \\\"The same pretrained VGGFace2 InceptionResnetV1 FaceNet backbone was used.\\\",\\n\",\"        \\\"evidence\\\": [\\n\",\"            \\\"Freeze manifest\\\",\\n\",\"            \\\"Embedding metadata\\\",\\n\",\"            \\\"Model configuration\\\"\\n\",\"        ],\\n\",\"        \\\"classification\\\": \\\"verified_design_limitation\\\",\\n\",\"        \\\"limitation\\\": \\\"The external dataset does not constitute independent model validation.\\\",\\n\",\"        \\\"manuscript_action\\\": \\\"Describe this as external dataset evaluation using the same pretrained model.\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"M06\\\",\\n\",\"        \\\"area\\\": \\\"Statistical inference\\\",\\n\",\"        \\\"finding\\\": \\\"Repeated-measures Friedman and Wilcoxon analyses were reproduced.\\\",\\n\",\"        \\\"evidence\\\": [\\n\",\"            \\\"Step 3.1.3 independent statistical reproduction\\\",\\n\",\"            \\\"38 identities\\\",\\n\",\"            \\\"All six pairwise comparisons reproduced\\\"\\n\",\"        ],\\n\",\"        \\\"classification\\\": \\\"reproduced_with_reporting_decision\\\",\\n\",\"        \\\"limitation\\\": \\\"Holm correction was applied separately to the three comparisons for each metric; the protocol does not explicitly define the correction family.\\\",\\n\",\"        \\\"manuscript_action\\\": \\\"Justify the two metric-wise families or recompute using one six-comparison family. Do not silently change the correction.\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"M07\\\",\\n\",\"        \\\"area\\\": \\\"Descriptive analysis\\\",\\n\",\"        \\\"finding\\\": \\\"Euclidean displacement and cosine distance quantify embedding changes relative to the reference condition.\\\",\\n\",\"        \\\"evidence\\\": [\\n\",\"            \\\"Frozen descriptive analysis protocol\\\",\\n\",\"            \\\"Step 2.7.2 displacement analysis\\\",\\n\",\"            \\\"Step 2.7.3 group statistics\\\"\\n\",\"        ],\\n\",\"        \\\"classification\\\": \\\"verified_scope_limitation\\\",\\n\",\"        \\\"limitation\\\": \\\"These metrics do not establish identity recognition accuracy, detector accuracy, or operational robustness.\\\",\\n\",\"        \\\"manuscript_action\\\": \\\"Interpret results as embedding displacement only.\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"M08\\\",\\n\",\"        \\\"area\\\": \\\"Detector calibration\\\",\\n\",\"        \\\"finding\\\": \\\"The selected analysis is descriptive and does not use calibrated detection thresholds.\\\",\\n\",\"        \\\"evidence\\\": [\\n\",\"            \\\"Step 2.7.1 protocol\\\",\\n\",\"            \\\"No threshold calibration\\\",\\n\",\"            \\\"No false-alarm evaluation\\\"\\n\",\"        ],\\n\",\"        \\\"classification\\\": \\\"verified_scope_limitation\\\",\\n\",\"        \\\"limitation\\\": \\\"No operational false-alarm control or real-time detection performance can be claimed.\\\",\\n\",\"        \\\"manuscript_action\\\": \\\"Do not present this experiment as a validated real-time drift detector.\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"M09\\\",\\n\",\"        \\\"area\\\": \\\"Lighting geometry\\\",\\n\",\"        \\\"finding\\\": \\\"Illumination groups represent angular deviation of light direction.\\\",\\n\",\"        \\\"evidence\\\": [\\n\",\"            \\\"Lighting geometry grouping audit\\\",\\n\",\"            \\\"Near-frontal, oblique, and large-angular groups\\\"\\n\",\"        ],\\n\",\"        \\\"classification\\\": \\\"verified_interpretation_constraint\\\",\\n\",\"        \\\"limitation\\\": \\\"The groups do not directly measure illumination intensity.\\\",\\n\",\"        \\\"manuscript_action\\\": \\\"Use light-direction geometry terminology rather than intensity categories.\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"M10\\\",\\n\",\"        \\\"area\\\": \\\"Hemisphere analysis\\\",\\n\",\"        \\\"finding\\\": \\\"Frontal and beyond-frontal conditions were compared descriptively and statistically.\\\",\\n\",\"        \\\"evidence\\\": [\\n\",\"            \\\"Step 2.7.5 hemisphere analysis\\\",\\n\",\"            \\\"45 frontal evaluation conditions\\\",\\n\",\"            \\\"11 beyond-frontal evaluation conditions\\\"\\n\",\"        ],\\n\",\"        \\\"classification\\\": \\\"exploratory_limitation\\\",\\n\",\"        \\\"limitation\\\": \\\"Unequal condition counts and confounding with angular geometry limit interpretation.\\\",\\n\",\"        \\\"manuscript_action\\\": \\\"Present hemisphere findings as exploratory, not as an isolated causal effect.\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"M11\\\",\\n\",\"        \\\"area\\\": \\\"Reference representation\\\",\\n\",\"        \\\"finding\\\": \\\"One reference embedding per identity was used.\\\",\\n\",\"        \\\"evidence\\\": [\\n\",\"            \\\"Reference condition A+000E+00\\\",\\n\",\"            \\\"38 reference embeddings\\\"\\n\",\"        ],\\n\",\"        \\\"classification\\\": \\\"verified_design_limitation\\\",\\n\",\"        \\\"limitation\\\": \\\"One reference embedding per identity does not support reliable identity-conditioned covariance estimation.\\\",\\n\",\"        \\\"manuscript_action\\\": \\\"Do not claim identity-conditioned Mahalanobis calibration or covariance modelling.\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"M12\\\",\\n\",\"        \\\"area\\\": \\\"Cohort selection\\\",\\n\",\"        \\\"finding\\\": \\\"The analysis uses 38 identities sharing 57 illumination conditions.\\\",\\n\",\"        \\\"evidence\\\": [\\n\",\"            \\\"Common illumination condition manifest\\\",\\n\",\"            \\\"2,128 evaluation observations after reference exclusion\\\"\\n\",\"        ],\\n\",\"        \\\"classification\\\": \\\"verified_scope_limitation\\\",\\n\",\"        \\\"limitation\\\": \\\"Seven identities are incomplete in the broader dataset, and only common conditions enter the main evaluation.\\\",\\n\",\"        \\\"manuscript_action\\\": \\\"Explain the common-condition cohort selection and avoid implying complete condition coverage.\\\"\\n\",\"    }\\n\",\"]\\n\",\"\\n\",\"register = {\\n\",\"    \\\"experiment\\\": 20,\\n\",\"    \\\"step\\\": \\\"3.1.6\\\",\\n\",\"    \\\"title\\\": \\\"Consolidated Methodological Risk Register\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"source_review_steps\\\": [\\n\",\"        \\\"3.1.1\\\",\\n\",\"        \\\"3.1.2\\\",\\n\",\"        \\\"3.1.3\\\",\\n\",\"        \\\"3.1.4\\\",\\n\",\"        \\\"3.1.5\\\",\\n\",\"        \\\"3.1.5.1\\\",\\n\",\"        \\\"3.1.5.2\\\"\\n\",\"    ],\\n\",\"    \\\"risk_count\\\": len(risks),\\n\",\"    \\\"classification_counts\\\": {},\\n\",\"    \\\"risks\\\": risks,\\n\",\"    \\\"overall_assessment\\\": (\\n\",\"        \\\"The experiment has a reproducible descriptive analysis and a \\\"\\n\",\"        \\\"documented cohort, but important scope, provenance, preprocessing, \\\"\\n\",\"        \\\"and inferential limitations must be explicitly handled in the manuscript.\\\"\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"for item in risks:\\n\",\"    category = item[\\\"classification\\\"]\\n\",\"    register[\\\"classification_counts\\\"][category] = (\\n\",\"        register[\\\"classification_counts\\\"].get(category, 0) + 1\\n\",\"    )\\n\",\"\\n\",\"with OUTPUT_FILE.open(\\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    json.dump(register, f, indent=2, ensure_ascii=False)\\n\",\"\\n\",\"with OUTPUT_FILE.open(\\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    verified = json.load(f)\\n\",\"\\n\",\"assert len(verified[\\\"risks\\\"]) == 12\\n\",\"assert len({r[\\\"id\\\"] for r in verified[\\\"risks\\\"]}) == 12\\n\",\"assert all(\\n\",\"    r[\\\"finding\\\"] and r[\\\"limitation\\\"] and r[\\\"manuscript_action\\\"]\\n\",\"    for r in verified[\\\"risks\\\"]\\n\",\")\\n\",\"\\n\",\"print(\\\"=\\\" * 100)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.1.6\\\")\\n\",\"print(\\\"CONSOLIDATED METHODOLOGICAL RISK REGISTER\\\")\\n\",\"print(\\\"=\\\" * 100)\\n\",\"\\n\",\"print(\\\"Risk entries:\\\", verified[\\\"risk_count\\\"])\\n\",\"print(\\\"\\\\nClassification counts:\\\")\\n\",\"for key, value in verified[\\\"classification_counts\\\"].items():\\n\",\"    print(f\\\"{key}: {value}\\\")\\n\",\"\\n\",\"print(\\\"\\\\nValidation:\\\")\\n\",\"print(\\\"Unique risk IDs:\\\", \\\"PASS\\\")\\n\",\"print(\\\"Required fields:\\\", \\\"PASS\\\")\\n\",\"print(\\\"JSON reload:\\\", \\\"PASS\\\")\\n\",\"\\n\",\"print(\\\"\\\\nOverall assessment:\\\")\\n\",\"print(verified[\\\"overall_assessment\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nSaved:\\\", OUTPUT_FILE)\\n\",\"print(\\\"=\\\" * 100)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"3pVysjsevQEo\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794385971962,\"user_tz\":360,\"elapsed\":64,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"e2be9b05-e10d-472d-a349-2ace84ebcf12\"},\"execution_count\":12,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"====================================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.1.6\\n\",\"CONSOLIDATED METHODOLOGICAL RISK REGISTER\\n\",\"====================================================================================================\\n\",\"Risk entries: 12\\n\",\"\\n\",\"Classification counts:\\n\",\"verified_with_limitation: 1\\n\",\"verified_scope_limitation: 4\\n\",\"verified_design_limitation: 3\\n\",\"partially_documented: 1\\n\",\"reproduced_with_reporting_decision: 1\\n\",\"verified_interpretation_constraint: 1\\n\",\"exploratory_limitation: 1\\n\",\"\\n\",\"Validation:\\n\",\"Unique risk IDs: PASS\\n\",\"Required fields: PASS\\n\",\"JSON reload: PASS\\n\",\"\\n\",\"Overall assessment:\\n\",\"The experiment has a reproducible descriptive analysis and a documented cohort, but important scope, provenance, preprocessing, and inferential limitations must be explicitly handled in the manuscript.\\n\",\"\\n\",\"Saved: /content/drive/MyDrive/Experiment_20_Results/step_3_1/experiment20_step316_methodological_risk_register.json\\n\",\"====================================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.1.7: Final Unresolved-Decision Register\\n\",\"\\n\",\"## Objective\\n\",\"Record unresolved methodological and reporting decisions before closing the methodological review.\\n\",\"\\n\",\"This step must not modify the frozen experiment or recalculate results.\\n\",\"\\n\",\"## Decisions to track\\n\",\"1. Holm correction family justification.\\n\",\"2. Resize interpolation and missing preprocessing details.\\n\",\"3. Exact model/checkpoint and software-version documentation.\\n\",\"4. Official dataset checksum authentication limitation.\\n\",\"5. Correct scope description of the cropped frontal-pose subset.\\n\",\"\\n\",\"## Output\\n\",\"A JSON register containing each decision, its current status,\\n\",\"required action, and whether it blocks manuscript submission.\"],\"metadata\":{\"id\":\"gunXCRXkvXTR\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"from datetime import datetime, timezone\\n\",\"import json\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"OUTPUT_DIR = BASE / \\\"step_3_1\\\"\\n\",\"OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"OUTPUT_FILE = (\\n\",\"    OUTPUT_DIR /\\n\",\"    \\\"experiment20_step317_unresolved_decisions.json\\\"\\n\",\")\\n\",\"\\n\",\"decisions = [\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"D01\\\",\\n\",\"        \\\"decision\\\": \\\"Multiple-comparison correction family\\\",\\n\",\"        \\\"current_status\\\": \\\"UNRESOLVED\\\",\\n\",\"        \\\"current_analysis\\\": \\\"Holm correction applied separately to three pairwise comparisons for each metric.\\\",\\n\",\"        \\\"required_action\\\": \\\"Justify the two metric-wise outcome families or recalculate using one six-comparison family.\\\",\\n\",\"        \\\"blocks_manuscript_submission\\\": True\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"D02\\\",\\n\",\"        \\\"decision\\\": \\\"Resize interpolation method\\\",\\n\",\"        \\\"current_status\\\": \\\"NOT_FULLY_DOCUMENTED\\\",\\n\",\"        \\\"current_analysis\\\": \\\"Images resized to 160x160; interpolation method not established in the reviewed records.\\\",\\n\",\"        \\\"required_action\\\": \\\"Recover the interpolation method from the original execution environment if possible; otherwise disclose it as unavailable.\\\",\\n\",\"        \\\"blocks_manuscript_submission\\\": True\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"D03\\\",\\n\",\"        \\\"decision\\\": \\\"Exact model checkpoint and software versions\\\",\\n\",\"        \\\"current_status\\\": \\\"PARTIALLY_DOCUMENTED\\\",\\n\",\"        \\\"current_analysis\\\": \\\"InceptionResnetV1 pretrained on VGGFace2 is documented; complete checkpoint identity and environment versions remain insufficiently established.\\\",\\n\",\"        \\\"required_action\\\": \\\"Recover checkpoint identity and relevant package versions where possible; disclose unrecoverable details.\\\",\\n\",\"        \\\"blocks_manuscript_submission\\\": True\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"D04\\\",\\n\",\"        \\\"decision\\\": \\\"Official dataset authenticity\\\",\\n\",\"        \\\"current_status\\\": \\\"KNOWN_LIMITATION\\\",\\n\",\"        \\\"current_analysis\\\": \\\"Acquisition listing and archive hash match, but no independent official Yale checksum authentication was performed.\\\",\\n\",\"        \\\"required_action\\\": \\\"Disclose the community-hosted source and absence of official checksum authentication.\\\",\\n\",\"        \\\"blocks_manuscript_submission\\\": False\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"id\\\": \\\"D05\\\",\\n\",\"        \\\"decision\\\": \\\"Dataset scope terminology\\\",\\n\",\"        \\\"current_status\\\": \\\"RESOLVED\\\",\\n\",\"        \\\"current_analysis\\\": \\\"The acquired data represent a cropped frontal-pose subset, not the complete multi-pose Extended Yale B dataset.\\\",\\n\",\"        \\\"required_action\\\": \\\"Use the precise dataset scope consistently throughout the manuscript.\\\",\\n\",\"        \\\"blocks_manuscript_submission\\\": False\\n\",\"    }\\n\",\"]\\n\",\"\\n\",\"register = {\\n\",\"    \\\"experiment\\\": 20,\\n\",\"    \\\"step\\\": \\\"3.1.7\\\",\\n\",\"    \\\"timestamp_utc\\\": datetime.now(timezone.utc).isoformat(),\\n\",\"    \\\"decision_count\\\": len(decisions),\\n\",\"    \\\"decisions\\\": decisions,\\n\",\"    \\\"submission_blocking_count\\\": sum(\\n\",\"        d[\\\"blocks_manuscript_submission\\\"] for d in decisions\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"with OUTPUT_FILE.open(\\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    json.dump(register, f, indent=2, ensure_ascii=False)\\n\",\"\\n\",\"with OUTPUT_FILE.open(\\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    verified = json.load(f)\\n\",\"\\n\",\"assert len(verified[\\\"decisions\\\"]) == 5\\n\",\"assert len({d[\\\"id\\\"] for d in verified[\\\"decisions\\\"]}) == 5\\n\",\"assert verified[\\\"submission_blocking_count\\\"] == 3\\n\",\"\\n\",\"print(\\\"=\\\" * 100)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.1.7\\\")\\n\",\"print(\\\"FINAL UNRESOLVED-DECISION REGISTER\\\")\\n\",\"print(\\\"=\\\" * 100)\\n\",\"\\n\",\"for item in verified[\\\"decisions\\\"]:\\n\",\"    print(f\\\"\\\\n{item['id']} — {item['decision']}\\\")\\n\",\"    print(\\\"Status:\\\", item[\\\"current_status\\\"])\\n\",\"    print(\\\"Blocks submission:\\\", item[\\\"blocks_manuscript_submission\\\"])\\n\",\"    print(\\\"Required action:\\\", item[\\\"required_action\\\"])\\n\",\"\\n\",\"print(\\\"\\\\nTotal decisions:\\\", verified[\\\"decision_count\\\"])\\n\",\"print(\\\"Submission-blocking decisions:\\\", verified[\\\"submission_blocking_count\\\"])\\n\",\"print(\\\"JSON reload: PASS\\\")\\n\",\"print(\\\"Saved:\\\", OUTPUT_FILE)\\n\",\"print(\\\"=\\\" * 100)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"vhA7wyZOvZEE\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794386008529,\"user_tz\":360,\"elapsed\":83,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"7b315765-07bd-4dfb-9c3e-183005b95733\"},\"execution_count\":13,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"====================================================================================================\\n\",\"EXPERIMENT 20 — STEP 3.1.7\\n\",\"FINAL UNRESOLVED-DECISION REGISTER\\n\",\"====================================================================================================\\n\",\"\\n\",\"D01 — Multiple-comparison correction family\\n\",\"Status: UNRESOLVED\\n\",\"Blocks submission: True\\n\",\"Required action: Justify the two metric-wise outcome families or recalculate using one six-comparison family.\\n\",\"\\n\",\"D02 — Resize interpolation method\\n\",\"Status: NOT_FULLY_DOCUMENTED\\n\",\"Blocks submission: True\\n\",\"Required action: Recover the interpolation method from the original execution environment if possible; otherwise disclose it as unavailable.\\n\",\"\\n\",\"D03 — Exact model checkpoint and software versions\\n\",\"Status: PARTIALLY_DOCUMENTED\\n\",\"Blocks submission: True\\n\",\"Required action: Recover checkpoint identity and relevant package versions where possible; disclose unrecoverable details.\\n\",\"\\n\",\"D04 — Official dataset authenticity\\n\",\"Status: KNOWN_LIMITATION\\n\",\"Blocks submission: False\\n\",\"Required action: Disclose the community-hosted source and absence of official checksum authentication.\\n\",\"\\n\",\"D05 — Dataset scope terminology\\n\",\"Status: RESOLVED\\n\",\"Blocks submission: False\\n\",\"Required action: Use the precise dataset scope consistently throughout the manuscript.\\n\",\"\\n\",\"Total decisions: 5\\n\",\"Submission-blocking decisions: 3\\n\",\"JSON reload: PASS\\n\",\"Saved: /content/drive/MyDrive/Experiment_20_Results/step_3_1/experiment20_step317_unresolved_decisions.json\\n\",\"====================================================================================================\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"# Experiment 20 — Step 3.1.8: Preprocessing and Model Metadata Recovery\\n\",\"\\n\",\"## Objective\\n\",\"Inspect the existing experiment records to determine whether the following\\n\",\"details can be recovered:\\n\",\"\\n\",\"1. Resize interpolation method.\\n\",\"2. Exact FaceNet model architecture and pretrained weights.\\n\",\"3. Checkpoint identity or hash.\\n\",\"4. Python, PyTorch, torchvision, and facenet-pytorch versions.\\n\",\"5. Image normalization and inference configuration.\\n\",\"\\n\",\"## Sources\\n\",\"- Embedding generation configuration.\\n\",\"- Embedding checkpoint metadata.\\n\",\"- Preprocessing consistency audit.\\n\",\"- Freeze manifest.\\n\",\"- Acquisition and embedding metadata.\\n\",\"\\n\",\"## Restrictions\\n\",\"- Read-only inspection.\\n\",\"- Do not regenerate embeddings.\\n\",\"- Do not modify existing experiment files.\\n\",\"- Do not infer missing values.\\n\",\"- Clearly distinguish documented values from unavailable values.\\n\",\"\\n\",\"## Output\\n\",\"A metadata recovery report identifying recovered, partially recovered,\\n\",\"and unavailable details.\"],\"metadata\":{\"id\":\"VQoJlsetvlHM\"}},{\"cell_type\":\"code\",\"source\":[\"from pathlib import Path\\n\",\"import json\\n\",\"\\n\",\"BASE = Path(\\\"/content/drive/MyDrive/Experiment_20_Results\\\")\\n\",\"\\n\",\"FILES = {\\n\",\"    \\\"generation_config\\\": (\\n\",\"        BASE / \\\"embeddings\\\" /\\n\",\"        \\\"experiment20_embedding_generation_config.json\\\"\\n\",\"    ),\\n\",\"    \\\"checkpoint_metadata\\\": (\\n\",\"        BASE / \\\"embeddings\\\" / \\\"checkpoints\\\" /\\n\",\"        \\\"experiment20_embedding_checkpoint_metadata.json\\\"\\n\",\"    ),\\n\",\"    \\\"preprocessing_audit\\\": (\\n\",\"        BASE / \\\"dataset_audit\\\" /\\n\",\"        \\\"experiment20_preprocessing_consistency_audit.json\\\"\\n\",\"    ),\\n\",\"    \\\"compatibility_audit\\\": (\\n\",\"        BASE / \\\"dataset_audit\\\" /\\n\",\"        \\\"experiment20_facenet_preprocessing_compatibility_audit.json\\\"\\n\",\"    ),\\n\",\"    \\\"freeze_manifest\\\": (\\n\",\"        BASE / \\\"Experiment_20_Stage_2_Freeze_Manifest.json\\\"\\n\",\"    ),\\n\",\"    \\\"embedding_metadata\\\": (\\n\",\"        BASE / \\\"embeddings\\\" /\\n\",\"        \\\"experiment20_croppedyale_embedding_metadata.json\\\"\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"print(\\\"=\\\" * 100)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 3.1.8\\\")\\n\",\"print(\\\"PREPROCESSING AND MODEL METADATA RECOVERY\\\")\\n\",\"print(\\\"=\\\" * 100)\\n\",\"\\n\",\"loaded = {}\\n\",\"\\n\",\"for name, path in FILES.items():\\n\",\"    print(f\\\"\\\\n{'=' * 80}\\\")\\n\",\"    print(\\\"SOURCE:\\\", name)\\n\",\"    print(\\\"PATH:\\\", path)\\n\",\"\\n\",\"    if not path.exists():\\n\",\"        print(\\\"STATUS: FILE NOT FOUND\\\")\\n\",\"        continue\\n\",\"\\n\",\"    try:\\n\",\"        with path.open(\\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"            data = json.load(f)\\n\",\"\\n\",\"        loaded[name] = data\\n\",\"\\n\",\"        print(\\\"STATUS: LOADED\\\")\\n\",\"        print(\\\"TOP-LEVEL TYPE:\\\", type(data).__name__)\\n\",\"\\n\",\"        if isinstance(data, dict):\\n\",\"            print(\\\"TOP-LEVEL KEYS:\\\", list(data.keys()))\\n\",\"\\n\",\"            print(\\\"\\\\nFULL JSON CONTENT:\\\")\\n\",\"            print(json.dumps(data, indent=2, ensure_ascii=False))\\n\",\"\\n\",\"        elif isinstance(data, list):\\n\",\"            print(\\\"ITEM COUNT:\\\", len(data))\\n\",\"            print(json.dumps(data[:5], indent=2, ensure_ascii=False))\\n\",\"\\n\",\"    except Exception as exc:\\n\",\"        print(\\\"READ ERROR:\\\", repr(exc))\\n\",\"\\n\",\"# ---------------------------------------------------------\\n\",\"# Runtime versions: current environment only.\\n\",\"# These do not establish historical generation versions.\\n\",\"# ---------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 100)\\n\",\"print(\\\"CURRENT COLAB RUNTIME VERSIONS\\\")\\n\",\"print(\\\"=\\\" * 100)\\n\",\"\\n\",\"import sys\\n\",\"import platform\\n\",\"import importlib.metadata as metadata\\n\",\"\\n\",\"print(\\\"Python:\\\", sys.version)\\n\",\"print(\\\"Platform:\\\", platform.platform())\\n\",\"\\n\",\"for package in [\\n\",\"    \\\"torch\\\",\\n\",\"    \\\"torchvision\\\",\\n\",\"    \\\"facenet-pytorch\\\",\\n\",\"    \\\"numpy\\\",\\n\",\"    \\\"Pillow\\\"\\n\",\"]:\\n\",\"    try:\\n\",\"        print(f\\\"{package}: {metadata.version(package)}\\\")\\n\",\"    except metadata.PackageNotFoundError:\\n\",\"        print(f\\\"{package}: NOT INSTALLED\\\")\\n\",\"\\n\",\"print(\\\"\\\\nIMPORTANT:\\\")\\n\",\"print(\\\"Current runtime versions are not proof of historical embedding-generation versions.\\\")\\n\",\"print(\\\"No experiment files were modified.\\\")\\n\",\"print