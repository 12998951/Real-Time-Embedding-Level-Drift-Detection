      "source": [
        "\n",
        "# ================================================================\n",
        "# EXPERIMENT 20 — STEP 3.3.13\n",
        "# CORRECTED FULL MANUSCRIPT SCIENTIFIC AND EDITORIAL AUDIT\n",
        "# ================================================================\n",
        "\n",
        "import json\n",
        "import re\n",
        "import hashlib\n",
        "import warnings\n",
        "\n",
        "from pathlib import Path\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "warnings.filterwarnings(\"ignore\")\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 1. PATHS\n",
        "# ------------------------------------------------\n",
        "\n",
        "ROOT = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "\n",
        "MANUSCRIPT = (\n",
        "    ROOT / \"step_3_3\" / \"step_3312\"\n",
        "    / \"experiment20_integrated_manuscript_v1.md\"\n",
        ")\n",
        "\n",
        "INTEGRATION_RECORD = (\n",
        "    ROOT / \"step_3_3\" / \"step_3312\"\n",
        "    / \"experiment20_step3312_integration_record.json\"\n",
        ")\n",
        "\n",
        "FROZEN = ROOT / \"step_2_7\" / \"final_freeze\"\n",
        "\n",
        "STEP_33103 = ROOT / \"step_3_3\" / \"step_33103\"\n",
        "\n",
        "OUT = ROOT / \"step_3_3\" / \"step_3313\"\n",
        "OUT.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "EXPECTED_SHA256 = (\n",
        "    \"9c28be661b5136baecc9a583d1702a2d\"\n",
        "    \"1f1a2d3045598722d3d55c649e5b8357\"\n",
        ")\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 2. HELPERS\n",
        "# ------------------------------------------------\n",
        "\n",
        "def sha256_file(path):\n",
        "    h = hashlib.sha256()\n",
        "    with open(path, \"rb\") as f:\n",
        "        for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n",
        "            h.update(chunk)\n",
        "    return h.hexdigest()\n",
        "\n",
        "\n",
        "def load_json(path):\n",
        "    with open(path, \"r\", encoding=\"utf-8\") as f:\n",
        "        return json.load(f)\n",
        "\n",
        "\n",
        "def save_json(path, obj):\n",
        "    with open(path, \"w\", encoding=\"utf-8\") as f:\n",
        "        json.dump(obj, f, indent=2, allow_nan=False, default=str)\n",
        "\n",
        "\n",
        "def close(a, b, tol=1e-7):\n",
        "    return bool(np.isclose(\n",
        "        float(a), float(b), rtol=tol, atol=tol\n",
        "    ))\n",
        "\n",
        "\n",
        "def normalise_label(value):\n",
        "    return re.sub(\n",
        "        r\"[^a-z0-9]+\", \"_\", str(value).strip().lower()\n",
        "    ).strip(\"_\")\n",
        "\n",
        "\n",
        "def add_check(name, passed, detail):\n",
        "    checks.append({\n",
        "        \"check\": name,\n",
        "        \"status\": \"PASS\" if passed else \"REVIEW_REQUIRED\",\n",
        "        \"detail\": detail\n",
        "    })\n",
        "\n",
        "\n",
        "def add_issue(severity, area, issue, evidence, recommendation):\n",
        "    issues.append({\n",
        "        \"issue_id\": f\"AUTO-{len(issues)+1:03d}\",\n",
        "        \"severity\": severity,\n",
        "        \"area\": area,\n",
        "        \"issue\": issue,\n",
        "        \"evidence\": evidence,\n",
        "        \"recommended_action\": recommendation,\n",
        "        \"status\": \"OPEN\"\n",
        "    })\n",
        "\n",
        "\n",
        "def section(text, start, end=None):\n",
        "    if start not in text:\n",
        "        return \"\"\n",
        "    i = text.index(start)\n",
        "    if end and end in text[i:]:\n",
        "        j = text.index(end, i)\n",
        "        return text[i:j]\n",
        "    return text[i:]\n",
        "\n",
        "\n",
        "def require_columns(df, columns, name):\n",
        "    missing = [c for c in columns if c not in df.columns]\n",
        "    if missing:\n",
        "        raise ValueError(\n",
        "            f\"{name}: required columns missing: {missing}. \"\n",
        "            f\"Available columns: {list(df.columns)}\"\n",
        "        )\n",
        "\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 3. INITIALISE\n",
        "# ------------------------------------------------\n",
        "\n",
        "checks = []\n",
        "issues = []\n",
        "evidence = []\n",
        "\n",
        "if not MANUSCRIPT.is_file():\n",
        "    raise FileNotFoundError(MANUSCRIPT)\n",
        "\n",
        "if not INTEGRATION_RECORD.is_file():\n",
        "    raise FileNotFoundError(INTEGRATION_RECORD)\n",
        "\n",
        "original_bytes = MANUSCRIPT.read_bytes()\n",
        "manuscript = original_bytes.decode(\"utf-8\")\n",
        "manuscript_hash = hashlib.sha256(original_bytes).hexdigest()\n",
        "word_count = len(manuscript.split())\n",
        "\n",
        "integration = load_json(INTEGRATION_RECORD)\n",
        "\n",
        "print(\"=\" * 90)\n",
        "print(\"EXPERIMENT 20 — STEP 3.3.13\")\n",
        "print(\"CORRECTED FULL SCIENTIFIC AND EDITORIAL AUDIT\")\n",
        "print(\"=\" * 90)\n",
        "\n",
        "print(\"Manuscript word count:\", word_count)\n",
        "print(\"Manuscript SHA256:\", manuscript_hash)\n",
        "\n",
        "add_check(\n",
        "    \"Manuscript SHA256\",\n",
        "    manuscript_hash == EXPECTED_SHA256,\n",
        "    manuscript_hash\n",
        ")\n",
        "\n",
        "add_check(\n",
        "    \"Integration record status\",\n",
        "    integration.get(\"status\")\n",
        "    == \"INTEGRATED_MANUSCRIPT_STRUCTURALLY_CORRECTED\",\n",
        "    integration.get(\"status\")\n",
        ")\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 4. STRUCTURE AUDIT\n",
        "# ------------------------------------------------\n",
        "\n",
        "main_headings = [\n",
        "    \"# 1. Introduction\",\n",
        "    \"# 2. Methodology\",\n",
        "    \"# 3. Results\",\n",
        "    \"# 4. Discussion\",\n",
        "    \"# References\"\n",
        "]\n",
        "\n",
        "positions = {}\n",
        "\n",
        "for heading in main_headings:\n",
        "    present = heading in manuscript\n",
        "    add_check(\n",
        "        f\"Main heading: {heading}\",\n",
        "        present,\n",
        "        \"Present\" if present else \"Missing\"\n",
        "    )\n",
        "    if present:\n",
        "        positions[heading] = manuscript.index(heading)\n",
        "\n",
        "ordered = (\n",
        "    len(positions) == 5\n",
        "    and all(\n",
        "        positions[main_headings[i]]\n",
        "        < positions[main_headings[i+1]]\n",
        "        for i in range(4)\n",
        "    )\n",
        ")\n",
        "\n",
        "add_check(\"Main section ordering\", ordered, positions)\n",
        "\n",
        "intro = section(\n",
        "    manuscript, \"# 1. Introduction\", \"# 2. Methodology\"\n",
        ")\n",
        "method = section(\n",
        "    manuscript, \"# 2. Methodology\", \"# 3. Results\"\n",
        ")\n",
        "results = section(\n",
        "    manuscript, \"# 3. Results\", \"# 4. Discussion\"\n",
        ")\n",
        "discussion = section(\n",
        "    manuscript, \"# 4. Discussion\", \"# References\"\n",
        ")\n",
        "references = section(manuscript, \"# References\")\n",
        "\n",
        "abstract = section(\n",
        "    manuscript, \"## Abstract\", \"## Keywords\"\n",
        ")\n",
        "keywords = section(\n",
        "    manuscript, \"## Keywords\", \"# 1. Introduction\"\n",
        ")\n",
        "\n",
        "method_numbers = re.findall(r\"(?m)^## 2\\.(\\d+)\\s+\", method)\n",
        "result_numbers = re.findall(r\"(?m)^## 3\\.(\\d+)\\s+\", results)\n",
        "discussion_numbers = re.findall(r\"(?m)^## 4\\.(\\d+)\\s+\", discussion)\n",
        "\n",
        "add_check(\n",
        "    \"Methodology numbering\",\n",
        "    method_numbers == [str(i) for i in range(1, 11)],\n",
        "    method_numbers\n",
        ")\n",
        "\n",
        "add_check(\n",
        "    \"Results numbering\",\n",
        "    result_numbers == [str(i) for i in range(1, 7)],\n",
        "    result_numbers\n",
        ")\n",
        "\n",
        "add_check(\n",
        "    \"Discussion numbering\",\n",
        "    discussion_numbers == [str(i) for i in range(1, 9)],\n",
        "    discussion_numbers\n",
        ")\n",
        "\n",
        "add_check(\n",
        "    \"Abstract exists\",\n",
        "    len(abstract.split()) >= 100,\n",
        "    f\"{len(abstract.split())} words\"\n",
        ")\n",
        "\n",
        "expected_keywords = [\n",
        "    \"Face recognition\",\n",
        "    \"Face embeddings\",\n",
        "    \"Illumination variation\",\n",
        "    \"Embedding displacement\",\n",
        "    \"Euclidean distance\",\n",
        "    \"Cosine distance\"\n",
        "]\n",
        "\n",
        "for keyword in expected_keywords:\n",
        "    add_check(\n",
        "        f\"Keyword: {keyword}\",\n",
        "        keyword.lower() in keywords.lower(),\n",
        "        keyword\n",
        "    )\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 5. LOAD FROZEN CSV FILES\n",
        "# ------------------------------------------------\n",
        "\n",
        "files = {\n",
        "    \"displacement\":\n",
        "        \"experiment20_reference_evaluation_displacement.csv\",\n",
        "    \"group_statistics\":\n",
        "        \"experiment20_illumination_group_descriptive_statistics.csv\",\n",
        "    \"identity_group_means\":\n",
        "        \"experiment20_identity_level_group_means.csv\",\n",
        "    \"paired_comparisons\":\n",
        "        \"experiment20_paired_comparison_results.csv\",\n",
        "    \"hemisphere_identity\":\n",
        "        \"experiment20_identity_level_hemisphere_means.csv\",\n",
        "    \"hemisphere_comparisons\":\n",
        "        \"experiment20_hemisphere_comparison_results.csv\",\n",
        "    \"repeated_measures\":\n",
        "        \"experiment20_repeated_measures_test_results.csv\"\n",
        "}\n",
        "\n",
        "expected_rows = {\n",
        "    \"displacement\": 2128,\n",
        "    \"group_statistics\": 6,\n",
        "    \"identity_group_means\": 114,\n",
        "    \"paired_comparisons\": 6,\n",
        "    \"hemisphere_identity\": 76,\n",
        "    \"hemisphere_comparisons\": 2,\n",
        "    \"repeated_measures\": 2\n",
        "}\n",
        "\n",
        "data = {}\n",
        "\n",
        "print(\"\\nLOADING FROZEN EXPERIMENTAL DATA\")\n",
        "\n",
        "for key, filename in files.items():\n",
        "    path = FROZEN / filename\n",
        "\n",
        "    if not path.is_file():\n",
        "        raise FileNotFoundError(path)\n",
        "\n",
        "    df = pd.read_csv(path)\n",
        "    data[key] = df\n",
        "\n",
        "    add_check(\n",
        "        f\"Frozen row count: {key}\",\n",
        "        len(df) == expected_rows[key],\n",
        "        f\"Expected {expected_rows[key]}, found {len(df)}\"\n",
