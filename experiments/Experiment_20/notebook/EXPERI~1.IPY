      "cell_type": "code",
      "source": [
        "from pathlib import Path\n",
        "import json\n",
        "import re\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "BASE = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "STEP_DIR = BASE / \"step_3_3\"\n",
        "\n",
        "INTRO_DIR = STEP_DIR / \"step_3382\"\n",
        "REF_DIR = STEP_DIR / \"step_3383\"\n",
        "OUTPUT_DIR = STEP_DIR / \"step_3384\"\n",
        "OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "INTRO_FILE = INTRO_DIR / \"experiment20_consolidated_introduction_v2.md\"\n",
        "REF_FILE = REF_DIR / \"experiment20_reference_list_apa7.json\"\n",
        "\n",
        "for path in [INTRO_FILE, REF_FILE]:\n",
        "    if not path.exists():\n",
        "        raise FileNotFoundError(f\"Missing required file: {path}\")\n",
        "\n",
        "with open(INTRO_FILE, \"r\", encoding=\"utf-8\") as f:\n",
        "    original_intro = f.read()\n",
        "\n",
        "with open(REF_FILE, \"r\", encoding=\"utf-8\") as f:\n",
        "    reference_record = json.load(f)\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 1. Correct APA 7 narrative citation\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "corrected_intro = original_intro.replace(\n",
        "    \"Moses, Adini, and Ullman (1994)\",\n",
        "    \"Moses et al. (1994)\"\n",
        ")\n",
        "\n",
        "corrected_intro = corrected_intro.replace(\n",
        "    \"Moses, Adini & Ullman (1994)\",\n",
        "    \"Moses et al. (1994)\"\n",
        ")\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 2. Define expected author-year references\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "expected_citations = {\n",
        "    \"Moses et al. (1994)\": \"REF01\",\n",
        "    \"Beveridge et al. (2009)\": \"REF02\",\n",
        "    \"Han et al. (2013)\": \"REF03\",\n",
        "    \"Ochoa-Villegas et al. (2015)\": \"REF04\"\n",
        "}\n",
        "\n",
        "references = reference_record[\"references\"]\n",
        "\n",
        "reference_ids = {\n",
        "    ref[\"id\"]: ref for ref in references\n",
        "}\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 3. Detect expected citations and reference coverage\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "citation_presence = {\n",
        "    citation: citation in corrected_intro\n",
        "    for citation in expected_citations\n",
        "}\n",
        "\n",
        "reference_coverage = {\n",
        "    citation: expected_citations[citation] in reference_ids\n",
        "    for citation in expected_citations\n",
        "}\n",
        "\n",
        "# Detect the older Moses form.\n",
        "old_moses_form_present = (\n",
        "    \"Moses, Adini, and Ullman (1994)\" in corrected_intro\n",
        "    or \"Moses, Adini & Ullman (1994)\" in corrected_intro\n",
        ")\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 4. Detect unused references\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "unused_references = []\n",
        "\n",
        "for citation, reference_id in expected_citations.items():\n",
        "    if not citation_presence[citation]:\n",
        "        unused_references.append(reference_id)\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 5. Check the angular grouping citation\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "angular_citation_present = (\n",
        "    \"Ochoa-Villegas et al. (2015)\" in corrected_intro\n",
        ")\n",
        "\n",
        "angular_grouping_description_present = all(\n",
        "    value in corrected_intro\n",
        "    for value in [\n",
        "        \"0°–12°\",\n",
        "        \"13°–25°\",\n",
        "        \"26°–50°\",\n",
        "        \"51°–77°\",\n",
        "        \"above 77°\"\n",
        "    ]\n",
        ")\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# 6. Build audit\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "checks = {\n",
        "    \"moses_apa7_narrative_form\": (\n",
        "        \"Moses et al. (1994)\" in corrected_intro\n",
        "    ),\n",
        "    \"old_moses_form_removed\": not old_moses_form_present,\n",
        "    \"beveridge_citation_present\": citation_presence[\n",
        "        \"Beveridge et al. (2009)\"\n",
        "    ],\n",
        "    \"han_citation_present\": citation_presence[\n",
        "        \"Han et al. (2013)\"\n",
        "    ],\n",
        "    \"ochoa_citation_present\": citation_presence[\n",
        "        \"Ochoa-Villegas et al. (2015)\"\n",
        "    ],\n",
        "    \"all_four_reference_entries_available\": all(\n",
        "        reference_coverage.values()\n",
        "    ),\n",
        "    \"no_unused_reference_entries\": len(unused_references) == 0,\n",
        "    \"angular_grouping_citation_preserved\": angular_citation_present,\n",
        "    \"five_subset_description_preserved\": angular_grouping_description_present\n",
        "}\n",
        "\n",
        "audit = {\n",
        "    \"experiment\": \"Experiment 20\",\n",
        "    \"phase\": \"3.3\",\n",
        "    \"step\": \"3.3.8.4\",\n",
