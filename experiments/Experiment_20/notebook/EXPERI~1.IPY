      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# EXPERIMENT 20 — STEP 3.3.22\n",
        "# HOLM-ADJUSTED P-VALUE REFERENCE AUDIT\n",
        "# READ-ONLY RECURSIVE SEARCH\n",
        "# ============================================================\n",
        "\n",
        "import os\n",
        "import re\n",
        "import json\n",
        "import hashlib\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. PATHS AND SEARCH TERMS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "SEARCH_ROOT = (\n",
        "    \"/content/drive/MyDrive/Experiment_20_Results\"\n",
        ")\n",
        "\n",
        "OUTPUT_DIR = os.path.join(\n",
        "    SEARCH_ROOT,\n",
        "    \"step_3_3\",\n",
        "    \"step_3322\"\n",
        ")\n",
        "\n",
        "os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
        "\n",
        "REPORT_PATH = os.path.join(\n",
        "    OUTPUT_DIR,\n",
        "    \"experiment20_step3322_holm_reference_audit.json\"\n",
        ")\n",
        "\n",
        "EXTENSIONS = {\n",
        "    \".md\", \".csv\", \".json\", \".txt\",\n",
        "    \".py\", \".ipynb\"\n",
        "}\n",
        "\n",
        "SEARCH_TERMS = {\n",
        "    \"frozen_holm_value\": [\n",
        "        \"2.18278728426e-11\",\n",
        "        \"2.182787284254e-11\",\n",
        "        \"2.18278728425e-11\",\n",
        "        \"2.182787e-11\",\n",
        "        \"2.18278728426E-11\",\n",
        "        \"2.182787284254E-11\",\n",
        "        \"2.18278728425E-11\",\n",
        "        \"2.182787E-11\",\n",
        "        \"2.18278728426 × 10^-11\",\n",
        "        \"2.18278728426 × 10⁻¹¹\",\n",
        "        \"2.18278728426\\\\times10^{-11}\",\n",
        "        \"2.18278728426\\\\times 10^{-11}\"\n",
        "    ],\n",
        "    \"combined_six_holm_value\": [\n",
        "        \"4.36557456851e-11\",\n",
        "        \"4.365574568508e-11\",\n",
        "        \"4.36557456850e-11\",\n",
        "        \"4.365575e-11\",\n",
        "        \"4.36557456851E-11\",\n",
        "        \"4.365574568508E-11\",\n",
        "        \"4.36557456850E-11\",\n",
        "        \"4.365575E-11\",\n",
        "        \"4.36557456851 × 10^-11\",\n",
        "        \"4.36557456851 × 10⁻¹¹\",\n",
        "        \"4.36557456851\\\\times10^{-11}\",\n",
        "        \"4.36557456851\\\\times 10^{-11}\"\n",
        "    ]\n",
        "}\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. HASH FUNCTION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def sha256_file(path):\n",
        "    digest = hashlib.sha256()\n",
        "\n",
        "    with open(path, \"rb\") as f:\n",
        "        for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n",
        "            digest.update(chunk)\n",
        "\n",
        "    return digest.hexdigest()\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. RECURSIVE FILE SCAN\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "scanned_files = []\n",
        "matched_files = []\n",
        "unreadable_files = []\n",
        "\n",
        "for current_root, dirs, files in os.walk(SEARCH_ROOT):\n",
        "\n",
        "    # Exclude this step's output directory from its own search.\n",
        "    dirs[:] = [\n",
        "        d for d in dirs\n",
        "        if os.path.join(current_root, d) != OUTPUT_DIR\n",
        "    ]\n",
        "\n",
        "    for filename in files:\n",
        "\n",
        "        extension = os.path.splitext(filename)[1].lower()\n",
        "\n",
        "        if extension not in EXTENSIONS:\n",
        "            continue\n",
        "\n",
        "        path = os.path.join(current_root, filename)\n",
        "\n",
        "        try:\n",
        "            with open(path, \"r\", encoding=\"utf-8\", errors=\"replace\") as f:\n",
        "                content = f.read()\n",
        "\n",
        "            file_hash = sha256_file(path)\n",
        "\n",
        "            scanned_files.append({\n",
        "                \"path\": path,\n",
        "                \"sha256\": file_hash,\n",
        "                \"bytes\": os.path.getsize(path)\n",
        "            })\n",
        "\n",
        "            matches = []\n",
        "\n",
        "            for line_number, line in enumerate(\n",
        "                content.splitlines(),\n",
        "                start=1\n",
        "            ):\n",
        "\n",
        "                for category, terms in SEARCH_TERMS.items():\n",
        "\n",
        "                    for term in terms:\n",
        "\n",
        "                        if term.lower() in line.lower():\n",
        "\n",
        "                            matches.append({\n",
        "                                \"category\": category,\n",
        "                                \"matched_term\": term,\n",
        "                                \"line_number\": line_number,\n",
        "                                \"line_text\": line.strip()[:1000]\n",
        "                            })\n",
        "\n",
        "            if matches:\n",
        "                matched_files.append({\n",
        "                    \"path\": path,\n",
        "                    \"sha256\": file_hash,\n",
        "                    \"matches\": matches\n",
        "                })\n",
        "\n",
        "        except Exception as exc:\n",
        "            unreadable_files.append({\n",
        "                \"path\": path,\n",
        "                \"error\": str(exc)\n",
        "            })\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. DISPLAY RESULTS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"=\" * 100)\n",
        "print(\"EXPERIMENT 20 — STEP 3.3.22 HOLM REFERENCE AUDIT\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "print(\"Search root:\", SEARCH_ROOT)\n",
        "print(\"Files scanned:\", len(scanned_files))\n",
        "print(\"Files with matches:\", len(matched_files))\n",
        "print(\"Unreadable files:\", len(unreadable_files))\n",
        "\n",
        "for item in matched_files:\n",
        "\n",
        "    print(\"\\n\" + \"-\" * 100)\n",
        "    print(\"FILE:\", item[\"path\"])\n",
        "    print(\"SHA256:\", item[\"sha256\"])\n",
        "\n",
        "    for match in item[\"matches\"]:\n",
        "\n",
        "        print(\n",
        "            f\"\\n[{match['category']}] \"\n",
        "            f\"Line {match['line_number']}\"\n",
        "        )\n",
        "\n",
        "        print(\"Matched term:\", match[\"matched_term\"])\n",
        "        print(\"Text:\", match[\"line_text\"])\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. MATCH COUNTS BY CATEGORY\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "category_counts = {\n",
        "    \"frozen_holm_value\": 0,\n",
        "    \"combined_six_holm_value\": 0\n",
        "}\n",
        "\n",
        "for item in matched_files:\n",
        "    for match in item[\"matches\"]:\n",
        "        category_counts[match[\"category\"]] += 1\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"MATCH COUNTS\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "print(json.dumps(category_counts, indent=2))\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. SAVE AUDIT REPORT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "report = {\n",
        "    \"step\": \"3.3.22\",\n",
        "    \"title\": \"Holm-Adjusted P-Value Reference Audit\",\n",
        "    \"timestamp_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "\n",
        "    \"search_root\": SEARCH_ROOT,\n",
        "    \"extensions_scanned\": sorted(EXTENSIONS),\n",
        "\n",
        "    \"search_terms\": SEARCH_TERMS,\n",
        "\n",
        "    \"summary\": {\n",
        "        \"files_scanned\": len(scanned_files),\n",
        "        \"files_with_matches\": len(matched_files),\n",
        "        \"unreadable_files\": len(unreadable_files),\n",
        "        \"match_counts\": category_counts\n",
        "    },\n",
        "\n",
        "    \"matched_files\": matched_files,\n",
        "    \"scanned_files\": scanned_files,\n",
        "    \"unreadable_files\": unreadable_files,\n",
        "\n",
        "    \"integrity\": {\n",
        "        \"source_files_modified\": False,\n",
        "        \"source_files_overwritten\": False,\n",
        "        \"manuscript_modified\": False,\n",
        "        \"automated_corrections_applied\": False\n",
        "    }\n",
        "}\n",
        "\n",
        "with open(REPORT_PATH, \"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(report, f, indent=2)\n",
        "\n",
        "print(\"\\nAudit report saved:\")\n",
        "print(REPORT_PATH)\n",
        "\n",
        "print(\"\\nNo source files were modified.\")\n",
        "print(\"No manuscript or frozen result was overwritten.\")\n",
        "print(\"\\nSTEP 3.3.22 COMPLETED\")"
      ],
