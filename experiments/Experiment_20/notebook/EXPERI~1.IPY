    {
      "cell_type": "markdown",
      "source": [
        "# Experiment 20 — Step 3.2.17\n",
        "## MediaPipe Detection Failure Analysis\n",
        "\n",
        "### Objective\n",
        "Classify the 30-image pilot outcomes and investigate the\n",
        "12 unsuccessful detections.\n",
        "\n",
        "### Analysis\n",
        "- Count zero-face detections.\n",
        "- Count multiple-face detections.\n",
        "- Count incomplete landmark outputs.\n",
        "- Count successful 478-landmark detections.\n",
        "- Summarise failures by illumination group.\n",
        "- Preserve all original pilot records.\n",
        "\n",
        "### Restrictions\n",
        "- No new inference.\n",
        "- No image alignment.\n",
        "- No embedding generation.\n",
        "- No modification of frozen source data.\n",
        "\n",
        "### Decision requirement\n",
        "Determine whether failures are predominantly caused by\n",
        "large-angular illumination or are distributed across groups."
      ],
      "metadata": {
        "id": "EmL1YL4m7OTo"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from pathlib import Path\n",
        "import json\n",
        "from collections import Counter, defaultdict\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "BASE = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "STEP_DIR = BASE / \"step_3_2\"\n",
        "\n",
        "INPUT_FILE = STEP_DIR / (\n",
        "    \"experiment20_step3216_mediapipe_detection_pilot.json\"\n",
        ")\n",
        "\n",
        "OUTPUT_FILE = STEP_DIR / (\n",
        "    \"experiment20_step3217_detection_failure_analysis.json\"\n",
        ")\n",
        "\n",
        "assert INPUT_FILE.exists(), \"Step 3.2.16 result missing.\"\n",
        "\n",
        "with open(INPUT_FILE) as f:\n",
        "    pilot = json.load(f)\n",
        "\n",
        "results = pilot[\"results\"]\n",
        "\n",
        "assert len(results) == 30, \"Expected exactly 30 pilot records.\"\n",
        "\n",
        "failure_types = Counter()\n",
        "group_analysis = defaultdict(Counter)\n",
        "classified_records = []\n",
        "\n",
        "for record in results:\n",
        "\n",
        "    face_count = record.get(\"face_count\")\n",
        "    landmark_counts = record.get(\"landmark_counts\", [])\n",
        "\n",
        "    if record[\"processing_status\"] == \"EXCEPTION\":\n",
        "        failure_type = \"processing_exception\"\n",
        "\n",
        "    elif record[\"processing_status\"] == \"SOURCE_IMAGE_NOT_FOUND\":\n",
        "        failure_type = \"source_image_missing\"\n",
        "\n",
        "    elif face_count == 0:\n",
        "        failure_type = \"no_face_detected\"\n",
        "\n",
        "    elif face_count is not None and face_count > 1:\n",
        "        failure_type = \"multiple_faces_detected\"\n",
        "\n",
        "    elif face_count == 1 and (\n",
        "        not landmark_counts or landmark_counts[0] != 478\n",
        "    ):\n",
        "        failure_type = \"incomplete_landmark_output\"\n",
        "\n",
        "    elif record[\"detection_success\"]:\n",
        "        failure_type = \"successful_478_landmark_detection\"\n",
        "\n",
        "    else:\n",
        "        failure_type = \"unclassified_failure\"\n",
        "\n",
        "    failure_types[failure_type] += 1\n",
        "    group_analysis[record[\"illumination_group\"]][failure_type] += 1\n",
        "\n",
        "    classified_records.append({\n",
        "        \"filename\": record[\"filename\"],\n",
        "        \"subject\": record[\"subject\"],\n",
        "        \"condition\": record[\"condition\"],\n",
        "        \"illumination_group\": record[\"illumination_group\"],\n",
        "        \"face_count\": face_count,\n",
        "        \"landmark_counts\": landmark_counts,\n",
        "        \"detection_success\": record[\"detection_success\"],\n",
        "        \"failure_type\": failure_type\n",
        "    })\n",
        "\n",
        "failed_records = [\n",
        "    r for r in classified_records\n",
        "    if not r[\"detection_success\"]\n",
        "]\n",
        "\n",
        "group_summary = {\n",
        "    group: dict(counts)\n",
        "    for group, counts in group_analysis.items()\n",
        "}\n",
        "\n",
        "checks = {\n",
        "    \"30_records_classified\": len(classified_records) == 30,\n",
        "    \"all_12_unsuccessful_records_retained\": len(failed_records) == 12,\n",
        "    \"all_three_groups_present\": len(group_summary) == 3,\n",
        "    \"classification_counts_sum_to_30\": sum(failure_types.values()) == 30,\n",
        "    \"original_input_records_preserved\": len(results) == 30\n",
        "}\n",
        "\n",
        "output = {\n",
        "    \"experiment\": \"Experiment 20\",\n",
        "    \"step\": \"3.2.17\",\n",
        "    \"timestamp_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "    \"input_file\": str(INPUT_FILE),\n",
        "    \"total_images\": len(results),\n",
        "    \"failure_type_counts\": dict(failure_types),\n",
        "    \"group_failure_analysis\": group_summary,\n",
        "    \"failed_image_records\": failed_records,\n",
        "    \"classified_records\": classified_records,\n",
        "    \"checks\": checks,\n",
        "    \"passed_checks\": sum(checks.values()),\n",
        "    \"total_checks\": len(checks),\n",
        "    \"interpretation\": (\n",
        "        \"Descriptive pilot failure analysis only. \"\n",
        "        \"Do not infer causal effects from the 30-image sample.\"\n",
        "    ),\n",
        "    \"status\": (\n",
        "        \"FAILURE_ANALYSIS_COMPLETE\"\n",
        "        if all(checks.values())\n",
        "        else \"FAILURE_ANALYSIS_REQUIRES_REVIEW\"\n",
        "    )\n",
        "}\n",
        "\n",
        "with open(OUTPUT_FILE, \"w\") as f:\n",
        "    json.dump(output, f, indent=2)\n",
        "\n",
        "with open(OUTPUT_FILE) as f:\n",
        "    reloaded = json.load(f)\n",
        "\n",
        "print(\"=\" * 88)\n",
        "print(\"EXPERIMENT 20 — STEP 3.2.17\")\n",
        "print(\"MEDIAPIPE DETECTION FAILURE ANALYSIS\")\n",
        "print(\"=\" * 88)\n",
        "\n",
        "print(\"\\nFailure classification:\")\n",
        "for name, count in failure_types.items():\n",
        "    print(f\"{name}: {count}\")\n",
        "\n",
        "print(\"\\nGroup analysis:\")\n",
        "for group, counts in group_summary.items():\n",
        "    print(group, counts)\n",
        "\n",
        "print(\"\\nFailed image filenames:\")\n",
        "for record in failed_records:\n",
        "    print(\n",
        "        record[\"filename\"],\n",
        "        \"|\",\n",
        "        record[\"illumination_group\"],\n",
        "        \"|\",\n",
        "        record[\"failure_type\"]\n",
        "    )\n",
        "\n",
        "print(\"\\nAudit:\")\n",
        "for name, passed in checks.items():\n",
        "    print(name, \"PASS\" if passed else \"FAIL\")\n",
        "\n",
        "print(\"\\nPassed:\", sum(checks.values()), \"/\", len(checks))\n",
        "print(\"JSON reload:\", \"PASS\" if reloaded == output else \"FAIL\")\n",
        "print(\"Saved:\", OUTPUT_FILE)\n",
        "print(\"=\" * 88)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
