            ")\n",
            "\n",
            "print(\n",
            "    \"Mahalanobis result:\",\n",
            "    \"Statistically significant at 5%.\"\n",
            "    if mahalanobis_p < alpha\n",
            "    else \"Not statistically significant at 5%.\"\n",
            ")\n",
            "\n",
            "print(\n",
            "    \"\\nBoth tests are exploratory and based on only \"\n",
            "    \"13 paired identity-level observations.\"\n",
            ")\n",
            "\n",
            "print(\n",
            "    \"No multiple-comparison correction has been applied.\"\n",
            ")\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 8. Comparative research findings\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n7. COMPARATIVE RESEARCH FINDINGS\")\n",
            "\n",
            "print(\n",
            "    \"The Euclidean detector recorded its largest aggregate \"\n",
            "    \"response under low illumination.\"\n",
            ")\n",
            "\n",
            "print(\n",
            "    \"The Mahalanobis detector recorded its largest aggregate \"\n",
            "    \"response under high illumination.\"\n",
            ")\n",
            "\n",
            "print(\n",
            "    \"The identity-level results demonstrate that detector \"\n",
            "    \"responses vary across identities.\"\n",
            ")\n",
            "\n",
            "print(\n",
            "    \"The larger estimated Mahalanobis effect size does not \"\n",
            "    \"establish general detector superiority.\"\n",
            ")\n",
            "\n",
            "\n",
            "# ------------------------------------------------------------\n",
            "# 9. Scientific limitations\n",
            "# ------------------------------------------------------------\n",
            "\n",
            "print(\"\\n8. SCIENTIFIC LIMITATIONS\")\n",
            "\n",
            "limitations = [\n",
            "    \"The evaluation includes only 13 identities.\",\n",
            "    \"Identity-level sample counts are unequal.\",\n",
            "    \"The aggregate comparison covers three illumination conditions.\",\n",
            "    \"Both Wilcoxon tests are exploratory and based on 13 paired identities.\",\n",
            "    \"No multiple-comparison correction has been applied.\",\n",
            "    \"Bootstrap estimates are exploratory.\",\n",
            "    \"Controlled brightness transformations do not represent all natural lighting conditions.\",\n",
            "    \"Embedding displacement does not directly measure recognition accuracy.\",\n",
            "    \"The experiment does not establish demographic fairness.\",\n",
            "    \"The experiment does not establish operational drift-detection accuracy or false-alarm control.\"\n",
