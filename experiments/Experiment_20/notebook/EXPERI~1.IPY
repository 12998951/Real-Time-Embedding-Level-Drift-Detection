    {
      "cell_type": "markdown",
      "source": [
        "## Experiment 20 — Step 3.3.9.13.2: Angular Calculation and Group Reconstruction Audit\n",
        "\n",
        "### Objective\n",
        "Verify that the original notebook's angular calculation agrees with the frozen illumination-condition manifest.\n",
        "\n",
        "### Verification procedure\n",
        "1. Read the original Experiment 20 notebook.\n",
        "2. Confirm that its source code explicitly converts degree inputs to radians and converts the inverse-cosine result back to degrees.\n",
        "3. Load the frozen grouped illumination-condition manifest.\n",
        "4. Independently reconstruct angular deviations from the recorded azimuth and elevation values.\n",
        "5. Compare reconstructed angles and group assignments with the frozen manifest.\n",
        "6. Verify the 30-degree and 60-degree group boundaries.\n",
        "7. Save a machine-readable audit.\n",
        "\n",
        "This is a verification step only. It must not modify embeddings, condition assignments, statistical results, or existing frozen artifacts."
      ],
      "metadata": {
        "id": "1_uhqKK-OB53"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# EXPERIMENT 20\n",
        "# STEP 3.3.9.13.2\n",
        "# ANGULAR CALCULATION AND GROUP RECONSTRUCTION AUDIT\n",
        "# ============================================================\n",
        "\n",
        "import json\n",
        "import math\n",
        "import hashlib\n",
        "from pathlib import Path\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. DEFINE SOURCE AND OUTPUT PATHS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "ROOT = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "\n",
        "NOTEBOOK_PATH = Path(\n",
        "    \"/content/drive/MyDrive/Colab Notebooks/\"\n",
        "    \"Experiment 20: Paired Identity-Level Evaluation of \"\n",
        "    \"Within-Identity Embedding Drift Detection Under Multiple \"\n",
        "    \"Controlled Biometric Acquisition Changes.ipynb\"\n",
        ")\n",
        "\n",
        "MANIFEST_PATH = (\n",
        "    ROOT / \"dataset_audit\" /\n",
        "    \"experiment20_grouped_illumination_condition_manifest.json\"\n",
        ")\n",
        "\n",
        "OUTPUT_DIR = ROOT / \"step_3_3\" / \"step_33913\"\n",
        "OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "AUDIT_PATH = (\n",
        "    OUTPUT_DIR /\n",
        "    \"experiment20_step33913_angular_reconstruction_audit.json\"\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. VERIFY ORIGINAL NOTEBOOK SOURCE\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "if not NOTEBOOK_PATH.is_file():\n",
        "    raise FileNotFoundError(\n",
        "        f\"Original notebook not found: {NOTEBOOK_PATH}\"\n",
        "    )\n",
        "\n",
        "with open(NOTEBOOK_PATH, \"r\", encoding=\"utf-8\") as f:\n",
        "    notebook = json.load(f)\n",
        "\n",
        "code_cells = []\n",
        "\n",
        "for cell in notebook.get(\"cells\", []):\n",
        "    if cell.get(\"cell_type\") == \"code\":\n",
        "        source = cell.get(\"source\", [])\n",
        "        if isinstance(source, list):\n",
        "            source = \"\".join(source)\n",
        "        code_cells.append(source)\n",
        "\n",
        "matching_cells = [\n",
        "    source for source in code_cells\n",
        "    if (\n",
        "        \"math.radians(azimuth_deg)\" in source\n",
        "        and \"math.radians(elevation_deg)\" in source\n",
        "        and \"math.degrees(\" in source\n",
        "        and \"math.acos(cosine_value)\" in source\n",
        "    )\n",
        "]\n",
        "\n",
        "source_verified = len(matching_cells) >= 1\n",
        "\n",
        "if not source_verified:\n",
        "    raise RuntimeError(\n",
        "        \"The expected original angular calculation \"\n",
        "        \"was not found in the notebook.\"\n",
        "    )\n",
        "\n",
        "source_code = matching_cells[0]\n",
        "\n",
        "source_checks = {\n",
        "    \"azimuth_converted_to_radians\":\n",
        "        \"math.radians(azimuth_deg)\" in source_code,\n",
        "\n",
        "    \"elevation_converted_to_radians\":\n",
        "        \"math.radians(elevation_deg)\" in source_code,\n",
        "\n",
        "    \"cosine_product_calculated\":\n",
        "        \"math.cos(elevation_rad)\" in source_code\n",
        "        and \"math.cos(azimuth_rad)\" in source_code,\n",
        "\n",
        "    \"cosine_value_clipped\":\n",
        "        \"max(-1.0, min(1.0, cosine_value))\" in source_code,\n",
        "\n",
        "    \"arccos_result_converted_to_degrees\":\n",
        "        \"math.degrees(\" in source_code\n",
        "        and \"math.acos(cosine_value)\" in source_code,\n",
        "\n",
        "    \"near_frontal_boundary_30\":\n",
        "        \"angle <= 30.0\" in source_code,\n",
        "\n",
        "    \"oblique_boundary_60\":\n",
        "        \"angle <= 60.0\" in source_code\n",
        "}\n",
        "\n",
        "source_sha256 = hashlib.sha256(\n",
        "    source_code.encode(\"utf-8\")\n",
        ").hexdigest()\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. LOAD FROZEN GROUPED MANIFEST\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "if not MANIFEST_PATH.is_file():\n",
        "    raise FileNotFoundError(\n",
        "        f\"Grouped manifest not found: {MANIFEST_PATH}\"\n",
        "    )\n",
        "\n",
        "with open(MANIFEST_PATH, \"r\", encoding=\"utf-8\") as f:\n",
        "    manifest = json.load(f)\n",
        "\n",
        "condition_details = manifest.get(\"condition_details\", {})\n",
        "\n",
        "if len(condition_details) != 57:\n",
        "    raise RuntimeError(\n",
        "        f\"Expected 57 condition records, \"\n",
        "        f\"found {len(condition_details)}.\"\n",
        "    )\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. RECONSTRUCT ANGLES AND GROUPS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "reconstructed = {}\n",
        "\n",
        "for condition, record in condition_details.items():\n",
        "\n",
        "    azimuth_deg = float(\n",
        "        record[\"azimuth_degrees\"]\n",
        "    )\n",
        "\n",
        "    elevation_deg = float(\n",
        "        record[\"elevation_degrees\"]\n",
        "    )\n",
        "\n",
        "    azimuth_rad = math.radians(azimuth_deg)\n",
        "    elevation_rad = math.radians(elevation_deg)\n",
        "\n",
        "    cosine_value = (\n",
        "        math.cos(elevation_rad)\n",
        "        * math.cos(azimuth_rad)\n",
        "    )\n",
        "\n",
        "    cosine_value = max(\n",
        "        -1.0,\n",
        "        min(1.0, cosine_value)\n",
        "    )\n",
        "\n",
        "    angle_deg = math.degrees(\n",
        "        math.acos(cosine_value)\n",
        "    )\n",
        "\n",
        "    if angle_deg <= 30.0:\n",
        "        group = \"near_frontal\"\n",
        "\n",
        "    elif angle_deg <= 60.0:\n",
        "        group = \"oblique\"\n",
        "\n",
        "    else:\n",
        "        group = \"high_angle\"\n",
        "\n",
        "    reconstructed[condition] = {\n",
        "        \"angle_degrees\": angle_deg,\n",
        "        \"group\": group,\n",
        "        \"stored_angle_degrees\": float(\n",
        "            record[\"angular_deviation_degrees\"]\n",
        "        ),\n",
        "        \"stored_group\": record[\"group\"]\n",
        "    }\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. COMPARE RECONSTRUCTED VALUES WITH MANIFEST\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "angle_tolerance = 0.000001\n",
        "\n",
        "angle_mismatches = []\n",
        "group_mismatches = []\n",
        "\n",
        "for condition, values in reconstructed.items():\n",
        "\n",
        "    angle_difference = abs(\n",
        "        values[\"angle_degrees\"]\n",
        "        - values[\"stored_angle_degrees\"]\n",
        "    )\n",
        "\n",
        "    if angle_difference > angle_tolerance:\n",
        "        angle_mismatches.append({\n",
        "            \"condition\": condition,\n",
        "            \"reconstructed\": values[\"angle_degrees\"],\n",
        "            \"stored\": values[\"stored_angle_degrees\"],\n",
        "            \"absolute_difference\": angle_difference\n",
        "        })\n",
        "\n",
        "    if values[\"group\"] != values[\"stored_group\"]:\n",
        "        group_mismatches.append({\n",
        "            \"condition\": condition,\n",
        "            \"reconstructed_group\": values[\"group\"],\n",
        "            \"stored_group\": values[\"stored_group\"]\n",
        "        })\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. VERIFY GROUP COUNTS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "group_counts = {\n",
        "    \"near_frontal\": 0,\n",
        "    \"oblique\": 0,\n",
        "    \"high_angle\": 0\n",
        "}\n",
        "\n",
        "for values in reconstructed.values():\n",
        "    group_counts[values[\"group\"]] += 1\n",
        "\n",
        "expected_group_counts = {\n",
        "    \"near_frontal\": 18,\n",
        "    \"oblique\": 11,\n",
        "    \"high_angle\": 28\n",
        "}\n",
        "\n",
        "group_counts_match = (\n",
        "    group_counts == expected_group_counts\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. BUILD AUDIT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "checks = {\n",
        "    \"original_notebook_source_found\": source_verified,\n",
        "    **source_checks,\n",
        "    \"57_conditions_reconstructed\":\n",
        "        len(reconstructed) == 57,\n",
        "    \"no_angle_mismatches\":\n",
        "        len(angle_mismatches) == 0,\n",
        "    \"no_group_mismatches\":\n",
        "        len(group_mismatches) == 0,\n",
        "    \"group_counts_match_expected\":\n",
        "        group_counts_match\n",
        "}\n",
        "\n",
        "passed = sum(bool(value) for value in checks.values())\n",
        "failed = len(checks) - passed\n",
        "\n",
        "audit = {\n",
        "    \"experiment\": 20,\n",
        "    \"step\": \"3.3.9.13.2\",\n",
        "    \"timestamp_utc\": datetime.now(\n",
        "        timezone.utc\n",
        "    ).isoformat(),\n",
        "\n",
        "    \"source_notebook\": str(NOTEBOOK_PATH),\n",
        "    \"source_code_sha256\": source_sha256,\n",
        "    \"manifest_path\": str(MANIFEST_PATH),\n",
        "\n",
        "    \"formula\": (\n",
        "        \"degrees(acos(cos(radians(elevation)) \"\n",
        "        \"* cos(radians(azimuth))))\"\n",
        "    ),\n",
        "\n",
        "    \"group_boundaries\": {\n",
        "        \"near_frontal\": \"<= 30 degrees\",\n",
        "        \"oblique\": \"> 30 and <= 60 degrees\",\n",
        "        \"high_angle\": \"> 60 degrees\"\n",
        "    },\n",
        "\n",
        "    \"angle_tolerance_degrees\": angle_tolerance,\n",
        "    \"reconstructed_condition_count\": len(reconstructed),\n",
        "    \"reconstructed_group_counts\": group_counts,\n",
        "\n",
        "    \"angle_mismatches\": angle_mismatches,\n",
        "    \"group_mismatches\": group_mismatches,\n",
        "\n",
        "    \"checks\": checks,\n",
        "    \"passed_checks\": passed,\n",
        "    \"failed_checks\": failed,\n",
        "\n",
        "    \"status\": (\n",
        "        \"ANGULAR_RECONSTRUCTION_VERIFIED\"\n",
        "        if failed == 0\n",
        "        else \"ANGULAR_RECONSTRUCTION_REQUIRES_REVIEW\"\n",
        "    )\n",
        "}\n",
        "\n",
        "with open(AUDIT_PATH, \"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(audit, f, indent=4)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 8. DISPLAY RESULTS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"=\" * 75)\n",
        "print(\"EXPERIMENT 20 — STEP 3.3.9.13.2\")\n",
        "print(\"ANGULAR CALCULATION AND GROUP RECONSTRUCTION AUDIT\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "print(\"\\n[1] ORIGINAL SOURCE\")\n",
        "print(\"Notebook:\", NOTEBOOK_PATH.name)\n",
        "print(\"Matching source cells:\", len(matching_cells))\n",
        "print(\"Source SHA256:\", source_sha256)\n",
        "\n",
        "print(\"\\n[2] SOURCE IMPLEMENTATION CHECKS\")\n",
        "\n",
        "for name, result in source_checks.items():\n",
        "    print(f\"{name}: {'PASS' if result else 'FAIL'}\")\n",
        "\n",
        "print(\"\\n[3] RECONSTRUCTION\")\n",
        "print(\"Conditions reconstructed:\", len(reconstructed))\n",
        "print(\"Angle mismatches:\", len(angle_mismatches))\n",
        "print(\"Group mismatches:\", len(group_mismatches))\n",
        "\n",
        "print(\"\\n[4] RECONSTRUCTED GROUP COUNTS\")\n",
        "\n",
        "for group, count in group_counts.items():\n",
        "    print(f\"{group}: {count}\")\n",
        "\n",
        "print(\"\\n[5] GROUP COUNT VALIDATION\")\n",
        "print(\"Expected counts:\", expected_group_counts)\n",
        "print(\"Counts match:\", group_counts_match)\n",
        "\n",
        "print(\"\\n[6] FINAL AUDIT\")\n",
        "print(\"Passed:\", passed)\n",
        "print(\"Failed:\", failed)\n",
        "print(\"Status:\", audit[\"status\"])\n",
        "\n",
        "print(\"\\nAudit saved:\", AUDIT_PATH)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 75)\n",
        "print(\"STEP 3.3.9.13.2 COMPLETED\")\n",
        "print(\"=\" * 75)"
      ],
      "metadata": {
