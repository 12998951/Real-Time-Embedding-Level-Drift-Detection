        "\n",
        "from pathlib import Path\n",
        "import hashlib\n",
        "import json\n",
        "import re\n",
        "import math\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "# ============================================================\n",
        "# EXPERIMENT 20 — PHASE 4.6\n",
        "# MANUSCRIPT INTEGRITY AND REPORTING AUDIT\n",
        "# READ-ONLY: NO SOURCE OR EVIDENCE FILES ARE MODIFIED\n",
        "# ============================================================\n",
        "\n",
        "ROOT = Path(\"/content/drive/MyDrive/Experiment_20_Results\")\n",
        "\n",
        "FINAL_MANUSCRIPT = (\n",
        "    ROOT / \"step_4_5_statistical_methodology_audit\"\n",
        "    / \"experiment20_integrated_manuscript_v2_phase45_final.md\"\n",
        ")\n",
        "\n",
        "FROZEN_MANUSCRIPT = (\n",
        "    ROOT / \"step_3_3\" / \"step_3330\"\n",
        "    / \"experiment20_integrated_manuscript_v2.md\"\n",
        ")\n",
        "\n",
        "CSV_PATH = (\n",
        "    ROOT / \"step_2_7\" / \"final_freeze\"\n",
        "    / \"experiment20_reference_evaluation_displacement.csv\"\n",
        ")\n",
        "\n",
        "PHASE44_REPORT = (\n",
        "    ROOT / \"step_4_4_statistical_reproducibility\"\n",
        "    / \"experiment20_phase44_statistical_reproducibility_audit_corrected.json\"\n",
        ")\n",
        "\n",
        "PHASE45_REPORT = (\n",
        "    ROOT / \"step_4_5_statistical_methodology_audit\"\n",
        "    / \"experiment20_phase45_statistical_methodology_audit.json\"\n",
        ")\n",
        "\n",
        "SIGN_TEST_REPORT = (\n",
        "    ROOT / \"step_4_5_statistical_methodology_audit\"\n",
        "    / \"experiment20_phase45_sign_test_sensitivity_audit.json\"\n",
        ")\n",
        "\n",
        "PHASE45_CLOSURE = (\n",
        "    ROOT / \"step_4_5_statistical_methodology_audit\"\n",
        "    / \"experiment20_phase45_final_closure_record.json\"\n",
        ")\n",
        "\n",
        "OUTPUT_DIR = ROOT / \"step_4_6_manuscript_reporting_audit\"\n",
        "OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "OUTPUT_REPORT = (\n",
        "    OUTPUT_DIR / \"experiment20_phase46_manuscript_reporting_audit.json\"\n",
        ")\n",
        "\n",
        "EXPECTED_HASHES = {\n",
        "    \"final_manuscript\":\n",
        "        \"eb175d98a9018797a712e90614ace8972d2589bc1ecfd54fb59b76bdebf203e3\",\n",
        "    \"frozen_manuscript\":\n",
        "        \"2cc4156af63987fae717c37e997e6478e4253d81f584854fb5fab9f18da5e752\",\n",
        "    \"evaluation_csv\":\n",
        "        \"d24a2a6d628eca608b8ab8e6c056fb50bc7b0e1c6c34e253dfae7c9354c9892f\",\n",
        "    \"phase44_report\":\n",
        "        \"9d7f9d825805ccc03d973d462c7427b2c8d11199cb7440e155af65d02718a214\",\n",
        "    \"phase45_report\":\n",
        "        \"bf08cfbc118a7173962e3eb29e5b8987e049274645e0304ac0c570f569228237\",\n",
        "    \"sign_test_report\":\n",
        "        \"e7951e7b891d6e3c3399aa82c299229ef14f3cc54067ede09d7d5598461d0d25\",\n",
        "    \"phase45_closure\":\n",
        "        \"e22bcc2dbb84eb7ac892dc07d8f2c80fc258a749156903ea847600985e13f4ec\"\n",
        "}\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# HELPERS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def sha256(path):\n",
        "    h = hashlib.sha256()\n",
        "    with path.open(\"rb\") as f:\n",
        "        for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n",
        "            h.update(chunk)\n",
        "    return h.hexdigest()\n",
        "\n",
        "def json_load(path):\n",
        "    with path.open(\"r\", encoding=\"utf-8\") as f:\n",
        "        return json.load(f)\n",
        "\n",
        "def record_check(name, passed, detail=None):\n",
        "    checks[name] = bool(passed)\n",
        "    print(\n",
        "        (\"PASS\" if passed else \"REVIEW\"),\n",
        "        name,\n",
        "        (\"|\" + str(detail) if detail is not None else \"\")\n",
        "    )\n",
        "\n",
        "def rounded(value, digits=6):\n",
        "    return round(float(value), digits)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. INPUT FILE AND HASH VERIFICATION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"=\" * 82)\n",
        "print(\"EXPERIMENT 20 — PHASE 4.6 MANUSCRIPT REPORTING AUDIT\")\n",
        "print(\"=\" * 82)\n",
        "\n",
        "checks = {}\n",
        "file_hashes = {}\n",
        "file_status = {}\n",
        "\n",
        "FILES = {\n",
        "    \"final_manuscript\": FINAL_MANUSCRIPT,\n",
        "    \"frozen_manuscript\": FROZEN_MANUSCRIPT,\n",
        "    \"evaluation_csv\": CSV_PATH,\n",
        "    \"phase44_report\": PHASE44_REPORT,\n",
        "    \"phase45_report\": PHASE45_REPORT,\n",
        "    \"sign_test_report\": SIGN_TEST_REPORT,\n",
        "    \"phase45_closure\": PHASE45_CLOSURE\n",
        "}\n",
        "\n",
        "print(\"\\n1. INPUT INTEGRITY\")\n",
        "\n",
        "for name, path in FILES.items():\n",
        "    if not path.exists():\n",
        "        file_status[name] = \"MISSING\"\n",
        "        record_check(f\"{name}_exists\", False, str(path))\n",
        "        continue\n",
        "\n",
        "    actual = sha256(path)\n",
        "    file_hashes[name] = actual\n",
        "    expected = EXPECTED_HASHES[name]\n",
        "    passed = actual == expected\n",
        "    file_status[name] = \"VERIFIED\" if passed else \"HASH_MISMATCH\"\n",
        "\n",
        "    record_check(\n",
        "        f\"{name}_hash\",\n",
        "        passed,\n",
        "        f\"actual={actual}\"\n",
        "    )\n",
        "\n",
        "missing = [name for name, status in file_status.items()\n",
        "           if status == \"MISSING\"]\n",
        "\n",
        "if missing:\n",
        "    raise FileNotFoundError(\n",
        "        \"Required audit inputs are missing: \" + \", \".join(missing)\n",
        "    )\n",
        "\n",
        "# Read source documents only after checking their integrity.\n",
        "manuscript = FINAL_MANUSCRIPT.read_text(encoding=\"utf-8\")\n",
        "frozen_manuscript = FROZEN_MANUSCRIPT.read_text(encoding=\"utf-8\")\n",
        "df = pd.read_csv(CSV_PATH)\n",
        "\n",
        "phase44 = json_load(PHASE44_REPORT)\n",
        "phase45 = json_load(PHASE45_REPORT)\n",
        "sign_report = json_load(SIGN_TEST_REPORT)\n",
        "phase45_closure = json_load(PHASE45_CLOSURE)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. DATASET AND COHORT RECONCILIATION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 82)\n",
        "print(\"2. DATASET AND COHORT RECONCILIATION\")\n",
        "print(\"=\" * 82)\n",
        "\n",
        "required_columns = [\n",
        "    \"subject\",\n",
        "    \"reference_condition\",\n",
        "    \"evaluation_condition\",\n",
        "    \"reference_filename\",\n",
        "    \"evaluation_filename\",\n",
        "    \"azimuth_degrees\",\n",
        "    \"elevation_degrees\",\n",
        "    \"angular_deviation_degrees\",\n",
        "    \"illumination_group\",\n",
        "    \"hemisphere\",\n",
        "    \"euclidean_displacement\",\n",
        "    \"cosine_similarity\",\n",
        "    \"cosine_distance\"\n",
        "]\n",
        "\n",
        "missing_columns = [\n",
        "    col for col in required_columns if col not in df.columns\n",
        "]\n",
        "\n",
        "record_check(\n",
        "    \"required_csv_columns_present\",\n",
        "    len(missing_columns) == 0,\n",
        "    missing_columns\n",
        ")\n",
        "\n",
        "if missing_columns:\n",
        "    raise RuntimeError(\"CSV schema is incomplete; stopping calculations.\")\n",
        "\n",
        "row_count = len(df)\n",
        "identity_count = int(df[\"subject\"].nunique())\n",
        "condition_count = int(df[\"evaluation_condition\"].nunique())\n",
        "reference_count = int(df[\"reference_filename\"].nunique())\n",
        "\n",
        "group_counts = (\n",
        "    df.groupby(\"illumination_group\")\n",
        "      .agg(\n",
        "          observations=(\"subject\", \"size\"),\n",
        "          identities=(\"subject\", \"nunique\"),\n",
        "          conditions=(\"evaluation_condition\", \"nunique\")\n",
        "      )\n",
        "      .to_dict(orient=\"index\")\n",
        ")\n",
        "\n",
        "hemisphere_counts = (\n",
        "    df.groupby(\"hemisphere\")\n",
        "      .agg(\n",
        "          observations=(\"subject\", \"size\"),\n",
        "          identities=(\"subject\", \"nunique\"),\n",
        "          conditions=(\"evaluation_condition\", \"nunique\")\n",
        "      )\n",
        "      .to_dict(orient=\"index\")\n",
        ")\n",
        "\n",
        "print(\"Rows:\", row_count)\n",
        "print(\"Identities:\", identity_count)\n",
        "print(\"Evaluation conditions:\", condition_count)\n",
        "print(\"Unique reference filenames:\", reference_count)\n",
        "print(\"\\nIllumination groups:\")\n",
        "print(pd.DataFrame(group_counts).T.to_string())\n",
        "\n",
        "print(\"\\nHemisphere groups:\")\n",
        "print(pd.DataFrame(hemisphere_counts).T.to_string())\n",
        "\n",
        "record_check(\"evaluation_rows_2128\", row_count == 2128, row_count)\n",
        "record_check(\"identity_count_38\", identity_count == 38, identity_count)\n",
        "record_check(\n",
        "    \"evaluation_conditions_56\",\n",
        "    condition_count == 56,\n",
        "    condition_count\n",
        ")\n",
        "record_check(\n",
        "    \"one_reference_filename_per_identity\",\n",
        "    reference_count == 38,\n",
        "    reference_count\n",
        ")\n",
        "\n",
        "expected_groups = {\n",
        "    \"near_frontal\": (646, 38, 17),\n",
        "    \"oblique\": (418, 38, 11),\n",
        "    \"large_angular_deviation\": (1064, 38, 28)\n",
        "}\n",
        "\n",
        "observed_groups = {}\n",
        "for group, values in group_counts.items():\n",
        "    observed_groups[group] = (\n",
        "        int(values[\"observations\"]),\n",
        "        int(values[\"identities\"]),\n",
        "        int(values[\"conditions\"])\n",
        "    )\n",
        "\n",
        "record_check(\n",
        "    \"illumination_group_counts\",\n",
        "    observed_groups == expected_groups,\n",
        "    observed_groups\n",
        ")\n",
        "\n",
        "expected_hemispheres = {\n",
        "    \"frontal_hemisphere\": (1710, 38, 45),\n",
        "    \"beyond_frontal_hemisphere\": (418, 38, 11)\n",
        "}\n",
        "\n",
        "observed_hemispheres = {}\n",
        "for group, values in hemisphere_counts.items():\n",
        "    observed_hemispheres[group] = (\n",
        "        int(values[\"observations\"]),\n",
        "        int(values[\"identities\"]),\n",
        "        int(values[\"conditions\"])\n",
        "    )\n",
        "\n",
        "record_check(\n",
        "    \"hemisphere_counts\",\n",
        "    observed_hemispheres == expected_hemispheres,\n",
        "    observed_hemispheres\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. DESCRIPTIVE STATISTICS RECONSTRUCTION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 82)\n",
        "print(\"3. DESCRIPTIVE STATISTICS RECONSTRUCTION\")\n",
        "print(\"=\" * 82)\n",
        "\n",
        "metrics = [\"euclidean_displacement\", \"cosine_distance\"]\n",
        "\n",
        "group_summary = (\n",
        "    df.groupby(\"illumination_group\")[metrics]\n",
        "      .agg([\"mean\", \"median\", \"std\"])\n",
        ")\n",
        "\n",
        "hemisphere_summary = (\n",
        "    df.groupby(\"hemisphere\")[metrics]\n",
        "      .agg([\"mean\", \"median\", \"std\"])\n",
        ")\n",
        "\n",
        "print(\"\\nIllumination-group descriptive statistics:\")\n",
        "print(group_summary.to_string(float_format=lambda x: f\"{x:.6f}\"))\n",
        "\n",
        "print(\"\\nHemisphere descriptive statistics:\")\n",
        "print(hemisphere_summary.to_string(float_format=lambda x: f\"{x:.6f}\"))\n",
        "\n",
        "# Known previously verified manuscript values.\n",
        "# These are checks of the reported hemisphere means and differences.\n",
        "frontal = df[df[\"hemisphere\"] == \"frontal_hemisphere\"]\n",
        "beyond = df[df[\"hemisphere\"] == \"beyond_frontal_hemisphere\"]\n",
        "\n",
        "hemisphere_reconstructed = {}\n",
        "\n",
        "for metric in metrics:\n",
        "    frontal_mean = float(frontal[metric].mean())\n",
        "    beyond_mean = float(beyond[metric].mean())\n",
        "    difference = beyond_mean - frontal_mean\n",
        "\n",
        "    hemisphere_reconstructed[metric] = {\n",
        "        \"frontal_mean\": frontal_mean,\n",
        "        \"beyond_frontal_mean\": beyond_mean,\n",
        "        \"difference\": difference\n",
        "    }\n",
        "\n",
        "print(\"\\nReconstructed hemisphere mean differences:\")\n",
        "for metric, values in hemisphere_reconstructed.items():\n",
        "    print(\n",
        "        metric,\n",
        "        \"| frontal =\", rounded(values[\"frontal_mean\"]),\n",
        "        \"| beyond-frontal =\", rounded(values[\"beyond_frontal_mean\"]),\n",
        "        \"| difference =\", rounded(values[\"difference\"])\n",
        "    )\n",
        "\n",
        "expected_hemisphere_means = {\n",
        "    \"euclidean_displacement\": {\n",
        "        \"frontal_mean\": 0.706220,\n",
        "        \"beyond_frontal_mean\": 1.287990,\n",
        "        \"difference\": 0.581770\n",
        "    },\n",
        "    \"cosine_distance\": {\n",
        "        \"frontal_mean\": 0.295816,\n",
        "        \"beyond_frontal_mean\": 0.838624,\n",
        "        \"difference\": 0.542807\n",
        "    }\n",
        "}\n",
        "\n",
        "for metric in metrics:\n",
        "    for key, expected in expected_hemisphere_means[metric].items():\n",
        "        actual = hemisphere_reconstructed[metric][key]\n",
        "        record_check(\n",
        "            f\"{metric}_{key}_matches\",\n",
        "            abs(actual - expected) <= 0.00001,\n",
        "            f\"actual={actual:.9f}; expected={expected:.6f}\"\n",
        "        )\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. MANUSCRIPT TABLE AND FIGURE INVENTORY\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 82)\n",
        "print(\"4. TABLE AND FIGURE INVENTORY\")\n",
        "print(\"=\" * 82)\n",
        "\n",
        "lines = manuscript.splitlines()\n",
        "\n",
        "table_blocks = []\n",
        "i = 0\n",
        "while i < len(lines):\n",
        "    if (\n",
        "        lines[i].strip().startswith(\"|\")\n",
        "        and i + 1 < len(lines)\n",
        "        and re.match(r\"^\\s*\\|?[\\s:|-]+\\|?\\s*$\", lines[i + 1])\n",
        "    ):\n",
        "        start = i\n",
        "        i += 2\n",
        "        while i < len(lines) and lines[i].strip().startswith(\"|\"):\n",
        "            i += 1\n",
        "        table_blocks.append({\n",
        "            \"start_line\": start + 1,\n",
        "            \"end_line\": i,\n",
        "            \"content\": \"\\n\".join(lines[start:i])\n",
        "        })\n",
        "    else:\n",
        "        i += 1\n",
        "\n",
        "figure_pattern = re.compile(r\"!\\[[^\\]]*\\]\\(([^)]+)\\)\")\n",
        "figure_refs = []\n",
        "\n",
        "for line_no, line in enumerate(lines, start=1):\n",
        "    for match in figure_pattern.finditer(line):\n",
        "        figure_refs.append({\n",
        "            \"line\": line_no,\n",
        "            \"path\": match.group(1).strip(),\n",
        "            \"alt_text\": re.search(r\"!\\[([^\\]]*)\\]\", match.group(0)).group(1)\n",
        "        })\n",
        "\n",
        "print(\"Markdown tables detected:\", len(table_blocks))\n",
        "for index, table in enumerate(table_blocks, start=1):\n",
        "    print(\n",
        "        f\"\\nTABLE BLOCK {index} | lines \"\n",
        "        f\"{table['start_line']}-{table['end_line']}\"\n",
        "    )\n",
        "    print(table[\"content\"])\n",
        "\n",
        "print(\"\\nFigure references detected:\", len(figure_refs))\n",
        "\n",
        "figure_checks = []\n",
        "for figure in figure_refs:\n",
        "    raw_path = figure[\"path\"]\n",
        "\n",
        "    if raw_path.startswith((\"http://\", \"https://\")):\n",
        "        exists = None\n",
        "        resolved = \"External URL; not checked as a local file.\"\n",
        "    else:\n",
        "        candidates = [\n",
        "            FINAL_MANUSCRIPT.parent / raw_path,\n",
        "            ROOT / raw_path\n",
        "        ]\n",
        "        found = next((p for p in candidates if p.exists()), None)\n",
        "        exists = found is not None\n",
        "        resolved = str(found) if found else \"Not found in tested locations.\"\n",
        "\n",
        "    figure_checks.append({\n",
        "        **figure,\n",
        "        \"exists\": exists,\n",
        "        \"resolved_path\": resolved\n",
        "    })\n",
        "\n",
        "    print(\n",
        "        \"FOUND\" if exists is True else\n",
        "        \"EXTERNAL\" if exists is None else \"REVIEW\",\n",
        "        \"| line\", figure[\"line\"],\n",
        "        \"|\", raw_path,\n",
        "        \"|\", resolved\n",
        "    )\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. NUMBERING AND CROSS-REFERENCE INVENTORY\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 82)\n",
        "print(\"5. NUMBERING AND CROSS-REFERENCE INVENTORY\")\n",
        "print(\"=\" * 82)\n",
        "\n",
        "table_captions = []\n",
        "figure_captions = []\n",
        "\n",
        "for line_no, line in enumerate(lines, start=1):\n",
        "    stripped = line.strip()\n",
        "\n",
        "    if re.match(r\"^\\*?\\*?Table\\s+\\d+\\.\", stripped, re.IGNORECASE):\n",
        "        table_captions.append({\n",
        "            \"line\": line_no,\n",
        "            \"caption\": stripped\n",
        "        })\n",
        "\n",
        "    if re.match(r\"^\\*?\\*?Figure\\s+\\d+\\.\", stripped, re.IGNORECASE):\n",
        "        figure_captions.append({\n",
        "            \"line\": line_no,\n",
        "            \"caption\": stripped\n",
        "        })\n",
        "\n",
        "table_numbers = [\n",
        "    int(re.search(r\"Table\\s+(\\d+)\", x[\"caption\"], re.IGNORECASE).group(1))\n",
        "    for x in table_captions\n",
        "]\n",
        "\n",
        "figure_numbers = [\n",
        "    int(re.search(r\"Figure\\s+(\\d+)\", x[\"caption\"], re.IGNORECASE).group(1))\n",
        "    for x in figure_captions\n",
        "]\n",
        "\n",
        "print(\"Table captions:\")\n",
        "for item in table_captions:\n",
        "    print(item[\"line\"], item[\"caption\"])\n",
        "\n",
        "print(\"\\nFigure captions:\")\n",
        "for item in figure_captions:\n",
        "    print(item[\"line\"], item[\"caption\"])\n",
        "\n",
        "print(\"\\nTable numbers:\", table_numbers)\n",
        "print(\"Figure numbers:\", figure_numbers)\n",
        "\n",
        "record_check(\n",
        "    \"table_caption_numbering_sequential\",\n",
        "    table_numbers == list(range(1, len(table_numbers) + 1)),\n",
        "    table_numbers\n",
        ")\n",
        "\n",
        "record_check(\n",
        "    \"figure_caption_numbering_sequential\",\n",
        "    figure_numbers == list(range(1, len(figure_numbers) + 1)),\n",
        "    figure_numbers\n",
        ")\n",
        "\n",
        "# Check textual references to table/figure numbers.\n",
        "text_refs = {\n",
        "    \"table\": sorted(set(\n",
        "        int(x) for x in re.findall(\n",
        "            r\"\\bTable\\s+(\\d+)\\b\", manuscript, re.IGNORECASE\n",
        "        )\n",
        "    )),\n",
        "    \"figure\": sorted(set(\n",
        "        int(x) for x in re.findall(\n",
        "            r\"\\bFigure\\s+(\\d+)\\b\", manuscript, re.IGNORECASE\n",
        "        )\n",
        "    ))\n",
        "}\n",
        "\n",
        "print(\"Referenced table numbers:\", text_refs[\"table\"])\n",
        "print(\"Referenced figure numbers:\", text_refs[\"figure\"])\n",
        "\n",
        "record_check(\n",
        "    \"all_table_references_have_captions\",\n",
        "    all(n in table_numbers for n in text_refs[\"table\"]),\n",
        "    text_refs[\"table\"]\n",
        ")\n",
        "\n",
        "record_check(\n",
        "    \"all_figure_references_have_captions\",\n",
        "    all(n in figure_numbers for n in text_refs[\"figure\"]),\n",
        "    text_refs[\"figure\"]\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. STATISTICAL REPORTING AND QUALIFICATION CHECKS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 82)\n",
        "print(\"6. STATISTICAL REPORTING CONSISTENCY\")\n",
        "print(\"=\" * 82)\n",
        "\n",
        "statistical_phrases = {\n",
        "    \"friedman_test\": \"Friedman\",\n",
        "    \"wilcoxon_test\": \"Wilcoxon\",\n",
        "    \"kendall_w\": \"Kendall\",\n",
        "    \"primary_holm_family\": \"combined family of six\",\n",
        "    \"primary_sign_test\": \"exact two-sided sign-test p-value\",\n",
        "    \"hemisphere_holm_family\": \"separate two-test hemisphere family\",\n",
        "    \"bootstrap\": \"bootstrap\",\n",
        "    \"identity_level\": \"38 identities\",\n",
        "    \"exploratory_hemisphere\": \"exploratory\"\n",
        "}\n",
        "\n",
        "for name, phrase in statistical_phrases.items():\n",
        "    present = phrase.lower() in manuscript.lower()\n",
        "    record_check(\n",
        "        f\"manuscript_contains_{name}\",\n",
        "        present,\n",
        "        phrase\n",
        "    )\n",
        "\n",
        "limitation_phrases = [\n",
        "    \"recognition accuracy\",\n",
        "    \"causal\",\n",
        "    \"fairness\",\n",
        "    \"operational drift\",\n",
        "    \"architecture\",\n",
        "    \"symmetry assumption\",\n",
        "    \"independence\"\n",
        "]\n",
        "\n",
        "print(\"\\nScientific limitation phrase inventory:\")\n",
        "for phrase in limitation_phrases:\n",
        "    present = phrase.lower() in manuscript.lower()\n",
        "    print((\"PRESENT\" if present else \"NOT FOUND\"), phrase)\n",
        "\n",
        "# Report selected numerical values found in the manuscript.\n",
        "print(\"\\nSelected statistical values appearing in manuscript:\")\n",
        "for pattern in [\n",
        "    r\"χ²\\(2\\)\\s*=\\s*[\\d.]+\",\n",
        "    r\"p\\s*=\\s*[\\d.eE+-]+\",\n",
        "    r\"Kendall's W\\s*=\\s*[\\d.]+\",\n",
        "    r\"Holm-adjusted p\\s*=\\s*[\\d.eE+-]+\",\n",
        "    r\"95% bootstrap CI[^.\\n]*\"\n",
        "]:\n",
        "    matches = re.findall(pattern, manuscript, flags=re.IGNORECASE)\n",
        "    print(pattern, \"=>\", matches[:20])\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. PHASE 4.4 / 4.5 EVIDENCE STATUS INSPECTION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 82)\n",
        "print(\"7. PREVIOUS AUDIT RECORD STATUS\")\n",
        "print(\"=\" * 82)\n",
        "\n",
        "def show_status(name, obj):\n",
        "    print(name, \"top-level keys:\", list(obj.keys())[:30])\n",
        "    for key in (\"status\", \"final_status\", \"audit_status\", \"result\"):\n",
        "        if key in obj:\n",
        "            print(name, key, \"=\", obj[key])\n",
        "\n",
        "show_status(\"Phase 4.4\", phase44)\n",
        "show_status(\"Phase 4.5\", phase45)\n",
        "show_status(\"Sign-test audit\", sign_report)\n",
        "show_status(\"Phase 4.5 closure\", phase45_closure)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 8. REPORTING AUDIT FLAGS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 82)\n",
        "print(\"8. AUDIT FLAGS\")\n",
        "print(\"=\" * 82)\n",
        "\n",
        "missing_local_figures = [\n",
        "    x for x in figure_checks if x[\"exists\"] is False\n",
        "]\n",
        "\n",
        "audit_flags = []\n",
        "\n",
        "if missing_local_figures:\n",
        "    audit_flags.append({\n",
        "        \"issue\": \"figure_files_not_found\",\n",
        "        \"severity\": \"REVIEW_REQUIRED\",\n",
        "        \"details\": missing_local_figures\n",
        "    })\n",
        "\n",
        "if not table_captions:\n",
        "    audit_flags.append({\n",
        "        \"issue\": \"no_table_captions_detected\",\n",
        "        \"severity\": \"REVIEW_REQUIRED\"\n",
        "    })\n",
        "\n",
        "if not figure_captions:\n",
        "    audit_flags.append({\n",
        "        \"issue\": \"no_figure_captions_detected\",\n",
        "        \"severity\": \"REVIEW_REQUIRED\"\n",
        "    })\n",
        "\n",
        "# The CSV-derived values are printed for manual comparison.\n",
        "# Do not automatically claim the manuscript's full tables match\n",
        "# solely from keyword or approximate text matching.\n",
        "\n",
        "audit_flags.append({\n",
        "    \"issue\": \"manual_table_and_statistical_value_comparison_required\",\n",
        "    \"severity\": \"MANUAL_REVIEW\",\n",
        "    \"details\": (\n",
        "        \"Compare the printed manuscript tables and statistical values \"\n",
        "        \"against the independently reconstructed summaries and verified \"\n",
        "        \"Phase 4.4 / Phase 4.5 evidence.\"\n",
        "    )\n",
        "})\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 9. PRESERVATION RECHECK\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 82)\n",
        "print(\"9. PRESERVATION RECHECK\")\n",
        "print(\"=\" * 82)\n",
        "\n",
        "preservation_paths = {\n",
        "    \"final_manuscript\": FINAL_MANUSCRIPT,\n",
        "    \"frozen_manuscript\": FROZEN_MANUSCRIPT,\n",
        "    \"evaluation_csv\": CSV_PATH,\n",
        "    \"phase44_report\": PHASE44_REPORT,\n",
        "    \"phase45_report\": PHASE45_REPORT,\n",
        "    \"sign_test_report\": SIGN_TEST_REPORT,\n",
        "    \"phase45_closure\": PHASE45_CLOSURE\n",
        "}\n",
        "\n",
        "preservation_hashes_after = {}\n",
        "\n",
        "for name, path in preservation_paths.items():\n",
        "    current = sha256(path)\n",
        "    preservation_hashes_after[name] = current\n",
        "    unchanged = current == file_hashes[name]\n",
        "    record_check(\n",
        "        f\"{name}_unchanged_during_audit\",\n",
        "        unchanged,\n",
        "        current\n",
        "    )\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 10. SAVE SEPARATE PHASE 4.6 REPORT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "failed_checks = [\n",
        "    name for name, passed in checks.items() if not passed\n",
        "]\n",
        "\n",
        "report = {\n",
        "    \"experiment\": \"Experiment 20\",\n",
        "    \"phase\": \"4.6\",\n",
        "    \"title\": \"Manuscript Integrity and Reporting Audit\",\n",
        "    \"timestamp_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "    \"status\": (\n",
        "        \"PHASE_4_6_DIAGNOSTIC_COMPLETED_PENDING_MANUAL_REVIEW\"\n",
        "        if not failed_checks\n",
        "        else \"PHASE_4_6_REVIEW_REQUIRED\"\n",
        "    ),\n",
        "    \"checks\": checks,\n",
        "    \"failed_checks\": failed_checks,\n",
        "    \"input_file_hashes\": file_hashes,\n",
        "    \"preservation_hashes_after\": preservation_hashes_after,\n",
        "    \"dataset_summary\": {\n",
        "        \"rows\": row_count,\n",
        "        \"identities\": identity_count,\n",
        "        \"evaluation_conditions\": condition_count,\n",
        "        \"group_counts\": group_counts,\n",
        "        \"hemisphere_counts\": hemisphere_counts\n",
        "    },\n",
        "    \"descriptive_statistics\": {\n",
        "        \"illumination_groups\": json.loads(\n",
        "            group_summary.to_json()\n",
        "        ),\n",
        "        \"hemispheres\": json.loads(\n",
        "            hemisphere_summary.to_json()\n",
        "        ),\n",
        "        \"hemisphere_mean_differences\": hemisphere_reconstructed\n",
        "    },\n",
        "    \"table_inventory\": table_blocks,\n",
        "    \"table_captions\": table_captions,\n",
        "    \"figure_captions\": figure_captions,\n",
        "    \"figure_references\": figure_checks,\n",
        "    \"cross_references\": text_refs,\n",
        "    \"audit_flags\": audit_flags,\n",
        "    \"manual_review_required\": True,\n",
        "    \"source_files_modified\": False\n",
        "}\n",
        "\n",
        "if OUTPUT_REPORT.exists():\n",
        "    raise FileExistsError(\n",
        "        \"Phase 4.6 report already exists. Refusing to overwrite.\"\n",
        "    )\n",
        "\n",
        "with OUTPUT_REPORT.open(\"x\", encoding=\"utf-8\") as f:\n",
        "    json.dump(report, f, indent=2, ensure_ascii=False, default=str)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 82)\n",
        "print(\"10. PHASE 4.6 REPORT\")\n",
        "print(\"=\" * 82)\n",
        "print(\"Saved:\", OUTPUT_REPORT)\n",
        "print(\"Report SHA256:\", sha256(OUTPUT_REPORT))\n",
        "print(\"Checks:\", len(checks))\n",
        "print(\"Failed checks:\", len(failed_checks))\n",
        "print(\"Audit flags:\", len(audit_flags))\n",
        "\n",
        "for flag in audit_flags:\n",
        "    print(\n",
        "        flag[\"severity\"],\n",
        "        \"|\",\n",
        "        flag[\"issue\"]\n",
        "    )\n",
        "\n",
        "print(\"\\nFINAL STATUS:\", report[\"status\"])\n",
        "print(\"No manuscript, CSV, figure, or prior audit report was modified.\")\n"
      ],
      "metadata": {
