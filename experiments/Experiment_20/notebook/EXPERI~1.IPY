        "markdown_content = f\"# {section_title}\\n\\n{section_text}\\n\"\n",
        "\n",
        "markdown_path = OUTPUT_DIR / \"experiment20_methodology_3_2_dataset_provenance.md\"\n",
        "json_path = OUTPUT_DIR / \"experiment20_step3392_dataset_provenance.json\"\n",
        "audit_path = OUTPUT_DIR / \"experiment20_step3392_dataset_provenance_audit.json\"\n",
        "\n",
