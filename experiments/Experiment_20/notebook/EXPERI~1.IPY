      "cell_type": "markdown",
      "source": [
        "# Experiment 20 — Step 3.3.28: Frozen Figure Inventory and Manuscript Placement Audit\n",
        "\n",
        "## Objective\n",
        "Inspect the four frozen figures and identify appropriate locations for their integration into a new manuscript version.\n",
        "\n",
        "## Frozen figures\n",
        "1. Euclidean displacement across illumination geometry groups.\n",
        "2. Cosine distance across illumination geometry groups.\n",
        "3. Euclidean displacement: frontal versus beyond-frontal hemisphere.\n",
        "4. Cosine distance: frontal versus beyond-frontal hemisphere.\n",
        "\n",
        "## Procedure\n",
        "- Verify that all four figure files exist.\n",
        "- Recalculate SHA256 hashes and compare them with the recorded frozen hashes.\n",
        "- Inspect image dimensions, format, and file size.\n",
        "- Inspect manuscript headings, figure references, and surrounding results paragraphs.\n",
        "- Identify suitable insertion locations without changing manuscript content.\n",
        "\n",
        "## Integrity restrictions\n",
        "- Read-only inspection.\n",
        "- Do not regenerate, resize, or modify figures.\n",
        "- Do not edit either existing manuscript.\n",
        "- Do not insert images yet.\n",
        "\n",
        "## Expected outcome\n",
        "A verified figure inventory and a proposed figure-to-manuscript placement map."
      ],
      "metadata": {
        "id": "ZtlWhPKrGTT7"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# EXPERIMENT 20 — STEP 3.3.28\n",
        "# FROZEN FIGURE INVENTORY AND MANUSCRIPT PLACEMENT AUDIT\n",
        "# READ-ONLY\n",
        "# ============================================================\n",
        "\n",
        "import os\n",
        "import re\n",
        "import json\n",
        "import hashlib\n",
        "from datetime import datetime, timezone\n",
        "from PIL import Image\n",
        "\n",
        "BASE = \"/content/drive/MyDrive/Experiment_20_Results\"\n",
        "\n",
        "FIGURE_DIR = os.path.join(\n",
        "    BASE, \"step_2_7\", \"final_freeze\"\n",
        ")\n",
        "\n",
        "FIGURES = {\n",
        "    \"Figure 1\": {\n",
        "        \"filename\": \"experiment20_figure1_euclidean_illumination_groups.png\",\n",
        "        \"expected_sha256\": \"71623f613dc8202cf5cf6ff7bea005b315e4a31de73841d064c896b24e565b16\",\n",
        "        \"subject\": \"Euclidean displacement across illumination geometry groups\"\n",
        "    },\n",
        "    \"Figure 2\": {\n",
        "        \"filename\": \"experiment20_figure2_cosine_illumination_groups.png\",\n",
        "        \"expected_sha256\": \"de22ee98a909ef099199f5b49911633497c2c890d9d903224131f95db54c917c\",\n",
        "        \"subject\": \"Cosine distance across illumination geometry groups\"\n",
        "    },\n",
        "    \"Figure 3\": {\n",
        "        \"filename\": \"experiment20_figure3_euclidean_hemisphere_comparison.png\",\n",
        "        \"expected_sha256\": \"5a55b8947698a35dd20a258a4d185b927a64ccdac4a4b18d8aad4bd6d35fc0c6\",\n",
        "        \"subject\": \"Euclidean displacement: frontal versus beyond-frontal hemisphere\"\n",
        "    },\n",
        "    \"Figure 4\": {\n",
        "        \"filename\": \"experiment20_figure4_cosine_hemisphere_comparison.png\",\n",
        "        \"expected_sha256\": \"0a06e0a5458ec2779aee94778f59fd576e585f8fc85fdd3e82afb6c91211851c\",\n",
        "        \"subject\": \"Cosine distance: frontal versus beyond-frontal hemisphere\"\n",
        "    }\n",
        "}\n",
        "\n",
        "MANUSCRIPTS = {\n",
        "    \"integrated\": os.path.join(\n",
        "        BASE, \"step_3_3\", \"step_3312\",\n",
        "        \"experiment20_integrated_manuscript_v1.md\"\n",
        "    ),\n",
        "    \"review_copy\": os.path.join(\n",
        "        BASE, \"step_3_3\", \"step_3313\",\n",
        "        \"experiment20_step3313_manuscript_review_copy.md\"\n",
        "    )\n",
        "}\n",
        "\n",
        "OUTPUT_DIR = os.path.join(\n",
        "    BASE, \"step_3_3\", \"step_3328\"\n",
        ")\n",
        "os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
        "\n",
        "REPORT_PATH = os.path.join(\n",
        "    OUTPUT_DIR,\n",
        "    \"experiment20_step3328_figure_inventory_placement_audit.json\"\n",
        ")\n",
        "\n",
        "\n",
        "def sha256_file(path):\n",
        "    h = hashlib.sha256()\n",
        "\n",
        "    with open(path, \"rb\") as f:\n",
        "        for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n",
        "            h.update(chunk)\n",
        "\n",
        "    return h.hexdigest()\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. VERIFY FROZEN FIGURES\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"=\" * 100)\n",
        "print(\"STEP 3.3.28 — FROZEN FIGURE INVENTORY\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "figure_results = {}\n",
        "\n",
        "for figure_name, info in FIGURES.items():\n",
        "\n",
        "    path = os.path.join(FIGURE_DIR, info[\"filename\"])\n",
        "\n",
        "    if not os.path.isfile(path):\n",
        "        figure_results[figure_name] = {\n",
        "            \"exists\": False,\n",
        "            \"status\": \"MISSING\"\n",
        "        }\n",
        "\n",
        "        print(f\"\\n{figure_name}: MISSING\")\n",
        "        continue\n",
        "\n",
        "    actual_hash = sha256_file(path)\n",
        "\n",
        "    with Image.open(path) as image_file:\n",
        "        image_file.verify()\n",
        "\n",
        "    with Image.open(path) as image_file:\n",
        "        width, height = image_file.size\n",
        "        image_format = image_file.format\n",
        "        mode = image_file.mode\n",
        "\n",
        "    hash_matches = actual_hash == info[\"expected_sha256\"]\n",
        "\n",
        "    figure_results[figure_name] = {\n",
        "        \"exists\": True,\n",
        "        \"filename\": info[\"filename\"],\n",
        "        \"path\": path,\n",
        "        \"subject\": info[\"subject\"],\n",
        "        \"sha256\": actual_hash,\n",
        "        \"expected_sha256\": info[\"expected_sha256\"],\n",
        "        \"sha256_matches\": hash_matches,\n",
        "        \"width_pixels\": width,\n",
        "        \"height_pixels\": height,\n",
        "        \"format\": image_format,\n",
        "        \"mode\": mode,\n",
        "        \"size_bytes\": os.path.getsize(path),\n",
        "        \"image_readable\": True\n",
        "    }\n",
        "\n",
        "    print(f\"\\n{figure_name}\")\n",
        "    print(\"Filename:\", info[\"filename\"])\n",
        "    print(\"SHA256:\", actual_hash)\n",
        "    print(\"Hash matches frozen record:\", hash_matches)\n",
        "    print(\"Dimensions:\", width, \"x\", height)\n",
        "    print(\"Format:\", image_format)\n",
        "    print(\"Colour mode:\", mode)\n",
        "    print(\"Size:\", os.path.getsize(path), \"bytes\")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. INSPECT MANUSCRIPT STRUCTURE AND FIGURE REFERENCES\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "manuscript_results = {}\n",
        "\n",
        "for label, path in MANUSCRIPTS.items():\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 100)\n",
        "    print(\"MANUSCRIPT:\", label)\n",
        "    print(\"=\" * 100)\n",
        "\n",
        "    if not os.path.isfile(path):\n",
        "        raise FileNotFoundError(path)\n",
        "\n",
        "    with open(path, \"r\", encoding=\"utf-8\") as f:\n",
        "        lines = f.readlines()\n",
        "\n",
        "    headings = []\n",
        "    figure_reference_lines = []\n",
        "\n",
        "    for index, line in enumerate(lines):\n",
        "\n",
        "        stripped = line.strip()\n",
        "\n",
        "        if re.match(r\"^#{1,6}\\s+\", stripped):\n",
        "            headings.append({\n",
        "                \"line\": index + 1,\n",
        "                \"heading\": stripped\n",
        "            })\n",
        "\n",
        "        if re.search(\n",
        "            r\"\\bFigures?\\s*[1-4]\\b|\\bFig(?:ure)?\\.?\\s*[1-4]\\b\",\n",
        "            line,\n",
        "            flags=re.IGNORECASE\n",
        "        ):\n",
        "            figure_reference_lines.append({\n",
        "                \"line\": index + 1,\n",
        "                \"text\": stripped\n",
        "            })\n",
        "\n",
        "    # Extract Results section and relevant surrounding paragraphs.\n",
        "    results_start = None\n",
        "    discussion_start = None\n",
        "\n",
        "    for i, line in enumerate(lines):\n",
        "\n",
        "        if re.match(r\"^#{1,6}\\s+Results\\b\", line.strip(), re.I):\n",
        "            results_start = i\n",
        "\n",
        "        if re.match(r\"^#{1,6}\\s+Discussion\\b\", line.strip(), re.I):\n",
        "            discussion_start = i\n",
        "            break\n",
        "\n",
        "    results_lines = []\n",
        "\n",
        "    if results_start is not None:\n",
        "\n",
        "        end = (\n",
        "            discussion_start\n",
        "            if discussion_start is not None\n",
        "            else len(lines)\n",
        "        )\n",
        "\n",
        "        for i in range(results_start, end):\n",
        "            if lines[i].strip():\n",
        "                results_lines.append({\n",
        "                    \"line\": i + 1,\n",
        "                    \"text\": lines[i].rstrip()\n",
        "                })\n",
        "\n",
        "    manuscript_results[label] = {\n",
        "        \"path\": path,\n",
        "        \"sha256\": sha256_file(path),\n",
        "        \"line_count\": len(lines),\n",
        "        \"headings\": headings,\n",
        "        \"figure_reference_lines\": figure_reference_lines,\n",
        "        \"results_section\": results_lines\n",
        "    }\n",
        "\n",
        "    print(\"SHA256:\", manuscript_results[label][\"sha256\"])\n",
        "    print(\"Total lines:\", len(lines))\n",
        "\n",
        "    print(\"\\nHEADINGS:\")\n",
        "    for item in headings:\n",
        "        print(f\"{item['line']}: {item['heading']}\")\n",
        "\n",
        "    print(\"\\nEXISTING FIGURE REFERENCES:\")\n",
        "    if figure_reference_lines:\n",
        "        for item in figure_reference_lines:\n",
        "            print(f\"{item['line']}: {item['text']}\")\n",
        "    else:\n",
        "        print(\"No explicit Figure 1–4 references found.\")\n",
        "\n",
        "    print(\"\\nRESULTS SECTION:\")\n",
        "    for item in results_lines:\n",
        "        print(f\"{item['line']}: {item['text']}\")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. CHECK MANUSCRIPT COPY IDENTITY\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "integrated_hash = manuscript_results[\"integrated\"][\"sha256\"]\n",
        "review_hash = manuscript_results[\"review_copy\"][\"sha256\"]\n",
        "\n",
        "copies_identical = integrated_hash == review_hash\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"MANUSCRIPT IDENTITY\")\n",
        "print(\"=\" * 100)\n",
        "print(\"Integrated SHA256:\", integrated_hash)\n",
        "print(\"Review copy SHA256:\", review_hash)\n",
        "print(\"Identical:\", copies_identical)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. PROPOSE FIGURE PLACEMENT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "placement_map = [\n",
        "    {\n",
        "        \"figure\": \"Figure 1\",\n",
        "        \"file\": FIGURES[\"Figure 1\"][\"filename\"],\n",
        "        \"proposed_section\": \"Results — illumination geometry group comparisons\",\n",
        "        \"proposed_position\": \"Immediately after the paragraph introducing Euclidean displacement differences across the three illumination geometry groups.\",\n",
        "        \"status\": \"PROPOSED_NOT_INSERTED\"\n",
        "    },\n",
        "    {\n",
        "        \"figure\": \"Figure 2\",\n",
        "        \"file\": FIGURES[\"Figure 2\"][\"filename\"],\n",
        "        \"proposed_section\": \"Results — illumination geometry group comparisons\",\n",
        "        \"proposed_position\": \"Immediately after the paragraph introducing cosine distance differences across the three illumination geometry groups.\",\n",
        "        \"status\": \"PROPOSED_NOT_INSERTED\"\n",
        "    },\n",
        "    {\n",
        "        \"figure\": \"Figure 3\",\n",
        "        \"file\": FIGURES[\"Figure 3\"][\"filename\"],\n",
        "        \"proposed_section\": \"Results — hemisphere comparison\",\n",
        "        \"proposed_position\": \"Immediately after the paragraph reporting the Euclidean frontal versus beyond-frontal comparison.\",\n",
        "        \"status\": \"PROPOSED_NOT_INSERTED\"\n",
        "    },\n",
        "    {\n",
        "        \"figure\": \"Figure 4\",\n",
        "        \"file\": FIGURES[\"Figure 4\"][\"filename\"],\n",
        "        \"proposed_section\": \"Results — hemisphere comparison\",\n",
        "        \"proposed_position\": \"Immediately after the paragraph reporting the cosine frontal versus beyond-frontal comparison.\",\n",
        "        \"status\": \"PROPOSED_NOT_INSERTED\"\n",
        "    }\n",
        "]\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"PROPOSED FIGURE PLACEMENT\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "for item in placement_map:\n",
        "    print(\"\\n\", item[\"figure\"])\n",
        "    print(\"Section:\", item[\"proposed_section\"])\n",
        "    print(\"Position:\", item[\"proposed_position\"])\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. FINAL REPORT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "all_figures_exist = all(\n",
        "    item.get(\"exists\", False)\n",
        "    for item in figure_results.values()\n",
        ")\n",
        "\n",
        "all_hashes_match = all(\n",
        "    item.get(\"sha256_matches\", False)\n",
        "    for item in figure_results.values()\n",
        ")\n",
        "\n",
        "all_images_readable = all(\n",
        "    item.get(\"image_readable\", False)\n",
        "    for item in figure_results.values()\n",
        ")\n",
        "\n",
        "report = {\n",
        "    \"step\": \"3.3.28\",\n",
        "    \"title\": \"Frozen Figure Inventory and Manuscript Placement Audit\",\n",
        "    \"created_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "\n",
        "    \"figure_inventory\": figure_results,\n",
        "    \"all_four_figures_exist\": all_figures_exist,\n",
        "    \"all_four_hashes_match\": all_hashes_match,\n",
        "    \"all_four_images_readable\": all_images_readable,\n",
        "\n",
        "    \"manuscripts\": manuscript_results,\n",
        "    \"manuscript_copies_identical\": copies_identical,\n",
        "\n",
        "    \"proposed_figure_placement\": placement_map,\n",
        "\n",
        "    \"integrity\": {\n",
        "        \"figures_modified\": False,\n",
        "        \"manuscripts_modified\": False,\n",
        "        \"frozen_evidence_modified\": False,\n",
        "        \"new_audit_report_created\": True\n",
        "    },\n",
        "\n",
        "    \"status\": (\n",
        "        \"FIGURE_INVENTORY_VERIFIED\"\n",
        "        if all_figures_exist and all_hashes_match and all_images_readable\n",
        "        else \"FIGURE_INVENTORY_REQUIRES_REVIEW\"\n",
        "    )\n",
        "}\n",
        "\n",
        "with open(REPORT_PATH, \"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(report, f, indent=2)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"FINAL STATUS\")\n",
        "print(\"=\" * 100)\n",
        "print(\"All four figures exist:\", all_figures_exist)\n",
        "print(\"All four hashes match:\", all_hashes_match)\n",
        "print(\"All four images readable:\", all_images_readable)\n",
        "print(\"Manuscript copies identical:\", copies_identical)\n",
        "print(\"Status:\", report[\"status\"])\n",
        "print(\"Report saved:\", REPORT_PATH)\n",
        "print(\"Report SHA256:\", sha256_file(REPORT_PATH))\n",
        "\n",
        "print(\"\\nNo existing files were modified.\")\n",
        "print(\"STEP 3.3.28 COMPLETED\")"
      ],
