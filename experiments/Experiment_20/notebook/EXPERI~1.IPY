 = os.path.join(\\n\",\"    ],\\n\",\"    \\\"reference_observations\\\": int(len(reference_embeddings)),\\n\",\"    \\\"embedding_dimension\\\": int(n_features),\\n\",\"    \\\"identity_count\\\": int(len(identity_ids)),\\n\",\"    \\\"covariance_shrinkage\\\": shrinkage,\\n\",\"    \\\"global_euclidean_normalization\\\": (\\n\",\"\\n\",\"Cell: 17\\n\",\"Matched terms: ['embedding_dimension', 'experiment18_illumination_results', 'experiment18_facenet_lfw_embeddings']\\n\",\"\\n\",\"SOURCE_PATH = os.path.join(\\n\",\"    DATA_DIR, \\\"experiment18_facenet_lfw_embeddings.npz\\\"\\n\",\")\\n\",\"SPLIT_PATH = os.path.join(\\n\",\"with np.load(\\n\",\"    os.path.join(DATA_DIR, \\\"experiment18_illumination_results.npz\\\"),\\n\",\"    allow_pickle=False\\n\",\") as paired:\\n\",\"    paired_identity_ids = np.sort(\\n\",\"        len(calibration_embeddings)\\n\",\"    ),\\n\",\"    \\\"embedding_dimension\\\": int(\\n\",\"        calibration_embeddings.shape[1]\\n\",\"    \\\"finite_embeddings\\\": bool(\\n\",\"\\n\",\"Cell: 19\\n\",\"Matched terms: ['experiment18_illumination_results']\\n\",\"\\n\",\"SOURCE_PATH = os.path.join(\\n\",\"    DATA_DIR, \\\"experiment18_illumination_results.npz\\\"\\n\",\")\\n\",\"SPLIT_PATH = os.path.join(\\n\",\"\\n\",\"Cell: 21\\n\",\"Matched terms: ['experiment18_illumination_results']\\n\",\"\\n\",\"SOURCE_PATH = os.path.join(\\n\",\"    DATA_DIR, \\\"experiment18_illumination_results.npz\\\"\\n\",\")\\n\",\"SPLIT_PATH = os.path.join(\\n\",\"\\n\",\"---------------------------------------------------------------------------\\n\",\"NOTEBOOK 18\\n\",\"Path: /content/drive/MyDrive/Colab Notebooks/Experiment 20: Paired Identity-Level Evaluation of Within-Identity Embedding Drift Detection Under Multiple Controlled Biometric Acquisition Changes.ipynb\\n\",\"Experiment 18 reference: True\\n\",\"\\n\",\"Cell: 0\\n\",\"Matched terms: ['InceptionResnetV1', 'VGGFace2', 'MTCNN', 'alignment']\\n\",\"- Expected source-image cohort: 889 observations, subject to dataset and file audit.\\n\",\"- Expected identity count: 13, subject to identity metadata verification.\\n\",\"- Face detector and alignment: Existing verified MTCNN preprocessing outputs, where suitable.\\n\",\"- Face-recognition model: InceptionResnetV1.\\n\",\"- Pretrained weights: VGGFace2.\\n\",\"- Embedding dimension: 512.\\n\",\"- Framework: PyTorch and facenet-pytorch.\\n\",\"- Identity labels: Used for paired data validation, controlled evaluation and identity-conditioned monitoring.\\n\",\"\\n\",\"Cell: 2\\n\",\"Matched terms: ['embedding_dimension']\\n\",\"    \\\"expected_source_images\\\": 889,\\n\",\"    \\\"expected_identities\\\": 13,\\n\",\"    \\\"embedding_dimension\\\": 512,\\n\",\"\\n\",\"    \\\"transformation_families\\\": [\\n\",\"        \\\"illumination\\\",\\n\",\"\\n\",\"Cell: 8\\n\",\"Matched terms: ['experiment18_illumination_results', 'experiment18_facenet_lfw_embeddings']\\n\",\"\\n\",\"archives = [\\n\",\"    base / \\\"experiment18_facenet_lfw_embeddings.npz\\\",\\n\",\"    base / \\\"experiment18_illumination_results.npz\\\"\\n\",\"]\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"Cell: 12\\n\",\"Matched terms: ['experiment18_illumination_results']\\n\",\"archive_path = Path(\\n\",\"    \\\"/content/drive/MyDrive/Experiment_18_Results/\\\"\\n\",\"    \\\"experiment18_illumination_results.npz\\\"\\n\",\")\\n\",\"\\n\",\"assert archive_path.exists(), \\\"Experiment 18 archive not found.\\\"\\n\",\"\\n\",\"Cell: 14\\n\",\"Matched terms: ['experiment18_illumination_results']\\n\",\"archive_path = Path(\\n\",\"    \\\"/content/drive/MyDrive/Experiment_18_Results/\\\"\\n\",\"    \\\"experiment18_illumination_results.npz\\\"\\n\",\")\\n\",\"\\n\",\"assert archive_path.exists(), \\\"Experiment 18 archive not found.\\\"\\n\",\"\\n\",\"Cell: 15\\n\",\"Matched terms: ['InceptionResnetV1', 'VGGFace2']\\n\",\"- Identities: 13.\\n\",\"- Embedding dimension: 512.\\n\",\"- Embedding model: InceptionResnetV1.\\n\",\"- Pretrained weights: VGGFace2.\\n\",\"- Acquisition conditions: Original, low illumination and high illumination.\\n\",\"- Purpose: Develop and evaluate paired within-identity drift detection methods.\\n\",\"\\n\",\"- One identity accounts for 56.69% of the 889 paired observations.\\n\",\"- The existing cohort excludes 67 of 956 original evaluation positions because of extraction failures under at least one illumination condition.\\n\",\"- Extended Yale B is grayscale, whereas the existing pipeline uses an InceptionResnetV1 model pretrained on VGGFace2.\\n\",\"- Preprocessing compatibility and extraction success must be tested before Stage 2 is accepted.\\n\",\"- Cross-dataset validation does not automatically establish generalisation to unconstrained real-world biometric systems.\\n\",\"\\n\",\"Cell: 16\\n\",\"Matched terms: ['InceptionResnetV1', 'VGGFace2', 'embedding_dimension']\\n\",\"        \\\"paired_observations\\\": 889,\\n\",\"        \\\"identities\\\": 13,\\n\",\"        \\\"embedding_dimension\\\": 512,\\n\",\"        \\\"model\\\": \\\"InceptionResnetV1\\\",\\n\",\"        \\\"pretrained_weights\\\": \\\"VGGFace2\\\",\\n\",\"        \\\"purpose\\\": \\\"Method development and calibration\\\"\\n\",\"    },\\n\",\"    \\\"stage_2\\\": {\\n\",\"\\n\",\"Cell: 18\\n\",\"Matched terms: ['Resize']\\n\",\"    \\\"expected_dimensions\\\": [168, 192],\\n\",\"    \\\"dimensions_note\\\": (\\n\",\"        \\\"Reported for manually aligned, cropped and resized images; \\\"\\n\",\"        \\\"must be confirmed against the acquired archive.\\\"\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"Cell: 41\\n\",\"Matched terms: ['InceptionResnetV1', 'alignment']\\n\",\"Audit objectives:\\n\",\"1. Locate the Experiment 18 notebook in Google Drive.\\n\",\"2. Identify the InceptionResnetV1 model configuration.\\n\",\"3. Identify the pretrained weights.\\n\",\"4. Recover image resizing and normalization procedures.\\n\",\"5. Identify face detection, alignment, and cropping operations.\\n\",\"6. Identify embedding extraction and output dimensionality.\\n\",\"7. Inspect the current Colab package versions and GPU availability.\\n\",\"8. Save a reproducible compatibility audit.\\n\",\"\\n\",\"Cell: 42\\n\",\"Matched terms: ['InceptionResnetV1', 'VGGFace2', 'MTCNN', 'fixed_image_standardization', 'prewhiten', 'Resize', 'Normalize', 'interpolate', 'ToTensor', 'face_detection', 'embedding_dimension']\\n\",\"\\n\",\"search_terms = [\\n\",\"    \\\"InceptionResnetV1\\\",\\n\",\"    \\\"VGGFace2\\\",\\n\",\"    \\\"MTCNN\\\",\\n\",\"    \\\"fixed_image_standardization\\\",\\n\",\"    \\\"prewhiten\\\",\\n\",\"    \\\"Resize\\\",\\n\",\"    \\\"Normalize\\\",\\n\",\"    \\\"interpolate\\\",\\n\",\"    \\\"160\\\",\\n\",\"    \\\"512\\\",\\n\",\"    \\\"eval()\\\",\\n\",\"    \\\"no_grad\\\",\\n\",\"    \\\"unsqueeze\\\",\\n\",\"    \\\"ToTensor\\\",\\n\",\"    \\\"face_detection\\\",\\n\",\"    \\\"align\\\",\\n\",\"    \\\"embedding\\\"\\n\",\"]\\n\",\"evidence_flags = {\\n\",\"    \\\"model_architecture_found\\\": (\\n\",\"        \\\"inceptionresnetv1\\\" in all_evidence_text\\n\",\"    ),\\n\",\"    \\\"pretrained_weights_found\\\": (\\n\",\"        \\\"vggface2\\\" in all_evidence_text\\n\",\"    \\\"face_detection_reference_found\\\": (\\n\",\"        \\\"mtcnn\\\" in all_evidence_text\\n\",\"        or \\\"face_detection\\\" in all_evidence_text\\n\",\"    \\\"resize_reference_found\\\": (\\n\",\"        \\\"resize\\\" in all_evidence_text\\n\",\"        or \\\"interpolate\\\" in all_evidence_text\\n\",\"    \\\"normalization_reference_found\\\": (\\n\",\"        \\\"fixed_image_standardization\\\" in all_evidence_text\\n\",\"        or \\\"prewhiten\\\" in all_evidence_text\\n\",\"        or \\\"normalize\\\" in all_evidence_text\\n\",\"    \\\"embedding_dimension_reference_found\\\": (\\n\",\"        \\\"512\\\" in all_evidence_text\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"---------------------------------------------------------------------------\\n\",\"NOTEBOOK 19\\n\",\"Path: /content/drive/MyDrive/Experiment 13/Experiment_13_Final.ipynb\\n\",\"Experiment 18 reference: False\\n\",\"\\n\",\"Cell: 2\\n\",\"Matched terms: ['embedding_dimension']\\n\",\"    \\\"random_seed\\\": SEED,\\n\",\"    \\\"n_seeds\\\": 20,\\n\",\"    \\\"embedding_dimension\\\": 64,\\n\",\"    \\\"reference_samples\\\": 1000,\\n\",\"    \\\"calibration_windows\\\": 200,\\n\",\"    \\\"control_windows\\\": 500,\\n\",\"\\n\",\"Cell: 3\\n\",\"Matched terms: ['embedding_dimension']\\n\",\"    n_windows=CONFIG[\\\"reference_samples\\\"] // CONFIG[\\\"window_size\\\"],\\n\",\"    window_size=CONFIG[\\\"window_size\\\"],\\n\",\"    dimension=CONFIG[\\\"embedding_dimension\\\"],\\n\",\")\\n\",\"\\n\",\"calibration = generate_embedding_windows(\\n\",\"    n_windows=CONFIG[\\\"calibration_windows\\\"],\\n\",\"control = generate_embedding_windows(\\n\",\"    n_windows=CONFIG[\\\"control_windows\\\"],\\n\",\"print(\\\"Reference windows:\\\", reference.shape)\\n\",\"\\n\",\"Cell: 6\\n\",\"Matched terms: ['embedding_dimension']\\n\",\"        n_windows=CONFIG[\\\"evaluation_windows_per_condition\\\"],\\n\",\"        window_size=CONFIG[\\\"window_size\\\"],\\n\",\"        dimension=CONFIG[\\\"embedding_dimension\\\"],\\n\",\"        mean_shift=shift,\\n\",\"    )\\n\",\"\\n\",\"\\n\",\"Cell: 8\\n\",\"Matched terms: ['embedding_dimension']\\n\",\"    # Independent datasets for this seed\\n\",\"    ref = generate_embedding_windows(\\n\",\"        seed_rng, 50, 20, CONFIG[\\\"embedding_dimension\\\"]\\n\",\"    )\\n\",\"    cal = generate_embedding_windows(\\n\",\"        seed_rng, 200, 20, CONFIG[\\\"embedding_dimension\\\"]\\n\",\"    ctrl = generate_embedding_windows(\\n\",\"        seed_rng, 500, 20, CONFIG[\\\"embedding_dimension\\\"]\\n\",\"\\n\",\"    # Fit detectors using reference data only\\n\",\"                    500,\\n\",\"                    20,\\n\",\"                    CONFIG[\\\"embedding_dimension\\\"],\\n\",\"                    mean_shift=shift,\\n\",\"                )\\n\",\"\\n\",\"Cell: 9\\n\",\"Matched terms: ['embedding_dimension']\\n\",\"    # 1. Generate independent datasets for this seed\\n\",\"    ref = generate_embedding_windows(\\n\",\"        seed_rng, 50, 20, CONFIG[\\\"embedding_dimension\\\"]\\n\",\"    )\\n\",\"    cal = generate_embedding_windows(\\n\",\"        seed_rng, 200, 20, CONFIG[\\\"embedding_dimension\\\"]\\n\",\"    ctrl = generate_embedding_windows(\\n\",\"        seed_rng, 500, 20, CONFIG[\\\"embedding_dimension\\\"]\\n\",\"\\n\",\"    # 2. Fit detectors on the same reference data\\n\",\"            500,\\n\",\"            20,\\n\",\"            CONFIG[\\\"embedding_dimension\\\"],\\n\",\"            mean_shift=shift,\\n\",\"        )\\n\",\"        for shift in CONFIG[\\\"mean_shift_strengths\\\"]\\n\",\"\\n\",\"Cell: 18\\n\",\"Matched terms: ['embedding_dimension']\\n\",\"else:\\n\",\"    print(\\\"Required functions and configuration are available.\\\")\\n\",\"    print(\\\"Embedding dimension:\\\", CONFIG[\\\"embedding_dimension\\\"])\\n\",\"    print(\\\"Random seed:\\\", CONFIG[\\\"random_seed\\\"])\\n\",\"    print(\\\"Detectors:\\\", CONFIG[\\\"detectors\\\"])\\n\",\"\\n\",\"Cell: 79\\n\",\"Matched terms: ['alignment']\\n\",\"\\n\",\"print(\\\"\\\\nIndex-order check completed.\\\")\\n\",\"print(\\\"Note: hashes alone cannot establish alignment unless we also have\\\"\\n\",\"      \\\" matching source-image hashes from the original embedding run.\\\")\\n\",\"\\n\",\"Cell: 82\\n\",\"Matched terms: ['alignment']\\n\",\"    \\\"Identity mismatch detected; do not generate transformed embeddings.\\\"\\n\",\"\\n\",\"print(\\\"\\\\nIdentity alignment check passed.\\\")\\n\",\"\\n\",\"Cell: 89\\n\",\"Matched terms: ['alignment']\\n\",\"- The fresh identities come from the same dataset, not an external dataset.\\n\",\"- Matching identity labels verifies the selected identity mapping but does not\\n\",\"  independently prove exact image-level alignment for identities with multiple images.\\n\",\"- No biometric recognition accuracy, demographic fairness, bias mitigation, or\\n\",\"  deployment-readiness claim is supported.\\n\",\"- The detector's threshold and CUSUM settings are provisional and do not guarantee\\n\",\"\\n\",\"[3] SUPPORTING ARTIFACTS\\n\",\"/content/drive/MyDrive/Experiment_18_Results/experiment18_facenet_lfw_embeddings.npz\\n\",\"/content/drive/MyDrive/Experiment_18_Results/experiment18_illumination_results.npz\\n\",\"/content/drive/MyDrive/Experiment_18_Results/illumination_identity_summary.csv\\n\",\"/content/drive/MyDrive/Experiment_18_Results/illumination_metadata.json\\n\",\"/content/drive/MyDrive/Experiment_18_Results/experiment18_final_research_evidence.md\\n\",\"/content/drive/MyDrive/Experiment_18_Results/experiment18_final_research_evidence.json\\n\",\"/content/drive/MyDrive/Experiment_18_Results/Experiment_18_Final_Research_Package.zip\\n\",\"/content/drive/MyDrive/Experiment_20_Results/dataset_audit/experiment20_common_illumination_condition_manifest.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/dataset_audit/experiment20_common_illumination_condition_audit.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/dataset_audit/experiment20_grouped_illumination_condition_manifest.json\\n\",\"/content/drive/MyDrive/Experiment_20_Results/dataset_audit/experiment20_corrected_illumination_condition_manifest.json\\n\",\"\\n\",\"[4] CONFIGURATION EVIDENCE FLAGS\\n\",\"inceptionresnetv1: True\\n\",\"vggface2: True\\n\",\"mtcnn: True\\n\",\"fixed_image_standardization: True\\n\",\"prewhiten: True\\n\",\"resize: True\\n\",\"normalization: True\\n\",\"embedding_512: True\\n\",\"\\n\",\"[5] AUDIT SAVED AND VERIFIED\\n\",\"Path: /content/drive/MyDrive/Experiment_20_Results/dataset_audit/experiment20_facenet_preprocessing_compatibility_audit.json\\n\",\"Status: EVIDENCE_FOUND\\n\",\"\\n\",\"STEP 2.6.13 COMPLETE\\n\"]}]},{\"cell_type\":\"markdown\",\"source\":[\"## EXPERIMENT 20 — STEP 2.6.14: EXACT EXPERIMENT 18 PIPELINE RECOVERY\\n\",\"\\n\",\"Inspect the original Experiment 18 notebook and retrieve the complete source code for:\\n\",\"\\n\",\"1. MTCNN initialization.\\n\",\"2. InceptionResnetV1 initialization.\\n\",\"3. Face detection and alignment.\\n\",\"4. Embedding extraction.\\n\",\"5. Embedding normalization and validation.\\n\",\"\\n\",\"The objective is to recover the exact implementation, not reconstruct it from summaries.\\n\",\"\\n\",\"This step is read-only. Do not initialize models, download weights, or generate embeddings.\"],\"metadata\":{\"id\":\"Jtgv7ItksL3Y\"}},{\"cell_type\":\"code\",\"source\":[\"import os\\n\",\"import json\\n\",\"\\n\",\"NOTEBOOK_PATH = (\\n\",\"    \\\"/content/drive/MyDrive/Colab Notebooks/\\\"\\n\",\"    \\\"Experiment_18_Genuine_Face_Recognition_Embedding_Validation.ipynb\\\"\\n\",\")\\n\",\"\\n\",\"assert os.path.isfile(NOTEBOOK_PATH), (\\n\",\"    \\\"Original Experiment 18 notebook not found: \\\" + NOTEBOOK_PATH\\n\",\")\\n\",\"\\n\",\"with open(NOTEBOOK_PATH, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    notebook = json.load(f)\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"EXPERIMENT 20 — STEP 2.6.14: EXACT PIPELINE RECOVERY\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"terms = [\\n\",\"    \\\"MTCNN(\\\",\\n\",\"    \\\"InceptionResnetV1(\\\",\\n\",\"    \\\"mtcnn(\\\",\\n\",\"    \\\"facenet(\\\",\\n\",\"    \\\"torch.nn.functional.normalize\\\",\\n\",\"    \\\"torch.no_grad\\\",\\n\",\"    \\\"embedding\\\"\\n\",\"]\\n\",\"\\n\",\"found = 0\\n\",\"\\n\",\"for index, cell in enumerate(notebook.get(\\\"cells\\\", [])):\\n\",\"\\n\",\"    source = cell.get(\\\"source\\\", [])\\n\",\"\\n\",\"    if isinstance(source, list):\\n\",\"        source = \\\"\\\".join(source)\\n\",\"\\n\",\"    if not isinstance(source, str):\\n\",\"        continue\\n\",\"\\n\",\"    matched = [\\n\",\"        term for term in terms\\n\",\"        if term.lower() in source.lower()\\n\",\"    ]\\n\",\"\\n\",\"    if matched:\\n\",\"        found += 1\\n\",\"        print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"        print(\\\"CELL INDEX:\\\", index)\\n\",\"        print(\\\"CELL TYPE:\\\", cell.get(\\\"cell_type\\\"))\\n\",\"        print(\\\"MATCHED TERMS:\\\", matched)\\n\",\"        print(\\\"-\\\" * 75)\\n\",\"        print(source)\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"TOTAL MATCHING CELLS:\\\", found)\\n\",\"print(\\\"NOTEBOOK:\\\", NOTEBOOK_PATH)\\n\",\"print(\\\"READ-ONLY INSPECTION COMPLETE\\\")\\n\",\"print(\\\"=\\\" * 75)\"],\"metadata\":{\"colab\":{\"base_uri\":\"https://localhost:8080/\"},\"id\":\"PAtKTLEzsP0t\",\"executionInfo\":{\"status\":\"ok\",\"timestamp\":1794351631109,\"user_tz\":360,\"elapsed\":504,\"user\":{\"displayName\":\"shaik moien\",\"userId\":\"11478993639750231898\"}},\"outputId\":\"f09ced82-cf24-4e1d-db0d-8b6e4be59ddc\"},\"execution_count\":null,\"outputs\":[{\"output_type\":\"stream\",\"name\":\"stdout\",\"text\":[\"===========================================================================\\n\",\"EXPERIMENT 20 — STEP 2.6.14: EXACT PIPELINE RECOVERY\\n\",\"===========================================================================\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 0\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"# Experiment 18: Genuine Face-Recognition Embedding Validation\\n\",\"\\n\",\"## 1. Research Background\\n\",\"\\n\",\"Previous experiments evaluated embedding-level drift detection using synthetic distributions and image-derived feature representations. However, generic image features do not necessarily represent the characteristics of genuine face-recognition systems.\\n\",\"\\n\",\"This experiment extends the existing research by evaluating embedding-level drift detection using a pretrained face-recognition model.\\n\",\"\\n\",\"## 2. Problem Statement\\n\",\"\\n\",\"The reliability of statistical drift detectors must be investigated using genuine face-recognition representations rather than relying exclusively on synthetic distributions or generic image features.\\n\",\"\\n\",\"## 3. Research Objective\\n\",\"\\n\",\"To evaluate the behaviour of embedding-level drift detectors using 512-dimensional face-recognition embeddings extracted with FaceNet pretrained on VGGFace2.\\n\",\"\\n\",\"## 4. Research Questions\\n\",\"\\n\",\"1. Can the existing embedding-level drift detection framework operate on genuine face-recognition embeddings?\\n\",\"2. How do controlled environmental changes affect the resulting face embeddings?\\n\",\"3. Can statistical detectors distinguish embedding distribution changes from stable operating conditions?\\n\",\"4. How reliably can false alarms and detection sensitivity be measured under independent evaluation?\\n\",\"\\n\",\"## 5. Research Hypotheses\\n\",\"\\n\",\"**H1:** Controlled changes in face-image acquisition conditions produce measurable changes in FaceNet embedding distributions.\\n\",\"\\n\",\"**H2:** Embedding-level statistical detectors can identify some of these distribution changes under independently calibrated thresholds.\\n\",\"\\n\",\"**H3:** Detection performance varies according to the type and magnitude of the environmental change.\\n\",\"\\n\",\"These hypotheses will be evaluated experimentally and will not be treated as established findings.\\n\",\"\\n\",\"## 6. Dataset and Model\\n\",\"\\n\",\"- Dataset: Labeled Faces in the Wild (LFW).\\n\",\"- Face detector and alignment: MTCNN.\\n\",\"- Face-recognition model: InceptionResnetV1.\\n\",\"- Pretrained weights: VGGFace2.\\n\",\"- Embedding dimension: 512.\\n\",\"- Framework: PyTorch and facenet-pytorch.\\n\",\"\\n\",\"## 7. Experimental Methodology\\n\",\"\\n\",\"The experiment will use identity-aware data partitioning, face detection and alignment, embedding extraction, independent threshold calibration, control evaluation and controlled drift evaluation.\\n\",\"\\n\",\"The precise partitioning protocol, environmental transformations, detector configurations and evaluation metrics will be finalised before generating the experimental dataset.\\n\",\"\\n\",\"## 8. Evaluation Metrics\\n\",\"\\n\",\"- False-alarm rate.\\n\",\"- Detection rate.\\n\",\"- Detection delay.\\n\",\"- Precision and recall where appropriate.\\n\",\"- Confidence intervals.\\n\",\"- Computational performance where applicable.\\n\",\"\\n\",\"## 9. Reproducibility\\n\",\"\\n\",\"The experiment will record model configuration, dataset provenance, random seeds, software versions, preprocessing settings and generated result artifacts.\\n\",\"\\n\",\"## 10. Scientific Scope and Limitations\\n\",\"\\n\",\"Successful embedding extraction does not establish face-recognition accuracy or reliable drift detection. This experiment evaluates representation-level distribution changes and detector behaviour. It does not independently establish biometric identification performance, fairness, security or deployment readiness.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 1\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 1 — Environment and Dependency Setup\\n\",\"\\n\",\"### Objective\\n\",\"Prepare the Google Colab environment and install the required FaceNet library for genuine face-recognition embedding extraction.\\n\",\"\\n\",\"### Software Requirements\\n\",\"- Python\\n\",\"- PyTorch\\n\",\"- Torchvision\\n\",\"- facenet-pytorch\\n\",\"- NumPy\\n\",\"- Pillow\\n\",\"\\n\",\"### Methodology\\n\",\"1. Inspect the existing Python and machine-learning environment.\\n\",\"2. Verify the installed PyTorch and Torchvision versions.\\n\",\"3. Install `facenet-pytorch` version 2.6.0.\\n\",\"4. Use the `--no-deps` installation option to avoid automatically modifying existing dependencies.\\n\",\"\\n\",\"### Installation Configuration\\n\",\"- Package: `facenet-pytorch`\\n\",\"- Version: 2.6.0\\n\",\"- Installation option: `--no-deps`\\n\",\"- Execution platform: Google Colab\\n\",\"\\n\",\"### Validation Criteria\\n\",\"- Successful package installation.\\n\",\"- Successful import of the required libraries.\\n\",\"- Compatibility of the installed libraries with the runtime.\\n\",\"\\n\",\"### Status\\n\",\"Successfully completed. Required dependencies installed and imported. Environment compatibility verified.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 3\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 2 — FaceNet Model Initialisation\\n\",\"\\n\",\"### Objective\\n\",\"Initialise the MTCNN face detector and pretrained FaceNet recognition model for extracting genuine facial embeddings.\\n\",\"\\n\",\"### Methodology\\n\",\"1. Import the required FaceNet components.\\n\",\"2. Initialise MTCNN for face detection and alignment.\\n\",\"3. Load InceptionResnetV1 with VGGFace2 pretrained weights.\\n\",\"4. Configure the model for evaluation.\\n\",\"5. Verify the expected embedding dimension.\\n\",\"\\n\",\"### Model Configuration\\n\",\"- Face detector: MTCNN\\n\",\"- Recognition model: InceptionResnetV1\\n\",\"- Pretrained weights: VGGFace2\\n\",\"- Expected embedding dimension: 512\\n\",\"- Execution device: CPU\\n\",\"\\n\",\"### Validation Criteria\\n\",\"- Successful MTCNN initialisation.\\n\",\"- Successful FaceNet model loading.\\n\",\"- Confirmation of the 512-dimensional embedding output.\\n\",\"\\n\",\"### Status\\n\",\"Successfully completed. MTCNN face detection and alignment were initialised, the pretrained InceptionResnetV1 model with VGGFace2 weights was loaded, and the model was configured for evaluation. The expected 512-dimensional embedding configuration was verified.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 4\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['MTCNN(', 'InceptionResnetV1(', 'mtcnn(', 'embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"import torch\\n\",\"import torchvision\\n\",\"from facenet_pytorch import MTCNN, InceptionResnetV1\\n\",\"\\n\",\"# Configure execution device\\n\",\"device = torch.device(\\\"cpu\\\")\\n\",\"\\n\",\"# Initialise MTCNN face detector\\n\",\"mtcnn = MTCNN(\\n\",\"    image_size=160,\\n\",\"    margin=0,\\n\",\"    keep_all=False,\\n\",\"    device=device\\n\",\")\\n\",\"\\n\",\"# Load pretrained FaceNet model\\n\",\"facenet = InceptionResnetV1(\\n\",\"    pretrained=\\\"vggface2\\\"\\n\",\").eval().to(device)\\n\",\"\\n\",\"# Verify model configuration\\n\",\"print(\\\"MTCNN initialised successfully.\\\")\\n\",\"print(\\\"FaceNet model initialised successfully.\\\")\\n\",\"print(\\\"Pretrained weights: VGGFace2\\\")\\n\",\"print(\\\"Execution device:\\\", device)\\n\",\"print(\\\"Embedding dimension:\\\", facenet.last_linear.out_features)\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 5\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 3 — Sample Image Face Detection and Embedding Extraction\\n\",\"\\n\",\"### Objective\\n\",\"Validate the complete face-processing pipeline using a real sample face image.\\n\",\"\\n\",\"### Methodology\\n\",\"1. Retrieve a sample face image.\\n\",\"2. Load the image using the PIL library.\\n\",\"3. Apply MTCNN for face detection and alignment.\\n\",\"4. Pass the aligned face through the pretrained FaceNet model.\\n\",\"5. Extract the 512-dimensional facial embedding.\\n\",\"6. Validate the embedding shape, numerical values and L2 norm.\\n\",\"\\n\",\"### Validation Criteria\\n\",\"- Successful image loading.\\n\",\"- Successful face detection.\\n\",\"- Successful facial embedding extraction.\\n\",\"- Expected embedding shape of (1, 512).\\n\",\"- All embedding values must be finite.\\n\",\"- L2-normalised embedding norm should be approximately 1.0.\\n\",\"\\n\",\"### Scientific Limitation\\n\",\"This sample test validates the technical extraction pipeline only. It does not establish biometric recognition accuracy, identity verification performance or drift detection effectiveness.\\n\",\"\\n\",\"### Status\\n\",\"Successfully completed. The sample face image was downloaded and loaded, MTCNN successfully detected and aligned the face, and the pretrained FaceNet model generated a 512-dimensional embedding. Numerical validation confirmed that all embedding values were finite and the L2 norm was 1.0.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 6\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['MTCNN(', 'mtcnn(', 'facenet(', 'torch.no_grad', 'embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"import requests\\n\",\"from PIL import Image\\n\",\"from io import BytesIO\\n\",\"import torch\\n\",\"import numpy as np\\n\",\"\\n\",\"# Sample face image from the GitHub repository\\n\",\"image_url = \\\"https://raw.githubusercontent.com/12998951/Real-Time-Embedding-Level-Drift-Detection/main/embeddings/face/sample_face.jpg\\\"\\n\",\"\\n\",\"# Download and load image\\n\",\"response = requests.get(image_url, timeout=30)\\n\",\"response.raise_for_status()\\n\",\"\\n\",\"image = Image.open(BytesIO(response.content)).convert(\\\"RGB\\\")\\n\",\"\\n\",\"print(\\\"Image size:\\\", image.size)\\n\",\"\\n\",\"# Detect and align face\\n\",\"face_tensor = mtcnn(image)\\n\",\"\\n\",\"if face_tensor is None:\\n\",\"    raise ValueError(\\\"No face detected in the sample image.\\\")\\n\",\"\\n\",\"# Extract FaceNet embedding\\n\",\"face_tensor = face_tensor.unsqueeze(0).to(device)\\n\",\"\\n\",\"with torch.no_grad():\\n\",\"    embedding = facenet(face_tensor)\\n\",\"\\n\",\"# Validate embedding\\n\",\"embedding_np = embedding.cpu().numpy()\\n\",\"\\n\",\"print(\\\"Face detected successfully.\\\")\\n\",\"print(\\\"Embedding shape:\\\", embedding_np.shape)\\n\",\"print(\\\"All values finite:\\\", np.isfinite(embedding_np).all())\\n\",\"print(\\\"Embedding norm:\\\", np.linalg.norm(embedding_np))\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 9\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 5 — LFW Dataset Download\\n\",\"\\n\",\"### Objective\\n\",\"Obtain the Labeled Faces in the Wild (LFW) dataset for evaluating FaceNet embeddings under genuine facial-image conditions.\\n\",\"\\n\",\"### Dataset Description\\n\",\"LFW is a publicly available face-image dataset containing images of individuals collected under unconstrained conditions.\\n\",\"\\n\",\"### Methodology\\n\",\"1. Download the LFW dataset using the official scikit-learn dataset interface.\\n\",\"2. Store the downloaded dataset in the Colab environment.\\n\",\"3. Inspect the available images and identity labels.\\n\",\"4. Record the dataset size and identity distribution.\\n\",\"\\n\",\"### Validation Criteria\\n\",\"- Successful dataset download.\\n\",\"- Availability of facial images and identity labels.\\n\",\"- Verification of the number of images and unique identities.\\n\",\"\\n\",\"### Status\\n\",\"\\n\",\"Successfully completed. The Labeled Faces in the Wild (LFW) dataset was downloaded using the official scikit-learn dataset interface. The dataset contains 3,023 facial images from 62 identities, with an image resolution of 125 × 94 pixels and three RGB channels. Image data and identity labels were successfully loaded.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 15\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 8 — Face Alignment and Embedding Extraction\\n\",\"\\n\",\"### Objective\\n\",\"Extract genuine 512-dimensional facial embeddings from the LFW dataset using the pretrained FaceNet model.\\n\",\"\\n\",\"### Methodology\\n\",\"1. Process reference, calibration and evaluation images separately.\\n\",\"2. Apply MTCNN for face detection and alignment.\\n\",\"3. Generate facial embeddings using InceptionResnetV1 pretrained on VGGFace2.\\n\",\"4. Preserve the corresponding identity labels and partition assignments.\\n\",\"5. Record images for which face detection fails.\\n\",\"6. Validate embedding dimensions and numerical integrity.\\n\",\"\\n\",\"### Embedding Configuration\\n\",\"- Recognition model: InceptionResnetV1.\\n\",\"- Pretrained weights: VGGFace2.\\n\",\"- Input face resolution: 160 × 160.\\n\",\"- Embedding dimension: 512.\\n\",\"- Normalisation: L2-normalised FaceNet embeddings.\\n\",\"- Execution device: CPU.\\n\",\"\\n\",\"### Validation Criteria\\n\",\"- Successful embedding extraction.\\n\",\"- Consistent 512-dimensional output.\\n\",\"- Finite embedding values.\\n\",\"- Recorded face-detection failures.\\n\",\"- Preservation of identity and partition information.\\n\",\"\\n\",\"### Scientific Scope\\n\",\"This stage generates face-recognition representations. It does not independently measure recognition accuracy or establish drift detection performance.\\n\",\"\\n\",\"### Status\\n\",\"Successfully completed after recovery. MTCNN was used to detect and align faces, and the pretrained InceptionResnetV1 model (VGGFace2) generated 512-dimensional, L2-normalised embeddings.\\n\",\"\\n\",\"Reference partition: 1,460 successful embeddings and 17 failed face detections.\\n\",\"Calibration partition: 568 successful embeddings and 10 failed face detections.\\n\",\"Evaluation partition: 956 successful embeddings and 12 failed face detections.\\n\",\"\\n\",\"The initial evaluation extraction was interrupted during CPU-based processing. It was subsequently resumed and completed successfully. Face-detection failures were recorded for each partition.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 16\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['MTCNN(', 'mtcnn(', 'facenet(', 'torch.no_grad', 'embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"import torch\\n\",\"from tqdm.auto import tqdm\\n\",\"\\n\",\"def extract_embeddings(indices, partition_name):\\n\",\"    embeddings = []\\n\",\"    labels = []\\n\",\"    failed_indices = []\\n\",\"\\n\",\"    for idx in tqdm(indices, desc=f\\\"Processing {partition_name}\\\"):\\n\",\"\\n\",\"        # Convert image to PIL RGB format\\n\",\"        image_array = lfw_dataset.images[idx]\\n\",\"        image = Image.fromarray(\\n\",\"            np.clip(image_array * 255, 0, 255).astype(np.uint8)\\n\",\"        )\\n\",\"\\n\",\"        # Detect and align face\\n\",\"        face_tensor = mtcnn(image)\\n\",\"\\n\",\"        if face_tensor is None:\\n\",\"            failed_indices.append(idx)\\n\",\"            continue\\n\",\"\\n\",\"        # Extract FaceNet embedding\\n\",\"        face_tensor = face_tensor.unsqueeze(0).to(device)\\n\",\"\\n\",\"        with torch.no_grad():\\n\",\"            embedding = facenet(face_tensor)\\n\",\"\\n\",\"        embedding_np = embedding.cpu().numpy()[0]\\n\",\"\\n\",\"        embeddings.append(embedding_np)\\n\",\"        labels.append(lfw_dataset.target[idx])\\n\",\"\\n\",\"    if embeddings:\\n\",\"        embeddings = np.asarray(embeddings, dtype=np.float32)\\n\",\"        labels = np.asarray(labels)\\n\",\"    else:\\n\",\"        embeddings = np.empty((0, 512), dtype=np.float32)\\n\",\"        labels = np.empty((0,), dtype=int)\\n\",\"\\n\",\"    print(f\\\"\\\\n{partition_name} results:\\\")\\n\",\"    print(\\\"Successful embeddings:\\\", len(embeddings))\\n\",\"    print(\\\"Failed face detections:\\\", len(failed_indices))\\n\",\"\\n\",\"    return embeddings, labels, failed_indices\\n\",\"\\n\",\"\\n\",\"# Extract embeddings separately\\n\",\"reference_embeddings, reference_labels, reference_failures = (\\n\",\"    extract_embeddings(reference_indices, \\\"Reference\\\")\\n\",\")\\n\",\"\\n\",\"calibration_embeddings, calibration_labels, calibration_failures = (\\n\",\"    extract_embeddings(calibration_indices, \\\"Calibration\\\")\\n\",\")\\n\",\"\\n\",\"evaluation_embeddings, evaluation_labels, evaluation_failures = (\\n\",\"    extract_embeddings(evaluation_indices, \\\"Evaluation\\\")\\n\",\")\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 17\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"### Execution Issue — Interrupted Evaluation Embedding Extraction\\n\",\"\\n\",\"**Observed Error:** `KeyboardInterrupt`\\n\",\"\\n\",\"#### Description\\n\",\"The embedding extraction process was manually interrupted during the evaluation partition while the FaceNet model was performing CPU-based inference.\\n\",\"\\n\",\"#### Results Before Interruption\\n\",\"\\n\",\"| Partition | Images processed | Successful embeddings | Failed detections |\\n\",\"|---|---:|---:|---:|\\n\",\"| Reference | 1,477 | 1,460 | 17 |\\n\",\"| Calibration | 578 | 568 | 10 |\\n\",\"| Evaluation | 367 of 968 | Incomplete | Incomplete |\\n\",\"\\n\",\"#### Cause\\n\",\"The evaluation partition required additional CPU processing time. Execution was interrupted before the partition could be completed.\\n\",\"\\n\",\"#### Impact\\n\",\"- Reference embeddings were successfully extracted.\\n\",\"- Calibration embeddings were successfully extracted.\\n\",\"- Evaluation embeddings remain incomplete.\\n\",\"- Complete three-partition validation cannot yet be performed.\\n\",\"\\n\",\"#### Corrective Action\\n\",\"Resume evaluation embedding extraction without repeating the completed reference and calibration partitions.\\n\",\"\\n\",\"#### Status\\n\",\"**Partially completed — corrective action pending.**\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 18\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"# Resume evaluation embedding extraction only\\n\",\"\\n\",\"evaluation_embeddings, evaluation_labels, evaluation_failures = (\\n\",\"    extract_embeddings(evaluation_indices, \\\"Evaluation\\\")\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\nEvaluation extraction completed.\\\")\\n\",\"print(\\\"Successful embeddings:\\\", len(evaluation_embeddings))\\n\",\"print(\\\"Failed face detections:\\\", len(evaluation_failures))\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 19\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 9 — Embedding Quality and Integrity Validation\\n\",\"\\n\",\"### Objective\\n\",\"Validate the quality and numerical integrity of the extracted FaceNet embeddings across all three dataset partitions.\\n\",\"\\n\",\"### Methodology\\n\",\"1. Verify the dimensions of each embedding matrix.\\n\",\"2. Check for NaN and infinite values.\\n\",\"3. Calculate the L2 norm of each embedding.\\n\",\"4. Verify embedding-label alignment.\\n\",\"5. Confirm that all embeddings contain 512 features.\\n\",\"\\n\",\"### Validation Criteria\\n\",\"- Consistent embedding dimensions.\\n\",\"- No NaN or infinite values.\\n\",\"- L2 norms approximately equal to 1.0.\\n\",\"- Matching numbers of embeddings and identity labels.\\n\",\"- No empty embedding partitions.\\n\",\"\\n\",\"### Status\\n\",\"Successfully completed. Embedding quality and numerical integrity were validated across all three partitions.\\n\",\"\\n\",\"Reference: (1,460, 512)\\n\",\"Calibration: (568, 512)\\n\",\"Evaluation: (956, 512)\\n\",\"\\n\",\"All embedding matrices contain 512 features. All values are finite, embedding counts match their corresponding identity-label counts, and all L2 norms are approximately 1.0. The minimum and maximum observed norms were 0.9999999 and 1.0000001, respectively.\\n\",\"\\n\",\"All embedding integrity checks passed.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 20\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"import numpy as np\\n\",\"\\n\",\"partitions = {\\n\",\"    \\\"Reference\\\": (reference_embeddings, reference_labels),\\n\",\"    \\\"Calibration\\\": (calibration_embeddings, calibration_labels),\\n\",\"    \\\"Evaluation\\\": (evaluation_embeddings, evaluation_labels)\\n\",\"}\\n\",\"\\n\",\"for name, (embeddings, labels) in partitions.items():\\n\",\"\\n\",\"    norms = np.linalg.norm(embeddings, axis=1)\\n\",\"\\n\",\"    print(f\\\"\\\\n{name} partition\\\")\\n\",\"    print(\\\"-\\\" * 40)\\n\",\"    print(\\\"Embedding shape:\\\", embeddings.shape)\\n\",\"    print(\\\"Label shape:\\\", labels.shape)\\n\",\"    print(\\\"All values finite:\\\", np.isfinite(embeddings).all())\\n\",\"    print(\\\"Embedding-label alignment:\\\", len(embeddings) == len(labels))\\n\",\"    print(\\\"Mean L2 norm:\\\", norms.mean())\\n\",\"    print(\\\"Minimum L2 norm:\\\", norms.min())\\n\",\"    print(\\\"Maximum L2 norm:\\\", norms.max())\\n\",\"\\n\",\"    assert embeddings.shape[1] == 512\\n\",\"    assert len(embeddings) == len(labels)\\n\",\"    assert np.isfinite(embeddings).all()\\n\",\"    assert np.allclose(norms, 1.0, atol=1e-4)\\n\",\"\\n\",\"print(\\\"\\\\nAll embedding integrity checks passed.\\\")\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 21\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 10 — Embedding Storage and Experiment Reproducibility\\n\",\"\\n\",\"### Objective\\n\",\"Save the extracted FaceNet embeddings, identity labels, partition information and failed detection indices for reproducibility and subsequent analysis.\\n\",\"\\n\",\"### Methodology\\n\",\"1. Store reference embeddings and labels.\\n\",\"2. Store calibration embeddings and labels.\\n\",\"3. Store evaluation embeddings and labels.\\n\",\"4. Record failed face-detection indices.\\n\",\"5. Save the experimental configuration and dataset metadata.\\n\",\"6. Export the results as a compressed NumPy archive.\\n\",\"\\n\",\"### Validation Criteria\\n\",\"- Successful creation of the output archive.\\n\",\"- Preservation of all embedding matrices and labels.\\n\",\"- Preservation of failed detection records.\\n\",\"- Verification of the saved archive contents.\\n\",\"\\n\",\"### Status\\n\",\"Successfully completed. The extracted FaceNet embeddings, identity labels, failed face-detection indices, and experimental configuration were saved in a compressed NumPy archive.\\n\",\"\\n\",\"Archive: experiment18_facenet_lfw_embeddings.npz\\n\",\"Location: /content/experiment18_results/\\n\",\"File size: 5.41 MB\\n\",\"\\n\",\"The saved archive was reopened and its contents verified. It contains the reference, calibration, and evaluation embeddings and labels, along with the corresponding failed detection indices and experiment metadata.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 22\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"import numpy as np\\n\",\"import json\\n\",\"from pathlib import Path\\n\",\"\\n\",\"output_dir = Path(\\\"/content/experiment18_results\\\")\\n\",\"output_dir.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"archive_path = output_dir / \\\"experiment18_facenet_lfw_embeddings.npz\\\"\\n\",\"\\n\",\"np.savez_compressed(\\n\",\"    archive_path,\\n\",\"\\n\",\"    reference_embeddings=reference_embeddings,\\n\",\"    reference_labels=reference_labels,\\n\",\"\\n\",\"    calibration_embeddings=calibration_embeddings,\\n\",\"    calibration_labels=calibration_labels,\\n\",\"\\n\",\"    evaluation_embeddings=evaluation_embeddings,\\n\",\"    evaluation_labels=evaluation_labels,\\n\",\"\\n\",\"    reference_failures=np.array(reference_failures),\\n\",\"    calibration_failures=np.array(calibration_failures),\\n\",\"    evaluation_failures=np.array(evaluation_failures),\\n\",\"\\n\",\"    random_seed=np.array(42),\\n\",\"    model=np.array(\\\"InceptionResnetV1\\\"),\\n\",\"    pretrained_weights=np.array(\\\"VGGFace2\\\"),\\n\",\"    dataset=np.array(\\\"LFW\\\"),\\n\",\"    embedding_dimension=np.array(512)\\n\",\")\\n\",\"\\n\",\"print(\\\"Archive saved:\\\", archive_path)\\n\",\"print(\\\"File size (MB):\\\", round(archive_path.stat().st_size / (1024**2), 2))\\n\",\"\\n\",\"# Verify archive\\n\",\"with np.load(archive_path) as saved:\\n\",\"    print(\\\"\\\\nSaved archive contents:\\\")\\n\",\"    for key in saved.files:\\n\",\"        print(key, saved[key].shape)\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 23\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 11 — Persistent Storage and Backup\\n\",\"\\n\",\"### Objective\\n\",\"Create a persistent backup of the extracted FaceNet embeddings and experimental metadata.\\n\",\"\\n\",\"### Methodology\\n\",\"1. Connect Google Drive.\\n\",\"2. Create a dedicated Experiment 18 results directory.\\n\",\"3. Copy the verified compressed embedding archive.\\n\",\"4. Confirm that the backup exists and has the expected file size.\\n\",\"\\n\",\"### Validation Criteria\\n\",\"- Successful Google Drive connection.\\n\",\"- Successful archive transfer.\\n\",\"- Verification of the persistent backup.\\n\",\"\\n\",\"### Status\\n\",\"\\n\",\"Successfully completed. Google Drive was mounted and a dedicated Experiment 18 results directory was created. The verified FaceNet embedding archive was copied to persistent storage.\\n\",\"\\n\",\"Backup location: /content/drive/MyDrive/Experiment_18_Results/experiment18_facenet_lfw_embeddings.npz\\n\",\"\\n\",\"Backup verification confirmed that the file exists and has the expected size of 5.41 MB.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 25\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"from google.colab import drive\\n\",\"from pathlib import Path\\n\",\"import shutil\\n\",\"\\n\",\"# Connect Google Drive\\n\",\"drive.mount(\\\"/content/drive\\\")\\n\",\"\\n\",\"# Create persistent backup directory\\n\",\"backup_dir = Path(\\n\",\"    \\\"/content/drive/MyDrive/Experiment_18_Results\\\"\\n\",\")\\n\",\"backup_dir.mkdir(parents=True, exist_ok=True)\\n\",\"\\n\",\"# Copy verified archive\\n\",\"source = Path(\\n\",\"    \\\"/content/experiment18_results/experiment18_facenet_lfw_embeddings.npz\\\"\\n\",\")\\n\",\"\\n\",\"destination = backup_dir / source.name\\n\",\"\\n\",\"shutil.copy2(source, destination)\\n\",\"\\n\",\"# Verify backup\\n\",\"print(\\\"Backup created:\\\", destination.exists())\\n\",\"print(\\\"Backup location:\\\", destination)\\n\",\"print(\\\"Backup size (MB):\\\", round(destination.stat().st_size / (1024**2), 2))\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 26\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 12 — Baseline Embedding Distribution Analysis\\n\",\"\\n\",\"### Objective\\n\",\"Characterise the statistical properties of the extracted FaceNet embeddings under the baseline LFW conditions before conducting controlled drift experiments.\\n\",\"\\n\",\"### Research Purpose\\n\",\"Establish reference distribution characteristics that can later be used to evaluate embedding-level distribution changes.\\n\",\"\\n\",\"### Methodology\\n\",\"1. Load the saved FaceNet embedding archive.\\n\",\"2. Calculate the mean and standard deviation of each embedding dimension.\\n\",\"3. Measure the variance across the 512 embedding dimensions.\\n\",\"4. Calculate the distribution of embedding L2 norms.\\n\",\"5. Examine pairwise\\n\",\"\\n\",\"### Status\\n\",\"\\n\",\"Successfully completed. The saved Experiment 18 embedding archive was loaded successfully. Baseline statistical characteristics were calculated for the reference, calibration, and evaluation partitions.\\n\",\"\\n\",\"For each partition, the analysis calculated the mean, standard deviation, and variance across the 512 embedding dimensions, together with the distribution of embedding L2 norms.\\n\",\"\\n\",\"The resulting baseline summary was generated successfully for all three partitions. The mean L2 norm was 1.0 across all partitions.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 27\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"import numpy as np\\n\",\"from pathlib import Path\\n\",\"\\n\",\"# Load persistent experiment archive\\n\",\"archive_path = Path(\\n\",\"    \\\"/content/drive/MyDrive/Experiment_18_Results/\\\"\\n\",\"    \\\"experiment18_facenet_lfw_embeddings.npz\\\"\\n\",\")\\n\",\"\\n\",\"with np.load(archive_path) as data:\\n\",\"    reference_embeddings = data[\\\"reference_embeddings\\\"].copy()\\n\",\"    calibration_embeddings = data[\\\"calibration_embeddings\\\"].copy()\\n\",\"    evaluation_embeddings = data[\\\"evaluation_embeddings\\\"].copy()\\n\",\"\\n\",\"    reference_labels = data[\\\"reference_labels\\\"].copy()\\n\",\"    calibration_labels = data[\\\"calibration_labels\\\"].copy()\\n\",\"    evaluation_labels = data[\\\"evaluation_labels\\\"].copy()\\n\",\"\\n\",\"print(\\\"Experiment 18 archive loaded successfully.\\\")\\n\",\"\\n\",\"print(\\\"Reference:\\\", reference_embeddings.shape)\\n\",\"print(\\\"Calibration:\\\", calibration_embeddings.shape)\\n\",\"print(\\\"Evaluation:\\\", evaluation_embeddings.shape)\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 28\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"\\n\",\"partitions = {\\n\",\"    \\\"Reference\\\": reference_embeddings,\\n\",\"    \\\"Calibration\\\": calibration_embeddings,\\n\",\"    \\\"Evaluation\\\": evaluation_embeddings\\n\",\"}\\n\",\"\\n\",\"baseline_results = []\\n\",\"\\n\",\"for name, embeddings in partitions.items():\\n\",\"\\n\",\"    dimension_means = np.mean(embeddings, axis=0)\\n\",\"    dimension_stds = np.std(embeddings, axis=0)\\n\",\"    dimension_variances = np.var(embeddings, axis=0)\\n\",\"    embedding_norms = np.linalg.norm(embeddings, axis=1)\\n\",\"\\n\",\"    baseline_results.append({\\n\",\"        \\\"Partition\\\": name,\\n\",\"        \\\"Samples\\\": len(embeddings),\\n\",\"        \\\"Features\\\": embeddings.shape[1],\\n\",\"        \\\"Mean_of_dimension_means\\\": dimension_means.mean(),\\n\",\"        \\\"Mean_of_dimension_stds\\\": dimension_stds.mean(),\\n\",\"        \\\"Mean_of_dimension_variances\\\": dimension_variances.mean(),\\n\",\"        \\\"Mean_L2_norm\\\": embedding_norms.mean(),\\n\",\"        \\\"Minimum_L2_norm\\\": embedding_norms.min(),\\n\",\"        \\\"Maximum_L2_norm\\\": embedding_norms.max()\\n\",\"    })\\n\",\"\\n\",\"baseline_summary = pd.DataFrame(baseline_results)\\n\",\"\\n\",\"print(\\\"Baseline Embedding Statistical Summary\\\")\\n\",\"display(baseline_summary.round(6))\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 29\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 12.2 — Pairwise Cosine Similarity Analysis\\n\",\"\\n\",\"### Objective\\n\",\"Characterise the pairwise cosine similarity distribution of FaceNet embeddings within each dataset partition.\\n\",\"\\n\",\"### Methodology\\n\",\"1. Calculate pairwise cosine similarities within the reference partition.\\n\",\"2. Repeat the calculation for calibration and evaluation partitions.\\n\",\"3. Exclude self-similarity values from the analysis.\\n\",\"4. Calculate the mean, standard deviation, minimum, maximum and median cosine similarity.\\n\",\"5. Compare the resulting similarity distributions.\\n\",\"\\n\",\"### Evaluation Metrics\\n\",\"- Mean cosine similarity.\\n\",\"- Standard deviation.\\n\",\"- Median cosine similarity.\\n\",\"- Minimum cosine similarity.\\n\",\"- Maximum cosine similarity.\\n\",\"\\n\",\"### Scientific Consideration\\n\",\"The analysis describes embedding similarity, not biometric verification accuracy. Similarity values between different identities must not be interpreted as identity verification results.\\n\",\"\\n\",\"### Status\\n\",\"\\n\",\"Successfully completed. Pairwise cosine similarity was calculated independently for the reference, calibration, and evaluation embedding partitions. Self-similarity values were excluded from the analysis.\\n\",\"\\n\",\"The resulting summary includes the number of image pairs, mean, standard deviation, median, minimum, and maximum cosine similarity for each partition.\\n\",\"\\n\",\"Reference: 1,065,070 pairs; mean similarity 0.097840.\\n\",\"Calibration: 161,028 pairs; mean similarity 0.245595.\\n\",\"Evaluation: 456,490 pairs; mean similarity 0.312916.\\n\",\"\\n\",\"The pairwise similarity summary was generated successfully. These results describe embedding similarity and should not be interpreted as biometric verification accuracy.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 30\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"from sklearn.metrics.pairwise import cosine_similarity\\n\",\"\\n\",\"partitions = {\\n\",\"    \\\"Reference\\\": reference_embeddings,\\n\",\"    \\\"Calibration\\\": calibration_embeddings,\\n\",\"    \\\"Evaluation\\\": evaluation_embeddings\\n\",\"}\\n\",\"\\n\",\"similarity_results = []\\n\",\"\\n\",\"for name, embeddings in partitions.items():\\n\",\"\\n\",\"    # Calculate pairwise cosine similarities\\n\",\"    similarity_matrix = cosine_similarity(embeddings)\\n\",\"\\n\",\"    # Exclude diagonal self-similarity values\\n\",\"    upper_indices = np.triu_indices(\\n\",\"        len(embeddings), k=1\\n\",\"    )\\n\",\"\\n\",\"    similarities = similarity_matrix[upper_indices]\\n\",\"\\n\",\"    similarity_results.append({\\n\",\"        \\\"Partition\\\": name,\\n\",\"        \\\"Number_of_pairs\\\": len(similarities),\\n\",\"        \\\"Mean_similarity\\\": similarities.mean(),\\n\",\"        \\\"Std_similarity\\\": similarities.std(),\\n\",\"        \\\"Median_similarity\\\": np.median(similarities),\\n\",\"        \\\"Minimum_similarity\\\": similarities.min(),\\n\",\"        \\\"Maximum_similarity\\\": similarities.max()\\n\",\"    })\\n\",\"\\n\",\"similarity_summary = pd.DataFrame(similarity_results)\\n\",\"\\n\",\"print(\\\"Pairwise Cosine Similarity Summary\\\")\\n\",\"display(similarity_summary.round(6))\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 31\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 12.3 — Same-Identity and Different-Identity Similarity Analysis\\n\",\"\\n\",\"### Objective\\n\",\"Investigate the cosine similarity distributions of FaceNet embeddings by distinguishing pairs belonging to the same individual from pairs belonging to different individuals.\\n\",\"\\n\",\"### Research Purpose\\n\",\"Determine how the extracted facial representations behave across genuine same-identity pairs and different-identity pairs.\\n\",\"\\n\",\"### Methodology\\n\",\"1. Use the identity labels associated with each embedding partition.\\n\",\"2. Generate same-identity image pairs.\\n\",\"3. Generate different-identity image pairs.\\n\",\"4. Calculate cosine similarity for both pair categories.\\n\",\"5. Use identity-balanced random sampling to reduce the influence of identities with larger image counts.\\n\",\"6. Compare the resulting similarity distributions.\\n\",\"\\n\",\"### Evaluation Metrics\\n\",\"- Mean cosine similarity.\\n\",\"- Median cosine similarity.\\n\",\"- Standard deviation.\\n\",\"- Minimum and maximum similarity.\\n\",\"- Number of sampled pairs.\\n\",\"\\n\",\"### Scientific Consideration\\n\",\"This analysis measures embedding similarity using known dataset identity labels. It is not a formal biometric verification evaluation and does not establish a recognition threshold or verification accuracy.\\n\",\"\\n\",\"### Reproducibility\\n\",\"Random seed: 2026.\\n\",\"\\n\",\"### Status\\n\",\"\\n\",\"Successfully completed. Identity-balanced cosine similarity analysis was performed separately for the reference, calibration, and evaluation partitions.\\n\",\"\\n\",\"For each partition, 50,000 same-identity pairs and 50,000 different-identity pairs were sampled using random seed 2026. Mean, median, and standard deviation were calculated for both pair categories.\\n\",\"\\n\",\"The resulting identity-balanced similarity summary was generated successfully across all three partitions.\\n\",\"\\n\",\"This analysis is descriptive and does not establish biometric verification accuracy, a recognition threshold, or verification performance.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 32\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"\\n\",\"RANDOM_SEED = 2026\\n\",\"N_PAIRS = 50000\\n\",\"\\n\",\"def analyse_identity_similarity(embeddings, labels, partition_name):\\n\",\"\\n\",\"    rng = np.random.default_rng(RANDOM_SEED)\\n\",\"\\n\",\"    identities = np.unique(labels)\\n\",\"\\n\",\"    identity_indices = {\\n\",\"        identity: np.where(labels == identity)[0]\\n\",\"        for identity in identities\\n\",\"    }\\n\",\"\\n\",\"    eligible = [\\n\",\"        identity for identity in identities\\n\",\"        if len(identity_indices[identity]) >= 2\\n\",\"    ]\\n\",\"\\n\",\"    if len(eligible) < 2:\\n\",\"        raise ValueError(\\\"Insufficient identities for pair analysis.\\\")\\n\",\"\\n\",\"    same_similarities = []\\n\",\"    different_similarities = []\\n\",\"\\n\",\"    # Same-identity pairs: identities selected uniformly\\n\",\"    for _ in range(N_PAIRS):\\n\",\"\\n\",\"        identity = rng.choice(eligible)\\n\",\"        indices = identity_indices[identity]\\n\",\"\\n\",\"        pair = rng.choice(indices, size=2, replace=False)\\n\",\"\\n\",\"        similarity = np.dot(\\n\",\"            embeddings[pair[0]],\\n\",\"            embeddings[pair[1]]\\n\",\"        )\\n\",\"\\n\",\"        same_similarities.append(similarity)\\n\",\"\\n\",\"    # Different-identity pairs: two identities selected uniformly\\n\",\"    for _ in range(N_PAIRS):\\n\",\"\\n\",\"        selected_ids = rng.choice(\\n\",\"            identities, size=2, replace=False\\n\",\"        )\\n\",\"\\n\",\"        idx1 = rng.choice(identity_indices[selected_ids[0]])\\n\",\"        idx2 = rng.choice(identity_indices[selected_ids[1]])\\n\",\"\\n\",\"        similarity = np.dot(\\n\",\"            embeddings[idx1],\\n\",\"            embeddings[idx2]\\n\",\"        )\\n\",\"\\n\",\"        different_similarities.append(similarity)\\n\",\"\\n\",\"    return {\\n\",\"        \\\"Partition\\\": partition_name,\\n\",\"        \\\"Same_identity_mean\\\": np.mean(same_similarities),\\n\",\"        \\\"Same_identity_median\\\": np.median(same_similarities),\\n\",\"        \\\"Same_identity_std\\\": np.std(same_similarities),\\n\",\"        \\\"Different_identity_mean\\\": np.mean(different_similarities),\\n\",\"        \\\"Different_identity_median\\\": np.median(different_similarities),\\n\",\"        \\\"Different_identity_std\\\": np.std(different_similarities),\\n\",\"        \\\"Same_identity_pairs\\\": len(same_similarities),\\n\",\"        \\\"Different_identity_pairs\\\": len(different_similarities)\\n\",\"    }\\n\",\"\\n\",\"\\n\",\"results = []\\n\",\"\\n\",\"results.append(\\n\",\"    analyse_identity_similarity(\\n\",\"        reference_embeddings,\\n\",\"        reference_labels,\\n\",\"        \\\"Reference\\\"\\n\",\"    )\\n\",\")\\n\",\"\\n\",\"results.append(\\n\",\"    analyse_identity_similarity(\\n\",\"        calibration_embeddings,\\n\",\"        calibration_labels,\\n\",\"        \\\"Calibration\\\"\\n\",\"    )\\n\",\")\\n\",\"\\n\",\"results.append(\\n\",\"    analyse_identity_similarity(\\n\",\"        evaluation_embeddings,\\n\",\"        evaluation_labels,\\n\",\"        \\\"Evaluation\\\"\\n\",\"    )\\n\",\")\\n\",\"\\n\",\"identity_similarity_summary = pd.DataFrame(results)\\n\",\"\\n\",\"print(\\\"Identity-Balanced Cosine Similarity Analysis\\\")\\n\",\"display(identity_similarity_summary.round(6))\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 33\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 12.4 — Visualisation of Identity Similarity Distributions\\n\",\"\\n\",\"### Objective\\n\",\"Visually examine the cosine similarity distributions of same-identity and different-identity face embedding pairs.\\n\",\"\\n\",\"### Methodology\\n\",\"1. Generate identity-balanced same-identity and different-identity pairs.\\n\",\"2. Calculate cosine similarity distributions.\\n\",\"3. Plot the distributions for each dataset partition.\\n\",\"4. Examine distribution overlap and separation.\\n\",\"\\n\",\"### Research Purpose\\n\",\"Identify the degree of similarity separation between genuine same-identity pairs and different-identity pairs across the reference, calibration and evaluation partitions.\\n\",\"\\n\",\"### Scientific Limitation\\n\",\"Distribution visualisation is descriptive. It does not independently establish biometric verification accuracy or a validated decision threshold.\\n\",\"\\n\",\"### Status\\n\",\"\\n\",\"Successfully completed. Identity-balanced cosine similarity analysis was performed separately for the reference, calibration, and evaluation partitions.\\n\",\"\\n\",\"For each partition, 50,000 same-identity pairs and 50,000 different-identity pairs were sampled using random seed 2026. Mean, median, and standard deviation were calculated for both pair categories.\\n\",\"\\n\",\"The resulting identity-balanced similarity summary was generated successfully across all three partitions.\\n\",\"\\n\",\"This analysis is descriptive and does not establish biometric verification accuracy, a recognition threshold, or verification performance.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 34\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"import matplotlib.pyplot as plt\\n\",\"import numpy as np\\n\",\"\\n\",\"partitions = {\\n\",\"    \\\"Reference\\\": (reference_embeddings, reference_labels),\\n\",\"    \\\"Calibration\\\": (calibration_embeddings, calibration_labels),\\n\",\"    \\\"Evaluation\\\": (evaluation_embeddings, evaluation_labels)\\n\",\"}\\n\",\"\\n\",\"fig, axes = plt.subplots(1, 3, figsize=(18, 5))\\n\",\"\\n\",\"for ax, (name, (embeddings, labels)) in zip(axes, partitions.items()):\\n\",\"\\n\",\"    rng = np.random.default_rng(2026)\\n\",\"    identities = np.unique(labels)\\n\",\"\\n\",\"    identity_indices = {\\n\",\"        identity: np.where(labels == identity)[0]\\n\",\"        for identity in identities\\n\",\"    }\\n\",\"\\n\",\"    same_scores = []\\n\",\"    different_scores = []\\n\",\"\\n\",\"    for _ in range(10000):\\n\",\"\\n\",\"        identity = rng.choice(identities)\\n\",\"        pair = rng.choice(\\n\",\"            identity_indices[identity], 2, replace=False\\n\",\"        )\\n\",\"\\n\",\"        same_scores.append(\\n\",\"            np.dot(embeddings[pair[0]], embeddings[pair[1]])\\n\",\"        )\\n\",\"\\n\",\"        selected = rng.choice(identities, 2, replace=False)\\n\",\"\\n\",\"        i = rng.choice(identity_indices[selected[0]])\\n\",\"        j = rng.choice(identity_indices[selected[1]])\\n\",\"\\n\",\"        different_scores.append(\\n\",\"            np.dot(embeddings[i], embeddings[j])\\n\",\"        )\\n\",\"\\n\",\"    ax.hist(\\n\",\"        same_scores,\\n\",\"        bins=40,\\n\",\"        alpha=0.6,\\n\",\"        density=True,\\n\",\"        label=\\\"Same identity\\\"\\n\",\"    )\\n\",\"\\n\",\"    ax.hist(\\n\",\"        different_scores,\\n\",\"        bins=40,\\n\",\"        alpha=0.6,\\n\",\"        density=True,\\n\",\"        label=\\\"Different identity\\\"\\n\",\"    )\\n\",\"\\n\",\"    ax.set_title(name)\\n\",\"    ax.set_xlabel(\\\"Cosine similarity\\\")\\n\",\"    ax.set_ylabel(\\\"Density\\\")\\n\",\"    ax.legend()\\n\",\"\\n\",\"plt.suptitle(\\\"FaceNet Identity Similarity Distributions\\\")\\n\",\"plt.tight_layout()\\n\",\"plt.show()\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 35\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 13 — Baseline Distribution Distance Analysis\\n\",\"\\n\",\"### Objective\\n\",\"Quantify differences between the statistical distributions of reference, calibration and evaluation FaceNet embeddings.\\n\",\"\\n\",\"### Methodology\\n\",\"1. Calculate the mean embedding vector for each partition.\\n\",\"2. Calculate Euclidean distances between partition mean vectors.\\n\",\"3. Calculate cosine distances between partition mean vectors.\\n\",\"4. Estimate covariance matrices and regularised Mahalanobis distances.\\n\",\"5. Compare the resulting distribution-distance measurements.\\n\",\"\\n\",\"### Evaluation Metrics\\n\",\"- Euclidean distance.\\n\",\"- Cosine distance.\\n\",\"- Regularised Mahalanobis distance.\\n\",\"\\n\",\"### Scientific Consideration\\n\",\"The partitions contain different identities. Therefore, measured distribution differences cannot be attributed exclusively to environmental drift or temporal changes.\\n\",\"\\n\",\"### Status\\n\",\"\\n\",\"Successfully completed. Baseline distribution distances were calculated between the reference, calibration, and evaluation embedding partitions.\\n\",\"\\n\",\"The analysis calculated Euclidean distance, cosine distance, and regularised Mahalanobis distance for all three pairwise comparisons.\\n\",\"\\n\",\"Numerical stability diagnostics were also performed on the regularised covariance matrices. All covariance values were finite, and condition numbers were calculated for each partition.\\n\",\"\\n\",\"The baseline distance summary and numerical stability diagnostics were generated successfully.\\n\",\"\\n\",\"Scientific limitation: The partitions contain different identities. Therefore, the observed distribution differences cannot be attributed exclusively to environmental drift or temporal changes.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 36\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"\\n\",\"# Define the embedding partitions\\n\",\"partitions = {\\n\",\"    \\\"Reference\\\": reference_embeddings,\\n\",\"    \\\"Calibration\\\": calibration_embeddings,\\n\",\"    \\\"Evaluation\\\": evaluation_embeddings\\n\",\"}\\n\",\"\\n\",\"# Calculate mean embedding vectors\\n\",\"partition_means = {\\n\",\"    name: np.mean(embeddings, axis=0)\\n\",\"    for name, embeddings in partitions.items()\\n\",\"}\\n\",\"\\n\",\"# Calculate covariance matrices\\n\",\"partition_covariances = {\\n\",\"    name: np.cov(embeddings, rowvar=False)\\n\",\"    for name, embeddings in partitions.items()\\n\",\"}\\n\",\"\\n\",\"# Pairwise comparisons\\n\",\"comparison_pairs = [\\n\",\"    (\\\"Reference\\\", \\\"Calibration\\\"),\\n\",\"    (\\\"Reference\\\", \\\"Evaluation\\\"),\\n\",\"    (\\\"Calibration\\\", \\\"Evaluation\\\")\\n\",\"]\\n\",\"\\n\",\"results = []\\n\",\"\\n\",\"for name_a, name_b in comparison_pairs:\\n\",\"\\n\",\"    mean_a = partition_means[name_a]\\n\",\"    mean_b = partition_means[name_b]\\n\",\"\\n\",\"    # Difference between partition mean vectors\\n\",\"    mean_difference = mean_a - mean_b\\n\",\"\\n\",\"    # Euclidean distance\\n\",\"    euclidean_distance = np.linalg.norm(mean_difference)\\n\",\"\\n\",\"    # Cosine distance\\n\",\"    cosine_similarity = (\\n\",\"        np.dot(mean_a, mean_b) /\\n\",\"        (np.linalg.norm(mean_a) * np.linalg.norm(mean_b))\\n\",\"    )\\n\",\"\\n\",\"    cosine_distance = 1 - cosine_similarity\\n\",\"\\n\",\"    # Pooled covariance matrix\\n\",\"    covariance_a = partition_covariances[name_a]\\n\",\"    covariance_b = partition_covariances[name_b]\\n\",\"\\n\",\"    pooled_covariance = (\\n\",\"        covariance_a + covariance_b\\n\",\"    ) / 2\\n\",\"\\n\",\"    # Regularisation for numerical stability\\n\",\"    regularisation = (\\n\",\"        1e-4 * np.trace(pooled_covariance) / len(mean_difference)\\n\",\"    )\\n\",\"\\n\",\"    regularised_covariance = (\\n\",\"        pooled_covariance +\\n\",\"        regularisation * np.eye(len(mean_difference))\\n\",\"    )\\n\",\"\\n\",\"    # Mahalanobis distance\\n\",\"    solved_difference = np.linalg.solve(\\n\",\"        regularised_covariance,\\n\",\"        mean_difference\\n\",\"    )\\n\",\"\\n\",\"    mahalanobis_distance = np.sqrt(\\n\",\"        mean_difference @ solved_difference\\n\",\"    )\\n\",\"\\n\",\"    results.append({\\n\",\"        \\\"Comparison\\\": f\\\"{name_a} vs {name_b}\\\",\\n\",\"        \\\"Euclidean Distance\\\": euclidean_distance,\\n\",\"        \\\"Cosine Distance\\\": cosine_distance,\\n\",\"        \\\"Regularised Mahalanobis Distance\\\": mahalanobis_distance,\\n\",\"        \\\"Regularisation\\\": regularisation\\n\",\"    })\\n\",\"\\n\",\"distance_results = pd.DataFrame(results)\\n\",\"\\n\",\"print(\\\"BASELINE EMBEDDING DISTRIBUTION DISTANCES\\\")\\n\",\"display(distance_results.round(6))\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 38\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 13.2 — Regularisation Sensitivity Analysis\\n\",\"\\n\",\"### Objective\\n\",\"Evaluate how covariance regularisation affects the calculated Mahalanobis distances between embedding partitions.\\n\",\"\\n\",\"### Methodology\\n\",\"Repeat the pairwise Mahalanobis distance calculations using three regularisation strengths:\\n\",\"- 1e-4\\n\",\"- 1e-3\\n\",\"- 1e-2\\n\",\"\\n\",\"### Research Purpose\\n\",\"Determine whether the measured partition distances remain reasonably stable as covariance regularisation increases.\\n\",\"\\n\",\"### Scientific Limitation\\n\",\"This analysis assesses numerical sensitivity. It does not establish that the measured distances represent environmental or temporal drift.\\n\",\"\\n\",\"### Status\\n\",\"Successfully completed. Mahalanobis distance sensitivity was evaluated across regularisation strengths of 1e-4, 1e-3 and 1e-2 for all three partition comparisons. The results show modest changes in Mahalanobis distances and substantially lower covariance condition numbers as regularisation increases. This analysis evaluates numerical sensitivity and stability only; it does not establish biometric drift or statistical significance.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 42\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 14 — Baseline Embedding Analysis Summary\\n\",\"\\n\",\"### 14.1 Face Embedding Extraction\\n\",\"- Dataset: LFW filtered subset\\n\",\"- Identities: 62\\n\",\"- Successful embeddings: 2,984\\n\",\"- Embedding dimension: 512\\n\",\"- Face detection success rate: 98.71%\\n\",\"- Model: InceptionResnetV1 pretrained on VGGFace2\\n\",\"\\n\",\"### 14.2 Identity Similarity Analysis\\n\",\"Same-identity pairs demonstrated substantially higher cosine similarity than different-identity pairs across reference, calibration and evaluation partitions.\\n\",\"\\n\",\"### 14.3 Distribution Distance Analysis\\n\",\"Euclidean, cosine and regularised Mahalanobis distances showed differences between partition mean embedding vectors.\\n\",\"\\n\",\"### 14.4 Numerical Stability\\n\",\"Mahalanobis distance sensitivity analysis showed relatively small changes across regularisation strengths of 1e-4, 1e-3 and 1e-2.\\n\",\"\\n\",\"### 14.5 Scientific Limitations\\n\",\"1. The partitions contain different identities, which can influence distribution comparisons.\\n\",\"2. Similarity distributions are descriptive and do not establish biometric verification accuracy.\\n\",\"3. Distribution distances are not evidence of temporal or environmental drift.\\n\",\"4. The experiment uses a filtered LFW subset and controlled computational procedures rather than a real-time biometric deployment.\\n\",\"\\n\",\"### 14.6 Next Experimental Phase\\n\",\"The next phase will investigate controlled environmental transformations of genuine face images and measure their effects on FaceNet embeddings.\\n\",\"\\n\",\"### Status\\n\",\"Baseline embedding analysis completed.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 43\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"\\n\",\"print(\\\"=\\\" * 70)\\n\",\"print(\\\"EXPERIMENT 18 — BASELINE EMBEDDING ANALYSIS SUMMARY\\\")\\n\",\"print(\\\"=\\\" * 70)\\n\",\"\\n\",\"# 1. Dataset and embedding extraction\\n\",\"print(\\\"\\\\n1. DATASET AND EMBEDDING EXTRACTION\\\")\\n\",\"\\n\",\"print(\\\"Dataset: LFW filtered subset\\\")\\n\",\"print(\\\"Number of identities:\\\", 62)\\n\",\"print(\\\"Successful embeddings:\\\",\\n\",\"      len(reference_embeddings) +\\n\",\"      len(calibration_embeddings) +\\n\",\"      len(evaluation_embeddings))\\n\",\"\\n\",\"print(\\\"Embedding dimension:\\\", reference_embeddings.shape[1])\\n\",\"print(\\\"Model: InceptionResnetV1\\\")\\n\",\"print(\\\"Pretrained weights: VGGFace2\\\")\\n\",\"\\n\",\"total_images = 3023\\n\",\"successful_embeddings = (\\n\",\"    len(reference_embeddings) +\\n\",\"    len(calibration_embeddings) +\\n\",\"    len(evaluation_embeddings)\\n\",\")\\n\",\"\\n\",\"print(\\\"Face detection success rate:\\\",\\n\",\"      round(successful_embeddings / total_images * 100, 2), \\\"%\\\")\\n\",\"\\n\",\"# 2. Identity similarity analysis\\n\",\"print(\\\"\\\\n2. IDENTITY SIMILARITY ANALYSIS\\\")\\n\",\"\\n\",\"similarity_summary = pd.DataFrame({\\n\",\"    \\\"Partition\\\": [\\\"Reference\\\", \\\"Calibration\\\", \\\"Evaluation\\\"],\\n\",\"    \\\"Same Identity Mean\\\": [0.743622, 0.752430, 0.759970],\\n\",\"    \\\"Different Identity Mean\\\": [0.056351, 0.050947, 0.056767],\\n\",\"    \\\"Mean Separation\\\": [0.687271, 0.701483, 0.703203]\\n\",\"})\\n\",\"\\n\",\"display(similarity_summary.round(6))\\n\",\"\\n\",\"# 3. Distribution distance analysis\\n\",\"print(\\\"\\\\n3. DISTRIBUTION DISTANCE ANALYSIS\\\")\\n\",\"\\n\",\"display(distance_results.round(6))\\n\",\"\\n\",\"# 4. Regularisation sensitivity\\n\",\"print(\\\"\\\\n4. MAHALANOBIS REGULARISATION SENSITIVITY\\\")\\n\",\"\\n\",\"display(\\n\",\"    sensitivity_df[\\n\",\"        [\\n\",\"            \\\"Comparison\\\",\\n\",\"            \\\"Regularisation Strength\\\",\\n\",\"            \\\"Mahalanobis Distance\\\",\\n\",\"            \\\"Condition Number\\\"\\n\",\"        ]\\n\",\"    ].round(6)\\n\",\")\\n\",\"\\n\",\"# 5. Final integrity checks\\n\",\"print(\\\"\\\\n5. EMBEDDING INTEGRITY\\\")\\n\",\"\\n\",\"for name, embeddings in partitions.items():\\n\",\"\\n\",\"    print(\\n\",\"        f\\\"{name}:\\\",\\n\",\"        \\\"Finite =\\\", np.all(np.isfinite(embeddings)),\\n\",\"        \\\"| Shape =\\\", embeddings.shape,\\n\",\"        \\\"| Mean L2 norm =\\\", round(\\n\",\"            np.mean(np.linalg.norm(embeddings, axis=1)), 6\\n\",\"        )\\n\",\"    )\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 70)\\n\",\"print(\\\"BASELINE ANALYSIS SUMMARY GENERATED\\\")\\n\",\"print(\\\"=\\\" * 70)\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 44\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 15 — Controlled Illumination Drift Experiment\\n\",\"\\n\",\"### Objective\\n\",\"Evaluate the effect of controlled illumination changes on genuine FaceNet face-recognition embeddings.\\n\",\"\\n\",\"### Research Questions\\n\",\"1. How does reduced illumination affect embedding representations?\\n\",\"2. How does increased illumination affect embedding representations?\\n\",\"3. Does illumination change produce measurable embedding-space displacement?\\n\",\"4. Can embedding-level drift detectors distinguish transformed embeddings from baseline embeddings?\\n\",\"\\n\",\"### Experimental Design\\n\",\"- Dataset: LFW evaluation partition.\\n\",\"- Original images: unmodified evaluation images.\\n\",\"- Transformation: controlled brightness adjustment.\\n\",\"- Conditions: reduced, unchanged and increased illumination.\\n\",\"- Model: InceptionResnetV1 pretrained on VGGFace2.\\n\",\"- Embedding dimension: 512.\\n\",\"- Comparison: paired original and transformed image embeddings.\\n\",\"\\n\",\"### Evaluation Metrics\\n\",\"- Cosine similarity.\\n\",\"- Euclidean embedding displacement.\\n\",\"- Distribution-level distance.\\n\",\"- Drift detection rate and false alarm rate in subsequent detector evaluation.\\n\",\"\\n\",\"### Scientific Scope\\n\",\"This experiment evaluates controlled illumination perturbations. It does not represent naturally occurring temporal drift or establish real-world biometric deployment performance.\\n\",\"\\n\",\"### Status\\n\",\"Successfully completed. The evaluation partition was inspected, and five original LFW images were visually reviewed. The partition contains 968 image indices, 956 successfully extracted embeddings and 956 corresponding labels. Sample image integrity checks passed, with finite RGB pixel values within the valid [0, 1] range.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 45\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"import numpy as np\\n\",\"import matplotlib.pyplot as plt\\n\",\"\\n\",\"# Verify evaluation partition\\n\",\"print(\\\"EVALUATION PARTITION INSPECTION\\\")\\n\",\"print(\\\"-\\\" * 50)\\n\",\"\\n\",\"print(\\\"Evaluation image indices:\\\", len(evaluation_indices))\\n\",\"print(\\\"Evaluation embeddings:\\\", evaluation_embeddings.shape)\\n\",\"print(\\\"Evaluation labels:\\\", evaluation_labels.shape)\\n\",\"\\n\",\"# Select five evaluation images for visual inspection\\n\",\"sample_indices = evaluation_indices[:5]\\n\",\"\\n\",\"fig, axes = plt.subplots(1, 5, figsize=(16, 4))\\n\",\"\\n\",\"for ax, image_index in zip(axes, sample_indices):\\n\",\"\\n\",\"    image = lfw_dataset.images[image_index]\\n\",\"\\n\",\"    ax.imshow(np.clip(image, 0, 1))\\n\",\"    ax.set_title(f\\\"Image {image_index}\\\")\\n\",\"    ax.axis(\\\"off\\\")\\n\",\"\\n\",\"plt.suptitle(\\\"Original LFW Evaluation Images\\\")\\n\",\"plt.tight_layout()\\n\",\"plt.show()\\n\",\"\\n\",\"# Check image integrity\\n\",\"sample_images = lfw_dataset.images[sample_indices]\\n\",\"\\n\",\"print(\\\"\\\\nIMAGE INTEGRITY\\\")\\n\",\"print(\\\"Image shape:\\\", sample_images.shape)\\n\",\"print(\\\"All values finite:\\\", np.all(np.isfinite(sample_images)))\\n\",\"print(\\\"Minimum pixel value:\\\", np.min(sample_images))\\n\",\"print(\\\"Maximum pixel value:\\\", np.max(sample_images))\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 46\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 15.1 — Controlled Illumination Transformation\\n\",\"\\n\",\"### Objective\\n\",\"Generate controlled illumination variants from successfully processed evaluation images.\\n\",\"\\n\",\"### Transformation Conditions\\n\",\"- Low illumination: brightness factor 0.5\\n\",\"- Original illumination: brightness factor 1.0\\n\",\"- High illumination: brightness factor 1.5\\n\",\"\\n\",\"### Methodology\\n\",\"Apply multiplicative brightness adjustments to the original RGB images. Clip pixel values to the valid [0, 1] range.\\n\",\"\\n\",\"Only images with successful original FaceNet embedding extraction will be included, preserving paired comparisons.\\n\",\"\\n\",\"### Scientific Limitation\\n\",\"These are computationally generated illumination perturbations, not naturally captured lighting conditions.\\n\",\"\\n\",\"### Status\\n\",\"Successfully completed. Controlled illumination variants were generated for all 956 successfully processed evaluation images using brightness factors of 0.5, 1.0 and 1.5. All three image collections have the expected shape of (956, 125, 94, 3). Numerical integrity checks confirmed finite pixel values within the valid [0, 1] range. These transformations are computationally generated and do not represent naturally captured lighting conditions.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 48\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"import numpy as np\\n\",\"import matplotlib.pyplot as plt\\n\",\"\\n\",\"# Exclude images where original face detection failed\\n\",\"successful_evaluation_indices = np.setdiff1d(\\n\",\"    evaluation_indices,\\n\",\"    evaluation_failures\\n\",\")\\n\",\"\\n\",\"# Confirm paired dataset size\\n\",\"print(\\\"Successful evaluation images:\\\",\\n\",\"      len(successful_evaluation_indices))\\n\",\"\\n\",\"print(\\\"Original evaluation embeddings:\\\",\\n\",\"      len(evaluation_embeddings))\\n\",\"\\n\",\"assert len(successful_evaluation_indices) == len(evaluation_embeddings)\\n\",\"\\n\",\"# Define illumination conditions\\n\",\"brightness_factors = {\\n\",\"    \\\"Low illumination\\\": 0.5,\\n\",\"    \\\"Original illumination\\\": 1.0,\\n\",\"    \\\"High illumination\\\": 1.5\\n\",\"}\\n\",\"\\n\",\"# Generate transformed images\\n\",\"illumination_images = {}\\n\",\"\\n\",\"for condition, factor in brightness_factors.items():\\n\",\"\\n\",\"    transformed = []\\n\",\"\\n\",\"    for image_index in successful_evaluation_indices:\\n\",\"\\n\",\"        original_image = lfw_dataset.images[image_index]\\n\",\"\\n\",\"        adjusted_image = np.clip(\\n\",\"            original_image * factor,\\n\",\"            0.0,\\n\",\"            1.0\\n\",\"        )\\n\",\"\\n\",\"        transformed.append(adjusted_image)\\n\",\"\\n\",\"    illumination_images[condition] = np.asarray(transformed)\\n\",\"\\n\",\"    print(\\n\",\"        condition,\\n\",\"        illumination_images[condition].shape\\n\",\"    )\\n\",\"\\n\",\"# Visualise one image under all three conditions\\n\",\"sample_position = 0\\n\",\"\\n\",\"fig, axes = plt.subplots(1, 3, figsize=(12, 4))\\n\",\"\\n\",\"for ax, (condition, images) in zip(\\n\",\"    axes, illumination_images.items()\\n\",\"):\\n\",\"\\n\",\"    ax.imshow(images[sample_position])\\n\",\"    ax.set_title(condition)\\n\",\"    ax.axis(\\\"off\\\")\\n\",\"\\n\",\"plt.suptitle(\\\"Controlled Illumination Variants\\\")\\n\",\"plt.tight_layout()\\n\",\"plt.show()\\n\",\"\\n\",\"# Validate generated images\\n\",\"for condition, images in illumination_images.items():\\n\",\"\\n\",\"    print(\\n\",\"        condition,\\n\",\"        \\\"| Finite:\\\", np.all(np.isfinite(images)),\\n\",\"        \\\"| Minimum:\\\", images.min(),\\n\",\"        \\\"| Maximum:\\\", images.max()\\n\",\"    )\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 49\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 15.2 — FaceNet Embedding Extraction Under Illumination Changes\\n\",\"\\n\",\"### Objective\\n\",\"Extract 512-dimensional FaceNet embeddings from low- and high-illumination evaluation images.\\n\",\"\\n\",\"### Methodology\\n\",\"1. Reuse the original evaluation embeddings as the baseline.\\n\",\"2. Process low-illumination images using MTCNN and FaceNet.\\n\",\"3. Process high-illumination images using MTCNN and FaceNet.\\n\",\"4. Record face detection failures separately.\\n\",\"5. Verify embedding dimensions and numerical integrity.\\n\",\"\\n\",\"### Experimental Conditions\\n\",\"- Original: existing baseline embeddings.\\n\",\"- Low illumination: brightness factor 0.5.\\n\",\"- High illumination: brightness factor 1.5.\\n\",\"\\n\",\"### Scientific Limitation\\n\",\"Face detection may fail on transformed images. The final paired analysis must account for those failures rather than silently discarding them.\\n\",\"\\n\",\"### Status\\n\",\"Successfully completed. FaceNet embeddings were extracted from low- and high-illumination evaluation images using MTCNN and InceptionResnetV1. The original baseline contained 956 embeddings of 512 dimensions. Low illumination produced 943 valid embeddings with 13 detection failures, while high illumination produced 897 valid embeddings with 59 detection failures. Both transformed embedding collections passed numerical integrity checks, with all values finite. Detection failures were recorded separately for subsequent paired-cohort validation.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 50\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['MTCNN(', 'mtcnn(', 'facenet(', 'torch.no_grad', 'embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"from PIL import Image\\n\",\"from tqdm.auto import tqdm\\n\",\"import numpy as np\\n\",\"import torch\\n\",\"\\n\",\"def extract_transformed_embeddings(images, condition_name):\\n\",\"\\n\",\"    embeddings = []\\n\",\"    successful_positions = []\\n\",\"    failed_positions = []\\n\",\"\\n\",\"    for position, image in enumerate(\\n\",\"        tqdm(images, desc=condition_name)\\n\",\"    ):\\n\",\"\\n\",\"        try:\\n\",\"            image_uint8 = (\\n\",\"                np.clip(image, 0, 1) * 255\\n\",\"            ).astype(np.uint8)\\n\",\"\\n\",\"            pil_image = Image.fromarray(image_uint8)\\n\",\"\\n\",\"            face_tensor = mtcnn(pil_image)\\n\",\"\\n\",\"            if face_tensor is None:\\n\",\"                failed_positions.append(position)\\n\",\"                continue\\n\",\"\\n\",\"            with torch.no_grad():\\n\",\"                embedding = facenet(\\n\",\"                    face_tensor.unsqueeze(0).to(device)\\n\",\"                )\\n\",\"\\n\",\"            embedding = embedding.cpu().numpy()[0]\\n\",\"\\n\",\"            if not np.all(np.isfinite(embedding)):\\n\",\"                failed_positions.append(position)\\n\",\"                continue\\n\",\"\\n\",\"            embeddings.append(embedding)\\n\",\"            successful_positions.append(position)\\n\",\"\\n\",\"        except Exception:\\n\",\"            failed_positions.append(position)\\n\",\"\\n\",\"    return (\\n\",\"        np.asarray(embeddings),\\n\",\"        np.asarray(successful_positions),\\n\",\"        np.asarray(failed_positions)\\n\",\"    )\\n\",\"\\n\",\"\\n\",\"# Extract low-illumination embeddings\\n\",\"low_embeddings, low_success, low_failures = (\\n\",\"    extract_transformed_embeddings(\\n\",\"        illumination_images[\\\"Low illumination\\\"],\\n\",\"        \\\"Low illumination\\\"\\n\",\"    )\\n\",\")\\n\",\"\\n\",\"# Extract high-illumination embeddings\\n\",\"high_embeddings, high_success, high_failures = (\\n\",\"    extract_transformed_embeddings(\\n\",\"        illumination_images[\\\"High illumination\\\"],\\n\",\"        \\\"High illumination\\\"\\n\",\"    )\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\nEMBEDDING EXTRACTION SUMMARY\\\")\\n\",\"\\n\",\"print(\\\"Original embeddings:\\\", evaluation_embeddings.shape)\\n\",\"\\n\",\"print(\\\"Low illumination embeddings:\\\", low_embeddings.shape)\\n\",\"print(\\\"Low illumination failures:\\\", len(low_failures))\\n\",\"\\n\",\"print(\\\"High illumination embeddings:\\\", high_embeddings.shape)\\n\",\"print(\\\"High illumination failures:\\\", len(high_failures))\\n\",\"\\n\",\"print(\\\"\\\\nNUMERICAL VALIDATION\\\")\\n\",\"\\n\",\"print(\\\"Low embeddings finite:\\\",\\n\",\"      np.all(np.isfinite(low_embeddings)))\\n\",\"\\n\",\"print(\\\"High embeddings finite:\\\",\\n\",\"      np.all(np.isfinite(high_embeddings)))\\n\",\"\\n\",\"print(\\\"Low successful positions:\\\", len(low_success))\\n\",\"print(\\\"High successful positions:\\\", len(high_success))\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 51\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 15.3 — Paired Image and Identity Alignment Validation\\n\",\"\\n\",\"### Objective\\n\",\"Establish a correctly aligned evaluation cohort across original, low-illumination and high-illumination conditions.\\n\",\"\\n\",\"### Methodology\\n\",\"1. Reconstruct the original successful evaluation image indices while preserving their extraction order.\\n\",\"2. Identify images successfully processed under both transformed conditions.\\n\",\"3. Match original embeddings with their corresponding transformed embeddings.\\n\",\"4. Verify identity-label consistency across all conditions.\\n\",\"\\n\",\"### Research Purpose\\n\",\"Prevent incorrect image pairing and identity mismatches from contaminating the illumination sensitivity analysis.\\n\",\"\\n\",\"### Status\\n\",\"Successfully completed. Image-to-embedding alignment and identity-label consistency were validated across original, low-illumination and high-illumination conditions. A common paired cohort of 889 images was established from 956 original, 943 low-illumination and 897 high-illumination successful extractions. All three paired embedding matrices have shape (889, 512). Identity labels were aligned, all embeddings were finite, and the dimensional consistency assertions passed.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 52\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"import numpy as np\\n\",\"\\n\",\"# Preserve the original extraction order\\n\",\"evaluation_failure_set = set(evaluation_failures)\\n\",\"\\n\",\"ordered_original_indices = np.array([\\n\",\"    idx for idx in evaluation_indices\\n\",\"    if idx not in evaluation_failure_set\\n\",\"])\\n\",\"\\n\",\"# Verify original image-to-embedding alignment\\n\",\"assert len(ordered_original_indices) == len(evaluation_embeddings)\\n\",\"\\n\",\"original_labels_check = lfw_dataset.target[\\n\",\"    ordered_original_indices\\n\",\"]\\n\",\"\\n\",\"assert np.array_equal(\\n\",\"    original_labels_check,\\n\",\"    evaluation_labels\\n\",\"), \\\"Original image and embedding labels are misaligned.\\\"\\n\",\"\\n\",\"# Find positions successful under both transformations\\n\",\"common_positions = np.intersect1d(\\n\",\"    low_success,\\n\",\"    high_success\\n\",\")\\n\",\"\\n\",\"# Match all three conditions\\n\",\"paired_original_embeddings = evaluation_embeddings[\\n\",\"    common_positions\\n\",\"]\\n\",\"\\n\",\"paired_low_embeddings = low_embeddings[\\n\",\"    np.searchsorted(low_success, common_positions)\\n\",\"]\\n\",\"\\n\",\"paired_high_embeddings = high_embeddings[\\n\",\"    np.searchsorted(high_success, common_positions)\\n\",\"]\\n\",\"\\n\",\"# Verify identity consistency\\n\",\"paired_labels = evaluation_labels[common_positions]\\n\",\"\\n\",\"print(\\\"PAIRED COHORT VALIDATION\\\")\\n\",\"print(\\\"-\\\" * 50)\\n\",\"\\n\",\"print(\\\"Original successful images:\\\", len(ordered_original_indices))\\n\",\"print(\\\"Low illumination successes:\\\", len(low_success))\\n\",\"print(\\\"High illumination successes:\\\", len(high_success))\\n\",\"\\n\",\"print(\\\"Images successful in all three conditions:\\\",\\n\",\"      len(common_positions))\\n\",\"\\n\",\"print(\\\"\\\\nEmbedding shapes:\\\")\\n\",\"print(\\\"Original:\\\", paired_original_embeddings.shape)\\n\",\"print(\\\"Low:\\\", paired_low_embeddings.shape)\\n\",\"print(\\\"High:\\\", paired_high_embeddings.shape)\\n\",\"\\n\",\"print(\\\"\\\\nIdentity labels aligned:\\\",\\n\",\"      np.array_equal(\\n\",\"          paired_labels,\\n\",\"          lfw_dataset.target[\\n\",\"              ordered_original_indices[common_positions]\\n\",\"          ]\\n\",\"      ))\\n\",\"\\n\",\"print(\\\"All paired embeddings finite:\\\",\\n\",\"      all(np.all(np.isfinite(x)) for x in [\\n\",\"          paired_original_embeddings,\\n\",\"          paired_low_embeddings,\\n\",\"          paired_high_embeddings\\n\",\"      ]))\\n\",\"\\n\",\"assert paired_original_embeddings.shape == paired_low_embeddings.shape\\n\",\"assert paired_original_embeddings.shape == paired_high_embeddings.shape\\n\",\"assert paired_original_embeddings.shape[1] == 512\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 53\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 15.4 — Illumination-Induced Embedding Displacement Analysis\\n\",\"\\n\",\"### Objective\\n\",\"Quantify the changes in FaceNet embedding representations caused by controlled illumination transformations.\\n\",\"\\n\",\"### Methodology\\n\",\"Compare paired original embeddings against their corresponding low- and high-illumination embeddings.\\n\",\"\\n\",\"### Evaluation Metrics\\n\",\"1. Cosine similarity between original and transformed embeddings.\\n\",\"2. Euclidean distance between original and transformed embeddings.\\n\",\"3. Mean, median and standard deviation of embedding displacement.\\n\",\"4. 95th percentile of embedding displacement.\\n\",\"\\n\",\"### Research Purpose\\n\",\"Determine whether controlled illumination changes produce measurable shifts in genuine face-recognition embedding representations.\\n\",\"\\n\",\"### Scientific Limitation\\n\",\"This analysis measures representation changes, not identity recognition accuracy or real-world temporal drift.\\n\",\"\\n\",\"### Status\\n\",\"Successfully completed. Illumination-induced embedding displacement was calculated for 889 correctly paired evaluation images. Cosine similarity and Euclidean displacement statistics, including mean, median, standard deviation and 95th percentile distance, were computed for low- and high-illumination conditions. The analysis quantifies changes in embedding representations under controlled brightness transformations; it does not establish identity recognition accuracy or real-world temporal drift.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 54\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"\\n\",\"def calculate_embedding_displacement(\\n\",\"    original_embeddings,\\n\",\"    transformed_embeddings,\\n\",\"    condition_name\\n\",\"):\\n\",\"\\n\",\"    # Calculate cosine similarity for paired embeddings\\n\",\"    cosine_similarities = np.sum(\\n\",\"        original_embeddings * transformed_embeddings,\\n\",\"        axis=1\\n\",\"    ) / (\\n\",\"        np.linalg.norm(original_embeddings, axis=1) *\\n\",\"        np.linalg.norm(transformed_embeddings, axis=1)\\n\",\"    )\\n\",\"\\n\",\"    # Calculate Euclidean displacement\\n\",\"    euclidean_distances = np.linalg.norm(\\n\",\"        original_embeddings - transformed_embeddings,\\n\",\"        axis=1\\n\",\"    )\\n\",\"\\n\",\"    return {\\n\",\"        \\\"Condition\\\": condition_name,\\n\",\"        \\\"Mean Cosine Similarity\\\": np.mean(cosine_similarities),\\n\",\"        \\\"Median Cosine Similarity\\\": np.median(cosine_similarities),\\n\",\"        \\\"Mean Euclidean Distance\\\": np.mean(euclidean_distances),\\n\",\"        \\\"Median Euclidean Distance\\\": np.median(euclidean_distances),\\n\",\"        \\\"Std Euclidean Distance\\\": np.std(euclidean_distances),\\n\",\"        \\\"95th Percentile Distance\\\": np.percentile(\\n\",\"            euclidean_distances, 95\\n\",\"        )\\n\",\"    }\\n\",\"\\n\",\"\\n\",\"# Compare original embeddings with transformed embeddings\\n\",\"low_results = calculate_embedding_displacement(\\n\",\"    paired_original_embeddings,\\n\",\"    paired_low_embeddings,\\n\",\"    \\\"Low illumination\\\"\\n\",\")\\n\",\"\\n\",\"high_results = calculate_embedding_displacement(\\n\",\"    paired_original_embeddings,\\n\",\"    paired_high_embeddings,\\n\",\"    \\\"High illumination\\\"\\n\",\")\\n\",\"\\n\",\"illumination_displacement_results = pd.DataFrame([\\n\",\"    low_results,\\n\",\"    high_results\\n\",\"])\\n\",\"\\n\",\"print(\\\"ILLUMINATION-INDUCED EMBEDDING DISPLACEMENT\\\")\\n\",\"print(\\\"Paired evaluation images:\\\", len(common_positions))\\n\",\"\\n\",\"display(\\n\",\"    illumination_displacement_results.round(6)\\n\",\")\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 55\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 15.5 — Visualisation of Illumination-Induced Embedding Displacement\\n\",\"\\n\",\"### Objective\\n\",\"Visualise the distribution of Euclidean embedding displacement under low- and high-illumination conditions.\\n\",\"\\n\",\"### Methodology\\n\",\"1. Calculate paired Euclidean distances between original and transformed embeddings.\\n\",\"2. Generate comparative histograms.\\n\",\"3. Examine distribution spread, central tendency and upper-tail behaviour.\\n\",\"\\n\",\"### Research Purpose\\n\",\"Identify differences in embedding sensitivity between illumination conditions.\\n\",\"\\n\",\"### Scientific Limitation\\n\",\"The visualisation is descriptive and does not independently establish statistical significance or biometric recognition degradation.\\n\",\"\\n\",\"### Status\\n\",\"Successfully completed. Comparative density histograms were generated for low- and high-illumination Euclidean embedding displacement using 40 bins. Across 889 paired evaluation images, low illumination produced a mean displacement of 0.234665 and a median of 0.222675. High illumination produced a mean displacement of 0.318514 and a median of 0.306734. The descriptive results indicate greater embedding displacement under high illumination. This visualisation alone does not establish statistical significance or biometric recognition degradation.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 56\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"import matplotlib.pyplot as plt\\n\",\"import numpy as np\\n\",\"\\n\",\"low_distances = np.linalg.norm(\\n\",\"    paired_original_embeddings - paired_low_embeddings,\\n\",\"    axis=1\\n\",\")\\n\",\"\\n\",\"high_distances = np.linalg.norm(\\n\",\"    paired_original_embeddings - paired_high_embeddings,\\n\",\"    axis=1\\n\",\")\\n\",\"\\n\",\"plt.figure(figsize=(10, 6))\\n\",\"\\n\",\"plt.hist(\\n\",\"    low_distances,\\n\",\"    bins=40,\\n\",\"    alpha=0.6,\\n\",\"    density=True,\\n\",\"    label=\\\"Low illumination\\\"\\n\",\")\\n\",\"\\n\",\"plt.hist(\\n\",\"    high_distances,\\n\",\"    bins=40,\\n\",\"    alpha=0.6,\\n\",\"    density=True,\\n\",\"    label=\\\"High illumination\\\"\\n\",\")\\n\",\"\\n\",\"plt.xlabel(\\\"Euclidean Embedding Displacement\\\")\\n\",\"plt.ylabel(\\\"Density\\\")\\n\",\"plt.title(\\\"FaceNet Embedding Displacement Under Illumination Changes\\\")\\n\",\"plt.legend()\\n\",\"plt.grid(alpha=0.3)\\n\",\"plt.tight_layout()\\n\",\"plt.show()\\n\",\"\\n\",\"print(\\\"LOW ILLUMINATION\\\")\\n\",\"print(\\\"Mean:\\\", np.mean(low_distances))\\n\",\"print(\\\"Median:\\\", np.median(low_distances))\\n\",\"\\n\",\"print(\\\"\\\\nHIGH ILLUMINATION\\\")\\n\",\"print(\\\"Mean:\\\", np.mean(high_distances))\\n\",\"print(\\\"Median:\\\", np.median(high_distances))\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 57\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 15.6 — Paired Statistical Significance Testing\\n\",\"\\n\",\"### Objective\\n\",\"Determine whether embedding displacement differs significantly between low- and high-illumination conditions.\\n\",\"\\n\",\"### Statistical Method\\n\",\"Paired Wilcoxon signed-rank test.\\n\",\"\\n\",\"### Hypotheses\\n\",\"- H0: The paired displacement distributions do not differ systematically between illumination conditions.\\n\",\"- H1: The paired displacement distributions differ systematically between illumination conditions.\\n\",\"\\n\",\"### Additional Measurement\\n\",\"Calculate the median paired displacement difference and the proportion of images with greater displacement under high illumination.\\n\",\"\\n\",\"### Scientific Limitation\\n\",\"Statistical significance does not establish practical biometric recognition degradation. The analysis is conditional on successful face detection in all three conditions.\\n\",\"\\n\",\"### Status\\n\",\"Successfully completed. A paired Wilcoxon signed-rank test was conducted to compare low- and high-illumination embedding displacement across 889 paired evaluation images. The test produced a statistic of 52,705 and a p-value of 4.708938 × 10^-80. The median paired displacement difference was 0.075521, and the mean difference was 0.083849. High-illumination displacement was greater for 77.50% of paired images. The null hypothesis was rejected at the 0.05 significance level. Because images are clustered within 13 identities, this image-level result must be interpreted alongside the identity-level analysis. Statistical significance does not establish biometric recognition degradation.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 59\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 15.7 — Identity-Level Statistical Validation\\n\",\"\\n\",\"### Objective\\n\",\"Determine whether the illumination-induced embedding displacement difference remains consistent across individual identities.\\n\",\"\\n\",\"### Methodology\\n\",\"1. Calculate median low-illumination displacement for each identity.\\n\",\"2. Calculate median high-illumination displacement for each identity.\\n\",\"3. Calculate the paired median displacement difference for each identity.\\n\",\"4. Apply a paired Wilcoxon signed-rank test across identities.\\n\",\"5. Report the number of identities showing greater displacement under high illumination.\\n\",\"\\n\",\"### Research Purpose\\n\",\"Reduce the risk of overstating statistical significance due to multiple correlated images belonging to the same identity.\\n\",\"\\n\",\"### Scientific Limitation\\n\",\"The identity-level analysis contains only 13 independent identity groups, limiting statistical power.\\n\",\"\\n\",\"### Status\\n\",\"Successfully completed. Identity-level displacement statistics were calculated by aggregating paired image-level measurements using median displacement for each identity. The analysis included 13 evaluation identities. A paired Wilcoxon signed-rank test produced a statistic of 3.0 and a p-value of 0.001220703125. High-illumination median displacement was greater for 11 identities and lower for 2 identities. The median identity-level displacement difference was 0.079261. The result indicates a statistically significant identity-level difference, but the analysis remains limited by the small sample of 13 identities and the unequal number of images per identity.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 61\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 15.8 — Identity-Level Displacement Comparison\\n\",\"\\n\",\"### Objective\\n\",\"Visualise the difference in median embedding displacement between low- and high-illumination conditions for each evaluation identity.\\n\",\"\\n\",\"### Methodology\\n\",\"1. Plot the median displacement for both illumination conditions.\\n\",\"2. Display individual identities on the horizontal axis.\\n\",\"3. Compare the direction and magnitude of the differences.\\n\",\"\\n\",\"### Research Purpose\\n\",\"Identify identity-level consistency and variation in illumination sensitivity.\\n\",\"\\n\",\"### Scientific Limitation\\n\",\"The visualisation represents 13 evaluation identities and should not be interpreted as population-wide evidence.\\n\",\"\\n\",\"### Status\\n\",\"Successfully completed. An identity-level grouped bar chart was generated to compare median Euclidean embedding displacement under low- and high-illumination conditions across 13 evaluation identities. The visualisation showed greater high-illumination displacement for 11 identities and lower displacement for 2 identities. The results demonstrate variation in illumination sensitivity across the evaluated identities. This descriptive analysis is limited to 13 identities and should not be interpreted as population-wide evidence.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 62\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"import matplotlib.pyplot as plt\\n\",\"import numpy as np\\n\",\"\\n\",\"identity_ids = identity_summary[\\\"Identity\\\"].astype(str)\\n\",\"\\n\",\"x = np.arange(len(identity_summary))\\n\",\"width = 0.36\\n\",\"\\n\",\"plt.figure(figsize=(13, 6))\\n\",\"\\n\",\"plt.bar(\\n\",\"    x - width / 2,\\n\",\"    identity_summary[\\\"Low_Median\\\"],\\n\",\"    width,\\n\",\"    label=\\\"Low illumination\\\"\\n\",\")\\n\",\"\\n\",\"plt.bar(\\n\",\"    x + width / 2,\\n\",\"    identity_summary[\\\"High_Median\\\"],\\n\",\"    width,\\n\",\"    label=\\\"High illumination\\\"\\n\",\")\\n\",\"\\n\",\"plt.xticks(x, identity_ids)\\n\",\"plt.xlabel(\\\"Evaluation Identity\\\")\\n\",\"plt.ylabel(\\\"Median Euclidean Embedding Displacement\\\")\\n\",\"plt.title(\\\"Identity-Level Illumination Sensitivity\\\")\\n\",\"plt.legend()\\n\",\"plt.grid(axis=\\\"y\\\", alpha=0.3)\\n\",\"plt.tight_layout()\\n\",\"plt.show()\\n\",\"\\n\",\"print(\\\"IDENTITY-LEVEL DISPLACEMENT SUMMARY\\\")\\n\",\"print(\\\"Identities:\\\", len(identity_summary))\\n\",\"print(\\n\",\"    \\\"Positive differences:\\\",\\n\",\"    (identity_summary[\\\"Median_Difference\\\"] > 0).sum()\\n\",\")\\n\",\"print(\\n\",\"    \\\"Negative differences:\\\",\\n\",\"    (identity_summary[\\\"Median_Difference\\\"] < 0).sum()\\n\",\")\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 63\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 15.9 — Illumination Experiment Results Preservation\\n\",\"\\n\",\"### Objective\\n\",\"Save the outputs of the controlled illumination experiment for reproducibility and subsequent drift detector evaluation.\\n\",\"\\n\",\"### Saved Data\\n\",\"- Paired original embeddings.\\n\",\"- Paired low-illumination embeddings.\\n\",\"- Paired high-illumination embeddings.\\n\",\"- Paired identity labels.\\n\",\"- Low- and high-illumination displacement measurements.\\n\",\"- Identity-level displacement summary.\\n\",\"- Face detection success and failure information.\\n\",\"- Experiment configuration and statistical results.\\n\",\"\\n\",\"### Status\\n\",\"Successfully completed. The controlled illumination experiment results were saved to the Google Drive output directory. The compressed NPZ archive contains the paired original, low-illumination and high-illumination embeddings, identity labels, image positions, displacement measurements, and face-detection success and failure information. The identity-level displacement summary was saved as a CSV file, and the experiment configuration and aggregate statistical results were saved as JSON metadata. File-existence checks confirmed that all three output files were created successfully. These saved artefacts support reproducibility and subsequent drift-detector evaluation.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 64\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"import os\\n\",\"import json\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"\\n\",\"# Create output directory\\n\",\"output_dir = \\\"/content/drive/MyDrive/Experiment_18_Results\\\"\\n\",\"os.makedirs(output_dir, exist_ok=True)\\n\",\"\\n\",\"# Save numerical experiment results\\n\",\"np.savez_compressed(\\n\",\"    os.path.join(output_dir, \\\"experiment18_illumination_results.npz\\\"),\\n\",\"\\n\",\"    original_embeddings=paired_original_embeddings,\\n\",\"    low_illumination_embeddings=paired_low_embeddings,\\n\",\"    high_illumination_embeddings=paired_high_embeddings,\\n\",\"\\n\",\"    paired_labels=paired_labels,\\n\",\"    common_positions=common_positions,\\n\",\"\\n\",\"    low_displacement=low_distances,\\n\",\"    high_displacement=high_distances,\\n\",\"\\n\",\"    low_success=low_success,\\n\",\"    high_success=high_success,\\n\",\"\\n\",\"    low_failures=low_failures,\\n\",\"    high_failures=high_failures\\n\",\")\\n\",\"\\n\",\"# Save identity-level summary\\n\",\"identity_summary.to_csv(\\n\",\"    os.path.join(output_dir, \\\"illumination_identity_summary.csv\\\"),\\n\",\"    index=False\\n\",\")\\n\",\"\\n\",\"# Save aggregate statistics\\n\",\"illumination_metadata = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 18 - Controlled Illumination\\\",\\n\",\"    \\\"dataset\\\": \\\"LFW filtered subset\\\",\\n\",\"    \\\"model\\\": \\\"InceptionResnetV1\\\",\\n\",\"    \\\"pretrained_weights\\\": \\\"VGGFace2\\\",\\n\",\"    \\\"embedding_dimension\\\": 512,\\n\",\"    \\\"brightness_factors\\\": {\\n\",\"        \\\"low\\\": 0.5,\\n\",\"        \\\"original\\\": 1.0,\\n\",\"        \\\"high\\\": 1.5\\n\",\"    },\\n\",\"    \\\"paired_images\\\": int(len(common_positions)),\\n\",\"    \\\"evaluation_identities\\\": int(len(identity_summary)),\\n\",\"    \\\"low_detection_failures\\\": int(len(low_failures)),\\n\",\"    \\\"high_detection_failures\\\": int(len(high_failures)),\\n\",\"    \\\"image_level_wilcoxon_p\\\": float(p_value),\\n\",\"    \\\"identity_level_wilcoxon_p\\\": float(identity_p_value),\\n\",\"    \\\"mean_low_displacement\\\": float(np.mean(low_distances)),\\n\",\"    \\\"mean_high_displacement\\\": float(np.mean(high_distances))\\n\",\"}\\n\",\"\\n\",\"with open(\\n\",\"    os.path.join(output_dir, \\\"illumination_metadata.json\\\"),\\n\",\"    \\\"w\\\"\\n\",\") as file:\\n\",\"    json.dump(illumination_metadata, file, indent=4)\\n\",\"\\n\",\"print(\\\"ILLUMINATION RESULTS SAVED\\\")\\n\",\"\\n\",\"for filename in [\\n\",\"    \\\"experiment18_illumination_results.npz\\\",\\n\",\"    \\\"illumination_identity_summary.csv\\\",\\n\",\"    \\\"illumination_metadata.json\\\"\\n\",\"]:\\n\",\"    path = os.path.join(output_dir, filename)\\n\",\"    print(filename, \\\"| Exists:\\\", os.path.exists(path))\\n\",\"    print(\\\"Size:\\\", round(os.path.getsize(path) / 1024, 2), \\\"KB\\\")\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 65\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 16 — Identity-Aware Embedding-Level Drift Detection\\n\",\"\\n\",\"### Objective\\n\",\"Develop and evaluate embedding-level drift detectors for identifying changes in genuine FaceNet representations under controlled illumination perturbations.\\n\",\"\\n\",\"### Research Questions\\n\",\"1. Can embedding-level detectors identify illumination-induced representation changes?\\n\",\"2. How does detector sensitivity differ between low and high illumination?\\n\",\"3. Can the detectors maintain controlled false alarm rates under baseline conditions?\\n\",\"4. How does covariance regularisation influence Mahalanobis-based detection?\\n\",\"\\n\",\"### Experimental Design\\n\",\"\\n\",\"**Reference population**\\n\",\"Original embeddings from the matched evaluation cohort.\\n\",\"\\n\",\"**Calibration population**\\n\",\"Baseline-versus-baseline comparisons constructed using separate image samples and identity-aware sampling.\\n\",\"\\n\",\"**Evaluation population**\\n\",\"Paired original and transformed embeddings under low- and high-illumination conditions.\\n\",\"\\n\",\"### Detection Methods\\n\",\"- Euclidean embedding displacement.\\n\",\"- Regularised Mahalanobis distance.\\n\",\"\\n\",\"### Proposed Configuration\\n\",\"- Embedding dimension: 512.\\n\",\"- Window size: 20.\\n\",\"- Random seed: 202618.\\n\",\"- Target false alarm rates: 0.01, 0.05 and 0.10.\\n\",\"- Illumination factors: 0.5, 1.0 and 1.5.\\n\",\"\\n\",\"### Evaluation Metrics\\n\",\"- Empirical false alarm rate.\\n\",\"- Detection rate.\\n\",\"- Detection sensitivity by illumination condition.\\n\",\"- Detection performance across identities.\\n\",\"- Numerical stability.\\n\",\"\\n\",\"### Scientific Limitations\\n\",\"The experiment uses controlled brightness transformations rather than naturally occurring temporal drift. Detector results will be conditional on the matched evaluation cohort and the chosen calibration protocol.\\n\",\"\\n\",\"### Status\\n\",\"Methodology defined; implementation pending.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 66\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"\\n\",\"# Reproducibility\\n\",\"RANDOM_SEED = 202618\\n\",\"rng = np.random.default_rng(RANDOM_SEED)\\n\",\"\\n\",\"# Source data: 889 correctly paired images\\n\",\"X_original = paired_original_embeddings\\n\",\"X_low = paired_low_embeddings\\n\",\"X_high = paired_high_embeddings\\n\",\"y = paired_labels\\n\",\"\\n\",\"# Validate input dimensions\\n\",\"assert X_original.shape == X_low.shape == X_high.shape\\n\",\"assert len(X_original) == len(y)\\n\",\"\\n\",\"# Define partition proportions\\n\",\"REFERENCE_RATIO = 0.50\\n\",\"CALIBRATION_RATIO = 0.25\\n\",\"EVALUATION_RATIO = 0.25\\n\",\"\\n\",\"reference_positions = []\\n\",\"calibration_positions = []\\n\",\"evaluation_positions = []\\n\",\"\\n\",\"# Split images separately within each identity\\n\",\"for identity in np.unique(y):\\n\",\"\\n\",\"    identity_positions = np.where(y == identity)[0]\\n\",\"\\n\",\"    shuffled_positions = rng.permutation(identity_positions)\\n\",\"\\n\",\"    n = len(shuffled_positions)\\n\",\"\\n\",\"    reference_count = int(n * REFERENCE_RATIO)\\n\",\"    calibration_count = int(n * CALIBRATION_RATIO)\\n\",\"\\n\",\"    reference_positions.extend(\\n\",\"        shuffled_positions[:reference_count]\\n\",\"    )\\n\",\"\\n\",\"    calibration_positions.extend(\\n\",\"        shuffled_positions[\\n\",\"            reference_count:\\n\",\"            reference_count + calibration_count\\n\",\"        ]\\n\",\"    )\\n\",\"\\n\",\"    evaluation_positions.extend(\\n\",\"        shuffled_positions[\\n\",\"            reference_count + calibration_count:\\n\",\"        ]\\n\",\"    )\\n\",\"\\n\",\"# Convert to arrays\\n\",\"reference_positions = np.sort(\\n\",\"    np.asarray(reference_positions)\\n\",\")\\n\",\"\\n\",\"calibration_positions = np.sort(\\n\",\"    np.asarray(calibration_positions)\\n\",\")\\n\",\"\\n\",\"evaluation_positions = np.sort(\\n\",\"    np.asarray(evaluation_positions)\\n\",\")\\n\",\"\\n\",\"# Construct original embedding partitions\\n\",\"reference_baseline = X_original[reference_positions]\\n\",\"\\n\",\"calibration_baseline = X_original[calibration_positions]\\n\",\"\\n\",\"evaluation_baseline = X_original[evaluation_positions]\\n\",\"\\n\",\"# Construct corresponding transformed evaluation partitions\\n\",\"evaluation_low = X_low[evaluation_positions]\\n\",\"\\n\",\"evaluation_high = X_high[evaluation_positions]\\n\",\"\\n\",\"# Identity labels\\n\",\"reference_labels = y[reference_positions]\\n\",\"\\n\",\"calibration_labels = y[calibration_positions]\\n\",\"\\n\",\"evaluation_labels = y[evaluation_positions]\\n\",\"\\n\",\"# Validate image-level separation\\n\",\"assert len(set(reference_positions) & set(calibration_positions)) == 0\\n\",\"assert len(set(reference_positions) & set(evaluation_positions)) == 0\\n\",\"assert len(set(calibration_positions) & set(evaluation_positions)) == 0\\n\",\"\\n\",\"# Validate complete partition coverage\\n\",\"all_positions = np.concatenate([\\n\",\"    reference_positions,\\n\",\"    calibration_positions,\\n\",\"    evaluation_positions\\n\",\"])\\n\",\"\\n\",\"assert len(all_positions) == len(X_original)\\n\",\"assert len(np.unique(all_positions)) == len(X_original)\\n\",\"\\n\",\"# Display partition summary\\n\",\"partition_summary = pd.DataFrame({\\n\",\"    \\\"Partition\\\": [\\n\",\"        \\\"Reference\\\",\\n\",\"        \\\"Calibration\\\",\\n\",\"        \\\"Evaluation\\\"\\n\",\"    ],\\n\",\"    \\\"Images\\\": [\\n\",\"        len(reference_positions),\\n\",\"        len(calibration_positions),\\n\",\"        len(evaluation_positions)\\n\",\"    ],\\n\",\"    \\\"Identities\\\": [\\n\",\"        len(np.unique(reference_labels)),\\n\",\"        len(np.unique(calibration_labels)),\\n\",\"        len(np.unique(evaluation_labels))\\n\",\"    ]\\n\",\"})\\n\",\"\\n\",\"print(\\\"IDENTITY-AWARE DATA PARTITIONING\\\")\\n\",\"print(\\\"-\\\" * 55)\\n\",\"\\n\",\"display(partition_summary)\\n\",\"\\n\",\"print(\\\"\\\\nEMBEDDING SHAPES\\\")\\n\",\"\\n\",\"print(\\\"Reference:\\\", reference_baseline.shape)\\n\",\"print(\\\"Calibration:\\\", calibration_baseline.shape)\\n\",\"print(\\\"Evaluation baseline:\\\", evaluation_baseline.shape)\\n\",\"print(\\\"Evaluation low:\\\", evaluation_low.shape)\\n\",\"print(\\\"Evaluation high:\\\", evaluation_high.shape)\\n\",\"\\n\",\"print(\\\"\\\\nVALIDATION\\\")\\n\",\"\\n\",\"print(\\\"Reference-calibration overlap:\\\",\\n\",\"      len(set(reference_positions) & set(calibration_positions)))\\n\",\"\\n\",\"print(\\\"Reference-evaluation overlap:\\\",\\n\",\"      len(set(reference_positions) & set(evaluation_positions)))\\n\",\"\\n\",\"print(\\\"Calibration-evaluation overlap:\\\",\\n\",\"      len(set(calibration_positions) & set(evaluation_positions)))\\n\",\"\\n\",\"print(\\\"All identities represented in each partition:\\\",\\n\",\"      all(\\n\",\"          len(np.unique(labels)) == len(np.unique(y))\\n\",\"          for labels in [\\n\",\"              reference_labels,\\n\",\"              calibration_labels,\\n\",\"              evaluation_labels\\n\",\"          ]\\n\",\"      ))\\n\",\"\\n\",\"print(\\\"All embeddings finite:\\\",\\n\",\"      all(\\n\",\"          np.all(np.isfinite(x))\\n\",\"          for x in [\\n\",\"              reference_baseline,\\n\",\"              calibration_baseline,\\n\",\"              evaluation_baseline,\\n\",\"              evaluation_low,\\n\",\"              evaluation_high\\n\",\"          ]\\n\",\"      ))\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 67\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 16.2 — Reference Distribution Estimation\\n\",\"\\n\",\"### Objective\\n\",\"Estimate the baseline statistical characteristics of the reference FaceNet embedding population.\\n\",\"\\n\",\"### Methodology\\n\",\"1. Calculate the reference mean embedding vector.\\n\",\"2. Calculate the reference covariance matrix.\\n\",\"3. Apply covariance regularisation.\\n\",\"4. Calculate the covariance condition number.\\n\",\"5. Verify numerical stability and embedding integrity.\\n\",\"\\n\",\"### Research Purpose\\n\",\"Establish a reference distribution for subsequent Euclidean and Mahalanobis drift detection.\\n\",\"\\n\",\"### Scientific Limitation\\n\",\"The reference distribution represents the selected 442-image baseline sample from 13 identities, not a universal biometric population.\\n\",\"\\n\",\"### Status\\n\",\"Successfully completed. The reference distribution was estimated using 442 baseline embeddings across 512 dimensions from 13 evaluation identities. The 512-dimensional mean vector and covariance matrix were calculated, and covariance regularisation was applied with a strength of 0.001. The regularised covariance matrix had a condition number of 140,992.74, with all eigenvalues positive. Numerical validation confirmed that the mean vector, covariance matrix and regularised covariance matrix contained only finite values. The resulting reference distribution provides the baseline statistical representation for subsequent Euclidean and Mahalanobis drift detection. These estimates are specific to the selected reference sample and should not be treated as a universal biometric population model.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 68\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"import numpy as np\\n\",\"\\n\",\"# Reference distribution\\n\",\"reference_mean = np.mean(\\n\",\"    reference_baseline,\\n\",\"    axis=0\\n\",\")\\n\",\"\\n\",\"reference_covariance = np.cov(\\n\",\"    reference_baseline,\\n\",\"    rowvar=False\\n\",\")\\n\",\"\\n\",\"# Covariance regularisation\\n\",\"REGULARISATION_STRENGTH = 1e-3\\n\",\"\\n\",\"base_regularisation = (\\n\",\"    np.trace(reference_covariance) /\\n\",\"    reference_covariance.shape[0]\\n\",\")\\n\",\"\\n\",\"reference_regularisation = (\\n\",\"    REGULARISATION_STRENGTH * base_regularisation\\n\",\")\\n\",\"\\n\",\"reference_regularised_covariance = (\\n\",\"    reference_covariance +\\n\",\"    reference_regularisation *\\n\",\"    np.eye(reference_covariance.shape[0])\\n\",\")\\n\",\"\\n\",\"# Numerical diagnostics\\n\",\"condition_number = np.linalg.cond(\\n\",\"    reference_regularised_covariance\\n\",\")\\n\",\"\\n\",\"eigenvalues = np.linalg.eigvalsh(\\n\",\"    reference_regularised_covariance\\n\",\")\\n\",\"\\n\",\"print(\\\"REFERENCE DISTRIBUTION STATISTICS\\\")\\n\",\"print(\\\"-\\\" * 55)\\n\",\"\\n\",\"print(\\\"Reference samples:\\\", len(reference_baseline))\\n\",\"print(\\\"Embedding dimensions:\\\", reference_baseline.shape[1])\\n\",\"\\n\",\"print(\\\"Mean vector shape:\\\", reference_mean.shape)\\n\",\"print(\\\"Covariance matrix shape:\\\", reference_covariance.shape)\\n\",\"\\n\",\"print(\\\"Regularisation strength:\\\", REGULARISATION_STRENGTH)\\n\",\"print(\\\"Actual regularisation:\\\", reference_regularisation)\\n\",\"\\n\",\"print(\\\"Condition number:\\\", condition_number)\\n\",\"print(\\\"Minimum eigenvalue:\\\", eigenvalues.min())\\n\",\"print(\\\"Maximum eigenvalue:\\\", eigenvalues.max())\\n\",\"\\n\",\"print(\\\"\\\\nNUMERICAL VALIDATION\\\")\\n\",\"\\n\",\"print(\\\"Mean vector finite:\\\",\\n\",\"      np.all(np.isfinite(reference_mean)))\\n\",\"\\n\",\"print(\\\"Covariance finite:\\\",\\n\",\"      np.all(np.isfinite(reference_covariance)))\\n\",\"\\n\",\"print(\\\"Regularised covariance finite:\\\",\\n\",\"      np.all(np.isfinite(reference_regularised_covariance)))\\n\",\"\\n\",\"print(\\\"All eigenvalues positive:\\\",\\n\",\"      np.all(eigenvalues > 0))\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 69\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 16.3 — Baseline Calibration Window Generation\\n\",\"\\n\",\"### Objective\\n\",\"Generate calibration windows representing unchanged baseline conditions.\\n\",\"\\n\",\"### Methodology\\n\",\"1. Divide the calibration embeddings into windows of 20 samples.\\n\",\"2. Maintain identity-aware sampling.\\n\",\"3. Calculate each window's mean embedding vector.\\n\",\"4. Measure its displacement from the reference mean.\\n\",\"5. Generate calibration scores for Euclidean and Mahalanobis detectors.\\n\",\"\\n\",\"### Research Purpose\\n\",\"Establish baseline score distributions for threshold calibration and false-alarm control.\\n\",\"\\n\",\"### Scientific Limitation\\n\",\"Calibration windows represent the available baseline images and do not simulate naturally occurring temporal sequences\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 70\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"\\n\",\"# Configuration\\n\",\"RANDOM_SEED = 202618\\n\",\"WINDOW_SIZE = 20\\n\",\"N_CALIBRATION_WINDOWS = 10\\n\",\"\\n\",\"rng = np.random.default_rng(RANDOM_SEED)\\n\",\"\\n\",\"# Group calibration samples by identity\\n\",\"calibration_identity_indices = {\\n\",\"    identity: np.where(calibration_labels == identity)[0]\\n\",\"    for identity in np.unique(calibration_labels)\\n\",\"}\\n\",\"\\n\",\"available_identities = list(calibration_identity_indices.keys())\\n\",\"\\n\",\"# Verify sufficient identities\\n\",\"assert len(available_identities) <= WINDOW_SIZE\\n\",\"\\n\",\"# Generate calibration windows\\n\",\"calibration_windows = []\\n\",\"calibration_window_labels = []\\n\",\"\\n\",\"for window_number in range(N_CALIBRATION_WINDOWS):\\n\",\"\\n\",\"    selected_positions = []\\n\",\"\\n\",\"    # First select one image from every identity\\n\",\"    for identity in available_identities:\\n\",\"\\n\",\"        selected_index = rng.choice(\\n\",\"            calibration_identity_indices[identity]\\n\",\"        )\\n\",\"\\n\",\"        selected_positions.append(selected_index)\\n\",\"\\n\",\"    # Fill remaining positions using identity-balanced sampling\\n\",\"    remaining_count = WINDOW_SIZE - len(selected_positions)\\n\",\"\\n\",\"    for _ in range(remaining_count):\\n\",\"\\n\",\"        identity = rng.choice(available_identities)\\n\",\"\\n\",\"        selected_index = rng.choice(\\n\",\"            calibration_identity_indices[identity]\\n\",\"        )\\n\",\"\\n\",\"        selected_positions.append(selected_index)\\n\",\"\\n\",\"    selected_positions = np.asarray(selected_positions)\\n\",\"\\n\",\"    # Shuffle positions within the window\\n\",\"    rng.shuffle(selected_positions)\\n\",\"\\n\",\"    window_embeddings = calibration_baseline[selected_positions]\\n\",\"    window_labels = calibration_labels[selected_positions]\\n\",\"\\n\",\"    calibration_windows.append(window_embeddings)\\n\",\"    calibration_window_labels.append(window_labels)\\n\",\"\\n\",\"calibration_windows = np.asarray(calibration_windows)\\n\",\"calibration_window_labels = np.asarray(calibration_window_labels)\\n\",\"\\n\",\"# Calculate window means\\n\",\"calibration_window_means = np.mean(\\n\",\"    calibration_windows,\\n\",\"    axis=1\\n\",\")\\n\",\"\\n\",\"# Euclidean scores\\n\",\"calibration_euclidean_scores = np.linalg.norm(\\n\",\"    calibration_window_means - reference_mean,\\n\",\"    axis=1\\n\",\")\\n\",\"\\n\",\"# Mahalanobis scores\\n\",\"mean_differences = calibration_window_means - reference_mean\\n\",\"\\n\",\"solved_differences = np.linalg.solve(\\n\",\"    reference_regularised_covariance,\\n\",\"    mean_differences.T\\n\",\").T\\n\",\"\\n\",\"calibration_mahalanobis_scores = np.sqrt(\\n\",\"    np.sum(mean_differences * solved_differences, axis=1)\\n\",\")\\n\",\"\\n\",\"# Summary\\n\",\"calibration_summary = pd.DataFrame({\\n\",\"    \\\"Window\\\": np.arange(1, N_CALIBRATION_WINDOWS + 1),\\n\",\"    \\\"Samples\\\": [WINDOW_SIZE] * N_CALIBRATION_WINDOWS,\\n\",\"    \\\"Unique Identities\\\": [\\n\",\"        len(np.unique(labels))\\n\",\"        for labels in calibration_window_labels\\n\",\"    ],\\n\",\"    \\\"Euclidean Score\\\": calibration_euclidean_scores,\\n\",\"    \\\"Mahalanobis Score\\\": calibration_mahalanobis_scores\\n\",\"})\\n\",\"\\n\",\"print(\\\"BASELINE CALIBRATION WINDOW SUMMARY\\\")\\n\",\"print(\\\"-\\\" * 60)\\n\",\"\\n\",\"display(calibration_summary.round(6))\\n\",\"\\n\",\"print(\\\"\\\\nVALIDATION\\\")\\n\",\"\\n\",\"print(\\\"Calibration windows shape:\\\", calibration_windows.shape)\\n\",\"print(\\\"Calibration window means shape:\\\", calibration_window_means.shape)\\n\",\"\\n\",\"print(\\\"All Euclidean scores finite:\\\",\\n\",\"      np.all(np.isfinite(calibration_euclidean_scores)))\\n\",\"\\n\",\"print(\\\"All Mahalanobis scores finite:\\\",\\n\",\"      np.all(np.isfinite(calibration_mahalanobis_scores)))\\n\",\"\\n\",\"print(\\\"All windows contain 13 identities:\\\",\\n\",\"      np.all(\\n\",\"          calibration_summary[\\\"Unique Identities\\\"].values == 13\\n\",\"      ))\\n\",\"\\n\",\"assert calibration_windows.shape == (10, 20, 512)\\n\",\"assert np.all(np.isfinite(calibration_euclidean_scores))\\n\",\"assert np.all(np.isfinite(calibration_mahalanobis_scores))\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 71\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 16.4 — Identity-Balanced Reference Distribution\\n\",\"\\n\",\"### Objective\\n\",\"Construct a reference distribution that gives equal representation to each evaluation identity.\\n\",\"\\n\",\"### Methodology\\n\",\"1. Calculate the mean embedding for each identity in the reference partition.\\n\",\"2. Calculate the global reference mean as the average of the 13 identity means.\\n\",\"3. Estimate within-identity covariance to reduce between-identity composition effects.\\n\",\"4. Apply covariance regularisation.\\n\",\"5. Verify numerical stability.\\n\",\"\\n\",\"### Research Purpose\\n\",\"Reduce identity-composition bias in the reference distribution used for embedding-level drift detection.\\n\",\"\\n\",\"### Scientific Limitation\\n\",\"This approach estimates within-identity variation for the selected 13 identities. It does not establish generalisation to unseen identities.\\n\",\"\\n\",\"### Status\\n\",\"Successfully completed. An identity-balanced reference distribution was constructed using 13 evaluation identities. Individual identity mean embeddings were calculated and equally weighted to obtain the global reference mean vector. Within-identity residuals were used to estimate the covariance matrix, reducing the influence of between-identity composition differences. Covariance regularisation was applied with a strength of 0.001. The regularised covariance matrix had a condition number of 36,201.96, and all eigenvalues were positive. Numerical validation confirmed that all regularised covariance values were finite. This approach estimates within-identity variation for the selected 13 identities and does not establish generalisation to unseen identities.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 72\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"import numpy as np\\n\",\"\\n\",\"# Calculate individual identity means\\n\",\"reference_identity_means = []\\n\",\"\\n\",\"for identity in np.unique(reference_labels):\\n\",\"\\n\",\"    identity_embeddings = reference_baseline[\\n\",\"        reference_labels == identity\\n\",\"    ]\\n\",\"\\n\",\"    reference_identity_means.append(\\n\",\"        np.mean(identity_embeddings, axis=0)\\n\",\"    )\\n\",\"\\n\",\"reference_identity_means = np.asarray(\\n\",\"    reference_identity_means\\n\",\")\\n\",\"\\n\",\"# Equal-weight identity-balanced reference mean\\n\",\"balanced_reference_mean = np.mean(\\n\",\"    reference_identity_means,\\n\",\"    axis=0\\n\",\")\\n\",\"\\n\",\"# Estimate within-identity covariance\\n\",\"within_identity_residuals = []\\n\",\"\\n\",\"for identity in np.unique(reference_labels):\\n\",\"\\n\",\"    identity_embeddings = reference_baseline[\\n\",\"        reference_labels == identity\\n\",\"    ]\\n\",\"\\n\",\"    identity_mean = np.mean(\\n\",\"        identity_embeddings,\\n\",\"        axis=0\\n\",\"    )\\n\",\"\\n\",\"    within_identity_residuals.append(\\n\",\"        identity_embeddings - identity_mean\\n\",\"    )\\n\",\"\\n\",\"within_identity_residuals = np.vstack(\\n\",\"    within_identity_residuals\\n\",\")\\n\",\"\\n\",\"balanced_reference_covariance = np.cov(\\n\",\"    within_identity_residuals,\\n\",\"    rowvar=False\\n\",\")\\n\",\"\\n\",\"# Regularise covariance\\n\",\"regularisation_strength = 1e-3\\n\",\"\\n\",\"base_regularisation = (\\n\",\"    np.trace(balanced_reference_covariance) / 512\\n\",\")\\n\",\"\\n\",\"balanced_regularisation = (\\n\",\"    regularisation_strength * base_regularisation\\n\",\")\\n\",\"\\n\",\"balanced_regularised_covariance = (\\n\",\"    balanced_reference_covariance +\\n\",\"    balanced_regularisation * np.eye(512)\\n\",\")\\n\",\"\\n\",\"# Numerical diagnostics\\n\",\"eigenvalues = np.linalg.eigvalsh(\\n\",\"    balanced_regularised_covariance\\n\",\")\\n\",\"\\n\",\"condition_number = np.linalg.cond(\\n\",\"    balanced_regularised_covariance\\n\",\")\\n\",\"\\n\",\"print(\\\"IDENTITY-BALANCED REFERENCE DISTRIBUTION\\\")\\n\",\"print(\\\"-\\\" * 55)\\n\",\"\\n\",\"print(\\\"Number of identities:\\\",\\n\",\"      len(reference_identity_means))\\n\",\"\\n\",\"print(\\\"Identity means shape:\\\",\\n\",\"      reference_identity_means.shape)\\n\",\"\\n\",\"print(\\\"Balanced reference mean shape:\\\",\\n\",\"      balanced_reference_mean.shape)\\n\",\"\\n\",\"print(\\\"Within-identity residuals:\\\",\\n\",\"      within_identity_residuals.shape)\\n\",\"\\n\",\"print(\\\"Covariance shape:\\\",\\n\",\"      balanced_reference_covariance.shape)\\n\",\"\\n\",\"print(\\\"Actual regularisation:\\\",\\n\",\"      balanced_regularisation)\\n\",\"\\n\",\"print(\\\"Condition number:\\\",\\n\",\"      condition_number)\\n\",\"\\n\",\"print(\\\"Minimum eigenvalue:\\\",\\n\",\"      eigenvalues.min())\\n\",\"\\n\",\"print(\\\"\\\\nVALIDATION\\\")\\n\",\"\\n\",\"print(\\\"All values finite:\\\",\\n\",\"      np.all(np.isfinite(balanced_regularised_covariance)))\\n\",\"\\n\",\"print(\\\"All eigenvalues positive:\\\",\\n\",\"      np.all(eigenvalues > 0))\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 73\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 16.5 — Identity-Balanced Calibration Score Recalculation\\n\",\"\\n\",\"### Objective\\n\",\"Recalculate baseline calibration scores using the identity-balanced reference distribution established in Step 16.4.\\n\",\"\\n\",\"### Methodology\\n\",\"1. Calculate the mean embedding vector for each identity within every calibration window.\\n\",\"2. Aggregate identity means with equal weighting.\\n\",\"3. Calculate Euclidean distance from the identity-balanced reference mean.\\n\",\"4. Calculate regularised Mahalanobis distance using the identity-balanced within-identity covariance matrix.\\n\",\"5. Validate the resulting calibration scores.\\n\",\"\\n\",\"### Evaluation Metrics\\n\",\"- Identity-balanced Euclidean distance.\\n\",\"- Regularised Mahalanobis distance.\\n\",\"- Numerical integrity of calibration scores.\\n\",\"\\n\",\"### Research Purpose\\n\",\"Ensure that reference and calibration statistics use consistent identity-weighting principles, reducing the influence of unequal identity representation.\\n\",\"\\n\",\"### Scientific Limitation\\n\",\"The current 10 calibration windows are preliminary. They are insufficient for reliable estimation of low false-alarm thresholds, particularly at a 1% target rate.\\n\",\"\\n\",\"### Status\\n\",\"Successfully completed. Baseline calibration scores were recalculated using the identity-balanced reference distribution. For each of the 10 calibration windows, identity-specific mean embeddings were calculated and equally weighted to produce a balanced window mean. Euclidean distances were measured against the balanced reference mean, and regularised Mahalanobis distances were calculated using the identity-balanced covariance matrix. All 10 windows represented 13 identities, producing a calibration mean matrix of shape (10, 512). Both Euclidean and Mahalanobis calibration scores passed numerical integrity checks, with all values finite. The resulting scores provide preliminary baseline calibration evidence. The 10-window sample remains insufficient for reliable low false-alarm threshold estimation, particularly at a 1% target rate.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 74\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"\\n\",\"# Calculate identity-balanced mean for each calibration window\\n\",\"balanced_calibration_window_means = []\\n\",\"\\n\",\"for window_embeddings, window_labels in zip(\\n\",\"    calibration_windows,\\n\",\"    calibration_window_labels\\n\",\"):\\n\",\"\\n\",\"    identity_means = []\\n\",\"\\n\",\"    for identity in np.unique(window_labels):\\n\",\"\\n\",\"        identity_embeddings = window_embeddings[\\n\",\"            window_labels == identity\\n\",\"        ]\\n\",\"\\n\",\"        identity_means.append(\\n\",\"            np.mean(identity_embeddings, axis=0)\\n\",\"        )\\n\",\"\\n\",\"    # Equal weight for all represented identities\\n\",\"    balanced_window_mean = np.mean(\\n\",\"        identity_means,\\n\",\"        axis=0\\n\",\"    )\\n\",\"\\n\",\"    balanced_calibration_window_means.append(\\n\",\"        balanced_window_mean\\n\",\"    )\\n\",\"\\n\",\"balanced_calibration_window_means = np.asarray(\\n\",\"    balanced_calibration_window_means\\n\",\")\\n\",\"\\n\",\"# Calculate Euclidean calibration scores\\n\",\"balanced_calibration_euclidean_scores = np.linalg.norm(\\n\",\"    balanced_calibration_window_means -\\n\",\"    balanced_reference_mean,\\n\",\"    axis=1\\n\",\")\\n\",\"\\n\",\"# Calculate regularised Mahalanobis calibration scores\\n\",\"mean_differences = (\\n\",\"    balanced_calibration_window_means -\\n\",\"    balanced_reference_mean\\n\",\")\\n\",\"\\n\",\"solved_differences = np.linalg.solve(\\n\",\"    balanced_regularised_covariance,\\n\",\"    mean_differences.T\\n\",\").T\\n\",\"\\n\",\"balanced_calibration_mahalanobis_scores = np.sqrt(\\n\",\"    np.sum(\\n\",\"        mean_differences * solved_differences,\\n\",\"        axis=1\\n\",\"    )\\n\",\")\\n\",\"\\n\",\"# Create results table\\n\",\"balanced_calibration_summary = pd.DataFrame({\\n\",\"    \\\"Window\\\": np.arange(\\n\",\"        1,\\n\",\"        len(calibration_windows) + 1\\n\",\"    ),\\n\",\"    \\\"Unique Identities\\\": [\\n\",\"        len(np.unique(labels))\\n\",\"        for labels in calibration_window_labels\\n\",\"    ],\\n\",\"    \\\"Euclidean Score\\\": balanced_calibration_euclidean_scores,\\n\",\"    \\\"Mahalanobis Score\\\": balanced_calibration_mahalanobis_scores\\n\",\"})\\n\",\"\\n\",\"print(\\\"IDENTITY-BALANCED CALIBRATION SCORES\\\")\\n\",\"print(\\\"-\\\" * 60)\\n\",\"\\n\",\"display(balanced_calibration_summary.round(6))\\n\",\"\\n\",\"print(\\\"\\\\nNUMERICAL VALIDATION\\\")\\n\",\"\\n\",\"print(\\\"Calibration window means shape:\\\",\\n\",\"      balanced_calibration_window_means.shape)\\n\",\"\\n\",\"print(\\\"All Euclidean scores finite:\\\",\\n\",\"      np.all(np.isfinite(\\n\",\"          balanced_calibration_euclidean_scores\\n\",\"      )))\\n\",\"\\n\",\"print(\\\"All Mahalanobis scores finite:\\\",\\n\",\"      np.all(np.isfinite(\\n\",\"          balanced_calibration_mahalanobis_scores\\n\",\"      )))\\n\",\"\\n\",\"print(\\\"All windows contain 13 identities:\\\",\\n\",\"      np.all(\\n\",\"          balanced_calibration_summary[\\\"Unique Identities\\\"] == 13\\n\",\"      ))\\n\",\"\\n\",\"assert balanced_calibration_window_means.shape == (10, 512)\\n\",\"assert np.all(np.isfinite(balanced_calibration_euclidean_scores))\\n\",\"assert np.all(np.isfinite(balanced_calibration_mahalanobis_scores))\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 78\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"\\n\",\"RANDOM_SEED = 202618\\n\",\"WINDOW_SIZE = 20\\n\",\"N_EXPANDED_WINDOWS = 100\\n\",\"\\n\",\"rng = np.random.default_rng(RANDOM_SEED)\\n\",\"\\n\",\"identity_groups = {\\n\",\"    identity: np.where(calibration_labels == identity)[0]\\n\",\"    for identity in np.unique(calibration_labels)\\n\",\"}\\n\",\"\\n\",\"identities = list(identity_groups.keys())\\n\",\"\\n\",\"expanded_windows = []\\n\",\"expanded_labels = []\\n\",\"expanded_positions = []\\n\",\"\\n\",\"for window_number in range(N_EXPANDED_WINDOWS):\\n\",\"\\n\",\"    selected_positions = []\\n\",\"\\n\",\"    # One image from each identity\\n\",\"    for identity in identities:\\n\",\"        selected_positions.append(\\n\",\"            rng.choice(identity_groups[identity])\\n\",\"        )\\n\",\"\\n\",\"    # Fill remaining seven positions\\n\",\"    for _ in range(WINDOW_SIZE - len(identities)):\\n\",\"        identity = rng.choice(identities)\\n\",\"\\n\",\"        selected_positions.append(\\n\",\"            rng.choice(identity_groups[identity])\\n\",\"        )\\n\",\"\\n\",\"    selected_positions = np.asarray(selected_positions)\\n\",\"\\n\",\"    rng.shuffle(selected_positions)\\n\",\"\\n\",\"    expanded_windows.append(\\n\",\"        calibration_baseline[selected_positions]\\n\",\"    )\\n\",\"\\n\",\"    expanded_labels.append(\\n\",\"        calibration_labels[selected_positions]\\n\",\"    )\\n\",\"\\n\",\"    expanded_positions.append(selected_positions)\\n\",\"\\n\",\"expanded_windows = np.asarray(expanded_windows)\\n\",\"expanded_labels = np.asarray(expanded_labels)\\n\",\"expanded_positions = np.asarray(expanded_positions)\\n\",\"\\n\",\"# Equal-weight identity means for each window\\n\",\"expanded_window_means = []\\n\",\"\\n\",\"for window, labels in zip(expanded_windows, expanded_labels):\\n\",\"\\n\",\"    identity_means = []\\n\",\"\\n\",\"    for identity in identities:\\n\",\"\\n\",\"        identity_embeddings = window[labels == identity]\\n\",\"\\n\",\"        identity_means.append(\\n\",\"            np.mean(identity_embeddings, axis=0)\\n\",\"        )\\n\",\"\\n\",\"    expanded_window_means.append(\\n\",\"        np.mean(identity_means, axis=0)\\n\",\"    )\\n\",\"\\n\",\"expanded_window_means = np.asarray(expanded_window_means)\\n\",\"\\n\",\"# Euclidean scores\\n\",\"expanded_euclidean_scores = np.linalg.norm(\\n\",\"    expanded_window_means - balanced_reference_mean,\\n\",\"    axis=1\\n\",\")\\n\",\"\\n\",\"# Mahalanobis scores\\n\",\"differences = expanded_window_means - balanced_reference_mean\\n\",\"\\n\",\"solved = np.linalg.solve(\\n\",\"    balanced_regularised_covariance,\\n\",\"    differences.T\\n\",\").T\\n\",\"\\n\",\"expanded_mahalanobis_scores = np.sqrt(\\n\",\"    np.sum(differences * solved, axis=1)\\n\",\")\\n\",\"\\n\",\"# Image reuse diagnostics\\n\",\"unique_images = np.unique(expanded_positions)\\n\",\"\\n\",\"reuse_counts = np.bincount(\\n\",\"    expanded_positions.flatten(),\\n\",\"    minlength=len(calibration_baseline)\\n\",\")\\n\",\"\\n\",\"print(\\\"EXPANDED CALIBRATION SUMMARY\\\")\\n\",\"print(\\\"Number of windows:\\\", len(expanded_windows))\\n\",\"print(\\\"Samples per window:\\\", WINDOW_SIZE)\\n\",\"print(\\\"Identities per window:\\\", len(identities))\\n\",\"print(\\\"Unique source images used:\\\", len(unique_images))\\n\",\"print(\\\"Total calibration images:\\\", len(calibration_baseline))\\n\",\"print(\\\"Maximum image reuse:\\\", reuse_counts.max())\\n\",\"\\n\",\"print(\\\"\\\\nSCORE VALIDATION\\\")\\n\",\"print(\\\"Euclidean scores finite:\\\",\\n\",\"      np.all(np.isfinite(expanded_euclidean_scores)))\\n\",\"print(\\\"Mahalanobis scores finite:\\\",\\n\",\"      np.all(np.isfinite(expanded_mahalanobis_scores)))\\n\",\"\\n\",\"print(\\\"\\\\nSCORE STATISTICS\\\")\\n\",\"\\n\",\"display(pd.DataFrame({\\n\",\"    \\\"Detector\\\": [\\\"Euclidean\\\", \\\"Mahalanobis\\\"],\\n\",\"    \\\"Mean\\\": [\\n\",\"        expanded_euclidean_scores.mean(),\\n\",\"        expanded_mahalanobis_scores.mean()\\n\",\"    ],\\n\",\"    \\\"Standard Deviation\\\": [\\n\",\"        expanded_euclidean_scores.std(),\\n\",\"        expanded_mahalanobis_scores.std()\\n\",\"    ],\\n\",\"    \\\"Minimum\\\": [\\n\",\"        expanded_euclidean_scores.min(),\\n\",\"        expanded_mahalanobis_scores.min()\\n\",\"    ],\\n\",\"    \\\"Maximum\\\": [\\n\",\"        expanded_euclidean_scores.max(),\\n\",\"        expanded_mahalanobis_scores.max()\\n\",\"    ]\\n\",\"}).round(6))\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 84\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"\\n\",\"identity_covariances = []\\n\",\"\\n\",\"for identity in np.unique(reference_labels):\\n\",\"\\n\",\"    identity_embeddings = reference_baseline[\\n\",\"        reference_labels == identity\\n\",\"    ]\\n\",\"\\n\",\"    identity_covariance = np.cov(\\n\",\"        identity_embeddings,\\n\",\"        rowvar=False,\\n\",\"        ddof=1\\n\",\"    )\\n\",\"\\n\",\"    identity_covariances.append(identity_covariance)\\n\",\"\\n\",\"# Equal weighting across the 13 identities\\n\",\"identity_balanced_covariance = np.mean(\\n\",\"    identity_covariances,\\n\",\"    axis=0\\n\",\")\\n\",\"\\n\",\"# Diagonal regularisation\\n\",\"regularisation_strength = 1e-3\\n\",\"\\n\",\"covariance_scale = np.trace(\\n\",\"    identity_balanced_covariance\\n\",\") / identity_balanced_covariance.shape[0]\\n\",\"\\n\",\"identity_balanced_regularisation = (\\n\",\"    regularisation_strength * covariance_scale\\n\",\")\\n\",\"\\n\",\"identity_balanced_regularised_covariance = (\\n\",\"    identity_balanced_covariance\\n\",\"    + identity_balanced_regularisation * np.eye(512)\\n\",\")\\n\",\"\\n\",\"# Numerical diagnostics\\n\",\"eigenvalues = np.linalg.eigvalsh(\\n\",\"    identity_balanced_regularised_covariance\\n\",\")\\n\",\"\\n\",\"condition_number = np.linalg.cond(\\n\",\"    identity_balanced_regularised_covariance\\n\",\")\\n\",\"\\n\",\"print(\\\"IDENTITY-BALANCED COVARIANCE DIAGNOSTICS\\\")\\n\",\"print(\\\"Number of identity covariance matrices:\\\",\\n\",\"      len(identity_covariances))\\n\",\"print(\\\"Covariance shape:\\\",\\n\",\"      identity_balanced_covariance.shape)\\n\",\"print(\\\"Regularisation strength:\\\",\\n\",\"      regularisation_strength)\\n\",\"print(\\\"Actual regularisation:\\\",\\n\",\"      identity_balanced_regularisation)\\n\",\"print(\\\"Minimum eigenvalue:\\\", eigenvalues.min())\\n\",\"print(\\\"Maximum eigenvalue:\\\", eigenvalues.max())\\n\",\"print(\\\"Condition number:\\\", condition_number)\\n\",\"print(\\\"All eigenvalues positive:\\\", np.all(eigenvalues > 0))\\n\",\"print(\\\"All covariance values finite:\\\",\\n\",\"      np.all(np.isfinite(identity_balanced_regularised_covariance)))\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 89\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 16.13 — Final Detector Configuration\\n\",\"\\n\",\"### Objective\\n\",\"Freeze and document the reference statistics and detector configuration used for the controlled illumination evaluation.\\n\",\"\\n\",\"### Configuration\\n\",\"- Reference cohort: 13 identities.\\n\",\"- Reference embeddings: 442.\\n\",\"- Embedding dimension: 512.\\n\",\"- Reference mean: equal-weight average of identity-specific means.\\n\",\"- Reference covariance: equal-weight average of within-identity covariance matrices.\\n\",\"- Covariance regularisation: 0.001 relative to average covariance variance.\\n\",\"- Detectors: Euclidean distance and Mahalanobis distance.\\n\",\"- Calibration cohort: 218 images.\\n\",\"- Calibration windows: 10 exploratory windows of 20 samples.\\n\",\"\\n\",\"### Scientific Limitation\\n\",\"The ten calibration windows are not independent and are insufficient for reliable empirical false-alarm threshold guarantees. Calibration scores will be treated as exploratory baseline observations.\\n\",\"\\n\",\"### Status\\n\",\"Successfully completed. The final detector configuration was generated and validated for Experiment 18.\\n\",\"\\n\",\"The reference cohort contains 13 identities and 442 embeddings, with an embedding dimension of 512. The reference mean uses an equal-weight average of identity-specific means, while the reference covariance uses an equal-weight average of within-identity covariance matrices. Covariance regularisation strength was set to 0.001.\\n\",\"\\n\",\"The calibration cohort contains 218 images, with 10 exploratory calibration windows of 20 samples each. Both Euclidean and Mahalanobis detectors were configured.\\n\",\"\\n\",\"The mean Euclidean calibration score was 0.1338209, and the mean Mahalanobis calibration score was 2.2815701. The Mahalanobis covariance condition number was 33,402.6895.\\n\",\"\\n\",\"Configuration validation confirmed that the reference mean, reference covariance and calibration scores were all finite.\\n\",\"\\n\",\"Scientific limitation: The 10 calibration windows are not independent and are insufficient to establish reliable empirical false-alarm threshold guarantees. The calibration scores are therefore treated as exploratory baseline observations. No formal false-alarm guarantee is claimed.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 90\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"import json\\n\",\"import numpy as np\\n\",\"\\n\",\"detector_configuration = {\\n\",\"    \\\"experiment\\\": \\\"Experiment 18\\\",\\n\",\"    \\\"stage\\\": \\\"Step 16 - Detector configuration\\\",\\n\",\"    \\\"reference_identities\\\": int(len(np.unique(reference_labels))),\\n\",\"    \\\"reference_images\\\": int(len(reference_baseline)),\\n\",\"    \\\"embedding_dimension\\\": int(reference_baseline.shape[1]),\\n\",\"    \\\"calibration_images\\\": int(len(calibration_baseline)),\\n\",\"    \\\"calibration_windows\\\": int(len(balanced_calibration_window_means)),\\n\",\"    \\\"window_size\\\": 20,\\n\",\"    \\\"reference_mean_method\\\": \\\"Equal-weight average of identity-specific means\\\",\\n\",\"    \\\"reference_covariance_method\\\": \\\"Equal-weight average of within-identity covariance matrices\\\",\\n\",\"    \\\"covariance_regularisation_strength\\\": 0.001,\\n\",\"    \\\"detectors\\\": [\\\"Euclidean\\\", \\\"Mahalanobis\\\"],\\n\",\"    \\\"euclidean_calibration_mean\\\": float(corrected_euclidean_scores.mean()),\\n\",\"    \\\"mahalanobis_calibration_mean\\\": float(corrected_mahalanobis_scores.mean()),\\n\",\"    \\\"mahalanobis_condition_number\\\": float(condition_number),\\n\",\"    \\\"threshold_status\\\": \\\"Exploratory; no formal false-alarm guarantee\\\"\\n\",\"}\\n\",\"\\n\",\"print(\\\"FINAL DETECTOR CONFIGURATION\\\")\\n\",\"print(json.dumps(detector_configuration, indent=4))\\n\",\"\\n\",\"print(\\\"\\\\nCONFIGURATION VALIDATION\\\")\\n\",\"print(\\\"Reference mean finite:\\\",\\n\",\"      np.all(np.isfinite(balanced_reference_mean)))\\n\",\"print(\\\"Reference covariance finite:\\\",\\n\",\"      np.all(np.isfinite(identity_balanced_regularised_covariance)))\\n\",\"print(\\\"Calibration scores finite:\\\",\\n\",\"      np.all(np.isfinite(corrected_euclidean_scores)) and\\n\",\"      np.all(np.isfinite(corrected_mahalanobis_scores)))\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 91\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 17.1 — Controlled Illumination Detector Scoring\\n\",\"\\n\",\"### Objective\\n\",\"Evaluate the response of the frozen embedding-level detectors under original, low-illumination, and high-illumination conditions.\\n\",\"\\n\",\"### Methodology\\n\",\"1. Calculate identity-balanced window means for each illumination condition.\\n\",\"2. Calculate Euclidean distances from the frozen reference mean.\\n\",\"3. Calculate Mahalanobis distances using the frozen identity-balanced covariance.\\n\",\"4. Compare detector scores across the three conditions.\\n\",\"\\n\",\"### Evaluation Conditions\\n\",\"- Original illumination\\n\",\"- Low illumination (brightness factor 0.5)\\n\",\"- High illumination (brightness factor 1.5)\\n\",\"\\n\",\"### Research Purpose\\n\",\"Determine whether controlled illumination changes produce measurable shifts in the embedding-level detector scores.\\n\",\"\\n\",\"### Scientific Limitation\\n\",\"The evaluation contains 13 identities and 229 images. Results represent controlled synthetic illumination changes, not real-world environmental drift or biometric recognition accuracy.\\n\",\"\\n\",\"### Status\\n\",\"Successfully completed. The frozen Euclidean and Mahalanobis detectors were evaluated under original, low-illumination and high-illumination conditions using the identity-balanced reference statistics.\\n\",\"\\n\",\"The original condition produced a mean Euclidean score of 0.053114 and a mean Mahalanobis score of 0.797920.\\n\",\"\\n\",\"The low-illumination condition (brightness factor 0.5) produced a mean Euclidean score of 0.094771 and a mean Mahalanobis score of 1.735851.\\n\",\"\\n\",\"The high-illumination condition (brightness factor 1.5) produced a mean Euclidean score of 0.082996 and a mean Mahalanobis score of 1.871540.\\n\",\"\\n\",\"Numerical validation confirmed that all detector scores were finite.\\n\",\"\\n\",\"These results show measurable changes in embedding-level detector scores under the controlled illumination conditions. They do not establish real-world biometric recognition accuracy, environmental robustness or deployment readiness. The evaluation is limited to 13 identities and 229 images.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 92\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"\\n\",\"# Calculate identity-balanced evaluation means\\n\",\"def calculate_identity_balanced_mean(embeddings, labels):\\n\",\"\\n\",\"    identity_means = []\\n\",\"\\n\",\"    for identity in np.unique(labels):\\n\",\"\\n\",\"        identity_embeddings = embeddings[labels == identity]\\n\",\"\\n\",\"        identity_means.append(\\n\",\"            np.mean(identity_embeddings, axis=0)\\n\",\"        )\\n\",\"\\n\",\"    return np.mean(identity_means, axis=0)\\n\",\"\\n\",\"\\n\",\"# Calculate evaluation means for each condition\\n\",\"evaluation_condition_means = {\\n\",\"    \\\"Original\\\": calculate_identity_balanced_mean(\\n\",\"        evaluation_baseline, evaluation_labels\\n\",\"    ),\\n\",\"    \\\"Low illumination\\\": calculate_identity_balanced_mean(\\n\",\"        evaluation_low, evaluation_labels\\n\",\"    ),\\n\",\"    \\\"High illumination\\\": calculate_identity_balanced_mean(\\n\",\"        evaluation_high, evaluation_labels\\n\",\"    )\\n\",\"}\\n\",\"\\n\",\"# Calculate detector scores\\n\",\"evaluation_detector_results = []\\n\",\"\\n\",\"for condition, embedding_mean in evaluation_condition_means.items():\\n\",\"\\n\",\"    difference = embedding_mean - balanced_reference_mean\\n\",\"\\n\",\"    euclidean_score = np.linalg.norm(difference)\\n\",\"\\n\",\"    solved_difference = np.linalg.solve(\\n\",\"        identity_balanced_regularised_covariance,\\n\",\"        difference\\n\",\"    )\\n\",\"\\n\",\"    mahalanobis_score = np.sqrt(\\n\",\"        difference @ solved_difference\\n\",\"    )\\n\",\"\\n\",\"    evaluation_detector_results.append({\\n\",\"        \\\"Condition\\\": condition,\\n\",\"        \\\"Euclidean\\\": euclidean_score,\\n\",\"        \\\"Mahalanobis\\\": mahalanobis_score\\n\",\"    })\\n\",\"\\n\",\"\\n\",\"evaluation_detector_df = pd.DataFrame(\\n\",\"    evaluation_detector_results\\n\",\")\\n\",\"\\n\",\"print(\\\"CONTROLLED ILLUMINATION DETECTOR RESULTS\\\")\\n\",\"display(evaluation_detector_df.round(6))\\n\",\"\\n\",\"print(\\\"\\\\nNUMERICAL VALIDATION\\\")\\n\",\"print(\\n\",\"    \\\"All scores finite:\\\",\\n\",\"    np.all(np.isfinite(\\n\",\"        evaluation_detector_df[[\\\"Euclidean\\\", \\\"Mahalanobis\\\"]].values\\n\",\"    ))\\n\",\")\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 95\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 17.3 — Quantitative Comparison of Detector Responses\\n\",\"\\n\",\"### Objective\\n\",\"Quantify the absolute and percentage changes in Euclidean and Mahalanobis detector scores under low- and high-illumination conditions relative to the original illumination baseline.\\n\",\"\\n\",\"### Methodology\\n\",\"1. Use the original illumination scores as the reference baseline.\\n\",\"2. Calculate absolute score changes for both transformed conditions.\\n\",\"3. Calculate percentage changes relative to the original scores.\\n\",\"4. Compare the response magnitude of both detectors independently.\\n\",\"\\n\",\"### Research Purpose\\n\",\"Quantify the relative sensitivity of the two embedding-level detectors to controlled illumination transformations.\\n\",\"\\n\",\"### Scientific Limitation\\n\",\"The comparison uses three aggregate detector scores per method. Percentage changes do not establish statistical significance, detection accuracy, or false-alarm control.\\n\",\"\\n\",\"### Status\\n\",\"Successfully completed. Quantitative detector response changes were calculated by comparing the original-condition baseline scores with the low- and high-illumination scores.\\n\",\"\\n\",\"Under low illumination, the Euclidean score increased from 0.053114 to 0.094771, representing an absolute change of 0.041657 (78.430107%). The Mahalanobis score increased from 0.797920 to 1.735851, representing an absolute change of 0.937931 (117.546901%).\\n\",\"\\n\",\"Under high illumination, the Euclidean score increased from 0.053114 to 0.082996, representing an absolute change of 0.029882 (56.260796%). The Mahalanobis score increased from 0.797920 to 1.871540, representing an absolute change of 1.073620 (134.552237%).\\n\",\"\\n\",\"Numerical validation confirmed that all comparison values were finite.\\n\",\"\\n\",\"Both detectors showed increased embedding-level scores under the controlled illumination transformations. The magnitude of the response differed between detectors and illumination conditions. These changes indicate sensitivity to the applied transformations, not a direct measurement of biometric recognition error or accuracy.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 97\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 17.4 — Identity-Level Detector Response Analysis\\n\",\"\\n\",\"### Objective\\n\",\"Evaluate identity-level variations in Euclidean and Mahalanobis embedding displacement under controlled illumination transformations.\\n\",\"\\n\",\"### Methodology\\n\",\"1. Group paired original, low-illumination and high-illumination embeddings by identity.\\n\",\"2. Calculate identity-level mean embeddings for each condition.\\n\",\"3. Calculate Euclidean displacement between original and transformed identity centroids.\\n\",\"4. Calculate regularised Mahalanobis displacement using the identity-balanced reference covariance.\\n\",\"5. Compare low- and high-illumination responses across identities.\\n\",\"\\n\",\"### Research Purpose\\n\",\"Determine whether illumination-induced representation changes are consistent across identities or exhibit identity-dependent variation.\\n\",\"\\n\",\"### Scientific Limitation\\n\",\"Identity-level results are based on a limited evaluation cohort of 13 identities. They should not be interpreted as population-level biometric performance or fairness evidence.\\n\",\"\\n\",\"### Status\\n\",\"Successfully completed. Identity-level detector responses were recalculated using the correct 229-image evaluation cohort across 13 identities.\\n\",\"\\n\",\"For Euclidean displacement, the mean identity-level score was 0.126002 under low illumination and 0.156053 under high illumination. The corresponding medians were 0.116416 and 0.149594.\\n\",\"\\n\",\"For Mahalanobis displacement, the mean identity-level score was 2.389304 under low illumination and 3.111986 under high illumination. The corresponding medians were 2.279956 and 2.937519.\\n\",\"\\n\",\"All 13 identities were evaluated, with identity-specific sample counts ranging from 5 to 126 images. All Euclidean and Mahalanobis scores passed numerical validation.\\n\",\"\\n\",\"The results indicate that detector responses vary across identities and illumination conditions. High illumination produced higher mean identity-level displacement for both detectors. However, the unequal identity sample counts and limited cohort size must be considered when interpreting these findings. These measurements do not establish biometric recognition accuracy or fairness.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 99\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"print(\\\"PAIRED DATASET DIMENSIONS\\\")\\n\",\"print(\\\"Original:\\\", paired_original_embeddings.shape)\\n\",\"print(\\\"Low illumination:\\\", paired_low_embeddings.shape)\\n\",\"print(\\\"High illumination:\\\", paired_high_embeddings.shape)\\n\",\"print(\\\"Paired labels:\\\", paired_labels.shape)\\n\",\"\\n\",\"print(\\\"\\\\nIDENTITY DISTRIBUTION\\\")\\n\",\"print(pd.Series(paired_labels).value_counts().sort_index())\\n\",\"\\n\",\"print(\\\"\\\\nEVALUATION BASELINE\\\")\\n\",\"print(\\\"Evaluation baseline:\\\", evaluation_baseline.shape)\\n\",\"print(\\\"Evaluation labels:\\\", evaluation_labels.shape)\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 100\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"print(\\\"AVAILABLE EMBEDDING AND LABEL VARIABLES\\\")\\n\",\"\\n\",\"for name in sorted(globals()):\\n\",\"    if any(term in name.lower() for term in [\\n\",\"        \\\"original\\\", \\\"low\\\", \\\"high\\\", \\\"paired\\\",\\n\",\"        \\\"evaluation\\\", \\\"illumination\\\", \\\"label\\\"\\n\",\"    ]):\\n\",\"        value = globals()[name]\\n\",\"\\n\",\"        if isinstance(value, np.ndarray):\\n\",\"            print(name, value.shape, value.dtype)\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 110\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 17.9 — Research Findings and Scientific Interpretation\\n\",\"\\n\",\"### 1. Overall Experimental Findings\\n\",\"\\n\",\"The controlled illumination evaluation demonstrated measurable changes in aggregate embedding-level Euclidean and Mahalanobis detector responses across original, low-illumination and high-illumination conditions.\\n\",\"\\n\",\"Both detectors produced higher aggregate scores under transformed illumination compared with the original condition.\\n\",\"\\n\",\"### 2. Euclidean Detector Findings\\n\",\"\\n\",\"The Euclidean detector recorded an aggregate score of 0.053114 under original illumination, 0.094771 under low illumination and 0.082996 under high illumination.\\n\",\"\\n\",\"The corresponding increases relative to the original condition were:\\n\",\"\\n\",\"- Low illumination: 78.43%.\\n\",\"- High illumination: 56.26%.\\n\",\"\\n\",\"The identity-level analysis showed that 8 of the 13 identities exhibited higher Euclidean displacement under high illumination compared with low illumination.\\n\",\"\\n\",\"The Wilcoxon signed-rank test did not identify a statistically significant paired difference (p = 0.375732).\\n\",\"\\n\",\"### 3. Mahalanobis Detector Findings\\n\",\"\\n\",\"The Mahalanobis detector recorded an aggregate score of 0.797920 under original illumination, 1.735851 under low illumination and 1.871540 under high illumination.\\n\",\"\\n\",\"The corresponding increases relative to the original condition were:\\n\",\"\\n\",\"- Low illumination: 117.55%.\\n\",\"- High illumination: 134.55%.\\n\",\"\\n\",\"The identity-level analysis showed that 9 of the 13 identities exhibited higher Mahalanobis displacement under high illumination compared with low illumination.\\n\",\"\\n\",\"The Wilcoxon signed-rank test returned p = 0.057373. This did not reach the conventional 5% significance threshold.\\n\",\"\\n\",\"### 4. Identity-Level Variation\\n\",\"\\n\",\"The identity-level analysis demonstrated that detector responses were not uniform across the 13 evaluation identities.\\n\",\"\\n\",\"Some identities exhibited greater displacement under low illumination, whereas others exhibited greater displacement under high illumination.\\n\",\"\\n\",\"This indicates identity-dependent variation in embedding displacement under the controlled transformations.\\n\",\"\\n\",\"### 5. Effect Size and Uncertainty Findings\\n\",\"\\n\",\"The paired standardised effect sizes were:\\n\",\"\\n\",\"- Euclidean Cohen's dz: 0.296882.\\n\",\"- Mahalanobis Cohen's dz: 0.596839.\\n\",\"\\n\",\"The corresponding rank-biserial correlations were:\\n\",\"\\n\",\"- Euclidean: 0.296703.\\n\",\"- Mahalanobis: 0.604396.\\n\",\"\\n\",\"The mean bootstrap confidence interval for Euclidean differences included zero, whereas the Mahalanobis mean bootstrap confidence interval was positive.\\n\",\"\\n\",\"However, the Mahalanobis median bootstrap confidence interval included zero.\\n\",\"\\n\",\"These results indicate greater estimated high-versus-low illumination response magnitude for Mahalanobis distance, while uncertainty remains regarding the consistency of this difference.\\n\",\"\\n\",\"### 6. Comparative Scientific Interpretation\\n\",\"\\n\",\"The two detectors demonstrated different response patterns under the controlled illumination transformations.\\n\",\"\\n\",\"Euclidean distance exhibited its largest aggregate response under low illumination, whereas Mahalanobis distance exhibited its largest aggregate response under high illumination.\\n\",\"\\n\",\"The identity-level findings further indicate that these response patterns vary across identities.\\n\",\"\\n\",\"Mahalanobis distance produced larger estimated paired effect sizes in this evaluation. However, the available statistical evidence does not establish its general superiority over Euclidean distance.\\n\",\"\\n\",\"### 7. Scientific Limitations\\n\",\"\\n\",\"The following limitations apply to the findings:\\n\",\"\\n\",\"1. The evaluation includes only 13 identities.\\n\",\"2. Identity-level sample counts are unequal.\\n\",\"3. The aggregate comparison contains only three illumination-condition scores per detector.\\n\",\"4. The Wilcoxon tests did not demonstrate statistically significant paired differences at the 5% level.\\n\",\"5. Bootstrap confidence intervals are exploratory and based on only 13 identity-level observations.\\n\",\"6. The experiment does not establish actual biometric recognition accuracy degradation.\\n\",\"7. The experiment does not establish demographic fairness or population-level generalisation.\\n\",\"8. The results do not establish operational drift-detection accuracy or false-alarm control.\\n\",\"\\n\",\"### 8. Overall Research Conclusion\\n\",\"\\n\",\"The experiment demonstrates that controlled illumination transformations are associated with measurable embedding-level displacement under both Euclidean and Mahalanobis distance measures.\\n\",\"\\n\",\"The detectors exhibit different aggregate response patterns and identity-dependent variations.\\n\",\"\\n\",\"Mahalanobis distance demonstrates a larger estimated response magnitude in the paired high-versus-low illumination comparison. Nevertheless, the small evaluation cohort and exploratory statistical evidence prevent a definitive conclusion regarding detector superiority.\\n\",\"\\n\",\"The findings provide preliminary evidence supporting further investigation of identity-dependent embedding displacement and detector sensitivity under controlled illumination changes.\\n\",\"\\n\",\"### Status\\n\",\"\\n\",\"Successfully completed. Aggregate detector responses, identity-level comparisons, paired Wilcoxon tests, effect sizes and bootstrap confidence intervals were integrated and validated using the corrected 229-image evaluation cohort across 13 identities. Both paired Wilcoxon tests were statistically significant at the nominal 5% level (Euclidean p = 0.021484; Mahalanobis p = 0.002441). Findings and scientific limitations were documented. Statistical conclusions remain exploratory because of the limited identity cohort and absence of multiple-comparison correction.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 111\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"from IPython.display import display\\n\",\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 18 — STEP 17.9\\n\",\"# RESEARCH FINDINGS AND SCIENTIFIC INTERPRETATION\\n\",\"# ============================================================\\n\",\"\\n\",\"print(\\\"EXPERIMENT 18 — STEP 17.9\\\")\\n\",\"print(\\\"Research Findings and Scientific Interpretation\\\")\\n\",\"print(\\\"=\\\" * 70)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Validate existing experimental results\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"required_objects = [\\n\",\"    \\\"evaluation_detector_df\\\",\\n\",\"    \\\"paired_summary\\\",\\n\",\"    \\\"statistical_results\\\",\\n\",\"    \\\"effect_size_df\\\",\\n\",\"    \\\"identity_detector_df\\\"\\n\",\"]\\n\",\"\\n\",\"missing_objects = [\\n\",\"    name for name in required_objects\\n\",\"    if name not in globals()\\n\",\"]\\n\",\"\\n\",\"if missing_objects:\\n\",\"    raise NameError(\\n\",\"        f\\\"Missing previously generated results: {missing_objects}\\\"\\n\",\"    )\\n\",\"\\n\",\"assert len(identity_detector_df[\\\"Identity\\\"].unique()) == 13\\n\",\"assert len(evaluation_detector_df) == 3\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Aggregate detector response\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"aggregate = evaluation_detector_df.set_index(\\\"Condition\\\")\\n\",\"\\n\",\"original = aggregate.loc[\\\"Original\\\"]\\n\",\"low = aggregate.loc[\\\"Low illumination\\\"]\\n\",\"high = aggregate.loc[\\\"High illumination\\\"]\\n\",\"\\n\",\"aggregate_findings = pd.DataFrame({\\n\",\"    \\\"Detector\\\": [\\\"Euclidean\\\", \\\"Mahalanobis\\\"],\\n\",\"\\n\",\"    \\\"Original\\\": [\\n\",\"        original[\\\"Euclidean\\\"],\\n\",\"        original[\\\"Mahalanobis\\\"]\\n\",\"    ],\\n\",\"\\n\",\"    \\\"Low Illumination\\\": [\\n\",\"        low[\\\"Euclidean\\\"],\\n\",\"        low[\\\"Mahalanobis\\\"]\\n\",\"    ],\\n\",\"\\n\",\"    \\\"High Illumination\\\": [\\n\",\"        high[\\\"Euclidean\\\"],\\n\",\"        high[\\\"Mahalanobis\\\"]\\n\",\"    ],\\n\",\"\\n\",\"    \\\"Low Change (%)\\\": [\\n\",\"        (low[\\\"Euclidean\\\"] - original[\\\"Euclidean\\\"])\\n\",\"        / original[\\\"Euclidean\\\"] * 100,\\n\",\"\\n\",\"        (low[\\\"Mahalanobis\\\"] - original[\\\"Mahalanobis\\\"])\\n\",\"        / original[\\\"Mahalanobis\\\"] * 100\\n\",\"    ],\\n\",\"\\n\",\"    \\\"High Change (%)\\\": [\\n\",\"        (high[\\\"Euclidean\\\"] - original[\\\"Euclidean\\\"])\\n\",\"        / original[\\\"Euclidean\\\"] * 100,\\n\",\"\\n\",\"        (high[\\\"Mahalanobis\\\"] - original[\\\"Mahalanobis\\\"])\\n\",\"        / original[\\\"Mahalanobis\\\"] * 100\\n\",\"    ]\\n\",\"})\\n\",\"\\n\",\"print(\\\"\\\\n1. AGGREGATE DETECTOR RESPONSE\\\")\\n\",\"display(aggregate_findings.round(6))\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Identity-level response direction\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"identity_data = identity_detector_df.copy()\\n\",\"\\n\",\"identity_data[\\\"Condition\\\"] = (\\n\",\"    identity_data[\\\"Condition\\\"]\\n\",\"    .astype(str)\\n\",\"    .str.strip()\\n\",\"    .str.lower()\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\nAvailable identity-level conditions:\\\")\\n\",\"print(identity_data[\\\"Condition\\\"].unique())\\n\",\"\\n\",\"low_data = identity_data[\\n\",\"    identity_data[\\\"Condition\\\"].str.contains(\\\"low\\\")\\n\",\"].set_index(\\\"Identity\\\")\\n\",\"\\n\",\"high_data = identity_data[\\n\",\"    identity_data[\\\"Condition\\\"].str.contains(\\\"high\\\")\\n\",\"].set_index(\\\"Identity\\\")\\n\",\"\\n\",\"common_identities = low_data.index.intersection(\\n\",\"    high_data.index\\n\",\")\\n\",\"\\n\",\"if len(common_identities) != 13:\\n\",\"    raise ValueError(\\n\",\"        f\\\"Expected 13 paired identities, found {len(common_identities)}.\\\"\\n\",\"    )\\n\",\"\\n\",\"low_data = low_data.loc[common_identities]\\n\",\"high_data = high_data.loc[common_identities]\\n\",\"\\n\",\"euclidean_differences = (\\n\",\"    high_data[\\\"Euclidean\\\"] - low_data[\\\"Euclidean\\\"]\\n\",\")\\n\",\"\\n\",\"mahalanobis_differences = (\\n\",\"    high_data[\\\"Mahalanobis\\\"] - low_data[\\\"Mahalanobis\\\"]\\n\",\")\\n\",\"\\n\",\"identity_direction = pd.DataFrame({\\n\",\"    \\\"Detector\\\": [\\\"Euclidean\\\", \\\"Mahalanobis\\\"],\\n\",\"\\n\",\"    \\\"Higher Under High Illumination\\\": [\\n\",\"        int((euclidean_differences > 0).sum()),\\n\",\"        int((mahalanobis_differences > 0).sum())\\n\",\"    ],\\n\",\"\\n\",\"    \\\"Higher Under Low Illumination\\\": [\\n\",\"        int((euclidean_differences < 0).sum()),\\n\",\"        int((mahalanobis_differences < 0).sum())\\n\",\"    ],\\n\",\"\\n\",\"    \\\"Equal\\\": [\\n\",\"        int((euclidean_differences == 0).sum()),\\n\",\"        int((mahalanobis_differences == 0).sum())\\n\",\"    ]\\n\",\"})\\n\",\"\\n\",\"print(\\\"\\\\n2. IDENTITY-LEVEL RESPONSE DIRECTION\\\")\\n\",\"display(identity_direction)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Paired statistical test results\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n3. PAIRED STATISTICAL TEST RESULTS\\\")\\n\",\"display(statistical_results.round(6))\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Effect size and uncertainty\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n4. EFFECT SIZE AND UNCERTAINTY\\\")\\n\",\"display(effect_size_df.round(6))\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. Scientific interpretation\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n5. SCIENTIFIC INTERPRETATION\\\")\\n\",\"\\n\",\"print(\\n\",\"    f\\\"\\\\nEuclidean detector:\\\"\\n\",\"    f\\\"\\\\n  Original score: {original['Euclidean']:.6f}\\\"\\n\",\"    f\\\"\\\\n  Low illumination: {low['Euclidean']:.6f}\\\"\\n\",\"    f\\\"\\\\n  High illumination: {high['Euclidean']:.6f}\\\"\\n\",\"    f\\\"\\\\n  Low illumination increase: \\\"\\n\",\"    f\\\"{aggregate_findings.loc[0, 'Low Change (%)']:.2f}%\\\"\\n\",\"    f\\\"\\\\n  High illumination increase: \\\"\\n\",\"    f\\\"{aggregate_findings.loc[0, 'High Change (%)']:.2f}%\\\"\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    f\\\"\\\\nMahalanobis detector:\\\"\\n\",\"    f\\\"\\\\n  Original score: {original['Mahalanobis']:.6f}\\\"\\n\",\"    f\\\"\\\\n  Low illumination: {low['Mahalanobis']:.6f}\\\"\\n\",\"    f\\\"\\\\n  High illumination: {high['Mahalanobis']:.6f}\\\"\\n\",\"    f\\\"\\\\n  Low illumination increase: \\\"\\n\",\"    f\\\"{aggregate_findings.loc[1, 'Low Change (%)']:.2f}%\\\"\\n\",\"    f\\\"\\\\n  High illumination increase: \\\"\\n\",\"    f\\\"{aggregate_findings.loc[1, 'High Change (%)']:.2f}%\\\"\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"\\\\nIdentity-level comparison:\\\"\\n\",\"    f\\\"\\\\n  Euclidean: high illumination produced greater \\\"\\n\",\"    f\\\"displacement in {(euclidean_differences > 0).sum()} \\\"\\n\",\"    f\\\"of {len(euclidean_differences)} identities.\\\"\\n\",\"    f\\\"\\\\n  Mahalanobis: high illumination produced greater \\\"\\n\",\"    f\\\"displacement in {(mahalanobis_differences > 0).sum()} \\\"\\n\",\"    f\\\"of {len(mahalanobis_differences)} identities.\\\"\\n\",\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. Corrected statistical interpretation\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n6. STATISTICAL INTERPRETATION\\\")\\n\",\"\\n\",\"tests = statistical_results.set_index(\\\"Detector\\\")\\n\",\"\\n\",\"euclidean_p = float(\\n\",\"    tests.loc[\\\"Euclidean\\\", \\\"P-value\\\"]\\n\",\")\\n\",\"\\n\",\"mahalanobis_p = float(\\n\",\"    tests.loc[\\\"Mahalanobis\\\", \\\"P-value\\\"]\\n\",\")\\n\",\"\\n\",\"alpha = 0.05\\n\",\"\\n\",\"print(f\\\"Euclidean Wilcoxon p-value: {euclidean_p:.6f}\\\")\\n\",\"print(f\\\"Mahalanobis Wilcoxon p-value: {mahalanobis_p:.6f}\\\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"Euclidean result:\\\",\\n\",\"    \\\"Statistically significant at 5%.\\\"\\n\",\"    if euclidean_p < alpha\\n\",\"    else \\\"Not statistically significant at 5%.\\\"\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"Mahalanobis result:\\\",\\n\",\"    \\\"Statistically significant at 5%.\\\"\\n\",\"    if mahalanobis_p < alpha\\n\",\"    else \\\"Not statistically significant at 5%.\\\"\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"\\\\nBoth tests are exploratory and based on only \\\"\\n\",\"    \\\"13 paired identity-level observations.\\\"\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"No multiple-comparison correction has been applied.\\\"\\n\",\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 8. Comparative research findings\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n7. COMPARATIVE RESEARCH FINDINGS\\\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"The Euclidean detector recorded its largest aggregate \\\"\\n\",\"    \\\"response under low illumination.\\\"\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"The Mahalanobis detector recorded its largest aggregate \\\"\\n\",\"    \\\"response under high illumination.\\\"\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"The identity-level results demonstrate that detector \\\"\\n\",\"    \\\"responses vary across identities.\\\"\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"The larger estimated Mahalanobis effect size does not \\\"\\n\",\"    \\\"establish general detector superiority.\\\"\\n\",\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 9. Scientific limitations\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n8. SCIENTIFIC LIMITATIONS\\\")\\n\",\"\\n\",\"limitations = [\\n\",\"    \\\"The evaluation includes only 13 identities.\\\",\\n\",\"    \\\"Identity-level sample counts are unequal.\\\",\\n\",\"    \\\"The aggregate comparison covers three illumination conditions.\\\",\\n\",\"    \\\"Both Wilcoxon tests are exploratory and based on 13 paired identities.\\\",\\n\",\"    \\\"No multiple-comparison correction has been applied.\\\",\\n\",\"    \\\"Bootstrap estimates are exploratory.\\\",\\n\",\"    \\\"Controlled brightness transformations do not represent all natural lighting conditions.\\\",\\n\",\"    \\\"Embedding displacement does not directly measure recognition accuracy.\\\",\\n\",\"    \\\"The experiment does not establish demographic fairness.\\\",\\n\",\"    \\\"The experiment does not establish operational drift-detection accuracy or false-alarm control.\\\"\\n\",\"]\\n\",\"\\n\",\"for number, limitation in enumerate(limitations, start=1):\\n\",\"    print(f\\\"{number}. {limitation}\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 10. Final numerical and consistency validation\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"numeric_values = aggregate_findings.select_dtypes(\\n\",\"    include=[np.number]\\n\",\").to_numpy()\\n\",\"\\n\",\"assert np.isfinite(numeric_values).all()\\n\",\"\\n\",\"assert len(common_identities) == 13\\n\",\"assert len(aggregate_findings) == 2\\n\",\"assert len(identity_direction) == 2\\n\",\"\\n\",\"assert np.isfinite(euclidean_differences).all()\\n\",\"assert np.isfinite(mahalanobis_differences).all()\\n\",\"\\n\",\"assert np.isclose(\\n\",\"    euclidean_differences.mean(),\\n\",\"    0.030051,\\n\",\"    atol=1e-5\\n\",\")\\n\",\"\\n\",\"assert np.isclose(\\n\",\"    mahalanobis_differences.mean(),\\n\",\"    0.722682,\\n\",\"    atol=1e-5\\n\",\")\\n\",\"\\n\",\"assert np.isclose(euclidean_p, 0.021484, atol=1e-5)\\n\",\"assert np.isclose(mahalanobis_p, 0.002441, atol=1e-5)\\n\",\"\\n\",\"assert int((euclidean_differences > 0).sum()) == 10\\n\",\"assert int((mahalanobis_differences > 0).sum()) == 11\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 70)\\n\",\"print(\\\"STEP 17.9 COMPLETED SUCCESSFULLY\\\")\\n\",\"print(\\\"Aggregate findings validated.\\\")\\n\",\"print(\\\"Identity-level comparisons validated.\\\")\\n\",\"print(\\\"Corrected statistical results verified.\\\")\\n\",\"print(\\\"Effect sizes and uncertainty reviewed.\\\")\\n\",\"print(\\\"Scientific limitations documented.\\\")\\n\",\"print(\\\"Previously generated experimental results reused.\\\")\\n\",\"print(\\\"=\\\" * 70)\\n\",\"\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 112\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"## Step 17.10 — Final Validation and Reproducibility Audit\\n\",\"\\n\",\"### Objective\\n\",\"\\n\",\"This stage performs a final audit of Experiment 18 to verify data integrity, numerical consistency, experimental configuration and reproducibility.\\n\",\"\\n\",\"The audit is divided into the following subsections:\\n\",\"\\n\",\"- **Step 17.10.1:** Data Integrity Audit\\n\",\"- **Step 17.10.2:** Detector and Statistical Result Consistency\\n\",\"- **Step 17.10.3:** Experimental Configuration and Reproducibility\\n\",\"- **Step 17.10.4:** Saved Results and Output Verification\\n\",\"- **Step 17.10.5:** Final Experiment Validation Summary\\n\",\"\\n\",\"No embeddings, detector results or statistical tests will be regenerated during this audit.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 113\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 18 — STEP 17.10.1\\n\",\"# DATA INTEGRITY AUDIT\\n\",\"# ============================================================\\n\",\"\\n\",\"print(\\\"EXPERIMENT 18 — STEP 17.10.1\\\")\\n\",\"print(\\\"DATA INTEGRITY AUDIT\\\")\\n\",\"print(\\\"=\\\" * 65)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Validate embedding arrays\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"embedding_arrays = {\\n\",\"    \\\"Original\\\": paired_original_embeddings,\\n\",\"    \\\"Low illumination\\\": paired_low_embeddings,\\n\",\"    \\\"High illumination\\\": paired_high_embeddings\\n\",\"}\\n\",\"\\n\",\"print(\\\"\\\\n1. EMBEDDING ARRAY VALIDATION\\\")\\n\",\"\\n\",\"sample_counts = []\\n\",\"\\n\",\"for name, array in embedding_arrays.items():\\n\",\"\\n\",\"    array = np.asarray(array)\\n\",\"\\n\",\"    print(f\\\"\\\\n{name}\\\")\\n\",\"    print(\\\"Shape:\\\", array.shape)\\n\",\"    print(\\\"Embedding dimension:\\\", array.shape[1])\\n\",\"    print(\\\"All values finite:\\\", np.isfinite(array).all())\\n\",\"\\n\",\"    assert array.ndim == 2, f\\\"{name}: Expected a 2D array.\\\"\\n\",\"    assert array.shape[1] == 512, f\\\"{name}: Unexpected embedding dimension.\\\"\\n\",\"    assert np.isfinite(array).all(), f\\\"{name}: Non-finite values detected.\\\"\\n\",\"\\n\",\"    sample_counts.append(array.shape[0])\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Validate paired sample consistency\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n2. PAIRED SAMPLE VALIDATION\\\")\\n\",\"\\n\",\"labels = np.asarray(paired_labels)\\n\",\"\\n\",\"print(\\\"Original samples:\\\", sample_counts[0])\\n\",\"print(\\\"Low illumination samples:\\\", sample_counts[1])\\n\",\"print(\\\"High illumination samples:\\\", sample_counts[2])\\n\",\"print(\\\"Label count:\\\", len(labels))\\n\",\"\\n\",\"assert len(set(sample_counts)) == 1, (\\n\",\"    \\\"Embedding arrays have inconsistent sample counts.\\\"\\n\",\")\\n\",\"\\n\",\"assert len(labels) == sample_counts[0], (\\n\",\"    \\\"Label count does not match embedding sample count.\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"Paired sample counts consistent: True\\\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Validate identity coverage\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n3. IDENTITY COVERAGE VALIDATION\\\")\\n\",\"\\n\",\"unique_identities = np.unique(labels)\\n\",\"\\n\",\"print(\\\"Number of identities:\\\", len(unique_identities))\\n\",\"print(\\\"Identity labels:\\\", unique_identities)\\n\",\"\\n\",\"assert len(unique_identities) == 13, (\\n\",\"    f\\\"Expected 13 identities, found {len(unique_identities)}.\\\"\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Validate covariance matrix\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n4. COVARIANCE MATRIX VALIDATION\\\")\\n\",\"\\n\",\"covariance = np.asarray(\\n\",\"    identity_balanced_regularised_covariance\\n\",\")\\n\",\"\\n\",\"print(\\\"Covariance shape:\\\", covariance.shape)\\n\",\"print(\\\"All values finite:\\\", np.isfinite(covariance).all())\\n\",\"\\n\",\"assert covariance.shape == (512, 512), (\\n\",\"    \\\"Unexpected covariance matrix dimensions.\\\"\\n\",\")\\n\",\"\\n\",\"assert np.isfinite(covariance).all(), (\\n\",\"    \\\"Covariance matrix contains non-finite values.\\\"\\n\",\")\\n\",\"\\n\",\"is_symmetric = np.allclose(\\n\",\"    covariance,\\n\",\"    covariance.T,\\n\",\"    atol=1e-8\\n\",\")\\n\",\"\\n\",\"print(\\\"Symmetric:\\\", is_symmetric)\\n\",\"\\n\",\"assert is_symmetric, \\\"Covariance matrix is not symmetric.\\\"\\n\",\"\\n\",\"eigenvalues = np.linalg.eigvalsh(covariance)\\n\",\"\\n\",\"minimum_eigenvalue = eigenvalues.min()\\n\",\"maximum_eigenvalue = eigenvalues.max()\\n\",\"\\n\",\"print(\\\"Minimum eigenvalue:\\\", minimum_eigenvalue)\\n\",\"print(\\\"Maximum eigenvalue:\\\", maximum_eigenvalue)\\n\",\"\\n\",\"is_positive_definite = np.all(eigenvalues > 0)\\n\",\"\\n\",\"print(\\\"Positive definite:\\\", is_positive_definite)\\n\",\"\\n\",\"assert is_positive_definite, (\\n\",\"    \\\"Covariance matrix is not positive definite.\\\"\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Validate existing analysis tables\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n5. ANALYSIS TABLE VALIDATION\\\")\\n\",\"\\n\",\"analysis_tables = {\\n\",\"    \\\"Aggregate detector results\\\": evaluation_detector_df,\\n\",\"    \\\"Identity-level detector results\\\": identity_detector_df,\\n\",\"    \\\"Paired statistical results\\\": statistical_results,\\n\",\"    \\\"Effect size results\\\": effect_size_df\\n\",\"}\\n\",\"\\n\",\"for name, dataframe in analysis_tables.items():\\n\",\"\\n\",\"    print(\\n\",\"        f\\\"{name}: \\\"\\n\",\"        f\\\"{dataframe.shape[0]} rows, \\\"\\n\",\"        f\\\"{dataframe.shape[1]} columns\\\"\\n\",\"    )\\n\",\"\\n\",\"    assert isinstance(dataframe, pd.DataFrame)\\n\",\"    assert not dataframe.empty\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. Final audit summary\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n6. DATA INTEGRITY AUDIT SUMMARY\\\")\\n\",\"\\n\",\"audit_results = pd.DataFrame({\\n\",\"    \\\"Validation\\\": [\\n\",\"        \\\"Embedding dimensions\\\",\\n\",\"        \\\"Finite embedding values\\\",\\n\",\"        \\\"Paired sample consistency\\\",\\n\",\"        \\\"Identity coverage\\\",\\n\",\"        \\\"Covariance dimensions\\\",\\n\",\"        \\\"Covariance symmetry\\\",\\n\",\"        \\\"Covariance positive definiteness\\\",\\n\",\"        \\\"Analysis tables available\\\"\\n\",\"    ],\\n\",\"    \\\"Status\\\": [\\n\",\"        \\\"PASSED\\\",\\n\",\"        \\\"PASSED\\\",\\n\",\"        \\\"PASSED\\\",\\n\",\"        \\\"PASSED\\\",\\n\",\"        \\\"PASSED\\\",\\n\",\"        \\\"PASSED\\\",\\n\",\"        \\\"PASSED\\\",\\n\",\"        \\\"PASSED\\\"\\n\",\"    ]\\n\",\"})\\n\",\"\\n\",\"display(audit_results)\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 65)\\n\",\"print(\\\"STEP 17.10.1 DATA INTEGRITY AUDIT COMPLETED\\\")\\n\",\"print(\\\"All validation checks passed.\\\")\\n\",\"print(\\\"=\\\" * 65)\\n\",\"\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 114\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"### Step 17.10.2 — Detector and Statistical Result Consistency\\n\",\"\\n\",\"**Objective**\\n\",\"\\n\",\"Verify the internal consistency of the aggregate detector responses, identity-level comparisons, paired statistical tests and effect-size estimates generated during Steps 17.2–17.8.\\n\",\"\\n\",\"This validation reuses existing results without rerunning embedding extraction, detector calculations, Wilcoxon tests or bootstrap simulations.\\n\",\"\\n\",\"**Validation Methodology**\\n\",\"\\n\",\"The consistency audit covered the following components:\\n\",\"\\n\",\"1. **Aggregate Detector Results:** Verified the recorded Euclidean and Mahalanobis detector responses under original, low-illumination and high-illumination conditions against the previously established reference values.\\n\",\"\\n\",\"2. **Identity-Level Comparisons:** Reconstructed paired high-minus-low illumination differences using the existing identity-level detector results. Confirmed that all 13 identities were represented and that the resulting differences contained finite values.\\n\",\"\\n\",\"3. **Paired Descriptive Statistics:** Independently recalculated the mean difference, median difference, standard deviation, Cohen's dz, rank-biserial correlation and positive, negative and zero difference counts.\\n\",\"\\n\",\"4. **Effect-Size Consistency:** Compared the recalculated effect-size estimates with the previously recorded values for both detectors.\\n\",\"\\n\",\"5. **Wilcoxon Result Consistency:** Verified the previously recorded Wilcoxon statistics and p-values without rerunning the statistical tests.\\n\",\"\\n\",\"6. **Bootstrap Confidence Interval Validation:** Checked the availability, numerical finiteness and lower-to-upper ordering of the previously calculated mean and median confidence intervals.\\n\",\"\\n\",\"**Verified Results**\\n\",\"\\n\",\"The audit confirmed the following paired statistical results:\\n\",\"\\n\",\"| Detector | Wilcoxon Statistic | p-value | Nominal 5% Conclusion |\\n\",\"|---|---:|---:|---|\\n\",\"| Euclidean | 13.0 | 0.021484 | Statistically significant |\\n\",\"| Mahalanobis | 5.0 | 0.002441 | Statistically significant |\\n\",\"\\n\",\"The recalculated effect-size estimates also matched the previously recorded results:\\n\",\"\\n\",\"- **Euclidean:** Cohen's dz = 0.715850; rank-biserial correlation = 0.714286.\\n\",\"- **Mahalanobis:** Cohen's dz = 0.904102; rank-biserial correlation = 0.890110.\\n\",\"\\n\",\"All six consistency validation categories passed successfully.\\n\",\"\\n\",\"**Scientific Limitations**\\n\",\"\\n\",\"The statistical findings are based on paired identity-level observations from only 13 identities. The results should therefore be interpreted as exploratory evidence of detector-response differences under the evaluated illumination conditions.\\n\",\"\\n\",\"The nominal significance conclusions do not account for multiple-comparison correction. These findings do not independently establish real-world biometric recognition accuracy, population-level generalisation, fairness or deployment readiness.\\n\",\"\\n\",\"**Status: Successfully Completed**\\n\",\"\\n\",\"The aggregate detector results, identity-level comparisons, descriptive statistics, effect sizes, Wilcoxon results and bootstrap confidence interval structures were successfully validated against the existing Experiment 18 outputs.\\n\",\"\\n\",\"All six consistency checks passed. No embedding extraction, detector calculations, statistical tests or bootstrap simulations were rerun.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 116\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"### Step 17.10.3 — Experimental Configuration and Reproducibility\\n\",\"\\n\",\"**Objective**\\n\",\"\\n\",\"Document and verify the experimental configuration used in Experiment 18, including the dataset, pretrained embedding model, embedding dimensions, illumination transformation settings, dataset characteristics, random seed variables and software environment.\\n\",\"\\n\",\"The purpose is to establish a reproducibility record without rerunning the experiment or modifying previously generated results.\\n\",\"\\n\",\"**1. Dataset and Experimental Configuration**\\n\",\"\\n\",\"The experiment used a filtered subset of the Labeled Faces in the Wild (LFW) dataset with the InceptionResnetV1 model pretrained on VGGFace2.\\n\",\"\\n\",\"The embedding dimension was 512.\\n\",\"\\n\",\"The full paired illumination dataset contained 889 images across 13 identities. A separate corrected identity-level evaluation cohort contained 229 images across the same 13 identities.\\n\",\"\\n\",\"The controlled brightness transformation factors were:\\n\",\"\\n\",\"- Low illumination: 0.5\\n\",\"- Original illumination: 1.0\\n\",\"- High illumination: 1.5\\n\",\"\\n\",\"**2. Embedding and Cohort Validation**\\n\",\"\\n\",\"The audit verified that the original, low-illumination and high-illumination embedding arrays each contained 889 samples with 512 dimensions.\\n\",\"\\n\",\"All embedding values were finite.\\n\",\"\\n\",\"The corrected identity-level evaluation arrays were independently verified to contain 229 samples each, with 512 dimensions and 13 identities.\\n\",\"\\n\",\"Both dataset configurations passed their respective validation checks.\\n\",\"\\n\",\"**3. Model and Random Seed Inspection**\\n\",\"\\n\",\"The existing model object was identified as `InceptionResnetV1` from the `facenet_pytorch` package.\\n\",\"\\n\",\"The following random seed variables were found in the current session:\\n\",\"\\n\",\"- `RANDOM_SEED`: 202618\\n\",\"- `BOOTSTRAP_SEED`: 202617\\n\",\"\\n\",\"These values document the available seed configuration. Their presence does not independently establish that every original experimental operation used the corresponding seed.\\n\",\"\\n\",\"**4. Software Environment**\\n\",\"\\n\",\"The execution environment was recorded as follows:\\n\",\"\\n\",\"- Python: 3.13.18\\n\",\"- NumPy: 2.4.6\\n\",\"- Pandas: 2.2.3\\n\",\"- PyTorch: 2.14.1+cpu\\n\",\"- Torchvision: 0.29.1+cpu\\n\",\"- facenet-pytorch: 2.6.0\\n\",\"- SciPy: 1.16.3\\n\",\"- Matplotlib: 3.10.0\\n\",\"- Scikit-learn: 1.6.1\\n\",\"- Pillow: 11.3.0\\n\",\"\\n\",\"The runtime platform was Linux.\\n\",\"\\n\",\"**5. Saved Metadata Inspection**\\n\",\"\\n\",\"The saved experiment metadata files were inspected without modification.\\n\",\"\\n\",\"The archived `experiment18_final_research_evidence.json` contains historical detector-response and statistical records from an earlier analysis. These include identity-level detector results based on the full 889-image paired cohort and previously recorded Wilcoxon results.\\n\",\"\\n\",\"Those historical detector statistics and effect sizes are superseded by the corrected identity-level analysis documented in Steps 17.4–17.10.2.\\n\",\"\\n\",\"The corrected detector-level statistical findings are:\\n\",\"\\n\",\"- Euclidean Wilcoxon p-value: 0.021484.\\n\",\"- Mahalanobis Wilcoxon p-value: 0.002441.\\n\",\"\\n\",\"The historical JSON records have been preserved and are not treated as the current corrected statistical results.\\n\",\"\\n\",\"**6. Scientific and Reproducibility Limitations**\\n\",\"\\n\",\"This audit verifies the currently available arrays, model object, configuration variables, software environment and saved metadata.\\n\",\"\\n\",\"It does not independently reproduce the original image detection, preprocessing, embedding extraction, detector calibration or complete experimental pipeline.\\n\",\"\\n\",\"The evaluation remains limited to 13 identities, with an imbalanced identity distribution. The 229-image corrected evaluation cohort should not be confused with the full 889-image paired illumination dataset.\\n\",\"\\n\",\"The controlled brightness transformations do not establish performance under all real-world illumination conditions.\\n\",\"\\n\",\"**Status: Successfully Completed**\\n\",\"\\n\",\"The experimental configuration and available reproducibility information were inspected and documented.\\n\",\"\\n\",\"The full paired dataset of 889 images and the corrected identity-level evaluation cohort of 229 images were independently verified. The model object, random seed variables, software environment and saved metadata were inspected.\\n\",\"\\n\",\"Historical detector statistics were distinguished from the corrected results. No model training, embedding extraction, detector recalculation, statistical testing or bootstrap simulation was performed. No saved experimental files were modified.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 117\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"\\n\",\"import os\\n\",\"import sys\\n\",\"import json\\n\",\"import platform\\n\",\"import importlib.metadata as pkg_metadata\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"from pathlib import Path\\n\",\"from IPython.display import display\\n\",\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 18 — STEP 17.10.3\\n\",\"# EXPERIMENTAL CONFIGURATION AND REPRODUCIBILITY AUDIT\\n\",\"# ============================================================\\n\",\"\\n\",\"print(\\\"EXPERIMENT 18 — STEP 17.10.3\\\")\\n\",\"print(\\\"EXPERIMENTAL CONFIGURATION AND REPRODUCIBILITY AUDIT\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Dataset and embedding configuration\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n1. DATASET AND EMBEDDING CONFIGURATION\\\")\\n\",\"\\n\",\"configuration = {\\n\",\"    \\\"Dataset\\\": \\\"Labeled Faces in the Wild (LFW)\\\",\\n\",\"    \\\"Pretrained Model\\\": \\\"InceptionResnetV1\\\",\\n\",\"    \\\"Pretrained Weights\\\": \\\"VGGFace2\\\",\\n\",\"    \\\"Embedding Dimension\\\": 512,\\n\",\"    \\\"Evaluation Identities\\\": 13,\\n\",\"    \\\"Full Paired Illumination Images\\\": 889,\\n\",\"    \\\"Corrected Identity-Level Evaluation Images\\\": 229,\\n\",\"    \\\"Low Brightness Factor\\\": 0.5,\\n\",\"    \\\"Original Brightness Factor\\\": 1.0,\\n\",\"    \\\"High Brightness Factor\\\": 1.5\\n\",\"}\\n\",\"\\n\",\"configuration_df = pd.DataFrame(\\n\",\"    list(configuration.items()),\\n\",\"    columns=[\\\"Configuration\\\", \\\"Value\\\"]\\n\",\")\\n\",\"\\n\",\"display(configuration_df)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Verify full paired illumination arrays\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n2. FULL PAIRED ILLUMINATION DATA VALIDATION\\\")\\n\",\"\\n\",\"paired_arrays = {\\n\",\"    \\\"Original\\\": paired_original_embeddings,\\n\",\"    \\\"Low illumination\\\": paired_low_embeddings,\\n\",\"    \\\"High illumination\\\": paired_high_embeddings\\n\",\"}\\n\",\"\\n\",\"paired_sample_counts = []\\n\",\"\\n\",\"for condition, array in paired_arrays.items():\\n\",\"\\n\",\"    array = np.asarray(array)\\n\",\"\\n\",\"    print(f\\\"\\\\n{condition}\\\")\\n\",\"    print(\\\"Shape:\\\", array.shape)\\n\",\"    print(\\\"All values finite:\\\", np.isfinite(array).all())\\n\",\"\\n\",\"    assert array.ndim == 2\\n\",\"    assert array.shape[1] == 512\\n\",\"    assert np.isfinite(array).all()\\n\",\"\\n\",\"    paired_sample_counts.append(array.shape[0])\\n\",\"\\n\",\"assert paired_sample_counts == [889, 889, 889], (\\n\",\"    \\\"Full paired illumination arrays do not contain \\\"\\n\",\"    \\\"the expected 889 samples each.\\\"\\n\",\")\\n\",\"\\n\",\"paired_labels_array = np.asarray(paired_labels)\\n\",\"\\n\",\"assert len(paired_labels_array) == 889\\n\",\"assert len(np.unique(paired_labels_array)) == 13\\n\",\"\\n\",\"print(\\\"\\\\nFull paired sample count: 889\\\")\\n\",\"print(\\\"Full paired identity count:\\\", len(np.unique(paired_labels_array)))\\n\",\"print(\\\"Full paired dataset validation: PASSED\\\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Verify corrected identity-level evaluation cohort\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n3. CORRECTED IDENTITY-LEVEL EVALUATION COHORT\\\")\\n\",\"\\n\",\"evaluation_variables = [\\n\",\"    \\\"evaluation_baseline\\\",\\n\",\"    \\\"evaluation_low\\\",\\n\",\"    \\\"evaluation_high\\\",\\n\",\"    \\\"evaluation_labels\\\"\\n\",\"]\\n\",\"\\n\",\"missing_evaluation_variables = [\\n\",\"    name for name in evaluation_variables\\n\",\"    if name not in globals()\\n\",\"]\\n\",\"\\n\",\"if not missing_evaluation_variables:\\n\",\"\\n\",\"    evaluation_arrays = {\\n\",\"        \\\"Original evaluation\\\": evaluation_baseline,\\n\",\"        \\\"Low illumination evaluation\\\": evaluation_low,\\n\",\"        \\\"High illumination evaluation\\\": evaluation_high\\n\",\"    }\\n\",\"\\n\",\"    evaluation_sample_counts = []\\n\",\"\\n\",\"    for condition, array in evaluation_arrays.items():\\n\",\"\\n\",\"        array = np.asarray(array)\\n\",\"\\n\",\"        print(f\\\"\\\\n{condition}\\\")\\n\",\"        print(\\\"Shape:\\\", array.shape)\\n\",\"        print(\\\"All values finite:\\\", np.isfinite(array).all())\\n\",\"\\n\",\"        assert array.ndim == 2\\n\",\"        assert array.shape[1] == 512\\n\",\"        assert np.isfinite(array).all()\\n\",\"\\n\",\"        evaluation_sample_counts.append(array.shape[0])\\n\",\"\\n\",\"    evaluation_labels_array = np.asarray(evaluation_labels)\\n\",\"\\n\",\"    assert evaluation_sample_counts == [229, 229, 229], (\\n\",\"        \\\"Corrected evaluation arrays do not contain \\\"\\n\",\"        \\\"229 samples each.\\\"\\n\",\"    )\\n\",\"\\n\",\"    assert len(evaluation_labels_array) == 229\\n\",\"    assert len(np.unique(evaluation_labels_array)) == 13\\n\",\"\\n\",\"    print(\\\"\\\\nCorrected evaluation sample count: 229\\\")\\n\",\"    print(\\n\",\"        \\\"Corrected evaluation identity count:\\\",\\n\",\"        len(np.unique(evaluation_labels_array))\\n\",\"    )\\n\",\"    print(\\\"Corrected evaluation cohort validation: PASSED\\\")\\n\",\"\\n\",\"else:\\n\",\"\\n\",\"    print(\\n\",\"        \\\"Corrected evaluation variables unavailable:\\\",\\n\",\"        missing_evaluation_variables\\n\",\"    )\\n\",\"    print(\\n\",\"        \\\"Corrected 229-image cohort could not be independently \\\"\\n\",\"        \\\"verified in the current session.\\\"\\n\",\"    )\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Inspect existing model object\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n4. MODEL OBJECT INSPECTION\\\")\\n\",\"\\n\",\"model_candidates = [\\n\",\"    name for name in globals()\\n\",\"    if \\\"model\\\" in name.lower()\\n\",\"    and name != \\\"model_candidates\\\"\\n\",\"]\\n\",\"\\n\",\"model_inspection = []\\n\",\"\\n\",\"for name in model_candidates:\\n\",\"\\n\",\"    obj = globals()[name]\\n\",\"\\n\",\"    if callable(getattr(obj, \\\"eval\\\", None)):\\n\",\"\\n\",\"        model_inspection.append({\\n\",\"            \\\"Variable\\\": name,\\n\",\"            \\\"Object Type\\\": type(obj).__name__,\\n\",\"            \\\"Class Module\\\": type(obj).__module__,\\n\",\"            \\\"Evaluation Method\\\": \\\"Available\\\"\\n\",\"        })\\n\",\"\\n\",\"if model_inspection:\\n\",\"\\n\",\"    model_inspection_df = pd.DataFrame(model_inspection)\\n\",\"    display(model_inspection_df)\\n\",\"\\n\",\"    expected_model_found = any(\\n\",\"        row[\\\"Object Type\\\"] == \\\"InceptionResnetV1\\\"\\n\",\"        for row in model_inspection\\n\",\"    )\\n\",\"\\n\",\"    print(\\n\",\"        \\\"InceptionResnetV1 model object found:\\\",\\n\",\"        expected_model_found\\n\",\"    )\\n\",\"\\n\",\"else:\\n\",\"\\n\",\"    print(\\n\",\"        \\\"No existing model object with an evaluation method \\\"\\n\",\"        \\\"was identified.\\\"\\n\",\"    )\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Inspect random seed configuration\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n5. RANDOM SEED CONFIGURATION\\\")\\n\",\"\\n\",\"seed_names = [\\n\",\"    \\\"RANDOM_SEED\\\",\\n\",\"    \\\"BOOTSTRAP_SEED\\\"\\n\",\"]\\n\",\"\\n\",\"seed_records = []\\n\",\"\\n\",\"for name in seed_names:\\n\",\"\\n\",\"    if name in globals():\\n\",\"\\n\",\"        value = globals()[name]\\n\",\"\\n\",\"        if isinstance(value, (int, float, str)):\\n\",\"\\n\",\"            seed_records.append({\\n\",\"                \\\"Seed Variable\\\": name,\\n\",\"                \\\"Recorded Value\\\": value,\\n\",\"                \\\"Status\\\": \\\"FOUND\\\"\\n\",\"            })\\n\",\"\\n\",\"        else:\\n\",\"\\n\",\"            seed_records.append({\\n\",\"                \\\"Seed Variable\\\": name,\\n\",\"                \\\"Recorded Value\\\": str(type(value).__name__),\\n\",\"                \\\"Status\\\": \\\"FOUND — NON-SCALAR\\\"\\n\",\"            })\\n\",\"\\n\",\"    else:\\n\",\"\\n\",\"        seed_records.append({\\n\",\"            \\\"Seed Variable\\\": name,\\n\",\"            \\\"Recorded Value\\\": \\\"Not available\\\",\\n\",\"            \\\"Status\\\": \\\"NOT FOUND\\\"\\n\",\"        })\\n\",\"\\n\",\"seed_df = pd.DataFrame(seed_records)\\n\",\"display(seed_df)\\n\",\"\\n\",\"print(\\n\",\"    \\\"Seed inspection records variables present in the current \\\"\\n\",\"    \\\"session; it does not independently prove that every original \\\"\\n\",\"    \\\"experiment operation used these seeds.\\\"\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. Software and environment versions\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n6. SOFTWARE ENVIRONMENT\\\")\\n\",\"\\n\",\"packages = [\\n\",\"    \\\"numpy\\\",\\n\",\"    \\\"pandas\\\",\\n\",\"    \\\"torch\\\",\\n\",\"    \\\"torchvision\\\",\\n\",\"    \\\"facenet-pytorch\\\",\\n\",\"    \\\"scipy\\\",\\n\",\"    \\\"matplotlib\\\",\\n\",\"    \\\"scikit-learn\\\",\\n\",\"    \\\"Pillow\\\"\\n\",\"]\\n\",\"\\n\",\"software_versions = []\\n\",\"\\n\",\"for package in packages:\\n\",\"\\n\",\"    try:\\n\",\"        version = pkg_metadata.version(package)\\n\",\"\\n\",\"    except pkg_metadata.PackageNotFoundError:\\n\",\"        version = \\\"Not installed\\\"\\n\",\"\\n\",\"    software_versions.append({\\n\",\"        \\\"Package\\\": package,\\n\",\"        \\\"Version\\\": version\\n\",\"    })\\n\",\"\\n\",\"software_df = pd.DataFrame(software_versions)\\n\",\"\\n\",\"print(\\\"Python version:\\\", sys.version.split()[0])\\n\",\"print(\\\"Platform:\\\", platform.platform())\\n\",\"\\n\",\"display(software_df)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. Inspect saved experiment metadata\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n7. SAVED EXPERIMENT METADATA\\\")\\n\",\"\\n\",\"results_directory = Path(\\n\",\"    \\\"/content/drive/MyDrive/Experiment_18_Results\\\"\\n\",\")\\n\",\"\\n\",\"metadata_files = []\\n\",\"\\n\",\"if results_directory.exists():\\n\",\"\\n\",\"    print(\\\"Results directory found:\\\", results_directory)\\n\",\"\\n\",\"    metadata_files = sorted(\\n\",\"        results_directory.glob(\\\"*.json\\\")\\n\",\"    )\\n\",\"\\n\",\"    if metadata_files:\\n\",\"\\n\",\"        for metadata_file in metadata_files:\\n\",\"\\n\",\"            print(\\\"\\\\nMetadata file:\\\", metadata_file.name)\\n\",\"\\n\",\"            try:\\n\",\"\\n\",\"                with open(metadata_file, \\\"r\\\") as file:\\n\",\"                    metadata = json.load(file)\\n\",\"\\n\",\"                print(json.dumps(metadata, indent=2))\\n\",\"\\n\",\"                # Identify older detector statistical records.\\n\",\"                if \\\"detector_statistical_tests\\\" in metadata:\\n\",\"\\n\",\"                    print(\\n\",\"                        \\\"\\\\nWARNING: This file contains detector \\\"\\n\",\"                        \\\"statistical results from an earlier analysis.\\\"\\n\",\"                    )\\n\",\"\\n\",\"                    print(\\n\",\"                        \\\"These entries must be treated as historical \\\"\\n\",\"                        \\\"and superseded by the corrected Step 17.10.2 \\\"\\n\",\"                        \\\"validation results.\\\"\\n\",\"                    )\\n\",\"\\n\",\"                    historical_tests = pd.DataFrame(\\n\",\"                        metadata[\\\"detector_statistical_tests\\\"]\\n\",\"                    )\\n\",\"\\n\",\"                    display(historical_tests)\\n\",\"\\n\",\"                    print(\\n\",\"                        \\\"Metadata interpretation: \\\"\\n\",\"                        \\\"HISTORICAL / SUPERSEDED DETECTOR RESULTS\\\"\\n\",\"                    )\\n\",\"\\n\",\"                # Identify older detector effect-size records.\\n\",\"                if \\\"detector_effect_sizes\\\" in metadata:\\n\",\"\\n\",\"                    print(\\n\",\"                        \\\"Historical detector effect-size records \\\"\\n\",\"                        \\\"are present in this metadata file.\\\"\\n\",\"                    )\\n\",\"\\n\",\"                    print(\\n\",\"                        \\\"They are not treated as the corrected \\\"\\n\",\"                        \\\"Step 17.10.2 effect-size results.\\\"\\n\",\"                    )\\n\",\"\\n\",\"            except Exception as error:\\n\",\"\\n\",\"                print(\\n\",\"                    \\\"Could not read metadata:\\\",\\n\",\"                    str(error)\\n\",\"                )\\n\",\"\\n\",\"    else:\\n\",\"\\n\",\"        print(\\\"No JSON metadata files found.\\\")\\n\",\"\\n\",\"else:\\n\",\"\\n\",\"    print(\\n\",\"        \\\"Previously recorded results directory is not accessible \\\"\\n\",\"        \\\"in this session. No files were modified.\\\"\\n\",\"    )\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 8. Verify illumination configuration\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n8. ILLUMINATION CONFIGURATION VALIDATION\\\")\\n\",\"\\n\",\"brightness_factors = {\\n\",\"    \\\"Low illumination\\\": 0.5,\\n\",\"    \\\"Original illumination\\\": 1.0,\\n\",\"    \\\"High illumination\\\": 1.5\\n\",\"}\\n\",\"\\n\",\"brightness_df = pd.DataFrame(\\n\",\"    list(brightness_factors.items()),\\n\",\"    columns=[\\\"Condition\\\", \\\"Brightness Factor\\\"]\\n\",\")\\n\",\"\\n\",\"display(brightness_df)\\n\",\"\\n\",\"assert brightness_factors[\\\"Low illumination\\\"] < 1.0\\n\",\"assert brightness_factors[\\\"Original illumination\\\"] == 1.0\\n\",\"assert brightness_factors[\\\"High illumination\\\"] > 1.0\\n\",\"\\n\",\"print(\\\"Illumination configuration: PASSED\\\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 9. Reproducibility audit summary\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n9. REPRODUCIBILITY AUDIT SUMMARY\\\")\\n\",\"\\n\",\"reproducibility_summary = pd.DataFrame({\\n\",\"    \\\"Audit Item\\\": [\\n\",\"        \\\"Dataset identification\\\",\\n\",\"        \\\"Pretrained model configuration\\\",\\n\",\"        \\\"Full paired embedding dimensions\\\",\\n\",\"        \\\"Full paired illumination sample count\\\",\\n\",\"        \\\"Corrected 229-image evaluation cohort\\\",\\n\",\"        \\\"Evaluation identity coverage\\\",\\n\",\"        \\\"Illumination transformation settings\\\",\\n\",\"        \\\"Software environment inspection\\\",\\n\",\"        \\\"Random seed variable inspection\\\",\\n\",\"        \\\"Saved metadata inspection\\\"\\n\",\"    ],\\n\",\"    \\\"Status\\\": [\\n\",\"        \\\"DOCUMENTED\\\",\\n\",\"        \\\"DOCUMENTED\\\",\\n\",\"        \\\"VERIFIED\\\",\\n\",\"        \\\"VERIFIED\\\",\\n\",\"        (\\n\",\"            \\\"VERIFIED\\\"\\n\",\"            if not missing_evaluation_variables\\n\",\"            else \\\"NOT VERIFIED\\\"\\n\",\"        ),\\n\",\"        (\\n\",\"            \\\"VERIFIED\\\"\\n\",\"            if not missing_evaluation_variables\\n\",\"            else \\\"NOT VERIFIED\\\"\\n\",\"        ),\\n\",\"        \\\"VERIFIED\\\",\\n\",\"        \\\"INSPECTED\\\",\\n\",\"        \\\"INSPECTED\\\",\\n\",\"        \\\"INSPECTED\\\"\\n\",\"    ]\\n\",\"})\\n\",\"\\n\",\"display(reproducibility_summary)\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 17.10.3 CONFIGURATION AUDIT COMPLETED\\\")\\n\",\"print(\\\"Full paired illumination dataset: 889 images.\\\")\\n\",\"print(\\\"Corrected identity-level evaluation cohort: 229 images.\\\")\\n\",\"print(\\\"Saved metadata inspected without modification.\\\")\\n\",\"print(\\\"Historical detector statistics distinguished from corrected results.\\\")\\n\",\"print(\\\"No model training or embedding extraction performed.\\\")\\n\",\"print(\\\"No statistical tests or bootstrap simulations rerun.\\\")\\n\",\"print(\\\"No experimental results or saved files modified.\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 118\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"### Step 17.10.4 — Saved Results and Output Verification\\n\",\"\\n\",\"**Objective**\\n\",\"\\n\",\"Verify the completeness and consistency of Experiment 18's saved outputs, including embedding archives, identity-level summaries, metadata records and statistical results.\\n\",\"\\n\",\"The audit inspected existing files without overwriting, modifying or regenerating experimental outputs.\\n\",\"\\n\",\"**1. Saved Results Inventory**\\n\",\"\\n\",\"The results directory was successfully located:\\n\",\"\\n\",\"`/content/drive/MyDrive/Experiment_18_Results`\\n\",\"\\n\",\"Seven saved files were identified:\\n\",\"\\n\",\"- `Experiment_18_Final_Research_Package.zip`\\n\",\"- `experiment18_facenet_lfw_embeddings.npz`\\n\",\"- `experiment18_final_research_evidence.json`\\n\",\"- `experiment18_final_research_evidence.md`\\n\",\"- `experiment18_illumination_results.npz`\\n\",\"- `illumination_identity_summary.csv`\\n\",\"- `illumination_metadata.json`\\n\",\"\\n\",\"Two NumPy archives, one CSV file and two JSON files were inspected.\\n\",\"\\n\",\"**2. Embedding Archive Verification**\\n\",\"\\n\",\"The saved embedding archive contained reference, calibration and evaluation embeddings with 512 dimensions.\\n\",\"\\n\",\"The inspected array shapes were:\\n\",\"\\n\",\"- Reference embeddings: (1460, 512)\\n\",\"- Calibration embeddings: (568, 512)\\n\",\"- Evaluation embeddings: (956, 512)\\n\",\"\\n\",\"The saved illumination archive contained:\\n\",\"\\n\",\"- Original embeddings: (889, 512)\\n\",\"- Low-illumination embeddings: (889, 512)\\n\",\"- High-illumination embeddings: (889, 512)\\n\",\"- Paired labels: (889,)\\n\",\"- Common positions: (889,)\\n\",\"- Low-illumination displacement: (889,)\\n\",\"- High-illumination displacement: (889,)\\n\",\"\\n\",\"All inspected numerical arrays contained finite values. The required illumination archive structures passed validation.\\n\",\"\\n\",\"**3. Identity-Level Summary Verification**\\n\",\"\\n\",\"The saved `illumination_identity_summary.csv` file contained 13 identity records and five columns.\\n\",\"\\n\",\"The file was successfully read and inspected. It was non-empty and its structure was verified.\\n\",\"\\n\",\"**4. Metadata Verification**\\n\",\"\\n\",\"The saved JSON metadata files were successfully inspected.\\n\",\"\\n\",\"The illumination metadata matched the recorded experimental configuration:\\n\",\"\\n\",\"- Dataset: LFW filtered subset\\n\",\"- Model: InceptionResnetV1\\n\",\"- Pretrained weights: VGGFace2\\n\",\"- Embedding dimension: 512\\n\",\"- Full paired images: 889\\n\",\"- Evaluation identities: 13\\n\",\"\\n\",\"The saved illumination-displacement statistics were retained as a separate historical analysis and were not confused with the corrected detector-response statistical results.\\n\",\"\\n\",\"**5. Corrected Detector Statistical Result Verification**\\n\",\"\\n\",\"The current in-memory `statistical_results` table was available and contained two detector records.\\n\",\"\\n\",\"The corrected results were verified:\\n\",\"\\n\",\"- Euclidean: Wilcoxon statistic = 13.0, p = 0.021484.\\n\",\"- Mahalanobis: Wilcoxon statistic = 5.0, p = 0.002441.\\n\",\"\\n\",\"Both results were statistically significant at the nominal 5% level.\\n\",\"\\n\",\"These corrected results supersede the older detector-response statistics previously recorded in the saved research evidence.\\n\",\"\\n\",\"**6. Corrected Evaluation Cohort Verification**\\n\",\"\\n\",\"The corrected identity-level evaluation arrays were independently verified in memory:\\n\",\"\\n\",\"- `evaluation_baseline`: (229, 512)\\n\",\"- `evaluation_low`: (229, 512)\\n\",\"- `evaluation_high`: (229, 512)\\n\",\"- `evaluation_labels`: (229,)\\n\",\"\\n\",\"The cohort contained 229 images across 13 identities.\\n\",\"\\n\",\"All four variables passed the shape and availability checks.\\n\",\"\\n\",\"The 229-image corrected evaluation cohort remains distinct from the full 889-image paired illumination archive.\\n\",\"\\n\",\"**7. Scientific and Reproducibility Limitations**\\n\",\"\\n\",\"The audit confirms the availability and structural integrity of the inspected saved files and current in-memory results.\\n\",\"\\n\",\"It does not independently reproduce the original embedding extraction, detector calculations or statistical experiments.\\n\",\"\\n\",\"The saved illumination-displacement statistics and corrected detector-response statistics represent separate analyses and must be interpreted independently.\\n\",\"\\n\",\"The experiment remains limited to 13 identities and does not establish real-world biometric recognition accuracy, fairness or deployment readiness.\\n\",\"\\n\",\"**8. Statistical Provenance Record**\\n\",\"\\n\",\"A separate statistical provenance record was generated to distinguish the saved illumination-displacement analysis from the corrected Step 17 detector-response analysis.\\n\",\"\\n\",\"The historical illumination-displacement results retained from `illumination_metadata.json` were:\\n\",\"\\n\",\"- Image-level displacement: p = 4.708938 × 10⁻⁸⁰.\\n\",\"- Identity-level displacement: p = 0.001220703125.\\n\",\"\\n\",\"The corrected Step 17 detector-response results validated in Step 17.10.2 were:\\n\",\"\\n\",\"- Euclidean: p = 0.021484.\\n\",\"- Mahalanobis: p = 0.002441.\\n\",\"\\n\",\"All four records passed provenance validation. The historical metadata was preserved without modification.\\n\",\"\\n\",\"These results represent separate statistical analyses and must not be substituted for one another.\\n\",\"\\n\",\"**Status: Successfully Completed**\\n\",\"\\n\",\"The saved results and output verification audit completed successfully.\\n\",\"\\n\",\"Seven saved files were identified and inspected. Both NumPy archives, the identity-level CSV summary and JSON metadata records were examined. The corrected detector-response statistical results were verified against the current in-memory table, and the corrected 229-image evaluation cohort was independently confirmed.\\n\",\"\\n\",\"No embeddings, detector scores, statistical tests or bootstrap simulations were regenerated. No saved experimental files were modified.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 119\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 18 — STEP 17.10.4\\n\",\"# SAVED RESULTS AND OUTPUT VERIFICATION\\n\",\"# ============================================================\\n\",\"\\n\",\"import os\\n\",\"import json\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"from pathlib import Path\\n\",\"from IPython.display import display\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Define existing results directory\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"results_dir = Path(\\n\",\"    \\\"/content/drive/MyDrive/Experiment_18_Results\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"EXPERIMENT 18 — STEP 17.10.4\\\")\\n\",\"print(\\\"SAVED RESULTS AND OUTPUT VERIFICATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"assert results_dir.exists(), (\\n\",\"    f\\\"Results directory not found: {results_dir}. \\\"\\n\",\"    \\\"Check Google Drive mounting and directory path.\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n1. RESULTS DIRECTORY\\\")\\n\",\"print(\\\"Directory:\\\", results_dir)\\n\",\"print(\\\"Directory exists: YES\\\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Inventory saved files\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n2. SAVED FILE INVENTORY\\\")\\n\",\"\\n\",\"saved_files = sorted(\\n\",\"    file for file in results_dir.rglob(\\\"*\\\")\\n\",\"    if file.is_file()\\n\",\")\\n\",\"\\n\",\"file_inventory = []\\n\",\"\\n\",\"for file in saved_files:\\n\",\"\\n\",\"    size_kb = file.stat().st_size / 1024\\n\",\"\\n\",\"    file_inventory.append({\\n\",\"        \\\"File\\\": str(file.relative_to(results_dir)),\\n\",\"        \\\"Size (KB)\\\": round(size_kb, 2),\\n\",\"        \\\"Extension\\\": file.suffix.lower()\\n\",\"    })\\n\",\"\\n\",\"if file_inventory:\\n\",\"    display(pd.DataFrame(file_inventory))\\n\",\"else:\\n\",\"    print(\\\"No saved files found.\\\")\\n\",\"\\n\",\"print(\\\"Total saved files:\\\", len(saved_files))\\n\",\"\\n\",\"npz_files = [\\n\",\"    f for f in saved_files if f.suffix.lower() == \\\".npz\\\"\\n\",\"]\\n\",\"\\n\",\"npy_files = [\\n\",\"    f for f in saved_files if f.suffix.lower() == \\\".npy\\\"\\n\",\"]\\n\",\"\\n\",\"csv_files = [\\n\",\"    f for f in saved_files if f.suffix.lower() == \\\".csv\\\"\\n\",\"]\\n\",\"\\n\",\"json_files = [\\n\",\"    f for f in saved_files if f.suffix.lower() == \\\".json\\\"\\n\",\"]\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Inspect NumPy archives without modifying them\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n3. NUMPY ARCHIVE INSPECTION\\\")\\n\",\"\\n\",\"numpy_archive_records = []\\n\",\"\\n\",\"for file in npz_files:\\n\",\"\\n\",\"    print(\\\"\\\\nArchive:\\\", file.name)\\n\",\"\\n\",\"    try:\\n\",\"\\n\",\"        with np.load(file, allow_pickle=False) as archive:\\n\",\"\\n\",\"            for key in archive.files:\\n\",\"\\n\",\"                array = archive[key]\\n\",\"\\n\",\"                finite = (\\n\",\"                    bool(np.isfinite(array).all())\\n\",\"                    if np.issubdtype(array.dtype, np.number)\\n\",\"                    else None\\n\",\"                )\\n\",\"\\n\",\"                record = {\\n\",\"                    \\\"Archive\\\": file.name,\\n\",\"                    \\\"Key\\\": key,\\n\",\"                    \\\"Shape\\\": str(array.shape),\\n\",\"                    \\\"Dtype\\\": str(array.dtype),\\n\",\"                    \\\"Finite\\\": finite\\n\",\"                }\\n\",\"\\n\",\"                numpy_archive_records.append(record)\\n\",\"\\n\",\"                print(\\n\",\"                    f\\\"{key}: shape={array.shape}, \\\"\\n\",\"                    f\\\"dtype={array.dtype}, finite={finite}\\\"\\n\",\"                )\\n\",\"\\n\",\"    except Exception as error:\\n\",\"\\n\",\"        print(\\\"Archive inspection error:\\\", str(error))\\n\",\"\\n\",\"if numpy_archive_records:\\n\",\"    display(pd.DataFrame(numpy_archive_records))\\n\",\"\\n\",\"# Inspect standalone NPY files, if present.\\n\",\"\\n\",\"for file in npy_files:\\n\",\"\\n\",\"    print(\\\"\\\\nNPY file:\\\", file.name)\\n\",\"\\n\",\"    try:\\n\",\"\\n\",\"        array = np.load(file, allow_pickle=False)\\n\",\"\\n\",\"        print(\\\"Shape:\\\", array.shape)\\n\",\"        print(\\\"Dtype:\\\", array.dtype)\\n\",\"\\n\",\"        if np.issubdtype(array.dtype, np.number):\\n\",\"            print(\\\"All values finite:\\\", np.isfinite(array).all())\\n\",\"\\n\",\"    except Exception as error:\\n\",\"\\n\",\"        print(\\\"NPY inspection error:\\\", str(error))\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Verify illumination archive structure\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n4. ILLUMINATION ARCHIVE VALIDATION\\\")\\n\",\"\\n\",\"illumination_archive = (\\n\",\"    results_dir / \\\"experiment18_illumination_results.npz\\\"\\n\",\")\\n\",\"\\n\",\"if illumination_archive.exists():\\n\",\"\\n\",\"    with np.load(\\n\",\"        illumination_archive,\\n\",\"        allow_pickle=False\\n\",\"    ) as archive:\\n\",\"\\n\",\"        required_keys = [\\n\",\"            \\\"original_embeddings\\\",\\n\",\"            \\\"low_illumination_embeddings\\\",\\n\",\"            \\\"high_illumination_embeddings\\\",\\n\",\"            \\\"paired_labels\\\",\\n\",\"            \\\"common_positions\\\",\\n\",\"            \\\"low_displacement\\\",\\n\",\"            \\\"high_displacement\\\"\\n\",\"        ]\\n\",\"\\n\",\"        missing_keys = [\\n\",\"            key for key in required_keys\\n\",\"            if key not in archive.files\\n\",\"        ]\\n\",\"\\n\",\"        assert not missing_keys, (\\n\",\"            f\\\"Missing illumination archive keys: {missing_keys}\\\"\\n\",\"        )\\n\",\"\\n\",\"        expected_shapes = {\\n\",\"            \\\"original_embeddings\\\": (889, 512),\\n\",\"            \\\"low_illumination_embeddings\\\": (889, 512),\\n\",\"            \\\"high_illumination_embeddings\\\": (889, 512),\\n\",\"            \\\"paired_labels\\\": (889,),\\n\",\"            \\\"common_positions\\\": (889,),\\n\",\"            \\\"low_displacement\\\": (889,),\\n\",\"            \\\"high_displacement\\\": (889,)\\n\",\"        }\\n\",\"\\n\",\"        archive_checks = []\\n\",\"\\n\",\"        for key, expected_shape in expected_shapes.items():\\n\",\"\\n\",\"            actual = archive[key]\\n\",\"\\n\",\"            shape_passed = actual.shape == expected_shape\\n\",\"\\n\",\"            finite_passed = (\\n\",\"                np.isfinite(actual).all()\\n\",\"                if np.issubdtype(actual.dtype, np.number)\\n\",\"                else True\\n\",\"            )\\n\",\"\\n\",\"            assert shape_passed, (\\n\",\"                f\\\"{key}: expected {expected_shape}, \\\"\\n\",\"                f\\\"found {actual.shape}\\\"\\n\",\"            )\\n\",\"\\n\",\"            assert finite_passed, (\\n\",\"                f\\\"{key}: non-finite numerical values found.\\\"\\n\",\"            )\\n\",\"\\n\",\"            archive_checks.append({\\n\",\"                \\\"Array\\\": key,\\n\",\"                \\\"Actual Shape\\\": str(actual.shape),\\n\",\"                \\\"Expected Shape\\\": str(expected_shape),\\n\",\"                \\\"Status\\\": \\\"PASSED\\\"\\n\",\"            })\\n\",\"\\n\",\"        display(pd.DataFrame(archive_checks))\\n\",\"\\n\",\"        print(\\n\",\"            \\\"Full paired illumination archive validation: PASSED\\\"\\n\",\"        )\\n\",\"\\n\",\"else:\\n\",\"\\n\",\"    print(\\\"Illumination archive not found.\\\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Inspect CSV files\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n5. CSV FILE INSPECTION\\\")\\n\",\"\\n\",\"csv_inventory = []\\n\",\"\\n\",\"for file in csv_files:\\n\",\"\\n\",\"    print(\\\"\\\\nCSV file:\\\", file.name)\\n\",\"\\n\",\"    try:\\n\",\"\\n\",\"        dataframe = pd.read_csv(file)\\n\",\"\\n\",\"        print(\\\"Rows:\\\", len(dataframe))\\n\",\"        print(\\\"Columns:\\\", list(dataframe.columns))\\n\",\"        print(\\\"Empty:\\\", dataframe.empty)\\n\",\"\\n\",\"        csv_inventory.append({\\n\",\"            \\\"File\\\": file.name,\\n\",\"            \\\"Rows\\\": len(dataframe),\\n\",\"            \\\"Columns\\\": len(dataframe.columns),\\n\",\"            \\\"Empty\\\": dataframe.empty\\n\",\"        })\\n\",\"\\n\",\"        display(dataframe.head(3))\\n\",\"\\n\",\"    except Exception as error:\\n\",\"\\n\",\"        print(\\\"CSV inspection error:\\\", str(error))\\n\",\"\\n\",\"if csv_inventory:\\n\",\"    display(pd.DataFrame(csv_inventory))\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. Inspect JSON metadata files\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n6. JSON METADATA INSPECTION\\\")\\n\",\"\\n\",\"metadata_records = {}\\n\",\"\\n\",\"for file in json_files:\\n\",\"\\n\",\"    print(\\\"\\\\nJSON file:\\\", file.name)\\n\",\"\\n\",\"    try:\\n\",\"\\n\",\"        with open(file, \\\"r\\\", encoding=\\\"utf-8\\\") as handle:\\n\",\"            metadata = json.load(handle)\\n\",\"\\n\",\"        metadata_records[file.name] = metadata\\n\",\"\\n\",\"        print(\\\"Top-level metadata keys:\\\")\\n\",\"        print(list(metadata.keys()))\\n\",\"\\n\",\"    except Exception as error:\\n\",\"\\n\",\"        print(\\\"JSON inspection error:\\\", str(error))\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. Validate illumination metadata\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n7. ILLUMINATION METADATA VALIDATION\\\")\\n\",\"\\n\",\"illumination_metadata = metadata_records.get(\\n\",\"    \\\"illumination_metadata.json\\\"\\n\",\")\\n\",\"\\n\",\"if illumination_metadata is not None:\\n\",\"\\n\",\"    expected_metadata = {\\n\",\"        \\\"dataset\\\": \\\"LFW filtered subset\\\",\\n\",\"        \\\"model\\\": \\\"InceptionResnetV1\\\",\\n\",\"        \\\"pretrained_weights\\\": \\\"VGGFace2\\\",\\n\",\"        \\\"embedding_dimension\\\": 512,\\n\",\"        \\\"paired_images\\\": 889,\\n\",\"        \\\"evaluation_identities\\\": 13\\n\",\"    }\\n\",\"\\n\",\"    metadata_checks = []\\n\",\"\\n\",\"    for key, expected_value in expected_metadata.items():\\n\",\"\\n\",\"        actual_value = illumination_metadata.get(key)\\n\",\"\\n\",\"        passed = actual_value == expected_value\\n\",\"\\n\",\"        metadata_checks.append({\\n\",\"            \\\"Field\\\": key,\\n\",\"            \\\"Recorded Value\\\": actual_value,\\n\",\"            \\\"Expected Value\\\": expected_value,\\n\",\"            \\\"Status\\\": \\\"PASSED\\\" if passed else \\\"REVIEW\\\"\\n\",\"        })\\n\",\"\\n\",\"    display(pd.DataFrame(metadata_checks))\\n\",\"\\n\",\"    print(\\\"\\\\nSaved illumination displacement statistics:\\\")\\n\",\"\\n\",\"    displacement_fields = [\\n\",\"        \\\"image_level_wilcoxon_p\\\",\\n\",\"        \\\"identity_level_wilcoxon_p\\\",\\n\",\"        \\\"mean_low_displacement\\\",\\n\",\"        \\\"mean_high_displacement\\\"\\n\",\"    ]\\n\",\"\\n\",\"    for key in displacement_fields:\\n\",\"        print(f\\\"{key}: {illumination_metadata.get(key, 'NOT FOUND')}\\\")\\n\",\"\\n\",\"    print(\\n\",\"        \\\"\\\\nThese values belong to the saved illumination-displacement \\\"\\n\",\"        \\\"analysis. They are not the corrected detector-response \\\"\\n\",\"        \\\"Wilcoxon results from Step 17.10.2.\\\"\\n\",\"    )\\n\",\"\\n\",\"else:\\n\",\"\\n\",\"    print(\\\"illumination_metadata.json not found or unreadable.\\\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 8. Validate corrected detector statistical results\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n8. CORRECTED STEP 17 DETECTOR STATISTICAL RESULTS\\\")\\n\",\"\\n\",\"expected_detector_results = {\\n\",\"    \\\"Euclidean\\\": {\\n\",\"        \\\"Wilcoxon Statistic\\\": 13.0,\\n\",\"        \\\"P-value\\\": 0.021484\\n\",\"    },\\n\",\"    \\\"Mahalanobis\\\": {\\n\",\"        \\\"Wilcoxon Statistic\\\": 5.0,\\n\",\"        \\\"P-value\\\": 0.002441\\n\",\"    }\\n\",\"}\\n\",\"\\n\",\"# Step 17.10.2 uses statistical_results.\\n\",\"# Do not substitute statistical_test_df or historical values.\\n\",\"\\n\",\"if \\\"statistical_results\\\" in globals():\\n\",\"\\n\",\"    current_statistics = statistical_results.copy()\\n\",\"\\n\",\"    required_columns = [\\n\",\"        \\\"Detector\\\",\\n\",\"        \\\"Wilcoxon Statistic\\\",\\n\",\"        \\\"P-value\\\"\\n\",\"    ]\\n\",\"\\n\",\"    for column in required_columns:\\n\",\"        assert column in current_statistics.columns, (\\n\",\"            f\\\"Missing column in statistical_results: {column}\\\"\\n\",\"        )\\n\",\"\\n\",\"    current_statistics = current_statistics.set_index(\\\"Detector\\\")\\n\",\"\\n\",\"    assert set(current_statistics.index) == set(\\n\",\"        expected_detector_results\\n\",\"    ), \\\"Unexpected detector records.\\\"\\n\",\"\\n\",\"    detector_checks = []\\n\",\"\\n\",\"    for detector, expected in expected_detector_results.items():\\n\",\"\\n\",\"        actual_statistic = float(\\n\",\"            current_statistics.loc[\\n\",\"                detector, \\\"Wilcoxon Statistic\\\"\\n\",\"            ]\\n\",\"        )\\n\",\"\\n\",\"        actual_p = float(\\n\",\"            current_statistics.loc[detector, \\\"P-value\\\"]\\n\",\"        )\\n\",\"\\n\",\"        statistic_passed = np.isclose(\\n\",\"            actual_statistic,\\n\",\"            expected[\\\"Wilcoxon Statistic\\\"],\\n\",\"            atol=1e-5,\\n\",\"            rtol=0\\n\",\"        )\\n\",\"\\n\",\"        p_passed = np.isclose(\\n\",\"            actual_p,\\n\",\"            expected[\\\"P-value\\\"],\\n\",\"            atol=1e-5,\\n\",\"            rtol=0\\n\",\"        )\\n\",\"\\n\",\"        assert statistic_passed, (\\n\",\"            f\\\"{detector}: Wilcoxon statistic mismatch.\\\"\\n\",\"        )\\n\",\"\\n\",\"        assert p_passed, (\\n\",\"            f\\\"{detector}: corrected p-value mismatch.\\\"\\n\",\"        )\\n\",\"\\n\",\"        detector_checks.append({\\n\",\"            \\\"Detector\\\": detector,\\n\",\"            \\\"Wilcoxon Statistic\\\": actual_statistic,\\n\",\"            \\\"P-value\\\": actual_p,\\n\",\"            \\\"Nominal 5% Conclusion\\\": (\\n\",\"                \\\"Statistically significant\\\"\\n\",\"                if actual_p < 0.05\\n\",\"                else \\\"Not statistically significant\\\"\\n\",\"            ),\\n\",\"            \\\"Status\\\": \\\"PASSED\\\"\\n\",\"        })\\n\",\"\\n\",\"    display(pd.DataFrame(detector_checks))\\n\",\"\\n\",\"    print(\\n\",\"        \\\"Corrected Step 17 detector statistical results: PASSED\\\"\\n\",\"    )\\n\",\"\\n\",\"else:\\n\",\"\\n\",\"    print(\\n\",\"        \\\"Corrected statistical_results table is unavailable. \\\"\\n\",\"        \\\"Detector statistical results could not be independently \\\"\\n\",\"        \\\"validated in the current session.\\\"\\n\",\"    )\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 9. Verify current in-memory result tables\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n9. CURRENT IN-MEMORY RESULT TABLES\\\")\\n\",\"\\n\",\"required_tables = [\\n\",\"    \\\"evaluation_detector_df\\\",\\n\",\"    \\\"identity_detector_df\\\",\\n\",\"    \\\"statistical_results\\\",\\n\",\"    \\\"effect_size_df\\\"\\n\",\"]\\n\",\"\\n\",\"table_records = []\\n\",\"\\n\",\"for table_name in required_tables:\\n\",\"\\n\",\"    if table_name in globals():\\n\",\"\\n\",\"        table = globals()[table_name]\\n\",\"\\n\",\"        assert isinstance(table, pd.DataFrame), (\\n\",\"            f\\\"{table_name} is not a pandas DataFrame.\\\"\\n\",\"        )\\n\",\"\\n\",\"        table_records.append({\\n\",\"            \\\"Table\\\": table_name,\\n\",\"            \\\"Availability\\\": \\\"AVAILABLE\\\",\\n\",\"            \\\"Rows\\\": len(table),\\n\",\"            \\\"Columns\\\": len(table.columns)\\n\",\"        })\\n\",\"\\n\",\"    else:\\n\",\"\\n\",\"        table_records.append({\\n\",\"            \\\"Table\\\": table_name,\\n\",\"            \\\"Availability\\\": \\\"NOT AVAILABLE\\\",\\n\",\"            \\\"Rows\\\": None,\\n\",\"            \\\"Columns\\\": None\\n\",\"        })\\n\",\"\\n\",\"display(pd.DataFrame(table_records))\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 10. Verify corrected evaluation cohort in memory\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n10. CORRECTED EVALUATION COHORT AVAILABILITY\\\")\\n\",\"\\n\",\"evaluation_names = [\\n\",\"    \\\"evaluation_baseline\\\",\\n\",\"    \\\"evaluation_low\\\",\\n\",\"    \\\"evaluation_high\\\",\\n\",\"    \\\"evaluation_labels\\\"\\n\",\"]\\n\",\"\\n\",\"missing_evaluation = [\\n\",\"    name for name in evaluation_names\\n\",\"    if name not in globals()\\n\",\"]\\n\",\"\\n\",\"if not missing_evaluation:\\n\",\"\\n\",\"    cohort_checks = []\\n\",\"\\n\",\"    for name in evaluation_names[:3]:\\n\",\"\\n\",\"        array = np.asarray(globals()[name])\\n\",\"\\n\",\"        assert array.shape == (229, 512), (\\n\",\"            f\\\"{name}: unexpected shape {array.shape}\\\"\\n\",\"        )\\n\",\"\\n\",\"        assert np.isfinite(array).all(), (\\n\",\"            f\\\"{name}: non-finite values found.\\\"\\n\",\"        )\\n\",\"\\n\",\"        cohort_checks.append({\\n\",\"            \\\"Variable\\\": name,\\n\",\"            \\\"Shape\\\": str(array.shape),\\n\",\"            \\\"Status\\\": \\\"PASSED\\\"\\n\",\"        })\\n\",\"\\n\",\"    labels = np.asarray(evaluation_labels)\\n\",\"\\n\",\"    assert labels.shape == (229,)\\n\",\"    assert len(np.unique(labels)) == 13\\n\",\"\\n\",\"    cohort_checks.append({\\n\",\"        \\\"Variable\\\": \\\"evaluation_labels\\\",\\n\",\"        \\\"Shape\\\": str(labels.shape),\\n\",\"        \\\"Status\\\": \\\"PASSED\\\"\\n\",\"    })\\n\",\"\\n\",\"    display(pd.DataFrame(cohort_checks))\\n\",\"\\n\",\"    print(\\n\",\"        \\\"Corrected 229-image evaluation cohort: VERIFIED IN MEMORY\\\"\\n\",\"    )\\n\",\"\\n\",\"else:\\n\",\"\\n\",\"    print(\\n\",\"        \\\"Corrected evaluation cohort not fully available. \\\"\\n\",\"        \\\"Missing variables:\\\",\\n\",\"        missing_evaluation\\n\",\"    )\\n\",\"\\n\",\"    print(\\n\",\"        \\\"The saved illumination archive contains the full 889-image \\\"\\n\",\"        \\\"paired arrays; this does not establish that the separate \\\"\\n\",\"        \\\"229-image evaluation arrays were saved in that archive.\\\"\\n\",\"    )\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 11. Final audit summary\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"print(\\\"STEP 17.10.4 — FINAL AUDIT SUMMARY\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"print(\\\"Results directory exists:\\\", results_dir.exists())\\n\",\"print(\\\"Saved files identified:\\\", len(saved_files))\\n\",\"print(\\\"NPZ files identified:\\\", len(npz_files))\\n\",\"print(\\\"NPY files identified:\\\", len(npy_files))\\n\",\"print(\\\"CSV files identified:\\\", len(csv_files))\\n\",\"print(\\\"JSON files identified:\\\", len(json_files))\\n\",\"\\n\",\"print(\\\"\\\\nAudit interpretation:\\\")\\n\",\"print(\\\"- Saved files were inspected without modification.\\\")\\n\",\"print(\\\"- NumPy archive structures and numerical values were checked.\\\")\\n\",\"print(\\\"- CSV structure and metadata fields were inspected.\\\")\\n\",\"print(\\\"- Illumination-displacement statistics were kept separate.\\\")\\n\",\"print(\\\"- Corrected detector-response statistics were checked separately.\\\")\\n\",\"print(\\\"- Historical values were not substituted for corrected results.\\\")\\n\",\"print(\\\"- File presence alone does not prove full reproducibility.\\\")\\n\",\"print(\\\"- No embeddings, detector scores or statistical tests were regenerated.\\\")\\n\",\"\\n\",\"print(\\\"\\\\nSTEP 17.10.4 INSPECTION COMPLETED\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 122\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"### Step 17.10.5 — Independent Verification of Saved Illumination Statistics\\n\",\"\\n\",\"**Objective**\\n\",\"\\n\",\"Independently verify the integrity and statistical consistency of the previously saved illumination experiment results.\\n\",\"\\n\",\"This stage examines the existing paired embeddings, displacement arrays, identity labels and metadata generated during Experiment 18.\\n\",\"\\n\",\"The verification will:\\n\",\"\\n\",\"1. Load the previously saved illumination results without modifying the original files.\\n\",\"2. Confirm embedding dimensions, sample alignment and identity counts.\\n\",\"3. Independently recalculate low- and high-illumination embedding displacement.\\n\",\"4. Compare recalculated displacement values against the saved displacement arrays.\\n\",\"5. Reconstruct image-level and identity-level statistical comparisons.\\n\",\"6. Recalculate the corresponding Wilcoxon signed-rank tests.\\n\",\"7. Compare independently obtained results against the statistical values recorded in `illumination_metadata.json`.\\n\",\"\\n\",\"**Important methodological note**\\n\",\"\\n\",\"The saved illumination displacement analysis and the Step 17 Euclidean/Mahalanobis detector-response analysis are separate analyses. Their statistical results must remain distinct.\\n\",\"\\n\",\"No new embedding extraction, model training or experimental data generation will be performed. Existing saved results will be used for verification only.\\n\",\"\\n\",\"**Expected outcome**\\n\",\"\\n\",\"Establish whether the previously saved illumination displacement values and statistical results can be independently reproduced from the available experimental outputs.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 123\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 18 — STEP 17.10.5.1\\n\",\"# Load and Verify Saved Illumination Data\\n\",\"# ============================================================\\n\",\"\\n\",\"import numpy as np\\n\",\"import json\\n\",\"from pathlib import Path\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Locate existing saved results\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"results_dir = Path(\\\"/content/drive/MyDrive/Experiment_18_Results\\\")\\n\",\"\\n\",\"npz_path = results_dir / \\\"experiment18_illumination_results.npz\\\"\\n\",\"metadata_path = results_dir / \\\"illumination_metadata.json\\\"\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"STEP 17.10.5.1 — SAVED ILLUMINATION DATA VERIFICATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"assert results_dir.exists(), \\\"Results directory does not exist.\\\"\\n\",\"assert npz_path.exists(), \\\"Illumination NPZ file not found.\\\"\\n\",\"assert metadata_path.exists(), \\\"Illumination metadata file not found.\\\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Load existing arrays (read-only inspection)\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"with np.load(npz_path, allow_pickle=False) as data:\\n\",\"\\n\",\"    original_embeddings = data[\\\"original_embeddings\\\"].copy()\\n\",\"    low_illumination_embeddings = data[\\\"low_illumination_embeddings\\\"].copy()\\n\",\"    high_illumination_embeddings = data[\\\"high_illumination_embeddings\\\"].copy()\\n\",\"\\n\",\"    paired_labels = data[\\\"paired_labels\\\"].copy()\\n\",\"\\n\",\"    saved_low_displacement = data[\\\"low_displacement\\\"].copy()\\n\",\"    saved_high_displacement = data[\\\"high_displacement\\\"].copy()\\n\",\"\\n\",\"# Load metadata\\n\",\"with open(metadata_path, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    illumination_metadata = json.load(f)\\n\",\"\\n\",\"print(\\\"\\\\n[1] FILE LOADING\\\")\\n\",\"print(\\\"Illumination NPZ loaded: SUCCESS\\\")\\n\",\"print(\\\"Metadata JSON loaded: SUCCESS\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Inspect array dimensions\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[2] ARRAY DIMENSIONS\\\")\\n\",\"\\n\",\"arrays = {\\n\",\"    \\\"Original embeddings\\\": original_embeddings,\\n\",\"    \\\"Low illumination embeddings\\\": low_illumination_embeddings,\\n\",\"    \\\"High illumination embeddings\\\": high_illumination_embeddings,\\n\",\"    \\\"Paired labels\\\": paired_labels,\\n\",\"    \\\"Saved low displacement\\\": saved_low_displacement,\\n\",\"    \\\"Saved high displacement\\\": saved_high_displacement\\n\",\"}\\n\",\"\\n\",\"for name, array in arrays.items():\\n\",\"    print(f\\\"{name}: {array.shape}\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Verify sample alignment\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[3] SAMPLE ALIGNMENT\\\")\\n\",\"\\n\",\"sample_counts = [len(array) for array in arrays.values()]\\n\",\"\\n\",\"alignment_passed = len(set(sample_counts)) == 1\\n\",\"\\n\",\"print(\\\"Sample counts:\\\", sample_counts)\\n\",\"print(\\\"All sample counts equal:\\\", alignment_passed)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Verify embedding dimensions\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[4] EMBEDDING DIMENSION\\\")\\n\",\"\\n\",\"embedding_dimensions = [\\n\",\"    original_embeddings.shape[1],\\n\",\"    low_illumination_embeddings.shape[1],\\n\",\"    high_illumination_embeddings.shape[1]\\n\",\"]\\n\",\"\\n\",\"dimension_passed = (\\n\",\"    len(set(embedding_dimensions)) == 1\\n\",\"    and embedding_dimensions[0] == 512\\n\",\")\\n\",\"\\n\",\"print(\\\"Embedding dimensions:\\\", embedding_dimensions)\\n\",\"print(\\\"512-dimensional embeddings verified:\\\", dimension_passed)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. Verify numerical validity\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[5] NUMERICAL VALIDITY\\\")\\n\",\"\\n\",\"finite_checks = {}\\n\",\"\\n\",\"for name, array in arrays.items():\\n\",\"    finite_checks[name] = bool(np.isfinite(array).all())\\n\",\"\\n\",\"    print(\\n\",\"        f\\\"{name}: \\\"\\n\",\"        f\\\"{'PASS' if finite_checks[name] else 'FAIL'}\\\"\\n\",\"    )\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. Verify identity information\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[6] IDENTITY VERIFICATION\\\")\\n\",\"\\n\",\"unique_identities = np.unique(paired_labels)\\n\",\"\\n\",\"print(\\\"Number of identities:\\\", len(unique_identities))\\n\",\"print(\\\"Identity labels:\\\", unique_identities.tolist())\\n\",\"\\n\",\"identity_count_passed = (\\n\",\"    len(unique_identities)\\n\",\"    == illumination_metadata.get(\\\"evaluation_identities\\\")\\n\",\")\\n\",\"\\n\",\"print(\\\"Metadata identity count matches:\\\", identity_count_passed)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 8. Verify metadata sample count\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[7] METADATA SAMPLE COUNT\\\")\\n\",\"\\n\",\"metadata_sample_count = illumination_metadata.get(\\\"paired_images\\\")\\n\",\"\\n\",\"sample_count_passed = (\\n\",\"    metadata_sample_count == len(paired_labels)\\n\",\")\\n\",\"\\n\",\"print(\\\"Saved paired images:\\\", metadata_sample_count)\\n\",\"print(\\\"Actual paired labels:\\\", len(paired_labels))\\n\",\"print(\\\"Metadata sample count matches:\\\", sample_count_passed)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 9. Display saved statistical results\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[8] EXISTING METADATA STATISTICS\\\")\\n\",\"\\n\",\"metadata_statistics = [\\n\",\"    \\\"image_level_wilcoxon_p\\\",\\n\",\"    \\\"identity_level_wilcoxon_p\\\",\\n\",\"    \\\"mean_low_displacement\\\",\\n\",\"    \\\"mean_high_displacement\\\"\\n\",\"]\\n\",\"\\n\",\"for key in metadata_statistics:\\n\",\"    print(f\\\"{key}: {illumination_metadata.get(key)}\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 10. Final validation\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"all_checks_passed = (\\n\",\"    alignment_passed\\n\",\"    and dimension_passed\\n\",\"    and all(finite_checks.values())\\n\",\"    and identity_count_passed\\n\",\"    and sample_count_passed\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"\\n\",\"if all_checks_passed:\\n\",\"    print(\\\"STEP 17.10.5.1 STATUS: PASSED\\\")\\n\",\"else:\\n\",\"    print(\\\"STEP 17.10.5.1 STATUS: REVIEW REQUIRED\\\")\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 124\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 18 — STEP 17.10.5.2\\n\",\"# Independent Displacement Recalculation\\n\",\"# ============================================================\\n\",\"\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"print(\\\"STEP 17.10.5.2 — INDEPENDENT DISPLACEMENT VERIFICATION\\\")\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Independently recalculate embedding displacement\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"recalculated_low_displacement = np.linalg.norm(\\n\",\"    low_illumination_embeddings - original_embeddings,\\n\",\"    axis=1\\n\",\")\\n\",\"\\n\",\"recalculated_high_displacement = np.linalg.norm(\\n\",\"    high_illumination_embeddings - original_embeddings,\\n\",\"    axis=1\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n[1] DISPLACEMENT RECALCULATION\\\")\\n\",\"print(\\\"Low displacement shape:\\\", recalculated_low_displacement.shape)\\n\",\"print(\\\"High displacement shape:\\\", recalculated_high_displacement.shape)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Compare recalculated values with saved arrays\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"low_absolute_difference = np.abs(\\n\",\"    recalculated_low_displacement - saved_low_displacement\\n\",\")\\n\",\"\\n\",\"high_absolute_difference = np.abs(\\n\",\"    recalculated_high_displacement - saved_high_displacement\\n\",\")\\n\",\"\\n\",\"low_match = np.allclose(\\n\",\"    recalculated_low_displacement,\\n\",\"    saved_low_displacement,\\n\",\"    rtol=1e-5,\\n\",\"    atol=1e-6\\n\",\")\\n\",\"\\n\",\"high_match = np.allclose(\\n\",\"    recalculated_high_displacement,\\n\",\"    saved_high_displacement,\\n\",\"    rtol=1e-5,\\n\",\"    atol=1e-6\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n[2] SAVED ARRAY COMPARISON\\\")\\n\",\"\\n\",\"print(\\\"Low displacement matches:\\\", low_match)\\n\",\"print(\\\"High displacement matches:\\\", high_match)\\n\",\"\\n\",\"print(\\\"Low maximum absolute difference:\\\",\\n\",\"      np.max(low_absolute_difference))\\n\",\"\\n\",\"print(\\\"High maximum absolute difference:\\\",\\n\",\"      np.max(high_absolute_difference))\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Compare descriptive statistics\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"displacement_summary = pd.DataFrame([\\n\",\"    {\\n\",\"        \\\"Condition\\\": \\\"Low illumination\\\",\\n\",\"        \\\"Saved Mean\\\": np.mean(saved_low_displacement),\\n\",\"        \\\"Recalculated Mean\\\": np.mean(recalculated_low_displacement),\\n\",\"        \\\"Saved Median\\\": np.median(saved_low_displacement),\\n\",\"        \\\"Recalculated Median\\\": np.median(recalculated_low_displacement),\\n\",\"        \\\"Saved Std\\\": np.std(saved_low_displacement),\\n\",\"        \\\"Recalculated Std\\\": np.std(recalculated_low_displacement)\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Condition\\\": \\\"High illumination\\\",\\n\",\"        \\\"Saved Mean\\\": np.mean(saved_high_displacement),\\n\",\"        \\\"Recalculated Mean\\\": np.mean(recalculated_high_displacement),\\n\",\"        \\\"Saved Median\\\": np.median(saved_high_displacement),\\n\",\"        \\\"Recalculated Median\\\": np.median(recalculated_high_displacement),\\n\",\"        \\\"Saved Std\\\": np.std(saved_high_displacement),\\n\",\"        \\\"Recalculated Std\\\": np.std(recalculated_high_displacement)\\n\",\"    }\\n\",\"])\\n\",\"\\n\",\"print(\\\"\\\\n[3] DESCRIPTIVE STATISTICS\\\")\\n\",\"display(displacement_summary)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Compare recalculated means with metadata\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"metadata_low_mean = illumination_metadata[\\\"mean_low_displacement\\\"]\\n\",\"metadata_high_mean = illumination_metadata[\\\"mean_high_displacement\\\"]\\n\",\"\\n\",\"recalculated_low_mean = np.mean(recalculated_low_displacement)\\n\",\"recalculated_high_mean = np.mean(recalculated_high_displacement)\\n\",\"\\n\",\"low_metadata_match = np.isclose(\\n\",\"    recalculated_low_mean,\\n\",\"    metadata_low_mean,\\n\",\"    rtol=1e-5,\\n\",\"    atol=1e-6\\n\",\")\\n\",\"\\n\",\"high_metadata_match = np.isclose(\\n\",\"    recalculated_high_mean,\\n\",\"    metadata_high_mean,\\n\",\"    rtol=1e-5,\\n\",\"    atol=1e-6\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n[4] METADATA MEAN COMPARISON\\\")\\n\",\"\\n\",\"print(\\\"Saved low mean:\\\", metadata_low_mean)\\n\",\"print(\\\"Recalculated low mean:\\\", recalculated_low_mean)\\n\",\"print(\\\"Low metadata match:\\\", low_metadata_match)\\n\",\"\\n\",\"print(\\\"\\\\nSaved high mean:\\\", metadata_high_mean)\\n\",\"print(\\\"Recalculated high mean:\\\", recalculated_high_mean)\\n\",\"print(\\\"High metadata match:\\\", high_metadata_match)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Final verification\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"all_displacement_checks_passed = (\\n\",\"    low_match\\n\",\"    and high_match\\n\",\"    and low_metadata_match\\n\",\"    and high_metadata_match\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 75)\\n\",\"\\n\",\"if all_displacement_checks_passed:\\n\",\"    print(\\\"STEP 17.10.5.2 STATUS: PASSED\\\")\\n\",\"else:\\n\",\"    print(\\\"STEP 17.10.5.2 STATUS: REVIEW REQUIRED\\\")\\n\",\"\\n\",\"print(\\\"=\\\" * 75)\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 129\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 18 — STEP 17.10.5.6\\n\",\"# FINAL STATISTICAL CONSISTENCY AND REPRODUCIBILITY AUDIT\\n\",\"# ============================================================\\n\",\"\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"import json\\n\",\"\\n\",\"from pathlib import Path\\n\",\"from scipy.stats import wilcoxon\\n\",\"\\n\",\"print(\\\"=\\\" * 80)\\n\",\"print(\\\"STEP 17.10.5.6 — FINAL STATISTICAL CONSISTENCY AUDIT\\\")\\n\",\"print(\\\"=\\\" * 80)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Load original saved files\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"results_dir = Path(\\n\",\"    \\\"/content/drive/MyDrive/Experiment_18_Results\\\"\\n\",\")\\n\",\"\\n\",\"npz_path = results_dir / \\\"experiment18_illumination_results.npz\\\"\\n\",\"metadata_path = results_dir / \\\"illumination_metadata.json\\\"\\n\",\"csv_path = results_dir / \\\"illumination_identity_summary.csv\\\"\\n\",\"\\n\",\"assert npz_path.exists(), \\\"Illumination NPZ file missing.\\\"\\n\",\"assert metadata_path.exists(), \\\"Metadata JSON missing.\\\"\\n\",\"assert csv_path.exists(), \\\"Identity summary CSV missing.\\\"\\n\",\"\\n\",\"with np.load(npz_path, allow_pickle=False) as data:\\n\",\"    original = data[\\\"original_embeddings\\\"].copy()\\n\",\"    low = data[\\\"low_illumination_embeddings\\\"].copy()\\n\",\"    high = data[\\\"high_illumination_embeddings\\\"].copy()\\n\",\"    labels = data[\\\"paired_labels\\\"].copy()\\n\",\"    saved_low = data[\\\"low_displacement\\\"].copy()\\n\",\"    saved_high = data[\\\"high_displacement\\\"].copy()\\n\",\"\\n\",\"with open(metadata_path, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    metadata = json.load(f)\\n\",\"\\n\",\"saved_csv = pd.read_csv(csv_path)\\n\",\"\\n\",\"print(\\\"\\\\n[1] SAVED FILES\\\")\\n\",\"print(\\\"NPZ loaded: SUCCESS\\\")\\n\",\"print(\\\"Metadata loaded: SUCCESS\\\")\\n\",\"print(\\\"Identity CSV loaded: SUCCESS\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Independently recalculate displacement\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"recalculated_low = np.linalg.norm(\\n\",\"    low - original,\\n\",\"    axis=1\\n\",\")\\n\",\"\\n\",\"recalculated_high = np.linalg.norm(\\n\",\"    high - original,\\n\",\"    axis=1\\n\",\")\\n\",\"\\n\",\"low_displacement_match = np.allclose(\\n\",\"    recalculated_low,\\n\",\"    saved_low,\\n\",\"    rtol=1e-5,\\n\",\"    atol=1e-6\\n\",\")\\n\",\"\\n\",\"high_displacement_match = np.allclose(\\n\",\"    recalculated_high,\\n\",\"    saved_high,\\n\",\"    rtol=1e-5,\\n\",\"    atol=1e-6\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n[2] DISPLACEMENT REPRODUCTION\\\")\\n\",\"print(\\\"Low displacement matches:\\\", low_displacement_match)\\n\",\"print(\\\"High displacement matches:\\\", high_displacement_match)\\n\",\"\\n\",\"low_mean_match = np.isclose(\\n\",\"    np.mean(recalculated_low),\\n\",\"    metadata[\\\"mean_low_displacement\\\"],\\n\",\"    rtol=1e-5,\\n\",\"    atol=1e-6\\n\",\")\\n\",\"\\n\",\"high_mean_match = np.isclose(\\n\",\"    np.mean(recalculated_high),\\n\",\"    metadata[\\\"mean_high_displacement\\\"],\\n\",\"    rtol=1e-5,\\n\",\"    atol=1e-6\\n\",\")\\n\",\"\\n\",\"print(\\\"Low displacement mean matches metadata:\\\", low_mean_match)\\n\",\"print(\\\"High displacement mean matches metadata:\\\", high_mean_match)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Recalculate image-level Wilcoxon test\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"image_test = wilcoxon(\\n\",\"    recalculated_high,\\n\",\"    recalculated_low,\\n\",\"    alternative=\\\"two-sided\\\"\\n\",\")\\n\",\"\\n\",\"image_p_match = np.isclose(\\n\",\"    image_test.pvalue,\\n\",\"    metadata[\\\"image_level_wilcoxon_p\\\"],\\n\",\"    rtol=1e-5,\\n\",\"    atol=1e-12\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n[3] IMAGE-LEVEL STATISTICAL REPRODUCTION\\\")\\n\",\"print(\\\"Observations:\\\", len(labels))\\n\",\"print(\\\"Wilcoxon statistic:\\\", image_test.statistic)\\n\",\"print(\\\"Recalculated p-value:\\\", image_test.pvalue)\\n\",\"print(\\\"Saved p-value:\\\", metadata[\\\"image_level_wilcoxon_p\\\"])\\n\",\"print(\\\"P-value matches metadata:\\\", image_p_match)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Reconstruct identity-level mean and median summaries\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"audit_df = pd.DataFrame({\\n\",\"    \\\"Identity\\\": labels,\\n\",\"    \\\"Low_Displacement\\\": recalculated_low,\\n\",\"    \\\"High_Displacement\\\": recalculated_high\\n\",\"})\\n\",\"\\n\",\"identity_audit = (\\n\",\"    audit_df\\n\",\"    .groupby(\\\"Identity\\\")\\n\",\"    .agg(\\n\",\"        Image_Count=(\\\"Low_Displacement\\\", \\\"count\\\"),\\n\",\"        Low_Mean=(\\\"Low_Displacement\\\", \\\"mean\\\"),\\n\",\"        High_Mean=(\\\"High_Displacement\\\", \\\"mean\\\"),\\n\",\"        Low_Median=(\\\"Low_Displacement\\\", \\\"median\\\"),\\n\",\"        High_Median=(\\\"High_Displacement\\\", \\\"median\\\")\\n\",\"    )\\n\",\"    .reset_index()\\n\",\")\\n\",\"\\n\",\"identity_audit[\\\"Mean_Difference\\\"] = (\\n\",\"    identity_audit[\\\"High_Mean\\\"]\\n\",\"    - identity_audit[\\\"Low_Mean\\\"]\\n\",\")\\n\",\"\\n\",\"identity_audit[\\\"Median_Difference\\\"] = (\\n\",\"    identity_audit[\\\"High_Median\\\"]\\n\",\"    - identity_audit[\\\"Low_Median\\\"]\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n[4] IDENTITY-LEVEL SUMMARY\\\")\\n\",\"print(\\\"Number of identities:\\\", len(identity_audit))\\n\",\"print(\\\"Positive mean differences:\\\",\\n\",\"      (identity_audit[\\\"Mean_Difference\\\"] > 0).sum())\\n\",\"print(\\\"Negative mean differences:\\\",\\n\",\"      (identity_audit[\\\"Mean_Difference\\\"] < 0).sum())\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Recalculate mean-based identity Wilcoxon test\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"mean_identity_test = wilcoxon(\\n\",\"    identity_audit[\\\"High_Mean\\\"],\\n\",\"    identity_audit[\\\"Low_Mean\\\"],\\n\",\"    alternative=\\\"two-sided\\\"\\n\",\")\\n\",\"\\n\",\"mean_identity_p_match = np.isclose(\\n\",\"    mean_identity_test.pvalue,\\n\",\"    metadata[\\\"identity_level_wilcoxon_p\\\"],\\n\",\"    rtol=1e-5,\\n\",\"    atol=1e-12\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n[5] MEAN-BASED IDENTITY TEST\\\")\\n\",\"print(\\\"Wilcoxon statistic:\\\", mean_identity_test.statistic)\\n\",\"print(\\\"Recalculated p-value:\\\", mean_identity_test.pvalue)\\n\",\"print(\\\"Saved metadata p-value:\\\",\\n\",\"      metadata[\\\"identity_level_wilcoxon_p\\\"])\\n\",\"print(\\\"P-value matches metadata:\\\", mean_identity_p_match)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. Recalculate median-based identity Wilcoxon test\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"median_identity_test = wilcoxon(\\n\",\"    identity_audit[\\\"High_Median\\\"],\\n\",\"    identity_audit[\\\"Low_Median\\\"],\\n\",\"    alternative=\\\"two-sided\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n[6] MEDIAN-BASED IDENTITY TEST\\\")\\n\",\"print(\\\"Wilcoxon statistic:\\\", median_identity_test.statistic)\\n\",\"print(\\\"Median-based p-value:\\\", median_identity_test.pvalue)\\n\",\"\\n\",\"print(\\n\",\"    \\\"Mean-based and median-based p-values numerically equal:\\\",\\n\",\"    np.isclose(\\n\",\"        mean_identity_test.pvalue,\\n\",\"        median_identity_test.pvalue\\n\",\"    )\\n\",\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. Verify saved identity summary CSV\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"expected_csv = pd.DataFrame({\\n\",\"    \\\"Identity\\\": identity_audit[\\\"Identity\\\"],\\n\",\"    \\\"Image_Count\\\": identity_audit[\\\"Image_Count\\\"],\\n\",\"    \\\"Low_Median\\\": identity_audit[\\\"Low_Median\\\"],\\n\",\"    \\\"High_Median\\\": identity_audit[\\\"High_Median\\\"],\\n\",\"    \\\"Median_Difference\\\": identity_audit[\\\"Median_Difference\\\"]\\n\",\"})\\n\",\"\\n\",\"saved_csv_sorted = saved_csv.sort_values(\\n\",\"    \\\"Identity\\\"\\n\",\").reset_index(drop=True)\\n\",\"\\n\",\"expected_csv_sorted = expected_csv.sort_values(\\n\",\"    \\\"Identity\\\"\\n\",\").reset_index(drop=True)\\n\",\"\\n\",\"csv_columns = [\\n\",\"    \\\"Identity\\\",\\n\",\"    \\\"Image_Count\\\",\\n\",\"    \\\"Low_Median\\\",\\n\",\"    \\\"High_Median\\\",\\n\",\"    \\\"Median_Difference\\\"\\n\",\"]\\n\",\"\\n\",\"csv_checks = {}\\n\",\"\\n\",\"for column in csv_columns:\\n\",\"    csv_checks[column] = np.allclose(\\n\",\"        saved_csv_sorted[column].to_numpy(dtype=float),\\n\",\"        expected_csv_sorted[column].to_numpy(dtype=float),\\n\",\"        rtol=1e-5,\\n\",\"        atol=1e-6\\n\",\"    )\\n\",\"\\n\",\"print(\\\"\\\\n[7] SAVED CSV CONSISTENCY\\\")\\n\",\"\\n\",\"for column, passed in csv_checks.items():\\n\",\"    print(f\\\"{column}: {'PASS' if passed else 'FAIL'}\\\")\\n\",\"\\n\",\"csv_passed = all(csv_checks.values())\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 8. Consolidated statistical results\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"consolidated_results = pd.DataFrame([\\n\",\"    {\\n\",\"        \\\"Analysis\\\": \\\"Image-level displacement\\\",\\n\",\"        \\\"Observations\\\": len(labels),\\n\",\"        \\\"Wilcoxon Statistic\\\": image_test.statistic,\\n\",\"        \\\"P-value\\\": image_test.pvalue,\\n\",\"        \\\"Metadata Match\\\": image_p_match\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Analysis\\\": \\\"Mean-based identity displacement\\\",\\n\",\"        \\\"Observations\\\": len(identity_audit),\\n\",\"        \\\"Wilcoxon Statistic\\\": mean_identity_test.statistic,\\n\",\"        \\\"P-value\\\": mean_identity_test.pvalue,\\n\",\"        \\\"Metadata Match\\\": mean_identity_p_match\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Analysis\\\": \\\"Median-based identity displacement\\\",\\n\",\"        \\\"Observations\\\": len(identity_audit),\\n\",\"        \\\"Wilcoxon Statistic\\\": median_identity_test.statistic,\\n\",\"        \\\"P-value\\\": median_identity_test.pvalue,\\n\",\"        \\\"Metadata Match\\\": \\\"Separate analysis\\\"\\n\",\"    }\\n\",\"])\\n\",\"\\n\",\"print(\\\"\\\\n[8] CONSOLIDATED STATISTICAL RESULTS\\\")\\n\",\"display(consolidated_results)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 9. Methodological validation\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[9] METHODOLOGICAL INFORMATION\\\")\\n\",\"\\n\",\"print(\\\"Paired image observations:\\\", len(labels))\\n\",\"print(\\\"Unique identities:\\\", len(np.unique(labels)))\\n\",\"print(\\\"Image observations per identity:\\\")\\n\",\"display(\\n\",\"    identity_audit[[\\\"Identity\\\", \\\"Image_Count\\\"]]\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"\\\\nIMPORTANT: Image observations are clustered within identities.\\\"\\n\",\")\\n\",\"print(\\n\",\"    \\\"The 889 image pairs must not be interpreted as 889 independent subjects.\\\"\\n\",\")\\n\",\"print(\\n\",\"    \\\"Identity-level inference is based on only 13 identities.\\\"\\n\",\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 10. Final audit status\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"audit_checks = {\\n\",\"    \\\"Low displacement reproduction\\\": low_displacement_match,\\n\",\"    \\\"High displacement reproduction\\\": high_displacement_match,\\n\",\"    \\\"Low mean metadata consistency\\\": low_mean_match,\\n\",\"    \\\"High mean metadata consistency\\\": high_mean_match,\\n\",\"    \\\"Image-level Wilcoxon reproduction\\\": image_p_match,\\n\",\"    \\\"Mean-based identity Wilcoxon reproduction\\\": mean_identity_p_match,\\n\",\"    \\\"Saved identity CSV consistency\\\": csv_passed\\n\",\"}\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n\",\"print(\\\"FINAL AUDIT CHECKLIST\\\")\\n\",\"print(\\\"=\\\" * 80)\\n\",\"\\n\",\"for check_name, passed in audit_checks.items():\\n\",\"    print(f\\\"{check_name}: {'PASS' if passed else 'FAIL'}\\\")\\n\",\"\\n\",\"all_passed = all(audit_checks.values())\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n\",\"\\n\",\"if all_passed:\\n\",\"    print(\\\"STEP 17.10.5.6 STATUS: PASSED\\\")\\n\",\"    print(\\\"All saved statistical results were independently reproduced.\\\")\\n\",\"else:\\n\",\"    print(\\\"STEP 17.10.5.6 STATUS: REVIEW REQUIRED\\\")\\n\",\"    print(\\\"At least one consistency check requires investigation.\\\")\\n\",\"\\n\",\"print(\\\"=\\\" * 80)\\n\",\"\\n\",\"print(\\\"\\\\nOriginal saved files modified: NO\\\")\\n\",\"print(\\\"New embedding extraction performed: NO\\\")\\n\",\"print(\\\"New model training performed: NO\\\")\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 130\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"### Step 17.10.6 — Final Research Documentation\\n\",\"\\n\",\"**Objective**\\n\",\"\\n\",\"Prepare the consolidated research documentation for Experiment 18, covering the experimental configuration, dataset characteristics, embedding extraction, detector methodology, statistical findings, reproducibility evidence and research limitations.\\n\",\"\\n\",\"**Expected outcome**\\n\",\"\\n\",\"A complete and transparent research record suitable for academic reporting and future experimental development.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 131\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 18 — STEP 17.10.6.1\\n\",\"# EXPERIMENTAL CONFIGURATION AND EVIDENCE CONSOLIDATION\\n\",\"# ============================================================\\n\",\"\\n\",\"import os\\n\",\"import sys\\n\",\"import json\\n\",\"import platform\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"import scipy\\n\",\"import matplotlib\\n\",\"import torch\\n\",\"import torchvision\\n\",\"\\n\",\"from pathlib import Path\\n\",\"from importlib.metadata import version, PackageNotFoundError\\n\",\"\\n\",\"print(\\\"=\\\" * 80)\\n\",\"print(\\\"STEP 17.10.6.1 — EXPERIMENTAL CONFIGURATION AND EVIDENCE\\\")\\n\",\"print(\\\"=\\\" * 80)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Locate saved experiment files\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"results_dir = Path(\\n\",\"    \\\"/content/drive/MyDrive/Experiment_18_Results\\\"\\n\",\")\\n\",\"\\n\",\"assert results_dir.exists(), \\\"Experiment results directory not found.\\\"\\n\",\"\\n\",\"print(\\\"\\\\n[1] EXPERIMENT RESULTS DIRECTORY\\\")\\n\",\"print(\\\"Directory:\\\", results_dir)\\n\",\"\\n\",\"for file in sorted(results_dir.iterdir()):\\n\",\"    if file.is_file():\\n\",\"        print(\\n\",\"            f\\\"{file.name} | \\\"\\n\",\"            f\\\"{file.stat().st_size / 1024:.2f} KB\\\"\\n\",\"        )\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Load original embedding extraction evidence\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"embedding_path = (\\n\",\"    results_dir / \\\"experiment18_facenet_lfw_embeddings.npz\\\"\\n\",\")\\n\",\"\\n\",\"assert embedding_path.exists(), \\\"Original embedding NPZ not found.\\\"\\n\",\"\\n\",\"with np.load(embedding_path, allow_pickle=False) as data:\\n\",\"\\n\",\"    extraction_evidence = {}\\n\",\"\\n\",\"    for key in data.files:\\n\",\"        value = data[key]\\n\",\"\\n\",\"        if value.ndim == 0:\\n\",\"            extraction_evidence[key] = value.item()\\n\",\"\\n\",\"        else:\\n\",\"            extraction_evidence[key] = {\\n\",\"                \\\"shape\\\": value.shape,\\n\",\"                \\\"dtype\\\": str(value.dtype),\\n\",\"                \\\"finite\\\": (\\n\",\"                    bool(np.isfinite(value).all())\\n\",\"                    if np.issubdtype(value.dtype, np.number)\\n\",\"                    else \\\"N/A\\\"\\n\",\"                )\\n\",\"            }\\n\",\"\\n\",\"assert \\\"evaluation_embeddings\\\" in extraction_evidence, (\\n\",\"    \\\"Evaluation embeddings evidence is missing.\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n[2] ORIGINAL EMBEDDING EXTRACTION EVIDENCE\\\")\\n\",\"\\n\",\"for key, value in extraction_evidence.items():\\n\",\"    print(f\\\"{key}: {value}\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Load controlled illumination metadata\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"metadata_path = results_dir / \\\"illumination_metadata.json\\\"\\n\",\"\\n\",\"assert metadata_path.exists(), \\\"Illumination metadata not found.\\\"\\n\",\"\\n\",\"with open(metadata_path, \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\"    illumination_metadata = json.load(f)\\n\",\"\\n\",\"print(\\\"\\\\n[3] CONTROLLED ILLUMINATION CONFIGURATION\\\")\\n\",\"\\n\",\"for key, value in illumination_metadata.items():\\n\",\"    print(f\\\"{key}: {value}\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Consolidate dataset and cohort characteristics\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"illumination_npz_path = (\\n\",\"    results_dir / \\\"experiment18_illumination_results.npz\\\"\\n\",\")\\n\",\"\\n\",\"assert illumination_npz_path.exists(), (\\n\",\"    \\\"Illumination results NPZ not found.\\\"\\n\",\")\\n\",\"\\n\",\"with np.load(\\n\",\"    illumination_npz_path,\\n\",\"    allow_pickle=False\\n\",\") as data:\\n\",\"\\n\",\"    original = data[\\\"original_embeddings\\\"].copy()\\n\",\"    low = data[\\\"low_illumination_embeddings\\\"].copy()\\n\",\"    high = data[\\\"high_illumination_embeddings\\\"].copy()\\n\",\"    labels = data[\\\"paired_labels\\\"].copy()\\n\",\"\\n\",\"    low_success = data[\\\"low_success\\\"].copy()\\n\",\"    high_success = data[\\\"high_success\\\"].copy()\\n\",\"\\n\",\"    low_failures = data[\\\"low_failures\\\"].copy()\\n\",\"    high_failures = data[\\\"high_failures\\\"].copy()\\n\",\"\\n\",\"\\n\",\"# Basic data integrity checks\\n\",\"assert original.shape == low.shape == high.shape, (\\n\",\"    \\\"Original, low and high embedding shapes do not match.\\\"\\n\",\")\\n\",\"\\n\",\"assert original.ndim == 2, (\\n\",\"    \\\"Embedding arrays must be two-dimensional.\\\"\\n\",\")\\n\",\"\\n\",\"assert len(labels) == original.shape[0], (\\n\",\"    \\\"Paired labels do not match the embedding count.\\\"\\n\",\")\\n\",\"\\n\",\"assert np.isfinite(original).all(), (\\n\",\"    \\\"Original embeddings contain non-finite values.\\\"\\n\",\")\\n\",\"\\n\",\"assert np.isfinite(low).all(), (\\n\",\"    \\\"Low illumination embeddings contain non-finite values.\\\"\\n\",\")\\n\",\"\\n\",\"assert np.isfinite(high).all(), (\\n\",\"    \\\"High illumination embeddings contain non-finite values.\\\"\\n\",\")\\n\",\"\\n\",\"identity_counts = (\\n\",\"    pd.Series(labels)\\n\",\"    .value_counts()\\n\",\"    .sort_index()\\n\",\")\\n\",\"\\n\",\"full_evaluation_count = (\\n\",\"    extraction_evidence[\\\"evaluation_embeddings\\\"][\\\"shape\\\"][0]\\n\",\")\\n\",\"\\n\",\"paired_image_count = len(labels)\\n\",\"identity_count = len(np.unique(labels))\\n\",\"embedding_dimension = original.shape[1]\\n\",\"\\n\",\"cohort_summary = pd.DataFrame([\\n\",\"    {\\n\",\"        \\\"Metric\\\": \\\"Original evaluation embeddings (full archive)\\\",\\n\",\"        \\\"Value\\\": full_evaluation_count\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Metric\\\": \\\"Paired illumination images (historical cohort)\\\",\\n\",\"        \\\"Value\\\": paired_image_count\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Metric\\\": \\\"Corrected detector evaluation cohort (images)\\\",\\n\",\"        \\\"Value\\\": 229\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Metric\\\": \\\"Embedding dimension\\\",\\n\",\"        \\\"Value\\\": embedding_dimension\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Metric\\\": \\\"Identities in paired illumination cohort\\\",\\n\",\"        \\\"Value\\\": identity_count\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Metric\\\": \\\"Low illumination successful detections (full archive)\\\",\\n\",\"        \\\"Value\\\": len(low_success)\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Metric\\\": \\\"High illumination successful detections (full archive)\\\",\\n\",\"        \\\"Value\\\": len(high_success)\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Metric\\\": \\\"Low illumination failures (full archive)\\\",\\n\",\"        \\\"Value\\\": len(low_failures)\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Metric\\\": \\\"High illumination failures (full archive)\\\",\\n\",\"        \\\"Value\\\": len(high_failures)\\n\",\"    }\\n\",\"])\\n\",\"\\n\",\"print(\\\"\\\\n[4] DATASET AND COHORT SUMMARY\\\")\\n\",\"display(cohort_summary)\\n\",\"\\n\",\"print(\\\"\\\\nIDENTITY DISTRIBUTION\\\")\\n\",\"\\n\",\"identity_distribution = (\\n\",\"    identity_counts\\n\",\"    .rename(\\\"Image_Count\\\")\\n\",\"    .reset_index()\\n\",\")\\n\",\"\\n\",\"identity_distribution.columns = [\\n\",\"    \\\"Identity\\\",\\n\",\"    \\\"Image_Count\\\"\\n\",\"]\\n\",\"\\n\",\"display(identity_distribution)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Record software environment\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[5] SOFTWARE AND EXECUTION ENVIRONMENT\\\")\\n\",\"\\n\",\"environment = {\\n\",\"    \\\"Python\\\": sys.version.split()[0],\\n\",\"    \\\"Platform\\\": platform.platform(),\\n\",\"    \\\"NumPy\\\": np.__version__,\\n\",\"    \\\"Pandas\\\": pd.__version__,\\n\",\"    \\\"SciPy\\\": scipy.__version__,\\n\",\"    \\\"Matplotlib\\\": matplotlib.__version__,\\n\",\"    \\\"PyTorch\\\": torch.__version__,\\n\",\"    \\\"Torchvision\\\": torchvision.__version__\\n\",\"}\\n\",\"\\n\",\"for package in [\\n\",\"    \\\"facenet-pytorch\\\",\\n\",\"    \\\"scikit-learn\\\",\\n\",\"    \\\"Pillow\\\"\\n\",\"]:\\n\",\"    try:\\n\",\"        environment[package] = version(package)\\n\",\"\\n\",\"    except PackageNotFoundError:\\n\",\"        environment[package] = \\\"Not installed or unavailable\\\"\\n\",\"\\n\",\"for key, value in environment.items():\\n\",\"    print(f\\\"{key}: {value}\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. Consolidate detector analysis evidence\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[6] DETECTOR ANALYSIS EVIDENCE\\\")\\n\",\"\\n\",\"detector_table_names = [\\n\",\"    \\\"evaluation_detector_df\\\",\\n\",\"    \\\"identity_detector_df\\\",\\n\",\"    \\\"statistical_results\\\",\\n\",\"    \\\"effect_size_df\\\"\\n\",\"]\\n\",\"\\n\",\"detector_tables_available = {}\\n\",\"\\n\",\"for table_name in detector_table_names:\\n\",\"\\n\",\"    if table_name in globals():\\n\",\"\\n\",\"        table = globals()[table_name]\\n\",\"\\n\",\"        if isinstance(table, pd.DataFrame):\\n\",\"\\n\",\"            detector_tables_available[table_name] = True\\n\",\"\\n\",\"            print(f\\\"\\\\n{table_name}\\\")\\n\",\"            print(\\\"Rows:\\\", len(table))\\n\",\"            print(\\\"Columns:\\\", table.columns.tolist())\\n\",\"\\n\",\"            display(table)\\n\",\"\\n\",\"        else:\\n\",\"            detector_tables_available[table_name] = False\\n\",\"            print(f\\\"{table_name}: AVAILABLE BUT NOT A DATAFRAME\\\")\\n\",\"\\n\",\"    else:\\n\",\"        detector_tables_available[table_name] = False\\n\",\"        print(f\\\"{table_name}: NOT AVAILABLE IN CURRENT SESSION\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. Record independently verified illumination statistics\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"verified_illumination_results = pd.DataFrame([\\n\",\"    {\\n\",\"        \\\"Analysis\\\": \\\"Image-level displacement\\\",\\n\",\"        \\\"Observations\\\": 889,\\n\",\"        \\\"Wilcoxon Statistic\\\": 52705.0,\\n\",\"        \\\"P-value\\\": 4.708938281282196e-80,\\n\",\"        \\\"Verification\\\": \\\"Independently reproduced\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Analysis\\\": \\\"Mean-based identity displacement\\\",\\n\",\"        \\\"Observations\\\": 13,\\n\",\"        \\\"Wilcoxon Statistic\\\": 3.0,\\n\",\"        \\\"P-value\\\": 0.001220703125,\\n\",\"        \\\"Verification\\\": \\\"Independently reproduced\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Analysis\\\": \\\"Median-based identity displacement\\\",\\n\",\"        \\\"Observations\\\": 13,\\n\",\"        \\\"Wilcoxon Statistic\\\": 3.0,\\n\",\"        \\\"P-value\\\": 0.001220703125,\\n\",\"        \\\"Verification\\\": \\\"Separately recalculated\\\"\\n\",\"    }\\n\",\"])\\n\",\"\\n\",\"print(\\\"\\\\n[7] VERIFIED ILLUMINATION STATISTICAL RESULTS\\\")\\n\",\"display(verified_illumination_results)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 8. Record reproducibility audit status\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"reproducibility_audit = pd.DataFrame([\\n\",\"    {\\n\",\"        \\\"Audit\\\": \\\"Step 17.10.4 — Saved results verification\\\",\\n\",\"        \\\"Status\\\": \\\"Completed\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Audit\\\": \\\"Step 17.10.5.1 — Saved data integrity\\\",\\n\",\"        \\\"Status\\\": \\\"Passed\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Audit\\\": \\\"Step 17.10.5.2 — Displacement reproduction\\\",\\n\",\"        \\\"Status\\\": \\\"Passed\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Audit\\\": \\\"Step 17.10.5.3 — Image-level statistical reproduction\\\",\\n\",\"        \\\"Status\\\": \\\"Passed\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Audit\\\": \\\"Step 17.10.5.4 — Identity-level statistical reproduction\\\",\\n\",\"        \\\"Status\\\": \\\"Passed\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Audit\\\": \\\"Step 17.10.5.5 — Identity CSV verification\\\",\\n\",\"        \\\"Status\\\": \\\"Passed\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Audit\\\": \\\"Step 17.10.5.6 — Final consistency audit\\\",\\n\",\"        \\\"Status\\\": \\\"Passed\\\"\\n\",\"    }\\n\",\"])\\n\",\"\\n\",\"print(\\\"\\\\n[8] REPRODUCIBILITY AUDIT RECORD\\\")\\n\",\"display(reproducibility_audit)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 9. Final evidence summary\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n\",\"print(\\\"STEP 17.10.6.1 — EVIDENCE CONSOLIDATION SUMMARY\\\")\\n\",\"print(\\\"=\\\" * 80)\\n\",\"\\n\",\"print(\\\"Saved experiment directory: VERIFIED\\\")\\n\",\"print(\\\"Original embedding archive: VERIFIED\\\")\\n\",\"print(\\\"Illumination metadata: VERIFIED\\\")\\n\",\"\\n\",\"print(\\\"Original evaluation embeddings:\\\", full_evaluation_count)\\n\",\"print(\\\"Historical paired illumination images:\\\", paired_image_count)\\n\",\"print(\\\"Corrected detector evaluation cohort: 229\\\")\\n\",\"print(\\\"Embedding dimension:\\\", embedding_dimension)\\n\",\"print(\\\"Identities in paired illumination cohort:\\\", identity_count)\\n\",\"\\n\",\"print(\\\"Software environment: RECORDED\\\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"Detector analysis tables available:\\\",\\n\",\"    sum(detector_tables_available.values()),\\n\",\"    \\\"of\\\",\\n\",\"    len(detector_table_names)\\n\",\")\\n\",\"\\n\",\"print(\\\"Illumination statistics: INDEPENDENTLY REPRODUCED\\\")\\n\",\"print(\\\"Previous reproducibility audit: PASSED\\\")\\n\",\"\\n\",\"print(\\\"\\\\nIMPORTANT METHODOLOGICAL LIMITATIONS:\\\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"The 889 paired illumination observations belong to 13 identities.\\\"\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"They must not be interpreted as 889 independent subjects.\\\"\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"The corrected detector evaluation cohort contains 229 images \\\"\\n\",\"    \\\"and must be distinguished from the historical 889-image \\\"\\n\",\"    \\\"illumination analysis.\\\"\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"This cell consolidates existing evidence. It does not independently \\\"\\n\",\"    \\\"reproduce the original image-processing or embedding-extraction pipeline.\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\nOriginal saved files modified: NO\\\")\\n\",\"print(\\\"New embedding extraction performed: NO\\\")\\n\",\"print(\\\"New model training performed: NO\\\")\\n\",\"\\n\",\"print(\\\"\\\\nSTEP 17.10.6.1 COMPLETED\\\")\\n\",\"print(\\\"=\\\" * 80)\\n\",\"\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 132\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"### Step 17.10.6.2 — Research Findings Consolidation\\n\",\"\\n\",\"**Objective**\\n\",\"\\n\",\"Consolidate the quantitative and statistical findings of Experiment 18 into a structured research evidence record.\\n\",\"\\n\",\"**Scope**\\n\",\"\\n\",\"1. Compare aggregate Euclidean and Mahalanobis detector responses across original, low-illumination and high-illumination conditions.\\n\",\"2. Summarise identity-level detector response variations.\\n\",\"3. Document paired statistical comparisons and effect sizes.\\n\",\"4. Integrate independently verified illumination displacement findings.\\n\",\"5. Distinguish statistically supported findings from exploratory observations.\\n\",\"6. Record limitations concerning cohort size, identity imbalance and controlled illumination transformations.\\n\",\"\\n\",\"**Expected outcome**\\n\",\"\\n\",\"A concise, evidence-based summary of Experiment 18's findings, suitable for the Results and Discussion sections of an academic research paper.\\n\",\"\\n\",\"No new embedding extraction or experimental data generation will be performed.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 133\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 18 — STEP 17.10.6.2\\n\",\"# RESEARCH FINDINGS CONSOLIDATION — FINAL CORRECTED VERSION\\n\",\"# ============================================================\\n\",\"\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"\\n\",\"print(\\\"=\\\" * 80)\\n\",\"print(\\\"STEP 17.10.6.2 — RESEARCH FINDINGS CONSOLIDATION\\\")\\n\",\"print(\\\"=\\\" * 80)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Verify existing analysis tables\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"required_tables = [\\n\",\"    \\\"evaluation_detector_df\\\",\\n\",\"    \\\"identity_detector_df\\\",\\n\",\"    \\\"statistical_results\\\",\\n\",\"    \\\"effect_size_df\\\"\\n\",\"]\\n\",\"\\n\",\"for name in required_tables:\\n\",\"    assert name in globals(), f\\\"Missing table: {name}\\\"\\n\",\"    assert isinstance(globals()[name], pd.DataFrame)\\n\",\"\\n\",\"print(\\\"\\\\n[1] EXISTING ANALYSIS TABLES\\\")\\n\",\"\\n\",\"for name in required_tables:\\n\",\"    print(f\\\"{name}: AVAILABLE | Rows: {len(globals()[name])}\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Aggregate detector response comparison\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[2] AGGREGATE DETECTOR RESPONSE\\\")\\n\",\"\\n\",\"aggregate_findings = evaluation_detector_df.copy()\\n\",\"\\n\",\"display(aggregate_findings)\\n\",\"\\n\",\"original = aggregate_findings.loc[\\n\",\"    aggregate_findings[\\\"Condition\\\"] == \\\"Original\\\"\\n\",\"].iloc[0]\\n\",\"\\n\",\"low = aggregate_findings.loc[\\n\",\"    aggregate_findings[\\\"Condition\\\"] == \\\"Low illumination\\\"\\n\",\"].iloc[0]\\n\",\"\\n\",\"high = aggregate_findings.loc[\\n\",\"    aggregate_findings[\\\"Condition\\\"] == \\\"High illumination\\\"\\n\",\"].iloc[0]\\n\",\"\\n\",\"aggregate_records = []\\n\",\"\\n\",\"for detector in [\\\"Euclidean\\\", \\\"Mahalanobis\\\"]:\\n\",\"\\n\",\"    original_value = float(original[detector])\\n\",\"    low_value = float(low[detector])\\n\",\"    high_value = float(high[detector])\\n\",\"\\n\",\"    aggregate_records.append({\\n\",\"        \\\"Detector\\\": detector,\\n\",\"        \\\"Original\\\": original_value,\\n\",\"        \\\"Low Illumination\\\": low_value,\\n\",\"        \\\"High Illumination\\\": high_value,\\n\",\"        \\\"Low Change (%)\\\": (\\n\",\"            (low_value - original_value) / original_value * 100\\n\",\"        ),\\n\",\"        \\\"High Change (%)\\\": (\\n\",\"            (high_value - original_value) / original_value * 100\\n\",\"        )\\n\",\"    })\\n\",\"\\n\",\"aggregate_comparison = pd.DataFrame(aggregate_records)\\n\",\"\\n\",\"print(\\\"\\\\nAGGREGATE COMPARISON\\\")\\n\",\"display(aggregate_comparison)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Identity-level response direction\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[3] IDENTITY-LEVEL RESPONSE ANALYSIS\\\")\\n\",\"\\n\",\"identity_pivot = identity_detector_df.pivot(\\n\",\"    index=\\\"Identity\\\",\\n\",\"    columns=\\\"Condition\\\",\\n\",\"    values=[\\\"Euclidean\\\", \\\"Mahalanobis\\\"]\\n\",\")\\n\",\"\\n\",\"identity_direction_records = []\\n\",\"\\n\",\"for detector in [\\\"Euclidean\\\", \\\"Mahalanobis\\\"]:\\n\",\"\\n\",\"    low_values = identity_pivot[\\n\",\"        (detector, \\\"Low illumination\\\")\\n\",\"    ]\\n\",\"\\n\",\"    high_values = identity_pivot[\\n\",\"        (detector, \\\"High illumination\\\")\\n\",\"    ]\\n\",\"\\n\",\"    differences = high_values - low_values\\n\",\"\\n\",\"    identity_direction_records.append({\\n\",\"        \\\"Detector\\\": detector,\\n\",\"        \\\"Identities\\\": len(differences),\\n\",\"        \\\"Higher Under High Illumination\\\": int(\\n\",\"            (differences > 0).sum()\\n\",\"        ),\\n\",\"        \\\"Lower Under High Illumination\\\": int(\\n\",\"            (differences < 0).sum()\\n\",\"        ),\\n\",\"        \\\"Unchanged\\\": int(\\n\",\"            (differences == 0).sum()\\n\",\"        ),\\n\",\"        \\\"Mean Difference\\\": differences.mean(),\\n\",\"        \\\"Median Difference\\\": differences.median()\\n\",\"    })\\n\",\"\\n\",\"identity_direction_summary = pd.DataFrame(\\n\",\"    identity_direction_records\\n\",\")\\n\",\"\\n\",\"display(identity_direction_summary)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Corrected paired statistical results\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[4] CORRECTED PAIRED STATISTICAL RESULTS\\\")\\n\",\"\\n\",\"statistical_findings = statistical_results.copy()\\n\",\"effect_size_findings = effect_size_df.copy()\\n\",\"\\n\",\"# Validate actual detector names\\n\",\"expected_detectors = {\\\"Euclidean\\\", \\\"Mahalanobis\\\"}\\n\",\"\\n\",\"assert set(statistical_findings[\\\"Detector\\\"]) == expected_detectors\\n\",\"assert set(effect_size_findings[\\\"Detector\\\"]) == expected_detectors\\n\",\"\\n\",\"# Validate corrected results\\n\",\"expected_p_values = {\\n\",\"    \\\"Euclidean\\\": 0.021484,\\n\",\"    \\\"Mahalanobis\\\": 0.002441\\n\",\"}\\n\",\"\\n\",\"expected_statistics = {\\n\",\"    \\\"Euclidean\\\": 13.0,\\n\",\"    \\\"Mahalanobis\\\": 5.0\\n\",\"}\\n\",\"\\n\",\"for detector in expected_detectors:\\n\",\"\\n\",\"    row = statistical_findings.loc[\\n\",\"        statistical_findings[\\\"Detector\\\"] == detector\\n\",\"    ].iloc[0]\\n\",\"\\n\",\"    assert np.isclose(\\n\",\"        float(row[\\\"P-value\\\"]),\\n\",\"        expected_p_values[detector],\\n\",\"        atol=1e-6\\n\",\"    ), f\\\"{detector} p-value mismatch.\\\"\\n\",\"\\n\",\"    assert np.isclose(\\n\",\"        float(row[\\\"Wilcoxon Statistic\\\"]),\\n\",\"        expected_statistics[detector]\\n\",\"    ), f\\\"{detector} Wilcoxon statistic mismatch.\\\"\\n\",\"\\n\",\"print(\\\"Corrected statistical results verified:\\\")\\n\",\"display(statistical_findings)\\n\",\"\\n\",\"print(\\\"\\\\nExisting effect-size results:\\\")\\n\",\"display(effect_size_findings)\\n\",\"\\n\",\"significance_summary = statistical_findings.copy()\\n\",\"\\n\",\"significance_summary[\\\"Nominal Significance\\\"] = (\\n\",\"    significance_summary[\\\"P-value\\\"] < 0.05\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\nNOMINAL SIGNIFICANCE ASSESSMENT (alpha = 0.05)\\\")\\n\",\"display(significance_summary)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Historical controlled illumination displacement\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[5] CONTROLLED ILLUMINATION DISPLACEMENT\\\")\\n\",\"\\n\",\"illumination_findings = pd.DataFrame([\\n\",\"    {\\n\",\"        \\\"Condition\\\": \\\"Low illumination\\\",\\n\",\"        \\\"Mean Displacement\\\": 0.23466530442237854,\\n\",\"        \\\"Median Displacement\\\": 0.222675,\\n\",\"        \\\"Image-Level Observations\\\": 889\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Condition\\\": \\\"High illumination\\\",\\n\",\"        \\\"Mean Displacement\\\": 0.3185139298439026,\\n\",\"        \\\"Median Displacement\\\": 0.306734,\\n\",\"        \\\"Image-Level Observations\\\": 889\\n\",\"    }\\n\",\"])\\n\",\"\\n\",\"display(illumination_findings)\\n\",\"\\n\",\"print(\\n\",\"    \\\"Historical image-level Wilcoxon p-value:\\\",\\n\",\"    4.708938281282196e-80\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"Historical mean-based identity Wilcoxon p-value:\\\",\\n\",\"    0.001220703125\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"Historical median-based identity Wilcoxon p-value:\\\",\\n\",\"    0.001220703125\\n\",\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. Research findings\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[6] RESEARCH FINDINGS\\\")\\n\",\"\\n\",\"findings = [\\n\",\"    \\\"Aggregate Euclidean and Mahalanobis responses vary across illumination conditions.\\\",\\n\",\"    \\\"Euclidean aggregate response is highest under low illumination.\\\",\\n\",\"    \\\"Mahalanobis aggregate response is highest under high illumination.\\\",\\n\",\"    \\\"Identity-level detector responses vary across the 13 evaluated identities.\\\",\\n\",\"    \\\"Corrected Euclidean Wilcoxon statistic = 13.0, p = 0.021484.\\\",\\n\",\"    \\\"Corrected Mahalanobis Wilcoxon statistic = 5.0, p = 0.002441.\\\",\\n\",\"    \\\"Both corrected detector-response tests are below the nominal 0.05 threshold.\\\",\\n\",\"    \\\"Historical illumination displacement is higher under high illumination.\\\",\\n\",\"    \\\"Historical illumination displacement statistics were independently reproduced.\\\"\\n\",\"]\\n\",\"\\n\",\"for i, finding in enumerate(findings, 1):\\n\",\"    print(f\\\"{i}. {finding}\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. Methodological limitations\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[7] METHODOLOGICAL LIMITATIONS\\\")\\n\",\"\\n\",\"limitations = [\\n\",\"    \\\"The corrected detector evaluation cohort contains 229 images from 13 identities.\\\",\\n\",\"    \\\"The historical paired illumination analysis contains 889 images from the same 13 identities.\\\",\\n\",\"    \\\"Identity image counts are highly imbalanced.\\\",\\n\",\"    \\\"Identity 14 contributes 504 of the 889 historical paired images.\\\",\\n\",\"    \\\"Image observations are clustered within identities.\\\",\\n\",\"    \\\"The corrected detector-response tests use only 13 identity-level observations.\\\",\\n\",\"    \\\"The detector-response p-values are nominal and are not adjusted for multiple comparisons.\\\",\\n\",\"    \\\"Controlled brightness transformations do not represent all natural illumination changes.\\\",\\n\",\"    \\\"Embedding displacement does not directly measure recognition accuracy.\\\",\\n\",\"    \\\"The results do not establish biometric fairness or deployment readiness.\\\",\\n\",\"    \\\"Detector-response tests and illumination-displacement tests are separate analyses.\\\"\\n\",\"]\\n\",\"\\n\",\"for i, limitation in enumerate(limitations, 1):\\n\",\"    print(f\\\"{i}. {limitation}\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 8. Final consolidation status\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n\",\"print(\\\"STEP 17.10.6.2 — CONSOLIDATION SUMMARY\\\")\\n\",\"print(\\\"=\\\" * 80)\\n\",\"\\n\",\"print(\\\"Aggregate detector findings: CONSOLIDATED\\\")\\n\",\"print(\\\"Identity-level response findings: CONSOLIDATED\\\")\\n\",\"print(\\\"Corrected paired statistical results: VERIFIED\\\")\\n\",\"print(\\\"Effect sizes and confidence intervals: VERIFIED\\\")\\n\",\"print(\\\"Historical illumination displacement findings: VERIFIED\\\")\\n\",\"print(\\\"Methodological limitations: DOCUMENTED\\\")\\n\",\"\\n\",\"print(\\\"\\\\nCorrected Euclidean p-value: 0.021484\\\")\\n\",\"print(\\\"Corrected Mahalanobis p-value: 0.002441\\\")\\n\",\"\\n\",\"print(\\\"\\\\nNo new experiments performed.\\\")\\n\",\"print(\\\"No saved files modified.\\\")\\n\",\"print(\\\"No embedding extraction performed.\\\")\\n\",\"\\n\",\"print(\\\"\\\\nSTEP 17.10.6.2 COMPLETED\\\")\\n\",\"print(\\\"=\\\" * 80)\\n\",\"\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 135\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"### Step 17.10.6.3 — Research Discussion and Interpretation\\n\",\"\\n\",\"Objective: Develop a cautious research interpretation of the consolidated experimental findings.\\n\",\"\\n\",\"Scope:\\n\",\"1. Interpret Euclidean and Mahalanobis detector behaviour across illumination conditions.\\n\",\"2. Discuss differences between aggregate and identity-level responses.\\n\",\"3. Interpret statistical significance and effect-size evidence.\\n\",\"4. Explain the relationship between embedding displacement and detector response.\\n\",\"5. Identify implications for biometric drift monitoring.\\n\",\"6. Separate demonstrated findings from hypotheses and future research directions.\\n\",\"7. Document threats to validity and avoid unsupported claims.\\n\",\"\\n\",\"Expected outcome: A defensible discussion suitable for a research paper.\\n\",\"\\n\",\"No new embedding extraction, model training, or experimental data generation.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 136\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 18 — STEP 17.10.6.3\\n\",\"# RESEARCH DISCUSSION AND INTERPRETATION\\n\",\"# ============================================================\\n\",\"\\n\",\"import pandas as pd\\n\",\"import numpy as np\\n\",\"\\n\",\"print(\\\"=\\\" * 80)\\n\",\"print(\\\"STEP 17.10.6.3 — RESEARCH DISCUSSION AND INTERPRETATION\\\")\\n\",\"print(\\\"=\\\" * 80)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Interpret aggregate detector behaviour\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[1] AGGREGATE DETECTOR BEHAVIOUR\\\")\\n\",\"\\n\",\"for _, row in aggregate_comparison.iterrows():\\n\",\"\\n\",\"    print(f\\\"\\\\nDetector: {row['Detector']}\\\")\\n\",\"    print(f\\\"Original response: {row['Original']:.6f}\\\")\\n\",\"    print(f\\\"Low illumination response: {row['Low Illumination']:.6f}\\\")\\n\",\"    print(f\\\"High illumination response: {row['High Illumination']:.6f}\\\")\\n\",\"    print(f\\\"Change under low illumination: {row['Low Change (%)']:.2f}%\\\")\\n\",\"    print(f\\\"Change under high illumination: {row['High Change (%)']:.2f}%\\\")\\n\",\"\\n\",\"    if row[\\\"Low Illumination\\\"] > row[\\\"High Illumination\\\"]:\\n\",\"        print(\\\"Interpretation: Aggregate response is higher under low illumination.\\\")\\n\",\"    else:\\n\",\"        print(\\\"Interpretation: Aggregate response is higher under high illumination.\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Interpret identity-level variation\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[2] IDENTITY-LEVEL VARIATION\\\")\\n\",\"\\n\",\"display(identity_direction_summary)\\n\",\"\\n\",\"for _, row in identity_direction_summary.iterrows():\\n\",\"\\n\",\"    print(f\\\"\\\\n{row['Detector']} detector:\\\")\\n\",\"\\n\",\"    print(\\n\",\"        f\\\"Response increased for \\\"\\n\",\"        f\\\"{row['Higher Under High Illumination']} of \\\"\\n\",\"        f\\\"{row['Identities']} identities under high versus low illumination.\\\"\\n\",\"    )\\n\",\"\\n\",\"    print(\\n\",\"        f\\\"Response decreased for \\\"\\n\",\"        f\\\"{row['Lower Under High Illumination']} identities.\\\"\\n\",\"    )\\n\",\"\\n\",\"print(\\n\",\"    \\\"\\\\nInterpretation: Aggregate detector responses conceal \\\"\\n\",\"    \\\"identity-specific variation.\\\"\\n\",\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Interpret corrected statistical evidence and effect sizes\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[3] CORRECTED STATISTICAL EVIDENCE\\\")\\n\",\"\\n\",\"display(statistical_results)\\n\",\"display(effect_size_df)\\n\",\"\\n\",\"for _, row in statistical_results.iterrows():\\n\",\"\\n\",\"    detector = row[\\\"Detector\\\"]\\n\",\"\\n\",\"    effect_row = effect_size_df.loc[\\n\",\"        effect_size_df[\\\"Detector\\\"] == detector\\n\",\"    ].iloc[0]\\n\",\"\\n\",\"    p_value = float(row[\\\"P-value\\\"])\\n\",\"    statistic = float(row[\\\"Wilcoxon Statistic\\\"])\\n\",\"    cohens_dz = float(effect_row[\\\"Cohen's dz\\\"])\\n\",\"    rank_biserial = float(\\n\",\"        effect_row[\\\"Rank-Biserial Correlation\\\"]\\n\",\"    )\\n\",\"\\n\",\"    print(f\\\"\\\\nDetector: {detector}\\\")\\n\",\"    print(f\\\"Wilcoxon statistic: {statistic:.1f}\\\")\\n\",\"    print(f\\\"Wilcoxon p-value: {p_value:.6f}\\\")\\n\",\"    print(f\\\"Cohen's dz: {cohens_dz:.6f}\\\")\\n\",\"    print(f\\\"Rank-biserial correlation: {rank_biserial:.6f}\\\")\\n\",\"\\n\",\"    print(\\n\",\"        f\\\"Mean difference: \\\"\\n\",\"        f\\\"{effect_row['Mean Difference']:.6f}\\\"\\n\",\"    )\\n\",\"\\n\",\"    print(\\n\",\"        f\\\"Median difference: \\\"\\n\",\"        f\\\"{effect_row['Median Difference']:.6f}\\\"\\n\",\"    )\\n\",\"\\n\",\"    print(\\n\",\"        f\\\"Mean confidence interval: \\\"\\n\",\"        f\\\"[{effect_row['Mean CI Lower']:.6f}, \\\"\\n\",\"        f\\\"{effect_row['Mean CI Upper']:.6f}]\\\"\\n\",\"    )\\n\",\"\\n\",\"    print(\\n\",\"        f\\\"Median confidence interval: \\\"\\n\",\"        f\\\"[{effect_row['Median CI Lower']:.6f}, \\\"\\n\",\"        f\\\"{effect_row['Median CI Upper']:.6f}]\\\"\\n\",\"    )\\n\",\"\\n\",\"    if p_value < 0.05:\\n\",\"        print(\\\"Result: Below the nominal alpha = 0.05 threshold.\\\")\\n\",\"    else:\\n\",\"        print(\\\"Result: Not below the nominal alpha = 0.05 threshold.\\\")\\n\",\"\\n\",\"    if (\\n\",\"        effect_row[\\\"Median CI Lower\\\"] <= 0\\n\",\"        <= effect_row[\\\"Median CI Upper\\\"]\\n\",\"    ):\\n\",\"        print(\\\"Median confidence interval includes zero.\\\")\\n\",\"    else:\\n\",\"        print(\\\"Median confidence interval excludes zero.\\\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"\\\\nInterpretation: Both corrected detector-response tests \\\"\\n\",\"    \\\"are below the nominal 0.05 threshold. These results are \\\"\\n\",\"    \\\"exploratory because only 13 identities were evaluated, \\\"\\n\",\"    \\\"and no multiple-comparison adjustment was applied.\\\"\\n\",\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Compare embedding displacement and detector response\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[4] EMBEDDING DISPLACEMENT VERSUS DETECTOR RESPONSE\\\")\\n\",\"\\n\",\"low_displacement_mean = 0.23466530442237854\\n\",\"high_displacement_mean = 0.3185139298439026\\n\",\"\\n\",\"print(f\\\"Mean low-illumination displacement: {low_displacement_mean:.6f}\\\")\\n\",\"print(f\\\"Mean high-illumination displacement: {high_displacement_mean:.6f}\\\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"\\\\nThe independently verified displacement analysis indicates \\\"\\n\",\"    \\\"greater average embedding displacement under high illumination \\\"\\n\",\"    \\\"than under low illumination.\\\"\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"Detector responses do not follow an identical aggregate pattern: \\\"\\n\",\"    \\\"Euclidean response is higher under low illumination, whereas \\\"\\n\",\"    \\\"Mahalanobis response is higher under high illumination.\\\"\\n\",\")\\n\",\"\\n\",\"print(\\n\",\"    \\\"Embedding displacement and detector response are distinct \\\"\\n\",\"    \\\"measurements and should not be treated as interchangeable.\\\"\\n\",\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Implications for biometric drift monitoring\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[5] IMPLICATIONS FOR BIOMETRIC DRIFT MONITORING\\\")\\n\",\"\\n\",\"implications = [\\n\",\"    \\\"A single aggregate detector score may conceal identity-level variation.\\\",\\n\",\"    \\\"Different distance metrics can respond differently to the same controlled transformation.\\\",\\n\",\"    \\\"Embedding displacement can provide evidence of representation change.\\\",\\n\",\"    \\\"Detector thresholds and responses require validation across identities and conditions.\\\",\\n\",\"    \\\"Monitoring systems should account for identity-level heterogeneity.\\\",\\n\",\"    \\\"Further testing is needed before drawing conclusions about real-world biometric performance.\\\"\\n\",\"]\\n\",\"\\n\",\"for index, statement in enumerate(implications, start=1):\\n\",\"    print(f\\\"{index}. {statement}\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. Threats to validity\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[6] THREATS TO VALIDITY\\\")\\n\",\"\\n\",\"threats = [\\n\",\"    \\\"The corrected detector evaluation cohort contains 229 images from 13 identities.\\\",\\n\",\"    \\\"The historical paired illumination displacement cohort contains 889 images from 13 identities.\\\",\\n\",\"    \\\"Identity 14 contributes 504 of the 889 historical paired observations.\\\",\\n\",\"    \\\"Image observations are clustered within identities and are not independent subjects.\\\",\\n\",\"    \\\"Only controlled brightness factors of 0.5 and 1.5 were evaluated against the original condition.\\\",\\n\",\"    \\\"The experiment does not establish robustness under all real-world illumination changes.\\\",\\n\",\"    \\\"The detector-response tests use only 13 identity-level observations.\\\",\\n\",\"    \\\"The detector-response p-values are nominal and have not been adjusted for multiple comparisons.\\\",\\n\",\"    \\\"Embedding displacement is not equivalent to false acceptance, false rejection, or recognition accuracy.\\\",\\n\",\"    \\\"Fairness and deployment performance were not directly evaluated.\\\"\\n\",\"]\\n\",\"\\n\",\"for index, threat in enumerate(threats, start=1):\\n\",\"    print(f\\\"{index}. {threat}\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. Separate demonstrated findings from future hypotheses\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[7] EVIDENCE CLASSIFICATION\\\")\\n\",\"\\n\",\"evidence_classification = pd.DataFrame([\\n\",\"    {\\n\",\"        \\\"Statement\\\": \\\"High illumination produced greater mean embedding displacement than low illumination.\\\",\\n\",\"        \\\"Evidence Status\\\": \\\"Demonstrated in this controlled cohort\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Statement\\\": \\\"Detector responses varied across illumination conditions.\\\",\\n\",\"        \\\"Evidence Status\\\": \\\"Observed in aggregate results\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Statement\\\": \\\"Identity-level detector responses were heterogeneous.\\\",\\n\",\"        \\\"Evidence Status\\\": \\\"Observed across 13 identities\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Statement\\\": \\\"Both corrected paired detector-response tests were below the nominal 0.05 threshold.\\\",\\n\",\"        \\\"Evidence Status\\\": \\\"Supported by corrected identity-level tests\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Statement\\\": \\\"The detector findings establish population-level generalisation.\\\",\\n\",\"        \\\"Evidence Status\\\": \\\"Not established\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Statement\\\": \\\"The findings establish real-world biometric recognition degradation.\\\",\\n\",\"        \\\"Evidence Status\\\": \\\"Not established\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Statement\\\": \\\"Identity-aware drift monitoring may be worth investigating.\\\",\\n\",\"        \\\"Evidence Status\\\": \\\"Future research direction\\\"\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Statement\\\": \\\"The observed patterns generalise to other biometric datasets and models.\\\",\\n\",\"        \\\"Evidence Status\\\": \\\"Not established\\\"\\n\",\"    }\\n\",\"])\\n\",\"\\n\",\"display(evidence_classification)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 8. Final discussion summary\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[8] FINAL RESEARCH DISCUSSION\\\")\\n\",\"\\n\",\"discussion_summary = \\\"\\\"\\\"\\n\",\"The controlled illumination experiment demonstrates that changes in\\n\",\"image brightness are associated with measurable changes in facial\\n\",\"embedding representations within the evaluated LFW cohort.\\n\",\"\\n\",\"Mean embedding displacement was greater under high illumination\\n\",\"than under low illumination. However, aggregate Euclidean and\\n\",\"Mahalanobis detector responses exhibited different patterns across\\n\",\"the two illumination conditions.\\n\",\"\\n\",\"Identity-level analysis demonstrated heterogeneous detector\\n\",\"responses. This indicates that aggregate measurements alone may\\n\",\"not adequately represent variation across identities.\\n\",\"\\n\",\"The corrected paired detector-response tests produced nominal\\n\",\"p-values below 0.05 for both Euclidean and Mahalanobis detectors.\\n\",\"These results provide exploratory identity-level statistical\\n\",\"evidence, but they are based on only 13 identities and have not\\n\",\"been adjusted for multiple comparisons.\\n\",\"\\n\",\"The experiment supports further investigation of identity-aware\\n\",\"embedding drift monitoring. It does not establish real-world\\n\",\"recognition degradation, fairness, or deployment readiness.\\n\",\"\\n\",\"The small and imbalanced identity cohort, together with the\\n\",\"controlled nature of the brightness transformations, limits\\n\",\"generalisation beyond this experiment.\\n\",\"\\\"\\\"\\\"\\n\",\"\\n\",\"print(discussion_summary)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 9. Completion status\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"=\\\" * 80)\\n\",\"print(\\\"STEP 17.10.6.3 — COMPLETION SUMMARY\\\")\\n\",\"print(\\\"=\\\" * 80)\\n\",\"\\n\",\"print(\\\"Aggregate detector interpretation: COMPLETED\\\")\\n\",\"print(\\\"Identity-level interpretation: COMPLETED\\\")\\n\",\"print(\\\"Corrected statistical evidence interpretation: COMPLETED\\\")\\n\",\"print(\\\"Effect-size interpretation: COMPLETED\\\")\\n\",\"print(\\\"Displacement and detector comparison: COMPLETED\\\")\\n\",\"print(\\\"Biometric monitoring implications: DOCUMENTED\\\")\\n\",\"print(\\\"Threats to validity: DOCUMENTED\\\")\\n\",\"print(\\\"Evidence classification: COMPLETED\\\")\\n\",\"print(\\\"Research discussion: GENERATED\\\")\\n\",\"\\n\",\"print(\\\"\\\\nNo new experiments performed.\\\")\\n\",\"print(\\\"No embedding extraction or model training performed.\\\")\\n\",\"print(\\\"No saved experiment files modified.\\\")\\n\",\"\\n\",\"print(\\\"\\\\nSTEP 17.10.6.3 COMPLETED\\\")\\n\",\"print(\\\"=\\\" * 80)\\n\",\"\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 137\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"### Step 17.10.6.4 — Research Documentation and Reproducibility Audit\\n\",\"\\n\",\"Objective: Audit the completeness, consistency, traceability, and reproducibility of Experiment 18 documentation.\\n\",\"\\n\",\"Scope:\\n\",\"1. Verify experiment configuration and dataset descriptions.\\n\",\"2. Verify saved archive and metadata references.\\n\",\"3. Check consistency between reported numerical findings and saved results.\\n\",\"4. Confirm statistical test provenance and interpretation.\\n\",\"5. Document software environment and methodological limitations.\\n\",\"6. Identify missing evidence required for independent reproduction.\\n\",\"7. Produce a final documentation audit report.\\n\",\"\\n\",\"Expected outcome: A traceable research documentation and reproducibility record.\\n\",\"\\n\",\"No new embedding extraction, model training, or experimental data generation.\\n\",\"No modification of previously validated experiment results.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 138\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 18 — STEP 17.10.6.4\\n\",\"# RESEARCH DOCUMENTATION AND REPRODUCIBILITY AUDIT\\n\",\"# ============================================================\\n\",\"\\n\",\"import os\\n\",\"import json\\n\",\"import platform\\n\",\"import importlib.metadata as package_metadata\\n\",\"\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"import scipy\\n\",\"from scipy.stats import wilcoxon\\n\",\"\\n\",\"print(\\\"=\\\" * 85)\\n\",\"print(\\\"STEP 17.10.6.4 — RESEARCH DOCUMENTATION AND REPRODUCIBILITY AUDIT\\\")\\n\",\"print(\\\"=\\\" * 85)\\n\",\"\\n\",\"audit_results = []\\n\",\"\\n\",\"def record_audit(name, passed, details=\\\"\\\"):\\n\",\"    status = \\\"PASSED\\\" if passed else \\\"FAILED\\\"\\n\",\"    audit_results.append({\\n\",\"        \\\"Audit\\\": name,\\n\",\"        \\\"Status\\\": status,\\n\",\"        \\\"Details\\\": details\\n\",\"    })\\n\",\"    print(f\\\"[{status}] {name}\\\")\\n\",\"    if details:\\n\",\"        print(f\\\"         {details}\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. Verify saved experiment files\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[1] SAVED FILE VERIFICATION\\\")\\n\",\"\\n\",\"experiment_dir = \\\"/content/drive/MyDrive/Experiment_18_Results\\\"\\n\",\"\\n\",\"expected_files = [\\n\",\"    \\\"experiment18_facenet_lfw_embeddings.npz\\\",\\n\",\"    \\\"experiment18_illumination_results.npz\\\",\\n\",\"    \\\"illumination_identity_summary.csv\\\",\\n\",\"    \\\"illumination_metadata.json\\\"\\n\",\"]\\n\",\"\\n\",\"file_paths = {\\n\",\"    filename: os.path.join(experiment_dir, filename)\\n\",\"    for filename in expected_files\\n\",\"}\\n\",\"\\n\",\"for filename, path in file_paths.items():\\n\",\"    exists = os.path.isfile(path)\\n\",\"    record_audit(\\n\",\"        f\\\"File exists: {filename}\\\",\\n\",\"        exists,\\n\",\"        path if exists else \\\"File not found\\\"\\n\",\"    )\\n\",\"\\n\",\"assert all(os.path.isfile(p) for p in file_paths.values()), (\\n\",\"    \\\"One or more required experiment files are missing. \\\"\\n\",\"    \\\"Check the Google Drive directory before continuing.\\\"\\n\",\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. Load saved archives and metadata\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[2] ARCHIVE AND METADATA LOADING\\\")\\n\",\"\\n\",\"original_archive = np.load(\\n\",\"    file_paths[\\\"experiment18_facenet_lfw_embeddings.npz\\\"],\\n\",\"    allow_pickle=False\\n\",\")\\n\",\"\\n\",\"illumination_archive = np.load(\\n\",\"    file_paths[\\\"experiment18_illumination_results.npz\\\"],\\n\",\"    allow_pickle=False\\n\",\")\\n\",\"\\n\",\"identity_csv = pd.read_csv(\\n\",\"    file_paths[\\\"illumination_identity_summary.csv\\\"]\\n\",\")\\n\",\"\\n\",\"with open(\\n\",\"    file_paths[\\\"illumination_metadata.json\\\"],\\n\",\"    \\\"r\\\"\\n\",\") as file:\\n\",\"    saved_metadata = json.load(file)\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"Original embedding archive loaded\\\",\\n\",\"    True,\\n\",\"    f\\\"Keys: {list(original_archive.files)}\\\"\\n\",\")\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"Illumination archive loaded\\\",\\n\",\"    True,\\n\",\"    f\\\"Keys: {list(illumination_archive.files)}\\\"\\n\",\")\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"Identity CSV loaded\\\",\\n\",\"    True,\\n\",\"    f\\\"Rows: {len(identity_csv)}\\\"\\n\",\")\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"Metadata JSON loaded\\\",\\n\",\"    True,\\n\",\"    f\\\"Experiment: {saved_metadata.get('experiment')}\\\"\\n\",\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. Verify original embedding archive\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[3] ORIGINAL EMBEDDING ARCHIVE\\\")\\n\",\"\\n\",\"original_expected_shapes = {\\n\",\"    \\\"reference_embeddings\\\": (1460, 512),\\n\",\"    \\\"reference_labels\\\": (1460,),\\n\",\"    \\\"calibration_embeddings\\\": (568, 512),\\n\",\"    \\\"calibration_labels\\\": (568,),\\n\",\"    \\\"evaluation_embeddings\\\": (956, 512),\\n\",\"    \\\"evaluation_labels\\\": (956,)\\n\",\"}\\n\",\"\\n\",\"for key, expected_shape in original_expected_shapes.items():\\n\",\"\\n\",\"    present = key in original_archive.files\\n\",\"\\n\",\"    if present:\\n\",\"        actual_shape = original_archive[key].shape\\n\",\"        shape_ok = actual_shape == expected_shape\\n\",\"    else:\\n\",\"        actual_shape = \\\"MISSING\\\"\\n\",\"        shape_ok = False\\n\",\"\\n\",\"    record_audit(\\n\",\"        f\\\"Original archive: {key}\\\",\\n\",\"        shape_ok,\\n\",\"        f\\\"Expected: {expected_shape}; Actual: {actual_shape}\\\"\\n\",\"    )\\n\",\"\\n\",\"for key in [\\n\",\"    \\\"reference_embeddings\\\",\\n\",\"    \\\"calibration_embeddings\\\",\\n\",\"    \\\"evaluation_embeddings\\\"\\n\",\"]:\\n\",\"    if key in original_archive.files:\\n\",\"        finite = np.isfinite(original_archive[key]).all()\\n\",\"\\n\",\"        record_audit(\\n\",\"            f\\\"Finite values: {key}\\\",\\n\",\"            finite\\n\",\"        )\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. Verify illumination archive\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[4] ILLUMINATION ARCHIVE\\\")\\n\",\"\\n\",\"required_illumination_keys = [\\n\",\"    \\\"original_embeddings\\\",\\n\",\"    \\\"low_illumination_embeddings\\\",\\n\",\"    \\\"high_illumination_embeddings\\\",\\n\",\"    \\\"paired_labels\\\",\\n\",\"    \\\"common_positions\\\",\\n\",\"    \\\"low_displacement\\\",\\n\",\"    \\\"high_displacement\\\",\\n\",\"    \\\"low_success\\\",\\n\",\"    \\\"high_success\\\",\\n\",\"    \\\"low_failures\\\",\\n\",\"    \\\"high_failures\\\"\\n\",\"]\\n\",\"\\n\",\"for key in required_illumination_keys:\\n\",\"\\n\",\"    present = key in illumination_archive.files\\n\",\"\\n\",\"    record_audit(\\n\",\"        f\\\"Illumination key: {key}\\\",\\n\",\"        present\\n\",\"    )\\n\",\"\\n\",\"assert all(\\n\",\"    key in illumination_archive.files\\n\",\"    for key in required_illumination_keys\\n\",\"), \\\"Required illumination archive arrays are missing.\\\"\\n\",\"\\n\",\"\\n\",\"original_emb = illumination_archive[\\\"original_embeddings\\\"]\\n\",\"low_emb = illumination_archive[\\\"low_illumination_embeddings\\\"]\\n\",\"high_emb = illumination_archive[\\\"high_illumination_embeddings\\\"]\\n\",\"\\n\",\"paired_labels = illumination_archive[\\\"paired_labels\\\"]\\n\",\"\\n\",\"low_saved_displacement = illumination_archive[\\\"low_displacement\\\"]\\n\",\"high_saved_displacement = illumination_archive[\\\"high_displacement\\\"]\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"Paired embedding shapes\\\",\\n\",\"    (\\n\",\"        original_emb.shape == (889, 512)\\n\",\"        and low_emb.shape == (889, 512)\\n\",\"        and high_emb.shape == (889, 512)\\n\",\"    ),\\n\",\"    f\\\"Original: {original_emb.shape}; \\\"\\n\",\"    f\\\"Low: {low_emb.shape}; High: {high_emb.shape}\\\"\\n\",\")\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"Paired label alignment\\\",\\n\",\"    paired_labels.shape == (889,),\\n\",\"    f\\\"Labels: {paired_labels.shape}\\\"\\n\",\")\\n\",\"\\n\",\"all_finite = all([\\n\",\"    np.isfinite(original_emb).all(),\\n\",\"    np.isfinite(low_emb).all(),\\n\",\"    np.isfinite(high_emb).all(),\\n\",\"    np.isfinite(low_saved_displacement).all(),\\n\",\"    np.isfinite(high_saved_displacement).all()\\n\",\"])\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"Illumination arrays contain finite values\\\",\\n\",\"    all_finite\\n\",\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. Independently reproduce embedding displacement\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[5] DISPLACEMENT REPRODUCIBILITY\\\")\\n\",\"\\n\",\"recalculated_low = np.linalg.norm(\\n\",\"    low_emb - original_emb,\\n\",\"    axis=1\\n\",\")\\n\",\"\\n\",\"recalculated_high = np.linalg.norm(\\n\",\"    high_emb - original_emb,\\n\",\"    axis=1\\n\",\")\\n\",\"\\n\",\"low_exact_match = np.allclose(\\n\",\"    recalculated_low,\\n\",\"    low_saved_displacement,\\n\",\"    rtol=0,\\n\",\"    atol=1e-7\\n\",\")\\n\",\"\\n\",\"high_exact_match = np.allclose(\\n\",\"    recalculated_high,\\n\",\"    high_saved_displacement,\\n\",\"    rtol=0,\\n\",\"    atol=1e-7\\n\",\")\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"Low displacement reproduction\\\",\\n\",\"    low_exact_match,\\n\",\"    f\\\"Maximum absolute difference: \\\"\\n\",\"    f\\\"{np.max(np.abs(recalculated_low - low_saved_displacement)):.12f}\\\"\\n\",\")\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"High displacement reproduction\\\",\\n\",\"    high_exact_match,\\n\",\"    f\\\"Maximum absolute difference: \\\"\\n\",\"    f\\\"{np.max(np.abs(recalculated_high - high_saved_displacement)):.12f}\\\"\\n\",\")\\n\",\"\\n\",\"low_mean = float(np.mean(recalculated_low))\\n\",\"high_mean = float(np.mean(recalculated_high))\\n\",\"\\n\",\"low_median = float(np.median(recalculated_low))\\n\",\"high_median = float(np.median(recalculated_high))\\n\",\"\\n\",\"displacement_summary = pd.DataFrame([\\n\",\"    {\\n\",\"        \\\"Condition\\\": \\\"Low illumination\\\",\\n\",\"        \\\"Mean\\\": low_mean,\\n\",\"        \\\"Median\\\": low_median,\\n\",\"        \\\"Standard Deviation\\\": np.std(recalculated_low)\\n\",\"    },\\n\",\"    {\\n\",\"        \\\"Condition\\\": \\\"High illumination\\\",\\n\",\"        \\\"Mean\\\": high_mean,\\n\",\"        \\\"Median\\\": high_median,\\n\",\"        \\\"Standard Deviation\\\": np.std(recalculated_high)\\n\",\"    }\\n\",\"])\\n\",\"\\n\",\"display(displacement_summary)\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"High mean displacement exceeds low mean displacement\\\",\\n\",\"    high_mean > low_mean,\\n\",\"    f\\\"Low: {low_mean:.9f}; High: {high_mean:.9f}\\\"\\n\",\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. Verify saved metadata\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[6] METADATA CONSISTENCY\\\")\\n\",\"\\n\",\"metadata_checks = {\\n\",\"    \\\"dataset\\\": saved_metadata.get(\\\"dataset\\\") == \\\"LFW filtered subset\\\",\\n\",\"    \\\"model\\\": saved_metadata.get(\\\"model\\\") == \\\"InceptionResnetV1\\\",\\n\",\"    \\\"pretrained weights\\\": saved_metadata.get(\\\"pretrained_weights\\\") == \\\"VGGFace2\\\",\\n\",\"    \\\"embedding dimension\\\": saved_metadata.get(\\\"embedding_dimension\\\") == 512,\\n\",\"    \\\"paired images\\\": saved_metadata.get(\\\"paired_images\\\") == 889,\\n\",\"    \\\"evaluation identities\\\": saved_metadata.get(\\\"evaluation_identities\\\") == 13\\n\",\"}\\n\",\"\\n\",\"for name, passed in metadata_checks.items():\\n\",\"    record_audit(\\n\",\"        f\\\"Metadata: {name}\\\",\\n\",\"        passed,\\n\",\"        str(saved_metadata.get(name.replace(\\\" \\\", \\\"_\\\")))\\n\",\"    )\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"Low displacement mean matches metadata\\\",\\n\",\"    np.isclose(\\n\",\"        low_mean,\\n\",\"        saved_metadata.get(\\\"mean_low_displacement\\\", np.nan),\\n\",\"        atol=1e-7\\n\",\"    )\\n\",\")\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"High displacement mean matches metadata\\\",\\n\",\"    np.isclose(\\n\",\"        high_mean,\\n\",\"        saved_metadata.get(\\\"mean_high_displacement\\\", np.nan),\\n\",\"        atol=1e-7\\n\",\"    )\\n\",\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. Reproduce image-level and identity-level tests\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[7] STATISTICAL REPRODUCIBILITY\\\")\\n\",\"\\n\",\"image_test = wilcoxon(\\n\",\"    recalculated_high,\\n\",\"    recalculated_low,\\n\",\"    alternative=\\\"two-sided\\\"\\n\",\")\\n\",\"\\n\",\"image_p = float(image_test.pvalue)\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"Image-level Wilcoxon reproduction\\\",\\n\",\"    np.isclose(\\n\",\"        image_p,\\n\",\"        saved_metadata.get(\\\"image_level_wilcoxon_p\\\", np.nan),\\n\",\"        rtol=1e-6,\\n\",\"        atol=1e-100\\n\",\"    ),\\n\",\"    f\\\"Statistic: {image_test.statistic}; p-value: {image_p:.12e}\\\"\\n\",\")\\n\",\"\\n\",\"identity_df = pd.DataFrame({\\n\",\"    \\\"Identity\\\": paired_labels,\\n\",\"    \\\"Low\\\": recalculated_low,\\n\",\"    \\\"High\\\": recalculated_high\\n\",\"})\\n\",\"\\n\",\"identity_means = identity_df.groupby(\\\"Identity\\\")[\\n\",\"    [\\\"Low\\\", \\\"High\\\"]\\n\",\"].mean()\\n\",\"\\n\",\"identity_medians = identity_df.groupby(\\\"Identity\\\")[\\n\",\"    [\\\"Low\\\", \\\"High\\\"]\\n\",\"].median()\\n\",\"\\n\",\"mean_identity_test = wilcoxon(\\n\",\"    identity_means[\\\"High\\\"],\\n\",\"    identity_means[\\\"Low\\\"],\\n\",\"    alternative=\\\"two-sided\\\"\\n\",\")\\n\",\"\\n\",\"median_identity_test = wilcoxon(\\n\",\"    identity_medians[\\\"High\\\"],\\n\",\"    identity_medians[\\\"Low\\\"],\\n\",\"    alternative=\\\"two-sided\\\"\\n\",\")\\n\",\"\\n\",\"mean_identity_p = float(mean_identity_test.pvalue)\\n\",\"median_identity_p = float(median_identity_test.pvalue)\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"Mean-based identity Wilcoxon reproduction\\\",\\n\",\"    np.isclose(\\n\",\"        mean_identity_p,\\n\",\"        0.001220703125,\\n\",\"        atol=1e-12\\n\",\"    ),\\n\",\"    f\\\"Statistic: {mean_identity_test.statistic}; \\\"\\n\",\"    f\\\"p-value: {mean_identity_p:.12f}\\\"\\n\",\")\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"Median-based identity Wilcoxon reproduction\\\",\\n\",\"    np.isclose(\\n\",\"        median_identity_p,\\n\",\"        0.001220703125,\\n\",\"        atol=1e-12\\n\",\"    ),\\n\",\"    f\\\"Statistic: {median_identity_test.statistic}; \\\"\\n\",\"    f\\\"p-value: {median_identity_p:.12f}\\\"\\n\",\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 8. Verify identity distribution and CSV\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[8] IDENTITY DISTRIBUTION AND CSV\\\")\\n\",\"\\n\",\"identity_counts = (\\n\",\"    pd.Series(paired_labels)\\n\",\"    .value_counts()\\n\",\"    .sort_index()\\n\",\")\\n\",\"\\n\",\"identity_distribution_df = (\\n\",\"    identity_counts\\n\",\"    .rename_axis(\\\"Identity\\\")\\n\",\"    .reset_index(name=\\\"Image_Count\\\")\\n\",\")\\n\",\"\\n\",\"print(\\\"Identity distribution:\\\")\\n\",\"display(identity_distribution_df)\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"Exactly 13 identities\\\",\\n\",\"    len(identity_counts) == 13,\\n\",\"    f\\\"Observed identities: {len(identity_counts)}\\\"\\n\",\")\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"Identity 14 count\\\",\\n\",\"    int(identity_counts.get(14, 0)) == 504,\\n\",\"    f\\\"Observed count: {identity_counts.get(14, 0)}\\\"\\n\",\")\\n\",\"\\n\",\"required_csv_columns = [\\n\",\"    \\\"Identity\\\",\\n\",\"    \\\"Image_Count\\\",\\n\",\"    \\\"Low_Median\\\",\\n\",\"    \\\"High_Median\\\",\\n\",\"    \\\"Median_Difference\\\"\\n\",\"]\\n\",\"\\n\",\"csv_columns_ok = all(\\n\",\"    column in identity_csv.columns\\n\",\"    for column in required_csv_columns\\n\",\")\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"Identity CSV columns\\\",\\n\",\"    csv_columns_ok,\\n\",\"    f\\\"Columns: {list(identity_csv.columns)}\\\"\\n\",\")\\n\",\"\\n\",\"if csv_columns_ok:\\n\",\"\\n\",\"    csv_identity_counts = (\\n\",\"        identity_csv.set_index(\\\"Identity\\\")[\\\"Image_Count\\\"]\\n\",\"        .sort_index()\\n\",\"    )\\n\",\"\\n\",\"    counts_match = csv_identity_counts.equals(\\n\",\"        identity_counts.rename_axis(\\\"Identity\\\")\\n\",\"    )\\n\",\"\\n\",\"    record_audit(\\n\",\"        \\\"CSV identity counts match archive\\\",\\n\",\"        counts_match\\n\",\"    )\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 9. Verify detector analysis tables\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[9] DETECTOR ANALYSIS TRACEABILITY\\\")\\n\",\"\\n\",\"detector_tables_available = all(\\n\",\"    name in globals()\\n\",\"    for name in [\\n\",\"        \\\"evaluation_detector_df\\\",\\n\",\"        \\\"identity_detector_df\\\",\\n\",\"        \\\"effect_size_df\\\",\\n\",\"        \\\"statistical_findings\\\"\\n\",\"    ]\\n\",\")\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"Detector analysis tables available\\\",\\n\",\"    detector_tables_available\\n\",\")\\n\",\"\\n\",\"if detector_tables_available:\\n\",\"\\n\",\"    record_audit(\\n\",\"        \\\"Aggregate detector table dimensions\\\",\\n\",\"        len(evaluation_detector_df) == 3,\\n\",\"        f\\\"Rows: {len(evaluation_detector_df)}\\\"\\n\",\"    )\\n\",\"\\n\",\"    record_audit(\\n\",\"        \\\"Identity detector table dimensions\\\",\\n\",\"        len(identity_detector_df) == 26,\\n\",\"        f\\\"Rows: {len(identity_detector_df)}\\\"\\n\",\"    )\\n\",\"\\n\",\"    record_audit(\\n\",\"        \\\"Effect-size table dimensions\\\",\\n\",\"        len(effect_size_df) == 2,\\n\",\"        f\\\"Rows: {len(effect_size_df)}\\\"\\n\",\"    )\\n\",\"\\n\",\"    print(\\\"\\\\nAggregate detector findings:\\\")\\n\",\"    display(evaluation_detector_df)\\n\",\"\\n\",\"    print(\\\"\\\\nDetector effect sizes:\\\")\\n\",\"    display(effect_size_df)\\n\",\"\\n\",\"    print(\\n\",\"        \\\"\\\\nNote: Detector-response statistics are checked against \\\"\\n\",\"        \\\"the previously validated in-memory analysis tables. \\\"\\n\",\"        \\\"They are not independently regenerated from the original \\\"\\n\",\"        \\\"image-level detector pipeline in this audit.\\\"\\n\",\"    )\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 10. Record software environment\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n[10] SOFTWARE ENVIRONMENT\\\")\\n\",\"\\n\",\"packages = [\\n\",\"    \\\"numpy\\\",\\n\",\"    \\\"pandas\\\",\\n\",\"    \\\"scipy\\\",\\n\",\"    \\\"matplotlib\\\",\\n\",\"    \\\"torch\\\",\\n\",\"    \\\"torchvision\\\",\\n\",\"    \\\"facenet-pytorch\\\",\\n\",\"    \\\"scikit-learn\\\",\\n\",\"    \\\"Pillow\\\"\\n\",\"]\\n\",\"\\n\",\"environment_records = []\\n\",\"\\n\",\"for package in packages:\\n\",\"\\n\",\"    try:\\n\",\"        version = package_metadata.version(package)\\n\",\"    except package_metadata.PackageNotFoundError:\\n\",\"        version = \\\"Not installed or unavailable\\\"\\n\",\"\\n\",\"    environment_records.append({\\n\",\"        \\\"Package\\\": package,\\n\",\"        \\\"Version\\\": version\\n\",\"    })\\n\",\"\\n\",\"environment_df = pd.DataFrame(environment_records)\\n\",\"\\n\",\"print(\\\"Python:\\\", platform.python_version())\\n\",\"print(\\\"Platform:\\\", platform.platform())\\n\",\"\\n\",\"display(environment_df)\\n\",\"\\n\",\"record_audit(\\n\",\"    \\\"Software environment recorded\\\",\\n\",\"    True,\\n\",\"    f\\\"Python {platform.python_version()}\\\"\\n\",\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 11. Final audit report\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 85)\\n\",\"print(\\\"FINAL REPRODUCIBILITY AUDIT REPORT\\\")\\n\",\"print(\\\"=\\\" * 85)\\n\",\"\\n\",\"audit_df = pd.DataFrame(audit_results)\\n\",\"\\n\",\"display(audit_df)\\n\",\"\\n\",\"passed_count = int(\\n\",\"    (audit_df[\\\"Status\\\"] == \\\"PASSED\\\").sum()\\n\",\")\\n\",\"\\n\",\"failed_count = int(\\n\",\"    (audit_df[\\\"Status\\\"] == \\\"FAILED\\\").sum()\\n\",\")\\n\",\"\\n\",\"total_count = len(audit_df)\\n\",\"\\n\",\"print(f\\\"\\\\nTotal audit checks: {total_count}\\\")\\n\",\"print(f\\\"Passed: {passed_count}\\\")\\n\",\"print(f\\\"Failed: {failed_count}\\\")\\n\",\"\\n\",\"print(\\\"\\\\nDOCUMENTATION STATUS\\\")\\n\",\"print(\\\"Saved files: CHECKED\\\")\\n\",\"print(\\\"Embedding archive: CHECKED\\\")\\n\",\"print(\\\"Illumination archive: CHECKED\\\")\\n\",\"print(\\\"Metadata consistency: CHECKED\\\")\\n\",\"print(\\\"Displacement reproduction: CHECKED\\\")\\n\",\"print(\\\"Statistical reproduction: CHECKED\\\")\\n\",\"print(\\\"Identity distribution: CHECKED\\\")\\n\",\"print(\\\"Detector analysis traceability: CHECKED\\\")\\n\",\"print(\\\"Software environment: RECORDED\\\")\\n\",\"\\n\",\"print(\\\"\\\\nIMPORTANT LIMITATION\\\")\\n\",\"print(\\n\",\"    \\\"This audit verifies saved outputs and selected numerical \\\"\\n\",\"    \\\"reproductions. It does not independently rerun the original \\\"\\n\",\"    \\\"image detection, preprocessing, embedding extraction, or \\\"\\n\",\"    \\\"detector calibration pipeline.\\\"\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\nNo saved experiment files modified.\\\")\\n\",\"print(\\\"No model training performed.\\\")\\n\",\"print(\\\"No new embedding extraction performed.\\\")\\n\",\"\\n\",\"if failed_count == 0:\\n\",\"    print(\\\"\\\\nSTEP 17.10.6.4 — AUDIT PASSED\\\")\\n\",\"else:\\n\",\"    print(\\n\",\"        \\\"\\\\nSTEP 17.10.6.4 — REVIEW REQUIRED: \\\"\\n\",\"        f\\\"{failed_count} checks failed.\\\"\\n\",\"    )\\n\",\"\\n\",\"print(\\\"=\\\" * 85)\\n\",\"\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 139\\n\",\"CELL TYPE: markdown\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"### Step 17.10.6.5 — Final Research Evidence Package\\n\",\"\\n\",\"Objective: Consolidate all validated Experiment 18 evidence into a final structured research record.\\n\",\"\\n\",\"Scope:\\n\",\"1. Consolidate experimental configuration and dataset information.\\n\",\"2. Summarise embedding extraction and controlled illumination methodology.\\n\",\"3. Record aggregate and identity-level detector findings.\\n\",\"4. Include verified displacement statistics and statistical tests.\\n\",\"5. Document effect sizes, confidence intervals, and limitations.\\n\",\"6. Record reproducibility audit results and software environment.\\n\",\"7. Distinguish validated findings, exploratory observations, and unsupported claims.\\n\",\"8. Prepare a traceable evidence package for future research writing.\\n\",\"\\n\",\"Expected outcome: A final, structured Experiment 18 research evidence record.\\n\",\"\\n\",\"No new embedding extraction, model training, or experimental data generation.\\n\",\"No modification of validated experimental results.\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 140\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"\\n\",\"# ============================================================\\n\",\"# EXPERIMENT 18 — STEP 17.10.6.5\\n\",\"# FINAL RESEARCH EVIDENCE PACKAGE\\n\",\"# Corrected version — uses validated in-memory results\\n\",\"# ============================================================\\n\",\"\\n\",\"import os\\n\",\"import sys\\n\",\"import json\\n\",\"import platform\\n\",\"import numpy as np\\n\",\"import pandas as pd\\n\",\"import scipy\\n\",\"import torch\\n\",\"import torchvision\\n\",\"import sklearn\\n\",\"import PIL\\n\",\"\\n\",\"from datetime import datetime, timezone\\n\",\"from importlib.metadata import version, PackageNotFoundError\\n\",\"\\n\",\"\\n\",\"print(\\\"=\\\" * 80)\\n\",\"print(\\\"STEP 17.10.6.5 — FINAL RESEARCH EVIDENCE PACKAGE\\\")\\n\",\"print(\\\"=\\\" * 80)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. CONFIGURATION AND REQUIRED FILE VERIFICATION\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"RESULTS_DIR = \\\"/content/drive/MyDrive/Experiment_18_Results\\\"\\n\",\"\\n\",\"ORIGINAL_ARCHIVE = os.path.join(\\n\",\"    RESULTS_DIR,\\n\",\"    \\\"experiment18_facenet_lfw_embeddings.npz\\\"\\n\",\")\\n\",\"\\n\",\"ILLUMINATION_ARCHIVE = os.path.join(\\n\",\"    RESULTS_DIR,\\n\",\"    \\\"experiment18_illumination_results.npz\\\"\\n\",\")\\n\",\"\\n\",\"METADATA_FILE = os.path.join(\\n\",\"    RESULTS_DIR,\\n\",\"    \\\"illumination_metadata.json\\\"\\n\",\")\\n\",\"\\n\",\"CSV_FILE = os.path.join(\\n\",\"    RESULTS_DIR,\\n\",\"    \\\"illumination_identity_summary.csv\\\"\\n\",\")\\n\",\"\\n\",\"required_files = [\\n\",\"    ORIGINAL_ARCHIVE,\\n\",\"    ILLUMINATION_ARCHIVE,\\n\",\"    METADATA_FILE,\\n\",\"    CSV_FILE\\n\",\"]\\n\",\"\\n\",\"missing_files = [\\n\",\"    path for path in required_files\\n\",\"    if not os.path.isfile(path)\\n\",\"]\\n\",\"\\n\",\"assert not missing_files, (\\n\",\"    \\\"Required experiment files are missing:\\\\n\\\"\\n\",\"    + \\\"\\\\n\\\".join(missing_files)\\n\",\")\\n\",\"\\n\",\"required_variables = [\\n\",\"    \\\"evaluation_detector_df\\\",\\n\",\"    \\\"identity_detector_df\\\",\\n\",\"    \\\"statistical_results\\\",\\n\",\"    \\\"effect_size_df\\\"\\n\",\"]\\n\",\"\\n\",\"missing_variables = [\\n\",\"    name for name in required_variables\\n\",\"    if name not in globals()\\n\",\"]\\n\",\"\\n\",\"assert not missing_variables, (\\n\",\"    \\\"Required validated DataFrames are unavailable: \\\"\\n\",\"    + \\\", \\\".join(missing_variables)\\n\",\")\\n\",\"\\n\",\"for name in required_variables:\\n\",\"    assert isinstance(globals()[name], pd.DataFrame), (\\n\",\"        f\\\"{name} is not a DataFrame.\\\"\\n\",\"    )\\n\",\"\\n\",\"print(\\\"Section 1: Required files and detector tables verified.\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. LOAD EXISTING EXPERIMENT OUTPUTS\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"with np.load(\\n\",\"    ORIGINAL_ARCHIVE,\\n\",\"    allow_pickle=False\\n\",\") as original_data:\\n\",\"\\n\",\"    original_shapes = {\\n\",\"        key: list(original_data[key].shape)\\n\",\"        for key in original_data.files\\n\",\"    }\\n\",\"\\n\",\"with np.load(\\n\",\"    ILLUMINATION_ARCHIVE,\\n\",\"    allow_pickle=False\\n\",\") as illumination_data:\\n\",\"\\n\",\"    illumination_shapes = {\\n\",\"        key: list(illumination_data[key].shape)\\n\",\"        for key in illumination_data.files\\n\",\"    }\\n\",\"\\n\",\"    original_embeddings = illumination_data[\\n\",\"        \\\"original_embeddings\\\"\\n\",\"    ].copy()\\n\",\"\\n\",\"    low_embeddings = illumination_data[\\n\",\"        \\\"low_illumination_embeddings\\\"\\n\",\"    ].copy()\\n\",\"\\n\",\"    high_embeddings = illumination_data[\\n\",\"        \\\"high_illumination_embeddings\\\"\\n\",\"    ].copy()\\n\",\"\\n\",\"    paired_labels = illumination_data[\\n\",\"        \\\"paired_labels\\\"\\n\",\"    ].copy()\\n\",\"\\n\",\"    saved_low_displacement = illumination_data[\\n\",\"        \\\"low_displacement\\\"\\n\",\"    ].copy()\\n\",\"\\n\",\"    saved_high_displacement = illumination_data[\\n\",\"        \\\"high_displacement\\\"\\n\",\"    ].copy()\\n\",\"\\n\",\"with open(METADATA_FILE, \\\"r\\\", encoding=\\\"utf-8\\\") as file:\\n\",\"    metadata = json.load(file)\\n\",\"\\n\",\"identity_csv = pd.read_csv(CSV_FILE)\\n\",\"\\n\",\"print(\\\"Section 2: Existing archives and metadata loaded.\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. DATASET COMPOSITION\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"assert original_embeddings.shape == low_embeddings.shape\\n\",\"assert original_embeddings.shape == high_embeddings.shape\\n\",\"assert original_embeddings.ndim == 2\\n\",\"assert original_embeddings.shape[0] == len(paired_labels)\\n\",\"assert original_embeddings.shape[1] == 512\\n\",\"\\n\",\"assert np.isfinite(original_embeddings).all()\\n\",\"assert np.isfinite(low_embeddings).all()\\n\",\"assert np.isfinite(high_embeddings).all()\\n\",\"\\n\",\"identity_values, identity_counts = np.unique(\\n\",\"    paired_labels,\\n\",\"    return_counts=True\\n\",\")\\n\",\"\\n\",\"identity_distribution = [\\n\",\"    {\\n\",\"        \\\"identity\\\": int(identity),\\n\",\"        \\\"paired_image_count\\\": int(count)\\n\",\"    }\\n\",\"    for identity, count in zip(\\n\",\"        identity_values,\\n\",\"        identity_counts\\n\",\"    )\\n\",\"]\\n\",\"\\n\",\"paired_images = int(len(paired_labels))\\n\",\"identity_count = int(len(identity_values))\\n\",\"embedding_dimension = int(original_embeddings.shape[1])\\n\",\"\\n\",\"largest_identity_index = int(np.argmax(identity_counts))\\n\",\"\\n\",\"largest_identity = int(\\n\",\"    identity_values[largest_identity_index]\\n\",\")\\n\",\"\\n\",\"largest_identity_count = int(\\n\",\"    identity_counts[largest_identity_index]\\n\",\")\\n\",\"\\n\",\"largest_identity_share = (\\n\",\"    largest_identity_count / paired_images\\n\",\")\\n\",\"\\n\",\"assert paired_images == 889\\n\",\"assert identity_count == 13\\n\",\"\\n\",\"print(\\\"\\\\nSection 3: Dataset composition verified.\\\")\\n\",\"print(\\\"Paired images:\\\", paired_images)\\n\",\"print(\\\"Identities:\\\", identity_count)\\n\",\"print(\\\"Embedding dimension:\\\", embedding_dimension)\\n\",\"print(\\\"Largest identity:\\\", largest_identity)\\n\",\"print(\\\"Largest identity share:\\\", f\\\"{largest_identity_share:.2%}\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. REPRODUCE SAVED EMBEDDING DISPLACEMENTS\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"recalculated_low = np.linalg.norm(\\n\",\"    low_embeddings - original_embeddings,\\n\",\"    axis=1\\n\",\")\\n\",\"\\n\",\"recalculated_high = np.linalg.norm(\\n\",\"    high_embeddings - original_embeddings,\\n\",\"    axis=1\\n\",\")\\n\",\"\\n\",\"low_max_error = float(\\n\",\"    np.max(\\n\",\"        np.abs(\\n\",\"            recalculated_low - saved_low_displacement\\n\",\"        )\\n\",\"    )\\n\",\")\\n\",\"\\n\",\"high_max_error = float(\\n\",\"    np.max(\\n\",\"        np.abs(\\n\",\"            recalculated_high - saved_high_displacement\\n\",\"        )\\n\",\"    )\\n\",\")\\n\",\"\\n\",\"assert low_max_error == 0.0, (\\n\",\"    \\\"Low-illumination displacement reproduction failed.\\\"\\n\",\")\\n\",\"\\n\",\"assert high_max_error == 0.0, (\\n\",\"    \\\"High-illumination displacement reproduction failed.\\\"\\n\",\")\\n\",\"\\n\",\"displacement_summary = {\\n\",\"    \\\"low_illumination\\\": {\\n\",\"        \\\"mean\\\": float(np.mean(saved_low_displacement)),\\n\",\"        \\\"median\\\": float(np.median(saved_low_displacement)),\\n\",\"        \\\"standard_deviation\\\": float(\\n\",\"            np.std(saved_low_displacement)\\n\",\"        )\\n\",\"    },\\n\",\"    \\\"high_illumination\\\": {\\n\",\"        \\\"mean\\\": float(np.mean(saved_high_displacement)),\\n\",\"        \\\"median\\\": float(np.median(saved_high_displacement)),\\n\",\"        \\\"standard_deviation\\\": float(\\n\",\"            np.std(saved_high_displacement)\\n\",\"        )\\n\",\"    },\\n\",\"    \\\"high_minus_low_mean\\\": float(\\n\",\"        np.mean(\\n\",\"            saved_high_displacement - saved_low_displacement\\n\",\"        )\\n\",\"    ),\\n\",\"    \\\"high_minus_low_median\\\": float(\\n\",\"        np.median(\\n\",\"            saved_high_displacement - saved_low_displacement\\n\",\"        )\\n\",\"    ),\\n\",\"    \\\"reproduction_max_absolute_error\\\": {\\n\",\"        \\\"low\\\": low_max_error,\\n\",\"        \\\"high\\\": high_max_error\\n\",\"    }\\n\",\"}\\n\",\"\\n\",\"print(\\\"\\\\nSection 4: Displacement reproduction passed.\\\")\\n\",\"print(\\\"Low maximum error:\\\", low_max_error)\\n\",\"print(\\\"High maximum error:\\\", high_max_error)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. HISTORICAL DISPLACEMENT STATISTICAL FINDINGS\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"displacement_tests = {\\n\",\"    \\\"image_level\\\": {\\n\",\"        \\\"unit_of_analysis\\\": \\\"paired images\\\",\\n\",\"        \\\"sample_size\\\": 889,\\n\",\"        \\\"wilcoxon_statistic\\\": 52705.0,\\n\",\"        \\\"p_value\\\": 4.708938281282196e-80\\n\",\"    },\\n\",\"    \\\"identity_level_mean_displacement\\\": {\\n\",\"        \\\"unit_of_analysis\\\": \\\"identity-level means\\\",\\n\",\"        \\\"sample_size\\\": 13,\\n\",\"        \\\"wilcoxon_statistic\\\": 3.0,\\n\",\"        \\\"p_value\\\": 0.001220703125\\n\",\"    },\\n\",\"    \\\"identity_level_median_displacement\\\": {\\n\",\"        \\\"unit_of_analysis\\\": \\\"identity-level medians\\\",\\n\",\"        \\\"sample_size\\\": 13,\\n\",\"        \\\"wilcoxon_statistic\\\": 3.0,\\n\",\"        \\\"p_value\\\": 0.001220703125\\n\",\"    }\\n\",\"}\\n\",\"\\n\",\"print(\\\"\\\\nSection 5: Previously reproduced displacement statistics recorded.\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. CORRECTED DETECTOR STATISTICS AND EFFECT SIZES\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"expected_detectors = {\\\"Euclidean\\\", \\\"Mahalanobis\\\"}\\n\",\"\\n\",\"assert set(statistical_results[\\\"Detector\\\"]) == expected_detectors\\n\",\"assert set(effect_size_df[\\\"Detector\\\"]) == expected_detectors\\n\",\"\\n\",\"expected_p_values = {\\n\",\"    \\\"Euclidean\\\": 0.021484,\\n\",\"    \\\"Mahalanobis\\\": 0.002441\\n\",\"}\\n\",\"\\n\",\"expected_wilcoxon = {\\n\",\"    \\\"Euclidean\\\": 13.0,\\n\",\"    \\\"Mahalanobis\\\": 5.0\\n\",\"}\\n\",\"\\n\",\"for detector in expected_detectors:\\n\",\"\\n\",\"    stat_row = statistical_results.loc[\\n\",\"        statistical_results[\\\"Detector\\\"] == detector\\n\",\"    ].iloc[0]\\n\",\"\\n\",\"    assert np.isclose(\\n\",\"        float(stat_row[\\\"P-value\\\"]),\\n\",\"        expected_p_values[detector],\\n\",\"        atol=1e-6\\n\",\"    ), f\\\"{detector} corrected p-value mismatch.\\\"\\n\",\"\\n\",\"    assert np.isclose(\\n\",\"        float(stat_row[\\\"Wilcoxon Statistic\\\"]),\\n\",\"        expected_wilcoxon[detector]\\n\",\"    ), f\\\"{detector} corrected Wilcoxon statistic mismatch.\\\"\\n\",\"\\n\",\"detector_tests_df = statistical_results.merge(\\n\",\"    effect_size_df,\\n\",\"    on=\\\"Detector\\\",\\n\",\"    how=\\\"inner\\\",\\n\",\"    validate=\\\"one_to_one\\\"\\n\",\")\\n\",\"\\n\",\"assert len(detector_tests_df) == 2\\n\",\"\\n\",\"detector_tests_df = detector_tests_df.sort_values(\\n\",\"    \\\"Detector\\\"\\n\",\").reset_index(drop=True)\\n\",\"\\n\",\"print(\\\"\\\\nSection 6: Corrected detector statistical results verified.\\\")\\n\",\"display(detector_tests_df)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. AGGREGATE AND IDENTITY-LEVEL DETECTOR EVIDENCE\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"aggregate_detector_records = (\\n\",\"    evaluation_detector_df.to_dict(orient=\\\"records\\\")\\n\",\")\\n\",\"\\n\",\"identity_detector_records = (\\n\",\"    identity_detector_df.to_dict(orient=\\\"records\\\")\\n\",\")\\n\",\"\\n\",\"effect_size_records = (\\n\",\"    effect_size_df.to_dict(orient=\\\"records\\\")\\n\",\")\\n\",\"\\n\",\"# Calculate identity-level direction directly from the validated table.\\n\",\"identity_pivot = identity_detector_df.pivot(\\n\",\"    index=\\\"Identity\\\",\\n\",\"    columns=\\\"Condition\\\",\\n\",\"    values=[\\\"Euclidean\\\", \\\"Mahalanobis\\\"]\\n\",\")\\n\",\"\\n\",\"identity_direction_summary = {}\\n\",\"\\n\",\"for detector in [\\\"Euclidean\\\", \\\"Mahalanobis\\\"]:\\n\",\"\\n\",\"    low_values = identity_pivot[\\n\",\"        (detector, \\\"Low illumination\\\")\\n\",\"    ]\\n\",\"\\n\",\"    high_values = identity_pivot[\\n\",\"        (detector, \\\"High illumination\\\")\\n\",\"    ]\\n\",\"\\n\",\"    differences = high_values - low_values\\n\",\"\\n\",\"    identity_direction_summary[detector.lower()] = {\\n\",\"        \\\"increased\\\": int((differences > 0).sum()),\\n\",\"        \\\"decreased\\\": int((differences < 0).sum()),\\n\",\"        \\\"unchanged\\\": int((differences == 0).sum()),\\n\",\"        \\\"identities\\\": int(len(differences))\\n\",\"    }\\n\",\"\\n\",\"assert identity_direction_summary[\\\"euclidean\\\"][\\\"increased\\\"] == 10\\n\",\"assert identity_direction_summary[\\\"euclidean\\\"][\\\"decreased\\\"] == 3\\n\",\"\\n\",\"assert identity_direction_summary[\\\"mahalanobis\\\"][\\\"increased\\\"] == 11\\n\",\"assert identity_direction_summary[\\\"mahalanobis\\\"][\\\"decreased\\\"] == 2\\n\",\"\\n\",\"print(\\\"\\\\nSection 7: Aggregate and identity-level detector evidence collected.\\\")\\n\",\"print(identity_direction_summary)\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 8. SOFTWARE ENVIRONMENT\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"def get_package_version(package_name):\\n\",\"    try:\\n\",\"        return version(package_name)\\n\",\"    except PackageNotFoundError:\\n\",\"        return \\\"Not available\\\"\\n\",\"\\n\",\"\\n\",\"software_environment = {\\n\",\"    \\\"python\\\": platform.python_version(),\\n\",\"    \\\"platform\\\": platform.platform(),\\n\",\"    \\\"numpy\\\": np.__version__,\\n\",\"    \\\"pandas\\\": pd.__version__,\\n\",\"    \\\"scipy\\\": scipy.__version__,\\n\",\"    \\\"pytorch\\\": torch.__version__,\\n\",\"    \\\"torchvision\\\": torchvision.__version__,\\n\",\"    \\\"scikit_learn\\\": sklearn.__version__,\\n\",\"    \\\"pillow\\\": PIL.__version__,\\n\",\"    \\\"facenet_pytorch\\\": get_package_version(\\\"facenet-pytorch\\\")\\n\",\"}\\n\",\"\\n\",\"print(\\\"\\\\nSection 8: Software environment recorded.\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 9. EVIDENCE CLASSIFICATION\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"evidence_interpretation = {\\n\",\"    \\\"validated\\\": [\\n\",\"        \\\"Saved embedding arrays and dimensions were verified.\\\",\\n\",\"        \\\"Saved low- and high-illumination displacement arrays were reproduced exactly.\\\",\\n\",\"        \\\"Saved displacement summary statistics were reproduced.\\\",\\n\",\"        \\\"Historical image-level and identity-level displacement tests were reproduced.\\\",\\n\",\"        \\\"Saved identity summary CSV was checked for consistency.\\\",\\n\",\"        \\\"The reproducibility audit passed 54 checks.\\\"\\n\",\"    ],\\n\",\"    \\\"exploratory\\\": [\\n\",\"        \\\"Aggregate Euclidean and Mahalanobis detector responses varied across illumination conditions.\\\",\\n\",\"        \\\"Identity-level detector responses varied across identities.\\\",\\n\",\"        \\\"Corrected Euclidean and Mahalanobis detector-response tests were below the nominal 0.05 threshold.\\\",\\n\",\"        \\\"Detector-response findings are based on only 13 identity-level observations.\\\"\\n\",\"    ],\\n\",\"    \\\"not_established\\\": [\\n\",\"        \\\"Real-world biometric recognition accuracy.\\\",\\n\",\"        \\\"Generalisation to other biometric datasets or models.\\\",\\n\",\"        \\\"Demographic fairness.\\\",\\n\",\"        \\\"Deployment readiness.\\\",\\n\",\"        \\\"Causal explanation of detector-response differences.\\\"\\n\",\"    ]\\n\",\"}\\n\",\"\\n\",\"limitations = [\\n\",\"    \\\"The corrected detector evaluation cohort contains 229 images from 13 identities.\\\",\\n\",\"    \\\"The historical paired illumination cohort contains 889 images from 13 identities.\\\",\\n\",\"    f\\\"Identity {largest_identity} contributes {largest_identity_share:.1%} of the historical paired images.\\\",\\n\",\"    \\\"Image observations are clustered within identities and must not be treated as independent subjects.\\\",\\n\",\"    \\\"Identity-level detector analyses have only 13 identity-level units.\\\",\\n\",\"    \\\"The illumination changes were controlled brightness transformations.\\\",\\n\",\"    \\\"Corrected detector-response p-values are nominal and have not been adjusted for multiple comparisons.\\\",\\n\",\"    \\\"Detector-response findings rely on previously validated tables and were not recalibrated in this documentation step.\\\"\\n\",\"]\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 10. BUILD STRUCTURED JSON EVIDENCE\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"evidence = {\\n\",\"    \\\"experiment\\\": {\\n\",\"        \\\"title\\\": \\\"Experiment 18 - Controlled Illumination\\\",\\n\",\"        \\\"dataset\\\": \\\"LFW filtered subset\\\",\\n\",\"        \\\"model\\\": \\\"InceptionResnetV1\\\",\\n\",\"        \\\"pretrained_weights\\\": \\\"VGGFace2\\\",\\n\",\"        \\\"embedding_dimension\\\": embedding_dimension,\\n\",\"        \\\"brightness_factors\\\": {\\n\",\"            \\\"low\\\": 0.5,\\n\",\"            \\\"original\\\": 1.0,\\n\",\"            \\\"high\\\": 1.5\\n\",\"        }\\n\",\"    },\\n\",\"    \\\"dataset_summary\\\": {\\n\",\"        \\\"paired_images\\\": paired_images,\\n\",\"        \\\"evaluation_identities\\\": identity_count,\\n\",\"        \\\"identity_distribution\\\": identity_distribution,\\n\",\"        \\\"largest_identity\\\": largest_identity,\\n\",\"        \\\"largest_identity_image_count\\\": largest_identity_count,\\n\",\"        \\\"largest_identity_share\\\": largest_identity_share,\\n\",\"        \\\"corrected_detector_evaluation_images\\\": 229\\n\",\"    },\\n\",\"    \\\"original_embedding_archive_shapes\\\": original_shapes,\\n\",\"    \\\"illumination_archive_shapes\\\": illumination_shapes,\\n\",\"    \\\"illumination_displacement\\\": displacement_summary,\\n\",\"    \\\"displacement_statistical_tests\\\": displacement_tests,\\n\",\"    \\\"aggregate_detector_results\\\": aggregate_detector_records,\\n\",\"    \\\"identity_level_detector_results\\\": identity_detector_records,\\n\",\"    \\\"detector_effect_sizes\\\": effect_size_records,\\n\",\"    \\\"detector_statistical_tests\\\": detector_tests_df.to_dict(\\n\",\"        orient=\\\"records\\\"\\n\",\"    ),\\n\",\"    \\\"identity_level_detector_directions\\\": identity_direction_summary,\\n\",\"    \\\"reproducibility_audit\\\": {\\n\",\"        \\\"step\\\": \\\"17.10.6.4\\\",\\n\",\"        \\\"checks\\\": 54,\\n\",\"        \\\"passed\\\": 54,\\n\",\"        \\\"failed\\\": 0,\\n\",\"        \\\"scope\\\": (\\n\",\"            \\\"Verified saved outputs, array integrity, displacement \\\"\\n\",\"            \\\"reproduction, statistical summaries, CSV consistency, \\\"\\n\",\"            \\\"metadata consistency, and detector-table availability.\\\"\\n\",\"        ),\\n\",\"        \\\"limitation\\\": (\\n\",\"            \\\"The audit did not independently rerun original image \\\"\\n\",\"            \\\"detection, preprocessing, embedding extraction, or \\\"\\n\",\"            \\\"detector calibration.\\\"\\n\",\"        )\\n\",\"    },\\n\",\"    \\\"software_environment\\\": software_environment,\\n\",\"    \\\"source_files\\\": [\\n\",\"        os.path.basename(ORIGINAL_ARCHIVE),\\n\",\"        os.path.basename(ILLUMINATION_ARCHIVE),\\n\",\"        os.path.basename(METADATA_FILE),\\n\",\"        os.path.basename(CSV_FILE)\\n\",\"    ],\\n\",\"    \\\"evidence_interpretation\\\": evidence_interpretation,\\n\",\"    \\\"limitations\\\": limitations,\\n\",\"    \\\"documentation_created_utc\\\": datetime.now(\\n\",\"        timezone.utc\\n\",\"    ).isoformat()\\n\",\"}\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 11. CREATE MARKDOWN RESEARCH REPORT\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"report_path = os.path.join(\\n\",\"    RESULTS_DIR,\\n\",\"    \\\"experiment18_final_research_evidence.md\\\"\\n\",\")\\n\",\"\\n\",\"json_path = os.path.join(\\n\",\"    RESULTS_DIR,\\n\",\"    \\\"experiment18_final_research_evidence.json\\\"\\n\",\")\\n\",\"\\n\",\"markdown = f\\\"\\\"\\\"# Experiment 18 — Final Research Evidence Package\\n\",\"\\n\",\"## 1. Experiment Overview\\n\",\"\\n\",\"- Dataset: LFW filtered subset\\n\",\"- Model: InceptionResnetV1\\n\",\"- Pretrained weights: VGGFace2\\n\",\"- Embedding dimension: {embedding_dimension}\\n\",\"- Brightness factors: 0.5, 1.0, 1.5\\n\",\"- Historical paired illumination images: {paired_images}\\n\",\"- Identities in historical paired cohort: {identity_count}\\n\",\"- Corrected detector evaluation cohort: 229 images\\n\",\"\\n\",\"## 2. Dataset Composition\\n\",\"\\n\",\"The historical paired illumination cohort contains {paired_images}\\n\",\"images from {identity_count} identities.\\n\",\"\\n\",\"Identity {largest_identity} contributes {largest_identity_count}\\n\",\"images ({largest_identity_share:.2%}) of the historical paired cohort.\\n\",\"\\n\",\"| Identity | Paired image count |\\n\",\"|---:|---:|\\n\",\"\\\"\\\"\\\"\\n\",\"\\n\",\"for item in identity_distribution:\\n\",\"    markdown += (\\n\",\"        f\\\"| {item['identity']} | \\\"\\n\",\"        f\\\"{item['paired_image_count']} |\\\\n\\\"\\n\",\"    )\\n\",\"\\n\",\"markdown += f\\\"\\\"\\\"\\n\",\"## 3. Embedding Displacement\\n\",\"\\n\",\"| Statistic | Low illumination | High illumination |\\n\",\"|---|---:|---:|\\n\",\"| Mean | {displacement_summary['low_illumination']['mean']:.9f} | {displacement_summary['high_illumination']['mean']:.9f} |\\n\",\"| Median | {displacement_summary['low_illumination']['median']:.9f} | {displacement_summary['high_illumination']['median']:.9f} |\\n\",\"| Standard deviation | {displacement_summary['low_illumination']['standard_deviation']:.9f} | {displacement_summary['high_illumination']['standard_deviation']:.9f} |\\n\",\"\\n\",\"Mean high-minus-low displacement:\\n\",\"{displacement_summary['high_minus_low_mean']:.9f}\\n\",\"\\n\",\"Median high-minus-low displacement:\\n\",\"{displacement_summary['high_minus_low_median']:.9f}\\n\",\"\\n\",\"Displacement reproduction maximum absolute error:\\n\",\"- Low: {low_max_error}\\n\",\"- High: {high_max_error}\\n\",\"\\n\",\"## 4. Historical Displacement Statistical Tests\\n\",\"\\n\",\"| Analysis | Unit | n | Wilcoxon statistic | p-value |\\n\",\"|---|---|---:|---:|---:|\\n\",\"| Image-level | Paired images | 889 | 52705.0 | 4.708938281282196e-80 |\\n\",\"| Identity-level means | Identities | 13 | 3.0 | 0.001220703125 |\\n\",\"| Identity-level medians | Identities | 13 | 3.0 | 0.001220703125 |\\n\",\"\\n\",\"The image-level observations are clustered within identities and\\n\",\"must not be interpreted as 889 independent subjects.\\n\",\"\\n\",\"## 5. Aggregate Detector Results\\n\",\"\\n\",\"{evaluation_detector_df.to_string(index=False)}\\n\",\"\\n\",\"## 6. Identity-Level Detector Results\\n\",\"\\n\",\"{identity_detector_df.to_string(index=False)}\\n\",\"\\n\",\"## 7. Corrected Detector Statistical Tests and Effect Sizes\\n\",\"\\n\",\"{detector_tests_df.to_string(index=False)}\\n\",\"\\n\",\"The corrected Euclidean paired detector-response test has\\n\",\"Wilcoxon statistic 13 and p-value 0.021484.\\n\",\"\\n\",\"The corrected Mahalanobis paired detector-response test has\\n\",\"Wilcoxon statistic 5 and p-value 0.002441.\\n\",\"\\n\",\"Both tests are below the nominal 0.05 significance threshold.\\n\",\"These results are based on 13 identity-level observations and\\n\",\"have not been adjusted for multiple comparisons.\\n\",\"\\n\",\"## 8. Identity-Level Detector Direction\\n\",\"\\n\",\"- Euclidean high-versus-low response increased for\\n\",\"  {identity_direction_summary['euclidean']['increased']} of 13 identities\\n\",\"  and decreased for {identity_direction_summary['euclidean']['decreased']}.\\n\",\"- Mahalanobis high-versus-low response increased for\\n\",\"  {identity_direction_summary['mahalanobis']['increased']} of 13 identities\\n\",\"  and decreased for {identity_direction_summary['mahalanobis']['decreased']}.\\n\",\"\\n\",\"## 9. Reproducibility Audit\\n\",\"\\n\",\"Step 17.10.6.4: 54 checks passed; 0 failed.\\n\",\"\\n\",\"The audit checked saved files, array shapes and integrity,\\n\",\"displacement reproduction, statistical summaries, CSV consistency,\\n\",\"metadata, and detector-table availability.\\n\",\"\\n\",\"It did not independently rerun original image detection,\\n\",\"preprocessing, embedding extraction, or detector calibration.\\n\",\"\\n\",\"## 10. Software Environment\\n\",\"\\n\",\"{pd.DataFrame(\\n\",\"    list(software_environment.items()),\\n\",\"    columns=[\\\"Component\\\", \\\"Version\\\"]\\n\",\").to_string(index=False)}\\n\",\"\\n\",\"## 11. Evidence Classification\\n\",\"\\n\",\"### Validated findings\\n\",\"\\n\",\"{chr(10).join('- ' + item for item in evidence_interpretation['validated'])}\\n\",\"\\n\",\"### Exploratory findings\\n\",\"\\n\",\"{chr(10).join('- ' + item for item in evidence_interpretation['exploratory'])}\\n\",\"\\n\",\"### Claims not established\\n\",\"\\n\",\"{chr(10).join('- ' + item for item in evidence_interpretation['not_established'])}\\n\",\"\\n\",\"## 12. Limitations\\n\",\"\\n\",\"{chr(10).join(f'{i}. {item}' for i, item in enumerate(limitations, start=1))}\\n\",\"\\n\",\"## 13. Provenance and Scope\\n\",\"\\n\",\"This evidence package consolidates previously generated and audited\\n\",\"Experiment 18 outputs.\\n\",\"\\n\",\"It does not perform new image detection, preprocessing, embedding\\n\",\"extraction, model training, detector calibration, or statistical testing.\\n\",\"\\n\",\"Original experiment archives and metadata are retained unchanged.\\n\",\"\\\"\\\"\\\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 12. SAVE DOCUMENTATION FILES\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"with open(report_path, \\\"w\\\", encoding=\\\"utf-8\\\") as file:\\n\",\"    file.write(markdown)\\n\",\"\\n\",\"with open(json_path, \\\"w\\\", encoding=\\\"utf-8\\\") as file:\\n\",\"    json.dump(\\n\",\"        evidence,\\n\",\"        file,\\n\",\"        indent=2,\\n\",\"        allow_nan=False\\n\",\"    )\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 13. VERIFY GENERATED FILES AND CORRECTED CONTENT\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"for path in [report_path, json_path]:\\n\",\"\\n\",\"    assert os.path.isfile(path), (\\n\",\"        f\\\"Output file missing: {path}\\\"\\n\",\"    )\\n\",\"\\n\",\"    assert os.path.getsize(path) > 0, (\\n\",\"        f\\\"Output file is empty: {path}\\\"\\n\",\"    )\\n\",\"\\n\",\"with open(json_path, \\\"r\\\", encoding=\\\"utf-8\\\") as file:\\n\",\"    verified_json = json.load(file)\\n\",\"\\n\",\"assert verified_json[\\\"dataset_summary\\\"][\\\"paired_images\\\"] == 889\\n\",\"assert verified_json[\\\"dataset_summary\\\"][\\\"evaluation_identities\\\"] == 13\\n\",\"assert verified_json[\\\"dataset_summary\\\"][\\\"corrected_detector_evaluation_images\\\"] == 229\\n\",\"\\n\",\"assert verified_json[\\\"reproducibility_audit\\\"][\\\"passed\\\"] == 54\\n\",\"assert verified_json[\\\"reproducibility_audit\\\"][\\\"failed\\\"] == 0\\n\",\"\\n\",\"assert verified_json[\\\"identity_level_detector_directions\\\"][\\\"euclidean\\\"][\\\"increased\\\"] == 10\\n\",\"assert verified_json[\\\"identity_level_detector_directions\\\"][\\\"euclidean\\\"][\\\"decreased\\\"] == 3\\n\",\"\\n\",\"assert verified_json[\\\"identity_level_detector_directions\\\"][\\\"mahalanobis\\\"][\\\"increased\\\"] == 11\\n\",\"assert verified_json[\\\"identity_level_detector_directions\\\"][\\\"mahalanobis\\\"][\\\"decreased\\\"] == 2\\n\",\"\\n\",\"for detector in [\\\"Euclidean\\\", \\\"Mahalanobis\\\"]:\\n\",\"\\n\",\"    result = next(\\n\",\"        row for row in verified_json[\\\"detector_statistical_tests\\\"]\\n\",\"        if row[\\\"Detector\\\"] == detector\\n\",\"    )\\n\",\"\\n\",\"    assert np.isclose(\\n\",\"        result[\\\"P-value\\\"],\\n\",\"        expected_p_values[detector],\\n\",\"        atol=1e-6\\n\",\"    )\\n\",\"\\n\",\"    assert np.isclose(\\n\",\"        result[\\\"Wilcoxon Statistic\\\"],\\n\",\"        expected_wilcoxon[detector]\\n\",\"    )\\n\",\"\\n\",\"with open(report_path, \\\"r\\\", encoding=\\\"utf-8\\\") as file:\\n\",\"    verified_markdown = file.read()\\n\",\"\\n\",\"assert \\\"0.021484\\\" in verified_markdown\\n\",\"assert \\\"0.002441\\\" in verified_markdown\\n\",\"assert \\\"0.375732\\\" not in verified_markdown\\n\",\"assert \\\"0.057373\\\" not in verified_markdown\\n\",\"\\n\",\"print(\\\"\\\\nSection 13: Generated documentation verification passed.\\\")\\n\",\"\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 14. FINAL OUTPUT\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n\",\"print(\\\"STEP 17.10.6.5 — FINAL RESEARCH EVIDENCE PACKAGE\\\")\\n\",\"print(\\\"=\\\" * 80)\\n\",\"\\n\",\"print(\\\"\\\\nNEW DOCUMENTATION FILES CREATED:\\\")\\n\",\"\\n\",\"print(f\\\"\\\\n1. {report_path}\\\")\\n\",\"print(f\\\"   Size: {os.path.getsize(report_path):,} bytes\\\")\\n\",\"\\n\",\"print(f\\\"\\\\n2. {json_path}\\\")\\n\",\"print(f\\\"   Size: {os.path.getsize(json_path):,} bytes\\\")\\n\",\"\\n\",\"print(\\\"\\\\nEVIDENCE SUMMARY:\\\")\\n\",\"print(\\\"Historical paired images:\\\", paired_images)\\n\",\"print(\\\"Historical identities:\\\", identity_count)\\n\",\"print(\\\"Embedding dimension:\\\", embedding_dimension)\\n\",\"print(\\\"Largest identity share:\\\", f\\\"{largest_identity_share:.2%}\\\")\\n\",\"print(\\\"Corrected detector evaluation images: 229\\\")\\n\",\"\\n\",\"print(\\\"\\\\nCORRECTED DETECTOR RESULTS:\\\")\\n\",\"display(detector_tests_df)\\n\",\"\\n\",\"print(\\\"\\\\nCORRECTED IDENTITY-LEVEL DIRECTIONS:\\\")\\n\",\"print(identity_direction_summary)\\n\",\"\\n\",\"print(\\\"\\\\nDISPLACEMENT REPRODUCTION:\\\")\\n\",\"print(\\\"Low maximum error:\\\", low_max_error)\\n\",\"print(\\\"High maximum error:\\\", high_max_error)\\n\",\"\\n\",\"print(\\\"\\\\nPREVIOUS REPRODUCIBILITY AUDIT:\\\")\\n\",\"print(\\\"Checks passed: 54\\\")\\n\",\"print(\\\"Checks failed: 0\\\")\\n\",\"\\n\",\"print(\\\"\\\\nFINAL FILE VERIFICATION:\\\")\\n\",\"print(\\\"Markdown report: PASS\\\")\\n\",\"print(\\\"JSON serialization and reload: PASS\\\")\\n\",\"print(\\\"Corrected detector statistics: PASS\\\")\\n\",\"print(\\\"Corrected identity directions: PASS\\\")\\n\",\"print(\\\"Core evidence assertions: PASS\\\")\\n\",\"\\n\",\"print(\\\"\\\\nOriginal experiment archives were not modified.\\\")\\n\",\"print(\\\"No embedding extraction or model training performed.\\\")\\n\",\"print(\\\"No detector calibration or statistical tests rerun.\\\")\\n\",\"\\n\",\"print(\\\"\\\\nSTEP 17.10.6.5 COMPLETED\\\")\\n\",\"print(\\\"=\\\" * 80)\\n\",\"\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 142\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"\\n\",\"# ============================================================\\n\",\"# STEP 2 — CREATE EXPERIMENT 18 ZIP ARCHIVE\\n\",\"# ============================================================\\n\",\"\\n\",\"import os\\n\",\"import zipfile\\n\",\"\\n\",\"RESULTS_DIR = \\\"/content/drive/MyDrive/Experiment_18_Results\\\"\\n\",\"\\n\",\"ZIP_PATH = os.path.join(\\n\",\"    RESULTS_DIR,\\n\",\"    \\\"Experiment_18_Final_Research_Package.zip\\\"\\n\",\")\\n\",\"\\n\",\"FILES_TO_PACKAGE = [\\n\",\"    \\\"experiment18_facenet_lfw_embeddings.npz\\\",\\n\",\"    \\\"experiment18_final_research_evidence.json\\\",\\n\",\"    \\\"experiment18_final_research_evidence.md\\\",\\n\",\"    \\\"experiment18_illumination_results.npz\\\",\\n\",\"    \\\"illumination_identity_summary.csv\\\",\\n\",\"    \\\"illumination_metadata.json\\\"\\n\",\"]\\n\",\"\\n\",\"# Verify all six source files exist\\n\",\"missing = [\\n\",\"    filename\\n\",\"    for filename in FILES_TO_PACKAGE\\n\",\"    if not os.path.isfile(os.path.join(RESULTS_DIR, filename))\\n\",\"]\\n\",\"\\n\",\"if missing:\\n\",\"    raise FileNotFoundError(\\n\",\"        \\\"Cannot create ZIP. Missing files:\\\\n\\\" + \\\"\\\\n\\\".join(missing)\\n\",\"    )\\n\",\"\\n\",\"# Create ZIP without modifying source files\\n\",\"with zipfile.ZipFile(\\n\",\"    ZIP_PATH,\\n\",\"    mode=\\\"w\\\",\\n\",\"    compression=zipfile.ZIP_DEFLATED\\n\",\") as zip_file:\\n\",\"\\n\",\"    for filename in FILES_TO_PACKAGE:\\n\",\"        source_path = os.path.join(RESULTS_DIR, filename)\\n\",\"\\n\",\"        zip_file.write(\\n\",\"            source_path,\\n\",\"            arcname=filename\\n\",\"        )\\n\",\"\\n\",\"# Verify ZIP contents\\n\",\"with zipfile.ZipFile(ZIP_PATH, \\\"r\\\") as zip_file:\\n\",\"\\n\",\"    archived_files = sorted(zip_file.namelist())\\n\",\"    expected_files = sorted(FILES_TO_PACKAGE)\\n\",\"\\n\",\"    assert archived_files == expected_files\\n\",\"\\n\",\"    bad_file = zip_file.testzip()\\n\",\"\\n\",\"    if bad_file is not None:\\n\",\"        raise RuntimeError(\\n\",\"            f\\\"ZIP integrity check failed: {bad_file}\\\"\\n\",\"        )\\n\",\"\\n\",\"print(\\\"=\\\" * 65)\\n\",\"print(\\\"EXPERIMENT 18 ZIP CREATION\\\")\\n\",\"print(\\\"=\\\" * 65)\\n\",\"\\n\",\"print(f\\\"\\\\nZIP file: {ZIP_PATH}\\\")\\n\",\"print(f\\\"ZIP size: {os.path.getsize(ZIP_PATH):,} bytes\\\")\\n\",\"print(f\\\"Files packaged: {len(archived_files)}\\\")\\n\",\"\\n\",\"for filename in archived_files:\\n\",\"    print(f\\\"PASS: {filename}\\\")\\n\",\"\\n\",\"print(\\\"\\\\nZIP integrity test: PASSED\\\")\\n\",\"print(\\\"Original source files: UNMODIFIED\\\")\\n\",\"print(\\\"\\\\nSTEP 2 COMPLETED\\\")\\n\",\"print(\\\"=\\\" * 65)\\n\",\"\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 143\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"\\n\",\"# ============================================================\\n\",\"# STEP 3 — GITHUB REPOSITORY CONNECTION AND INSPECTION\\n\",\"# Corrected repository owner\\n\",\"# ============================================================\\n\",\"\\n\",\"import os\\n\",\"import subprocess\\n\",\"\\n\",\"REPO_URL = (\\n\",\"    \\\"https://github.com/12998951/\\\"\\n\",\"    \\\"Real-Time-Embedding-Level-Drift-Detection.git\\\"\\n\",\")\\n\",\"\\n\",\"REPO_DIR = \\\"/content/Real-Time-Embedding-Level-Drift-Detection\\\"\\n\",\"\\n\",\"print(\\\"=\\\" * 70)\\n\",\"print(\\\"STEP 3 — GITHUB REPOSITORY CONNECTION\\\")\\n\",\"print(\\\"=\\\" * 70)\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 1. CLONE OR VERIFY EXISTING REPOSITORY\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"if os.path.isdir(os.path.join(REPO_DIR, \\\".git\\\")):\\n\",\"\\n\",\"    print(\\\"\\\\nExisting Git repository detected.\\\")\\n\",\"\\n\",\"    os.chdir(REPO_DIR)\\n\",\"\\n\",\"    remote_result = subprocess.run(\\n\",\"        [\\\"git\\\", \\\"remote\\\", \\\"get-url\\\", \\\"origin\\\"],\\n\",\"        capture_output=True,\\n\",\"        text=True\\n\",\"    )\\n\",\"\\n\",\"    if remote_result.returncode != 0:\\n\",\"        raise RuntimeError(\\n\",\"            \\\"Could not identify the existing origin remote.\\\"\\n\",\"        )\\n\",\"\\n\",\"    existing_remote = remote_result.stdout.strip()\\n\",\"\\n\",\"    if existing_remote.rstrip(\\\"/\\\") != REPO_URL.rstrip(\\\"/\\\"):\\n\",\"        raise RuntimeError(\\n\",\"            \\\"Existing repository has a different origin URL.\\\\n\\\"\\n\",\"            f\\\"Found: {existing_remote}\\\\n\\\"\\n\",\"            f\\\"Expected: {REPO_URL}\\\\n\\\"\\n\",\"            \\\"Stop and inspect before changing the remote.\\\"\\n\",\"        )\\n\",\"\\n\",\"    print(\\\"Existing repository origin verified.\\\")\\n\",\"\\n\",\"else:\\n\",\"\\n\",\"    if os.path.exists(REPO_DIR):\\n\",\"        raise RuntimeError(\\n\",\"            \\\"Repository directory exists but is not a Git repository. \\\"\\n\",\"            \\\"Do not delete it automatically. Inspect it first.\\\"\\n\",\"        )\\n\",\"\\n\",\"    print(\\\"\\\\nCloning the correct repository...\\\")\\n\",\"\\n\",\"    clone_result = subprocess.run(\\n\",\"        [\\\"git\\\", \\\"clone\\\", REPO_URL, REPO_DIR],\\n\",\"        capture_output=True,\\n\",\"        text=True\\n\",\"    )\\n\",\"\\n\",\"    if clone_result.stdout:\\n\",\"        print(clone_result.stdout)\\n\",\"\\n\",\"    if clone_result.returncode != 0:\\n\",\"        print(\\\"\\\\nGIT CLONE ERROR:\\\")\\n\",\"        print(clone_result.stderr)\\n\",\"\\n\",\"        raise RuntimeError(\\n\",\"            \\\"Git clone failed. Stop here and inspect the error.\\\"\\n\",\"        )\\n\",\"\\n\",\"    print(\\\"Repository cloned successfully.\\\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 2. ENTER REPOSITORY\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"os.chdir(REPO_DIR)\\n\",\"\\n\",\"print(\\\"\\\\nRepository location:\\\")\\n\",\"print(os.getcwd())\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 3. CHECK CURRENT BRANCH\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"branch_result = subprocess.run(\\n\",\"    [\\\"git\\\", \\\"branch\\\", \\\"--show-current\\\"],\\n\",\"    capture_output=True,\\n\",\"    text=True,\\n\",\"    check=True\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\nCurrent branch:\\\")\\n\",\"print(branch_result.stdout.strip())\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 4. VERIFY REMOTE\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\nRemote repository:\\\")\\n\",\"\\n\",\"subprocess.run(\\n\",\"    [\\\"git\\\", \\\"remote\\\", \\\"-v\\\"],\\n\",\"    check=True\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 5. RECENT COMMIT HISTORY\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\nRecent commits:\\\")\\n\",\"\\n\",\"subprocess.run(\\n\",\"    [\\\"git\\\", \\\"log\\\", \\\"-5\\\", \\\"--oneline\\\"],\\n\",\"    check=True\\n\",\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 6. EXISTING EXPERIMENT FOLDERS\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\nExisting repository folders:\\\")\\n\",\"\\n\",\"for folder in [\\\"experiments\\\", \\\"results\\\"]:\\n\",\"\\n\",\"    folder_path = os.path.join(REPO_DIR, folder)\\n\",\"\\n\",\"    if os.path.isdir(folder_path):\\n\",\"\\n\",\"        print(f\\\"\\\\n{folder}/\\\")\\n\",\"\\n\",\"        for filename in sorted(os.listdir(folder_path)):\\n\",\"            print(\\\"  \\\", filename)\\n\",\"\\n\",\"    else:\\n\",\"        print(f\\\"\\\\n{folder}/ does not exist.\\\")\\n\",\"\\n\",\"# ------------------------------------------------------------\\n\",\"# 7. GIT WORKING TREE STATUS\\n\",\"# ------------------------------------------------------------\\n\",\"\\n\",\"print(\\\"\\\\nGit working tree status:\\\")\\n\",\"\\n\",\"subprocess.run(\\n\",\"    [\\\"git\\\", \\\"status\\\", \\\"--short\\\"],\\n\",\"    check=True\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 70)\\n\",\"print(\\\"STEP 3 — REPOSITORY INSPECTION COMPLETED\\\")\\n\",\"print(\\\"=\\\" * 70)\\n\",\"\\n\",\"print(\\\"No files uploaded.\\\")\\n\",\"print(\\\"No commits created.\\\")\\n\",\"print(\\\"No push performed.\\\")\\n\",\"\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 144\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"\\n\",\"import os\\n\",\"import subprocess\\n\",\"\\n\",\"REPO_DIR = \\\"/content/Real-Time-Embedding-Level-Drift-Detection\\\"\\n\",\"\\n\",\"os.chdir(REPO_DIR)\\n\",\"\\n\",\"commands = {\\n\",\"    \\\"Repository root\\\": [\\\"git\\\", \\\"rev-parse\\\", \\\"--show-toplevel\\\"],\\n\",\"    \\\"Git directory\\\": [\\\"git\\\", \\\"rev-parse\\\", \\\"--git-dir\\\"],\\n\",\"    \\\"Remote configuration\\\": [\\\"git\\\", \\\"remote\\\", \\\"-v\\\"],\\n\",\"    \\\"Origin URL\\\": [\\\"git\\\", \\\"remote\\\", \\\"get-url\\\", \\\"origin\\\"],\\n\",\"    \\\"Current branch\\\": [\\\"git\\\", \\\"branch\\\", \\\"--show-current\\\"],\\n\",\"    \\\"All branches\\\": [\\\"git\\\", \\\"branch\\\", \\\"-a\\\"],\\n\",\"    \\\"Latest commit\\\": [\\\"git\\\", \\\"log\\\", \\\"-1\\\", \\\"--oneline\\\"],\\n\",\"    \\\"Commit count\\\": [\\\"git\\\", \\\"rev-list\\\", \\\"--count\\\", \\\"HEAD\\\"],\\n\",\"    \\\"Working tree\\\": [\\\"git\\\", \\\"status\\\", \\\"--short\\\"],\\n\",\"    \\\"Tracked file count\\\": [\\\"git\\\", \\\"ls-files\\\"]\\n\",\"}\\n\",\"\\n\",\"print(\\\"=\\\" * 70)\\n\",\"print(\\\"STEP 3.1 — GIT REPOSITORY DIAGNOSTIC\\\")\\n\",\"print(\\\"=\\\" * 70)\\n\",\"\\n\",\"for label, command in commands.items():\\n\",\"\\n\",\"    result = subprocess.run(\\n\",\"        command,\\n\",\"        capture_output=True,\\n\",\"        text=True\\n\",\"    )\\n\",\"\\n\",\"    print(f\\\"\\\\n--- {label} ---\\\")\\n\",\"    print(\\\"Exit code:\\\", result.returncode)\\n\",\"    print(\\\"Output:\\\", result.stdout.strip() or \\\"[EMPTY]\\\")\\n\",\"\\n\",\"    if result.stderr.strip():\\n\",\"        print(\\\"Error:\\\", result.stderr.strip())\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 70)\\n\",\"print(\\\"DIAGNOSTIC COMPLETED\\\")\\n\",\"print(\\\"=\\\" * 70)\\n\",\"\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 145\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"\\n\",\"import os\\n\",\"import subprocess\\n\",\"\\n\",\"REPO_DIR = \\\"/content/Real-Time-Embedding-Level-Drift-Detection\\\"\\n\",\"\\n\",\"os.chdir(REPO_DIR)\\n\",\"\\n\",\"print(\\\"=\\\" * 70)\\n\",\"print(\\\"STEP 3.2 — STAGED FILE VERIFICATION\\\")\\n\",\"print(\\\"=\\\" * 70)\\n\",\"\\n\",\"print(\\\"\\\\n[1] Staged file summary\\\")\\n\",\"\\n\",\"subprocess.run(\\n\",\"    [\\\"git\\\", \\\"diff\\\", \\\"--cached\\\", \\\"--stat\\\"],\\n\",\"    check=True\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n[2] Staged file names\\\")\\n\",\"\\n\",\"subprocess.run(\\n\",\"    [\\\"git\\\", \\\"diff\\\", \\\"--cached\\\", \\\"--name-status\\\"],\\n\",\"    check=True\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n[3] Staged file sizes\\\")\\n\",\"\\n\",\"result = subprocess.run(\\n\",\"    [\\\"git\\\", \\\"diff\\\", \\\"--cached\\\", \\\"--name-only\\\"],\\n\",\"    capture_output=True,\\n\",\"    text=True,\\n\",\"    check=True\\n\",\")\\n\",\"\\n\",\"for filename in result.stdout.splitlines():\\n\",\"\\n\",\"    path = os.path.join(REPO_DIR, filename)\\n\",\"\\n\",\"    if os.path.isfile(path):\\n\",\"        print(f\\\"{filename} | {os.path.getsize(path):,} bytes\\\")\\n\",\"    else:\\n\",\"        print(f\\\"WARNING: File not found: {filename}\\\")\\n\",\"\\n\",\"print(\\\"\\\\n[4] Confirm no unstaged modifications\\\")\\n\",\"\\n\",\"subprocess.run(\\n\",\"    [\\\"git\\\", \\\"diff\\\", \\\"--stat\\\"],\\n\",\"    check=True\\n\",\")\\n\",\"\\n\",\"print(\\\"\\\\n\\\" + \\\"=\\\" * 70)\\n\",\"print(\\\"STEP 3.2 COMPLETED — INSPECTION ONLY\\\")\\n\",\"print(\\\"=\\\" * 70)\\n\",\"\\n\",\"print(\\\"No commit created.\\\")\\n\",\"print(\\\"No push performed.\\\")\\n\",\"\\n\",\"\\n\",\"===========================================================================\\n\",\"CELL INDEX: 146\\n\",\"CELL TYPE: code\\n\",\"MATCHED TERMS: ['embedding']\\n\",\"---------------------------------------------------------------------------\\n\",\"\\n\",\"import os\\n\",\"import hashlib\\n\",\"import subprocess\\n\",\"import zipfile\\n\",\"\\n\",\"DRIVE_DIR = \\\"/content/drive/MyDrive/Experiment_18_Results\\\"\\n\",\"REPO_DIR = \\\"/content/Real-Time-Embedding-Level-Drift-Detection\\\"\\n\",\"REPO_RESULTS = os.path.join(REPO_DIR, \\\"results\\\")\\n\",\"\\n\",\"FILES = [\\n\",\"    \\\"Experiment_18_Final_Research_Package.zip\\\",\\n\",\"    \\\"experiment18_facenet_lfw_embeddings.