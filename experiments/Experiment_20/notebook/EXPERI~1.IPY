        "\n",
        "from pathlib import Path\n",
        "import hashlib\n",
        "import re\n",
        "import json\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "# ============================================================\n",
        "# EXPERIMENT 20 — PHASE 4.5\n",
        "# CONTROLLED MANUSCRIPT AMENDMENT\n",
        "# Creates a separate amended copy. Never overwrites frozen V2.\n",
        "# ============================================================\n",
        "\n",
        "SOURCE = Path(\n",
        "    \"/content/drive/MyDrive/Experiment_20_Results/\"\n",
        "    \"step_3_3/step_3330/experiment20_integrated_manuscript_v2.md\"\n",
        ")\n",
        "\n",
        "OUTPUT_DIR = Path(\n",
        "    \"/content/drive/MyDrive/Experiment_20_Results/\"\n",
        "    \"step_4_5_statistical_methodology_audit\"\n",
        ")\n",
        "\n",
        "OUTPUT = OUTPUT_DIR / \"experiment20_integrated_manuscript_v2_phase45_amended.md\"\n",
        "RECORD = OUTPUT_DIR / \"experiment20_phase45_manuscript_amendment_record.json\"\n",
        "\n",
        "EXPECTED_SOURCE_SHA256 = (\n",
        "    \"2cc4156af63987fae717c37e997e6478e4253d81f584854fb5fab9f18da5e752\"\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# APPROVED ADDITIONS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "ADDITIONS = [\n",
        "    {\n",
        "        \"section\": \"2.8 Statistical Analysis\",\n",
        "        \"anchor\": \"Pairwise differences between illumination geometry groups were examined using Wilcoxon signed-rank tests\",\n",
        "        \"text\": (\n",
        "            \"As a sensitivity analysis, exact two-sided paired sign tests were additionally \"\n",
        "            \"conducted on the identity-level mean differences for each of the six primary \"\n",
        "            \"pairwise comparisons. The sign tests evaluated whether the direction of the \"\n",
        "            \"paired differences was consistently positive or negative across identities, \"\n",
        "            \"without relying on the symmetry assumption associated with the Wilcoxon \"\n",
        "            \"signed-rank test. Tied differences, if present, were excluded from the sign-test \"\n",
        "            \"calculation. Holm's step-down correction was applied across the same combined \"\n",
        "            \"family of six primary sign tests. These analyses were used to assess the \"\n",
        "            \"robustness of the directional findings and did not replace the primary \"\n",
        "            \"Wilcoxon signed-rank tests.\"\n",
        "        )\n",
        "    },\n",
        "    {\n",
        "        \"section\": \"2.9 Exploratory Hemisphere-Based Analysis\",\n",
        "        \"anchor\": \"For each identity, mean Euclidean displacement and mean cosine distance were calculated separately\",\n",
        "        \"text\": (\n",
        "            \"As an additional sensitivity analysis, exact two-sided paired sign tests were \"\n",
        "            \"performed separately for Euclidean displacement and cosine distance using the \"\n",
        "            \"identity-level differences between beyond-frontal and frontal conditions. Holm \"\n",
        "            \"correction was applied across these two hemisphere sign tests as a separate \"\n",
        "            \"exploratory correction family. This correction family was kept separate from \"\n",
        "            \"the six primary illumination-geometry comparisons because the hemisphere \"\n",
        "            \"analysis was secondary and exploratory.\"\n",
        "        )\n",
        "    },\n",
        "    {\n",
        "        \"section\": \"3.4 Identity-level repeated-measures analysis\",\n",
        "        \"anchor\": \"Pairwise identity-level comparisons used Wilcoxon signed-rank tests.\",\n",
        "        \"text\": (\n",
        "            \"In the sign-test sensitivity analysis, all 38 identities showed positive paired \"\n",
        "            \"differences for each of the six primary comparisons, with no negative differences \"\n",
        "            \"or ties. The exact two-sided sign-test p-value was 7.276 × 10⁻¹² for each \"\n",
        "            \"comparison. Following Holm correction across the six-test family, all adjusted \"\n",
        "            \"p-values were 4.366 × 10⁻¹¹. This consistent direction of differences provides \"\n",
        "            \"sensitivity evidence supporting the ordering observed in the primary \"\n",
        "            \"Wilcoxon analysis.\"\n",
        "        )\n",
        "    },\n",
        "    {\n",
        "        \"section\": \"3.5 Exploratory frontal and beyond-frontal comparison\",\n",
        "        \"anchor\": \"For cosine distance, the corresponding means were\",\n",
        "        \"text\": (\n",
        "            \"In the exploratory hemisphere sign-test sensitivity analysis, all 38 identities \"\n",
        "            \"showed positive differences between beyond-frontal and frontal conditions for \"\n",
        "            \"both Euclidean displacement and cosine distance, with no negative differences \"\n",
        "            \"or ties. The exact two-sided sign-test p-value was 7.276 × 10⁻¹² for each \"\n",
        "            \"metric. Following Holm correction across the separate two-test hemisphere \"\n",
        "            \"family, both adjusted p-values were 1.455 × 10⁻¹¹. These results provide \"\n",
        "            \"additional evidence of directional consistency but do not establish an \"\n",
        "            \"independent or causal hemisphere effect.\"\n",
        "        )\n",
        "    }\n",
        "]\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# HELPERS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def sha256(path):\n",
        "    h = hashlib.sha256()\n",
        "    with path.open(\"rb\") as f:\n",
        "        for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n",
        "            h.update(chunk)\n",
        "    return h.hexdigest()\n",
        "\n",
        "def find_section_bounds(lines, section_title):\n",
        "    expected_heading = \"## \" + section_title\n",
        "\n",
        "    matches = [\n",
        "        i for i, line in enumerate(lines)\n",
        "        if line.strip() == expected_heading\n",
        "    ]\n",
        "\n",
        "    if len(matches) != 1:\n",
        "        raise RuntimeError(\n",
        "            f\"Expected exactly one heading '{expected_heading}', \"\n",
        "            f\"found {len(matches)}.\"\n",
        "        )\n",
        "\n",
        "    start = matches[0]\n",
        "    end = len(lines)\n",
        "\n",
        "    for i in range(start + 1, len(lines)):\n",
        "        match = re.match(r\"^\\s{0,3}(#{1,6})\\s+\", lines[i])\n",
        "        if match and len(match.group(1)) <= 2:\n",
        "            end = i\n",
        "            break\n",
        "\n",
        "    return start, end\n",
        "\n",
        "def insert_after_anchor_paragraph(lines, item):\n",
        "    section_start, section_end = find_section_bounds(\n",
        "        lines, item[\"section\"]\n",
        "    )\n",
        "\n",
        "    matches = [\n",
        "        i for i in range(section_start + 1, section_end)\n",
        "        if item[\"anchor\"] in lines[i]\n",
        "    ]\n",
        "\n",
        "    if len(matches) != 1:\n",
        "        raise RuntimeError(\n",
        "            f\"Section '{item['section']}': expected one anchor match, \"\n",
        "            f\"found {len(matches)} for: {item['anchor']}\"\n",
        "        )\n",
        "\n",
        "    anchor_index = matches[0]\n",
        "\n",
        "    # Find the end of the paragraph containing the anchor.\n",
        "    paragraph_end = anchor_index + 1\n",
        "\n",
        "    while paragraph_end < section_end:\n",
        "        if not lines[paragraph_end].strip():\n",
        "            break\n",
        "        if re.match(r\"^\\s{0,3}#{1,6}\\s+\", lines[paragraph_end]):\n",
        "            break\n",
        "        paragraph_end += 1\n",
        "\n",
        "    # Prevent accidental duplicate insertion.\n",
        "    if item[\"text\"] in \"\\n\".join(lines):\n",
        "        raise RuntimeError(\n",
        "            f\"Addition already exists; refusing duplicate insertion: \"\n",
        "            f\"{item['section']}\"\n",
        "        )\n",
        "\n",
        "    lines.insert(paragraph_end, item[\"text\"])\n",
        "\n",
        "    return {\n",
        "        \"section\": item[\"section\"],\n",
        "        \"anchor_line_before_insertion\": anchor_index + 1,\n",
        "        \"inserted_line\": paragraph_end + 1\n",
        "    }\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. INPUT INTEGRITY AND OUTPUT SAFETY\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"=\" * 78)\n",
        "print(\"EXPERIMENT 20 — CONTROLLED PHASE 4.5 MANUSCRIPT AMENDMENT\")\n",
        "print(\"=\" * 78)\n",
        "\n",
        "if not SOURCE.exists():\n",
        "    raise FileNotFoundError(f\"Source manuscript not found: {SOURCE}\")\n",
        "\n",
        "OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "if OUTPUT.exists() or RECORD.exists():\n",
        "    raise FileExistsError(\n",
        "        \"Output manuscript or amendment record already exists. \"\n",
        "        \"No existing file will be overwritten. Inspect the existing \"\n",
        "        \"outputs before choosing a new filename.\"\n",
        "    )\n",
        "\n",
        "source_hash_before = sha256(SOURCE)\n",
        "\n",
        "print(\"\\n1. SOURCE INTEGRITY\")\n",
        "print(\"Source:\", SOURCE)\n",
        "print(\"Expected SHA256:\", EXPECTED_SOURCE_SHA256)\n",
        "print(\"Actual SHA256:  \", source_hash_before)\n",
        "\n",
        "if source_hash_before != EXPECTED_SOURCE_SHA256:\n",
        "    raise RuntimeError(\n",
        "        \"STOP: Source manuscript does not match frozen V2. \"\n",
        "        \"No amendment was created.\"\n",
        "    )\n",
        "\n",
        "print(\"PASS: Frozen source manuscript verified.\")\n",
        "\n",
        "original_bytes = SOURCE.read_bytes()\n",
        "original_text = original_bytes.decode(\"utf-8\")\n",
        "lines = original_text.splitlines()\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. INSERT FOUR APPROVED ADDITIONS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n2. INSERTING APPROVED ADDITIONS\")\n",
        "\n",
        "insertion_log = []\n",
        "\n",
        "for item in ADDITIONS:\n",
        "    result = insert_after_anchor_paragraph(lines, item)\n",
        "    insertion_log.append(result)\n",
        "    print(\n",
        "        \"PASS:\",\n",
        "        item[\"section\"],\n",
        "        \"| inserted at line\",\n",
        "        result[\"inserted_line\"]\n",
        "    )\n",
        "\n",
        "amended_text = \"\\n\".join(lines) + \"\\n\"\n",
        "amended_bytes = amended_text.encode(\"utf-8\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. VERIFY ORIGINAL TEXT PRESERVATION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n3. ORIGINAL TEXT PRESERVATION\")\n",
        "\n",
        "# Removing the four inserted paragraphs must recover the original\n",
        "# manuscript text, modulo the original terminal newline.\n",
        "recovered = amended_text\n",
        "\n",
        "for item in ADDITIONS:\n",
        "    recovered = recovered.replace(item[\"text\"] + \"\\n\", \"\", 1)\n",
        "\n",
        "recovered_bytes = recovered.encode(\"utf-8\")\n",
        "\n",
        "# splitlines/join normalises line endings. Compare normalised text.\n",
        "original_normalised = original_text.rstrip(\"\\n\")\n",
        "recovered_normalised = recovered.rstrip(\"\\n\")\n",
        "\n",
        "if original_normalised != recovered_normalised:\n",
        "    raise RuntimeError(\n",
        "        \"STOP: Original manuscript text was not preserved exactly \"\n",
        "        \"after removing the four approved additions.\"\n",
        "    )\n",
        "\n",
        "print(\"PASS: All original manuscript text retained.\")\n",
        "print(\"PASS: Exactly four approved paragraphs inserted.\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. VERIFY EACH ADDITION AND ITS LOCATION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n4. INSERTION VERIFICATION\")\n",
        "\n",
        "for item in ADDITIONS:\n",
        "    occurrences = amended_text.count(item[\"text\"])\n",
        "    if occurrences != 1:\n",
        "        raise RuntimeError(\n",
        "            f\"Verification failed: addition occurs {occurrences} times \"\n",
        "            f\"in section {item['section']}.\"\n",
        "        )\n",
        "\n",
        "    section_start, section_end = find_section_bounds(\n",
        "        lines, item[\"section\"]\n",
        "    )\n",
        "    section_text = \"\\n\".join(lines[section_start:section_end])\n",
        "\n",
        "    if item[\"text\"] not in section_text:\n",
        "        raise RuntimeError(\n",
        "            f\"Addition not found in intended section: {item['section']}\"\n",
        "        )\n",
        "\n",
        "    print(\"PASS:\", item[\"section\"])\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. WRITE SEPARATE AMENDED MANUSCRIPT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "with OUTPUT.open(\"xb\") as f:\n",
        "    f.write(amended_bytes)\n",
        "\n",
        "output_hash = sha256(OUTPUT)\n",
        "\n",
        "print(\"\\n5. NEW MANUSCRIPT\")\n",
        "print(\"Saved:\", OUTPUT)\n",
        "print(\"New SHA256:\", output_hash)\n",
        "print(\"File size:\", OUTPUT.stat().st_size, \"bytes\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. PRESERVATION CHECK — ORIGINAL FILE\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "source_hash_after = sha256(SOURCE)\n",
        "\n",
        "print(\"\\n6. ORIGINAL FROZEN MANUSCRIPT PRESERVATION\")\n",
        "print(\"Original SHA before:\", source_hash_before)\n",
        "print(\"Original SHA after: \", source_hash_after)\n",
        "\n",
        "if source_hash_after != EXPECTED_SOURCE_SHA256:\n",
        "    raise RuntimeError(\n",
        "        \"CRITICAL: Original frozen manuscript hash changed.\"\n",
        "    )\n",
        "\n",
        "print(\"PASS: Original frozen manuscript unchanged.\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. WRITE AMENDMENT RECORD\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "record = {\n",
        "    \"experiment\": \"Experiment 20\",\n",
        "    \"phase\": \"4.5\",\n",
        "    \"record_type\": \"controlled_manuscript_amendment\",\n",
        "    \"status\": \"AMENDED_COPY_CREATED_AND_VERIFIED\",\n",
        "    \"timestamp_utc\": datetime.now(timezone.utc).isoformat(),\n",
        "    \"source_manuscript\": str(SOURCE),\n",
        "    \"source_sha256_before\": source_hash_before,\n",
        "    \"source_sha256_after\": source_hash_after,\n",
        "    \"source_frozen_hash_expected\": EXPECTED_SOURCE_SHA256,\n",
        "    \"amended_manuscript\": str(OUTPUT),\n",
        "    \"amended_manuscript_sha256\": output_hash,\n",
        "    \"insertions\": insertion_log,\n",
        "    \"approved_addition_count\": len(ADDITIONS),\n",
        "    \"original_text_preserved\": True,\n",
        "    \"original_manuscript_modified\": False,\n",
        "    \"frozen_csv_modified\": False,\n",
        "    \"existing_phase45_audit_modified\": False\n",
        "}\n",
        "\n",
        "with RECORD.open(\"x\", encoding=\"utf-8\") as f:\n",
        "    json.dump(record, f, indent=2, ensure_ascii=False)\n",
        "\n",
        "record_hash = sha256(RECORD)\n",
        "\n",
        "print(\"\\n7. AMENDMENT RECORD\")\n",
        "print(\"Saved:\", RECORD)\n",
        "print(\"Record SHA256:\", record_hash)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 8. FINAL STATUS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 78)\n",
        "print(\"FINAL VERIFICATION\")\n",
        "print(\"=\" * 78)\n",
        "\n",
        "checks = {\n",
        "    \"frozen_source_hash_matches\": source_hash_before == EXPECTED_SOURCE_SHA256,\n",
        "    \"original_manuscript_unchanged\": source_hash_after == EXPECTED_SOURCE_SHA256,\n",
        "    \"four_additions_inserted\": len(ADDITIONS) == 4,\n",
        "    \"all_additions_verified_once\": all(\n",
        "        amended_text.count(item[\"text\"]) == 1 for item in ADDITIONS\n",
        "    ),\n",
        "    \"original_text_preserved\": (\n",
        "        original_normalised == recovered_normalised\n",
        "    ),\n",
        "    \"amended_copy_exists\": OUTPUT.exists(),\n",
        "    \"amendment_record_exists\": RECORD.exists()\n",
        "}\n",
        "\n",
        "for name, passed in checks.items():\n",
        "    print((\"PASS\" if passed else \"FAIL\"), name)\n",
        "\n",
        "failed = [name for name, passed in checks.items() if not passed]\n",
        "\n",
        "if failed:\n",
        "    print(\"\\nFAILED CHECKS:\", failed)\n",
        "    raise RuntimeError(\"Amendment verification did not pass.\")\n",
        "\n",
        "print(\"\\nFINAL STATUS: PHASE_4_5_MANUSCRIPT_AMENDMENT_CREATED\")\n",
        "print(\"Original V2 remains frozen and unchanged.\")\n",
        "print(\"Amended manuscript is a separate file.\")\n",
        "print(\"No frozen CSV or prior audit report was modified.\")\n"
      ],
