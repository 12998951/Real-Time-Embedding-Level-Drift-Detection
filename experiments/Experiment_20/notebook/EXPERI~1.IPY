        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. CHECK FOR POTENTIAL OVERCLAIM LANGUAGE\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "overclaim_patterns = {\n",
        "    \"proves\": r\"\\bproves?\\b\",\n",
        "    \"guarantees\": r\"\\bguarantees?\\b\",\n",
        "    \"solves_all\": r\"\\bsolves all\\b\",\n",
        "    \"deployment_ready\": r\"\\bdeployment[- ]ready\\b\",\n",
        "    \"perfect_accuracy\": r\"\\bperfect accuracy\\b\",\n",
        "    \"caused_by\": r\"\\bcaused by\\b\",\n",
        "    \"universally_generalises\": (\n",
        "        r\"\\buniversally generalis(?:es|ed|ation)\\b\"\n",
        "    )\n",
        "}\n",
        "\n",
        "overclaim_scan = {}\n",
        "\n",
        "for label, pattern in overclaim_patterns.items():\n",
        "    matches = re.findall(\n",
        "        pattern,\n",
        "        discussion,\n",
        "        flags=re.I\n",
        "    )\n",
        "\n",
        "    overclaim_scan[label] = {\n",
        "        \"count\": len(matches)\n",
