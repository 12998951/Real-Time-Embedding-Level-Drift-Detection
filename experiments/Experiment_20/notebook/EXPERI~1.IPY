=1, keepdims=True\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 275,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"alignment\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"recovered_float = np.asarray(recovered, dtype=np.float64)\\\\n\\\\n# Calculate differences after image-level alignment.\\\\nembedding_difference = recovered_float - fresh_aligned\\\\nrow_l2_difference = np.linalg.norm(\\\"\\n\",\"        }\\n\",\"      ]\\n\",\"    },\\n\",\"    {\\n\",\"      \\\"path\\\": \\\"/content/drive/MyDrive/Colab Notebooks/Experiment_16_Cross_Condition_Calibration_Transfer.ipynb\\\",\\n\",\"      \\\"experiment18_reference\\\": false,\\n\",\"      \\\"evidence\\\": [\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 1,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"embedding_dimension\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"    \\\\\\\"random_seed\\\\\\\": 202616,\\\\n    \\\\\\\"n_seeds\\\\\\\": 20,\\\\n    \\\\\\\"embedding_dimension\\\\\\\": 64,\\\\n    \\\\\\\"window_size\\\\\\\": 20,\\\\n    \\\\\\\"reference_samples\\\\\\\": 1000,\\\\n    \\\\\\\"calibration_windows\\\\\\\": 200,\\\\nprint(\\\\\\\"Results directory:\\\\\\\", RESULTS_DIR)\\\\nprint(\\\\\\\"Seeds:\\\\\\\", CONFIG[\\\\\\\"n_seeds\\\\\\\"])\\\\nprint(\\\\\\\"Embedding dimension:\\\\\\\", CONFIG[\\\\\\\"embedding_dimension\\\\\\\"])\\\\nprint(\\\\\\\"Conditions:\\\\\\\", CONFIG[\\\\\\\"conditions\\\\\\\"])\\\\nprint(\\\\\\\"Detectors:\\\\\\\", CONFIG[\\\\\\\"detectors\\\\\\\"])\\\\nprint(\\\\\\\"Target false-alarm rate:\\\\\\\", CONFIG[\\\\\\\"target_false_alarm_rate\\\\\\\"])\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 3,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"embedding_dimension\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"import pandas as pd\\\\n\\\\nD = CONFIG[\\\\\\\"embedding_dimension\\\\\\\"]\\\\nrho = CONFIG[\\\\\\\"correlation_strength\\\\\\\"]\\\\n# 1. Isotropic covariance\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 5,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"embedding_dimension\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"\\\\nn_reference = CONFIG[\\\\\\\"reference_samples\\\\\\\"]\\\\nD = CONFIG[\\\\\\\"embedding_dimension\\\\\\\"]\\\\nfor seed in range(CONFIG[\\\\\\\"random_seed\\\\\\\"], CONFIG[\\\\\\\"random_seed\\\\\\\"] + CONFIG[\\\\\\\"n_seeds\\\\\\\"]):\\\\n    for condition, covariance in COVARIANCE_MATRICES.items():\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 22,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"Normalize\\\",\\n\",\"            \\\"embedding_dimension\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"            \\\\\\\"n_control_windows\\\\\\\": len(control_means),\\\\n            \\\\\\\"n_drift_windows\\\\\\\": len(drift_means),\\\\n            \\\\\\\"embedding_dimension\\\\\\\": D,\\\\n            \\\\\\\"window_size\\\\\\\": window_size,\\\\n            \\\\\\\"mean_shift_strength\\\\\\\": shift_strength,\\\\n            \\\\\\\"control_all_finite\\\\\\\": bool(np.isfinite(control_means).all()),\\\\n\\\\nprint(\\\\n    \\\\\\\"All drift directions normalized:\\\\\\\",\\\\n    all(\\\\n        np.isclose(np.linalg.norm(x), 1.0)\\\\n        for x in SHARED_DRIFT_DIRECTIONS.values()\\\"\\n\",\"        }\\n\",\"      ]\\n\",\"    },\\n\",\"    {\\n\",\"      \\\"path\\\": \\\"/content/drive/MyDrive/Colab Notebooks/Experiment_17_Target_Condition_Recalibration_FINAL.ipynb\\\",\\n\",\"      \\\"experiment18_reference\\\": false,\\n\",\"      \\\"evidence\\\": [\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 1,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"embedding_dimension\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"    \\\\\\\"random_seed\\\\\\\": 202617,\\\\n    \\\\\\\"n_seeds\\\\\\\": 20,\\\\n    \\\\\\\"embedding_dimension\\\\\\\": 64,\\\\n    \\\\\\\"window_size\\\\\\\": 20,\\\\n    \\\\\\\"reference_samples\\\\\\\": 1000,\\\\n    \\\\\\\"source_calibration_windows\\\\\\\": 200,\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 2,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"embedding_dimension\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"# Experiment 17 — Step 3: Define and Validate Covariance Conditions\\\\n\\\\nD = CONFIG[\\\\\\\"embedding_dimension\\\\\\\"]\\\\nrho = CONFIG[\\\\\\\"correlation_strength\\\\\\\"]\\\\ncovariances = {\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 22,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"alignment\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"- Aggregated scenario count.\\\\n- Finite values and valid rate ranges.\\\\n- One-to-one alignment between control and drift evaluation records.\\\\n\\\\n### Expected Result\\\\nAll programmed integrity checks should pass. Passing these checks confirms data consistency and numerical integrity, but does not by itself establish scientific validity or real-world applicability.\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 28,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"alignment\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"## Integrity Checks\\\\n\\\\nThe programmed integrity audit passed **15 out of 15 checks**. These checks cover expected record counts, numerical finiteness, valid rate ranges, and alignment of control and drift evaluation records.\\\\nPassing these checks establishes basic numerical and data-structure consistency. It does not establish scientific validity by itself.\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 41,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"embedding_dimension\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"        \\\\\\\"random_seed\\\\\\\": 202617,\\\\n        \\\\\\\"n_seeds\\\\\\\": 20,\\\\n        \\\\\\\"embedding_dimension\\\\\\\": 64,\\\\n        \\\\\\\"window_size\\\\\\\": 20,\\\\n        \\\\\\\"reference_samples\\\\\\\": 1000,\\\\n        \\\\\\\"source_calibration_windows\\\\\\\": 200,\\\"\\n\",\"        }\\n\",\"      ]\\n\",\"    },\\n\",\"    {\\n\",\"      \\\"path\\\": \\\"/content/drive/MyDrive/Colab Notebooks/Experiment_18_Genuine_Face_Recognition_Embedding_Validation.ipynb\\\",\\n\",\"      \\\"experiment18_reference\\\": true,\\n\",\"      \\\"evidence\\\": [\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 0,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"InceptionResnetV1\\\",\\n\",\"            \\\"VGGFace2\\\",\\n\",\"            \\\"MTCNN\\\",\\n\",\"            \\\"alignment\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"## 3. Research Objective\\\\n\\\\nTo evaluate the behaviour of embedding-level drift detectors using 512-dimensional face-recognition embeddings extracted with FaceNet pretrained on VGGFace2.\\\\n## 4. Research Questions\\\\n- Dataset: Labeled Faces in the Wild (LFW).\\\\n- Face detector and alignment: MTCNN.\\\\n- Face-recognition model: InceptionResnetV1.\\\\n- Pretrained weights: VGGFace2.\\\\n- Embedding dimension: 512.\\\\n- Framework: PyTorch and facenet-pytorch.\\\\n## 7. Experimental Methodology\\\\nThe experiment will use identity-aware data partitioning, face detection and alignment, embedding extraction, independent threshold calibration, control evaluation and controlled drift evaluation.\\\\nThe precise partitioning protocol, environmental transformations, detector configurations and evaluation metrics will be finalised before generating the experimental dataset.\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 3,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"InceptionResnetV1\\\",\\n\",\"            \\\"VGGFace2\\\",\\n\",\"            \\\"MTCNN\\\",\\n\",\"            \\\"alignment\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"\\\\n### Objective\\\\nInitialise the MTCNN face detector and pretrained FaceNet recognition model for extracting genuine facial embeddings.\\\\n### Methodology\\\\n1. Import the required FaceNet components.\\\\n2. Initialise MTCNN for face detection and alignment.\\\\n3. Load InceptionResnetV1 with VGGFace2 pretrained weights.\\\\n4. Configure the model for evaluation.\\\\n5. Verify the expected embedding dimension.\\\\n### Model Configuration\\\\n- Face detector: MTCNN\\\\n- Recognition model: InceptionResnetV1\\\\n- Pretrained weights: VGGFace2\\\\n- Expected embedding dimension: 512\\\\n- Execution device: CPU\\\\n### Validation Criteria\\\\n- Successful MTCNN initialisation.\\\\n- Successful FaceNet model loading.\\\\n- Confirmation of the 512-dimensional embedding output.\\\\n### Status\\\\nSuccessfully completed. MTCNN face detection and alignment were initialised, the pretrained InceptionResnetV1 model with VGGFace2 weights was loaded, and the model was configured for evaluation. The expected 512-dimensional embedding configuration was verified.\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 4,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"InceptionResnetV1\\\",\\n\",\"            \\\"VGGFace2\\\",\\n\",\"            \\\"MTCNN\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"import torch\\\\nimport torchvision\\\\nfrom facenet_pytorch import MTCNN, InceptionResnetV1\\\\n\\\\n# Configure execution device\\\\ndevice = torch.device(\\\\\\\"cpu\\\\\\\")\\\\n# Initialise MTCNN face detector\\\\nmtcnn = MTCNN(\\\\n    image_size=160,\\\\n    margin=0,\\\\n    keep_all=False,\\\\n# Load pretrained FaceNet model\\\\nfacenet = InceptionResnetV1(\\\\n    pretrained=\\\\\\\"vggface2\\\\\\\"\\\\n).eval().to(device)\\\\n# Verify model configuration\\\\nprint(\\\\\\\"MTCNN initialised successfully.\\\\\\\")\\\\nprint(\\\\\\\"FaceNet model initialised successfully.\\\\\\\")\\\\nprint(\\\\\\\"Pretrained weights: VGGFace2\\\\\\\")\\\\nprint(\\\\\\\"Execution device:\\\\\\\", device)\\\\nprint(\\\\\\\"Embedding dimension:\\\\\\\", facenet.last_linear.out_features)\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 5,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"MTCNN\\\",\\n\",\"            \\\"alignment\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"1. Retrieve a sample face image.\\\\n2. Load the image using the PIL library.\\\\n3. Apply MTCNN for face detection and alignment.\\\\n4. Pass the aligned face through the pretrained FaceNet model.\\\\n5. Extract the 512-dimensional facial embedding.\\\\n6. Validate the embedding shape, numerical values and L2 norm.\\\\n\\\\n### Status\\\\nSuccessfully completed. The sample face image was downloaded and loaded, MTCNN successfully detected and aligned the face, and the pretrained FaceNet model generated a 512-dimensional embedding. Numerical validation confirmed that all embedding values were finite and the L2 norm was 1.0.\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 6,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"MTCNN\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"\\\\n# Detect and align face\\\\nface_tensor = mtcnn(image)\\\\nif face_tensor is None:\\\\n    raise ValueError(\\\\\\\"No face detected in the sample image.\\\\\\\")\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 10,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"Resize\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"lfw_dataset = fetch_lfw_people(\\\\n    data_home=\\\\\\\"/content/lfw_data\\\\\\\",\\\\n    resize=1.0,\\\\n    min_faces_per_person=20,\\\\n    color=True,\\\\n    download_if_missing=True\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 15,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"InceptionResnetV1\\\",\\n\",\"            \\\"VGGFace2\\\",\\n\",\"            \\\"MTCNN\\\",\\n\",\"            \\\"alignment\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"## Step 8 — Face Alignment and Embedding Extraction\\\\n\\\\n### Objective\\\\nExtract genuine 512-dimensional facial embeddings from the LFW dataset using the pretrained FaceNet model.\\\\n### Methodology\\\\n1. Process reference, calibration and evaluation images separately.\\\\n2. Apply MTCNN for face detection and alignment.\\\\n3. Generate facial embeddings using InceptionResnetV1 pretrained on VGGFace2.\\\\n4. Preserve the corresponding identity labels and partition assignments.\\\\n5. Record images for which face detection fails.\\\\n6. Validate embedding dimensions and numerical integrity.\\\\n### Embedding Configuration\\\\n- Recognition model: InceptionResnetV1.\\\\n- Pretrained weights: VGGFace2.\\\\n- Input face resolution: 160 × 160.\\\\n- Embedding dimension: 512.\\\\n- Normalisation: L2-normalised FaceNet embeddings.\\\\n### Status\\\\nSuccessfully completed after recovery. MTCNN was used to detect and align faces, and the pretrained InceptionResnetV1 model (VGGFace2) generated 512-dimensional, L2-normalised embeddings.\\\\nReference partition: 1,460 successful embeddings and 17 failed face detections.\\\\nCalibration partition: 568 successful embeddings and 10 failed face detections.\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 16,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"MTCNN\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"\\\\n        # Detect and align face\\\\n        face_tensor = mtcnn(image)\\\\n        if face_tensor is None:\\\\n            failed_indices.append(idx)\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 19,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"alignment\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"2. Check for NaN and infinite values.\\\\n3. Calculate the L2 norm of each embedding.\\\\n4. Verify embedding-label alignment.\\\\n5. Confirm that all embeddings contain 512 features.\\\\n\\\\n### Validation Criteria\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 20,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"alignment\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"    print(\\\\\\\"Label shape:\\\\\\\", labels.shape)\\\\n    print(\\\\\\\"All values finite:\\\\\\\", np.isfinite(embeddings).all())\\\\n    print(\\\\\\\"Embedding-label alignment:\\\\\\\", len(embeddings) == len(labels))\\\\n    print(\\\\\\\"Mean L2 norm:\\\\\\\", norms.mean())\\\\n    print(\\\\\\\"Minimum L2 norm:\\\\\\\", norms.min())\\\\n    print(\\\\\\\"Maximum L2 norm:\\\\\\\", norms.max())\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 21,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"experiment18_facenet_lfw_embeddings\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"Successfully completed. The extracted FaceNet embeddings, identity labels, failed face-detection indices, and experimental configuration were saved in a compressed NumPy archive.\\\\n\\\\nArchive: experiment18_facenet_lfw_embeddings.npz\\\\nLocation: /content/experiment18_results/\\\\nFile size: 5.41 MB\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 22,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"InceptionResnetV1\\\",\\n\",\"            \\\"VGGFace2\\\",\\n\",\"            \\\"embedding_dimension\\\",\\n\",\"            \\\"experiment18_facenet_lfw_embeddings\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"output_dir.mkdir(parents=True, exist_ok=True)\\\\n\\\\narchive_path = output_dir / \\\\\\\"experiment18_facenet_lfw_embeddings.npz\\\\\\\"\\\\nnp.savez_compressed(\\\\n    archive_path,\\\\n    random_seed=np.array(42),\\\\n    model=np.array(\\\\\\\"InceptionResnetV1\\\\\\\"),\\\\n    pretrained_weights=np.array(\\\\\\\"VGGFace2\\\\\\\"),\\\\n    dataset=np.array(\\\\\\\"LFW\\\\\\\"),\\\\n    embedding_dimension=np.array(512)\\\\n)\\\\nprint(\\\\\\\"Archive saved:\\\\\\\", archive_path)\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 23,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"experiment18_facenet_lfw_embeddings\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"Successfully completed. Google Drive was mounted and a dedicated Experiment 18 results directory was created. The verified FaceNet embedding archive was copied to persistent storage.\\\\n\\\\nBackup location: /content/drive/MyDrive/Experiment_18_Results/experiment18_facenet_lfw_embeddings.npz\\\\nBackup verification confirmed that the file exists and has the expected size of 5.41 MB.\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 25,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"experiment18_facenet_lfw_embeddings\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"# Copy verified archive\\\\nsource = Path(\\\\n    \\\\\\\"/content/experiment18_results/experiment18_facenet_lfw_embeddings.npz\\\\\\\"\\\\n)\\\\n\\\\ndestination = backup_dir / source.name\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 27,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"experiment18_facenet_lfw_embeddings\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"archive_path = Path(\\\\n    \\\\\\\"/content/drive/MyDrive/Experiment_18_Results/\\\\\\\"\\\\n    \\\\\\\"experiment18_facenet_lfw_embeddings.npz\\\\\\\"\\\\n)\\\\n\\\\nwith np.load(archive_path) as data:\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 42,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"InceptionResnetV1\\\",\\n\",\"            \\\"VGGFace2\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"- Embedding dimension: 512\\\\n- Face detection success rate: 98.71%\\\\n- Model: InceptionResnetV1 pretrained on VGGFace2\\\\n\\\\n### 14.2 Identity Similarity Analysis\\\\nSame-identity pairs demonstrated substantially higher cosine similarity than different-identity pairs across reference, calibration and evaluation partitions.\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 43,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"InceptionResnetV1\\\",\\n\",\"            \\\"VGGFace2\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"\\\\nprint(\\\\\\\"Embedding dimension:\\\\\\\", reference_embeddings.shape[1])\\\\nprint(\\\\\\\"Model: InceptionResnetV1\\\\\\\")\\\\nprint(\\\\\\\"Pretrained weights: VGGFace2\\\\\\\")\\\\ntotal_images = 3023\\\\nsuccessful_embeddings = (\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 44,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"InceptionResnetV1\\\",\\n\",\"            \\\"VGGFace2\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"- Transformation: controlled brightness adjustment.\\\\n- Conditions: reduced, unchanged and increased illumination.\\\\n- Model: InceptionResnetV1 pretrained on VGGFace2.\\\\n- Embedding dimension: 512.\\\\n- Comparison: paired original and transformed image embeddings.\\\\n\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 49,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"InceptionResnetV1\\\",\\n\",\"            \\\"MTCNN\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"### Methodology\\\\n1. Reuse the original evaluation embeddings as the baseline.\\\\n2. Process low-illumination images using MTCNN and FaceNet.\\\\n3. Process high-illumination images using MTCNN and FaceNet.\\\\n4. Record face detection failures separately.\\\\n5. Verify embedding dimensions and numerical integrity.\\\\n\\\\n### Status\\\\nSuccessfully completed. FaceNet embeddings were extracted from low- and high-illumination evaluation images using MTCNN and InceptionResnetV1. The original baseline contained 956 embeddings of 512 dimensions. Low illumination produced 943 valid embeddings with 13 detection failures, while high illumination produced 897 valid embeddings with 59 detection failures. Both transformed embedding collections passed numerical integrity checks, with all values finite. Detection failures were recorded separately for subsequent paired-cohort validation.\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 50,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"MTCNN\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"            pil_image = Image.fromarray(image_uint8)\\\\n\\\\n            face_tensor = mtcnn(pil_image)\\\\n            if face_tensor is None:\\\\n                failed_positions.append(position)\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 51,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"alignment\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"## Step 15.3 — Paired Image and Identity Alignment Validation\\\\n\\\\n### Objective\\\\nEstablish a correctly aligned evaluation cohort across original, low-illumination and high-illumination conditions.\\\\n### Status\\\\nSuccessfully completed. Image-to-embedding alignment and identity-label consistency were validated across original, low-illumination and high-illumination conditions. A common paired cohort of 889 images was established from 956 original, 943 low-illumination and 897 high-illumination successful extractions. All three paired embedding matrices have shape (889, 512). Identity labels were aligned, all embeddings were finite, and the dimensional consistency assertions passed.\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 52,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"alignment\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"])\\\\n\\\\n# Verify original image-to-embedding alignment\\\\nassert len(ordered_original_indices) == len(evaluation_embeddings)\\\\noriginal_labels_check = lfw_dataset.target[\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 64,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"InceptionResnetV1\\\",\\n\",\"            \\\"VGGFace2\\\",\\n\",\"            \\\"embedding_dimension\\\",\\n\",\"            \\\"experiment18_illumination_results\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"# Save numerical experiment results\\\\nnp.savez_compressed(\\\\n    os.path.join(output_dir, \\\\\\\"experiment18_illumination_results.npz\\\\\\\"),\\\\n\\\\n    original_embeddings=paired_original_embeddings,\\\\n    low_illumination_embeddings=paired_low_embeddings,\\\\n    \\\\\\\"experiment\\\\\\\": \\\\\\\"Experiment 18 - Controlled Illumination\\\\\\\",\\\\n    \\\\\\\"dataset\\\\\\\": \\\\\\\"LFW filtered subset\\\\\\\",\\\\n    \\\\\\\"model\\\\\\\": \\\\\\\"InceptionResnetV1\\\\\\\",\\\\n    \\\\\\\"pretrained_weights\\\\\\\": \\\\\\\"VGGFace2\\\\\\\",\\\\n    \\\\\\\"embedding_dimension\\\\\\\": 512,\\\\n    \\\\\\\"brightness_factors\\\\\\\": {\\\\n        \\\\\\\"low\\\\\\\": 0.5,\\\\n        \\\\\\\"original\\\\\\\": 1.0,\\\\nfor filename in [\\\\n    \\\\\\\"experiment18_illumination_results.npz\\\\\\\",\\\\n    \\\\\\\"illumination_identity_summary.csv\\\\\\\",\\\\n    \\\\\\\"illumination_metadata.json\\\\\\\"\\\\n]:\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 90,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"embedding_dimension\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"    \\\\\\\"reference_identities\\\\\\\": int(len(np.unique(reference_labels))),\\\\n    \\\\\\\"reference_images\\\\\\\": int(len(reference_baseline)),\\\\n    \\\\\\\"embedding_dimension\\\\\\\": int(reference_baseline.shape[1]),\\\\n    \\\\\\\"calibration_images\\\\\\\": int(len(calibration_baseline)),\\\\n    \\\\\\\"calibration_windows\\\\\\\": int(len(balanced_calibration_window_means)),\\\\n    \\\\\\\"window_size\\\\\\\": 20,\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 116,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"InceptionResnetV1\\\",\\n\",\"            \\\"VGGFace2\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"**1. Dataset and Experimental Configuration**\\\\n\\\\nThe experiment used a filtered subset of the Labeled Faces in the Wild (LFW) dataset with the InceptionResnetV1 model pretrained on VGGFace2.\\\\nThe embedding dimension was 512.\\\\n**3. Model and Random Seed Inspection**\\\\nThe existing model object was identified as `InceptionResnetV1` from the `facenet_pytorch` package.\\\\nThe following random seed variables were found in the current session:\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 117,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"InceptionResnetV1\\\",\\n\",\"            \\\"VGGFace2\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"configuration = {\\\\n    \\\\\\\"Dataset\\\\\\\": \\\\\\\"Labeled Faces in the Wild (LFW)\\\\\\\",\\\\n    \\\\\\\"Pretrained Model\\\\\\\": \\\\\\\"InceptionResnetV1\\\\\\\",\\\\n    \\\\\\\"Pretrained Weights\\\\\\\": \\\\\\\"VGGFace2\\\\\\\",\\\\n    \\\\\\\"Embedding Dimension\\\\\\\": 512,\\\\n    \\\\\\\"Evaluation Identities\\\\\\\": 13,\\\\n    \\\\\\\"Full Paired Illumination Images\\\\\\\": 889,\\\\n\\\\n    expected_model_found = any(\\\\n        row[\\\\\\\"Object Type\\\\\\\"] == \\\\\\\"InceptionResnetV1\\\\\\\"\\\\n        for row in model_inspection\\\\n    )\\\\n    print(\\\\n        \\\\\\\"InceptionResnetV1 model object found:\\\\\\\",\\\\n        expected_model_found\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 118,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"InceptionResnetV1\\\",\\n\",\"            \\\"VGGFace2\\\",\\n\",\"            \\\"experiment18_illumination_results\\\",\\n\",\"            \\\"experiment18_facenet_lfw_embeddings\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"\\\\n- `Experiment_18_Final_Research_Package.zip`\\\\n- `experiment18_facenet_lfw_embeddings.npz`\\\\n- `experiment18_final_research_evidence.json`\\\\n- `experiment18_final_research_evidence.md`\\\\n- `experiment18_illumination_results.npz`\\\\n- `illumination_identity_summary.csv`\\\\n- `illumination_metadata.json`\\\\n- Dataset: LFW filtered subset\\\\n- Model: InceptionResnetV1\\\\n- Pretrained weights: VGGFace2\\\\n- Embedding dimension: 512\\\\n- Full paired images: 889\\\\n- Evaluation identities: 13\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 119,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"InceptionResnetV1\\\",\\n\",\"            \\\"VGGFace2\\\",\\n\",\"            \\\"embedding_dimension\\\",\\n\",\"            \\\"experiment18_illumination_results\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"\\\\nillumination_archive = (\\\\n    results_dir / \\\\\\\"experiment18_illumination_results.npz\\\\\\\"\\\\n)\\\\nif illumination_archive.exists():\\\\n    expected_metadata = {\\\\n        \\\\\\\"dataset\\\\\\\": \\\\\\\"LFW filtered subset\\\\\\\",\\\\n        \\\\\\\"model\\\\\\\": \\\\\\\"InceptionResnetV1\\\\\\\",\\\\n        \\\\\\\"pretrained_weights\\\\\\\": \\\\\\\"VGGFace2\\\\\\\",\\\\n        \\\\\\\"embedding_dimension\\\\\\\": 512,\\\\n        \\\\\\\"paired_images\\\\\\\": 889,\\\\n        \\\\\\\"evaluation_identities\\\\\\\": 13\\\\n    }\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 122,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"alignment\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"\\\\n1. Load the previously saved illumination results without modifying the original files.\\\\n2. Confirm embedding dimensions, sample alignment and identity counts.\\\\n3. Independently recalculate low- and high-illumination embedding displacement.\\\\n4. Compare recalculated displacement values against the saved displacement arrays.\\\\n5. Reconstruct image-level and identity-level statistical comparisons.\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 123,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"alignment\\\",\\n\",\"            \\\"embedding_dimension\\\",\\n\",\"            \\\"experiment18_illumination_results\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"results_dir = Path(\\\\\\\"/content/drive/MyDrive/Experiment_18_Results\\\\\\\")\\\\n\\\\nnpz_path = results_dir / \\\\\\\"experiment18_illumination_results.npz\\\\\\\"\\\\nmetadata_path = results_dir / \\\\\\\"illumination_metadata.json\\\\\\\"\\\\nprint(\\\\\\\"=\\\\\\\" * 75)\\\\n# ------------------------------------------------------------\\\\n# 4. Verify sample alignment\\\\nprint(\\\\\\\"\\\\\\\\n[3] SAMPLE ALIGNMENT\\\\\\\")\\\\nsample_counts = [len(array) for array in arrays.values()]\\\\nalignment_passed = len(set(sample_counts)) == 1\\\\nprint(\\\\\\\"Sample counts:\\\\\\\", sample_counts)\\\\nprint(\\\\\\\"All sample counts equal:\\\\\\\", alignment_passed)\\\\nprint(\\\\\\\"\\\\\\\\n[4] EMBEDDING DIMENSION\\\\\\\")\\\\nembedding_dimensions = [\\\\n    original_embeddings.shape[1],\\\\n    low_illumination_embeddings.shape[1],\\\\n    high_illumination_embeddings.shape[1]\\\\ndimension_passed = (\\\\n    len(set(embedding_dimensions)) == 1\\\\n    and embedding_dimensions[0] == 512\\\\n)\\\\nprint(\\\\\\\"Embedding dimensions:\\\\\\\", embedding_dimensions)\\\\nprint(\\\\\\\"512-dimensional embeddings verified:\\\\\\\", dimension_passed)\\\\nall_checks_passed = (\\\\n    alignment_passed\\\\n    and dimension_passed\\\\n    and all(finite_checks.values())\\\\n    and identity_count_passed\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 129,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"experiment18_illumination_results\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\")\\\\n\\\\nnpz_path = results_dir / \\\\\\\"experiment18_illumination_results.npz\\\\\\\"\\\\nmetadata_path = results_dir / \\\\\\\"illumination_metadata.json\\\\\\\"\\\\ncsv_path = results_dir / \\\\\\\"illumination_identity_summary.csv\\\\\\\"\\\"\\n\",\"        },\\n\",\"        {\\n\",\"          \\\"cell_index\\\": 131,\\n\",\"          \\\"matched_terms\\\": [\\n\",\"            \\\"embedding_dimension\\\",\\n\",\"            \\\"experiment18_illumination_results\\\",\\n\",\"            \\\"experiment18_facenet_lfw_embeddings\\\"\\n\",\"          ],\\n\",\"          \\\"excerpt\\\": \\\"\\\\nembedding_path = (\\\\n    results_dir / \\\\\\\"experiment18_facenet_lfw_embeddings.npz\\\\\\\"\\\\n)\\\\nassert embedding_path.exists(), \\\\\\\"Original embedding NPZ not found.\\\\\\\"\\\\nillumination_npz_path = (\\\\n    results_dir / \\\\\\\"experiment18_illumination_results.npz\\\\\\\"\\\\nassert illumination_npz_path.exists(), (\\\\npaired_image_count = len(labels)\\\\nidentity_count = len(np.unique(labels))\\\\nembedding_dimension = original.shape[1]\\\\ncohort_summary = pd.DataFrame([\\\\n    {\\\\n        \\\\\\\"Metric\\\\\\\": \\\\\\\"Embedding dimension\\\\\\\",\\\\n        \\\\\\\"Value\\\\\\\": embedding_dimension\\\\n    },\\\\n        \\\\\\\"Metric\\\\\\\": \\\\\\\"Identities in paired illumination cohort\\\\\\\",\\\\nprint(\\\\\\\"Historical paired illumination images:\\\\\\\", paired_image_count)\\\\nprint(\\\\\\\"Corrected detector evaluation cohort: 229\\\\\\\")\\\\nprint(\\\\\\\"Embedding dimension:\\\\\\\", embeddin